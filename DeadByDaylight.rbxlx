        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Actions</string>
            <string name="Source"><![CDATA[-- Действия, пока игрок держит кнопку (Poses.Action): ключевые клипы всего тела.
-- Функция действия (t, p) -> поза, где t — секунды от НАЧАЛА действия (Animator считает его сам
-- и плавно вводит/выводит слой). Зацикленные (Loop) — пока действие длится сколько угодно
-- (ремонт, лечение); с фиксированной длительностью ActionInfo (крюк, пинок, обыск) — один проход,
-- последняя поза держится. Позы — как в Anim/Clips.lua: body{} (корпус вокруг таза, ноги —
-- мировые углы, руки/голова — в пространстве торса). Clip.sample пишет в общую таблицу клипа —
-- без выделения памяти каждый кадр.
local Rig = require(script.Parent.Rig)
local Clip = require(script.Parent.Clip)
local Clips = require(script.Parent.Clips)

local Actions = {}

local A = Rig.A
local V = Vector3.new
local AT, K, body = Clips.AT, Clips.K, Clips.body

local Action = {}
Actions.Action = Action
-- Длина клипа каждого действия (для превью и тестов)
Actions.Length = {} :: { [string]: number }
Actions.Clips = {} :: { [string]: Clip.Clip }

-- Стойка + поза (стойка подставляет таз и ноги, если их нет в позе)
local function on(stance: Clips.Spec, s: Clips.Spec): Clip.Pose
	local spec = table.clone(stance)
	for k, v in s do
		(spec :: any)[k] = v
	end
	return body(spec)
end

-- На правом колене (левая нога впереди) и на левом; таз на высоте ~1 стада
local KNEEL_R: Clips.Spec = { hip = V(0, -1.0, 0), ll = A(60, 0, -6), rl = A(-58, 0, 6) }
local KNEEL_L: Clips.Spec = { hip = V(0, -1.0, 0), ll = A(-58, 0, -6), rl = A(60, 0, 6) }
local STAND: Clips.Spec = { ll = A(0, 0, -3), rl = A(0, 0, 3) }

local function define(names: { string }, def: Clip.Def)
	local clip = Clip.new(def)
	local fn = function(t: number, _p: any?): Clip.Pose
		return Clip.sample(clip, t)
	end
	for _, name in names do
		Action[name] = fn
		Actions.Length[name] = clip.Duration
		Actions.Clips[name] = clip
	end
end

------------------------------------------------------------------------
-- Выживший
------------------------------------------------------------------------

-- Ремонт: на колене, руки копаются в механизме (вразнобой, с поворотом кистей), тянется глубже,
-- дёргает провода на себя, замирает и оглядывается через плечо.
do
	local function k(t, s, e)
		return K(t, on(KNEEL_R, s), e or "SineInOut")
	end
	define({ "Repair" }, {
		Duration = 6.4,
		Loop = true,
		Keys = {
			k(0, { lean = 18, turn = 3, la = AT(80, -6, -10), ra = AT(70, 8, 12), neck = A(-16, 4, 0) }),
			k(0.4, { lean = 17, turn = -2, la = AT(68, -10, 8), ra = AT(84, 4, -14), neck = A(-18, -3, 0) }),
			k(0.8, { lean = 19, turn = 4, la = AT(84, -4, -16), ra = AT(66, 10, 10), neck = A(-15, 6, 0) }),
			k(1.2, { lean = 17, turn = -3, la = AT(70, -12, 6), ra = AT(80, 2, -10), neck = A(-17, -2, 0) }),
			k(1.65, { lean = 24, hip = V(0, -0.98, -0.1), la = AT(92, -2, 0), ra = AT(94, 0, 0), neck = A(-8, 0, 0) }),
			k(1.9, { lean = 10, turn = 2, la = AT(56, -12, 10), ra = AT(60, 12, -10), neck = A(-20, 0, 0) }, "QuadOut"),
			k(2.3, { lean = 17, la = AT(78, -6, -8), ra = AT(72, 6, 8), neck = A(-16, 2, 0) }),
			k(2.65, { lean = 18, turn = -3, la = AT(68, -10, 10), ra = AT(84, 4, -12), neck = A(-17, -4, 0) }),
			k(3.0, { lean = 17, turn = 3, la = AT(82, -4, -12), ra = AT(68, 8, 12), neck = A(-15, 5, 0) }),
			k(3.4, { lean = 15, la = AT(76, -6, 0), ra = AT(76, 6, 0), neck = A(-12, 0, 0) }),
			k(3.8, { lean = 11, turn = 12, roll = 2, la = AT(74, -6, 0), ra = AT(72, 6, 0), neck = A(-2, 58, 0) }),
			k(4.4, { lean = 11, turn = 10, roll = 2, la = AT(74, -6, 0), ra = AT(72, 6, 0), neck = A(2, 50, -4) }, "Linear"),
			k(4.8, { lean = 17, la = AT(78, -6, -8), ra = AT(70, 8, 10), neck = A(-16, 0, 0) }),
			k(5.2, { lean = 18, turn = -3, la = AT(68, -10, 10), ra = AT(84, 4, -12), neck = A(-17, -4, 0) }),
			k(5.6, { lean = 17, turn = 3, la = AT(84, -4, -14), ra = AT(68, 10, 12), neck = A(-15, 5, 0) }),
			k(6.0, { lean = 18, turn = -1, la = AT(70, -12, 6), ra = AT(80, 2, -10), neck = A(-17, -2, 0) }),
		},
	})
end

-- Лечение другого: на левом колене, ладони на ране — ритмично давит всем корпусом,
-- перевязывает, иногда поднимает глаза.
do
	local function k(t, s, e)
		return K(t, on(KNEEL_L, s), e or "SineInOut")
	end
	local up = { lean = 24, la = AT(58, 8, 0), ra = AT(56, -8, 0), neck = A(-24, 0, 0) }
	local press = { lean = 31, hip = V(0, -1.05, -0.05), la = AT(46, 10, 4), ra = AT(44, -10, -4), neck = A(-26, 0, 0) }
	define({ "Heal" }, {
		Duration = 3.2,
		Loop = true,
		Keys = {
			k(0, up),
			k(0.4, press),
			k(0.8, up),
			k(1.2, press),
			k(1.65, { lean = 22, turn = 6, la = AT(64, -6, -10), ra = AT(50, -16, 8), neck = A(-24, -6, 4) }),
			k(2.05, { lean = 24, turn = 2, la = AT(52, 14, 6), ra = AT(60, -4, -6), neck = A(-22, 4, 0) }),
			k(2.45, press),
			k(2.85, { lean = 20, turn = 4, la = AT(56, 8, 0), ra = AT(54, -8, 0), neck = A(-4, 34, 0) }),
		},
	})
end

-- Очищение тотема: на колене, выдирает кости и отбрасывает в стороны
do
	local function k(t, s, e)
		return K(t, on(KNEEL_R, s), e or "SineInOut")
	end
	local reach = { lean = 32, la = A(55, 0, -4), ra = A(52, 0, 4), neck = A(-22, 0, 0) }
	define({ "Cleanse" }, {
		Duration = 2.4,
		Loop = true,
		Keys = {
			k(0, reach),
			k(0.45, { lean = 22, turn = -12, la = A(50, 0, -8), ra = A(95, 0, 50), neck = A(-14, -14, 0) }, "QuadOut"),
			k(0.8, reach),
			k(1.2, { lean = 30, turn = 6, la = AT(58, -20, -15), ra = AT(58, 20, 15), neck = A(-24, 4, 0) }),
			k(1.6, { lean = 22, turn = 12, la = A(90, 0, -55), ra = A(55, 0, 6), neck = A(-14, 16, 0) }, "QuadOut"),
			k(2.0, { lean = 32, la = A(54, 0, -6), ra = A(52, 0, 6), neck = A(-22, 0, 0) }),
		},
	})
end

-- Сундук (5 с): роется двумя руками по очереди, заглядывает внутрь, откидывает хлам
do
	local function k(t, s, e)
		return K(t, on(KNEEL_L, s), e or "SineInOut")
	end
	define({ "OpenChest" }, {
		Duration = 2.6,
		Loop = true,
		Keys = {
			k(0, { lean = 28, la = AT(62, -4, 10), ra = AT(48, 6, -10), neck = A(-22, 0, 0) }),
			k(0.35, { lean = 30, turn = -4, la = AT(46, -8, -10), ra = AT(66, 2, 12), neck = A(-24, -6, 0) }),
			k(0.7, { lean = 27, turn = 4, la = AT(66, -2, 8), ra = AT(46, 8, -8), neck = A(-20, 6, 0) }),
			k(1.05, { lean = 34, hip = V(0, -0.98, -0.08), la = AT(56, -6, 0), ra = AT(58, 6, 0), neck = A(-14, 0, 0) }),
			k(1.4, { lean = 22, turn = -10, la = A(52, 0, -6), ra = A(100, 0, 55), neck = A(-16, -18, 0) }, "QuadOut"),
			k(1.8, { lean = 30, turn = 2, la = AT(48, -8, -6), ra = AT(64, 4, 10), neck = A(-24, 2, 0) }),
			k(2.2, { lean = 28, turn = -2, la = AT(64, -4, 8), ra = AT(50, 6, -6), neck = A(-22, -4, 0) }),
		},
	})
end

-- Освободить из капкана / обезвредить: на колене, раздвигает челюсти капкана, руки дрожат от
-- натуги, челюсти срываются — хватается снова.
do
	local function k(t, s, e)
		return K(t, on(KNEEL_R, s), e or "SineInOut")
	end
	define({ "FreeTrap", "DisarmTrap" }, {
		Duration = 2.0,
		Loop = true,
		Keys = {
			k(0, { lean = 38, la = A(66, 0, 4), ra = A(66, 0, -4), neck = A(-24, 0, 0) }),
			k(0.5, { lean = 30, hip = V(0, -0.96, 0.08), la = A(62, 0, -22), ra = A(62, 0, 22), neck = A(-18, 0, 0) }),
			k(0.7, { lean = 31, hip = V(0, -0.96, 0.08), la = A(63, 0, -24), ra = A(61, 0, 21), neck = A(-17, 3, 0) }, "Linear"),
			k(0.9, { lean = 30, hip = V(0, -0.96, 0.08), la = A(61, 0, -21), ra = A(63, 0, 24), neck = A(-19, -3, 0) }, "Linear"),
			k(1.1, { lean = 31, hip = V(0, -0.96, 0.08), la = A(63, 0, -25), ra = A(62, 0, 25), neck = A(-16, 0, 0) }, "Linear"),
			k(1.25, { lean = 42, la = A(64, 0, 8), ra = A(64, 0, -8), neck = A(-28, 0, 0) }, "QuadIn"),
			k(1.6, { lean = 38, la = A(66, 0, 4), ra = A(66, 0, -4), neck = A(-24, 6, 0) }),
		},
	})
end

-- Снять с крюка (1.2 с): тянется вверх, берёт под руки, поднимает с натугой, отклоняясь назад
define({ "Unhook" }, {
	Duration = 1.2,
	Keys = {
		K(0, on(STAND, { lean = 2, la = A(150, 0, -10), ra = A(150, 0, 10), neck = A(25, 0, 0) })),
		K(0.3, on(STAND, { lean = 0, la = A(142, 0, 8), ra = A(142, 0, -8), neck = A(24, 0, 0) }), "SineInOut"),
		K(0.75, on(STAND, { lean = -10, hip = V(0, 0.06, 0.06), ll = A(6, 0, -3), rl = A(-8, 0, 3), la = A(166, 0, 5), ra = A(166, 0, -5), neck = A(30, 0, 0) }), "SineInOut"),
		K(1.2, on(STAND, { lean = -12, hip = V(0, 0.08, 0.08), ll = A(8, 0, -3), rl = A(-10, 0, 3), la = A(172, 0, 6), ra = A(172, 0, -6), neck = A(32, 0, 0) }), "SineInOut"),
	},
})

-- Ворота: правая держит рычаг вниз (дожимает), левая упирается в щиток, нервно оглядывается
do
	local function k(t, s, e)
		return K(t, on({ ll = A(4, 0, -4), rl = A(-6, 0, 4) }, s), e or "SineInOut")
	end
	define({ "OpenGate" }, {
		Duration = 4.0,
		Loop = true,
		Keys = {
			k(0, { lean = 8, turn = 4, la = A(80, 0, -12), ra = AT(70, 4, 10), neck = A(-6, 0, 0) }),
			k(0.7, { lean = 10, turn = 4, la = A(80, 0, -12), ra = AT(64, 4, 10), neck = A(-8, -4, 0) }),
			k(1.3, { lean = 8, turn = 2, la = A(78, 0, -12), ra = AT(70, 4, 10), neck = A(-4, 2, 0) }),
			k(1.8, { lean = 6, turn = 14, roll = 2, la = A(74, 0, -14), ra = AT(68, 4, 10), neck = A(2, 55, 0) }),
			k(2.6, { lean = 6, turn = 12, roll = 2, la = A(74, 0, -14), ra = AT(68, 4, 10), neck = A(4, 48, -4) }, "Linear"),
			k(3.1, { lean = 10, turn = 2, la = A(80, 0, -12), ra = AT(64, 4, 10), neck = A(-8, -20, 0) }),
			k(3.6, { lean = 9, turn = 4, la = A(80, 0, -12), ra = AT(68, 4, 10), neck = A(-6, -6, 0) }),
		},
	})
end

-- Лечение аптечкой: аптечка в правой у левого бока, левая придерживает одежду, сутулится,
-- прикладывает и морщится от боли.
do
	local function k(t, s, e)
		return K(t, on({ hip = V(-0.08, -0.05, 0), ll = A(6, 0, -6), rl = A(-4, 0, 5) }, s), e or "SineInOut")
	end
	define({ "SelfHeal" }, {
		Duration = 2.4,
		Loop = true,
		Keys = {
			k(0, { lean = 20, turn = 8, roll = 4, la = A(36, 0, 24), ra = AT(52, -38, 20), neck = A(-28, 10, 6) }),
			k(0.5, { lean = 22, turn = 9, roll = 4, la = A(38, 0, 22), ra = AT(46, -42, 26), neck = A(-30, 12, 6) }),
			k(0.8, { lean = 26, turn = 4, roll = 6, la = A(42, 0, 18), ra = AT(50, -36, 18), neck = A(-34, 6, 10) }, "QuadOut"),
			k(1.2, { lean = 20, turn = 8, roll = 4, la = A(36, 0, 24), ra = AT(54, -40, 22), neck = A(-26, 10, 6) }),
			k(1.7, { lean = 21, turn = 10, roll = 4, la = A(38, 0, 22), ra = AT(46, -44, 28), neck = A(-30, 14, 6) }),
			k(2.0, { lean = 18, turn = 6, roll = 3, la = A(34, 0, 24), ra = AT(52, -38, 20), neck = A(-12, 30, 0) }),
		},
	})
end

-- Вырваться из капкана (1.4 с — одна попытка): правая нога в капкане, левое колено на земле;
-- хватается за ногу и рвёт её вверх всем телом.
do
	local function k(t, s, e)
		return K(t, on({ hip = V(0.1, -0.4, -0.1), rl = A(-4, 0, 3), ll = A(-70, 0, -6) }, s), e or "SineInOut")
	end
	define({ "EscapeTrap" }, {
		Duration = 1.4,
		Loop = true,
		Keys = {
			k(0, { lean = 38, turn = -8, roll = -5, la = A(66, 0, 24), ra = A(62, 0, 6), neck = A(-28, 0, 0) }),
			k(0.35, { lean = 44, turn = -10, roll = -6, la = A(76, 0, 26), ra = A(72, 0, 8), neck = A(-30, 0, 0) }),
			k(0.55, { lean = 22, turn = -4, roll = -8, hip = V(0.1, -0.3, -0.04), la = A(40, 0, 20), ra = A(36, 0, 4), neck = A(-8, 0, 0) }, "QuadOut"),
			k(0.75, { lean = 26, turn = -6, roll = -6, hip = V(0.1, -0.32, -0.06), la = A(44, 0, 22), ra = A(40, 0, 4), neck = A(-14, -6, 0) }),
			k(1.05, { lean = 40, turn = -8, roll = -4, la = A(70, 0, 24), ra = A(66, 0, 6), neck = A(-30, 6, 0) }),
		},
	})
end

------------------------------------------------------------------------
-- Маньяк
------------------------------------------------------------------------

-- Повесить на крюк (1.2 с): выживший на правом плече; приседает и подхватывает обеими руками,
-- рывком поднимает вверх и насаживает, отклоняясь назад.
define({ "Hook" }, {
	Duration = 1.2,
	Keys = {
		K(0, on(STAND, { lean = 8, la = A(10, 0, -10), ra = A(132, 0, 10), neck = A(-4, 0, 0) })),
		K(0.3, on({ hip = V(0, -0.18, 0), ll = A(16, 0, -8), rl = A(-14, 0, 8) }, { lean = 16, la = A(120, 0, -8), ra = A(118, 0, 16), neck = A(6, 0, 0) }), "SineInOut"),
		K(0.62, on({ hip = V(0, 0.04, 0), ll = A(4, 0, -4), rl = A(-6, 0, 4) }, { lean = -8, la = A(168, 0, -6), ra = A(166, 0, 12), neck = A(28, 0, 0) }), "QuadOut"),
		K(0.9, on({ hip = V(0, 0.06, 0.04), ll = A(6, 0, -4), rl = A(-8, 0, 4) }, { lean = -12, la = A(174, 0, -4), ra = A(172, 0, 10), neck = A(32, 0, 0) }), "SineInOut"),
		K(1.2, on({ hip = V(0, 0.02, 0.02), ll = A(4, 0, -4), rl = A(-6, 0, 4) }, { lean = -6, la = A(160, 0, -8), ra = A(158, 0, 12), neck = A(24, 0, 0) }), "SineInOut"),
	},
})

-- Сломать паллету (2.6 с): высоко заносит правую ногу и топчет; второй замах сильнее — паллета ломается
do
	local lift = { hip = V(-0.14, 0.04, 0.05), ll = A(-2, 0, -4) }
	local stomp = { hip = V(-0.1, -0.12, -0.05), ll = A(-6, 0, -4) }
	define({ "Break" }, {
		Duration = 2.6,
		Keys = {
			K(0, on(STAND, { lean = 6, la = A(6, 0, -9), ra = A(16, 0, 12), neck = A(-6, 0, 0) })),
			K(0.45, on(lift, { lean = -4, rl = A(85, 0, 6), la = A(30, 0, -35), ra = A(40, 0, 35), neck = A(-24, 0, 0) }), "SineInOut"),
			K(0.58, on(stomp, { lean = 14, rl = A(26, 0, 4), la = A(10, 0, -22), ra = A(14, 0, 24), neck = A(-34, 0, 0) }), "CubicIn"),
			K(0.9, on(STAND, { lean = 8, rl = A(10, 0, 4), la = A(10, 0, -14), ra = A(18, 0, 14), neck = A(-26, 0, 0) }), "SineInOut"),
			K(1.6, on(lift, { lean = -10, hip = V(-0.15, 0.06, 0.08), rl = A(98, 0, 6), la = A(50, 0, -45), ra = A(60, 0, 40), neck = A(-26, 4, 0) }), "SineInOut"),
			K(1.74, on(stomp, { lean = 20, hip = V(-0.1, -0.16, -0.08), rl = A(28, 0, 4), la = A(6, 0, -26), ra = A(10, 0, 28), neck = A(-36, 0, 0) }), "CubicIn"),
			K(2.1, on(stomp, { lean = 16, rl = A(24, 0, 4), la = A(8, 0, -18), ra = A(16, 0, 18), neck = A(-30, 0, 0) }), "SineInOut"),
			K(2.6, on(STAND, { lean = 8, rl = A(4, 0, 3), la = A(6, 0, -10), ra = A(16, 0, 12), neck = A(-14, 0, 0) }), "SineInOut"),
		},
	})
end

-- Повредить генератор (1.8 с): заносит ногу, отклоняясь назад, мощный прямой удар, ставит ногу
define({ "Kick" }, {
	Duration = 1.8,
	Keys = {
		K(0, on(STAND, { lean = 6, la = A(6, 0, -9), ra = A(16, 0, 12), neck = A(0, 0, 0) })),
		K(0.5, on({ hip = V(-0.12, 0.02, 0.1), ll = A(-4, 0, -4) }, { lean = -10, turn = -8, rl = A(70, 0, 4), la = A(40, 0, -30), ra = A(50, 0, 30), neck = A(-10, 8, 0) }), "SineInOut"),
		K(0.62, on({ hip = V(-0.1, 0.04, -0.2), ll = A(-14, 0, -4) }, { lean = -16, turn = 6, rl = A(84, 0, 2), la = A(-10, 0, -34), ra = A(-6, 0, 30), neck = A(-4, -6, 0) }), "CubicIn"),
		K(0.85, on({ hip = V(-0.1, 0.02, -0.1), ll = A(-8, 0, -4) }, { lean = -8, turn = 2, rl = A(60, 0, 4), la = A(10, 0, -24), ra = A(14, 0, 24), neck = A(-8, 0, 0) }), "QuadOut"),
		K(1.25, on(STAND, { lean = 8, rl = A(-4, 0, 3), la = A(8, 0, -12), ra = A(18, 0, 14), neck = A(-10, 0, 0) }), "SineInOut"),
		K(1.8, on(STAND, { lean = 6, la = A(6, 0, -9), ra = A(16, 0, 12), neck = A(-4, 0, 0) }), "SineInOut"),
	},
})

-- Обыск шкафчика (0.9 с): левой рывком распахивает дверцу, правой лезет внутрь
define({ "SearchLocker" }, {
	Duration = 0.9,
	Keys = {
		K(0, on(STAND, { lean = 6, la = A(6, 0, -9), ra = A(16, 0, 12), neck = A(0, 0, 0) })),
		K(0.2, on(STAND, { lean = 10, turn = -6, la = A(84, 0, -4), ra = A(24, 0, 14), neck = A(-4, -4, 0) }), "SineInOut"),
		K(0.36, on(STAND, { lean = 6, turn = 14, la = A(56, 0, -72), ra = A(30, 0, 16), neck = A(-2, -10, 0) }), "QuadOut"),
		K(0.6, on({ hip = V(0, -0.06, -0.18), ll = A(-12, 0, -4), rl = A(14, 0, 4) }, { lean = 22, turn = 6, la = A(60, 0, -60), ra = A(92, 0, -4), neck = A(-6, -6, 0) }), "SineInOut"),
		K(0.9, on({ hip = V(0, -0.06, -0.2), ll = A(-12, 0, -4), rl = A(14, 0, 4) }, { lean = 24, turn = 4, la = A(58, 0, -58), ra = A(98, 0, 8), neck = A(-8, -2, 0) }), "SineInOut"),
	},
})

-- Капкан: ставит, забирает, взводит; люк закрывает — на колене, руки у земли, разжимает пружины
do
	local function k(t, s, e)
		return K(t, on({ hip = V(0, -1.05, 0), ll = A(58, 0, -8), rl = A(-60, 0, 8) }, s), e or "SineInOut")
	end
	define({ "SetTrap", "PickupTrap", "ResetTrap", "CloseHatch" }, {
		Duration = 1.6,
		Loop = true,
		Keys = {
			k(0, { lean = 40, la = A(72, 0, -8), ra = A(72, 0, 8), neck = A(-20, 0, 0) }),
			k(0.4, { lean = 46, hip = V(0, -1.1, 0), la = A(64, 0, -12), ra = A(64, 0, 12), neck = A(-24, 0, 0) }),
			k(0.8, { lean = 42, turn = -4, la = A(66, 0, -12), ra = A(80, 0, -4), neck = A(-22, -6, 0) }),
			k(1.2, { lean = 40, la = A(70, 0, -10), ra = A(70, 0, 10), neck = A(-18, 4, 0) }),
		},
	})
end

return Actions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Clip</string>
            <string name="Source"><![CDATA[-- Ключевые клипы для R6: позы по времени с плавностью (easing) на каждом ключе.
--
-- КАК АВТОРИТЬ КЛИП
--   local A = Rig.A  -- углы в градусах: +X вперёд, +Y влево, +Z вправо; корпус вперёд — МИНУС X
--   local swing = Clip.new({
--       Duration = 0.7,          -- секунды (по умолчанию — время последнего ключа)
--       Loop = false,            -- true: после конца снова с начала (сегмент последний -> первый)
--       FadeIn = 0.1,            -- секунды, за которые слой плавно накрывает базовую позу
--       FadeOut = 0.25,          -- ...и плавно отдаёт её обратно в конце (без рывка в походку)
--       Additive = false,        -- true: позы ключей — ДОБАВКИ к базовой позе (вздрагивание на бегу)
--       Stiffness = 1.6,         -- множитель частоты пружин суставов, пока играет (резкие удары)
--       Keys = {
--           { T = 0,    Pose = { RArm = A(40, 0, 12), Root = A(0, 10, 0) } },
--           { T = 0.25, Pose = { RArm = A(175, 0, 12), Root = A(4, 14, 0) }, Ease = "SineInOut" },
--           { T = 0.38, Pose = { RArm = A(10, 0, 12), Root = A(-14, -12, 0) }, Ease = "CubicIn" },
--       },
--   })
--   Ease ключа описывает, КАК поза ПРИХОДИТ в этот ключ (сегмент от предыдущего ключа к этому).
--   Имена: Linear, SineIn/Out/InOut, QuadIn/Out/InOut, CubicIn/Out/InOut, BackIn/Out/InOut,
--   Elastic (мягкая пружинка в конце); можно передать и свою функцию (u: 0..1) -> число.
--   Back и Elastic выходят за 0..1 — поворот при этом честно экстраполируется (перелёт).
--
--   Каждый сустав — отдельная дорожка: значение берётся из ключей, где сустав указан,
--   и интерполируется между ними (до первого и после последнего — держится). Поэтому
--   в первом ключе укажите ВСЕ суставы, которые клип двигает. Не указанные ни в одном ключе
--   суставы остаются за базовой позой (походкой). Соседние ключи одного сустава должны
--   отличаться меньше чем на 180° (иначе поворот пойдёт коротким путём) — добавьте
--   промежуточный ключ. Clip.check проверяет это в тестах.
--
--   Ритм удара удобнее собирать строителем Clip.motion (подготовка -> действие -> захлёст ->
--   возврат), см. ниже. Пружины суставов (Spring.lua) добавят инерцию сверху — ключи можно
--   ставить «чисто», лёгкий перелёт появится сам.
--
-- ИСПОЛЬЗОВАНИЕ
--   Клип совместим с Poses.OneShot: у него есть Duration и Fn(a) (a — прогресс 0..1).
--   Poses.OneShot.Swing = swing   -- Animator сам накладывает его с FadeIn/FadeOut/Additive/Stiffness
--   Clip.sample(clip, t)          -- поза в момент t (секунды); для зацикленных Action: Clip.sample(loop, t)
--   Clip.layer(dst, layer, w)     -- наложить позу-слой с весом (на месте, в свою таблицу dst)
-- Возвращаемая поза — общая таблица клипа (без выделения памяти каждый кадр): прочитайте
-- или скопируйте её до следующего вызова для этого же клипа.
local Rig = require(script.Parent.Rig)

local Clip = {}

export type Pose = { [string]: any }
export type EaseFn = (number) -> number
export type Ease = string | EaseFn
export type Key = { T: number, Pose: Pose, Ease: Ease? }
export type Def = {
	Duration: number?,
	Loop: boolean?,
	FadeIn: number?,
	FadeOut: number?,
	Additive: boolean?,
	Stiffness: number?,
	Keys: { Key },
}

type Track = {
	Joint: string,
	IsVector: boolean,
	Times: { number },
	Values: { any },
	Eases: { EaseFn },
	-- для поворотов: ось и угол перехода от ключа i к ключу i+1 (i = n — переход к первому при Loop)
	Axes: { Vector3 },
	Angles: { number },
}

export type Clip = {
	Duration: number,
	Loop: boolean,
	FadeIn: number,
	FadeOut: number,
	FadeInEase: EaseFn,
	FadeOutEase: EaseFn,
	Additive: boolean,
	Stiffness: number?,
	Tracks: { Track },
	Out: Pose,
	Fn: (number, any?) -> Pose,
}

local pi, sin, cos, exp, clamp = math.pi, math.sin, math.cos, math.exp, math.clamp
local IDENTITY = CFrame.identity
local ZERO = Vector3.zero

------------------------------------------------------------------------
-- Плавности: u 0..1 -> 0..1 (Back/Elastic — с выходом за пределы)
------------------------------------------------------------------------

local C1 = 1.70158
local C2 = C1 * 1.525
local C3 = C1 + 1

local Ease: { [string]: EaseFn } = {
	Linear = function(u)
		return u
	end,
	SineIn = function(u)
		return 1 - cos(u * pi / 2)
	end,
	SineOut = function(u)
		return sin(u * pi / 2)
	end,
	SineInOut = function(u)
		return (1 - cos(pi * u)) / 2
	end,
	QuadIn = function(u)
		return u * u
	end,
	QuadOut = function(u)
		return 1 - (1 - u) * (1 - u)
	end,
	QuadInOut = function(u)
		return u < 0.5 and 2 * u * u or 1 - (-2 * u + 2) ^ 2 / 2
	end,
	CubicIn = function(u)
		return u * u * u
	end,
	CubicOut = function(u)
		return 1 - (1 - u) ^ 3
	end,
	CubicInOut = function(u)
		return u < 0.5 and 4 * u * u * u or 1 - (-2 * u + 2) ^ 3 / 2
	end,
	BackIn = function(u)
		return C3 * u * u * u - C1 * u * u
	end,
	BackOut = function(u)
		local v = u - 1
		return 1 + C3 * v * v * v + C1 * v * v
	end,
	BackInOut = function(u)
		if u < 0.5 then
			return ((2 * u) ^ 2 * ((C2 + 1) * 2 * u - C2)) / 2
		end
		return ((2 * u - 2) ^ 2 * ((C2 + 1) * (u * 2 - 2) + C2) + 2) / 2
	end,
	-- Мягкая пружинка: перелёт ~13%, затем ~2% недолёт и покой; ровно 0 и 1 на концах
	Elastic = function(u)
		return 1 - (exp(-6 * u) * cos(3 * pi * u) - u * exp(-6) * cos(3 * pi))
	end,
}
Clip.Ease = Ease

local function easeFn(e: Ease?): EaseFn
	if e == nil then
		return Ease.Linear
	elseif type(e) == "function" then
		return e
	end
	local fn = Ease[e :: string]
	assert(fn, "Clip: неизвестная плавность " .. tostring(e))
	return fn
end
Clip.easeFn = easeFn

------------------------------------------------------------------------
-- Построение
------------------------------------------------------------------------

-- Переход a -> b кратчайшим путём: ось и угол (0..π)
local function segmentDelta(a: CFrame, b: CFrame): (Vector3, number)
	local v = Rig.rotVec(a:Inverse() * b)
	local angle = v.Magnitude
	if angle < 1e-6 then
		return ZERO, 0
	end
	return v / angle, angle
end

local function buildTrack(joint: string, keys: { Key }, loop: boolean): Track?
	local track: Track = {
		Joint = joint,
		IsVector = joint == "RootPos",
		Times = {},
		Values = {},
		Eases = {},
		Axes = {},
		Angles = {},
	}
	for _, key in keys do
		local v = key.Pose[joint]
		if v ~= nil then
			table.insert(track.Times, key.T)
			table.insert(track.Values, v)
			table.insert(track.Eases, easeFn(key.Ease))
		end
	end
	local n = #track.Times
	if n == 0 then
		return nil
	end
	if not track.IsVector then
		for i = 1, n do
			local j = i < n and i + 1 or (loop and 1 or nil)
			if j then
				track.Axes[i], track.Angles[i] = segmentDelta(track.Values[i], track.Values[j])
			else
				track.Axes[i], track.Angles[i] = ZERO, 0
			end
		end
	end
	return track
end

function Clip.new(def: Def): Clip
	local keys = table.clone(def.Keys)
	assert(#keys > 0, "Clip: нужен хотя бы один ключ")
	table.sort(keys, function(a, b)
		return a.T < b.T
	end)
	local loop = def.Loop == true
	local duration = def.Duration or keys[#keys].T
	assert(duration > 0, "Clip: Duration должна быть больше нуля")
	local joints = {}
	for _, key in keys do
		for joint in key.Pose do
			joints[joint] = true
		end
	end
	local tracks = {}
	for joint in joints do
		local track = buildTrack(joint, keys, loop)
		if track then
			table.insert(tracks, track)
		end
	end
	table.sort(tracks, function(a, b)
		return a.Joint < b.Joint
	end)
	local clip: Clip = {
		Duration = duration,
		Loop = loop,
		FadeIn = def.FadeIn or 0,
		FadeOut = def.FadeOut or 0,
		FadeInEase = Ease.SineInOut,
		FadeOutEase = Ease.SineInOut,
		Additive = def.Additive == true,
		Stiffness = def.Stiffness,
		Tracks = tracks,
		Out = {},
		Fn = nil :: any,
	}
	clip.Fn = function(a: number): Pose
		return Clip.sample(clip, a * clip.Duration)
	end
	return clip
end

------------------------------------------------------------------------
-- Выборка
------------------------------------------------------------------------

local function interp(track: Track, i: number, j: number, a: number): any
	local from = track.Values[i]
	if track.IsVector then
		local to = track.Values[j]
		return from + (to - from) * a
	end
	local angle = track.Angles[i]
	if angle == 0 or a == 0 then
		return from
	end
	return from * CFrame.fromAxisAngle(track.Axes[i], angle * a)
end

local function sampleTrack(track: Track, t: number, duration: number, loop: boolean): any
	local times = track.Times
	local n = #times
	if n == 1 then
		return track.Values[1]
	end
	if t < times[1] or t >= times[n] then
		if not loop then
			return t < times[1] and track.Values[1] or track.Values[n]
		end
		-- сегмент «последний -> первый» через конец цикла
		local span = duration - times[n] + times[1]
		local local_t = t >= times[n] and t - times[n] or t + duration - times[n]
		local u = span > 1e-6 and clamp(local_t / span, 0, 1) or 1
		return interp(track, n, 1, track.Eases[1](u))
	end
	for i = 1, n - 1 do
		local t1 = times[i + 1]
		if t < t1 then
			local t0 = times[i]
			local u = t1 > t0 and (t - t0) / (t1 - t0) or 1
			return interp(track, i, i + 1, track.Eases[i + 1](u))
		end
	end
	return track.Values[n]
end

-- Поза клипа в момент t (секунды). Пишет в out (по умолчанию — общая таблица клипа).
function Clip.sample(clip: Clip, t: number, out: Pose?): Pose
	local dst = out or clip.Out
	local d = clip.Duration
	if clip.Loop then
		t = t % d
	else
		t = clamp(t, 0, d)
	end
	for _, track in clip.Tracks do
		dst[track.Joint] = sampleTrack(track, t, d, clip.Loop)
	end
	return dst
end

-- Вес слоя в момент t (секунды от начала): плавный вход FadeIn и выход FadeOut.
-- Работает для любого описания с полями Duration/FadeIn/FadeOut (и для старых OneShot).
function Clip.weight(def: any, t: number): number
	local w = 1
	local fadeIn = def.FadeIn or 0
	if fadeIn > 0 and t < fadeIn then
		w = (def.FadeInEase or Ease.SineInOut)(clamp(t / fadeIn, 0, 1))
	end
	local fadeOut = def.FadeOut or 0
	if fadeOut > 0 and not def.Loop then
		local left = def.Duration - t
		if left < fadeOut then
			w = math.min(w, (def.FadeOutEase or Ease.SineInOut)(clamp(left / fadeOut, 0, 1)))
		end
	end
	return clamp(w, 0, 1)
end

------------------------------------------------------------------------
-- Слои
------------------------------------------------------------------------

local LAYER_KEYS = { "Root", "Neck", "LArm", "RArm", "LLeg", "RLeg", "RootPos" }
Clip.Keys = LAYER_KEYS

-- Копия позы в свою таблицу dst (без выделения памяти)
function Clip.copy(src: Pose, dst: Pose): Pose
	for _, k in LAYER_KEYS do
		dst[k] = src[k]
	end
	return dst
end

-- Наложить позу layer на dst с весом w (dst меняется на месте — это должна быть ВАША таблица).
--   обычный слой: сустав плавно заменяется позой слоя (w = 1 — полностью);
--   additive: поворот слоя ДОБАВЛЯЕТСЯ к базовому (base * delta^w), RootPos складывается.
-- Суставы, которых нет в layer, не трогаются.
function Clip.layer(dst: Pose, layer: Pose, w: number, additive: boolean?): Pose
	if w <= 0 then
		return dst
	end
	for _, k in LAYER_KEYS do
		local v = layer[k]
		if v == nil then
			continue
		end
		local base = dst[k]
		if k == "RootPos" then
			local b = base or ZERO
			if additive then
				dst[k] = b + v * w
			else
				dst[k] = w >= 1 and v or b + (v - b) * w
			end
		elseif additive then
			dst[k] = (base or IDENTITY) * (w >= 1 and v or IDENTITY:Lerp(v, w))
		elseif w >= 1 then
			dst[k] = v
		else
			dst[k] = (base or IDENTITY):Lerp(v, w)
		end
	end
	return dst
end

-- Смешать две позы: out = a·(1-w) + b·w по каждому суставу (для смены походок и т.п.)
function Clip.blend(a: Pose, b: Pose, w: number, out: Pose): Pose
	for _, k in LAYER_KEYS do
		local va, vb = a[k], b[k]
		if va == nil and vb == nil then
			out[k] = nil
		elseif k == "RootPos" then
			local pa, pb = va or ZERO, vb or ZERO
			out[k] = pa + (pb - pa) * w
		else
			out[k] = (va or IDENTITY):Lerp(vb or IDENTITY, w)
		end
	end
	return out
end

------------------------------------------------------------------------
-- Строитель удара: подготовка -> действие -> захлёст -> (пауза) -> возврат
------------------------------------------------------------------------

export type Phase = { Time: number, Pose: Pose?, Ease: Ease? }
export type MotionDef = {
	Anticipation: Phase?, -- замах/подготовка: поза набирается из базовой за Time
	Action: Phase, -- само действие: быстрый переход в позу (обычно CubicIn/QuadIn)
	FollowThrough: Phase?, -- захлёст за точку удара (обычно CubicOut/BackOut)
	Hold: number?, -- секунды держать последнюю позу
	Recover: Phase?, -- плавный возврат в базовую позу (вес слоя -> 0)
	Additive: boolean?,
	Stiffness: number?,
}

-- Каждая фаза без Pose держит предыдущую. Суставы, впервые появившиеся в поздней фазе,
-- копируются в ранние (держатся с начала), поэтому удобнее перечислять всё в Anticipation.
function Clip.motion(def: MotionDef): Clip
	local phases = {}
	if def.Anticipation then
		table.insert(phases, def.Anticipation)
	end
	table.insert(phases, def.Action)
	if def.FollowThrough then
		table.insert(phases, def.FollowThrough)
	end
	-- накопительные позы: каждая фаза наследует суставы предыдущей
	local poses = {}
	local acc = {}
	for i, ph in phases do
		for k, v in ph.Pose or {} do
			acc[k] = v
		end
		poses[i] = table.clone(acc)
	end
	for i = #phases - 1, 1, -1 do
		for k, v in poses[i + 1] do
			if poses[i][k] == nil then
				poses[i][k] = v
			end
		end
	end
	local keys = {}
	local t = 0
	for i, ph in phases do
		t += ph.Time
		table.insert(keys, { T = t, Pose = poses[i], Ease = i == 1 and "Linear" or ph.Ease })
	end
	if def.Hold and def.Hold > 0 then
		t += def.Hold
		table.insert(keys, { T = t, Pose = poses[#poses], Ease = "Linear" })
	end
	local recover = def.Recover
	local first = phases[1]
	local clip = Clip.new({
		Duration = t + (recover and recover.Time or 0),
		FadeIn = first.Time,
		FadeOut = recover and recover.Time or 0,
		Additive = def.Additive,
		Stiffness = def.Stiffness,
		Keys = keys,
	})
	clip.FadeInEase = easeFn(first.Ease or "SineInOut")
	clip.FadeOutEase = easeFn(recover and recover.Ease or "SineInOut")
	return clip
end

------------------------------------------------------------------------
-- Проверка (для тестов): шаги > 175° между ключами, нечисла
------------------------------------------------------------------------

function Clip.check(clip: Clip): { string }
	local issues = {}
	for _, track in clip.Tracks do
		for i, v in track.Values do
			if track.IsVector then
				if v.X ~= v.X or v.Y ~= v.Y or v.Z ~= v.Z then
					table.insert(issues, ("%s: ключ %d — не число"):format(track.Joint, i))
				end
			elseif track.Angles[i] and track.Angles[i] > math.rad(175) then
				table.insert(issues, ("%s: ключи %d->%d отличаются почти на 180°"):format(track.Joint, i, i + 1))
			end
		end
	end
	return issues
end

return Clip
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Clips</string>
            <string name="Source"><![CDATA[-- Одноразовые анимации (Poses.OneShot) — ключевые клипы Anim/Clip.lua.
-- Ритм: подготовка -> действие -> захлёст -> возврат; голова и свободная рука запаздывают,
-- вес переносится через таз (корпус поворачивается вокруг таза, ноги не уезжают).
--
-- Два вида клипов:
--   * всё тело (обычный слой): позы ключей собирает body{} — корпус поворачивается вокруг таза,
--     ноги задаются МИРОВЫМИ углами (относительно HumanoidRootPart), руки и голова — в пространстве
--     торса. Для случаев, когда персонаж стоит или его двигает сервер (прыжок в окно, крюк).
--   * верх тела (Upper = true, ключи собирает up{}): персонаж может бежать. Корпус ключа — ДОБАВКА
--     к корпусу походки (поворот вокруг таза), RootPos — сдвиг таза, ноги походки сохраняют мировое
--     положение (ноги ключа применяются, только пока персонаж стоит), руки и голова — как обычно.
-- Clips.apply накладывает любой из них (Animator, превью, тесты).
--
-- Поля сверх Clip: Upper; Follows — имя клипа, из позы которого этот начинается без FadeIn
-- (Wipe после Swing, Throw после Windup).
--
-- Длительности = серверные времена (Config, KillerDefs, Systems/*, Powers/*):
--   Swing 0.7 (выпад KillerLungeTime 0.35), Wipe 2.4 (замедление после удара 2.7),
--   Stun 2.2 (PalletStunTime), Blind 2.5 (BlindDuration), Vault 0.55 / VaultWalk 0.95 (Obstacles:
--   с бега / шагом — сервер везёт корень вверх на 2.2 к середине и вниз), KillerVault 1.6,
--   PalletDrop 0.6 (удар паллеты о землю на 0.22), Windup — держится до Throw/Cancel (30),
--   Throw 0.45, Bell 1.5 (CloakTime) / BellUncloak 1.0 (UncloakTime), Pickup 0.8, Flinch 0.45,
--   HookScream 1.4, Entity 2.8 (Сущность поднимает тело с 1.6 по 2.8).
local Rig = require(script.Parent.Rig)
local Clip = require(script.Parent.Clip)
local Life = require(script.Parent.Life)

local Clips = {}

type Pose = Clip.Pose

local rad, clamp = math.rad, math.clamp
local A = Rig.A
local V = Vector3.new
local YXZ = CFrame.fromEulerAnglesYXZ
local IDENTITY = CFrame.identity
local ZERO = Vector3.zero
local DOWN = Vector3.new(0, -1, 0)

------------------------------------------------------------------------
-- Помощники авторинга
------------------------------------------------------------------------

-- Рука/нога вдоль направления (x вправо, y вверх, z назад — в пространстве родителя;
-- вперёд — минус z) с поворотом twist (°) вокруг своей оси (куда смотрит оружие в руке)
local function aim(x: number, y: number, z: number, twist: number?): CFrame
	local cf = Rig.aim(V(x, y, z))
	return twist and cf * CFrame.Angles(0, rad(twist), 0) or cf
end
Clips.aim = aim

-- Как Rig.A(x, 0, z), но с поворотом twist вокруг оси конечности (направление не меняется)
local function AT(x: number, z: number, twist: number): CFrame
	return A(x, 0, z) * CFrame.Angles(0, rad(twist), 0)
end
Clips.AT = AT

-- Корпус: наклон вперёд, поворот влево, крен влево (правое плечо вверх), в градусах
local function torso(lean: number?, turn: number?, roll: number?): CFrame
	return YXZ(rad(-(lean or 0)), rad(turn or 0), rad(roll or 0))
end

export type Spec = {
	lean: number?,
	turn: number?,
	roll: number?,
	hip: Vector3?, -- сдвиг таза (стады): +X вправо, +Y вверх, +Z назад
	ll: CFrame?, -- ноги — мировые углы
	rl: CFrame?,
	la: CFrame?, -- руки и голова — в пространстве торса
	ra: CFrame?,
	neck: CFrame?,
}

-- Поза всего тела. center = true — корпус вращается вокруг своего центра (висит на крюке),
-- иначе вокруг таза (стоит на ногах); hip — сдвиг этой точки от положения стоя.
local function body(s: Spec, center: boolean?): Pose
	local r = torso(s.lean, s.turn, s.roll)
	local inv = r:Inverse()
	local hip = s.hip or ZERO
	return {
		Root = r,
		RootPos = if center then hip else hip + DOWN + r.UpVector,
		LLeg = inv * (s.ll or IDENTITY),
		RLeg = inv * (s.rl or IDENTITY),
		LArm = s.la,
		RArm = s.ra,
		Neck = s.neck,
	}
end
Clips.body = body

local function hang(s: Spec): Pose
	return body(s, true)
end

-- Кадр «верха тела» (см. шапку): корпус и таз — добавки, ноги — мировые углы (необязательно)
local function up(s: Spec): Pose
	return {
		Root = torso(s.lean, s.turn, s.roll),
		RootPos = s.hip or ZERO,
		LLeg = s.ll,
		RLeg = s.rl,
		LArm = s.la,
		RArm = s.ra,
		Neck = s.neck,
	}
end

local function K(t: number, pose: Pose, ease: Clip.Ease?): Clip.Key
	return { T = t, Pose = pose, Ease = ease }
end
Clips.K = K

local function upperClip(def: Clip.Def): Clip.Clip
	local clip = Clip.new(def);
	(clip :: any).Upper = true
	return clip
end

------------------------------------------------------------------------
-- Наложение
------------------------------------------------------------------------

local LEGS = { "LLeg", "RLeg" }
local TOP = { "Neck", "LArm", "RArm" }

-- Слой «верх тела» с весом w: корпус поворачивается вокруг таза походки, стопы остаются на месте
local function layerUpper(dst: Pose, f: Pose, w: number, legW: number)
	local r = dst.Root or IDENTITY
	local hip = (dst.RootPos or ZERO) - r.UpVector
	local d = f.Root
	local r2 = r
	if d then
		r2 = r * (if w >= 1 then d else IDENTITY:Lerp(d, w))
	end
	local off = f.RootPos
	if off then
		hip += off * w
	end
	dst.Root = r2
	dst.RootPos = hip + r2.UpVector
	local inv = r2:Inverse()
	for _, leg in LEGS do
		local world = r * (dst[leg] or IDENTITY)
		local lw = f[leg]
		if lw and legW > 0 then
			world = world:Lerp(lw, legW)
		end
		dst[leg] = inv * world
	end
	for _, k in TOP do
		local v = f[k]
		if v then
			dst[k] = if w >= 1 then v else (dst[k] or IDENTITY):Lerp(v, w)
		end
	end
end

-- Наложить одноразовую анимацию def на позу dst (своя таблица) в момент elapsed (с) от начала.
-- fade — дополнительный множитель веса (плавная отмена). Возвращает множитель жёсткости пружин.
function Clips.apply(dst: Pose, def: any, elapsed: number, p: any?, fade: number?): number
	local w = Clip.weight(def, elapsed) * (fade or 1)
	if w <= 0 then
		return 1
	end
	local frame = def.Fn(clamp(elapsed / def.Duration, 0, 1), p)
	if def.Upper then
		-- ноги клипа — только пока стоит (на бегу ноги ведёт походка)
		local speed = p and p.Speed or 0
		layerUpper(dst, frame, w, w * clamp(1 - (speed - 1) / 3, 0, 1))
	else
		Clip.layer(dst, frame, w, def.Additive)
	end
	return 1 + ((def.Stiffness or 1) - 1) * w
end

-- Колокол Призрака: исчезнуть — 1.5 с, проявиться — 1 с (сервер шлёт одно имя "Bell").
-- Прыжок через окно сервер выбирает сам: "Vault" (с бега, 0.55 с) или "VaultWalk" (шагом, 0.95 с).
function Clips.variant(name: string, _running: boolean, powerState: any): string
	if name == "Bell" and (powerState == "Uncloaking" or powerState == "Cloaked") then
		return "BellUncloak"
	end
	return name
end

local OneShot = {}
Clips.OneShot = OneShot

------------------------------------------------------------------------
-- Маньяк: удар (0.7 с, выпад 0.35 с) — замах за плечо со скруткой корпуса, быстрый диагональный
-- удар с выпадом, корпус проваливается следом, тяжёлый возврат.
------------------------------------------------------------------------

local SWING_FOLLOW = {
	lean = 22,
	turn = 30,
	roll = -12,
	hip = V(0, -0.22, -0.12),
	la = A(-28, 0, -30),
	ra = aim(-0.35, -0.75, -0.55),
	neck = A(8, -22, 8),
}

OneShot.Swing = upperClip({
	Duration = 0.7,
	FadeIn = 0.06,
	FadeOut = 0.26,
	Stiffness = 1.7,
	Keys = {
		K(0, up({ la = A(12, 0, -12), ra = A(26, 0, 14), neck = A(0, 0, 0) })),
		-- рука идёт вперёд-вверх (а не назад через низ)
		K(0.07, up({ lean = -2, turn = -12, roll = 3, la = A(40, 0, -22), ra = aim(0.5, 0.55, -0.67), neck = A(-2, 10, -2) }), "SineIn"),
		-- замах: оружие за правым плечом, корпус скручен вправо и чуть назад, левая рука — вперёд
		K(0.15, up({ lean = -6, turn = -28, roll = 8, hip = V(0, -0.03, 0.08), la = A(66, 0, -30), ra = aim(0.45, 0.8, 0.4), neck = A(-4, 24, -6) }), "QuadOut"),
		-- удар по диагонали: сверху справа вниз влево, корпус раскручивается, вес — вперёд
		K(0.205, up({ lean = 2, turn = -8, roll = 2, hip = V(0, -0.08, 0), la = A(45, 0, -28), ra = aim(0.25, 0.7, -0.65), neck = A(-2, 8, 0) }), "QuadIn"),
		K(0.26, up({ lean = 14, turn = 18, roll = -8, hip = V(0, -0.16, -0.08), la = A(-10, 0, -32), ra = aim(-0.45, -0.45, -0.77), neck = A(4, -14, 6) })),
		K(0.36, up(SWING_FOLLOW), "QuadOut"),
		-- оружие тяжёлое: рука висит, корпус выпрямляется не сразу
		K(0.5, up({ lean = 14, turn = 18, roll = -6, hip = V(0, -0.14, -0.06), la = A(-12, 0, -20), ra = aim(-0.05, -0.85, -0.45), neck = A(4, -14, 4) }), "SineInOut"),
	},
})

-- После попадания (2.4 с, маньяк медленно идёт): доводит удар, выпрямляется, проводит клинком
-- по левой руке (дважды), стряхивает и опускает оружие; голова склонена набок.
OneShot.Wipe = upperClip({
	Duration = 2.4,
	FadeIn = 0,
	FadeOut = 0.5,
	Stiffness = 1.15,
	Keys = {
		K(0, up(SWING_FOLLOW)),
		K(0.3, up({ lean = 8, turn = 8, roll = -3, hip = V(0, -0.06, -0.02), la = A(5, 0, -14), ra = A(30, 0, 4), neck = A(2, -8, 0) }), "SineInOut"),
		-- клинок поперёк груди (смотрит влево), левая рука под ним
		K(0.7, up({ lean = 10, turn = -10, la = aim(0.55, -0.2, -0.81), ra = aim(-0.35, -0.05, -0.94, 85), neck = A(-24, 14, 14) }), "SineInOut"),
		K(1.05, up({ lean = 10, turn = -6, la = aim(0.5, -0.25, -0.83), ra = aim(0.15, -0.05, -0.99, 85), neck = A(-24, 6, 14) }), "SineInOut"),
		K(1.25, up({ lean = 10, turn = -10, la = aim(0.55, -0.2, -0.81), ra = aim(-0.35, -0.05, -0.94, 85), neck = A(-22, 12, 12) }), "SineInOut"),
		K(1.5, up({ lean = 9, turn = -4, la = aim(0.48, -0.28, -0.83), ra = aim(0.3, -0.1, -0.95, 85), neck = A(-20, 0, 10) }), "QuadIn"),
		-- стряхивает кровь
		K(1.62, up({ lean = 8, turn = 2, la = A(30, 0, -10), ra = aim(0.5, -0.35, -0.79, 60), neck = A(-10, -6, 8) }), "QuadOut"),
		K(2.0, up({ lean = 6, la = A(8, 0, -12), ra = A(22, 0, 12), neck = A(-4, 0, 10) }), "SineInOut"),
	},
})

------------------------------------------------------------------------
-- Маньяк оглушён паллетой (2.2 с, стоит): отлетает назад, хватается левой за голову, оружие
-- в опущенной правой, два шага назад, трясёт головой, приходит в себя.
------------------------------------------------------------------------

local HOLD_HEAD = aim(0.4, 0.78, -0.47)

OneShot.Stun = Clip.new({
	Duration = 2.2,
	FadeIn = 0.05,
	FadeOut = 0.45,
	Stiffness = 1.35,
	Keys = {
		K(0, body({ lean = 6, ll = A(0, 0, -3), rl = A(0, 0, 3), la = A(6, 0, -9), ra = A(16, 0, 12), neck = A(0, 0, 0) })),
		-- удар: голову откидывает, руки разлетаются
		K(0.08, body({ lean = -16, turn = 8, roll = -6, hip = V(0, -0.02, 0.22), ll = A(8, 0, -6), rl = A(14, 0, 8), la = A(60, 0, -50), ra = A(40, 0, 45), neck = A(30, -10, 8) }), "QuadOut"),
		-- сгибается, держится за голову, шаг назад правой
		K(0.3, body({ lean = 24, turn = 12, roll = 6, hip = V(0.08, -0.08, 0.32), ll = A(16, 0, -8), rl = A(-18, 0, 8), la = HOLD_HEAD, ra = A(-6, 0, 22), neck = A(-28, 12, -10) }), "SineInOut"),
		-- шаг назад левой, шатается
		K(0.62, body({ lean = 28, turn = -8, roll = -8, hip = V(-0.08, -0.1, 0.4), ll = A(-20, 0, -12), rl = A(18, 0, 10), la = aim(0.36, 0.76, -0.52), ra = A(-2, 0, 18), neck = A(-32, -10, 8) }), "SineInOut"),
		-- широко стоит, трясёт головой
		K(0.95, body({ lean = 24, turn = 6, roll = 4, hip = V(0, -0.1, 0.4), ll = A(-12, 0, -12), rl = A(12, 0, 10), la = HOLD_HEAD, ra = A(-4, 0, 20), neck = A(-24, 16, -6) }), "SineInOut"),
		K(1.18, body({ lean = 25, turn = -4, roll = 2, hip = V(0, -0.1, 0.4), ll = A(-12, 0, -12), rl = A(12, 0, 10), la = aim(0.42, 0.74, -0.52), ra = A(-2, 0, 20), neck = A(-26, -16, 6) }), "SineInOut"),
		K(1.42, body({ lean = 22, turn = 4, roll = 3, hip = V(0, -0.09, 0.36), ll = A(-10, 0, -10), rl = A(10, 0, 9), la = HOLD_HEAD, ra = A(0, 0, 18), neck = A(-20, 12, -4) }), "SineInOut"),
		-- выпрямляется, рука опускается
		K(1.78, body({ lean = 10, hip = V(0, -0.04, 0.2), ll = A(-6, 0, -6), rl = A(6, 0, 6), la = A(30, 0, -14), ra = A(10, 0, 14), neck = A(-8, 4, 0) }), "SineInOut"),
	},
})

------------------------------------------------------------------------
-- Маньяк ослеплён (2.5 с, может идти): закрывает глаза руками, отворачивает голову,
-- пошатывается, трёт глаза, опускает руки.
------------------------------------------------------------------------

OneShot.Blind = upperClip({
	Duration = 2.5,
	FadeIn = 0.06,
	FadeOut = 0.5,
	Stiffness = 1.3,
	Keys = {
		K(0, up({ la = A(8, 0, -10), ra = A(16, 0, 12), neck = A(0, 0, 0) })),
		K(0.1, up({ lean = -12, turn = 10, hip = V(0, 0, 0.12), la = aim(0.45, 0.62, -0.64), ra = aim(-0.35, 0.55, -0.76), neck = A(10, 35, 0) }), "QuadOut"),
		K(0.45, up({ lean = -4, turn = -14, roll = 6, hip = V(0.05, -0.05, 0.18), la = aim(0.5, 0.58, -0.64), ra = aim(-0.3, 0.5, -0.8), neck = A(-8, -30, 6) }), "SineInOut"),
		K(0.8, up({ lean = 6, turn = 12, roll = -6, hip = V(-0.05, -0.07, 0.16), la = aim(0.42, 0.66, -0.62), ra = aim(-0.38, 0.58, -0.72), neck = A(-14, 28, -6) }), "SineInOut"),
		-- трёт глаза
		K(1.15, up({ lean = 10, turn = -8, roll = 4, hip = V(0, -0.08, 0.1), la = aim(0.48, 0.52, -0.7), ra = aim(-0.25, 0.42, -0.87), neck = A(-18, -20, 8) }), "SineInOut"),
		K(1.5, up({ lean = 8, turn = 6, roll = -3, hip = V(0, -0.06, 0.06), la = aim(0.4, 0.62, -0.67), ra = A(40, 0, 20), neck = A(-12, 14, -4) }), "SineInOut"),
		K(1.95, up({ lean = 4, la = A(55, 0, 10), ra = A(25, 0, 14), neck = A(-6, 8, 0) }), "SineInOut"),
	},
})

------------------------------------------------------------------------
-- Маньяк поднимает выжившего (0.8 с): наклоняется и хватает, рывком закидывает на правое плечо
-- (сервер кладёт тело на правое плечо, походка Carry держит его правой), оседает под весом.
------------------------------------------------------------------------

OneShot.Pickup = upperClip({
	Duration = 0.8,
	FadeIn = 0.1,
	FadeOut = 0.28,
	Stiffness = 1.3,
	Keys = {
		K(0, up({ ll = A(0, 0, -2), rl = A(0, 0, 2), la = A(8, 0, -10), ra = A(30, 0, 10), neck = A(0, 0, 0) })),
		K(0.18, up({ lean = 28, turn = -10, roll = -4, hip = V(0, -0.22, 0.1), ll = A(22, 0, -8), rl = A(-14, 0, 8), la = A(55, 0, -12), ra = A(62, 0, 6), neck = A(20, 0, 0) }), "SineOut"),
		K(0.36, up({ lean = -6, turn = 6, roll = 9, hip = V(0, 0.06, 0), ll = A(6, 0, -6), rl = A(-6, 0, 6), la = A(-25, 0, -24), ra = A(140, 0, 12), neck = A(-6, -6, 0) }), "BackOut"),
		K(0.52, up({ lean = 8, roll = 4, hip = V(0, -0.1, 0), ll = A(4, 0, -5), rl = A(-4, 0, 5), la = A(5, 0, -14), ra = A(134, 0, 10), neck = A(-10, 0, 0) }), "SineInOut"),
	},
})

------------------------------------------------------------------------
-- Выживший опускает паллету (0.6 с, удар о землю на 0.22): хватает сверху двумя руками,
-- рывком роняет вперёд всем корпусом, оглядывается.
------------------------------------------------------------------------

OneShot.PalletDrop = upperClip({
	Duration = 0.6,
	FadeIn = 0.05,
	FadeOut = 0.25,
	Stiffness = 1.5,
	Keys = {
		K(0, up({ la = A(10, 0, -8), ra = A(10, 0, 8), neck = A(0, 0, 0) })),
		K(0.09, up({ lean = -6, hip = V(0, 0.05, 0), la = aim(-0.25, 0.75, -0.6), ra = aim(0.25, 0.75, -0.6), neck = A(14, 0, 0) }), "QuadOut"),
		K(0.22, up({ lean = 26, turn = 4, roll = -3, hip = V(0, -0.18, -0.08), la = A(45, 0, -16), ra = A(50, 0, 14), neck = A(4, 0, 0) }), "CubicIn"),
		K(0.32, up({ lean = 32, turn = 6, roll = -4, hip = V(0, -0.22, -0.1), la = A(20, 0, -20), ra = A(28, 0, 18), neck = A(8, 10, 0) }), "QuadOut"),
		K(0.42, up({ lean = 14, turn = 10, hip = V(0, -0.08, 0), la = A(10, 0, -14), ra = A(12, 0, 12), neck = A(2, 30, 0) }), "SineInOut"),
	},
})

------------------------------------------------------------------------
-- Выжившего ударили (0.45 с, бежит с ускорением): удар в спину выгибает, затем резкий рывок
-- вперёд, руки болтаются, спотыкается и переходит в бег.
------------------------------------------------------------------------

OneShot.Flinch = upperClip({
	Duration = 0.45,
	FadeIn = 0.03,
	FadeOut = 0.22,
	Stiffness = 1.9,
	Keys = {
		K(0, up({ la = A(10, 0, -8), ra = A(10, 0, 8), neck = A(0, 0, 0) })),
		K(0.05, up({ lean = -14, turn = -6, roll = 8, hip = V(0, 0.04, -0.12), la = A(-35, 0, -40), ra = A(-25, 0, 45), neck = A(24, 8, 0) }), "QuadOut"),
		K(0.16, up({ lean = 26, turn = 10, roll = -6, hip = V(0, -0.14, -0.1), la = A(75, 0, -50), ra = A(30, 0, 55), neck = A(-14, -6, 4) }), "QuadOut"),
		K(0.27, up({ lean = 18, turn = -4, roll = 4, hip = V(0, -0.08, 0), la = A(40, 0, -30), ra = A(-20, 0, 30), neck = A(-6, 4, 0) }), "SineInOut"),
	},
})

------------------------------------------------------------------------
-- Охотница: замах топором (держится, пока заряжает — до Throw или Cancel) и бросок
------------------------------------------------------------------------

local WINDUP_FULL = {
	lean = -14,
	turn = -32,
	roll = 8,
	hip = V(0, -0.06, 0.12),
	la = aim(-0.36, 0.1, -0.93),
	ra = aim(0.32, 0.6, 0.73),
	neck = A(-2, 30, -6),
}
local FULL_WINDUP_TIME = 1.3 -- KillerDefs.Huntress.FullWindup

local windup = upperClip({
	Duration = 30,
	FadeIn = 0.08,
	FadeOut = 0.3,
	Keys = {
		K(0, up({ la = A(10, 0, -10), ra = A(25, 0, 12), neck = A(0, 0, 0) })),
		-- топор высоко за головой, корпус отклонён назад, левая рука вперёд — целится
		K(0.3, up({ lean = -10, turn = -24, roll = 6, hip = V(0, -0.04, 0.08), la = aim(-0.42, 0.05, -0.91), ra = aim(0.3, 0.72, 0.62), neck = A(-2, 22, -4) }), "QuadOut"),
		-- набирает силу броска до полного замаха
		K(FULL_WINDUP_TIME, up(WINDUP_FULL), "SineInOut"),
	},
})
do
	local sample = windup.Fn
	local sin = math.sin
	windup.Fn = function(a: number, p: any?): Pose
		local pose = sample(a, p)
		local t = a * windup.Duration
		if t > FULL_WINDUP_TIME then
			-- полный замах: рука подрагивает от напряжения, корпус чуть покачивается
			local k = math.min((t - FULL_WINDUP_TIME) / 0.5, 1)
			pose.RArm = pose.RArm * CFrame.Angles(rad(sin(t * 31) * 1.6 * k), 0, rad(sin(t * 23) * 1.2 * k))
			pose.Root = pose.Root * CFrame.Angles(rad(sin(t * 1.7) * 1.2 * k), rad(sin(t * 2.3) * 1.5 * k), 0)
		end
		return pose
	end
end
OneShot.Windup = windup

-- Бросок: ещё чуть назад, хлёсткий выброс руки с полным разворотом корпуса, захлёст вниз-влево
local throw = upperClip({
	Duration = 0.45,
	FadeIn = 0,
	FadeOut = 0.2,
	Stiffness = 1.8,
	Keys = {
		K(0, up(WINDUP_FULL)),
		K(0.05, up({ lean = -16, turn = -36, roll = 9, hip = V(0, -0.06, 0.14), la = aim(-0.3, 0.12, -0.95), ra = aim(0.3, 0.55, 0.78), neck = A(-2, 32, -6) }), "QuadOut"),
		K(0.12, up({ lean = 6, turn = 6, roll = -2, hip = V(0, -0.1, 0), la = A(10, 0, -30), ra = aim(0.12, 0.6, -0.79), neck = A(0, 0, 0) }), "CubicIn"),
		K(0.2, up({ lean = 20, turn = 28, roll = -8, hip = V(0, -0.16, -0.1), la = A(-30, 0, -28), ra = aim(-0.3, -0.35, -0.89), neck = A(6, -26, 4) })),
		K(0.3, up({ lean = 24, turn = 36, roll = -10, hip = V(0, -0.18, -0.12), la = A(-36, 0, -24), ra = aim(-0.45, -0.7, -0.55), neck = A(8, -32, 6) }), "QuadOut"),
	},
});
(throw :: any).Follows = "Windup"
OneShot.Throw = throw;
(OneShot.Wipe :: any).Follows = "Swing"

------------------------------------------------------------------------
-- Призрак: колокол в левой руке. Поднимает, звонит резкими встряхиваниями, голова склонена.
------------------------------------------------------------------------

local function bell(duration: number, rings: number): Clip.Clip
	local lift = duration * 0.18
	local lower = duration * 0.78
	local keys = {
		K(0, up({ la = A(52, 0, -12), ra = A(16, 0, 12), neck = A(0, 0, 0) })),
		K(lift, up({ lean = 8, turn = 10, la = AT(116, -8, 0), ra = A(28, 0, 18), neck = A(-28, 0, 4) }), "SineOut"),
	}
	local from, to = lift + 0.04, lower - 0.1
	for i = 1, rings do
		local s = i % 2 == 1 and 1 or -1
		local t = from + (to - from) * (i - 1) / math.max(rings - 1, 1)
		table.insert(keys, K(t, up({ lean = 8 + s, turn = 10, roll = s * 2, la = AT(116 + s * 7, -8, s * 24), ra = A(28, 0, 18), neck = A(-30 + s, 0, 4) }), "BackOut"))
	end
	table.insert(keys, K(lower, up({ lean = 5, turn = 4, la = A(64, 0, -12), ra = A(20, 0, 14), neck = A(-16, 0, 2) }), "SineInOut"))
	return upperClip({ Duration = duration, FadeIn = 0.1, FadeOut = duration - lower + 0.05, Keys = keys })
end
OneShot.Bell = bell(1.5, 7)
OneShot.BellUncloak = bell(1.0, 5)

------------------------------------------------------------------------
-- На крюке: крик (1.4 с) — выгибается, рвётся вверх к крюку, болтает ногами, обмякает.
-- Корпус вращается вокруг центра (тело висит на крюке, а не стоит на ногах).
------------------------------------------------------------------------

OneShot.HookScream = Clip.new({
	Duration = 1.4,
	FadeIn = 0.06,
	FadeOut = 0.45,
	Stiffness = 1.5,
	Keys = {
		K(0, hang({ lean = 7, roll = -8, ll = A(0, 0, -3), rl = A(-6, 0, 4), la = A(174, 0, 12), ra = A(10, 0, 7), neck = A(-28, 0, 8) })),
		K(0.1, hang({ lean = -22, turn = 6, roll = -14, hip = V(0, 0.2, 0), ll = A(26, 0, -8), rl = A(-10, 0, 10), la = A(178, 0, 18), ra = A(110, 0, 34), neck = A(38, -10, 10) }), "SineOut"),
		K(0.2, hang({ lean = -20, turn = 2, roll = -10, hip = V(0, 0.16, 0), ll = A(6, 0, -6), rl = A(14, 0, 8), la = A(177, 0, 16), ra = A(150, 0, 30), neck = A(36, 0, 6) }), "SineInOut"),
		K(0.3, hang({ lean = -16, turn = -10, roll = -6, hip = V(0, 0.1, 0), ll = A(-12, 0, -6), rl = A(28, 0, 8), la = A(176, 0, 14), ra = A(115, 0, 45), neck = A(30, 12, -6) }), "SineInOut"),
		K(0.5, hang({ lean = -20, turn = 8, roll = -12, hip = V(0, 0.12, 0), ll = A(22, 0, -4), rl = A(-14, 0, 10), la = A(178, 0, 18), ra = A(165, 0, 22), neck = A(34, -8, 8) }), "SineInOut"),
		K(0.72, hang({ lean = -10, turn = -4, roll = -8, hip = V(0, 0.05, 0), ll = A(-6, 0, -4), rl = A(16, 0, 6), la = A(176, 0, 14), ra = A(120, 0, 35), neck = A(20, 6, 0) }), "SineInOut"),
		K(0.95, hang({ lean = 10, roll = -8, ll = A(4, 0, -3), rl = A(-2, 0, 4), la = A(174, 0, 12), ra = A(30, 0, 10), neck = A(-30, 0, 10) }), "SineInOut"),
	},
})

-- Сущность забирает (2.8 с): отчаянно отталкивает её лапы, бьётся; судорога, руки в стороны —
-- тело поднимают (сервер: с 1.6 с вверх на 30 стад).
do
	local keys = {
		K(0, hang({ lean = -4, roll = -8, hip = V(0, 0.03, 0), ll = A(10, 0, -4), rl = A(10, 0, 4), la = A(172, 0, 14), ra = A(158, 0, -6), neck = A(18, 0, 0) })),
	}
	local t, i = 0.12, 0
	while t < 1.5 do
		i += 1
		local s = i % 2 == 1 and 1 or -1
		local e = 0.7 + 0.3 * math.min(t / 0.8, 1) -- отчаяние нарастает
		local h = Life.hash(i * 1.37)
		table.insert(
			keys,
			K(
				t,
				hang({
					lean = -10 - 6 * e + s * 4,
					turn = s * 16 * e,
					roll = -10 + s * 6 * e,
					hip = V(0, 0.06 * e, 0),
					ll = A(8 + s * 28 * e, 0, -6),
					rl = A(8 - s * 28 * e, 0, 6),
					la = A(150 + s * 14, 0, -12 - s * 12),
					ra = A(140 - s * 22, 0, 22 + s * 10),
					neck = A(18 + s * 6, -s * (20 + 12 * h) * e, s * 6),
				}),
				i % 3 == 0 and "QuadOut" or "SineInOut"
			)
		)
		t += 0.12 + 0.05 * h -- неровный ритм
	end
	table.insert(keys, K(1.68, hang({ lean = -30, roll = -4, hip = V(0, 0.2, 0), ll = A(-8, 0, -4), rl = A(-4, 0, 4), la = A(165, 0, -40), ra = A(165, 0, 40), neck = A(40, 0, 0) }), "QuadOut"))
	table.insert(keys, K(2.1, hang({ lean = -20, roll = -2, hip = V(0, 0.1, 0), ll = A(-6, 0, -3), rl = A(-2, 0, 3), la = A(30, 0, -80), ra = A(30, 0, 80), neck = A(36, 0, 6) }), "SineInOut"))
	table.insert(keys, K(2.8, hang({ lean = -16, hip = V(0, 0.08, 0), ll = A(-4, 0, -2), rl = A(-2, 0, 2), la = A(24, 0, -84), ra = A(24, 0, 84), neck = A(40, 0, 8) }), "SineInOut"))
	OneShot.Entity = Clip.new({ Duration = 2.8, FadeIn = 0.08, FadeOut = 0.3, Stiffness = 1.4, Keys = keys })
end

------------------------------------------------------------------------
-- Прыжки через окно/паллету. Сервер везёт корень (Anchored) по прямой: вверх на 2.2 стада к
-- середине препятствия за половину времени и вниз за вторую половину; высота препятствия 3.
-- Ключи — в долях длительности: u = 0.5 — над подоконником.
------------------------------------------------------------------------

local function timed(duration: number, list: { { any } }): { Clip.Key }
	local keys = {}
	for _, k in list do
		table.insert(keys, K(k[1] * duration, k[2], k[3]))
	end
	return keys
end

-- С бега (0.55 с): упор руками, тело перекатывается через левую руку, ноги проносятся над
-- подоконником вбок, приземление и сразу бег.
OneShot.Vault = Clip.new({
	Duration = 0.55,
	FadeIn = 0.04,
	FadeOut = 0.12,
	Stiffness = 1.5,
	Keys = timed(0.55, {
		{ 0, body({ lean = 14, hip = V(0, -0.04, 0), ll = A(24, 0, -3), rl = A(-26, 0, 3), la = A(-22, 0, -8), ra = A(38, 0, 8), neck = A(-2, 0, 0) }) },
		-- толчок: корпус вперёд, руки тянутся к подоконнику, ноги отталкиваются
		{ 0.16, body({ lean = 32, turn = 6, roll = 4, ll = A(-34, 0, -4), rl = A(-8, 0, 5), la = A(88, 0, -10), ra = A(84, 0, 10), neck = A(22, 0, 0) }), "QuadOut" },
		-- упор левой, ноги проносятся вперёд-вправо
		{ 0.33, body({ lean = 16, turn = 18, roll = 14, hip = V(0, 0.08, 0), ll = A(66, 0, 8), rl = A(78, 0, 20), la = A(34, 0, -6), ra = A(100, 0, 60), neck = A(10, -12, -6) }), "QuadIn" },
		{ 0.5, body({ lean = 2, turn = 22, roll = 18, hip = V(0, 0.1, 0), ll = A(84, 0, 14), rl = A(90, 0, 26), la = A(4, 0, 2), ra = A(112, 0, 76), neck = A(4, -18, -10) }) },
		-- соскальзывает вниз, ноги тянутся к земле
		{ 0.68, body({ lean = 4, turn = 12, roll = 6, ll = A(46, 0, 6), rl = A(30, 0, 10), la = A(-28, 0, -26), ra = A(62, 0, 42), neck = A(0, -10, -2) }), "QuadOut" },
		-- касание земли раньше корня: таз опускается навстречу
		{ 0.85, body({ lean = 18, turn = 4, hip = V(0, -0.62, 0), ll = A(26, 0, -4), rl = A(-14, 0, 4), la = A(-8, 0, -14), ra = A(32, 0, 14), neck = A(-6, -2, 0) }), "SineInOut" },
		{ 1, body({ lean = 15, hip = V(0, -0.04, 0), ll = A(-22, 0, -3), rl = A(28, 0, 3), la = A(36, 0, -8), ra = A(-20, 0, 8), neck = A(-2, 0, 0) }), "SineInOut" },
	}),
})

-- Шагом (0.95 с): обе руки на подоконник, правое колено вверх, перекидывает ноги сидя, спрыгивает
OneShot.VaultWalk = Clip.new({
	Duration = 0.95,
	FadeIn = 0.08,
	FadeOut = 0.18,
	Stiffness = 1.2,
	Keys = timed(0.95, {
		{ 0, body({ lean = 6, ll = A(8, 0, -3), rl = A(-10, 0, 3), la = A(10, 0, -8), ra = A(14, 0, 8), neck = A(0, 0, 0) }) },
		{ 0.18, body({ lean = 30, turn = 4, ll = A(-20, 0, -4), rl = A(10, 0, 4), la = A(84, 0, -12), ra = A(84, 0, 12), neck = A(20, 0, 0) }), "SineInOut" },
		{ 0.36, body({ lean = 34, turn = 10, roll = 8, hip = V(0, 0.05, 0), ll = A(-30, 0, -6), rl = A(70, 0, 14), la = A(44, 0, 0), ra = A(48, 0, -4), neck = A(22, -4, 0) }), "SineInOut" },
		{ 0.52, body({ lean = 6, turn = 24, roll = 16, hip = V(0, 0.1, 0), ll = A(80, 0, 10), rl = A(88, 0, 26), la = A(6, 0, 4), ra = A(40, 0, 30), neck = A(6, -18, -8) }), "SineInOut" },
		{ 0.72, body({ lean = -4, turn = 14, roll = 6, ll = A(40, 0, 4), rl = A(18, 0, 8), la = A(-10, 0, -12), ra = A(30, 0, 24), neck = A(0, -10, -2) }), "SineInOut" },
		{ 0.88, body({ lean = 10, turn = 4, hip = V(0, -0.5, 0), ll = A(20, 0, -4), rl = A(-10, 0, 4), la = A(-6, 0, -12), ra = A(16, 0, 12), neck = A(-6, -2, 0) }), "SineInOut" },
		{ 1, body({ lean = 6, hip = V(0, -0.02, 0), ll = A(-8, 0, -3), rl = A(10, 0, 3), la = A(12, 0, -8), ra = A(-6, 0, 8), neck = A(0, 0, 0) }), "SineInOut" },
	}),
})

-- Маньяк (1.6 с): тяжело, сначала заносит правую ногу на подоконник, подтягивается на руках,
-- перекидывает левую, слезает и грузно встаёт.
OneShot.KillerVault = Clip.new({
	Duration = 1.6,
	FadeIn = 0.12,
	FadeOut = 0.22,
	Keys = timed(1.6, {
		{ 0, body({ lean = 6, ll = A(0, 0, -3), rl = A(0, 0, 3), la = A(6, 0, -9), ra = A(16, 0, 12), neck = A(0, 0, 0) }) },
		{ 0.14, body({ lean = 16, turn = -6, roll = -4, hip = V(0, -0.06, 0), ll = A(-6, 0, -4), rl = A(118, 0, 8), la = A(70, 0, -14), ra = A(64, 0, 16), neck = A(10, 6, 0) }), "SineInOut" },
		{ 0.32, body({ lean = 34, turn = -4, roll = -6, hip = V(0, 0.04, 0), ll = A(-28, 0, -6), rl = A(88, 0, 10), la = A(60, 0, -6), ra = A(56, 0, 8), neck = A(22, 4, 0) }), "SineInOut" },
		{ 0.5, body({ lean = 26, turn = 6, roll = 4, hip = V(0, 0.08, 0), ll = A(70, 0, -14), rl = A(30, 0, 10), la = A(28, 0, -4), ra = A(30, 0, 6), neck = A(18, -4, 0) }), "SineInOut" },
		{ 0.7, body({ lean = 14, turn = 4, roll = 2, ll = A(46, 0, -8), rl = A(8, 0, 6), la = A(36, 0, -16), ra = A(44, 0, 18), neck = A(6, -2, 0) }), "SineInOut" },
		{ 0.86, body({ lean = 12, hip = V(0, -0.5, 0), ll = A(24, 0, -6), rl = A(-14, 0, 5), la = A(14, 0, -12), ra = A(22, 0, 14), neck = A(-4, 0, 0) }), "SineInOut" },
		{ 1, body({ lean = 7, ll = A(2, 0, -3), rl = A(-2, 0, 3), la = A(6, 0, -9), ra = A(16, 0, 12), neck = A(0, 0, 0) }), "SineInOut" },
	}),
})

return Clips
]]></string>
