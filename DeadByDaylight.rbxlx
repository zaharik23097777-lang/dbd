      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Создаёт (на сервере) или находит (на клиенте) все RemoteEvent'ы игры.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local NAMES = {
	"Attack", -- клиент -> сервер: маньяк бьёт
	"Sprint", -- клиент -> сервер: бег (true/false)
	"BeginAction", -- клиент -> сервер: начать действие (kind, target)
	"EndAction", -- клиент -> сервер: отпустить кнопку
	"SkillCheck", -- сервер -> клиент: показать проверку; клиент -> сервер: результат
	"Notify", -- сервер -> клиент: сообщение на экране
	"Noise", -- сервер -> маньяку: подсветить место шума (взрыв генератора)
	"Results", -- сервер -> клиенту: итоги раунда
	"Crouch", -- клиент -> сервер: присесть (true/false)
	"UsePower", -- клиент -> сервер: способность маньяка (нажата?, направление)
	"UseItem", -- клиент -> сервер: предмет выжившего (нажата?, направление)
	"Sfx", -- сервер -> клиенту: проиграть звук (имя, где)
	"Score", -- сервер -> клиенту: +очки крови
	"LobbyChoice", -- клиент -> сервер: выбор в лобби
	"Projectile", -- сервер -> клиенту: полёт топора (id, старт, скорость, гравитация)
	"ProjectileEnd", -- сервер -> клиенту: топор остановился (id, позиция)
	"Effect", -- сервер -> клиенту: экранный эффект (ослепление, тряска, интро)
}

local Remotes = {}

local folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in NAMES do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

local isServer = RunService:IsServer()
for _, name in NAMES do
	Remotes[name] = if isServer then folder:FindFirstChild(name) else folder:WaitForChild(name)
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Sounds</string>
          <string name="Source"><![CDATA[-- Библиотека звуков.
-- По умолчанию используются звуки, встроенные в клиент Roblox (rbxasset://sounds/...),
-- их гарантированно слышно в любой игре. Изменяя высоту тона и эффекты, из них собраны
-- все звуки игры. Любой звук можно заменить своим ID через Config.SoundOverrides.
local Config = require(script.Parent.Config)

local F = "rbxasset://sounds/"
local STEP = F .. "action_footsteps_plastic.mp3"
local LAND = F .. "action_jump_land.mp3"
local JUMP = F .. "action_jump.mp3"
local FALL = F .. "action_falling.ogg"
local SWIM = F .. "action_swim.mp3"
local SPLASH = F .. "impact_water.mp3"
local GETUP = F .. "action_get_up.mp3"
local OOF = F .. "uuhhh.mp3"

-- Effects: Distortion (0..1), Echo {Delay, Feedback}, LowPass (true = глушим верха), Reverb
local Sounds = {}

Sounds.Defs = {
	Footstep = { Id = STEP, Volume = 0.35, Speed = 1, MaxDistance = 70 },
	KillerFootstep = { Id = STEP, Volume = 0.7, Speed = 0.65, MaxDistance = 90, Effects = { LowPass = true } },
	HeartThump = { Id = LAND, Volume = 1, Speed = 0.32, Effects = { LowPass = true } },
	Wind = { Id = FALL, Volume = 0.18, Speed = 0.3, Looped = true, Effects = { LowPass = true } },
	Whoosh = { Id = FALL, Volume = 0.8, Speed = 2.6, Duration = 0.3, MaxDistance = 60 },
	Swing = { Id = FALL, Volume = 0.9, Speed = 3.2, Duration = 0.25, MaxDistance = 60 },
	Hit = { Id = LAND, Volume = 1, Speed = 0.8, MaxDistance = 80, Effects = { Distortion = 0.6 } },
	Pain = { Id = OOF, Volume = 1, Speed = 1.15, MaxDistance = 120 },
	Scream = { Id = OOF, Volume = 1, Speed = 0.8, MaxDistance = 250, Effects = { Echo = { 0.12, 0.35 } } },
	Thud = { Id = LAND, Volume = 1, Speed = 0.55, MaxDistance = 90 },
	PalletSlam = { Id = LAND, Volume = 1, Speed = 0.45, MaxDistance = 140, Effects = { Distortion = 0.4 } },
	PalletBreak = { Id = SPLASH, Volume = 1, Speed = 1.6, MaxDistance = 140, Effects = { Distortion = 0.7 } },
	Vault = { Id = JUMP, Volume = 0.8, Speed = 0.9, MaxDistance = 80 },
	Rustle = { Id = GETUP, Volume = 0.8, Speed = 1, MaxDistance = 50 },
	LockerDoor = { Id = LAND, Volume = 0.9, Speed = 1.7, MaxDistance = 80, Effects = { Echo = { 0.05, 0.3 } } },
	GenLoop = { Id = SWIM, Volume = 0.3, Speed = 0.35, Looped = true, MaxDistance = 60, Effects = { Distortion = 0.5, LowPass = true } },
	GenExplode = { Id = SPLASH, Volume = 1, Speed = 0.45, MaxDistance = 300, Effects = { Distortion = 0.9 } },
	GenDone = { Id = LAND, Volume = 1, Speed = 0.3, Effects = { Echo = { 0.35, 0.5 }, Distortion = 0.3 } },
	Clank = { Id = LAND, Volume = 1, Speed = 2.2, MaxDistance = 100, Effects = { Echo = { 0.06, 0.4 } } },
	TrapSnap = { Id = LAND, Volume = 1, Speed = 2.8, MaxDistance = 160, Effects = { Distortion = 0.8 } },
	SkillWarn = { Id = LAND, Volume = 0.8, Speed = 3.5, Effects = { Echo = { 0.08, 0.2 } } },
	SkillGood = { Id = STEP, Volume = 0.8, Speed = 2 },
	Bell = { Id = LAND, Volume = 1, Speed = 3, MaxDistance = 200, Effects = { Echo = { 0.25, 0.6 } } },
	GatePowered = { Id = FALL, Volume = 0.8, Speed = 0.6, Duration = 2.5, Effects = { Distortion = 0.6, Echo = { 0.3, 0.5 } } },
	GateOpen = { Id = SWIM, Volume = 1, Speed = 0.25, Duration = 2.5, MaxDistance = 300, Effects = { Distortion = 0.7 } },
	EntityDrone = { Id = FALL, Volume = 1, Speed = 0.15, Duration = 3, Effects = { Distortion = 0.8, Echo = { 0.4, 0.6 } } },
	HatchWind = { Id = FALL, Volume = 0.5, Speed = 0.5, Looped = true, MaxDistance = 40, Effects = { Echo = { 0.2, 0.4 } } },
	Crow = { Id = OOF, Volume = 0.8, Speed = 2.8, MaxDistance = 150, Effects = { Distortion = 0.9 } },
	Flutter = { Id = FALL, Volume = 0.7, Speed = 4, Duration = 0.6, MaxDistance = 80 },
	Click = { Id = STEP, Volume = 0.6, Speed = 3, MaxDistance = 40 },
	Throw = { Id = FALL, Volume = 1, Speed = 2, Duration = 0.4, MaxDistance = 120 },
	Hum = { Id = JUMP, Volume = 0.6, Speed = 0.5, MaxDistance = 40, Effects = { Echo = { 0.3, 0.5 } } },
	Chest = { Id = GETUP, Volume = 0.9, Speed = 0.7, MaxDistance = 60 },
	Notify = { Id = STEP, Volume = 0.5, Speed = 1.5 },
	ChaseDrone = { Id = FALL, Volume = 0.45, Speed = 0.22, Looped = true, Effects = { Distortion = 0.5, LowPass = true } },

	-- Слоты без звука по умолчанию: вставь свой ID в Config.SoundOverrides
	ChaseMusic = { Id = "", Volume = 0.6, Looped = true },
	Lullaby = { Id = "", Volume = 0.6, Looped = true },
	AmbientMusic = { Id = "", Volume = 0.25, Looped = true },
	Heartbeat = { Id = "", Volume = 1, Looped = true },
}

-- Возвращает определение звука с учётом переопределения из Config
function Sounds.get(name: string)
	local def = Sounds.Defs[name]
	if not def then
		return nil
	end
	local override = Config.SoundOverrides[name]
	if override and override ~= "" then
		return {
			Id = override,
			Volume = def.Volume,
			Speed = 1,
			Looped = def.Looped,
			MaxDistance = def.MaxDistance,
			Custom = true,
		}
	end
	if def.Id == "" then
		return nil
	end
	return def
end

return Sounds
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[-- Общие функции для сервера и клиента.
local Util = {}

function Util.getRoot(player: Player?): BasePart?
	local char = player and player.Character
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Util.getHumanoid(player: Player?): Humanoid?
	local char = player and player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

function Util.flatDist(a: Vector3, b: Vector3): number
	local d = a - b
	return Vector3.new(d.X, 0, d.Z).Magnitude
end

-- Позиция объекта взаимодействия (одинаково считается на сервере и клиенте)
function Util.objectPosition(obj: Instance?): Vector3?
	if typeof(obj) ~= "Instance" or not obj.Parent then
		return nil
	end
	if obj:IsA("Player") then
		local root = Util.getRoot(obj)
		return root and root.Position
	end
	local kind = obj:GetAttribute("Kind")
	if kind == "Pallet" then
		local cf = obj:GetAttribute("DropCFrame")
		return cf and (cf :: CFrame).Position
	elseif kind == "Hook" then
		local hp = obj:FindFirstChild("HangPoint") :: BasePart?
		return hp and hp.Position
	elseif kind == "ExitGate" then
		local sw = obj:FindFirstChild("Switch") :: BasePart?
		return sw and sw.Position
	elseif kind == "Locker" then
		local inside = obj:FindFirstChild("Inside") :: BasePart?
		return inside and inside.Position
	end
	if obj:IsA("Model") then
		return obj:GetPivot().Position
	elseif obj:IsA("BasePart") then
		return obj.Position
	end
	return nil
end

function Util.isInGameStatus(status: string?): boolean
	return status == "Playing" or status == "Carried" or status == "Hooked"
end

function Util.weld(part0: BasePart, part1: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = part0
	w.Part1 = part1
	w.Parent = part1
	return w
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">Core</string>
        </Properties>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Actions</string>
            <string name="Source"><![CDATA[-- Реестр действий (ремонт, лечение, крюк, шкафчики и т.д.).
-- Системы регистрируют действие: Validate, Begin, Tick, Complete, Progress, OnSkillCheck.
-- Здесь — общий цикл: проверка дистанции, длительность, проверки навыка, атрибуты для UI.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local ActionInfo = require(ReplicatedStorage.Shared.ActionInfo)
local State = require(script.Parent.State)

local Actions = {}

export type ActionDef = {
	Validate: (data: any, target: Instance) -> boolean,
	Begin: ((data: any, target: Instance) -> ())?,
	Tick: ((data: any, target: Instance, dt: number) -> ())?,
	Complete: ((data: any, target: Instance) -> ())?,
	Progress: ((data: any, target: Instance) -> number?)?,
	OnSkillCheck: ((data: any, target: Instance, result: string) -> ())?,
	OnCancel: ((data: any, target: Instance) -> ())?,
	SkillChecks: boolean?,
	AllowHidden: boolean?,
	AllowTrapped: boolean?,
	AllowCarrying: boolean?,
	AllowDowned: boolean?,
}

Actions.Defs = {} :: { [string]: ActionDef }

function Actions.register(kind: string, def: ActionDef)
	assert(ActionInfo[kind], "нет ActionInfo для " .. kind)
	Actions.Defs[kind] = def
end

function Actions.cancel(data)
	local a = data.Action
	data.Action = nil
	data.PendingCheck = nil
	data.Player:SetAttribute("ActionName", nil)
	data.Player:SetAttribute("ActionProgress", nil)
	if a then
		local def = Actions.Defs[a.Kind]
		if def and def.OnCancel then
			def.OnCancel(data, a.Target)
		end
	end
end

-- Общие условия: может ли игрок вообще что-то делать
function Actions.canAct(data, def: ActionDef?): boolean
	if data.Status ~= "Playing" then
		return false
	end
	local t = State.now()
	if t < data.VaultUntil then
		return false
	end
	if data.Hidden and not (def and def.AllowHidden) then
		return false
	end
	if data.Role == "Survivor" then
		if data.Trapped and not (def and def.AllowTrapped) then
			return false
		end
		return data.Health > 0 or (def ~= nil and def.AllowDowned == true)
	end
	if data.Carrying and not (def and def.AllowCarrying) then
		return false
	end
	return t >= data.StunnedUntil and t >= data.BlindUntil and not data.Lunging and not data.PowerBusy
end

local function inRange(data, kind: string, target: Instance, extra: number): boolean
	local info = ActionInfo[kind]
	if info.Range >= 1000 then
		return true
	end
	local root = Util.getRoot(data.Player)
	local pos = Util.objectPosition(target)
	return root ~= nil and pos ~= nil and Util.flatDist(root.Position, pos) <= info.Range + extra
end

local function roleAllowed(data, kind: string): boolean
	local info = ActionInfo[kind]
	return info.Role == "Any" or info.Role == data.Role
end

-- Начать действие (с клиента или из другой системы)
function Actions.start(data, kind: string, target: Instance): boolean
	local def = Actions.Defs[kind]
	local info = ActionInfo[kind]
	if not def or not info or not State.Active then
		return false
	end
	if data.Action or not roleAllowed(data, kind) or not Actions.canAct(data, def) then
		return false
	end
	if not inRange(data, kind, target, 1) or not def.Validate(data, target) then
		return false
	end
	if info.Instant then
		if def.Begin then
			def.Begin(data, target)
		end
		return true
	end
	data.Action = { Kind = kind, Target = target, Time = 0 }
	data.NextCheckRoll = State.now() + 1
	if def.Begin then
		def.Begin(data, target)
	end
	return true
end

------------------------------------------------------------------------
-- Проверки навыка
------------------------------------------------------------------------

local skillCheckCounter = 0
local rng = Random.new()

local function applySkillCheck(data, result: string)
	data.PendingCheck = nil
	local a = data.Action
	if not a then
		return
	end
	local def = Actions.Defs[a.Kind]
	if def and def.OnSkillCheck then
		def.OnSkillCheck(data, a.Target, result)
	end
end

local function tickSkillChecks(data, t: number)
	if data.PendingCheck then
		if t > data.PendingCheck.Deadline then
			applySkillCheck(data, "fail")
		end
		return
	end
	if t < data.NextCheckRoll then
		return
	end
	data.NextCheckRoll = t + 1
	local chance = Config.SkillCheckChancePerSecond
	if State.HexRuin then
		chance *= 1.3
	end
	if rng:NextNumber() < chance then
		skillCheckCounter += 1
		local zone = rng:NextNumber(0.45, 0.8)
		data.PendingCheck = { Id = skillCheckCounter, Deadline = t + Config.SkillCheckDuration + 2 }
		Remotes.SkillCheck:FireClient(data.Player, skillCheckCounter, zone)
	end
end

------------------------------------------------------------------------
-- Цикл
------------------------------------------------------------------------

function Actions.update(dt: number)
	local t = State.now()
	for _, data in State.Participants do
		local a = data.Action
		if not a then
			if data.PendingCheck then
				data.PendingCheck = nil
			end
			continue
		end
		local def = Actions.Defs[a.Kind]
		local info = ActionInfo[a.Kind]
		if not (Actions.canAct(data, def) and inRange(data, a.Kind, a.Target, 2) and def.Validate(data, a.Target)) then
			Actions.cancel(data)
			continue
		end
		a.Time += dt
		if def.Tick then
			def.Tick(data, a.Target, dt)
		end
		if data.Action ~= a then
			continue
		end
		local progress
		if info.Duration then
			progress = a.Time / info.Duration
			if progress >= 1 then
				Actions.cancel(data)
				if def.Complete then
					def.Complete(data, a.Target)
				end
				continue
			end
		elseif def.Progress then
			progress = def.Progress(data, a.Target)
		end
		data.Player:SetAttribute("ActionName", a.Kind)
		data.Player:SetAttribute("ActionProgress", progress)
		if def.SkillChecks then
			tickSkillChecks(data, t)
		end
	end
end

Remotes.BeginAction.OnServerEvent:Connect(function(player, kind, target)
	local data = State.get(player)
	if data and typeof(kind) == "string" and typeof(target) == "Instance" then
		Actions.start(data, kind, target)
	end
end)

Remotes.EndAction.OnServerEvent:Connect(function(player)
	local data = State.get(player)
	if data and data.Action then
		local info = ActionInfo[data.Action.Kind]
		-- Предмет и способность отпускаются своими кнопками
		if info and info.Key ~= "Item" and info.Key ~= "Power" then
			Actions.cancel(data)
		end
	end
end)

Remotes.SkillCheck.OnServerEvent:Connect(function(player, id, result)
	local data = State.get(player)
	if not data or not data.PendingCheck or data.PendingCheck.Id ~= id then
		return
	end
	if result ~= "great" and result ~= "good" then
		result = "fail"
	end
	applySkillCheck(data, result)
end)

return Actions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Characters</string>
            <string name="Source"><![CDATA[-- Персонажи R6: появление, внешний вид маньяков, группы столкновений.
-- Персонажи создаются вручную (CharacterAutoLoads = false), чтобы гарантировать R6
-- и полностью управлять анимациями (стандартный Animate удаляется).
local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)
local Util = require(ReplicatedStorage.Shared.Util)
local MapBuilder = require(script.Parent.Parent.Map.MapBuilder)

local Characters = {}

Characters.GROUP_ROOT = "DBDChars"
Characters.GROUP_LIMBS = "DBDLimbs"
Characters.GROUP_CARRIED = "DBDCarried"
Characters.GROUP_SEATS = "DBDSeats"

local function setupGroups()
	for _, g in { Characters.GROUP_ROOT, Characters.GROUP_LIMBS, Characters.GROUP_CARRIED, Characters.GROUP_SEATS } do
		PhysicsService:RegisterCollisionGroup(g)
	end
	-- Конечности не сталкиваются ни с чем: позы (ползание, крюк, перелезание) двигают их свободно.
	-- Сталкивается только HumanoidRootPart.
	for _, other in { "Default", Characters.GROUP_ROOT, Characters.GROUP_LIMBS, Characters.GROUP_CARRIED } do
		PhysicsService:CollisionGroupSetCollidable(Characters.GROUP_LIMBS, other, false)
		PhysicsService:CollisionGroupSetCollidable(Characters.GROUP_CARRIED, other, false)
	end
	-- Брёвна-сиденья в лобби «касаются» ног (у ног CanCollide = false, так что они не толкаются),
	-- иначе Seat не сработает: HumanoidRootPart висит выше бревна.
	PhysicsService:CollisionGroupSetCollidable(Characters.GROUP_SEATS, Characters.GROUP_LIMBS, true)
end
setupGroups()

-- Вызывается при смерти персонажа (Match подставляет свой обработчик)
Characters.OnDied = nil :: ((Player, Model) -> boolean)?

local descriptionCache = {}

local SKIN = {
	Color3.fromRGB(234, 184, 146),
	Color3.fromRGB(204, 142, 105),
	Color3.fromRGB(160, 110, 80),
	Color3.fromRGB(105, 70, 50),
}
local CLOTH = {
	Color3.fromRGB(60, 80, 110),
	Color3.fromRGB(110, 50, 45),
	Color3.fromRGB(70, 90, 60),
	Color3.fromRGB(120, 110, 90),
	Color3.fromRGB(50, 50, 55),
}

local function randomDescription(): HumanoidDescription
	local d = Instance.new("HumanoidDescription")
	local skin = SKIN[math.random(#SKIN)]
	local shirt = CLOTH[math.random(#CLOTH)]
	local pants = CLOTH[math.random(#CLOTH)]:Lerp(Color3.new(0, 0, 0), 0.3)
	d.HeadColor = skin
	d.LeftArmColor = skin
	d.RightArmColor = skin
	d.TorsoColor = shirt
	d.LeftLegColor = pants
	d.RightLegColor = pants
	return d
end

function Characters.getDescription(player: Player): HumanoidDescription
	local cached = descriptionCache[player]
	if cached then
		return cached:Clone()
	end
	local desc
	if player.UserId > 0 then
		local ok, result = pcall(function()
			return Players:GetHumanoidDescriptionFromUserId(player.UserId)
		end)
		if ok then
			desc = result
		end
	end
	desc = desc or randomDescription()
	descriptionCache[player] = desc
	return desc:Clone()
end

------------------------------------------------------------------------
-- Снаряжение маньяков (из деталей, приваривается к телу)
------------------------------------------------------------------------

local function gear(char: Model, attachTo: string, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part?
	local base = char:FindFirstChild(attachTo) :: BasePart?
	if not base then
		return nil
	end
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CFrame = base.CFrame * offset
	Util.weld(base, p)
	p.Parent = char
	return p
end

local A = function(x, y, z)
	return CFrame.Angles(math.rad(x or 0), math.rad(y or 0), math.rad(z or 0))
end

local GEAR = {}

function GEAR.Trapper(char: Model)
	local bone = Color3.fromRGB(225, 215, 195)
	gear(char, "Head", "Mask", Vector3.new(1.25, 1.25, 0.3), CFrame.new(0, 0, -0.6), bone)
	gear(char, "Head", "MaskMouth", Vector3.new(0.9, 0.3, 0.1), CFrame.new(0, -0.3, -0.78), Color3.fromRGB(40, 10, 10))
	for i = -3, 3 do
		gear(char, "Head", "Tooth", Vector3.new(0.1, 0.18, 0.08), CFrame.new(i * 0.12, -0.25, -0.83), bone)
	end
	for _, x in { -0.25, 0.25 } do
		gear(char, "Head", "Eye", Vector3.new(0.22, 0.12, 0.08), CFrame.new(x, 0.15, -0.78), Color3.fromRGB(10, 10, 10))
	end
	gear(char, "Torso", "Apron", Vector3.new(1.9, 2.4, 0.2), CFrame.new(0, -0.4, -0.55), Color3.fromRGB(80, 60, 45), Enum.Material.Fabric)
	gear(char, "Torso", "Belt", Vector3.new(2.1, 0.3, 1.1), CFrame.new(0, -0.9, 0), Color3.fromRGB(40, 30, 25), Enum.Material.Fabric)
	gear(char, "Torso", "BackTrap", Vector3.new(0.2, 1.4, 1.4), CFrame.new(0, 0.2, 0.62) * A(0, 90, 0), Color3.fromRGB(110, 105, 100), Enum.Material.Metal, Enum.PartType.Cylinder)
	-- Тесак
	gear(char, "Right Arm", "Handle", Vector3.new(0.25, 1.2, 0.25), CFrame.new(0, -1.2, -0.4) * A(90, 0, 0), Color3.fromRGB(60, 40, 25), Enum.Material.Wood)
	gear(char, "Right Arm", "Blade", Vector3.new(0.12, 1, 2.2), CFrame.new(0, -1.5, -1.9), Color3.fromRGB(160, 150, 145), Enum.Material.Metal)
	gear(char, "Right Arm", "BladeBlood", Vector3.new(0.13, 0.5, 1.2), CFrame.new(0, -1.75, -2.2), Color3.fromRGB(90, 10, 10), Enum.Material.SmoothPlastic)
end

function GEAR.Huntress(char: Model)
	local white = Color3.fromRGB(235, 230, 220)
	gear(char, "Head", "Mask", Vector3.new(1.3, 1.3, 0.4), CFrame.new(0, 0, -0.55), white)
	for _, x in { -0.3, 0.3 } do
		gear(char, "Head", "Ear", Vector3.new(0.3, 1.6, 0.15), CFrame.new(x, 1.25, -0.2) * A(-10, 0, x * 25), white)
		gear(char, "Head", "Eye", Vector3.new(0.18, 0.18, 0.08), CFrame.new(x * 0.8, 0.12, -0.78), Color3.fromRGB(10, 10, 10))
	end
	gear(char, "Head", "Hood", Vector3.new(1.5, 1.4, 1.2), CFrame.new(0, 0.1, 0.25), Color3.fromRGB(90, 60, 40), Enum.Material.Fabric)
	gear(char, "Torso", "Fur", Vector3.new(2.6, 0.7, 1.4), CFrame.new(0, 0.85, 0), Color3.fromRGB(110, 85, 60), Enum.Material.Fabric)
	gear(char, "Torso", "Cloak", Vector3.new(2.2, 2.6, 0.2), CFrame.new(0, -0.3, 0.6), Color3.fromRGB(80, 55, 35), Enum.Material.Fabric)
	-- Топор
	gear(char, "Right Arm", "Handle", Vector3.new(0.22, 0.22, 2.6), CFrame.new(0, -1.15, -1.1), Color3.fromRGB(70, 50, 30), Enum.Material.Wood)
	gear(char, "Right Arm", "AxeHead", Vector3.new(0.12, 1.1, 0.8), CFrame.new(0, -0.75, -2.2), Color3.fromRGB(150, 145, 140), Enum.Material.Metal)
end

function GEAR.Wraith(char: Model)
	local wrap = Color3.fromRGB(150, 140, 120)
	for _, partName in { "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg" } do
		local part = char:FindFirstChild(partName) :: BasePart?
		if part then
			local w = part.Size.X + 0.06
			for i = -2, 2 do
				gear(char, partName, "Bandage", Vector3.new(w, 0.18, part.Size.Z + 0.06), CFrame.new(0, i * 0.4, 0) * A(0, 0, (i % 2) * 8 - 4), wrap, Enum.Material.Fabric)
			end
		end
	end
	gear(char, "Head", "Wraps", Vector3.new(1.3, 1.25, 1.1), CFrame.new(0, 0, 0), wrap, Enum.Material.Fabric)
	for _, x in { -0.25, 0.25 } do
		gear(char, "Head", "Eye", Vector3.new(0.2, 0.1, 0.06), CFrame.new(x, 0.12, -0.56), Color3.fromRGB(255, 240, 200), Enum.Material.Neon)
	end
	gear(char, "Torso", "Rags", Vector3.new(2.1, 1.6, 1.1), CFrame.new(0, -1.3, 0), Color3.fromRGB(60, 55, 50), Enum.Material.Fabric)
	-- Дубина с черепом
	gear(char, "Right Arm", "Club", Vector3.new(0.25, 0.25, 2.4), CFrame.new(0, -1.15, -1.1), Color3.fromRGB(80, 70, 60), Enum.Material.Wood)
	gear(char, "Right Arm", "Skull", Vector3.new(0.75, 0.75, 0.75), CFrame.new(0, -1.15, -2.4), Color3.fromRGB(220, 210, 190), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	-- Колокол
	gear(char, "Left Arm", "Bell", Vector3.new(0.8, 0.9, 0.9), CFrame.new(0, -1.5, -0.2) * A(0, 0, 90), Color3.fromRGB(150, 120, 60), Enum.Material.Metal, Enum.PartType.Cylinder)
end

local function dressKiller(char: Model, def)
	for _, d in char:GetDescendants() do
		if d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") or d:IsA("Accessory") then
			d:Destroy()
		end
	end
	local head = char:FindFirstChild("Head")
	if head then
		for _, d in head:GetChildren() do
			if d:IsA("Decal") then
				d:Destroy()
			end
		end
	end
	for _, partName in { "Torso", "Left Leg", "Right Leg" } do
		local p = char:FindFirstChild(partName) :: BasePart?
		if p then
			p.Color = def.ClothColor
		end
	end
	for _, partName in { "Head", "Left Arm", "Right Arm" } do
		local p = char:FindFirstChild(partName) :: BasePart?
		if p then
			p.Color = def.BodyColor
		end
	end
	local builder = GEAR[def.Id]
	if builder then
		builder(char)
	end
	-- Красное пятно перед маньяком (видят выжившие)
	if head then
		local stain = Instance.new("SpotLight")
		stain.Name = "RedStain"
		stain.Color = Color3.fromRGB(255, 20, 20)
		stain.Range = 24
		stain.Angle = 35
		stain.Brightness = 4
		stain.Face = Enum.NormalId.Front
		stain.Parent = head
	end
end

------------------------------------------------------------------------
-- Создание и появление
------------------------------------------------------------------------

local function stripDefaults(char: Model)
	for _, d in char:GetDescendants() do
		if d:IsA("Animator") or ((d:IsA("LocalScript") or d:IsA("Script")) and d.Name == "Animate") then
			d:Destroy()
		end
	end
end

function Characters.setCollision(char: Model, group: string?)
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") then
			if group then
				d.CollisionGroup = group
			elseif d.Name == "HumanoidRootPart" then
				d.CollisionGroup = Characters.GROUP_ROOT
				d.CanCollide = true
			else
				d.CollisionGroup = Characters.GROUP_LIMBS
			end
		end
	end
end

function Characters.build(player: Player, role: string?, killerType: string?): Model
	local desc
	local def
	if role == "Killer" then
		def = KillerDefs.get(killerType)
		desc = Instance.new("HumanoidDescription")
	else
		desc = Characters.getDescription(player)
	end
	local ok, char = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R6)
	end)
	if not ok or not char then
		warn("[DBD] Не удалось создать персонажа из описания: " .. tostring(char))
		char = Players:CreateHumanoidModelFromDescription(randomDescription(), Enum.HumanoidRigType.R6)
	end
	char.Name = player.Name
	stripDefaults(char)
	if def then
		dressKiller(char, def)
		if def.Scale ~= 1 then
			pcall(function()
				char:ScaleTo(def.Scale)
			end)
		end
	end
	Characters.setCollision(char)
	char:SetAttribute("Role", role)
	char:SetAttribute("KillerType", def and def.Id or nil)
	char:SetAttribute("AnimSeq", 0)
	CollectionService:AddTag(char, "DBDChar")
	return char
end

function Characters.spawn(player: Player, cframe: CFrame, role: string?, killerType: string?): Model?
	if not player.Parent then
		return nil
	end
	local old = player.Character
	local char = Characters.build(player, role, killerType)
	if not player.Parent then
		char:Destroy()
		return nil
	end
	if old then
		old:Destroy()
	end
	char:PivotTo(cframe)
	char.Parent = workspace
	player.Character = char

	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.BreakJointsOnDeath = false
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		hum.UseJumpPower = true
		if role then
			hum.JumpPower = 0
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		else
			hum.JumpPower = 40
			hum.WalkSpeed = 14
		end
		hum.Died:Connect(function()
			local handled = Characters.OnDied and Characters.OnDied(player, char)
			if not handled then
				task.wait(3)
				if player.Parent and player.Character == char then
					Characters.spawnLobby(player)
				end
			end
		end)
	end
	return char
end

function Characters.spawnLobby(player: Player): Model?
	return Characters.spawn(player, MapBuilder.LobbySpawn(), nil, nil)
end

Players.PlayerRemoving:Connect(function(player)
	descriptionCache[player] = nil
end)

return Characters
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Lifecycle</string>
            <string name="Source"><![CDATA[-- Выбывание из раунда (смерть, побег, выход) и «отцепление» от объектов
-- (крюк, шкафчик, капкан, руки маньяка). Системы регистрируют свои обработчики,
-- чтобы не было циклических require.
local State = require(script.Parent.State)
local Actions = require(script.Parent.Actions)
local Characters = require(script.Parent.Characters)

local Lifecycle = {}

local detachers = {} :: { (data: any) -> () }

-- fn(data) должна освободить игрока от своего объекта, если он к нему привязан
function Lifecycle.addDetach(fn: (data: any) -> ())
	table.insert(detachers, fn)
end

function Lifecycle.detach(data)
	for _, fn in detachers do
		fn(data)
	end
end

-- Убрать выжившего из игры. status = "Dead" / "Escaped" / "Left"
function Lifecycle.remove(data, status: string, text: string?, color: Color3?)
	if not State.isInGame(data) then
		return
	end
	Lifecycle.detach(data)
	Actions.cancel(data)
	data.Status = status
	data.Player:SetAttribute("Status", status)
	if text then
		State.notifyAll(text, color)
	end
	local player = data.Player
	if status ~= "Left" then
		task.delay(status == "Dead" and 1.8 or 0.3, function()
			if player.Parent and State.Participants[player] == data then
				Characters.spawnLobby(player)
			end
		end)
	end
end

return Lifecycle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Lobby</string>
            <string name="Source"><![CDATA[-- Выбор в лобби: «хочу быть маньяком» и выбор маньяка.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)

local Lobby = {}

local function init(player: Player)
	player:SetAttribute("WantKiller", false)
	player:SetAttribute("KillerChoice", "Trapper")
end

Players.PlayerAdded:Connect(init)
for _, p in Players:GetPlayers() do
	init(p)
end

Remotes.LobbyChoice.OnServerEvent:Connect(function(player, key, value)
	if key == "WantKiller" and typeof(value) == "boolean" then
		player:SetAttribute("WantKiller", value)
	elseif key == "Killer" and typeof(value) == "string" and KillerDefs[value] and table.find(KillerDefs.Order, value) then
		player:SetAttribute("KillerChoice", value)
	end
end)

-- Выбирает маньяка: сначала среди желающих, иначе среди всех
function Lobby.pickKiller(list: { Player }): (Player?, string)
	if #list <= 1 then
		return nil, "Trapper"
	end
	local wanting = {}
	for _, p in list do
		if p:GetAttribute("WantKiller") then
			table.insert(wanting, p)
		end
	end
	local pool = #wanting > 0 and wanting or list
	local killer = pool[math.random(1, #pool)]
	return killer, killer:GetAttribute("KillerChoice") or "Trapper"
end

return Lobby
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Match</string>
            <string name="Source"><![CDATA[-- Один раунд: старт, главный цикл, конец.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)
local Server = script.Parent.Parent
local State = require(script.Parent.State)
local Actions = require(script.Parent.Actions)
local Lifecycle = require(script.Parent.Lifecycle)
local Scoring = require(script.Parent.Scoring)
local Characters = require(script.Parent.Characters)
local MapBuilder = require(Server.Map.MapBuilder)
local Powers = require(Server.Powers)
local Systems = Server.Systems
local Health = require(Systems.Health)
local Carry = require(Systems.Carry)
local Combat = require(Systems.Combat)
local Generators = require(Systems.Generators)
local Exits = require(Systems.Exits)
require(Systems.Obstacles)
require(Systems.Lockers)
local Totems = require(Systems.Totems)
local Items = require(Systems.Items)
local Crows = require(Systems.Crows)
local Chase = require(Systems.Chase)

local Match = {}

local PLAYER_ATTRS = {
	"Role",
	"KillerType",
	"Status",
	"Health",
	"HookCount",
	"HookProgress",
	"BleedOut",
	"Wiggle",
	"ActionName",
	"ActionProgress",
	"Stunned",
	"Blinded",
	"Carrying",
	"Running",
	"Crouching",
	"Hidden",
	"Trapped",
	"Chase",
	"Item",
	"ItemCharges",
	"ItemMax",
	"ItemActive",
	"PowerCount",
	"PowerCharge",
	"PowerState",
	"Cloaked",
	"TerrorRadius",
}

local function newData(player: Player, role: string, killerType: string?)
	local def = killerType and KillerDefs.get(killerType)
	return {
		Player = player,
		Role = role,
		KillerType = killerType,
		Scale = def and def.Scale or 1,
		Health = 2,
		Status = "Playing",
		HookCount = 0,
		HookTimer = 0,
		BleedOut = 0,
		Wiggle = 0,
		HealProgress = 0,
		Sprinting = false,
		Crouching = false,
		BoostUntil = 0,
		StunnedUntil = 0,
		BlindUntil = 0,
		AttackReadyAt = 0,
		LungeUntil = 0,
		Lunging = false,
		SlowUntil = 0,
		VaultUntil = 0,
		NextCheckRoll = 0,
		Score = {},
	}
end

function Match.isActive(): boolean
	return State.Active
end

function Match.Start(playerList: { Player }, killerPlayer: Player?, killerType: string)
	table.clear(State.Participants)
	State.Killer = nil
	State.GensDone = 0
	State.GatesPowered = false
	State.EndgameDeadline = nil
	State.StartTime = State.now()
	State.SoloTest = killerPlayer == nil
	State.HexRuin = false
	Generators.reset()
	State.Map = MapBuilder.BuildMap()

	for _, player in playerList do
		local isKiller = player == killerPlayer
		local data = newData(player, isKiller and "Killer" or "Survivor", isKiller and killerType or nil)
		State.Participants[player] = data
		if isKiller then
			State.Killer = data
		end
	end

	State.InitialSurvivors = #State.survivors()
	local def = KillerDefs.get(killerType)
	State.setGame("GensLeft", Config.GeneratorsRequired)
	State.setGame("EndGame", false)
	State.setGame("EndGameTimer", Config.EndGameCollapseTime)
	State.setGame("KillerName", State.Killer and State.Killer.Player.DisplayName or "—")
	State.setGame("KillerType", State.Killer and def.Id or nil)

	-- Появление персонажей
	local map = State.Map
	local sIndex = 0
	for player, data in State.Participants do
		player:SetAttribute("Role", data.Role)
		player:SetAttribute("KillerType", data.KillerType)
		player:SetAttribute("Status", data.Status)
		player:SetAttribute("Health", data.Health)
		local cf
		if data.Role == "Killer" then
			cf = CFrame.lookAt(map.KillerSpawn, map.SurvivorSpawn * Vector3.new(1, 0, 1) + Vector3.new(0, map.KillerSpawn.Y, 0))
		else
			sIndex += 1
			local angle = sIndex * math.pi / 2
			local pos = map.SurvivorSpawn + Vector3.new(math.cos(angle) * 4, 0, math.sin(angle) * 4)
			cf = CFrame.lookAt(pos, map.SurvivorSpawn)
		end
		local char = Characters.spawn(player, cf, data.Role, data.KillerType)
		if not char then
			data.Status = "Left"
		end
	end

	if State.Killer then
		Powers.call(State.Killer, "Setup")
	end
	Totems.setup()
	Crows.setup()
	State.Active = true
	State.setGame("Phase", "InGame")

	for player, data in State.Participants do
		State.effect(player, "Intro", {
			Role = data.Role,
			KillerName = def.Name,
		})
		if data.Role == "Killer" then
			State.notify(player, "Ты — " .. def.Name .. ". " .. def.PowerHint, State.RED)
		else
			State.notify(player, "Ты — ВЫЖИВШИЙ. Почини генераторы и сбеги!", State.GREEN)
		end
	end
end

function Match.End(reason: string?)
	if not State.Active then
		return
	end
	State.Active = false

	local rows = {}
	local escaped, dead = 0, 0
	for player, data in State.Participants do
		if data.Role == "Survivor" then
			if data.Status == "Escaped" then
				escaped += 1
			elseif data.Status == "Dead" or data.Status == "Left" then
				dead += 1
			end
		end
		local total = Scoring.total(data)
		table.insert(rows, {
			Name = player.DisplayName,
			Role = data.Role,
			KillerType = data.KillerType,
			Status = data.Status,
			Score = Scoring.summary(data),
			Total = total,
		})
		Scoring.commit(player, total)
	end
	table.sort(rows, function(a, b)
		if a.Role ~= b.Role then
			return a.Role == "Killer"
		end
		return a.Total > b.Total
	end)
	local title
	if State.SoloTest then
		title = escaped > 0 and "Тестовый раунд: ты сбежал!" or "Тестовый раунд окончен"
	elseif escaped > dead then
		title = "Победа выживших!"
	elseif dead > escaped then
		title = "Победа маньяка!"
	else
		title = "Ничья"
	end
	Remotes.Results:FireAllClients(title, reason or "", rows)

	if State.Killer then
		Powers.call(State.Killer, "Cleanup")
	end
	for player, data in State.Participants do
		Lifecycle.detach(data)
		Actions.cancel(data)
		Items.cleanup(data)
		local root = State.getRoot(player)
		if root then
			root.Anchored = false
		end
		for _, attr in PLAYER_ATTRS do
			player:SetAttribute(attr, nil)
		end
		if player.Parent then
			task.spawn(Characters.spawnLobby, player)
		end
	end
	table.clear(State.Participants)
	State.Killer = nil
	State.setGame("EndGame", false)
	State.setGame("HexRuin", false)
	if State.Map then
		State.Map.Model:Destroy()
		State.Map = nil
	end
end

function Match.OnPlayerRemoving(player: Player)
	local data = State.get(player)
	if not data then
		return
	end
	Lifecycle.detach(data)
	Actions.cancel(data)
	if data.Status ~= "Dead" and data.Status ~= "Escaped" then
		data.Status = "Left"
		State.notifyAll(player.DisplayName .. " покинул игру", State.YELLOW)
	end
end

-- Смерть персонажа (например, кнопка «Reset»)
Characters.OnDied = function(player: Player, char: Model): boolean
	local data = State.get(player)
	if not State.Active or not data or player.Character ~= char then
		return false
	end
	if data.Role == "Killer" then
		data.Status = "Dead"
		return false
	end
	if State.isInGame(data) then
		Lifecycle.remove(data, "Dead", player.DisplayName .. " погиб", State.RED)
		return true
	end
	return false
end

Remotes.Sprint.OnServerEvent:Connect(function(player, value)
	local data = State.get(player)
	if data then
		data.Sprinting = value == true
	end
end)

Remotes.Crouch.OnServerEvent:Connect(function(player, value)
	local data = State.get(player)
	if data and data.Role == "Survivor" then
		data.Crouching = value == true
	end
end)

------------------------------------------------------------------------
-- Скорость и атрибуты
------------------------------------------------------------------------

local function survivorSpeed(data, t: number): number
	if data.Action or t < data.VaultUntil or data.Trapped or data.Hidden then
		return 0
	end
	if data.Health == 0 then
		return Config.SurvivorCrawlSpeed
	end
	if t < data.BoostUntil then
		return Config.SurvivorHitBoostSpeed
	end
	if data.Crouching then
		return Config.SurvivorCrouchSpeed
	end
	return data.Sprinting and Config.SurvivorSprintSpeed or Config.SurvivorWalkSpeed
end

local function killerSpeed(data, t: number): number
	if t < data.StunnedUntil or data.Action or t < data.VaultUntil then
		return 0
	end
	if data.Lunging then
		return Config.KillerLungeSpeed
	end
	if t < data.SlowUntil then
		return Config.AttackSlowSpeed
	end
	if t < data.BlindUntil then
		return 8
	end
	local override = Powers.call(data, "SpeedOverride", t)
	if override then
		return override
	end
	if data.Carrying then
		return Config.KillerCarrySpeed
	end
	return KillerDefs.get(data.KillerType).Speed
end

local function syncPlayer(player: Player, data, t: number)
	local hum = State.getHumanoid(player)
	local root = State.getRoot(player)
	if hum and State.isInGame(data) then
		hum.WalkSpeed = data.Role == "Killer" and killerSpeed(data, t) or survivorSpeed(data, t)
	end
	local running = false
	if data.Role == "Survivor" and data.Status == "Playing" and data.Health > 0 and data.Sprinting and not data.Crouching and root then
		running = (root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude > 11
	end
	player:SetAttribute("Status", data.Status)
	player:SetAttribute("Health", data.Health)
	player:SetAttribute("HookCount", data.HookCount)
	player:SetAttribute("HookProgress", data.Status == "Hooked" and data.HookTimer / Config.HookStageTime or nil)
	player:SetAttribute("BleedOut", (data.Status == "Playing" and data.Health == 0) and data.BleedOut / Config.BleedOutTime or nil)
	player:SetAttribute("Wiggle", data.Status == "Carried" and data.Wiggle or nil)
	player:SetAttribute("Stunned", t < data.StunnedUntil)
	player:SetAttribute("Blinded", t < data.BlindUntil)
	player:SetAttribute("Carrying", data.Carrying ~= nil)
	player:SetAttribute("Running", running)
	player:SetAttribute("Crouching", data.Crouching and data.Role == "Survivor" and data.Health > 0)
	if data.Role == "Killer" then
		local tr = Powers.call(data, "TerrorRadius")
		player:SetAttribute("TerrorRadius", tr or KillerDefs.get(data.KillerType).TerrorRadius)
	end
end

function Match.Update(dt: number)
	if not State.Active then
		return
	end
	local t = State.now()

	Actions.update(dt)
	Combat.update(dt)
	Carry.update(dt)
	Health.update(dt)
	Generators.update(dt)
	Exits.update(dt)
	Powers.update(dt)
	Items.update(dt)
	Crows.update(dt)
	Chase.update(dt)

	for player, data in State.Participants do
		syncPlayer(player, data, t)
	end

	-- Условия окончания раунда
	local k = State.Killer
	if State.remainingSurvivors() == 0 then
		Match.End()
	elseif not State.SoloTest and (not k or k.Status ~= "Playing" or not k.Player.Parent) then
		Match.End("Маньяк выбыл из игры")
	elseif t - State.StartTime > Config.MaxRoundTime then
		Match.End("Время вышло")
	end
end

return Match
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Scoring</string>
            <string name="Source"><![CDATA[-- Очки крови: 4 категории у выживших и 4 у маньяка, сохраняются в DataStore.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)

local Scoring = {}

Scoring.SurvivorCategories = { "Objectives", "Survival", "Altruism", "Boldness" }
Scoring.KillerCategories = { "Brutality", "Deviousness", "Hunter", "Sacrifice" }
Scoring.CategoryNames = {
	Objectives = "Цели",
	Survival = "Выживание",
	Altruism = "Альтруизм",
	Boldness = "Смелость",
	Brutality = "Жестокость",
	Deviousness = "Коварство",
	Hunter = "Охота",
	Sacrifice = "Жертвоприношение",
}

local store
if Config.SaveBloodpoints then
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("DBD_Bloodpoints_v1")
	end)
	if ok then
		store = result
	end
end

-- Добавить очки. label = nil — без всплывающей надписи
function Scoring.add(player: Player?, category: string, amount: number, label: string?)
	local data = State.get(player)
	if not data or not player then
		return
	end
	data.Score = data.Score or {}
	local current = data.Score[category] or 0
	local added = math.min(amount, Config.ScoreCategoryCap - current)
	if added <= 0 then
		return
	end
	data.Score[category] = current + added
	if label then
		Remotes.Score:FireClient(player, label, math.floor(added + 0.5), category)
	end
end

function Scoring.total(data): number
	local sum = 0
	for _, v in data.Score or {} do
		sum += v
	end
	return math.floor(sum)
end

function Scoring.summary(data)
	local cats = data.Role == "Killer" and Scoring.KillerCategories or Scoring.SurvivorCategories
	local out = {}
	for _, c in cats do
		table.insert(out, { Name = Scoring.CategoryNames[c], Value = math.floor((data.Score or {})[c] or 0) })
	end
	return out
end

function Scoring.load(player: Player)
	player:SetAttribute("Bloodpoints", 0)
	if not store then
		return
	end
	task.spawn(function()
		local ok, value = pcall(function()
			return store:GetAsync("u" .. player.UserId)
		end)
		if ok and typeof(value) == "number" and player.Parent then
			player:SetAttribute("Bloodpoints", value)
		end
	end)
end

function Scoring.commit(player: Player, amount: number)
	if amount <= 0 or not player.Parent then
		return
	end
	local current: number = (player:GetAttribute("Bloodpoints") :: number?) or 0
	player:SetAttribute("Bloodpoints", current + amount)
	if not store or player.UserId <= 0 then
		return
	end
	task.spawn(function()
		pcall(function()
			store:UpdateAsync("u" .. player.UserId, function(old)
				local prev: number = if typeof(old) == "number" then old else 0
				return prev + amount
			end)
		end)
	end)
end

Players.PlayerAdded:Connect(Scoring.load)
for _, p in Players:GetPlayers() do
	Scoring.load(p)
end

return Scoring
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[-- Общее состояние раунда и вспомогательные функции для всех систем.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)

local State = {}

State.Active = false
State.Participants = {} :: { [Player]: any }
State.Killer = nil :: any -- data маньяка
State.Map = nil :: any
State.SoloTest = false
State.GensDone = 0
State.GatesPowered = false
State.EndgameDeadline = nil :: number?
State.StartTime = 0
State.HexRuin = false
State.InitialSurvivors = 0

State.RED = Color3.fromRGB(255, 70, 70)
State.YELLOW = Color3.fromRGB(255, 220, 90)
State.GREEN = Color3.fromRGB(110, 255, 140)
State.WHITE = Color3.fromRGB(240, 240, 240)

State.getRoot = Util.getRoot
State.getHumanoid = Util.getHumanoid
State.flatDist = Util.flatDist

local gameState = ReplicatedStorage:FindFirstChild("GameState")
if not gameState then
	gameState = Instance.new("Folder")
	gameState.Name = "GameState"
	gameState.Parent = ReplicatedStorage
end
State.GameState = gameState

function State.now(): number
	return os.clock()
end

function State.setGame(key: string, value: any)
	gameState:SetAttribute(key, value)
end

function State.notifyAll(text: string, color: Color3?)
	Remotes.Notify:FireAllClients(text, color)
end

function State.notify(player: Player?, text: string, color: Color3?)
	if player and player.Parent then
		Remotes.Notify:FireClient(player, text, color)
	end
end

-- Звук для всех: where = Vector3, BasePart/Model или nil (без позиции)
function State.sfx(name: string, where: any?)
	Remotes.Sfx:FireAllClients(name, where)
end

function State.sfxTo(player: Player, name: string, where: any?)
	if player.Parent then
		Remotes.Sfx:FireClient(player, name, where)
	end
end

function State.effect(player: Player, name: string, value: any?)
	if player.Parent then
		Remotes.Effect:FireClient(player, name, value)
	end
end

-- Одноразовая анимация: клиенты видят смену AnimSeq и проигрывают позу
function State.playAnim(player: Player, name: string)
	local char = player.Character
	if char then
		char:SetAttribute("Anim", name)
		char:SetAttribute("AnimSeq", (char:GetAttribute("AnimSeq") or 0) + 1)
	end
end

-- Шум для маньяка (восклицательный знак на месте)
function State.noise(position: Vector3)
	local k = State.Killer
	if k and k.Player.Parent then
		Remotes.Noise:FireClient(k.Player, position)
	end
end

function State.isInGame(data): boolean
	return Util.isInGameStatus(data.Status)
end

function State.survivors(): { any }
	local list = {}
	for _, data in State.Participants do
		if data.Role == "Survivor" then
			table.insert(list, data)
		end
	end
	return list
end

function State.remainingSurvivors(): number
	local n = 0
	for _, data in State.Participants do
		if data.Role == "Survivor" and State.isInGame(data) then
			n += 1
		end
	end
	return n
end

function State.get(player: Player?)
	return player and State.Participants[player]
end

-- Можно ли выжившего ударить / схватить
function State.isTargetable(data): boolean
	return data.Status == "Playing" and not data.Hidden and State.now() >= data.VaultUntil
end

return State
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="23">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Точка входа сервера: лобби -> раунд -> результаты -> снова лобби.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

Players.CharacterAutoLoads = false

local Config = require(ReplicatedStorage.Shared.Config)
require(ReplicatedStorage.Shared.Remotes) -- создаёт RemoteEvent'ы
local MapBuilder = require(script.Parent.Map.MapBuilder)
local Characters = require(script.Parent.Core.Characters)
local Lobby = require(script.Parent.Core.Lobby)
local State = require(script.Parent.Core.State)
local Match = require(script.Parent.Core.Match)

MapBuilder.BuildLobby()
MapBuilder.SetupLighting()

local function onPlayerAdded(player: Player)
	task.spawn(Characters.spawnLobby, player)
end
Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	onPlayerAdded(player)
end
Players.PlayerRemoving:Connect(Match.OnPlayerRemoving)

RunService.Heartbeat:Connect(function(dt)
	local ok, err = pcall(Match.Update, dt)
	if not ok then
		warn("[DBD] Ошибка в Match.Update: " .. tostring(err))
	end
end)

local function minPlayers(): number
	if RunService:IsStudio() then
		return Config.StudioMinPlayers
	end
	return Config.MinPlayers
end

local function readyPlayers(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(list, player)
		end
	end
	return list
end

while true do
	State.setGame("Phase", "Waiting")
	State.setGame("Timer", 0)
	State.setGame("NeedPlayers", minPlayers())
	while #readyPlayers() < minPlayers() do
		task.wait(1)
	end

	local cancelled = false
	State.setGame("Phase", "Starting")
	for i = Config.LobbyCountdown, 1, -1 do
		State.setGame("Timer", i)
		task.wait(1)
		if #readyPlayers() < minPlayers() then
			cancelled = true
			break
		end
	end

	if not cancelled then
		local list = readyPlayers()
		local killer, killerType = Lobby.pickKiller(list)
		State.setGame("Phase", "Loading")
		local ok, err = pcall(Match.Start, list, killer, killerType)
		if not ok then
			warn("[DBD] Не удалось начать раунд: " .. tostring(err))
			State.Active = true
			Match.End("Ошибка запуска")
		end
		while State.Active do
			task.wait(0.5)
		end
		State.setGame("Phase", "Results")
		for i = Config.ResultsTime, 1, -1 do
			State.setGame("Timer", i)
			task.wait(1)
		end
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="24">
        <Properties>
          <string name="Name">Map</string>
        </Properties>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[-- Процедурно строит карту (каждый раунд новая раскладка), лобби и освещение.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage.Shared.Config)
local Props = require(script.Parent.Props)

local P = Props.part
local A = Props.A

local MapBuilder = {}

local CELL = 22

local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function shuffle(list, rng: Random)
	for i = #list, 2, -1 do
		local j = rng:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
end

export type MapData = {
	Model: Model,
	Walls: Folder,
	Decor: Folder,
	Generators: Folder,
	Hooks: Folder,
	Pallets: Folder,
	Windows: Folder,
	ExitGates: Folder,
	Lockers: Folder,
	Totems: Folder,
	Chests: Folder,
	Traps: Folder,
	Crows: Folder,
	Effects: Folder,
	Hatch: Model,
	TrapSpots: { CFrame },
	CrowSpots: { CFrame },
	SurvivorSpawn: Vector3,
	KillerSpawn: Vector3,
	ChestSpots: { CFrame },
	TotemSpots: { CFrame },
}

------------------------------------------------------------------------
-- Постройки
------------------------------------------------------------------------

local function palletLoop(map, cf: CFrame, rng: Random)
	local style = rng:NextNumber() < 0.5 and "Wood" or "Concrete"
	local walls = map.Walls
	Props.wall(walls, cf * CFrame.new(-5.6, 4, 0), Vector3.new(5.6, 8, 1.5), style)
	Props.wall(walls, cf * CFrame.new(5.6, 4, 0), Vector3.new(5.6, 8, 1.5), style)
	Props.wall(walls, cf * CFrame.new(-8.6, 4, 4), Vector3.new(1.5, 8, 8), style)
	Props.wall(walls, cf * CFrame.new(8.6, 4, -4), Vector3.new(1.5, 8, 8), style)
	local upCF = cf * CFrame.new(-1.8, 3, 1) * A(0, 0, 78)
	Props.pallet(map.Pallets, upCF, cf * CFrame.new(0, 1.5, 0))
	table.insert(map.TrapSpots, cf * CFrame.new(0, 0, rng:NextNumber() < 0.5 and 3.5 or -3.5))
	table.insert(map.CrowSpots, cf * CFrame.new(-5.6, 8, 0))
end

local function windowLoop(map, cf: CFrame, rng: Random)
	local style = rng:NextNumber() < 0.5 and "Brick" or "Concrete"
	Props.wallWithOpenings(map.Walls, cf, 18, 10, 1.5, {
		{ Center = 0, Width = 4, Sill = 3, Top = 7 },
	}, style, map.Windows)
	Props.wall(map.Walls, cf * CFrame.new(-9.75, 5, -5), Vector3.new(1.5, 10, 10), style)
	Props.wall(map.Walls, cf * CFrame.new(9.75, 5, 5), Vector3.new(1.5, 10, 10), style)
	table.insert(map.TrapSpots, cf * CFrame.new(0, 0, -3))
end

local function roof(parent: Instance, cf: CFrame, size: Vector3)
	P(parent, {
		Name = "Roof",
		Size = size,
		CFrame = cf,
		Color = Color3.fromRGB(90, 60, 45),
		Material = Enum.Material.CorrodedMetal,
	})
end

local function floor(parent: Instance, cf: CFrame, size: Vector2)
	P(parent, {
		Name = "Floor",
		Size = Vector3.new(size.X, 0.2, size.Y),
		CFrame = cf * CFrame.new(0, 0.1, 0),
		Color = Color3.fromRGB(80, 60, 45),
		Material = Enum.Material.WoodPlanks,
	})
end

-- Хижина маньяка в центре карты
local function shack(map, cf: CFrame)
	local walls = map.Walls
	local h = 9
	Props.wallWithOpenings(walls, cf * CFrame.new(0, 0, -8), 17, h, 1, {
		{ Center = 0, Width = 5.8, Sill = 0, Top = 7 },
	}, "Wood", map.Windows)
	Props.wallWithOpenings(walls, cf * CFrame.new(0, 0, 8), 17, h, 1, {
		{ Center = 3, Width = 4, Sill = 3, Top = 7 },
	}, "Wood", map.Windows)
	Props.wallWithOpenings(walls, cf * CFrame.new(-8, 0, 0) * A(0, 90, 0), 15, h, 1, {
		{ Center = 2, Width = 4, Sill = 3, Top = 7 },
	}, "Wood", map.Windows)
	Props.wallWithOpenings(walls, cf * CFrame.new(8, 0, 0) * A(0, 90, 0), 15, h, 1, {
		{ Center = -2, Width = 5, Sill = 0, Top = 7 },
	}, "Wood", map.Windows)
	roof(walls, cf * CFrame.new(0, h + 0.3, 0) * A(0, 0, 4), Vector3.new(19, 0.6, 19))
	floor(map.Decor, cf, Vector2.new(15.5, 15.5))
	Props.pallet(map.Pallets, cf * CFrame.new(-1.8, 3, -7) * A(0, 0, 78), cf * CFrame.new(0, 1.5, -8))
	Props.locker(map.Lockers, cf * CFrame.new(-5.5, 0, 6.2))
	table.insert(map.ChestSpots, cf * CFrame.new(5.2, 0, 5.4))
	table.insert(map.TotemSpots, cf * CFrame.new(-11, 0, -9))
	table.insert(map.CrowSpots, cf * CFrame.new(6, h + 0.6, -6))
	-- Тусклая лампочка внутри
	local bulb = P(map.Decor, {
		Name = "Bulb",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.6, 0.6, 0.6),
		CFrame = cf * CFrame.new(0, h - 1, 0),
		Color = Color3.fromRGB(255, 200, 120),
		Material = Enum.Material.Neon,
		Decor = true,
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 160, 90)
	light.Range = 16
	light.Brightness = 1.2
	light.Shadows = true
	light.Parent = bulb
end

-- Дом из двух комнат
local function house(map, cf: CFrame)
	local walls = map.Walls
	local h = 10
	Props.wallWithOpenings(walls, cf * CFrame.new(0, 0, -9), 21, h, 1, {
		{ Center = -5, Width = 5.8, Sill = 0, Top = 7.5 },
		{ Center = 5, Width = 4, Sill = 3, Top = 7 },
	}, "Brick", map.Windows)
	Props.wallWithOpenings(walls, cf * CFrame.new(0, 0, 9), 21, h, 1, {
		{ Center = -5, Width = 4, Sill = 3, Top = 7 },
		{ Center = 5, Width = 4.5, Sill = 0, Top = 7.5 },
	}, "Brick", map.Windows)
	Props.wallWithOpenings(walls, cf * CFrame.new(-10, 0, 0) * A(0, 90, 0), 17, h, 1, {
		{ Center = 2, Width = 4, Sill = 3, Top = 7 },
	}, "Brick", map.Windows)
	Props.wall(walls, cf * CFrame.new(10, h / 2, 0), Vector3.new(1, h, 17), "Brick")
	Props.wallWithOpenings(walls, cf * CFrame.new(0, 0, 0) * A(0, 90, 0), 17, h, 0.8, {
		{ Center = 3, Width = 4.5, Sill = 0, Top = 7.5 },
	}, "Wood", map.Windows)
	roof(walls, cf * CFrame.new(0, h + 0.3, 0), Vector3.new(23, 0.6, 21))
	floor(map.Decor, cf, Vector2.new(19.5, 17.5))
	Props.pallet(map.Pallets, cf * CFrame.new(-6.8, 3, -8) * A(0, 0, 78), cf * CFrame.new(-5, 1.5, -9))
	Props.locker(map.Lockers, cf * CFrame.new(-8, 0, 6.8))
	Props.locker(map.Lockers, cf * CFrame.new(7.6, 0, 6.8))
	table.insert(map.ChestSpots, cf * CFrame.new(-7.5, 0, -2) * A(0, 90, 0))
	table.insert(map.TotemSpots, cf * CFrame.new(7, 0, -6))
	for _, x in { -5, 5 } do
		local bulb = P(map.Decor, {
			Name = "Bulb",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.6, 0.6, 0.6),
			CFrame = cf * CFrame.new(x, h - 1, 0),
			Color = Color3.fromRGB(255, 210, 140),
			Material = Enum.Material.Neon,
			Decor = true,
		})
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 170, 100)
		light.Range = 14
		light.Brightness = 1
		light.Parent = bulb
	end
end

------------------------------------------------------------------------
-- Карта
------------------------------------------------------------------------

function MapBuilder.BuildMap(seed: number?): MapData
	local old = workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end

	local rng = Random.new(seed or os.clock() * 1000)
	local size = Config.MapSize
	local half = size / 2

	local model = Instance.new("Model")
	model.Name = "Map"
	local map = {
		Model = model,
		Walls = folder("Walls", model),
		Decor = folder("Decor", model),
		Generators = folder("Generators", model),
		Hooks = folder("Hooks", model),
		Pallets = folder("Pallets", model),
		Windows = folder("Windows", model),
		ExitGates = folder("ExitGates", model),
		Lockers = folder("Lockers", model),
		Totems = folder("Totems", model),
		Chests = folder("Chests", model),
		Traps = folder("Traps", model),
		Crows = folder("Crows", model),
		Effects = folder("Effects", model),
		TrapSpots = {},
		CrowSpots = {},
		ChestSpots = {},
		TotemSpots = {},
	}

	P(model, {
		Name = "Ground",
		Size = Vector3.new(size + 4, 2, size + 4),
		CFrame = CFrame.new(0, -1, 0),
		Color = Color3.fromRGB(42, 52, 33),
		Material = Enum.Material.Grass,
	})

	-- Внешние стены с проёмами под ворота на севере и юге
	local wallH = 16
	local gateGap = 16
	local sideLen = (size - gateGap) / 2
	for _, side in { 1, -1 } do
		for _, dir in { 1, -1 } do
			Props.wall(
				map.Walls,
				CFrame.new(dir * (gateGap / 2 + sideLen / 2), wallH / 2, side * half),
				Vector3.new(sideLen, wallH, 2)
			)
		end
		Props.wall(map.Walls, CFrame.new(side * half, wallH / 2, 0), Vector3.new(2, wallH, size))
	end
	for i, side in { 1, -1 } do
		Props.exitGate(map.ExitGates, side, i)
	end

	-- Сетка ячеек
	local n = math.floor(size / CELL)
	local cells = {}
	local center
	for ix = 1, n do
		for iz = 1, n do
			local cx = -half + CELL * (ix - 0.5)
			local cz = -half + CELL * (iz - 0.5)
			local nearGate = math.abs(cx) < CELL and (iz == 1 or iz == n)
			if ix == math.ceil(n / 2) and iz == math.ceil(n / 2) then
				center = Vector3.new(cx, 0, cz)
			elseif not nearGate then
				table.insert(cells, Vector3.new(cx, 0, cz))
			end
		end
	end
	shuffle(cells, rng)

	local idx = 0
	local function nextCell(): (CFrame, Vector3)
		idx += 1
		local c = cells[idx]
		local rot = rng:NextInteger(0, 3) * 90
		return CFrame.new(c) * A(0, rot, 0), c
	end

	shack(map, CFrame.new(center) * A(0, rng:NextInteger(0, 3) * 90, 0))
	house(map, (nextCell()))

	for i = 1, Config.GeneratorCount do
		local cf = nextCell()
		Props.generator(map.Generators, cf, i)
		Props.wall(map.Walls, cf * CFrame.new(0, 3, 6.5), Vector3.new(10, 6, 1.5), rng:NextNumber() < 0.5 and "Wood" or "Brick")
		table.insert(map.TrapSpots, cf * CFrame.new(rng:NextNumber(-4, 4), 0, -4))
	end
	for i = 1, 8 do
		local cf = nextCell()
		Props.hook(map.Hooks, cf, i)
		table.insert(map.CrowSpots, cf * CFrame.new(0, 12, 0))
	end
	for _ = 1, 8 do
		palletLoop(map, (nextCell()), rng)
	end
	for _ = 1, 3 do
		windowLoop(map, (nextCell()), rng)
	end
	for _ = 1, 2 do
		local cf = nextCell()
		Props.wall(map.Walls, cf * CFrame.new(0, 4, 2), Vector3.new(8, 8, 1.2), "Wood")
		Props.locker(map.Lockers, cf * CFrame.new(-2, 0, 0.3))
		Props.locker(map.Lockers, cf * CFrame.new(1.4, 0, 0.3))
	end
	for _ = 1, 3 do
		local cf = nextCell()
		table.insert(map.TotemSpots, cf)
		Props.rock(map.Walls, cf * CFrame.new(0, 0, 6), rng)
	end
	for _ = 1, 3 do
		local cf = nextCell()
		table.insert(map.ChestSpots, cf)
		Props.hay(map.Walls, cf * CFrame.new(0, 0, 5), rng)
	end

	-- Люк
	local hatchCF = nextCell()
	map.Hatch = Props.hatch(map.Model, hatchCF)

	-- Тотемы (один — проклятый) и сундуки
	shuffle(map.TotemSpots, rng)
	for i = 1, math.min(5, #map.TotemSpots) do
		Props.totem(map.Totems, map.TotemSpots[i], i == 1, rng)
	end
	for _, cf in map.ChestSpots do
		Props.chest(map.Chests, cf)
	end

	-- Декор
	for _ = 1, 4 do
		Props.junkPile(map.Walls, (nextCell()), rng)
	end
	for _ = 1, 3 do
		Props.corn(map.Decor, (nextCell()), rng)
	end
	for _ = 1, 6 do
		local cf = nextCell()
		for _ = 1, rng:NextInteger(2, 3) do
			Props.tree(map.Walls, cf * CFrame.new(rng:NextNumber(-8, 8), 0, rng:NextNumber(-8, 8)), rng)
		end
	end
	for _ = 1, 3 do
		local cf = nextCell()
		Props.deadTree(map.Walls, cf, rng)
		table.insert(map.CrowSpots, cf * CFrame.new(0, 0, 3))
	end
	for _ = 1, 4 do
		Props.rock(map.Walls, (nextCell()), rng)
	end
	for _ = 1, 2 do
		Props.tombstones(map.Walls, (nextCell()), rng)
	end
	for _ = 1, 3 do
		local cf = nextCell()
		Props.barrel(map.Walls, cf * CFrame.new(-3, 0, 0), rng)
		Props.barrel(map.Walls, cf * CFrame.new(-0.6, 0, 1), rng)
		Props.fire(map.Decor, cf * CFrame.new(-3, 3.2, 0), 1)
		Props.hay(map.Walls, cf * CFrame.new(4, 0, 0), rng)
	end
	for _ = 1, 3 do
		local cf = nextCell()
		Props.fence(map.Walls, cf * CFrame.new(0, 0, -4), 16)
		table.insert(map.CrowSpots, cf * CFrame.new(rng:NextNumber(-6, 6), 4.5, -4))
	end
	for _ = 1, 5 do
		Props.lamp(map.Decor, (nextCell()))
	end

	-- Туман по всей карте
	for _ = 1, 14 do
		Props.fog(map.Decor, Vector3.new(rng:NextNumber(-half, half), 1, rng:NextNumber(-half, half)), rng)
	end

	-- Оставшиеся пустые ячейки — для спавна
	local free = {}
	for i = idx + 1, #cells do
		table.insert(free, cells[i])
	end
	local survivorSpawn = free[1] or Vector3.new(30, 0, 30)
	local killerSpawn = survivorSpawn
	local best = -1
	for _, c in free do
		local d = (c - survivorSpawn).Magnitude
		if d > best then
			best = d
			killerSpawn = c
		end
	end
	map.SurvivorSpawn = survivorSpawn + Vector3.new(0, 3.2, 0)
	map.KillerSpawn = killerSpawn + Vector3.new(0, 3.5, 0)
	for i = 2, #free do
		table.insert(map.CrowSpots, CFrame.new(free[i] + Vector3.new(rng:NextNumber(-6, 6), 0, rng:NextNumber(-6, 6))))
	end

	model.Parent = workspace
	return map :: any
end

------------------------------------------------------------------------
-- Лобби у костра
------------------------------------------------------------------------

function MapBuilder.BuildLobby(): Model
	local existing = workspace:FindFirstChild("Lobby")
	if existing then
		return existing :: Model
	end
	local rng = Random.new(42)
	local lobby = Instance.new("Model")
	lobby.Name = "Lobby"
	local pos = Config.LobbyPosition
	local base = CFrame.new(pos)

	P(lobby, {
		Name = "Ground",
		Size = Vector3.new(120, 2, 120),
		CFrame = base * CFrame.new(0, -1, 0),
		Color = Color3.fromRGB(38, 48, 30),
		Material = Enum.Material.Grass,
	})
	-- Невидимые стены
	for _, d in
		{
			{ Vector3.new(0, 15, 60), Vector3.new(120, 30, 2) },
			{ Vector3.new(0, 15, -60), Vector3.new(120, 30, 2) },
			{ Vector3.new(60, 15, 0), Vector3.new(2, 30, 120) },
			{ Vector3.new(-60, 15, 0), Vector3.new(2, 30, 120) },
		}
	do
		P(lobby, { Name = "Barrier", Size = d[2], CFrame = base * CFrame.new(d[1]), Transparency = 1 })
	end

	-- Костёр
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		P(lobby, {
			Name = "FireStone",
			Size = Vector3.new(1.2, 0.8, 1),
			CFrame = base * CFrame.new(math.cos(a) * 2.4, 0.4, math.sin(a) * 2.4) * A(0, -math.deg(a), 0),
			Color = Color3.fromRGB(80, 78, 75),
			Material = Enum.Material.Slate,
		})
	end
	for i = 1, 4 do
		P(lobby, {
			Name = "FireLog",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3, 0.6, 0.6),
			CFrame = base * CFrame.new(0, 0.5, 0) * A(0, i * 45, 25),
			Color = Color3.fromRGB(50, 35, 25),
			Material = Enum.Material.Wood,
		})
	end
	Props.fire(lobby, base * CFrame.new(0, 1.2, 0), 2.2)

	-- Брёвна-сиденья вокруг костра
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		local seatPos = pos + Vector3.new(math.cos(a) * 9, 0.7, math.sin(a) * 9)
		local seat = Instance.new("Seat")
		seat.Name = "LogSeat"
		seat.Anchored = true
		seat.Shape = Enum.PartType.Cylinder
		seat.Size = Vector3.new(5, 1.4, 1.4)
		seat.CFrame = CFrame.lookAt(seatPos, Vector3.new(pos.X, seatPos.Y, pos.Z))
		seat.Color = Color3.fromRGB(70, 50, 35)
		seat.Material = Enum.Material.Wood
		seat.CollisionGroup = "DBDSeats"
		seat.Parent = lobby
	end

	-- Палатки, деревья, туман
	for i = 1, 3 do
		local a = i / 3 * math.pi * 2 + 0.5
		local tcf = CFrame.lookAt(pos + Vector3.new(math.cos(a) * 22, 0, math.sin(a) * 22), pos)
		for _, side in { -1, 1 } do
			local w = Instance.new("WedgePart")
			w.Anchored = true
			w.Size = Vector3.new(0.3, 4, 3)
			w.CFrame = tcf * CFrame.new(side * 1.5, 2, 0) * A(0, side * 90, 0)
			w.Color = Color3.fromRGB(70 + i * 20, 80, 60)
			w.Material = Enum.Material.Fabric
			w.Parent = lobby
		end
		P(lobby, {
			Name = "TentFloor",
			Size = Vector3.new(6, 0.2, 6),
			CFrame = tcf * CFrame.new(0, 0.1, 0),
			Color = Color3.fromRGB(60, 55, 45),
			Material = Enum.Material.Fabric,
		})
	end
	for _ = 1, 26 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(32, 55)
		Props.tree(lobby, base * CFrame.new(math.cos(a) * r, 0, math.sin(a) * r), rng)
	end
	for _ = 1, 6 do
		Props.fog(lobby, pos + Vector3.new(rng:NextNumber(-40, 40), 1, rng:NextNumber(-40, 40)), rng)
	end

	-- Табличка
	local board = P(lobby, {
		Name = "Sign",
		Size = Vector3.new(12, 4, 0.4),
		CFrame = base * CFrame.new(0, 5, -26),
		Color = Color3.fromRGB(60, 40, 30),
		Material = Enum.Material.WoodPlanks,
	})
	for _, x in { -5, 5 } do
		P(lobby, {
			Name = "SignPost",
			Size = Vector3.new(0.5, 5, 0.5),
			CFrame = base * CFrame.new(x, 2.5, -26),
			Color = Color3.fromRGB(50, 35, 25),
			Material = Enum.Material.Wood,
		})
	end
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.CanvasSize = Vector2.new(600, 200)
	gui.Parent = board
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Text = "DEAD BY DAYLIGHT"
	text.Font = Enum.Font.Creepster
	text.TextScaled = true
	text.TextColor3 = Color3.fromRGB(190, 20, 20)
	text.Parent = gui

	lobby.Parent = workspace
	return lobby
end

-- Точка появления в лобби (по кругу у костра)
function MapBuilder.LobbySpawn(): CFrame
	local pos = Config.LobbyPosition
	local a = math.random() * math.pi * 2
	local p = pos + Vector3.new(math.cos(a) * 14, 3.5, math.sin(a) * 14)
	return CFrame.lookAt(p, Vector3.new(pos.X, p.Y, pos.Z))
end

------------------------------------------------------------------------
-- Освещение
------------------------------------------------------------------------

function MapBuilder.SetupLighting()
	Lighting.ClockTime = 0.3
	Lighting.Brightness = 1.2
	Lighting.Ambient = Color3.fromRGB(35, 35, 50)
	Lighting.OutdoorAmbient = Color3.fromRGB(70, 70, 90)
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.GlobalShadows = true
	Lighting.FogEnd = 100000
	for _, child in Lighting:GetChildren() do
		child:Destroy()
	end

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.48
	atmosphere.Offset = 0.1
	atmosphere.Color = Color3.fromRGB(120, 130, 155)
	atmosphere.Decay = Color3.fromRGB(40, 45, 60)
	atmosphere.Glare = 0
	atmosphere.Haze = 2.2
	atmosphere.Parent = Lighting

	local sky = Instance.new("Sky")
	sky.CelestialBodiesShown = true
	sky.MoonAngularSize = 14
	sky.StarCount = 1500
	sky.Parent = Lighting

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = -0.35
	cc.Contrast = 0.15
	cc.Brightness = 0.02
	cc.TintColor = Color3.fromRGB(215, 225, 255)
	cc.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 30
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[-- Детализированные объекты карты. Всё строится из обычных деталей (Part),
-- поэтому не нужны модели из Toolbox.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Props = {}

local SMOKE_TEX = "rbxasset://textures/particles/smoke_main.dds"
local SPARK_TEX = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE_TEX = "rbxasset://textures/particles/fire_main.dds"
Props.SmokeTexture = SMOKE_TEX
Props.SparkTexture = SPARK_TEX

local rad = math.rad

local function A(x, y, z)
	return CFrame.Angles(rad(x or 0), rad(y or 0), rad(z or 0))
end
Props.A = A

-- Создаёт деталь. Мелкий декор (Decor = true) не сталкивается и не мешает лучам.
function Props.part(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	local decor = props.Decor
	for k, v in props do
		if k ~= "Decor" then
			(p :: any)[k] = v
		end
	end
	if decor then
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
	end
	p.Parent = parent
	return p
end
local P = Props.part

local function model(name: string, parent: Instance?): Model
	local m = Instance.new("Model")
	m.Name = name
	if parent then
		m.Parent = parent
	end
	return m
end
Props.model = model

local COLORS = {
	Concrete = Color3.fromRGB(92, 88, 84),
	Wood = Color3.fromRGB(105, 78, 52),
	DarkWood = Color3.fromRGB(70, 52, 38),
	Rust = Color3.fromRGB(110, 60, 35),
	Metal = Color3.fromRGB(90, 92, 95),
	Bone = Color3.fromRGB(225, 215, 190),
	Black = Color3.fromRGB(20, 20, 22),
}
Props.Colors = COLORS

local WALL_STYLES = {
	Wood = { COLORS.Wood, Enum.Material.WoodPlanks },
	Brick = { Color3.fromRGB(110, 60, 50), Enum.Material.Brick },
	Concrete = { COLORS.Concrete, Enum.Material.Concrete },
}

function Props.wall(parent: Instance, cf: CFrame, size: Vector3, style: string?): Part
	local st = WALL_STYLES[style or "Concrete"] or WALL_STYLES.Concrete
	return P(parent, {
		Name = "Wall",
		Size = size,
		CFrame = cf,
		Color = st[1],
		Material = st[2],
	})
end

-- Стена вдоль локальной оси X с проёмами.
-- openings = { {Center = x, Width = w, Sill = высота подоконника или 0 для двери, Top = верх проёма} }
-- Возвращает подоконники (их можно перепрыгивать).
function Props.wallWithOpenings(
	parent: Instance,
	cf: CFrame,
	length: number,
	height: number,
	thick: number,
	openings,
	style: string?,
	windowParent: Instance?
)
	table.sort(openings, function(a, b)
		return a.Center < b.Center
	end)
	local sills = {}
	local x = -length / 2
	local function segment(x0, x1, y0, y1)
		if x1 - x0 > 0.05 and y1 - y0 > 0.05 then
			Props.wall(parent, cf * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, 0), Vector3.new(x1 - x0, y1 - y0, thick), style)
		end
	end
	for _, o in openings do
		local x0, x1 = o.Center - o.Width / 2, o.Center + o.Width / 2
		segment(x, x0, 0, height)
		segment(x0, x1, o.Top, height)
		if o.Sill > 0 then
			local sill = P(windowParent or parent, {
				Name = "Window",
				Size = Vector3.new(o.Width, o.Sill, thick),
				CFrame = cf * CFrame.new(o.Center, o.Sill / 2, 0),
				Color = COLORS.DarkWood,
				Material = Enum.Material.Wood,
			})
			sill:SetAttribute("Kind", "Window")
			table.insert(sills, sill)
		end
		x = x1
	end
	segment(x, length / 2, 0, height)
	return sills
end

------------------------------------------------------------------------
-- Генератор
------------------------------------------------------------------------

function Props.generator(parent: Instance, cf: CFrame, index: number): Model
	local m = model("Generator" .. index)
	P(m, {
		Name = "Base",
		Size = Vector3.new(4.6, 0.5, 3.4),
		CFrame = cf * CFrame.new(0, 0.25, 0),
		Color = COLORS.Rust,
		Material = Enum.Material.CorrodedMetal,
	})
	local body = P(m, {
		Name = "Body",
		Size = Vector3.new(4, 3, 3),
		CFrame = cf * CFrame.new(0, 2, 0),
		Color = Color3.fromRGB(78, 84, 74),
		Material = Enum.Material.DiamondPlate,
	})
	P(m, {
		Name = "Engine",
		Size = Vector3.new(2.6, 1.3, 2.2),
		CFrame = cf * CFrame.new(-0.5, 4.15, 0),
		Color = Color3.fromRGB(45, 45, 45),
		Material = Enum.Material.Metal,
	})
	for i = 1, 2 do
		P(m, {
			Name = "Piston" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.3, 0.55, 0.55),
			CFrame = cf * CFrame.new(-1.1 + (i - 1) * 1.1, 5.2, 0) * A(0, 0, 90),
			Color = Color3.fromRGB(150, 150, 150),
			Material = Enum.Material.Metal,
			Decor = true,
		})
	end
	P(m, {
		Name = "Exhaust",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.2, 0.35, 0.35),
		CFrame = cf * CFrame.new(1.4, 4.4, 1) * A(0, 0, 90),
		Color = COLORS.Black,
		Material = Enum.Material.Metal,
		Decor = true,
	})
	-- Кабели к земле
	for i = 1, 3 do
		P(m, {
			Name = "Cable",
			Size = Vector3.new(0.15, 0.15, 3),
			CFrame = cf * CFrame.new(-1.5 + i * 0.6, 0.6, -2.7) * A(-12, (i - 2) * 15, 0),
			Color = COLORS.Black,
			Material = Enum.Material.Rubber,
			Decor = true,
		})
	end
	-- Лампочки прогресса (4 штуки)
	P(m, {
		Name = "LightBar",
		Size = Vector3.new(2.4, 0.25, 0.4),
		CFrame = cf * CFrame.new(0, 3.65, -1.55),
		Color = COLORS.Black,
		Material = Enum.Material.Metal,
		Decor = true,
	})
	for i = 1, 4 do
		P(m, {
			Name = "Light" .. i,
			Size = Vector3.new(0.35, 0.35, 0.2),
			CFrame = cf * CFrame.new(-0.9 + (i - 1) * 0.6, 3.65, -1.8),
			Color = Color3.fromRGB(45, 40, 30),
			Material = Enum.Material.Glass,
			Decor = true,
		})
	end
	-- Большая лампа, загорается после ремонта
	local bulb = P(m, {
		Name = "Bulb",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.1, 1.1, 1.1),
		CFrame = cf * CFrame.new(1.2, 5.3, -0.6),
		Color = Color3.fromRGB(60, 60, 50),
		Material = Enum.Material.Glass,
		Decor = true,
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 230, 150)
	light.Range = 28
	light.Brightness = 3
	light.Shadows = true
	light.Enabled = false
	light.Parent = bulb

	-- Искры и дым при провале проверки навыка
	local fx = Instance.new("Attachment")
	fx.Name = "FX"
	fx.Position = Vector3.new(0, 1.8, 0)
	fx.Parent = body
	local sparks = Instance.new("ParticleEmitter")
	sparks.Name = "Sparks"
	sparks.Texture = SPARK_TEX
	sparks.Color = ColorSequence.new(Color3.fromRGB(255, 190, 80))
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new(0.3, 0)
	sparks.Speed = NumberRange.new(10, 18)
	sparks.SpreadAngle = Vector2.new(70, 70)
	sparks.Lifetime = NumberRange.new(0.3, 0.7)
	sparks.Acceleration = Vector3.new(0, -40, 0)
	sparks.Enabled = false
	sparks.Parent = fx
	local smoke = Instance.new("ParticleEmitter")
	smoke.Name = "Smoke"
	smoke.Texture = SMOKE_TEX
	smoke.Color = ColorSequence.new(Color3.fromRGB(40, 40, 40))
	smoke.Size = NumberSequence.new(1.5, 5)
	smoke.Transparency = NumberSequence.new(0.3, 1)
	smoke.Speed = NumberRange.new(3, 6)
	smoke.Lifetime = NumberRange.new(1.5, 2.5)
	smoke.Enabled = false
	smoke.Parent = fx

	m.PrimaryPart = body
	m:SetAttribute("Kind", "Generator")
	m:SetAttribute("Progress", 0)
	m:SetAttribute("Done", false)
	m:SetAttribute("Regressing", false)
	m.Parent = parent
	return m
end

------------------------------------------------------------------------
-- Крюк
------------------------------------------------------------------------

function Props.hook(parent: Instance, cf: CFrame, index: number): Model
	local m = model("Hook" .. index)
	local red = Color3.fromRGB(95, 25, 20)
	P(m, {
		Name = "Base",
		Size = Vector3.new(2.6, 0.8, 2.6),
		CFrame = cf * CFrame.new(0, 0.4, 0) * A(0, 20, 0),
		Color = Color3.fromRGB(70, 65, 60),
		Material = Enum.Material.Slate,
	})
	local pole = P(m, {
		Name = "Pole",
		Size = Vector3.new(0.9, 12, 0.9),
		CFrame = cf * CFrame.new(0, 6, 0),
		Color = red,
		Material = Enum.Material.CorrodedMetal,
	})
	P(m, {
		Name = "Arm",
		Size = Vector3.new(0.7, 0.7, 4.4),
		CFrame = cf * CFrame.new(0, 11.4, -2),
		Color = red,
		Material = Enum.Material.CorrodedMetal,
	})
	P(m, {
		Name = "Brace",
		Size = Vector3.new(0.4, 0.4, 3),
		CFrame = cf * CFrame.new(0, 10.3, -1) * A(-45, 0, 0),
		Color = red,
		Material = Enum.Material.CorrodedMetal,
		Decor = true,
	})
	-- Цепь из звеньев
	for i = 1, 4 do
		P(m, {
			Name = "Link",
			Size = Vector3.new(0.12, 0.45, 0.25),
			CFrame = cf * CFrame.new(0, 11 - i * 0.4, -3.9) * A(0, i % 2 == 0 and 90 or 0, 0),
			Color = Color3.fromRGB(80, 80, 80),
			Material = Enum.Material.Metal,
			Decor = true,
		})
	end
	-- Сам крюк (изогнутый из трёх частей)
	local steel = Color3.fromRGB(160, 155, 150)
	P(m, {
		Name = "HookShaft",
		Size = Vector3.new(0.25, 1.4, 0.25),
		CFrame = cf * CFrame.new(0, 8.8, -3.9),
		Color = steel,
		Material = Enum.Material.Metal,
		Decor = true,
	})
	P(m, {
		Name = "HookCurve",
		Size = Vector3.new(0.25, 0.25, 0.9),
		CFrame = cf * CFrame.new(0, 8.1, -3.55),
		Color = steel,
		Material = Enum.Material.Metal,
		Decor = true,
	})
	P(m, {
		Name = "HookTip",
		Size = Vector3.new(0.22, 0.8, 0.22),
		CFrame = cf * CFrame.new(0, 8.45, -3.15) * A(-15, 0, 0),
		Color = steel,
		Material = Enum.Material.Metal,
		Decor = true,
	})
	-- Пятно крови под крюком
	P(m, {
		Name = "Blood",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.05, 2.6, 2.6),
		CFrame = cf * CFrame.new(0, 0.03, -3.9) * A(0, 0, 90),
		Color = Color3.fromRGB(70, 5, 5),
		Material = Enum.Material.SmoothPlastic,
		Decor = true,
	})
	-- Точка, где висит выживший (HumanoidRootPart), смотрит от столба
	P(m, {
		Name = "HangPoint",
		Size = Vector3.new(1, 1, 1),
		CFrame = cf * CFrame.new(0.25, 7, -4.3),
		Transparency = 1,
		Decor = true,
	})
	m.PrimaryPart = pole
	m:SetAttribute("Kind", "Hook")
	m:SetAttribute("Occupant", 0)
	m.Parent = parent
	return m
end

-- Лапы Сущности вокруг крюка (на 2-й стадии и при жертвоприношении)
function Props.entityLegs(hook: Model, count: number): Model
	local hp = hook:FindFirstChild("HangPoint") :: BasePart
	local m = model("EntityLegs", hook)
	for i = 1, count do
		local angle = (i / count) * math.pi * 2
		local base = hp.CFrame * CFrame.new(math.cos(angle) * 3.5, 5, math.sin(angle) * 3.5)
		local look = CFrame.lookAt(base.Position, hp.Position + Vector3.new(0, 1, 0))
		P(m, {
			Name = "Leg",
			Size = Vector3.new(0.35, 0.35, 7),
			CFrame = look * CFrame.new(0, 0, -3.5),
			Color = Color3.fromRGB(25, 10, 10),
			Material = Enum.Material.Slate,
			Decor = true,
		})
		P(m, {
			Name = "Tip",
			Size = Vector3.new(0.2, 0.2, 1.4),
			CFrame = look * CFrame.new(0, 0, -7.4),
			Color = Color3.fromRGB(200, 40, 20),
			Material = Enum.Material.Neon,
			Decor = true,
		})
	end
	return m
end

------------------------------------------------------------------------
-- Паллета (модель из досок + невидимый хитбокс)
------------------------------------------------------------------------

function Props.pallet(parent: Instance, upCF: CFrame, dropCF: CFrame): Model
	local m = model("Pallet")
	local hitbox = P(m, {
		Name = "Hitbox",
		Size = Vector3.new(5.6, 3, 1.2),
		CFrame = upCF,
		Transparency = 1,
		CanCollide = false,
	})
	local wood = Color3.fromRGB(150, 112, 66)
	-- Поперечные доски
	for i = 0, 3 do
		P(m, {
			Name = "Slat",
			Size = Vector3.new(5.6, 0.55, 0.2),
			CFrame = upCF * CFrame.new(0, -1.15 + i * 0.77, -0.45),
			Color = wood:Lerp(Color3.new(0, 0, 0), (i % 2) * 0.1),
			Material = Enum.Material.WoodPlanks,
			Decor = true,
		})
		P(m, {
			Name = "Slat",
			Size = Vector3.new(5.6, 0.55, 0.2),
			CFrame = upCF * CFrame.new(0, -1.15 + i * 0.77, 0.45),
			Color = wood:Lerp(Color3.new(0, 0, 0), 0.15),
			Material = Enum.Material.WoodPlanks,
			Decor = true,
		})
	end
	-- Продольные бруски
	for _, x in { -2.4, 0, 2.4 } do
		P(m, {
			Name = "Stringer",
			Size = Vector3.new(0.5, 3, 0.7),
			CFrame = upCF * CFrame.new(x, 0, 0),
			Color = wood:Lerp(Color3.new(0, 0, 0), 0.25),
			Material = Enum.Material.Wood,
			Decor = true,
		})
	end
	m.PrimaryPart = hitbox
	m:SetAttribute("Kind", "Pallet")
	m:SetAttribute("State", "Up")
	m:SetAttribute("DropCFrame", dropCF)
	m.Parent = parent
	return m
end

------------------------------------------------------------------------
-- Шкафчик
------------------------------------------------------------------------

-- cf — точка на полу, -Z смотрит наружу (дверь спереди)
function Props.locker(parent: Instance, cf: CFrame): Model
	local m = model("Locker")
	local metal = Color3.fromRGB(70, 85, 80)
	local back = P(m, {
		Name = "Back",
		Size = Vector3.new(3, 7.2, 0.2),
		CFrame = cf * CFrame.new(0, 3.6, 1.2),
		Color = metal,
		Material = Enum.Material.CorrodedMetal,
	})
	for _, x in { -1.5, 1.5 } do
		P(m, {
			Name = "Side",
			Size = Vector3.new(0.2, 7.2, 2.6),
			CFrame = cf * CFrame.new(x, 3.6, 0),
			Color = metal,
			Material = Enum.Material.CorrodedMetal,
		})
	end
	P(m, {
		Name = "Top",
		Size = Vector3.new(3.2, 0.2, 2.6),
		CFrame = cf * CFrame.new(0, 7.3, 0),
		Color = metal,
		Material = Enum.Material.CorrodedMetal,
	})
	P(m, {
		Name = "Bottom",
		Size = Vector3.new(3, 0.2, 2.6),
		CFrame = cf * CFrame.new(0, 0.1, 0),
		Color = metal,
		Material = Enum.Material.CorrodedMetal,
	})
	-- Дверь крутится вокруг левого края (петли)
	local closed = cf * CFrame.new(0, 3.6, -1.3)
	P(m, {
		Name = "Door",
		Size = Vector3.new(2.8, 7, 0.15),
		CFrame = closed,
		Color = metal:Lerp(Color3.new(1, 1, 1), 0.08),
		Material = Enum.Material.CorrodedMetal,
	})
	for i = 1, 4 do
		local offset = CFrame.new(0, 2.6 - i * 0.3, -0.1)
		local slit = P(m, {
			Name = "Slit",
			Size = Vector3.new(1.6, 0.12, 0.05),
			CFrame = closed * offset,
			Color = COLORS.Black,
			Decor = true,
		})
		slit:SetAttribute("DoorOffset", offset)
	end
	m:SetAttribute("DoorClosed", closed)
	m:SetAttribute("Hinge", cf * CFrame.new(-1.4, 3.6, -1.3))
	P(m, {
		Name = "Inside",
		Size = Vector3.new(1, 1, 1),
		CFrame = cf * CFrame.new(0, 3, 0.2),
		Transparency = 1,
		Decor = true,
	})
	m.PrimaryPart = back
	m:SetAttribute("Kind", "Locker")
	m:SetAttribute("Occupant", 0)
	m.Parent = parent
	return m
end

-- Открывает/закрывает дверь шкафчика (angle = градусы)
function Props.setLockerDoor(locker: Model, angle: number)
	local hinge = locker:GetAttribute("Hinge") :: CFrame
	local closed = locker:GetAttribute("DoorClosed") :: CFrame
	if not hinge or not closed then
		return
	end
	local rot = hinge * A(0, -angle, 0) * hinge:Inverse()
	local doorCF = rot * closed
	local door = locker:FindFirstChild("Door") :: BasePart?
	if door then
		door.CFrame = doorCF
	end
	for _, d in locker:GetChildren() do
		local offset = d:GetAttribute("DoorOffset")
		if offset and d:IsA("BasePart") then
			d.CFrame = doorCF * (offset :: CFrame)
		end
	end
end

------------------------------------------------------------------------
-- Тотем
------------------------------------------------------------------------

function Props.totem(parent: Instance, cf: CFrame, hex: boolean, rng: Random): Model
	local m = model("Totem")
	local base = P(m, {
		Name = "Base",
		Size = Vector3.new(2.4, 0.6, 2.4),
		CFrame = cf * CFrame.new(0, 0.3, 0) * A(0, 30, 0),
		Color = Color3.fromRGB(60, 50, 40),
		Material = Enum.Material.Ground,
	})
	-- Кучка костей
	for _ = 1, 9 do
		P(m, {
			Name = "Bone",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(rng:NextNumber(0.8, 1.6), 0.25, 0.25),
			CFrame = cf
				* CFrame.new(rng:NextNumber(-0.8, 0.8), rng:NextNumber(0.6, 1.8), rng:NextNumber(-0.8, 0.8))
				* A(rng:NextNumber(-60, 60), rng:NextNumber(0, 180), rng:NextNumber(-60, 60)),
			Color = COLORS.Bone,
			Material = Enum.Material.SmoothPlastic,
			Decor = true,
		})
	end
	P(m, {
		Name = "Stake",
		Size = Vector3.new(0.3, 3.2, 0.3),
		CFrame = cf * CFrame.new(0, 2, 0),
		Color = COLORS.DarkWood,
		Material = Enum.Material.Wood,
		Decor = true,
	})
	local skull = P(m, {
		Name = "Skull",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.1, 1.1, 1.1),
		CFrame = cf * CFrame.new(0, 3.5, 0),
		Color = COLORS.Bone,
		Material = Enum.Material.SmoothPlastic,
		Decor = true,
	})
	for _, x in { -0.22, 0.22 } do
		local eye = P(m, {
			Name = "Eye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.3, 0.3, 0.3),
			CFrame = skull.CFrame * CFrame.new(x, 0.08, -0.43),
			Color = hex and Color3.fromRGB(255, 60, 20) or COLORS.Black,
			Material = hex and Enum.Material.Neon or Enum.Material.SmoothPlastic,
			Decor = true,
		})
		eye:SetAttribute("SkullPart", true)
	end
	-- Свечи вокруг
	for i = 1, 5 do
		local angle = i / 5 * math.pi * 2
		local h = rng:NextNumber(0.4, 0.9)
		local candle = P(m, {
			Name = "Candle",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(h, 0.25, 0.25),
			CFrame = cf * CFrame.new(math.cos(angle) * 1.4, 0.6 + h / 2, math.sin(angle) * 1.4) * A(0, 0, 90),
			Color = Color3.fromRGB(230, 220, 180),
			Material = Enum.Material.SmoothPlastic,
			Decor = true,
		})
		if hex then
			local flame = P(m, {
				Name = "Flame",
				Size = Vector3.new(0.12, 0.25, 0.12),
				CFrame = candle.CFrame * A(0, 0, -90) * CFrame.new(0, h / 2 + 0.12, 0),
				Color = Color3.fromRGB(255, 170, 60),
				Material = Enum.Material.Neon,
				Decor = true,
			})
			if i == 1 then
				local light = Instance.new("PointLight")
				light.Color = Color3.fromRGB(255, 120, 50)
				light.Range = 10
				light.Brightness = 2
				light.Parent = flame
			end
		end
	end
	m.PrimaryPart = base
	m:SetAttribute("Kind", "Totem")
	m:SetAttribute("Hex", hex)
	m:SetAttribute("Progress", 0)
	m:SetAttribute("Cleansed", false)
	m.Parent = parent
	return m
end

------------------------------------------------------------------------
-- Сундук
------------------------------------------------------------------------

function Props.chest(parent: Instance, cf: CFrame): Model
	local m = model("Chest")
	local base = P(m, {
		Name = "Box",
		Size = Vector3.new(3, 1.6, 2),
		CFrame = cf * CFrame.new(0, 0.8, 0),
		Color = COLORS.Wood,
		Material = Enum.Material.WoodPlanks,
	})
	local lidClosed = cf * CFrame.new(0, 1.85, 0)
	P(m, {
		Name = "Lid",
		Size = Vector3.new(3.1, 0.5, 2.1),
		CFrame = lidClosed,
		Color = COLORS.DarkWood,
		Material = Enum.Material.WoodPlanks,
	})
	for _, x in { -1, 1 } do
		P(m, {
			Name = "Band",
			Size = Vector3.new(0.25, 2.2, 2.15),
			CFrame = cf * CFrame.new(x, 1.1, 0),
			Color = COLORS.Metal,
			Material = Enum.Material.Metal,
			Decor = true,
		})
	end
	P(m, {
		Name = "Lock",
		Size = Vector3.new(0.4, 0.5, 0.15),
		CFrame = cf * CFrame.new(0, 1.5, -1.08),
		Color = Color3.fromRGB(180, 150, 60),
		Material = Enum.Material.Metal,
		Decor = true,
	})
	m:SetAttribute("LidClosed", lidClosed)
	m:SetAttribute("LidHinge", cf * CFrame.new(0, 2.1, 1.05))
	m.PrimaryPart = base
	m:SetAttribute("Kind", "Chest")
	m:SetAttribute("Opened", false)
	m.Parent = parent
	return m
end

function Props.openChest(chest: Model)
	local hinge = chest:GetAttribute("LidHinge") :: CFrame
	local closed = chest:GetAttribute("LidClosed") :: CFrame
	local lid = chest:FindFirstChild("Lid") :: BasePart?
	if hinge and closed and lid then
		lid.CFrame = hinge * A(70, 0, 0) * hinge:Inverse() * closed
	end
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 220, 140)
	glow.Range = 6
	glow.Brightness = 1
	glow.Parent = chest.PrimaryPart
end

------------------------------------------------------------------------
-- Люк
------------------------------------------------------------------------

function Props.hatch(parent: Instance, cf: CFrame): Model
	local m = model("Hatch")
	local frame = P(m, {
		Name = "Frame",
		Size = Vector3.new(4.4, 0.3, 4.4),
		CFrame = cf * CFrame.new(0, 0.15, 0),
		Color = COLORS.Rust,
		Material = Enum.Material.CorrodedMetal,
		CanCollide = false,
	})
	P(m, {
		Name = "Pit",
		Size = Vector3.new(3.6, 0.1, 3.6),
		CFrame = cf * CFrame.new(0, 0.32, 0),
		Color = COLORS.Black,
		Material = Enum.Material.SmoothPlastic,
		Decor = true,
	})
	for i, x in { -0.9, 0.9 } do
		local door = P(m, {
			Name = "Door" .. i,
			Size = Vector3.new(1.8, 0.15, 3.6),
			CFrame = cf * CFrame.new(x, 0.42, 0),
			Color = COLORS.Metal,
			Material = Enum.Material.DiamondPlate,
			Decor = true,
		})
		door:SetAttribute("Closed", door.CFrame)
		door:SetAttribute("Hinge", cf * CFrame.new(x * 2, 0.42, 0))
		door:SetAttribute("Sign", x > 0 and 1 or -1)
	end
	local glow = Instance.new("PointLight")
	glow.Name = "Glow"
	glow.Color = Color3.fromRGB(180, 200, 255)
	glow.Range = 14
	glow.Brightness = 2
	glow.Enabled = false
	glow.Parent = frame
	m.PrimaryPart = frame
	m:SetAttribute("Kind", "Hatch")
	m:SetAttribute("Open", false)
	m:SetAttribute("Closed", false)
	m.Parent = parent
	return m
end

function Props.setHatchOpen(hatch: Model, open: boolean)
	for _, d in hatch:GetChildren() do
		if d:IsA("BasePart") and d.Name:match("^Door") then
			local closed = d:GetAttribute("Closed") :: CFrame
			local hinge = d:GetAttribute("Hinge") :: CFrame
			local sign = d:GetAttribute("Sign") :: number
			if open then
				d.CFrame = hinge * A(0, 0, -100 * sign) * hinge:Inverse() * closed
			else
				d.CFrame = closed
			end
		end
	end
	local frame = hatch.PrimaryPart
	local glow = frame and frame:FindFirstChild("Glow") :: PointLight?
	if glow then
		glow.Enabled = open
	end
end

------------------------------------------------------------------------
-- Медвежий капкан
------------------------------------------------------------------------

function Props.trap(parent: Instance, cf: CFrame): Model
	local m = model("BearTrap")
	local base = P(m, {
		Name = "Plate",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.15, 1.2, 1.2),
		CFrame = cf * CFrame.new(0, 0.08, 0) * A(0, 0, 90),
		Color = Color3.fromRGB(70, 65, 60),
		Material = Enum.Material.CorrodedMetal,
		CanCollide = false,
	})
	for i = 1, 2 do
		P(m, {
			Name = "Jaw" .. i,
			Size = Vector3.new(2.2, 0.12, 0.7),
			CFrame = cf,
			Color = Color3.fromRGB(110, 105, 100),
			Material = Enum.Material.Metal,
			Decor = true,
		})
		for t = -2, 2 do
			local tooth = P(m, {
				Name = "Tooth" .. i,
				Size = Vector3.new(0.14, 0.4, 0.14),
				CFrame = cf,
				Color = Color3.fromRGB(150, 145, 140),
				Material = Enum.Material.Metal,
				Decor = true,
			})
			tooth:SetAttribute("Offset", t * 0.45)
		end
	end
	P(m, {
		Name = "Chain",
		Size = Vector3.new(0.12, 0.12, 2),
		CFrame = cf * CFrame.new(0, 0.06, 1.4),
		Color = COLORS.Black,
		Material = Enum.Material.Metal,
		Decor = true,
	})
	m.PrimaryPart = base
	m:SetAttribute("Kind", "Trap")
	m:SetAttribute("Armed", true)
	m:SetAttribute("Caught", 0)
	m:SetAttribute("Origin", cf)
	m.Parent = parent
	Props.setTrapArmed(m, true)
	return m
end

function Props.setTrapArmed(trap: Model, armed: boolean)
	local cf = trap:GetAttribute("Origin") :: CFrame
	for i = 1, 2 do
		local side = i == 1 and -1 or 1
		local jawCF
		if armed then
			jawCF = cf * CFrame.new(0, 0.12, side * 0.85)
		else
			jawCF = cf * CFrame.new(0, 0.55, side * 0.18) * A(side * 75, 0, 0)
		end
		local jaw = trap:FindFirstChild("Jaw" .. i) :: BasePart?
		if jaw then
			jaw.CFrame = jawCF
		end
		for _, d in trap:GetChildren() do
			if d.Name == "Tooth" .. i and d:IsA("BasePart") then
				local off = d:GetAttribute("Offset") :: number
				d.CFrame = jawCF * CFrame.new(off, 0.2, -side * 0.3)
			end
		end
	end
end

------------------------------------------------------------------------
-- Ворона
------------------------------------------------------------------------

function Props.crow(parent: Instance, cf: CFrame): Model
	local m = model("Crow")
	local black = Color3.fromRGB(15, 15, 18)
	local body = P(m, {
		Name = "Body",
		Size = Vector3.new(0.45, 0.45, 0.9),
		CFrame = cf * CFrame.new(0, 0.35, 0),
		Color = black,
		Decor = true,
	})
	P(m, {
		Name = "Head",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.38, 0.38, 0.38),
		CFrame = cf * CFrame.new(0, 0.65, -0.45),
		Color = black,
		Decor = true,
	})
	P(m, {
		Name = "Beak",
		Size = Vector3.new(0.1, 0.1, 0.3),
		CFrame = cf * CFrame.new(0, 0.62, -0.72),
		Color = Color3.fromRGB(60, 55, 40),
		Decor = true,
	})
	for _, x in { -0.3, 0.3 } do
		P(m, {
			Name = "Wing",
			Size = Vector3.new(0.12, 0.35, 0.75),
			CFrame = cf * CFrame.new(x, 0.38, 0.05),
			Color = black,
			Decor = true,
		})
	end
	P(m, {
		Name = "Tail",
		Size = Vector3.new(0.3, 0.08, 0.45),
		CFrame = cf * CFrame.new(0, 0.4, 0.6) * A(15, 0, 0),
		Color = black,
		Decor = true,
	})
	m.PrimaryPart = body
	m:SetAttribute("Kind", "Crow")
	m.Parent = parent
	return m
end

------------------------------------------------------------------------
-- Ворота выхода
------------------------------------------------------------------------

function Props.exitGate(parent: Instance, side: number, index: number): Model
	local half = Config.MapSize / 2
	local cf = CFrame.new(0, 0, side * half) * A(0, side == 1 and 0 or 180, 0)
	-- В локальных координатах: -Z внутрь карты, +Z наружу.
	local m = model("ExitGate" .. index)
	local metal = Color3.fromRGB(60, 60, 65)

	P(m, {
		Name = "Door",
		Size = Vector3.new(12, 12, 1),
		CFrame = cf * CFrame.new(0, 6, 0),
		Color = metal,
		Material = Enum.Material.DiamondPlate,
	})
	for i = -2, 2 do
		P(m, {
			Name = "DoorRib",
			Size = Vector3.new(0.4, 12, 1.3),
			CFrame = cf * CFrame.new(i * 2.4, 6, 0),
			Color = metal:Lerp(Color3.new(0, 0, 0), 0.3),
			Material = Enum.Material.Metal,
			Decor = true,
		})
	end
	for _, x in { -7, 7 } do
		P(m, {
			Name = "Pillar",
			Size = Vector3.new(2, 16, 2.5),
			CFrame = cf * CFrame.new(x, 8, 0),
			Color = Color3.fromRGB(50, 48, 46),
			Material = Enum.Material.Concrete,
		})
	end
	P(m, {
		Name = "Frame",
		Size = Vector3.new(16, 2.5, 2.5),
		CFrame = cf * CFrame.new(0, 14.75, 0),
		Color = Color3.fromRGB(40, 40, 40),
		Material = Enum.Material.Metal,
	})
	-- Пульт с рычагом
	local switch = P(m, {
		Name = "Switch",
		Size = Vector3.new(2.2, 4, 1.4),
		CFrame = cf * CFrame.new(10, 2, -2.2),
		Color = Color3.fromRGB(50, 50, 50),
		Material = Enum.Material.Metal,
	})
	P(m, {
		Name = "LeverBase",
		Size = Vector3.new(0.5, 0.5, 0.5),
		CFrame = switch.CFrame * CFrame.new(0, 0.6, -0.8),
		Color = COLORS.Black,
		Material = Enum.Material.Metal,
		Decor = true,
	})
	P(m, {
		Name = "Lever",
		Size = Vector3.new(0.25, 1.6, 0.25),
		CFrame = switch.CFrame * CFrame.new(0, 1.3, -0.8) * A(-35, 0, 0),
		Color = Color3.fromRGB(150, 30, 30),
		Material = Enum.Material.Metal,
		Decor = true,
	})
	m:SetAttribute("LeverPivot", switch.CFrame * CFrame.new(0, 0.6, -0.8))
	for i = 1, 3 do
		P(m, {
			Name = "Lamp" .. i,
			Size = Vector3.new(0.5, 0.5, 0.3),
			CFrame = switch.CFrame * CFrame.new(-0.6 + (i - 1) * 0.6, 1.5, -0.75),
			Color = Color3.fromRGB(40, 0, 0),
			Material = Enum.Material.Neon,
			Decor = true,
		})
	end
	-- Сирена
	local siren = P(m, {
		Name = "Siren",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1, 1, 1),
		CFrame = cf * CFrame.new(-7, 16.5, -1),
		Color = Color3.fromRGB(80, 10, 10),
		Material = Enum.Material.Glass,
		Decor = true,
	})
	local sirenLight = Instance.new("SpotLight")
	sirenLight.Name = "SirenLight"
	sirenLight.Color = Color3.fromRGB(255, 30, 20)
	sirenLight.Range = 30
	sirenLight.Brightness = 4
	sirenLight.Angle = 60
	sirenLight.Face = Enum.NormalId.Front
	sirenLight.Enabled = false
	sirenLight.Parent = siren

	-- Коридор за воротами и зона побега
	P(m, {
		Name = "Corridor",
		Size = Vector3.new(12, 1, 30),
		CFrame = cf * CFrame.new(0, -0.5, 15.75),
		Color = Color3.fromRGB(50, 45, 40),
		Material = Enum.Material.Ground,
	})
	Props.wall(m, cf * CFrame.new(-6.75, 6, 15.75), Vector3.new(1.5, 12, 30))
	Props.wall(m, cf * CFrame.new(6.75, 6, 15.75), Vector3.new(1.5, 12, 30))
	local escape = P(m, {
		Name = "EscapeZone",
		Size = Vector3.new(12, 12, 10),
		CFrame = cf * CFrame.new(0, 6, 24),
		Transparency = 0.6,
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.ForceField,
		Decor = true,
	})
	local glow = Instance.new("PointLight")
	glow.Range = 40
	glow.Brightness = 2
	glow.Parent = escape

	m.PrimaryPart = switch
	m:SetAttribute("Kind", "ExitGate")
	m:SetAttribute("Powered", false)
	m:SetAttribute("Progress", 0)
	m:SetAttribute("Open", false)
	m.Parent = parent
	return m
end

function Props.setGateLever(gate: Model, progress: number)
	local pivot = gate:GetAttribute("LeverPivot") :: CFrame
	local lever = gate:FindFirstChild("Lever") :: BasePart?
	if pivot and lever then
		local angle = -35 + 70 * math.clamp(progress, 0, 1)
		lever.CFrame = pivot * A(angle, 0, 0) * CFrame.new(0, 0.7, 0)
	end
	for i = 1, 3 do
		local lamp = gate:FindFirstChild("Lamp" .. i) :: BasePart?
		if lamp then
			lamp.Color = progress >= i / 3 and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(40, 0, 0)
		end
	end
end

------------------------------------------------------------------------
-- Декор
------------------------------------------------------------------------

function Props.tree(parent: Instance, cf: CFrame, rng: Random)
	local h = rng:NextNumber(16, 26)
	P(parent, {
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(h, 1.8, 1.8),
		CFrame = cf * CFrame.new(0, h / 2, 0) * A(0, 0, 90),
		Color = Color3.fromRGB(55, 42, 33),
		Material = Enum.Material.Wood,
	})
	for i = 1, 3 do
		local s = 10 - i * 2.2
		P(parent, {
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(s, s * 0.8, s),
			CFrame = cf * CFrame.new(rng:NextNumber(-0.6, 0.6), h - 3 + i * 2.4, rng:NextNumber(-0.6, 0.6)),
			Color = Color3.fromRGB(28, 45 + i * 3, 30),
			Material = Enum.Material.LeafyGrass,
			Decor = true,
		})
	end
end

function Props.deadTree(parent: Instance, cf: CFrame, rng: Random)
	local h = rng:NextNumber(14, 22)
	local trunkColor = Color3.fromRGB(45, 38, 34)
	P(parent, {
		Name = "DeadTrunk",
		Size = Vector3.new(1.4, h, 1.4),
		CFrame = cf * CFrame.new(0, h / 2, 0) * A(rng:NextNumber(-4, 4), rng:NextNumber(0, 90), 0),
		Color = trunkColor,
		Material = Enum.Material.Wood,
	})
	for _ = 1, rng:NextInteger(3, 5) do
		local y = rng:NextNumber(h * 0.45, h * 0.9)
		local len = rng:NextNumber(3, 6)
		local yaw = rng:NextNumber(0, 360)
		P(parent, {
			Name = "Branch",
			Size = Vector3.new(0.4, 0.4, len),
			CFrame = cf * CFrame.new(0, y, 0) * A(0, yaw, 0) * A(rng:NextNumber(20, 50), 0, 0) * CFrame.new(0, 0, -len / 2),
			Color = trunkColor,
			Material = Enum.Material.Wood,
			Decor = true,
		})
	end
end

function Props.rock(parent: Instance, cf: CFrame, rng: Random)
	for _ = 1, rng:NextInteger(1, 3) do
		local s = Vector3.new(rng:NextNumber(4, 9), rng:NextNumber(4, 8), rng:NextNumber(4, 9))
		P(parent, {
			Name = "Rock",
			Size = s,
			CFrame = cf
				* CFrame.new(rng:NextNumber(-3, 3), s.Y / 2 - 0.5, rng:NextNumber(-3, 3))
				* A(rng:NextNumber(-8, 8), rng:NextNumber(0, 180), rng:NextNumber(-8, 8)),
			Color = Color3.fromRGB(80, 80, 86),
			Material = Enum.Material.Slate,
		})
	end
end

function Props.junkPile(parent: Instance, cf: CFrame, rng: Random)
	local rust = Color3.fromRGB(100 + rng:NextInteger(-15, 15), 55, 35)
	local car = cf * A(0, rng:NextNumber(-25, 25), rng:NextNumber(-6, 6))
	P(parent, {
		Name = "CarBody",
		Size = Vector3.new(4.4, 1.8, 9),
		CFrame = car * CFrame.new(0, 1.6, 0),
		Color = rust,
		Material = Enum.Material.CorrodedMetal,
	})
	P(parent, {
		Name = "CarCabin",
		Size = Vector3.new(4, 1.6, 4),
		CFrame = car * CFrame.new(0, 3.3, 0.6),
		Color = rust:Lerp(Color3.new(0, 0, 0), 0.2),
		Material = Enum.Material.CorrodedMetal,
	})
	P(parent, {
		Name = "Windshield",
		Size = Vector3.new(3.6, 1.2, 0.1),
		CFrame = car * CFrame.new(0, 3.3, -1.45),
		Color = Color3.fromRGB(40, 50, 55),
		Material = Enum.Material.Glass,
		Transparency = 0.4,
		Decor = true,
	})
	for _, w in { { -2.2, -3 }, { 2.2, -3 }, { -2.2, 3 }, { 2.2, 3 } } do
		if rng:NextNumber() > 0.25 then
			P(parent, {
				Name = "Wheel",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.6, 1.8, 1.8),
				CFrame = car * CFrame.new(w[1], 0.9, w[2]),
				Color = COLORS.Black,
				Material = Enum.Material.Rubber,
				Decor = true,
			})
		end
	end
	-- Стопка шин
	local tires = cf * CFrame.new(rng:NextNumber(-7, -5), 0, rng:NextNumber(-6, 6))
	for i = 1, rng:NextInteger(2, 4) do
		P(parent, {
			Name = "Tire",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.9, 2.6, 2.6),
			CFrame = tires * CFrame.new(rng:NextNumber(-0.2, 0.2), 0.45 + (i - 1) * 0.9, 0) * A(0, 0, 90),
			Color = COLORS.Black,
			Material = Enum.Material.Rubber,
		})
	end
	Props.barrel(parent, cf * CFrame.new(rng:NextNumber(5, 7), 0, rng:NextNumber(-5, 5)), rng)
end

function Props.barrel(parent: Instance, cf: CFrame, rng: Random)
	P(parent, {
		Name = "Barrel",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3, 2, 2),
		CFrame = cf * CFrame.new(0, 1.5, 0) * A(0, 0, 90),
		Color = Color3.fromRGB(80 + rng:NextInteger(0, 40), 40, 30),
		Material = Enum.Material.CorrodedMetal,
	})
end

function Props.hay(parent: Instance, cf: CFrame, rng: Random)
	for i = 1, rng:NextInteger(2, 4) do
		P(parent, {
			Name = "Hay",
			Size = Vector3.new(3, 2, 4.5),
			CFrame = cf * CFrame.new((i - 2) * 3.2, 1, rng:NextNumber(-0.5, 0.5)) * A(0, rng:NextNumber(-10, 10), 0),
			Color = Color3.fromRGB(190, 160, 85),
			Material = Enum.Material.Grass,
		})
	end
	if rng:NextNumber() > 0.5 then
		P(parent, {
			Name = "Hay",
			Size = Vector3.new(3, 2, 4.5),
			CFrame = cf * CFrame.new(-1.6, 3, 0) * A(0, 8, 0),
			Color = Color3.fromRGB(175, 150, 80),
			Material = Enum.Material.Grass,
		})
	end
end

function Props.tombstones(parent: Instance, cf: CFrame, rng: Random)
	for i = 1, rng:NextInteger(4, 7) do
		local x = ((i - 1) % 4 - 1.5) * 4
		local z = math.floor((i - 1) / 4) * 5 - 2.5
		local h = rng:NextNumber(2, 3.5)
		P(parent, {
			Name = "Tombstone",
			Size = Vector3.new(2, h, 0.6),
			CFrame = cf * CFrame.new(x, h / 2 - 0.3, z) * A(rng:NextNumber(-10, 10), rng:NextNumber(-10, 10), rng:NextNumber(-8, 8)),
			Color = Color3.fromRGB(110, 110, 115),
			Material = Enum.Material.Slate,
		})
	end
end

function Props.fence(parent: Instance, cf: CFrame, length: number)
	local posts = math.floor(length / 4)
	for i = 0, posts do
		P(parent, {
			Name = "FencePost",
			Size = Vector3.new(0.5, 4.5, 0.5),
			CFrame = cf * CFrame.new(-length / 2 + i * (length / posts), 2.25, 0),
			Color = COLORS.DarkWood,
			Material = Enum.Material.Wood,
		})
	end
	for _, y in { 1.5, 3.4 } do
		P(parent, {
			Name = "FenceRail",
			Size = Vector3.new(length, 0.4, 0.2),
			CFrame = cf * CFrame.new(0, y, 0),
			Color = COLORS.Wood,
			Material = Enum.Material.WoodPlanks,
		})
	end
	-- Сплошная невидимая стенка, чтобы через забор нельзя было пролезть
	P(parent, {
		Name = "FenceBlock",
		Size = Vector3.new(length, 4.5, 0.4),
		CFrame = cf * CFrame.new(0, 2.25, 0),
		Transparency = 1,
	})
end

-- Кукурузное поле: высокие стебли, сквозь которые можно пройти и спрятаться
function Props.corn(parent: Instance, cf: CFrame, rng: Random)
	for x = -8, 8, 1.6 do
		for z = -8, 8, 1.6 do
			local h = rng:NextNumber(6.5, 8.5)
			P(parent, {
				Name = "Corn",
				Size = Vector3.new(0.18, h, 0.18),
				CFrame = cf * CFrame.new(x + rng:NextNumber(-0.4, 0.4), h / 2, z + rng:NextNumber(-0.4, 0.4)) * A(
					rng:NextNumber(-6, 6),
					0,
					rng:NextNumber(-6, 6)
				),
				Color = Color3.fromRGB(150, 140, 70):Lerp(Color3.fromRGB(80, 100, 45), rng:NextNumber()),
				Material = Enum.Material.Grass,
				Decor = true,
			})
		end
	end
end

function Props.lamp(parent: Instance, cf: CFrame)
	P(parent, {
		Name = "LampPost",
		Size = Vector3.new(0.6, 12, 0.6),
		CFrame = cf * CFrame.new(0, 6, 0),
		Color = Color3.fromRGB(30, 30, 30),
		Material = Enum.Material.Metal,
	})
	P(parent, {
		Name = "LampArm",
		Size = Vector3.new(0.3, 0.3, 2),
		CFrame = cf * CFrame.new(0, 12, -0.8),
		Color = Color3.fromRGB(30, 30, 30),
		Material = Enum.Material.Metal,
		Decor = true,
	})
	local head = P(parent, {
		Name = "LampHead",
		Size = Vector3.new(1, 0.6, 1),
		CFrame = cf * CFrame.new(0, 11.7, -1.6),
		Color = Color3.fromRGB(255, 200, 120),
		Material = Enum.Material.Neon,
		Decor = true,
	})
	local light = Instance.new("SpotLight")
	light.Color = Color3.fromRGB(255, 170, 90)
	light.Range = 30
	light.Angle = 80
	light.Brightness = 2
	light.Shadows = true
	light.Face = Enum.NormalId.Bottom
	light.Parent = head
end

-- Низкий туман
function Props.fog(parent: Instance, pos: Vector3, rng: Random)
	local p = P(parent, {
		Name = "FogEmitter",
		Size = Vector3.new(20, 1, 20),
		CFrame = CFrame.new(pos),
		Transparency = 1,
		Decor = true,
	})
	local e = Instance.new("ParticleEmitter")
	e.Texture = SMOKE_TEX
	e.Color = ColorSequence.new(Color3.fromRGB(150, 155, 170))
	e.Size = NumberSequence.new(8, 14)
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.88),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Lifetime = NumberRange.new(10, 16)
	e.Rate = 0.6
	e.Speed = NumberRange.new(0.3, 1)
	e.SpreadAngle = Vector2.new(180, 10)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-5, 5)
	e.LightInfluence = 1
	e.Parent = p
	if rng:NextNumber() < 0.4 then
		local flies = Instance.new("ParticleEmitter")
		flies.Name = "Fireflies"
		flies.Texture = SPARK_TEX
		flies.Color = ColorSequence.new(Color3.fromRGB(220, 255, 140))
		flies.LightEmission = 1
		flies.Size = NumberSequence.new(0.15)
		flies.Lifetime = NumberRange.new(4, 7)
		flies.Rate = 1.5
		flies.Speed = NumberRange.new(0.5, 1.2)
		flies.SpreadAngle = Vector2.new(180, 180)
		flies.Parent = p
	end
end

-- Огонь костра / бочки
function Props.fire(parent: Instance, cf: CFrame, size: number)
	local p = P(parent, {
		Name = "FireSource",
		Size = Vector3.new(size, 0.4, size),
		CFrame = cf,
		Transparency = 1,
		Decor = true,
	})
	local e = Instance.new("ParticleEmitter")
	e.Texture = FIRE_TEX
	e.Color = ColorSequence.new(Color3.fromRGB(255, 150, 50), Color3.fromRGB(255, 60, 20))
	e.LightEmission = 1
	e.Size = NumberSequence.new(size * 0.8, 0)
	e.Lifetime = NumberRange.new(0.6, 1.1)
	e.Rate = 30
	e.Speed = NumberRange.new(2, 4)
	e.SpreadAngle = Vector2.new(15, 15)
	e.Parent = p
	local light = Instance.new("PointLight")
	light.Name = "FireLight"
	light.Color = Color3.fromRGB(255, 140, 60)
	light.Range = 18 * size
	light.Brightness = 2
	light.Shadows = true
	light.Parent = p
	return p
end

return Props
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Powers</string>
          <string name="Source"><![CDATA[-- Диспетчер способностей маньяков.
-- Каждый модуль может определить: Setup, Press, Release, Update, CanAttack, SpeedOverride,
-- TerrorRadius, OnStun, OnBlind, OnHit, OnLockerSearched, Cleanup.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.Core.State)

local Powers = {}

local modules = {
	Trapper = require(script.Trapper),
	Huntress = require(script.Huntress),
	Wraith = require(script.Wraith),
}

function Powers.module(kdata)
	return kdata and modules[kdata.KillerType]
end

-- Вызывает функцию способности, если она есть. Возвращает её результат или nil.
function Powers.call(kdata, fnName: string, ...): any
	local m = Powers.module(kdata)
	local fn = m and m[fnName]
	if fn then
		return fn(kdata, ...)
	end
	return nil
end

function Powers.update(dt: number)
	local k = State.Killer
	if k and k.Status == "Playing" then
		Powers.call(k, "Update", dt)
	end
end

local function validAim(aim: any): Vector3?
	if typeof(aim) ~= "Vector3" then
		return nil
	end
	local m = aim.Magnitude
	if m ~= m or m < 0.5 or m > 1.5 then
		return nil
	end
	return aim.Unit
end

Remotes.UsePower.OnServerEvent:Connect(function(player, isDown, aim)
	local data = State.get(player)
	if not State.Active or not data or data.Role ~= "Killer" or data.Status ~= "Playing" then
		return
	end
	if isDown == true then
		Powers.call(data, "Press", validAim(aim))
	else
		Powers.call(data, "Release", validAim(aim))
	end
end)

return Powers
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Huntress</string>
            <string name="Source"><![CDATA[-- Охотница: метательные топоры (сервер считает полёт, клиенты рисуют).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Server = script.Parent.Parent
local State = require(Server.Core.State)
local Scoring = require(Server.Core.Scoring)
local Health = require(Server.Systems.Health)

local DEF = KillerDefs.Huntress
local Huntress = {}

local projectiles = {}
local nextId = 0
local GRAVITY = Vector3.new(0, -DEF.Gravity, 0)

local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
params.RespectCanCollide = true

local function setAttrs(kdata)
	kdata.Player:SetAttribute("PowerCount", kdata.Power.Hatchets)
	local charge = 0
	if kdata.Power.WindupStart then
		charge = math.clamp((State.now() - kdata.Power.WindupStart) / DEF.FullWindup, 0, 1)
	end
	kdata.Player:SetAttribute("PowerCharge", charge)
end

function Huntress.Setup(kdata)
	kdata.Power = { Hatchets = DEF.MaxHatchets, WindupStart = nil }
	table.clear(projectiles)
	setAttrs(kdata)
end

local function cancelWindup(kdata)
	if kdata.Power.WindupStart then
		kdata.Power.WindupStart = nil
		kdata.PowerBusy = false
		State.playAnim(kdata.Player, "Cancel")
		setAttrs(kdata)
	end
end

function Huntress.Press(kdata)
	local t = State.now()
	if kdata.Power.Hatchets <= 0 then
		State.notify(kdata.Player, "Топоры кончились — пополни их в шкафчике (E)", State.WHITE)
		return
	end
	if kdata.Power.WindupStart or kdata.Carrying or kdata.Action or kdata.Lunging then
		return
	end
	if t < kdata.StunnedUntil or t < kdata.BlindUntil or t < kdata.VaultUntil then
		return
	end
	kdata.Power.WindupStart = t
	kdata.PowerBusy = true
	State.playAnim(kdata.Player, "Windup")
	State.sfx("Hum", State.getRoot(kdata.Player))
end

local function throw(kdata, aim: Vector3?, charge: number)
	local char = kdata.Player.Character
	local head = char and char:FindFirstChild("Head") :: BasePart?
	local root = State.getRoot(kdata.Player)
	if not head or not root then
		return
	end
	local look = root.CFrame.LookVector
	local dir = aim or head.CFrame.LookVector
	-- Нельзя бросать назад
	if dir:Dot(look) < 0.2 then
		dir = look
	end
	local k = math.clamp((charge - DEF.MinWindup) / (DEF.FullWindup - DEF.MinWindup), 0, 1)
	local speed = DEF.ThrowSpeedMin + (DEF.ThrowSpeedMax - DEF.ThrowSpeedMin) * k
	local origin = head.Position + root.CFrame.RightVector * 0.8 + dir * 1.2
	local vel = dir * speed
	nextId += 1
	table.insert(projectiles, { Id = nextId, Pos = origin, Vel = vel, Life = 0, Owner = kdata })
	kdata.Power.Hatchets -= 1
	Remotes.Projectile:FireAllClients(nextId, origin, vel, DEF.Gravity)
	State.sfx("Throw", origin)
	State.playAnim(kdata.Player, "Throw")
end

function Huntress.Release(kdata, aim: Vector3?)
	local start = kdata.Power.WindupStart
	if not start then
		return
	end
	local charge = State.now() - start
	kdata.Power.WindupStart = nil
	kdata.PowerBusy = false
	if charge >= DEF.MinWindup and kdata.Status == "Playing" then
		throw(kdata, aim, charge)
	else
		State.playAnim(kdata.Player, "Cancel")
	end
	setAttrs(kdata)
end

function Huntress.CanAttack(kdata)
	return kdata.Power.WindupStart == nil
end

function Huntress.SpeedOverride(kdata, _t)
	if kdata.Power.WindupStart then
		return DEF.WindupSpeed
	end
	return nil
end

function Huntress.OnStun(kdata)
	cancelWindup(kdata)
end
Huntress.OnBlind = Huntress.OnStun

function Huntress.OnLockerSearched(kdata)
	if kdata.Power.Hatchets < DEF.MaxHatchets then
		kdata.Power.Hatchets = DEF.MaxHatchets
		setAttrs(kdata)
		State.notify(kdata.Player, "Топоры пополнены", State.WHITE)
		State.sfx("Rustle", State.getRoot(kdata.Player))
	end
end

local function survivorFromPart(part: Instance)
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		for player, data in State.Participants do
			if player.Character == model and data.Role == "Survivor" then
				return data
			end
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

function Huntress.Update(kdata, dt: number)
	setAttrs(kdata)
	if #projectiles == 0 then
		return
	end
	local exclude = { kdata.Player.Character }
	if State.Map then
		table.insert(exclude, State.Map.Effects)
		table.insert(exclude, State.Map.Crows)
		table.insert(exclude, State.Map.Traps)
	end
	-- Спрятанных и висящих не задеваем
	for _, data in State.Participants do
		if data.Role == "Survivor" and data.Player.Character and (data.Status ~= "Playing" or data.Hidden) then
			table.insert(exclude, data.Player.Character)
		end
	end
	params.FilterDescendantsInstances = exclude
	for i = #projectiles, 1, -1 do
		local p = projectiles[i]
		local newVel = p.Vel + GRAVITY * dt
		local newPos = p.Pos + (p.Vel + newVel) * 0.5 * dt
		p.Life += dt
		local result = workspace:Raycast(p.Pos, newPos - p.Pos, params)
		local done = false
		if result then
			local sdata = survivorFromPart(result.Instance)
			if sdata and sdata.Status == "Playing" and sdata.Health > 0 then
				Health.damage(sdata, "Hatchet")
				Scoring.add(kdata.Player, "Deviousness", 700, "Попадание топором")
				Remotes.ProjectileEnd:FireAllClients(p.Id, result.Position, true)
			else
				Remotes.ProjectileEnd:FireAllClients(p.Id, result.Position, false)
				State.sfx("Thud", result.Position)
			end
			done = true
		elseif p.Life > 4 or newPos.Y < -20 then
			Remotes.ProjectileEnd:FireAllClients(p.Id, newPos, false)
			done = true
		end
		if done then
			table.remove(projectiles, i)
		else
			p.Pos = newPos
			p.Vel = newVel
		end
	end
end

function Huntress.Cleanup(_kdata)
	table.clear(projectiles)
end

return Huntress
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Trapper</string>
            <string name="Source"><![CDATA[-- Траппер: медвежьи капканы.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)
local Server = script.Parent.Parent
local State = require(Server.Core.State)
local Actions = require(Server.Core.Actions)
local Lifecycle = require(Server.Core.Lifecycle)
local Scoring = require(Server.Core.Scoring)
local Props = require(Server.Map.Props)
local Health = require(Server.Systems.Health)

local DEF = KillerDefs.Trapper
local Trapper = {}

local rng = Random.new()

local function setCount(kdata)
	kdata.Player:SetAttribute("PowerCount", kdata.Power.InHand)
end

local function isTrap(target: Instance): boolean
	return target:GetAttribute("Kind") == "Trap"
end

local function trapPosition(trap: Model): Vector3
	return (trap:GetAttribute("Origin") :: CFrame).Position
end

function Trapper.Setup(kdata)
	kdata.Power = { InHand = DEF.TrapsInHand }
	setCount(kdata)
	local map = State.Map
	if not map then
		return
	end
	local spots = table.clone(map.TrapSpots)
	for i = #spots, 2, -1 do
		local j = rng:NextInteger(1, i)
		spots[i], spots[j] = spots[j], spots[i]
	end
	for i = 1, math.min(DEF.TrapsOnMap, #spots) do
		local trap = Props.trap(map.Traps, spots[i] * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
		trap:SetAttribute("Owner", kdata.Player.UserId)
	end
end

-- Отпустить выжившего из капкана
local function release(sdata)
	local trap = sdata.Trapped
	if not trap then
		return
	end
	sdata.Trapped = nil
	sdata.Player:SetAttribute("Trapped", nil)
	if trap.Parent then
		trap:SetAttribute("Caught", 0)
	end
	local root = State.getRoot(sdata.Player)
	if root then
		root.Anchored = false
	end
end

local function catch(sdata, trap: Model)
	Actions.cancel(sdata)
	trap:SetAttribute("Armed", false)
	trap:SetAttribute("Caught", sdata.Player.UserId)
	Props.setTrapArmed(trap, false)
	sdata.Trapped = trap
	sdata.TrapAttempts = 0
	sdata.Player:SetAttribute("Trapped", true)
	local root = State.getRoot(sdata.Player)
	local pos = trapPosition(trap)
	if root then
		root.Anchored = true
		root.CFrame = CFrame.new(pos.X, root.Position.Y, pos.Z) * root.CFrame.Rotation
	end
	State.sfx("TrapSnap", pos)
	Health.damage(sdata, "Trap")
	State.sfx("Scream", pos)
	State.noise(pos)
	local k = State.Killer
	if k then
		State.notify(k.Player, sdata.Player.DisplayName .. " попал в капкан!", State.RED)
		Scoring.add(k.Player, "Deviousness", 500, "Пойман в капкан")
	end
end

function Trapper.Press(kdata)
	if kdata.Power.InHand > 0 and not kdata.Action then
		Actions.start(kdata, "SetTrap", kdata.Player)
	elseif kdata.Power.InHand <= 0 then
		State.notify(kdata.Player, "Нет капканов в руках — подбери капкан на карте (E)", State.WHITE)
	end
end

function Trapper.Release(kdata)
	if kdata.Action and kdata.Action.Kind == "SetTrap" then
		Actions.cancel(kdata)
	end
end

function Trapper.Update(kdata, _dt)
	local map = State.Map
	if not map then
		return
	end
	for _, trap in map.Traps:GetChildren() do
		if not trap:GetAttribute("Armed") then
			continue
		end
		local pos = trapPosition(trap :: Model)
		for _, sdata in State.survivors() do
			if sdata.Status ~= "Playing" or sdata.Hidden or sdata.Trapped or State.now() < sdata.VaultUntil then
				continue
			end
			local root = State.getRoot(sdata.Player)
			if root and State.flatDist(root.Position, pos) < 1.4 and root.Position.Y - pos.Y < 4.5 then
				catch(sdata, trap :: Model)
				break
			end
		end
	end
	setCount(kdata)
end

------------------------------------------------------------------------
-- Действия
------------------------------------------------------------------------

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.RespectCanCollide = true

Actions.register("SetTrap", {
	Validate = function(data, _target)
		return data.KillerType == "Trapper" and data.Power ~= nil and data.Power.InHand > 0
	end,
	Complete = function(data, _target)
		local root = State.getRoot(data.Player)
		if not root or not State.Map then
			return
		end
		local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
		local origin = root.Position + look.Unit * 2.5
		local exclude = { State.Map.Traps, State.Map.Effects }
		for p in State.Participants do
			if p.Character then
				table.insert(exclude, p.Character)
			end
		end
		groundParams.FilterDescendantsInstances = exclude
		local hit = workspace:Raycast(origin, Vector3.new(0, -12, 0), groundParams)
		local ground = hit and hit.Position or Vector3.new(origin.X, 0, origin.Z)
		local trap = Props.trap(State.Map.Traps, CFrame.lookAt(ground, ground + look))
		trap:SetAttribute("Owner", data.Player.UserId)
		data.Power.InHand -= 1
		setCount(data)
		State.sfx("Clank", ground)
	end,
})

Actions.register("PickupTrap", {
	Validate = function(data, target)
		return data.KillerType == "Trapper"
			and isTrap(target)
			and target:GetAttribute("Caught") == 0
			and data.Power.InHand < DEF.MaxTrapsInHand
	end,
	Complete = function(data, target)
		target:Destroy()
		data.Power.InHand += 1
		setCount(data)
		State.sfx("Rustle", State.getRoot(data.Player))
	end,
})

Actions.register("ResetTrap", {
	Validate = function(data, target)
		return data.KillerType == "Trapper" and isTrap(target) and not target:GetAttribute("Armed") and target:GetAttribute("Caught") == 0
	end,
	Complete = function(_data, target)
		target:SetAttribute("Armed", true)
		Props.setTrapArmed(target :: Model, true)
		State.sfx("Clank", trapPosition(target :: Model))
	end,
})

Actions.register("DisarmTrap", {
	Validate = function(_data, target)
		return isTrap(target) and target:GetAttribute("Armed") == true
	end,
	Complete = function(data, target)
		target:SetAttribute("Armed", false)
		Props.setTrapArmed(target :: Model, false)
		State.sfx("TrapSnap", trapPosition(target :: Model))
		Scoring.add(data.Player, "Boldness", 300, "Капкан обезврежен")
	end,
})

Actions.register("EscapeTrap", {
	AllowTrapped = true,
	Validate = function(data, target)
		return data.Trapped ~= nil and data.Trapped == target
	end,
	Complete = function(data, _target)
		data.TrapAttempts = (data.TrapAttempts or 0) + 1
		local chance = DEF.TrapEscapeChance + data.TrapAttempts * 0.05
		if rng:NextNumber() < chance then
			release(data)
			State.notify(data.Player, "Ты вырвался из капкана!", State.GREEN)
			Scoring.add(data.Player, "Survival", 500, "Вырвался из капкана")
		else
			local root = State.getRoot(data.Player)
			if root then
				State.sfx("Pain", root)
			end
		end
	end,
})

Actions.register("FreeTrap", {
	Validate = function(data, target)
		if not isTrap(target) then
			return false
		end
		local caught = target:GetAttribute("Caught") :: number
		return caught ~= 0 and caught ~= data.Player.UserId
	end,
	Complete = function(data, target)
		for _, sdata in State.Participants do
			if sdata.Trapped == target then
				release(sdata)
				State.notify(sdata.Player, data.Player.DisplayName .. " освободил тебя из капкана", State.GREEN)
				Scoring.add(data.Player, "Altruism", 1000, "Освобождение из капкана")
			end
		end
	end,
})

Lifecycle.addDetach(function(data)
	if data.Trapped then
		release(data)
	end
end)

return Trapper
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Wraith</string>
            <string name="Source"><![CDATA[-- Призрак: колокол, невидимость и рывок после проявления.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)
local Server = script.Parent.Parent
local State = require(Server.Core.State)
local Scoring = require(Server.Core.Scoring)

local DEF = KillerDefs.Wraith
local Wraith = {}

local function setCloaked(kdata, cloaked: boolean)
	kdata.Power.Cloaked = cloaked
	kdata.Player:SetAttribute("Cloaked", cloaked)
	local char = kdata.Player.Character
	if char then
		char:SetAttribute("Cloaked", cloaked)
		-- Красное пятно не видно, пока Призрак невидим
		local head = char:FindFirstChild("Head")
		local stain = head and head:FindFirstChild("RedStain") :: SpotLight?
		if stain then
			stain.Enabled = not cloaked
		end
	end
end

function Wraith.Setup(kdata)
	kdata.Power = { Cloaked = false, Transition = nil, TransitionEnd = 0, BoostUntil = 0, UncloakedAt = 0 }
	setCloaked(kdata, false)
	kdata.Player:SetAttribute("PowerState", "Visible")
end

local function startTransition(kdata, kind: string, duration: number)
	kdata.Power.Transition = kind
	kdata.Power.TransitionEnd = State.now() + duration
	kdata.PowerBusy = true
	kdata.Player:SetAttribute("PowerState", kind)
	State.playAnim(kdata.Player, "Bell")
	State.sfx("Bell", State.getRoot(kdata.Player))
end

function Wraith.Press(kdata)
	local p = kdata.Power
	local t = State.now()
	if p.Transition or kdata.Carrying or kdata.Action or kdata.Lunging then
		return
	end
	if t < kdata.StunnedUntil or t < kdata.BlindUntil or t < kdata.VaultUntil then
		return
	end
	if p.Cloaked then
		startTransition(kdata, "Uncloaking", DEF.UncloakTime)
	else
		startTransition(kdata, "Cloaking", DEF.CloakTime)
	end
end

function Wraith.Update(kdata, _dt)
	local p = kdata.Power
	if p.Transition and State.now() >= p.TransitionEnd then
		if p.Transition == "Cloaking" then
			setCloaked(kdata, true)
			kdata.Player:SetAttribute("PowerState", "Cloaked")
		else
			setCloaked(kdata, false)
			p.BoostUntil = State.now() + DEF.UncloakBoostTime
			p.UncloakedAt = State.now()
			kdata.Player:SetAttribute("PowerState", "Visible")
		end
		p.Transition = nil
		kdata.PowerBusy = false
	end
end

function Wraith.CanAttack(kdata)
	return not kdata.Power.Cloaked and kdata.Power.Transition == nil
end

function Wraith.SpeedOverride(kdata, t: number)
	local p = kdata.Power
	if p.Transition then
		return 4
	end
	if p.Cloaked then
		return DEF.CloakedSpeed
	end
	if t < p.BoostUntil then
		return DEF.UncloakBoostSpeed
	end
	return nil
end

function Wraith.TerrorRadius(kdata)
	if kdata.Power.Cloaked then
		return 0
	end
	return DEF.TerrorRadius
end

-- Фонарик проявляет Призрака
function Wraith.OnBlind(kdata)
	local p = kdata.Power
	if p.Cloaked or p.Transition == "Cloaking" then
		p.Transition = nil
		kdata.PowerBusy = false
		setCloaked(kdata, false)
		kdata.Player:SetAttribute("PowerState", "Visible")
		State.notifyAll("Призрак проявлен светом!", State.YELLOW)
	end
end

function Wraith.OnStun(kdata)
	local p = kdata.Power
	if p.Transition then
		p.Transition = nil
		kdata.PowerBusy = false
		kdata.Player:SetAttribute("PowerState", p.Cloaked and "Cloaked" or "Visible")
	end
end

function Wraith.OnHit(kdata, _sdata)
	if State.now() - (kdata.Power.UncloakedAt or 0) < 2 then
		Scoring.add(kdata.Player, "Deviousness", 500, "Внезапный удар")
	end
end

function Wraith.Cleanup(kdata)
	setCloaked(kdata, false)
end

return Wraith
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="31">
        <Properties>
          <string name="Name">Systems</string>
        </Properties>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Carry</string>
            <string name="Source"><![CDATA[-- Подъём, перенос на плече, вырывание, крюки, Сущность и жертвоприношение.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Actions = require(Core.Actions)
local Lifecycle = require(Core.Lifecycle)
local Scoring = require(Core.Scoring)
local Characters = require(Core.Characters)
local Props = require(script.Parent.Parent.Map.Props)

local Carry = {}

local function killerScale(kdata): number
	local char = kdata.Player.Character
	local ok, s = pcall(function()
		return char:GetScale()
	end)
	return ok and s or 1
end

------------------------------------------------------------------------
-- Перенос
------------------------------------------------------------------------

function Carry.startCarry(kdata, sdata)
	local kroot = State.getRoot(kdata.Player)
	local sroot = State.getRoot(sdata.Player)
	local shum = State.getHumanoid(sdata.Player)
	local schar = sdata.Player.Character
	if not kroot or not sroot or not shum or not schar then
		return
	end
	Lifecycle.detach(sdata)
	Actions.cancel(sdata)
	sdata.Status = "Carried"
	sdata.CarriedBy = kdata
	sdata.Wiggle = 0
	kdata.Carrying = sdata
	sdata.SavedMassless = {}
	for _, d in schar:GetDescendants() do
		if d:IsA("BasePart") then
			sdata.SavedMassless[d] = d.Massless
			d.Massless = true
		end
	end
	Characters.setCollision(schar, Characters.GROUP_CARRIED)
	shum.PlatformStand = true
	sroot.Anchored = false
	local s = killerScale(kdata)
	-- Тело лежит на правом плече животом вниз, голова за спиной маньяка
	sroot.CFrame = kroot.CFrame
		* CFrame.new(1.05 * s, 1.75 * s, 0)
		* CFrame.Angles(math.rad(90), 0, 0)
		* CFrame.Angles(0, math.pi, 0)
	sdata.CarryWeld = Util.weld(kroot, sroot)
	pcall(function()
		sroot:SetNetworkOwner(kdata.Player)
	end)
	State.playAnim(kdata.Player, "Pickup")
	State.sfx("Rustle", kroot)
	State.notifyAll(sdata.Player.DisplayName .. " схвачен маньяком!", State.RED)
	Scoring.add(kdata.Player, "Hunter", 200, "Поднял")
end

function Carry.release(sdata)
	local kdata = sdata.CarriedBy
	if kdata then
		kdata.Carrying = nil
	end
	sdata.CarriedBy = nil
	if sdata.CarryWeld then
		sdata.CarryWeld:Destroy()
		sdata.CarryWeld = nil
	end
	local char = sdata.Player.Character
	if not char then
		return
	end
	for part, massless in sdata.SavedMassless or {} do
		if part.Parent then
			part.Massless = massless
		end
	end
	sdata.SavedMassless = nil
	Characters.setCollision(char)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.PlatformStand = false
	end
	local sroot = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local kroot = kdata and State.getRoot(kdata.Player)
	if sroot and kroot then
		local look = kroot.CFrame.LookVector * Vector3.new(1, 0, 1)
		local pos = kroot.Position + look.Unit * 3
		sroot.CFrame = CFrame.lookAt(pos, pos + look)
	end
	if sroot then
		pcall(function()
			sroot:SetNetworkOwner(sdata.Player)
		end)
	end
end

-- Выживший вырвался (сам, паллетой или фонариком)
function Carry.escape(sdata, scoreLabel: string?)
	Carry.release(sdata)
	sdata.Status = "Playing"
	sdata.Health = 1
	sdata.Wiggle = 0
	sdata.BoostUntil = State.now() + Config.SurvivorHitBoostTime
	State.notifyAll(sdata.Player.DisplayName .. " вырвался из рук маньяка!", State.GREEN)
	Scoring.add(sdata.Player, "Survival", 1000, scoreLabel or "Вырвался")
end

------------------------------------------------------------------------
-- Крюки
------------------------------------------------------------------------

local function clearEntity(hook: Instance?)
	local legs = hook and hook:FindFirstChild("EntityLegs")
	if legs then
		legs:Destroy()
	end
end

local function summonEntity(hook: Model)
	if not hook:FindFirstChild("EntityLegs") then
		Props.entityLegs(hook, 6)
		local hp = hook:FindFirstChild("HangPoint")
		State.sfx("EntityDrone", hp)
	end
end

function Carry.sacrifice(sdata)
	if sdata.Sacrificing then
		return
	end
	sdata.Sacrificing = true
	local hook = sdata.Hook
	if hook then
		summonEntity(hook)
	end
	State.playAnim(sdata.Player, "Entity")
	local root = State.getRoot(sdata.Player)
	if root then
		State.sfx("Scream", root)
	end
	local killer = State.Killer and State.Killer.Player
	Scoring.add(killer, "Sacrifice", 2000, "Жертвоприношение")
	task.delay(1.6, function()
		local r = State.getRoot(sdata.Player)
		if r and State.Map then
			local fx = Instance.new("Part")
			fx.Anchored = true
			fx.CanCollide = false
			fx.CanQuery = false
			fx.Shape = Enum.PartType.Ball
			fx.Material = Enum.Material.Neon
			fx.Color = Color3.fromRGB(255, 60, 20)
			fx.Size = Vector3.new(2, 2, 2)
			fx.CFrame = r.CFrame
			fx.Parent = State.Map.Effects
			TweenService:Create(fx, TweenInfo.new(1.4), { Size = Vector3.new(14, 14, 14), Transparency = 1 }):Play()
			Debris:AddItem(fx, 1.5)
			TweenService:Create(r, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				CFrame = r.CFrame + Vector3.new(0, 30, 0),
			}):Play()
		end
		task.delay(1.1, function()
			clearEntity(hook)
			Lifecycle.remove(sdata, "Dead", sdata.Player.DisplayName .. " принесён в жертву Сущности", State.RED)
		end)
	end)
end

function Carry.hang(kdata, hook: Model)
	local sdata = kdata.Carrying
	if not sdata then
		return
	end
	Carry.release(sdata)
	local sroot = State.getRoot(sdata.Player)
	local hp = hook:FindFirstChild("HangPoint") :: BasePart?
	if not sroot or not hp then
		sdata.Status = "Playing"
		return
	end
	sdata.Status = "Hooked"
	sdata.Hook = hook
	sdata.HookTimer = 0
	sdata.HookCount += 1
	sdata.BleedOut = 0
	sdata.Health = 0
	hook:SetAttribute("Occupant", sdata.Player.UserId)
	sroot.Anchored = true
	sroot.CFrame = hp.CFrame
	State.sfx("Clank", hp)
	State.sfx("Scream", hp)
	State.playAnim(sdata.Player, "HookScream")
	Scoring.add(kdata.Player, "Sacrifice", 1000, "Повешен на крюк")
	if sdata.HookCount >= Config.MaxHooks then
		Carry.sacrifice(sdata)
	else
		if sdata.HookCount >= 2 then
			summonEntity(hook)
		end
		State.notifyAll(string.format("%s на крюке! (стадия %d)", sdata.Player.DisplayName, sdata.HookCount), State.RED)
	end
end

function Carry.unhook(sdata, rescuer: Player)
	local hook = sdata.Hook
	local sroot = State.getRoot(sdata.Player)
	if hook then
		hook:SetAttribute("Occupant", 0)
		clearEntity(hook)
	end
	sdata.Hook = nil
	sdata.Status = "Playing"
	sdata.Health = 1
	sdata.HealProgress = 0
	sdata.HookTimer = 0
	sdata.BoostUntil = State.now() + 1.5
	if sroot then
		sroot.Anchored = false
		local hp = hook and hook:FindFirstChild("HangPoint") :: BasePart?
		if hp then
			sroot.CFrame = hp.CFrame * CFrame.new(0, -4, -3)
		end
	end
	State.playAnim(rescuer, "Flinch")
	State.notifyAll(rescuer.DisplayName .. " снял(а) " .. sdata.Player.DisplayName .. " с крюка", State.GREEN)
	Scoring.add(rescuer, "Altruism", 1500, "Спасение")
end

------------------------------------------------------------------------
-- Действия
------------------------------------------------------------------------

local function isCloaked(kdata): boolean
	return kdata.Power ~= nil and (kdata.Power.Cloaked == true or kdata.Power.Transition ~= nil)
end

Actions.register("Pickup", {
	Validate = function(data, target)
		if not target:IsA("Player") or data.Carrying or isCloaked(data) then
			return false
		end
		local td = State.get(target :: Player)
		return td ~= nil
			and td.Role == "Survivor"
			and td.Status == "Playing"
			and not td.Hidden
			and (td.Health == 0 or td.Trapped ~= nil)
			and State.now() >= td.VaultUntil
	end,
	Begin = function(data, target)
		Carry.startCarry(data, State.get(target :: Player))
	end,
})

Actions.register("Hook", {
	AllowCarrying = true,
	Validate = function(data, target)
		return data.Carrying ~= nil and target:GetAttribute("Kind") == "Hook" and target:GetAttribute("Occupant") == 0
	end,
	Complete = function(data, target)
		Carry.hang(data, target :: Model)
	end,
})

Actions.register("Unhook", {
	Validate = function(data, target)
		if not target:IsA("Player") then
			return false
		end
		local td = State.get(target :: Player)
		return td ~= nil and td ~= data and td.Status == "Hooked" and not td.Sacrificing
	end,
	Complete = function(data, target)
		local td = State.get(target :: Player)
		if td and td.Status == "Hooked" and not td.Sacrificing then
			Carry.unhook(td, data.Player)
		end
	end,
})

------------------------------------------------------------------------
-- Цикл
------------------------------------------------------------------------

function Carry.update(dt: number)
	local t = State.now()
	for _, data in State.Participants do
		if data.Role ~= "Survivor" then
			continue
		end
		if data.Status == "Hooked" and not data.Sacrificing then
			data.HookTimer += dt
			if data.HookTimer >= Config.HookStageTime then
				data.HookTimer = 0
				data.HookCount += 1
				if data.HookCount >= Config.MaxHooks then
					Carry.sacrifice(data)
				else
					if data.Hook then
						summonEntity(data.Hook)
					end
					State.notifyAll(data.Player.DisplayName .. " борется с Сущностью!", State.RED)
				end
			end
		elseif data.Status == "Carried" then
			data.Wiggle += dt / Config.WiggleTime
			if data.Wiggle >= 1 then
				local kdata = data.CarriedBy
				Carry.escape(data)
				if kdata then
					kdata.StunnedUntil = t + 3
					State.playAnim(kdata.Player, "Stun")
				end
			end
		end
	end
end

-- Освобождение при выбывании/выходе
Lifecycle.addDetach(function(data)
	if data.CarriedBy then
		Carry.release(data)
	end
	if data.Carrying then
		local carried = data.Carrying
		Carry.release(carried)
		carried.Status = "Playing"
	end
	if data.Hook then
		data.Hook:SetAttribute("Occupant", 0)
		clearEntity(data.Hook)
		data.Hook = nil
		local root = State.getRoot(data.Player)
		if root then
			root.Anchored = false
		end
	end
end)

return Carry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Chase</string>
            <string name="Source"><![CDATA[-- Погоня: маньяк видит бегущего рядом выжившего -> музыка погони и очки.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Scoring = require(Core.Scoring)
local Combat = require(script.Parent.Combat)

local Chase = {}

local timer = 0
local GRACE = 2.5

function Chase.update(dt: number)
	timer += dt
	if timer < 0.25 then
		return
	end
	local step = timer
	timer = 0
	local k = State.Killer
	local kroot = k and State.getRoot(k.Player)
	local t = State.now()
	local anyChase = false
	for _, data in State.survivors() do
		local inChase = false
		local root = State.getRoot(data.Player)
		if kroot and root and k.Status == "Playing" and data.Status == "Playing" and not data.Hidden then
			local offset = (root.Position - kroot.Position) * Vector3.new(1, 0, 1)
			local d = offset.Magnitude
			if d <= Config.ChaseDistance and d > 0.1 then
				local facing = kroot.CFrame.LookVector:Dot(offset.Unit)
				local fleeing = data.Player:GetAttribute("Running") == true or d < 12
				if facing > 0.3 and fleeing and Combat.lineOfSight(kroot.Position, root.Position) then
					inChase = true
				end
			end
		end
		if inChase then
			data.ChaseUntil = t + GRACE
		end
		local chased = t < (data.ChaseUntil or 0) and data.Status == "Playing"
		data.Chase = chased
		data.Player:SetAttribute("Chase", chased)
		if chased then
			anyChase = true
			Scoring.add(data.Player, "Boldness", 20 * step, nil)
			if k then
				Scoring.add(k.Player, "Hunter", 15 * step, nil)
			end
		end
	end
	if k then
		k.Player:SetAttribute("Chase", anyChase)
	end
end

return Chase
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Combat</string>
            <string name="Source"><![CDATA[-- Атака маньяка (выпад), оглушение паллетой и ослепление фонариком.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Actions = require(Core.Actions)
local Health = require(script.Parent.Health)
local Carry = require(script.Parent.Carry)
local Powers = require(script.Parent.Parent.Powers)

local Combat = {}

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
raycastParams.RespectCanCollide = true

-- Исключаем персонажей и мелкий декор при проверке прямой видимости
function Combat.lineOfSight(from: Vector3, to: Vector3): boolean
	local exclude = {}
	for p in State.Participants do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	if State.Map then
		table.insert(exclude, State.Map.Effects)
		table.insert(exclude, State.Map.Traps)
		table.insert(exclude, State.Map.Crows)
	end
	raycastParams.FilterDescendantsInstances = exclude
	return workspace:Raycast(from, to - from, raycastParams) == nil
end

local function tryHit(kdata): boolean
	local kroot = State.getRoot(kdata.Player)
	if not kroot then
		return false
	end
	local forward = kroot.CFrame.LookVector * Vector3.new(1, 0, 1)
	if forward.Magnitude < 0.01 then
		return false
	end
	forward = forward.Unit
	for _, sdata in State.survivors() do
		local sroot = State.getRoot(sdata.Player)
		if sdata.Status == "Playing" and not sdata.Hidden and sdata.Health > 0 and sroot then
			local offset = sroot.Position - kroot.Position
			local flat = offset * Vector3.new(1, 0, 1)
			local d = flat.Magnitude
			if d <= Config.AttackRange * (kdata.Scale or 1) and (d < 1 or forward:Dot(flat.Unit) >= 0.3) then
				if Combat.lineOfSight(kroot.Position, sroot.Position) then
					Health.damage(sdata, "M1")
					Powers.call(kdata, "OnHit", sdata)
					return true
				end
			end
		end
	end
	return false
end

function Combat.onAttack(player: Player)
	local data = State.get(player)
	if not State.Active or not data or data.Role ~= "Killer" then
		return
	end
	local t = State.now()
	if not Actions.canAct(data) or data.Action or t < data.AttackReadyAt then
		return
	end
	if Powers.call(data, "CanAttack") == false then
		return
	end
	data.Lunging = true
	data.LungeUntil = t + Config.KillerLungeTime
	data.AttackReadyAt = math.huge
	State.playAnim(player, "Swing")
	local root = State.getRoot(player)
	if root then
		State.sfx("Swing", root)
	end
end

-- Оглушение (паллета). Маньяк роняет выжившего.
function Combat.stun(duration: number)
	local kdata = State.Killer
	if not kdata or kdata.Status ~= "Playing" then
		return
	end
	kdata.StunnedUntil = State.now() + duration
	kdata.Lunging = false
	kdata.AttackReadyAt = State.now() + duration
	Actions.cancel(kdata)
	Powers.call(kdata, "OnStun")
	if kdata.Carrying then
		Carry.escape(kdata.Carrying, "Спасение паллетой")
	end
	State.playAnim(kdata.Player, "Stun")
	State.effect(kdata.Player, "Stun", duration)
	State.notify(kdata.Player, "Оглушён!", State.YELLOW)
end

-- Ослепление (фонарик)
function Combat.blind(duration: number): boolean
	local kdata = State.Killer
	if not kdata or kdata.Status ~= "Playing" or State.now() < kdata.BlindUntil then
		return false
	end
	kdata.BlindUntil = State.now() + duration
	kdata.Lunging = false
	kdata.AttackReadyAt = math.max(kdata.AttackReadyAt, State.now() + 0.5)
	Actions.cancel(kdata)
	Powers.call(kdata, "OnBlind")
	if kdata.Carrying then
		Carry.escape(kdata.Carrying, "Спасение фонариком")
	end
	State.playAnim(kdata.Player, "Blind")
	State.effect(kdata.Player, "Blind", duration)
	State.notify(kdata.Player, "Ослеплён!", State.YELLOW)
	return true
end

function Combat.update(_dt: number)
	local k = State.Killer
	if not k or not k.Lunging then
		return
	end
	local t = State.now()
	if tryHit(k) then
		k.Lunging = false
		k.SlowUntil = t + Config.AttackCooldownHit
		k.AttackReadyAt = t + Config.AttackCooldownHit
		State.playAnim(k.Player, "Wipe")
	elseif t >= k.LungeUntil then
		k.Lunging = false
		k.SlowUntil = t + Config.AttackCooldownMiss
		k.AttackReadyAt = t + Config.AttackCooldownMiss
	end
end

Remotes.Attack.OnServerEvent:Connect(Combat.onAttack)

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Crows</string>
            <string name="Source"><![CDATA[-- Вороны: взлетают, когда рядом пробегает выживший, и выдают его маньяку.
local TweenService = game:GetService("TweenService")

local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Props = require(script.Parent.Parent.Map.Props)

local Crows = {}

local crows = {}
local spots = {}
local timer = 0
local rng = Random.new()

local COUNT = 12

local function spawnCrow()
	if #spots == 0 or not State.Map then
		return
	end
	local spot = spots[rng:NextInteger(1, #spots)]
	local cf = spot * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	local model = Props.crow(State.Map.Crows, cf)
	table.insert(crows, { Model = model, Pos = cf.Position })
end

local function flyAway(crow)
	local model = crow.Model
	local pivot = model:GetPivot()
	local dir = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1))
	if dir.Magnitude < 0.1 then
		dir = Vector3.new(1, 0, 0)
	end
	local target = pivot.Position + dir.Unit * 40 + Vector3.new(0, 30, 0)
	local value = Instance.new("CFrameValue")
	value.Value = pivot
	value.Changed:Connect(function(cf)
		if model.Parent then
			model:PivotTo(cf)
		end
	end)
	local tw = TweenService:Create(value, TweenInfo.new(2.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Value = CFrame.lookAt(target, target + dir),
	})
	tw.Completed:Connect(function()
		value:Destroy()
		model:Destroy()
	end)
	tw:Play()
	State.sfx("Crow", pivot.Position)
	State.sfx("Flutter", pivot.Position)
	State.noise(pivot.Position)
	task.delay(25, function()
		if State.Active then
			spawnCrow()
		end
	end)
end

function Crows.setup()
	table.clear(crows)
	spots = State.Map and State.Map.CrowSpots or {}
	for _ = 1, COUNT do
		spawnCrow()
	end
end

function Crows.update(dt: number)
	timer += dt
	if timer < 0.2 then
		return
	end
	timer = 0
	local positions = {}
	for _, data in State.Participants do
		if data.Role == "Survivor" and data.Status == "Playing" and not data.Hidden then
			local root = State.getRoot(data.Player)
			if root then
				table.insert(positions, { root.Position, data.Player:GetAttribute("Running") == true })
			end
		end
	end
	for i = #crows, 1, -1 do
		local crow = crows[i]
		if not crow.Model.Parent then
			table.remove(crows, i)
			continue
		end
		for _, p in positions do
			local d = (p[1] - crow.Pos).Magnitude
			if d < 2.5 or (p[2] and d < 8) then
				table.remove(crows, i)
				flyAway(crow)
				break
			end
		end
	end
end

return Crows
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Exits</string>
            <string name="Source"><![CDATA[-- Ворота, обрушение Сущности (эндгейм) и люк.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Actions = require(Core.Actions)
local Lifecycle = require(Core.Lifecycle)
local Scoring = require(Core.Scoring)
local Props = require(script.Parent.Parent.Map.Props)

local Exits = {}

function Exits.startEndgame(text: string?)
	if State.EndgameDeadline then
		return
	end
	State.EndgameDeadline = State.now() + Config.EndGameCollapseTime
	State.setGame("EndGame", true)
	State.sfx("EntityDrone", nil)
	if text then
		State.notifyAll(text, State.YELLOW)
	end
end

function Exits.powerGates()
	if State.GatesPowered or not State.Map then
		return
	end
	State.GatesPowered = true
	State.setGame("GensLeft", 0)
	for _, gate in State.Map.ExitGates:GetChildren() do
		gate:SetAttribute("Powered", true)
		local sw = gate:FindFirstChild("Switch") :: BasePart?
		if sw then
			sw.Color = Color3.fromRGB(150, 130, 40)
		end
	end
	State.sfx("GatePowered", nil)
	State.notifyAll("Все генераторы починены! Ворота запитаны — открывайте их!", State.YELLOW)
end

local function openGate(gate: Model, opener: Player?)
	gate:SetAttribute("Progress", 1)
	gate:SetAttribute("Open", true)
	Props.setGateLever(gate, 1)
	local door = gate:FindFirstChild("Door") :: BasePart?
	if door then
		door.CanCollide = false
		local info = TweenInfo.new(2.5, Enum.EasingStyle.Quad)
		TweenService:Create(door, info, { CFrame = door.CFrame + Vector3.new(0, 11.8, 0) }):Play()
		for _, rib in gate:GetChildren() do
			if rib.Name == "DoorRib" and rib:IsA("BasePart") then
				TweenService:Create(rib, info, { CFrame = rib.CFrame + Vector3.new(0, 11.8, 0) }):Play()
			end
		end
		State.sfx("GateOpen", door)
	end
	if opener then
		Scoring.add(opener, "Objectives", 1250, "Ворота открыты")
	end
	if State.EndgameDeadline then
		State.notifyAll("Вторые ворота открыты!", State.YELLOW)
	else
		Exits.startEndgame("Ворота открыты! Обрушение Сущности началось — бегите!")
	end
end

local function setSiren(gate: Model, on: boolean)
	local siren = gate:FindFirstChild("Siren")
	local light = siren and siren:FindFirstChild("SirenLight") :: SpotLight?
	if light then
		light.Enabled = on
	end
	if siren and siren:IsA("BasePart") then
		siren.Material = on and Enum.Material.Neon or Enum.Material.Glass
		siren.Color = on and Color3.fromRGB(255, 40, 30) or Color3.fromRGB(80, 10, 10)
	end
end

Actions.register("OpenGate", {
	Validate = function(_data, target)
		return target:GetAttribute("Kind") == "ExitGate" and target:GetAttribute("Powered") == true and not target:GetAttribute("Open")
	end,
	Begin = function(_data, target)
		setSiren(target :: Model, true)
	end,
	Tick = function(data, target, dt)
		local p = (target:GetAttribute("Progress") :: number) + dt / Config.OpenGateTime
		if p >= 1 then
			Actions.cancel(data)
			openGate(target :: Model, data.Player)
		else
			target:SetAttribute("Progress", p)
			Props.setGateLever(target :: Model, p)
		end
	end,
	Progress = function(_data, target)
		return target:GetAttribute("Progress") :: number
	end,
})

------------------------------------------------------------------------
-- Люк
------------------------------------------------------------------------

local function isHatch(target: Instance): boolean
	return target:GetAttribute("Kind") == "Hatch"
end

Actions.register("JumpHatch", {
	Validate = function(_data, target)
		return isHatch(target) and target:GetAttribute("Open") == true
	end,
	Begin = function(data, target)
		State.sfx("Vault", (target :: Model).PrimaryPart)
		Scoring.add(data.Player, "Survival", 7000, "Побег через люк")
		Lifecycle.remove(data, "Escaped", data.Player.DisplayName .. " сбежал через люк!", State.GREEN)
	end,
})

Actions.register("CloseHatch", {
	Validate = function(_data, target)
		return isHatch(target) and target:GetAttribute("Open") == true
	end,
	Complete = function(data, target)
		target:SetAttribute("Open", false)
		target:SetAttribute("Closed", true)
		Props.setHatchOpen(target :: Model, false)
		State.sfx("Clank", (target :: Model).PrimaryPart)
		Scoring.add(data.Player, "Hunter", 1000, "Люк закрыт")
		Exits.powerGates()
		Exits.startEndgame("Маньяк закрыл люк! Обрушение Сущности началось.")
	end,
})

------------------------------------------------------------------------
-- Цикл
------------------------------------------------------------------------

function Exits.update(_dt: number)
	local map = State.Map
	if not map then
		return
	end
	local t = State.now()

	-- Побег через открытые ворота
	for _, data in State.survivors() do
		if data.Status ~= "Playing" then
			continue
		end
		local root = State.getRoot(data.Player)
		if not root then
			continue
		end
		for _, gate in map.ExitGates:GetChildren() do
			local zone = gate:FindFirstChild("EscapeZone") :: BasePart?
			if gate:GetAttribute("Open") and zone then
				local rel = zone.CFrame:PointToObjectSpace(root.Position)
				local half = zone.Size / 2
				if math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y + 2 and math.abs(rel.Z) <= half.Z then
					Scoring.add(data.Player, "Survival", 5000, "Побег")
					Lifecycle.remove(data, "Escaped", data.Player.DisplayName .. " сбежал!", State.GREEN)
					break
				end
			end
		end
	end

	-- Люк открывается, когда остался один выживший
	local hatch = map.Hatch
	if hatch and not State.SoloTest and not hatch:GetAttribute("Open") and not hatch:GetAttribute("Closed") then
		local earned = State.InitialSurvivors >= 2 or State.GensDone >= 2
		if earned and State.remainingSurvivors() == 1 and not State.EndgameDeadline then
			hatch:SetAttribute("Open", true)
			Props.setHatchOpen(hatch, true)
			State.sfx("Clank", hatch.PrimaryPart)
			for _, data in State.survivors() do
				if State.isInGame(data) then
					State.notify(data.Player, "Ты остался один. Люк открылся — найди его по звуку ветра!", State.YELLOW)
				end
			end
		end
	end

	-- Обрушение
	if State.EndgameDeadline then
		local left = State.EndgameDeadline - t
		State.setGame("EndGameTimer", math.max(math.ceil(left), 0))
		if left <= 0 then
			for _, data in State.survivors() do
				if State.isInGame(data) then
					Lifecycle.remove(data, "Dead", data.Player.DisplayName .. " забран Сущностью", State.RED)
				end
			end
		end
	end
end

return Exits
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Generators</string>
            <string name="Source"><![CDATA[-- Генераторы: ремонт, проверки навыка, повреждение маньяком, Проклятие «Руина».
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Actions = require(Core.Actions)
local Scoring = require(Core.Scoring)
local Exits = require(script.Parent.Exits)

local Generators = {}

local lastRepair = {} :: { [Instance]: number }

-- Бонус ящика с инструментами (тратит заряд)
local function toolboxBonus(data, dt: number): number
	if data.Item == "Toolbox" and (data.ItemCharges or 0) > 0 then
		data.ItemCharges -= dt
		data.Player:SetAttribute("ItemCharges", math.max(data.ItemCharges, 0))
		if data.ItemCharges <= 0 then
			Generators.onItemEmpty(data)
		end
		return Config.ToolboxBonus
	end
	return 0
end
Generators.onItemEmpty = function(_data) end -- подменяется Items

local function setLights(gen: Model, progress: number)
	for i = 1, 4 do
		local light = gen:FindFirstChild("Light" .. i) :: BasePart?
		if light then
			local on = progress >= i / 4 - 0.001
			light.Color = on and Color3.fromRGB(255, 220, 120) or Color3.fromRGB(45, 40, 30)
			light.Material = on and Enum.Material.Neon or Enum.Material.Glass
		end
	end
end

function Generators.setProgress(gen: Model, p: number)
	gen:SetAttribute("Progress", p)
	setLights(gen, p)
end

local function completeGenerator(gen: Model)
	Generators.setProgress(gen, 1)
	gen:SetAttribute("Done", true)
	gen:SetAttribute("Regressing", false)
	local bulb = gen:FindFirstChild("Bulb") :: BasePart?
	if bulb then
		bulb.Color = Color3.fromRGB(255, 230, 140)
		bulb.Material = Enum.Material.Neon
		local light = bulb:FindFirstChildOfClass("PointLight")
		if light then
			light.Enabled = true
		end
	end
	State.GensDone += 1
	State.sfx("GenDone", nil)
	State.sfx("Clank", gen.PrimaryPart)
	for _, data in State.Participants do
		if data.Action and data.Action.Target == gen then
			Actions.cancel(data)
			Scoring.add(data.Player, "Objectives", 1250, "Генератор починен")
		end
	end
	local left = math.max(Config.GeneratorsRequired - State.GensDone, 0)
	State.setGame("GensLeft", left)
	if left > 0 then
		State.notifyAll("Генератор починен! Осталось: " .. left, State.YELLOW)
	else
		Exits.powerGates()
	end
end

local function explode(gen: Model)
	local body = gen.PrimaryPart
	if not body then
		return
	end
	local fx = body:FindFirstChild("FX")
	if fx then
		local sparks = fx:FindFirstChild("Sparks") :: ParticleEmitter?
		local smoke = fx:FindFirstChild("Smoke") :: ParticleEmitter?
		if sparks then
			sparks:Emit(45)
		end
		if smoke then
			smoke.Enabled = true
			task.delay(2.5, function()
				if smoke.Parent then
					smoke.Enabled = false
				end
			end)
		end
	end
	State.sfx("GenExplode", body)
	State.noise(body.Position)
end

local function isGen(target: Instance): boolean
	return target:GetAttribute("Kind") == "Generator"
end

Actions.register("Repair", {
	SkillChecks = true,
	Validate = function(_data, target)
		return isGen(target) and not target:GetAttribute("Done") and not State.GatesPowered
	end,
	Begin = function(_data, target)
		target:SetAttribute("Regressing", false)
	end,
	Tick = function(data, target, dt)
		local rate = (1 + toolboxBonus(data, dt)) / Config.GeneratorRepairTime
		local p = (target:GetAttribute("Progress") :: number) + dt * rate
		lastRepair[target] = State.now()
		Scoring.add(data.Player, "Objectives", dt * rate * 1250, nil)
		if p >= 1 then
			completeGenerator(target :: Model)
		else
			Generators.setProgress(target :: Model, p)
		end
	end,
	Progress = function(_data, target)
		return target:GetAttribute("Progress") :: number
	end,
	OnSkillCheck = function(data, target, result)
		local p = target:GetAttribute("Progress") :: number
		if result == "great" then
			Generators.setProgress(target :: Model, math.min(p + Config.SkillCheckGreatBonus, 0.999))
			Scoring.add(data.Player, "Objectives", 100, "Отличная проверка")
		elseif result == "good" then
			Scoring.add(data.Player, "Objectives", 50, nil)
		else
			Generators.setProgress(target :: Model, math.max(p - Config.SkillCheckFailPenalty, 0))
			explode(target :: Model)
			State.effect(data.Player, "Shake", 0.5)
			State.notify(data.Player, "Генератор взорвался! Маньяк услышал шум.", State.RED)
		end
	end,
})

Actions.register("Kick", {
	Validate = function(_data, target)
		return isGen(target)
			and not target:GetAttribute("Done")
			and not State.GatesPowered
			and (target:GetAttribute("Progress") :: number) > 0
			and not target:GetAttribute("Regressing")
	end,
	Complete = function(data, target)
		local p = math.max((target:GetAttribute("Progress") :: number) - Config.GeneratorKickRegression, 0)
		Generators.setProgress(target :: Model, p)
		target:SetAttribute("Regressing", p > 0)
		State.sfx("Clank", (target :: Model).PrimaryPart)
		explode(target :: Model)
		Scoring.add(data.Player, "Brutality", 100, "Повреждение генератора")
	end,
})

function Generators.update(dt: number)
	local map = State.Map
	if not map or State.GatesPowered then
		return
	end
	local t = State.now()
	for _, gen in map.Generators:GetChildren() do
		if gen:GetAttribute("Done") then
			continue
		end
		local p = gen:GetAttribute("Progress") :: number
		local beingRepaired = t - (lastRepair[gen] or 0) < 0.2
		if p > 0 and not beingRepaired then
			local rate = 0
			if gen:GetAttribute("Regressing") then
				rate += Config.GeneratorRegressPerSecond
			end
			if State.HexRuin then
				rate += Config.RuinRegressPerSecond
			end
			if rate > 0 then
				p = math.max(p - rate * dt, 0)
				Generators.setProgress(gen :: Model, p)
				if p <= 0 then
					gen:SetAttribute("Regressing", false)
				end
			end
		end
	end
end

function Generators.reset()
	table.clear(lastRepair)
end

return Generators
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Health</string>
            <string name="Source"><![CDATA[-- Здоровье выживших: удары, повержение, лечение, истекание кровью.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage.Shared.Config)
local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Actions = require(Core.Actions)
local Lifecycle = require(Core.Lifecycle)
local Scoring = require(Core.Scoring)

local Health = {}

local function bloodBurst(part: BasePart)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(150, 0, 0))
	emitter.Size = NumberSequence.new(0.5, 0)
	emitter.Speed = NumberRange.new(6, 14)
	emitter.SpreadAngle = Vector2.new(60, 60)
	emitter.Lifetime = NumberRange.new(0.4, 0.9)
	emitter.Acceleration = Vector3.new(0, -35, 0)
	emitter.Enabled = false
	emitter.Parent = part
	emitter:Emit(35)
	Debris:AddItem(emitter, 2)
end

-- source: "M1" | "Hatchet" | "Trap"
function Health.damage(sdata, source: string)
	Actions.cancel(sdata)
	sdata.HealProgress = 0
	local root = State.getRoot(sdata.Player)
	if source == "Trap" then
		sdata.Health = math.max(sdata.Health - 1, 1)
	else
		sdata.Health -= 1
	end
	if root then
		bloodBurst(root)
		State.sfx("Hit", root)
	end
	State.playAnim(sdata.Player, "Flinch")
	State.effect(sdata.Player, "Shake", 0.6)
	local killer = State.Killer and State.Killer.Player
	if sdata.Health >= 1 then
		if source ~= "Trap" then
			sdata.BoostUntil = State.now() + Config.SurvivorHitBoostTime
		end
		if root then
			State.sfx("Pain", root)
		end
		State.notify(sdata.Player, "Тебя ранили! Беги!", State.RED)
		Scoring.add(killer, "Brutality", 300, "Удар")
	else
		sdata.Health = 0
		sdata.BleedOut = 0
		if root then
			State.sfx("Scream", root)
		end
		State.notifyAll(sdata.Player.DisplayName .. " повержен!", State.RED)
		Scoring.add(killer, "Brutality", 500, "Повержен")
	end
end

Actions.register("Heal", {
	SkillChecks = true,
	Validate = function(data, target)
		if not target:IsA("Player") then
			return false
		end
		local td = State.get(target :: Player)
		return td ~= nil
			and td ~= data
			and td.Role == "Survivor"
			and td.Status == "Playing"
			and td.Health < 2
			and not td.Hidden
			and not td.Trapped
			and State.now() >= td.VaultUntil
	end,
	Tick = function(data, target, dt)
		local td = State.get(target :: Player)
		td.HealProgress += dt / Config.HealTime
		td.HealedAt = State.now()
		if td.HealProgress >= 1 then
			td.HealProgress = 0
			td.Health += 1
			Actions.cancel(data)
			if td.Health == 1 then
				State.notify(td.Player, "Тебя подняли!", State.GREEN)
				Scoring.add(data.Player, "Altruism", 1250, "Подъём")
			else
				State.notify(td.Player, "Ты полностью вылечен", State.GREEN)
				Scoring.add(data.Player, "Altruism", 1000, "Лечение")
			end
		end
	end,
	Progress = function(_data, target)
		local td = State.get(target :: Player)
		return td and td.HealProgress
	end,
	OnSkillCheck = function(data, target, result)
		local td = State.get(target :: Player)
		if not td then
			return
		end
		if result == "great" then
			td.HealProgress = math.min(td.HealProgress + Config.SkillCheckGreatBonus, 0.999)
			Scoring.add(data.Player, "Altruism", 50, "Отличная проверка")
		elseif result == "fail" then
			td.HealProgress = math.max(td.HealProgress - Config.SkillCheckFailPenalty, 0)
			local root = State.getRoot(td.Player)
			if root then
				State.noise(root.Position)
				State.sfx("Pain", root)
			end
			State.notify(data.Player, "Провал! Маньяк услышал крик.", State.RED)
		end
	end,
})

function Health.update(dt: number)
	local t = State.now()
	for _, data in State.Participants do
		if data.Role == "Survivor" and data.Status == "Playing" and data.Health == 0 then
			if t - (data.HealedAt or 0) > 0.25 then
				data.BleedOut += dt
				if data.BleedOut >= Config.BleedOutTime then
					Lifecycle.remove(data, "Dead", data.Player.DisplayName .. " истёк кровью", State.RED)
				end
			end
		end
	end
end

return Health
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Items</string>
            <string name="Source"><![CDATA[-- Сундуки и предметы: аптечка, ящик с инструментами, фонарик.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local ItemDefs = require(ReplicatedStorage.Shared.ItemDefs)
local Util = require(ReplicatedStorage.Shared.Util)
local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Actions = require(Core.Actions)
local Lifecycle = require(Core.Lifecycle)
local Scoring = require(Core.Scoring)
local Props = require(script.Parent.Parent.Map.Props)
local Combat = require(script.Parent.Combat)
local Generators = require(script.Parent.Generators)

local Items = {}

local rng = Random.new()

local function rollItem(): string
	local total = 0
	for _, w in Config.ChestItemWeights do
		total += w
	end
	local r = rng:NextNumber(0, total)
	for name, w in Config.ChestItemWeights do
		r -= w
		if r <= 0 then
			return name
		end
	end
	return "Medkit"
end

local function removeModel(data)
	if data.ItemModel then
		data.ItemModel:Destroy()
		data.ItemModel = nil
	end
end

-- Предмет в руке (виден всем)
local function buildModel(data, item: string)
	removeModel(data)
	local char = data.Player.Character
	local arm = char and char:FindFirstChild("Right Arm") :: BasePart?
	if not arm then
		return
	end
	local def = ItemDefs[item]
	local p = Instance.new("Part")
	p.Name = "HeldItem"
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Color = def.Color
	p.Material = Enum.Material.SmoothPlastic
	if item == "Flashlight" then
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(1.3, 0.4, 0.4)
		-- Ось цилиндра вдоль руки: луч светит туда, куда указывает кисть
		p.CFrame = arm.CFrame * CFrame.new(0, -1.3, -0.25) * CFrame.Angles(0, 0, math.rad(90))
		local beam = Instance.new("SpotLight")
		beam.Name = "Beam"
		beam.Color = Color3.fromRGB(255, 250, 220)
		beam.Range = Config.FlashlightRange + 4
		beam.Angle = Config.FlashlightAngle * 2.5
		beam.Brightness = 6
		beam.Shadows = true
		beam.Face = Enum.NormalId.Left
		beam.Enabled = false
		beam.Parent = p
	elseif item == "Medkit" then
		p.Size = Vector3.new(1, 0.7, 0.4)
		p.CFrame = arm.CFrame * CFrame.new(0, -1.2, -0.3)
	else
		p.Size = Vector3.new(1.2, 0.6, 0.5)
		p.CFrame = arm.CFrame * CFrame.new(0, -1.25, -0.2)
	end
	Util.weld(arm, p)
	p.Parent = char
	data.ItemModel = p
end

function Items.give(data, item: string)
	data.Item = item
	data.ItemCharges = ItemDefs[item].Charges
	data.ItemActive = false
	data.Player:SetAttribute("Item", item)
	data.Player:SetAttribute("ItemCharges", data.ItemCharges)
	data.Player:SetAttribute("ItemMax", data.ItemCharges)
	data.Player:SetAttribute("ItemActive", false)
	buildModel(data, item)
end

function Items.remove(data)
	if data.Item then
		State.notify(data.Player, ItemDefs[data.Item].Name .. " закончился", State.WHITE)
	end
	data.Item = nil
	data.ItemCharges = 0
	data.ItemActive = false
	data.Player:SetAttribute("Item", nil)
	data.Player:SetAttribute("ItemCharges", nil)
	data.Player:SetAttribute("ItemActive", nil)
	removeModel(data)
end
Generators.onItemEmpty = Items.remove

local function setFlashlight(data, on: boolean)
	data.ItemActive = on
	data.Player:SetAttribute("ItemActive", on)
	local beam = data.ItemModel and data.ItemModel:FindFirstChild("Beam") :: SpotLight?
	if beam then
		beam.Enabled = on
	end
	if data.ItemModel then
		State.sfx("Click", data.ItemModel)
	end
end

Actions.register("OpenChest", {
	Validate = function(_data, target)
		return target:GetAttribute("Kind") == "Chest" and not target:GetAttribute("Opened")
	end,
	Begin = function(_data, target)
		State.sfx("Chest", (target :: Model).PrimaryPart)
	end,
	Complete = function(data, target)
		if target:GetAttribute("Opened") then
			return
		end
		target:SetAttribute("Opened", true)
		Props.openChest(target :: Model)
		local item = rollItem()
		Items.give(data, item)
		State.notify(data.Player, "Ты нашёл: " .. ItemDefs[item].Name .. ". " .. ItemDefs[item].Hint, State.YELLOW)
		Scoring.add(data.Player, "Objectives", 250, "Сундук открыт")
	end,
})

Actions.register("SelfHeal", {
	SkillChecks = true,
	Validate = function(data, _target)
		return data.Item == "Medkit" and (data.ItemCharges or 0) > 0 and data.Health == 1
	end,
	Tick = function(data, _target, dt)
		data.HealProgress += dt / Config.MedkitHealTime
		data.ItemCharges -= dt
		data.Player:SetAttribute("ItemCharges", math.max(data.ItemCharges, 0))
		if data.HealProgress >= 1 then
			data.HealProgress = 0
			data.Health = 2
			Actions.cancel(data)
			State.notify(data.Player, "Ты вылечился аптечкой", State.GREEN)
			Scoring.add(data.Player, "Survival", 500, "Самолечение")
		end
		if data.ItemCharges <= 0 then
			Actions.cancel(data)
			Items.remove(data)
		end
	end,
	Progress = function(data, _target)
		return data.HealProgress
	end,
	OnSkillCheck = function(data, _target, result)
		if result == "great" then
			data.HealProgress = math.min(data.HealProgress + Config.SkillCheckGreatBonus, 0.999)
		elseif result == "fail" then
			data.HealProgress = math.max(data.HealProgress - Config.SkillCheckFailPenalty, 0)
			local root = State.getRoot(data.Player)
			if root then
				State.noise(root.Position)
				State.sfx("Pain", root)
			end
		end
	end,
})

Remotes.UseItem.OnServerEvent:Connect(function(player, isDown, aim)
	local data = State.get(player)
	if not State.Active or not data or data.Role ~= "Survivor" or not data.Item then
		return
	end
	if typeof(aim) == "Vector3" and aim.Magnitude > 0.5 and aim.Magnitude < 1.5 then
		data.ItemAim = aim.Unit
	end
	if data.Item == "Medkit" then
		if isDown == true then
			Actions.start(data, "SelfHeal", player)
		elseif data.Action and data.Action.Kind == "SelfHeal" then
			Actions.cancel(data)
		end
	elseif data.Item == "Flashlight" then
		local on = isDown == true and data.Status == "Playing" and data.Health > 0 and not data.Hidden
		if on ~= data.ItemActive then
			setFlashlight(data, on)
		end
	end
end)

-- Фонарик: светим в лицо маньяку
function Items.update(dt: number)
	local k = State.Killer
	local khead = k and k.Player.Character and k.Player.Character:FindFirstChild("Head") :: BasePart?
	local kroot = k and State.getRoot(k.Player)
	for _, data in State.Participants do
		if data.Item ~= "Flashlight" or not data.ItemActive then
			continue
		end
		if data.Status ~= "Playing" or data.Health <= 0 or data.Hidden or data.Action then
			setFlashlight(data, false)
			continue
		end
		data.ItemCharges -= dt
		data.Player:SetAttribute("ItemCharges", math.max(data.ItemCharges, 0))
		if data.ItemCharges <= 0 then
			Items.remove(data)
			continue
		end
		local shead = data.Player.Character and data.Player.Character:FindFirstChild("Head") :: BasePart?
		local hit = false
		if khead and kroot and shead and k.Status == "Playing" then
			local toKiller = khead.Position - shead.Position
			local dist = toKiller.Magnitude
			local aim = data.ItemAim or shead.CFrame.LookVector
			if dist <= Config.FlashlightRange and dist > 0.1 then
				local angle = math.deg(math.acos(math.clamp(aim:Dot(toKiller.Unit), -1, 1)))
				local facing = kroot.CFrame.LookVector:Dot(-toKiller.Unit)
				if angle <= Config.FlashlightAngle and facing > 0.4 and Combat.lineOfSight(shead.Position, khead.Position) then
					hit = true
				end
			end
		end
		if hit then
			data.BlindAccum = (data.BlindAccum or 0) + dt
			if data.BlindAccum >= Config.FlashlightBlindTime then
				data.BlindAccum = 0
				if Combat.blind(Config.BlindDuration) then
					Scoring.add(data.Player, "Boldness", 1250, "Ослепление")
				end
			end
		else
			data.BlindAccum = math.max((data.BlindAccum or 0) - dt * 0.5, 0)
		end
	end
end

Lifecycle.addDetach(function(data)
	if data.ItemActive then
		setFlashlight(data, false)
	end
end)

function Items.cleanup(data)
	removeModel(data)
end

return Items
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Lockers</string>
            <string name="Source"><![CDATA[-- Шкафчики: спрятаться, выйти, обыскать (маньяк хватает выжившего).
local TweenService = game:GetService("TweenService")

local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Actions = require(Core.Actions)
local Lifecycle = require(Core.Lifecycle)
local Scoring = require(Core.Scoring)
local Props = require(script.Parent.Parent.Map.Props)
local Carry = require(script.Parent.Carry)
local Powers = require(script.Parent.Parent.Powers)

local Lockers = {}

-- Открыть и закрыть дверь (анимация на сервере, видят все)
local function swingDoor(locker: Model, holdTime: number)
	local value = Instance.new("NumberValue")
	value.Value = 0
	value.Changed:Connect(function(v)
		Props.setLockerDoor(locker, v)
	end)
	local open = TweenService:Create(value, TweenInfo.new(0.2), { Value = 100 })
	open:Play()
	State.sfx("LockerDoor", locker.PrimaryPart)
	task.delay(0.2 + holdTime, function()
		local close = TweenService:Create(value, TweenInfo.new(0.25), { Value = 0 })
		close:Play()
		close.Completed:Wait()
		Props.setLockerDoor(locker, 0)
		value:Destroy()
		if locker.Parent then
			State.sfx("LockerDoor", locker.PrimaryPart)
		end
	end)
end

local function insideCF(locker: Model): CFrame?
	local inside = locker:FindFirstChild("Inside") :: BasePart?
	return inside and inside.CFrame
end

local function moveRoot(root: BasePart, target: CFrame, duration: number)
	local tw = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Quad), { CFrame = target })
	tw:Play()
end

-- Вытащить игрока из шкафчика без анимации входа/выхода
local function freeFromLocker(data, moveOut: boolean)
	local locker = data.Hidden
	if not locker then
		return
	end
	data.Hidden = nil
	data.Player:SetAttribute("Hidden", nil)
	locker:SetAttribute("Occupant", 0)
	local root = State.getRoot(data.Player)
	local cf = insideCF(locker)
	if root then
		if moveOut and cf then
			root.CFrame = cf * CFrame.new(0, 0, -2.8)
		end
		root.Anchored = false
	end
end

Actions.register("EnterLocker", {
	Validate = function(data, target)
		return target:GetAttribute("Kind") == "Locker" and target:GetAttribute("Occupant") == 0 and not data.Hidden
	end,
	Begin = function(data, target)
		local locker = target :: Model
		local root = State.getRoot(data.Player)
		local cf = insideCF(locker)
		if not root or not cf then
			return
		end
		local fast = data.Sprinting
		local duration = fast and 0.35 or 0.7
		locker:SetAttribute("Occupant", data.Player.UserId)
		data.Hidden = locker
		data.Player:SetAttribute("Hidden", true)
		data.VaultUntil = State.now() + duration
		root.Anchored = true
		moveRoot(root, cf, duration)
		swingDoor(locker, duration - 0.1)
		if fast then
			State.noise(cf.Position)
		end
	end,
})

Actions.register("ExitLocker", {
	AllowHidden = true,
	Validate = function(data, target)
		return data.Hidden == target
	end,
	Begin = function(data, target)
		local locker = target :: Model
		local root = State.getRoot(data.Player)
		local cf = insideCF(locker)
		data.Hidden = nil
		data.Player:SetAttribute("Hidden", nil)
		locker:SetAttribute("Occupant", 0)
		data.VaultUntil = State.now() + 0.6
		swingDoor(locker, 0.4)
		if root and cf then
			moveRoot(root, cf * CFrame.new(0, 0, -2.8), 0.5)
			task.delay(0.55, function()
				if root.Parent and data.Status == "Playing" and not data.Hidden and not data.Trapped then
					root.Anchored = false
				end
			end)
		elseif root then
			root.Anchored = false
		end
	end,
})

Actions.register("SearchLocker", {
	Validate = function(_data, target)
		return target:GetAttribute("Kind") == "Locker"
	end,
	Begin = function(_data, target)
		swingDoor(target :: Model, 0.8)
	end,
	Complete = function(data, target)
		local occupantId = target:GetAttribute("Occupant") :: number
		if occupantId ~= 0 then
			for _, sdata in State.Participants do
				if sdata.Hidden == target and sdata.Status == "Playing" then
					freeFromLocker(sdata, true)
					sdata.Health = 0
					Carry.startCarry(data, sdata)
					State.notifyAll(sdata.Player.DisplayName .. " вытащен из шкафчика!", State.RED)
					Scoring.add(data.Player, "Deviousness", 1000, "Вытащил из шкафчика")
					return
				end
			end
		end
		Powers.call(data, "OnLockerSearched")
	end,
})

Lifecycle.addDetach(function(data)
	if data.Hidden then
		freeFromLocker(data, true)
	end
end)

return Lockers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Obstacles</string>
            <string name="Source"><![CDATA[-- Паллеты и перелезание через окна/паллеты.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Actions = require(Core.Actions)
local Scoring = require(Core.Scoring)
local Combat = require(script.Parent.Combat)

local Obstacles = {}

-- Плавно двигает модель паллеты (сервер, короткий твин)
local function tweenModel(model: Model, target: CFrame, duration: number)
	local value = Instance.new("CFrameValue")
	value.Value = model:GetPivot()
	value.Changed:Connect(function(cf)
		model:PivotTo(cf)
	end)
	local tw = TweenService:Create(value, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Value = target })
	tw.Completed:Connect(function()
		model:PivotTo(target)
		value:Destroy()
	end)
	tw:Play()
end

local function obstacleCFrame(target: Instance): CFrame?
	local kind = target:GetAttribute("Kind")
	if kind == "Pallet" then
		return target:GetAttribute("DropCFrame") :: CFrame
	elseif kind == "Window" and target:IsA("BasePart") then
		return target.CFrame
	end
	return nil
end

Actions.register("DropPallet", {
	Validate = function(_data, target)
		return target:GetAttribute("Kind") == "Pallet" and target:GetAttribute("State") == "Up"
	end,
	Begin = function(data, target)
		local pallet = target :: Model
		local dropCF = pallet:GetAttribute("DropCFrame") :: CFrame
		pallet:SetAttribute("State", "Dropped")
		local hitbox = pallet.PrimaryPart
		if hitbox then
			hitbox.CanCollide = true
		end
		tweenModel(pallet, dropCF, 0.25)
		State.playAnim(data.Player, "PalletDrop")
		task.delay(0.22, function()
			State.sfx("PalletSlam", dropCF.Position)
		end)
		local k = State.Killer
		if k and k.Status == "Playing" then
			local kroot = State.getRoot(k.Player)
			if kroot then
				local rel = dropCF:PointToObjectSpace(kroot.Position)
				if math.abs(rel.X) < 3.5 and math.abs(rel.Z) < 2.4 then
					-- маньяк стоял прямо под паллетой — отталкиваем на его сторону
					local side = rel.Z >= 0 and 1 or -1
					local w = dropCF:PointToWorldSpace(Vector3.new(rel.X, 0, side * 2.8))
					kroot.CFrame = CFrame.new(w.X, kroot.Position.Y, w.Z) * kroot.CFrame.Rotation
				end
				if State.flatDist(kroot.Position, dropCF.Position) <= Config.PalletStunRange then
					Combat.stun(Config.PalletStunTime)
					Scoring.add(data.Player, "Boldness", 1000, "Оглушение паллетой")
				end
			end
		end
	end,
})

Actions.register("Break", {
	Validate = function(_data, target)
		return target:GetAttribute("Kind") == "Pallet" and target:GetAttribute("State") == "Dropped"
	end,
	Complete = function(data, target)
		target:SetAttribute("State", "Broken")
		local pos = (target :: Model):GetPivot().Position
		State.sfx("PalletBreak", pos)
		-- Обломки разлетаются
		for _, d in target:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = false
				d.CanCollide = false
				d.AssemblyLinearVelocity = Vector3.new(math.random(-15, 15), math.random(8, 18), math.random(-15, 15))
			end
		end
		task.delay(2, function()
			target:Destroy()
		end)
		target.Parent = State.Map and State.Map.Effects or target.Parent
		Scoring.add(data.Player, "Brutality", 100, "Паллета сломана")
	end,
})

Actions.register("Vault", {
	Validate = function(data, target)
		local kind = target:GetAttribute("Kind")
		if data.Carrying then
			return false
		end
		if kind == "Window" then
			return true
		end
		return kind == "Pallet" and data.Role == "Survivor" and target:GetAttribute("State") == "Dropped"
	end,
	Begin = function(data, target)
		local root = State.getRoot(data.Player)
		local ocf = obstacleCFrame(target)
		if not root or not ocf then
			return
		end
		local rel = ocf:PointToObjectSpace(root.Position)
		local side = rel.Z >= 0 and 1 or -1
		local x = math.clamp(rel.X, -1.2, 1.2)
		local y = root.Position.Y
		local function at(z: number): Vector3
			local w = ocf:PointToWorldSpace(Vector3.new(x, 0, z))
			return Vector3.new(w.X, y, w.Z)
		end
		local mid = at(0) + Vector3.new(0, 2.2, 0)
		local finish = at(-side * 3.4)
		local dir = (finish - root.Position) * Vector3.new(1, 0, 1)
		if dir.Magnitude < 0.1 then
			return
		end
		dir = dir.Unit
		local duration
		if data.Role == "Killer" then
			duration = 1.6
			State.playAnim(data.Player, "KillerVault")
		else
			duration = data.Sprinting and 0.55 or 0.95
			State.playAnim(data.Player, "Vault")
			if data.Sprinting then
				-- быстрый прыжок шумит
				State.noise(root.Position)
				State.sfx("Vault", root)
				if data.Chase then
					Scoring.add(data.Player, "Boldness", 100, "Прыжок")
				end
			end
		end
		data.VaultUntil = State.now() + duration
		Actions.cancel(data)
		root.Anchored = true
		task.spawn(function()
			local info = TweenInfo.new(duration / 2, Enum.EasingStyle.Linear)
			local t1 = TweenService:Create(root, info, { CFrame = CFrame.lookAt(mid, mid + dir) })
			t1:Play()
			t1.Completed:Wait()
			local t2 = TweenService:Create(root, info, { CFrame = CFrame.lookAt(finish, finish + dir) })
			t2:Play()
			t2.Completed:Wait()
			if root.Parent and data.Status == "Playing" and not data.Hidden and not data.Trapped then
				root.Anchored = false
			end
		end)
	end,
})

return Obstacles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Totems</string>
            <string name="Source"><![CDATA[-- Тотемы: очистка выжившими, проклятый тотем включает Проклятие «Руина».
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Actions = require(Core.Actions)
local Scoring = require(Core.Scoring)

local Totems = {}

local function cleanse(totem: Model, by: Player)
	totem:SetAttribute("Cleansed", true)
	totem:SetAttribute("Progress", 1)
	for _, d in totem:GetChildren() do
		if d.Name == "Flame" then
			d:Destroy()
		elseif d:GetAttribute("SkullPart") and d:IsA("BasePart") then
			d.Color = Color3.fromRGB(20, 20, 22)
			d.Material = Enum.Material.SmoothPlastic
		end
	end
	local skull = totem:FindFirstChild("Skull") :: BasePart?
	if skull then
		local fallen = skull.CFrame * CFrame.new(0.6, -2.6, 0) * CFrame.Angles(0, 0, math.rad(80))
		TweenService:Create(skull, TweenInfo.new(0.6, Enum.EasingStyle.Bounce), { CFrame = fallen }):Play()
	end
	State.sfx("Rustle", totem.PrimaryPart)
	if totem:GetAttribute("Hex") then
		State.HexRuin = false
		State.setGame("HexRuin", false)
		State.sfx("EntityDrone", totem.PrimaryPart)
		State.notifyAll("Проклятие «Руина» снято!", State.GREEN)
		Scoring.add(by, "Objectives", 1500, "Проклятый тотем очищен")
	else
		Scoring.add(by, "Objectives", 1000, "Тотем очищен")
	end
end

Actions.register("Cleanse", {
	Validate = function(_data, target)
		return target:GetAttribute("Kind") == "Totem" and not target:GetAttribute("Cleansed")
	end,
	Tick = function(data, target, dt)
		local p = (target:GetAttribute("Progress") :: number) + dt / Config.CleanseTime
		if p >= 1 then
			Actions.cancel(data)
			cleanse(target :: Model, data.Player)
		else
			target:SetAttribute("Progress", p)
		end
	end,
	Progress = function(_data, target)
		return target:GetAttribute("Progress") :: number
	end,
})

function Totems.setup()
	local hex = false
	if State.Map then
		for _, totem in State.Map.Totems:GetChildren() do
			if totem:GetAttribute("Hex") then
				hex = true
			end
		end
	end
	State.HexRuin = hex
	State.setGame("HexRuin", hex)
	if hex and State.Killer then
		State.notify(State.Killer.Player, "Проклятие «Руина» активно: генераторы сами откатываются", State.RED)
	end
end

return Totems
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="43">
    <Properties>
      <string name="Name">SoundService</string>
      <token name="AmbientReverb">16</token>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="44">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="45">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="46">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Animator</string>
            <string name="Source"><![CDATA[-- Процедурные анимации R6 для всех персонажей.
-- Motor6D.Transform не реплицируется, поэтому каждый клиент анимирует всех сам,
-- по реплицированным атрибутам (состояние, действие, одноразовые анимации AnimSeq).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local Rig = require(ReplicatedStorage.Shared.Anim.Rig)
local Poses = require(ReplicatedStorage.Shared.Anim.Poses)
local Util = require(ReplicatedStorage.Shared.Util)
local Audio = require(script.Parent.Audio)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Animator = {}

type Entry = {
	Char: Model,
	Rig: Rig.RigData?,
	Current: { [string]: CFrame },
	Phase: number,
	Step: number,
	Seq: number,
	Shot: { Name: string, Start: number, Duration: number }?,
	LocalShot: { Name: string, At: number }?,
}

local entries = {} :: { [Model]: Entry }

local function register(char: Instance)
	if not char:IsA("Model") or entries[char] then
		return
	end
	local entry: Entry = {
		Char = char,
		Rig = nil,
		Current = {},
		Phase = 0,
		Step = 0,
		Seq = char:GetAttribute("AnimSeq") or 0,
		Shot = nil,
		LocalShot = nil,
	}
	entries[char] = entry
	char.Destroying:Connect(function()
		entries[char] = nil
	end)
end

CollectionService:GetInstanceAddedSignal("DBDChar"):Connect(register)
CollectionService:GetInstanceRemovedSignal("DBDChar"):Connect(function(char)
	entries[char :: Model] = nil
end)
for _, char in CollectionService:GetTagged("DBDChar") do
	register(char)
end

local function startShot(entry: Entry, name: string)
	if name == "Cancel" then
		entry.Shot = nil
		return
	end
	local shot = Poses.OneShot[name]
	if shot then
		entry.Shot = { Name = name, Start = os.clock(), Duration = shot.Duration }
	end
end

-- Мгновенно проиграть анимацию у своего персонажа (не ждать сервер)
function Animator.playLocal(name: string)
	local char = player.Character
	local entry = char and entries[char]
	if entry then
		startShot(entry, name)
		entry.LocalShot = { Name = name, At = os.clock() }
	end
end

local function findKillerRoot(): BasePart?
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("Role") == "Killer" then
			return Util.getRoot(p)
		end
	end
	return nil
end

local function choosePose(entry: Entry, t: number, dt: number, killerRoot: BasePart?)
	local char = entry.Char
	local owner = Players:GetPlayerFromCharacter(char)
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hum or not root then
		return nil
	end
	local function attr(name: string): any
		return owner and owner:GetAttribute(name)
	end
	local role = char:GetAttribute("Role")
	local isKiller = role == "Killer"
	local status = attr("Status")
	local health = attr("Health") or 2
	local crouching = attr("Crouching") == true
	local speed = (root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude
	if root.Anchored then
		speed = 0
	end

	-- Фаза шага и звуки шагов
	local rate = Poses.stepRate(speed, crouching)
	entry.Phase += rate * dt
	local step = math.floor(entry.Phase / math.pi)
	if step ~= entry.Step then
		entry.Step = step
		local grounded = hum.FloorMaterial ~= Enum.Material.Air
		if speed > 1.5 and grounded and status ~= "Hooked" and status ~= "Carried" and health > 0 then
			Audio.footstep(char, isKiller, speed, crouching)
		end
	end

	-- Голова поворачивается к маньяку
	local lookYaw = 0
	if not isKiller and killerRoot and status == "Playing" then
		local rel = root.CFrame:PointToObjectSpace(killerRoot.Position)
		if rel.Magnitude < 30 then
			lookYaw = math.clamp(math.deg(math.atan2(-rel.X, -rel.Z)), -70, 70)
		end
	end

	local p: Poses.Params = {
		Speed = speed,
		Phase = entry.Phase,
		Injured = health == 1 and not isKiller,
		Crouching = crouching,
		Killer = isKiller,
		Carrying = attr("Carrying") == true,
		Wiggle = attr("Wiggle"),
		Struggle = (attr("HookCount") or 0) >= 2,
		LookYaw = lookYaw,
		KillerType = char:GetAttribute("KillerType"),
	}

	local pose
	local action = attr("ActionName")
	if status == "Hooked" then
		pose = Poses.State.Hooked(t, p)
	elseif status == "Carried" then
		pose = Poses.State.Carried(t, p)
	elseif attr("Hidden") then
		pose = Poses.State.Hidden(t, p)
	elseif attr("Trapped") and action ~= "EscapeTrap" then
		pose = Poses.State.Trapped(t, p)
	elseif not isKiller and status == "Playing" and health == 0 then
		pose = Poses.State.Crawl(t, p)
	elseif hum.Sit then
		pose = Poses.State.Sit(t, p)
	else
		pose = Poses.locomotion(t, p)
		local actionPose = action and Poses.Action[action]
		if actionPose then
			pose = Poses.merge(pose, actionPose(t, p))
		end
		if attr("Item") == "Flashlight" and attr("ItemActive") then
			pose.RArm = Poses.A(92 + math.sin(t * 3) * 2, 0, 4)
		end
	end

	-- Одноразовая анимация поверх
	local seq = char:GetAttribute("AnimSeq") or 0
	if seq ~= entry.Seq then
		entry.Seq = seq
		local name = char:GetAttribute("Anim")
		local loc = entry.LocalShot
		if not (loc and loc.Name == name and os.clock() - loc.At < 0.5) and typeof(name) == "string" then
			startShot(entry, name)
		end
	end
	local shot = entry.Shot
	if shot then
		local a = (t - shot.Start) / shot.Duration
		if a >= 1 or (shot.Name == "Windup" and attr("PowerCharge") == 0 and t - shot.Start > 0.3) then
			entry.Shot = nil
		else
			pose = Poses.merge(pose, Poses.OneShot[shot.Name].Fn(a, p))
		end
	end
	return pose
end

local ZERO = Vector3.zero

RunService.PreSimulation:Connect(function(dt)
	local t = os.clock()
	local camPos = camera.CFrame.Position
	local killerRoot = findKillerRoot()
	local alpha = 1 - math.exp(-16 * dt)
	for char, entry in entries do
		if not char.Parent then
			continue
		end
		local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root or (root.Position - camPos).Magnitude > 260 then
			continue
		end
		if not entry.Rig then
			entry.Rig = Rig.find(char)
			if not entry.Rig then
				continue
			end
		end
		local rig = entry.Rig :: Rig.RigData
		local pose = choosePose(entry, t, dt, killerRoot)
		if not pose then
			continue
		end
		for _, name in Rig.JointNames do
			local joint = rig.Joints[name]
			if not joint.Motor.Parent then
				entry.Rig = nil
				break
			end
			local rot = pose[name] or CFrame.identity
			local offset = name == "Root" and (pose.RootPos or ZERO) * rig.Scale or nil
			local target = Rig.transform(joint, rot, offset)
			local current = entry.Current[name] or target
			current = current:Lerp(target, alpha)
			entry.Current[name] = current
			joint.Motor.Transform = current
		end
	end
end)

return Animator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[-- Звук: 3D-эффекты, синтезированное сердцебиение, погоня, генераторы, шаги, атмосфера.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Sounds = require(ReplicatedStorage.Shared.Sounds)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)

local player = Players.LocalPlayer
local Audio = {}

SoundService.AmbientReverb = Enum.ReverbType.Forest

local function addEffects(sound: Sound, effects)
	if not effects then
		return
	end
	if effects.Distortion then
		local d = Instance.new("DistortionSoundEffect")
		d.Level = effects.Distortion
		d.Parent = sound
	end
	if effects.Echo then
		local e = Instance.new("EchoSoundEffect")
		e.Delay = effects.Echo[1]
		e.Feedback = effects.Echo[2]
		e.WetLevel = -6
		e.Parent = sound
	end
	if effects.LowPass then
		local eq = Instance.new("EqualizerSoundEffect")
		eq.HighGain = -30
		eq.MidGain = -8
		eq.LowGain = 4
		eq.Parent = sound
	end
end

-- Создаёт звук. where: BasePart / Model / Vector3 / nil (2D)
function Audio.create(name: string, where: any?): Sound?
	local def = Sounds.get(name)
	if not def then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = def.Id
	sound.Volume = def.Volume or 1
	sound.PlaybackSpeed = def.Speed or 1
	sound.Looped = def.Looped == true
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 8
	sound.RollOffMaxDistance = def.MaxDistance or 100
	if not def.Custom then
		addEffects(sound, def.Effects)
	end
	local parent: Instance = SoundService
	if typeof(where) == "Instance" then
		if where:IsA("Model") then
			parent = where.PrimaryPart or where:FindFirstChildWhichIsA("BasePart") or SoundService
		elseif where:IsA("BasePart") or where:IsA("Attachment") then
			parent = where
		end
	elseif typeof(where) == "Vector3" then
		local att = Instance.new("Attachment")
		att.WorldPosition = where
		att.Parent = workspace.Terrain
		parent = att
		Debris:AddItem(att, 12)
	end
	sound.Parent = parent
	return sound
end

function Audio.play(name: string, where: any?, volumeScale: number?, speedScale: number?): Sound?
	local sound = Audio.create(name, where)
	if not sound then
		return nil
	end
	local def = Sounds.get(name)
	if volumeScale then
		sound.Volume *= volumeScale
	end
	if speedScale then
		sound.PlaybackSpeed *= speedScale
	end
	sound:Play()
	if not sound.Looped then
		if def and def.Duration then
			task.delay(def.Duration, function()
				if sound.Parent then
					local tw = TweenService:Create(sound, TweenInfo.new(0.15), { Volume = 0 })
					tw:Play()
					tw.Completed:Wait()
					sound:Destroy()
				end
			end)
		end
		sound.Ended:Connect(function()
			sound:Destroy()
		end)
		Debris:AddItem(sound, 15)
	end
	return sound
end

Remotes.Sfx.OnClientEvent:Connect(function(name, where)
	Audio.play(name, where)
end)

------------------------------------------------------------------------
-- Шаги (вызывает Animator в такт шагам)
------------------------------------------------------------------------

function Audio.footstep(char: Model, isKiller: boolean, speed: number, crouching: boolean)
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local vol = crouching and 0.25 or math.clamp(speed / 16, 0.35, 1.1)
	Audio.play(isKiller and "KillerFootstep" or "Footstep", root, vol, 0.92 + math.random() * 0.16)
end

------------------------------------------------------------------------
-- Фоновые звуки
------------------------------------------------------------------------

local wind = Audio.create("Wind", nil)
if wind then
	wind:Play()
end
local ambientMusic = Audio.create("AmbientMusic", nil)
if ambientMusic then
	ambientMusic:Play()
end

local heartbeatLoop = Audio.create("Heartbeat", nil) -- если задан свой звук
local lullabyLoop = Audio.create("Lullaby", nil)
local chaseMusic = Audio.create("ChaseMusic", nil)
local chaseDrone = Audio.create("ChaseDrone", nil)
for _, s in { heartbeatLoop, lullabyLoop, chaseMusic, chaseDrone } do
	if s then
		s.Volume = 0
		s:Play()
	end
end
local chaseLayer = chaseMusic or chaseDrone
local chaseMaxVolume = chaseLayer and (Sounds.get(chaseMusic and "ChaseMusic" or "ChaseDrone") :: any).Volume or 0

local beatTimer = 0
local crowTimer = 20
local genSounds = {} :: { [Instance]: Sound }
local hatchSound: Sound? = nil

local function findKiller(): Player?
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("Role") == "Killer" then
			return p
		end
	end
	return nil
end

-- Сила радиуса ужаса для локального выжившего (0..1)
function Audio.terrorIntensity(): number
	if player:GetAttribute("Role") ~= "Survivor" or not Util.isInGameStatus(player:GetAttribute("Status")) then
		return 0
	end
	local killer = findKiller()
	local kroot = Util.getRoot(killer)
	local myRoot = Util.getRoot(player)
	if not kroot or not myRoot then
		return 0
	end
	local tr = (killer :: Player):GetAttribute("TerrorRadius") or 32
	if tr <= 0 then
		return 0
	end
	return math.clamp(1 - Util.flatDist(kroot.Position, myRoot.Position) / tr, 0, 1)
end

local function updateGenerators(map: Instance?)
	local gens = map and map:FindFirstChild("Generators")
	local alive = {}
	if gens then
		for _, gen in gens:GetChildren() do
			local p = gen:GetAttribute("Progress") or 0
			if p > 0 and not gen:GetAttribute("Done") then
				alive[gen] = true
				local s = genSounds[gen]
				if not s then
					s = Audio.create("GenLoop", gen)
					if s then
						s:Play()
						genSounds[gen] = s
					end
				end
				if s then
					s.Volume = 0.1 + 0.45 * p
					s.PlaybackSpeed = 0.3 + 0.15 * p
				end
			end
		end
	end
	for gen, s in genSounds do
		if not alive[gen] then
			s:Destroy()
			genSounds[gen] = nil
		end
	end
end

function Audio.update(dt: number)
	local map = workspace:FindFirstChild("Map")
	local inMatch = player:GetAttribute("Role") ~= nil
	if wind then
		wind.Volume = map and 0.2 or 0.1
	end

	-- Сердцебиение / колыбельная
	local intensity = Audio.terrorIntensity()
	local killer = findKiller()
	local lullaby = killer and KillerDefs.get(killer:GetAttribute("KillerType")).Lullaby
	if lullaby and lullabyLoop then
		lullabyLoop.Volume = intensity
	elseif heartbeatLoop then
		heartbeatLoop.Volume = intensity
		heartbeatLoop.PlaybackSpeed = 0.9 + intensity * 0.5
	elseif intensity > 0 then
		beatTimer -= dt
		if beatTimer <= 0 then
			beatTimer = 1.25 - 0.8 * intensity
			local vol = 0.3 + 0.7 * intensity
			Audio.play("HeartThump", nil, vol)
			task.delay(0.17, function()
				Audio.play("HeartThump", nil, vol * 0.7, 0.9)
			end)
		end
	end

	-- Погоня
	if chaseLayer then
		local target = player:GetAttribute("Chase") and chaseMaxVolume or 0
		chaseLayer.Volume += (target - chaseLayer.Volume) * math.min(dt * 1.5, 1)
	end

	updateGenerators(map)

	-- Люк
	local hatch = map and map:FindFirstChild("Hatch")
	local hatchOpen = hatch and hatch:GetAttribute("Open")
	if hatchOpen and not hatchSound then
		hatchSound = Audio.create("HatchWind", hatch)
		if hatchSound then
			hatchSound:Play()
		end
	elseif not hatchOpen and hatchSound then
		hatchSound:Destroy()
		hatchSound = nil
	end

	-- Далёкие вороны для атмосферы
	if map and inMatch then
		crowTimer -= dt
		if crowTimer <= 0 then
			crowTimer = 15 + math.random() * 25
			local myRoot = Util.getRoot(player)
			if myRoot then
				local a = math.random() * math.pi * 2
				Audio.play("Crow", myRoot.Position + Vector3.new(math.cos(a) * 60, 10, math.sin(a) * 60), 0.5)
			end
		end
	end
end

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Auras</string>
            <string name="Source"><![CDATA[-- Ауры (подсветка сквозь стены), как в DBD.
-- Выжившие видят висящих/поверженных товарищей и запитанные ворота.
-- Маньяк видит генераторы, а когда несёт выжившего — свободные крюки.
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Auras = {}

local auras = {} :: { [Instance]: Highlight }

local RED = Color3.fromRGB(255, 50, 50)
local YELLOW = Color3.fromRGB(255, 220, 90)
local WHITE = Color3.fromRGB(235, 235, 235)

local function children(name: string): { Instance }
	local map = workspace:FindFirstChild("Map")
	local f = map and map:FindFirstChild(name)
	return f and f:GetChildren() or {}
end

function Auras.update()
	local wanted = {} :: { [Instance]: Color3 }
	local role = player:GetAttribute("Role")
	local status = player:GetAttribute("Status")
	local inGame = status == "Playing" or status == "Carried" or status == "Hooked"
	if role == "Survivor" and inGame then
		for _, p in Players:GetPlayers() do
			if p ~= player and p:GetAttribute("Role") == "Survivor" and p.Character then
				local s = p:GetAttribute("Status")
				if s == "Hooked" or (s == "Playing" and p:GetAttribute("Health") == 0 and not p:GetAttribute("Hidden")) then
					wanted[p.Character] = RED
				end
			end
		end
		for _, gate in children("ExitGates") do
			if gate:GetAttribute("Powered") and not gate:GetAttribute("Open") then
				wanted[gate] = YELLOW
			end
		end
	elseif role == "Killer" and status == "Playing" then
		if player:GetAttribute("Carrying") then
			for _, hook in children("Hooks") do
				if hook:GetAttribute("Occupant") == 0 then
					wanted[hook] = WHITE
				end
			end
		end
		for _, gen in children("Generators") do
			if not gen:GetAttribute("Done") then
				wanted[gen] = WHITE
			end
		end
	end

	for inst, h in auras do
		if not wanted[inst] or not inst.Parent then
			h:Destroy()
			auras[inst] = nil
		end
	end
	for inst, color in wanted do
		local h = auras[inst]
		if not h then
			h = Instance.new("Highlight")
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.FillTransparency = 0.85
			h.OutlineTransparency = 0.1
			h.Adornee = inst
			h.Parent = camera
			auras[inst] = h
		end
		h.OutlineColor = color
		h.FillColor = color
	end
end

return Auras
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[-- Камера: маньяк от первого лица с покачиванием, выживший от третьего,
-- ползание ниже, вид из шкафчика, тряска и наклон при оглушении.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local CameraController = {}

local shake = 0
local stunUntil = 0
local stunStart = 0
local fovPunch = 0
local mode = ""
local bob = 0
local lockerMode = false

function CameraController.shake(amount: number)
	shake = math.max(shake, amount)
end

function CameraController.stun(duration: number)
	stunStart = os.clock()
	stunUntil = stunStart + duration
	shake = math.max(shake, 0.4)
end

function CameraController.punch(amount: number)
	fovPunch = amount
end

local function setMode(newMode: string)
	if mode == newMode then
		return
	end
	mode = newMode
	if newMode == "Killer" then
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		player.CameraMaxZoomDistance = 0.5
		player.CameraMinZoomDistance = 0.5
	elseif newMode == "Survivor" then
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMaxZoomDistance = 16
		player.CameraMinZoomDistance = 7
	else
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMaxZoomDistance = 30
		player.CameraMinZoomDistance = 0.5
	end
end

local function findLocker(): Model?
	local map = workspace:FindFirstChild("Map")
	local lockers = map and map:FindFirstChild("Lockers")
	if not lockers then
		return nil
	end
	for _, l in lockers:GetChildren() do
		if l:GetAttribute("Occupant") == player.UserId then
			return l :: Model
		end
	end
	return nil
end

function CameraController.update(dt: number)
	local role = player:GetAttribute("Role")
	local status = player:GetAttribute("Status")
	local inGame = Util.isInGameStatus(status)
	local hum = Util.getHumanoid(player)

	if role == "Killer" and status == "Playing" and Config.KillerFirstPerson then
		setMode("Killer")
	elseif role == "Survivor" and inGame then
		setMode("Survivor")
	else
		setMode("Lobby")
	end

	-- Смещение камеры: ползание, приседание, покачивание головы маньяка
	if hum then
		local target = Vector3.zero
		local root = Util.getRoot(player)
		local speed = root and (root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude or 0
		if role == "Survivor" and status == "Playing" then
			if (player:GetAttribute("Health") or 2) == 0 then
				target = Vector3.new(0, -2.2, 0)
			elseif player:GetAttribute("Crouching") or player:GetAttribute("ActionName") then
				target = Vector3.new(0, -1, 0)
			end
		elseif mode == "Killer" then
			bob += dt * speed * 0.6
			local amp = math.clamp(speed / 18, 0, 1)
			target = Vector3.new(math.cos(bob) * 0.08 * amp, math.abs(math.sin(bob)) * 0.15 * amp, 0)
		end
		hum.CameraOffset = hum.CameraOffset:Lerp(target, math.min(dt * 8, 1))
	end

	local wantFov = mode == "Killer" and 85 or 70
	camera.FieldOfView += (wantFov + fovPunch - camera.FieldOfView) * math.min(dt * 10, 1)
	fovPunch *= math.exp(-dt * 6)

	-- Шкафчик: камера внутри, смотрит наружу через щели
	local locker = player:GetAttribute("Hidden") and findLocker()
	if locker then
		local inside = locker:FindFirstChild("Inside") :: BasePart?
		if inside then
			if not lockerMode then
				lockerMode = true
				camera.CameraType = Enum.CameraType.Scriptable
			end
			local look = inside.CFrame * CFrame.new(0, 1.8, -0.4)
			local sway = CFrame.Angles(math.sin(os.clock() * 0.7) * 0.02, math.sin(os.clock() * 0.5) * 0.08, 0)
			camera.CFrame = camera.CFrame:Lerp(look * sway, math.min(dt * 6, 1))
		end
	elseif lockerMode then
		lockerMode = false
		camera.CameraType = Enum.CameraType.Custom
	end
end

-- После стандартной камеры: тряска и наклон
RunService:BindToRenderStep("DBDCameraFX", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local t = os.clock()
	local extra = CFrame.identity
	if shake > 0.01 then
		extra *= CFrame.Angles(
			(math.noise(t * 25, 0) * shake) * 0.08,
			(math.noise(0, t * 25) * shake) * 0.08,
			0
		)
		shake *= math.exp(-dt * 5)
	end
	if t < stunUntil then
		local a = (t - stunStart) / (stunUntil - stunStart)
		extra *= CFrame.Angles(math.rad(-12) * (1 - a), 0, math.rad(18) * math.sin(a * math.pi))
	end
	if extra ~= CFrame.identity then
		camera.CFrame *= extra
	end
end)

return CameraController
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="51">
          <Properties>
            <string name="Name">Client</string>
            <string name="Source"><![CDATA[-- Клиент: связывает интерфейс, управление, анимации, камеру, звук и эффекты.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)
local Util = require(ReplicatedStorage.Shared.Util)

local Hud = require(script.Parent.UI.Hud)
local SkillCheck = require(script.Parent.UI.SkillCheck)
local LobbyUI = require(script.Parent.UI.LobbyUI)
local Results = require(script.Parent.UI.Results)
local Widgets = require(script.Parent.UI.Widgets)
require(script.Parent.Animator)
local Audio = require(script.Parent.Audio)
local CameraController = require(script.Parent.CameraController)
local Effects = require(script.Parent.Effects)
local Auras = require(script.Parent.Auras)
local Interaction = require(script.Parent.Interaction)
local Input = require(script.Parent.Input)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local gameState = ReplicatedStorage:WaitForChild("GameState")

Hud.mount(player:WaitForChild("PlayerGui") :: PlayerGui)
LobbyUI.mount(Hud.Gui)
Results.mount(Hud.Gui)

------------------------------------------------------------------------
-- События сервера
------------------------------------------------------------------------

Remotes.Notify.OnClientEvent:Connect(function(text, color)
	Hud.notify(text, color)
end)

Remotes.Score.OnClientEvent:Connect(function(text, amount)
	Hud.score(text, amount)
end)

Remotes.SkillCheck.OnClientEvent:Connect(function(id, zone)
	Audio.play("SkillWarn")
	SkillCheck.start(zone, Config.SkillCheckDuration, function(result)
		Remotes.SkillCheck:FireServer(id, result)
		if result == "great" then
			Audio.play("SkillGood", nil, 1, 1.2)
			Hud.notify("Отлично!", Color3.new(1, 1, 1))
		elseif result == "good" then
			Audio.play("SkillGood")
		else
			Hud.notify("Провал!", Color3.fromRGB(255, 70, 70))
			CameraController.shake(0.5)
		end
	end)
end)

Remotes.Noise.OnClientEvent:Connect(function(position)
	Effects.noise(position)
end)

Remotes.Results.OnClientEvent:Connect(function(title, reason, rows)
	Results.show(title, reason, rows, Config.ResultsTime)
end)

Remotes.Effect.OnClientEvent:Connect(function(name, value)
	if name == "Shake" then
		CameraController.shake(tonumber(value) or 0.5)
	elseif name == "Stun" then
		CameraController.stun(tonumber(value) or 2)
	elseif name == "Blind" then
		Hud.blind(tonumber(value) or 2)
		CameraController.shake(0.3)
	elseif name == "Intro" and typeof(value) == "table" then
		if value.Role == "Killer" then
			Hud.intro("Ты — " .. tostring(value.KillerName), "Принеси их в жертву Сущности")
		else
			Hud.intro("Выживи", "Маньяк: " .. tostring(value.KillerName))
		end
	end
end)

------------------------------------------------------------------------
-- Наблюдение за раундом (после смерти / побега)
------------------------------------------------------------------------

local spectateButton = Widgets.button({
	Parent = Hud.Gui,
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -24),
	Size = UDim2.fromOffset(240, 40),
	Text = "Наблюдать",
	Visible = false,
})
local spectating = false
local spectateIndex = 0

local function aliveParticipants(): { Player }
	local list = {}
	for _, p in Players:GetPlayers() do
		if p ~= player and p:GetAttribute("Role") and Util.isInGameStatus(p:GetAttribute("Status")) then
			table.insert(list, p)
		end
	end
	return list
end

local function stopSpectating()
	spectating = false
	local hum = Util.getHumanoid(player)
	if hum then
		camera.CameraSubject = hum
	end
	spectateButton.Text = "Наблюдать"
end

spectateButton.Activated:Connect(function()
	local list = aliveParticipants()
	if #list == 0 then
		stopSpectating()
		return
	end
	spectating = true
	spectateIndex = spectateIndex % #list + 1
	local target = list[spectateIndex]
	local hum = Util.getHumanoid(target)
	if hum then
		camera.CameraSubject = hum
	end
	spectateButton.Text = "Следующий (" .. target.DisplayName .. ")"
end)

player.CharacterAdded:Connect(function()
	if spectating then
		task.defer(stopSpectating)
	end
end)

------------------------------------------------------------------------
-- Главный цикл
------------------------------------------------------------------------

local ACTION_TEXT = {
	Repair = "Ремонт генератора",
	Heal = "Лечение",
	SelfHeal = "Лечение аптечкой",
	Unhook = "Снятие с крюка",
	OpenGate = "Открытие ворот",
	Cleanse = "Очищение тотема",
	OpenChest = "Открытие сундука",
	EscapeTrap = "Попытка вырваться",
	FreeTrap = "Освобождение из капкана",
	DisarmTrap = "Обезвреживание капкана",
	Hook = "Вешаем на крюк",
	Break = "Ломаем паллету",
	Kick = "Повреждаем генератор",
	SearchLocker = "Обыскиваем шкафчик",
	CloseHatch = "Закрываем люк",
	PickupTrap = "Забираем капкан",
	ResetTrap = "Взводим капкан",
	SetTrap = "Ставим капкан",
}

local CONTROLS_SURVIVOR = "Shift — бег   •   Ctrl/C — присесть\n"
	.. "E (держать) — чинить, лечить, снять с крюка, сундук, тотем\n"
	.. "Пробел — паллета, окно, шкафчик, проверка навыка\n"
	.. "R — использовать предмет"
local CONTROLS_LOBBY = "Dead by Daylight в Roblox\nВыжившие чинят генераторы и сбегают,\nманьяк вешает их на крюки.\nСядь на бревно у костра и жди раунда."

local pulse = 0

RunService.RenderStepped:Connect(function(dt)
	local role = player:GetAttribute("Role")
	local status = player:GetAttribute("Status")
	local phase = gameState:GetAttribute("Phase")
	local timer = gameState:GetAttribute("Timer") or 0
	local inMatch = role ~= nil and Util.isInGameStatus(status)

	Input.bind(inMatch and role or nil)

	-- Верхние надписи
	if phase == "InGame" then
		local gens = gameState:GetAttribute("GensLeft") or 0
		local sub
		if gameState:GetAttribute("EndGame") then
			sub = "ОБРУШЕНИЕ: " .. (gameState:GetAttribute("EndGameTimer") or 0) .. " с"
		elseif gameState:GetAttribute("HexRuin") and role then
			sub = "Проклятие: Руина"
		end
		Hud.setGenerators(role ~= nil, gens > 0 and ("Генераторы: " .. gens) or "Ворота запитаны!", sub)
		Hud.setTop(not role and "Идёт раунд — подожди следующего" or nil, nil)
	else
		Hud.setGenerators(false)
		if phase == "Starting" then
			Hud.setTop("Раунд начнётся через " .. timer, "Маньяк выбирается среди желающих")
		elseif phase == "Loading" then
			Hud.setTop("Загрузка карты...")
		elseif phase == "Results" then
			Hud.setTop("Новый раунд через " .. timer)
		else
			local need = gameState:GetAttribute("NeedPlayers") or Config.MinPlayers
			Hud.setTop("Ожидание игроков (" .. #Players:GetPlayers() .. "/" .. need .. ")")
		end
	end

	LobbyUI.setVisible(role == nil and phase ~= "InGame" and phase ~= "Loading")
	Hud.updatePortraits(phase == "InGame")
	Hud.updatePower()

	if role == "Killer" then
		local def = KillerDefs.get(player:GetAttribute("KillerType"))
		Hud.setControls("ЛКМ — удар   •   " .. def.PowerHint .. "\nE — поднять, повесить, сломать, обыскать\nПробел — перелезть через окно")
	elseif role == "Survivor" then
		Hud.setControls(CONTROLS_SURVIVOR)
	else
		Hud.setControls(CONTROLS_LOBBY)
	end

	-- Действия и подсказки
	local primary, secondary = nil, nil
	if inMatch then
		primary, secondary = Interaction.find()
	end
	Input.Primary, Input.Secondary = primary, secondary
	local actionName = player:GetAttribute("ActionName")
	if actionName then
		Hud.setHints(nil, nil)
		Hud.setAction(ACTION_TEXT[actionName] or actionName, player:GetAttribute("ActionProgress") or 0)
	else
		Hud.setAction(nil, nil)
		Hud.setHints(
			primary and ("[E] " .. primary.Text) or nil,
			secondary and ("[Пробел] " .. secondary.Text) or nil
		)
		local check = SkillCheck.get()
		if check then
			check.Cancel()
		end
	end
	local check = SkillCheck.get()
	if check then
		check.Update()
	end

	-- Личный статус
	if player:GetAttribute("HookProgress") then
		local stage = player:GetAttribute("HookCount") or 1
		Hud.setStatus("На крюке — стадия " .. stage .. ". Жди помощи!", 1 - player:GetAttribute("HookProgress"))
	elseif player:GetAttribute("Wiggle") then
		Hud.setStatus("Вырываешься из рук маньяка...", player:GetAttribute("Wiggle"))
	elseif player:GetAttribute("BleedOut") then
		Hud.setStatus("Ты повержен — истекаешь кровью. Жди помощи!", 1 - player:GetAttribute("BleedOut"))
	elseif player:GetAttribute("Trapped") then
		Hud.setStatus("Ты в капкане! Держи E, чтобы вырваться", 1)
	elseif player:GetAttribute("Stunned") then
		Hud.setStatus("Оглушён!", 1)
	elseif player:GetAttribute("Hidden") then
		Hud.setStatus("Ты прячешься в шкафчике. Пробел — выйти", 1)
	else
		Hud.setStatus(nil, nil)
	end

	-- Пульсирующая красная виньетка радиуса ужаса
	local intensity = Audio.terrorIntensity()
	if intensity > 0 then
		pulse += dt * (1 + intensity * 2.5)
		Hud.setTerror(intensity * (0.35 + 0.65 * math.abs(math.sin(pulse * math.pi))))
	else
		Hud.setTerror(0)
	end

	-- Наблюдение
	local canSpectate = phase == "InGame" and not inMatch
	spectateButton.Visible = canSpectate
	if spectating and not canSpectate then
		stopSpectating()
	end

	Auras.update()
	Effects.update(dt)
	Audio.update(dt)
	CameraController.update(dt)
	Input.update(dt)
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- Визуальные эффекты на клиенте: следы бега и кровь (видит только маньяк),
-- полёт топоров, невидимость Призрака, поршни генераторов, шумы.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Effects = {}

local folder = Instance.new("Folder")
folder.Name = "DBDLocalFX"
folder.Parent = workspace

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.RespectCanCollide = true

local function groundBelow(pos: Vector3): (Vector3?, Vector3?)
	local exclude = { folder }
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	groundParams.FilterDescendantsInstances = exclude
	local hit = workspace:Raycast(pos, Vector3.new(0, -8, 0), groundParams)
	if hit then
		return hit.Position, hit.Normal
	end
	return nil, nil
end

local function fxPart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = folder
	return p
end

local function fadeOut(part: BasePart, delayTime: number, duration: number)
	task.delay(delayTime, function()
		if part.Parent then
			TweenService:Create(part, TweenInfo.new(duration), { Transparency = 1 }):Play()
			Debris:AddItem(part, duration + 0.1)
		end
	end)
end

------------------------------------------------------------------------
-- Следы и кровь (только для маньяка)
------------------------------------------------------------------------

local trackTimers = {} :: { [Player]: { Scratch: number, Blood: number } }

local function scratchMark(pos: Vector3)
	local ground = groundBelow(pos)
	if not ground then
		return
	end
	local yaw = math.random() * math.pi * 2
	for i = 1, 3 do
		local p = fxPart({
			Name = "Scratch",
			Size = Vector3.new(0.12, 0.05, 1.6 + math.random()),
			CFrame = CFrame.new(ground + Vector3.new(0, 0.06, 0)) * CFrame.Angles(0, yaw, 0) * CFrame.new((i - 2) * 0.35, 0, 0) * CFrame.Angles(
				0,
				(math.random() - 0.5) * 0.4,
				0
			),
			Color = Color3.fromRGB(255, 80, 40),
			Material = Enum.Material.Neon,
			Transparency = 0.15,
		})
		fadeOut(p, 5, 3)
	end
end

local function bloodPool(pos: Vector3)
	local ground = groundBelow(pos)
	if not ground then
		return
	end
	local r = 0.8 + math.random() * 1.2
	local p = fxPart({
		Name = "Blood",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.05, r, r),
		CFrame = CFrame.new(ground + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(110, 0, 0),
		Material = Enum.Material.Glass,
		Transparency = 0.1,
	})
	fadeOut(p, 7, 3)
end

local function updateTracks(dt: number)
	local isKiller = player:GetAttribute("Role") == "Killer" and player:GetAttribute("Status") == "Playing"
	if not isKiller then
		return
	end
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("Role") ~= "Survivor" or p:GetAttribute("Status") ~= "Playing" or p:GetAttribute("Hidden") then
			continue
		end
		local root = Util.getRoot(p)
		if not root then
			continue
		end
		local timers = trackTimers[p] or { Scratch = 0, Blood = 0 }
		trackTimers[p] = timers
		timers.Scratch -= dt
		timers.Blood -= dt
		if p:GetAttribute("Running") and timers.Scratch <= 0 then
			timers.Scratch = 0.3
			scratchMark(root.Position + Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1))
		end
		local health = p:GetAttribute("Health") or 2
		local moving = (root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude > 1
		if health < 2 and moving and timers.Blood <= 0 then
			timers.Blood = 1.4
			bloodPool(root.Position)
		end
	end
end

------------------------------------------------------------------------
-- Топоры Охотницы
------------------------------------------------------------------------

local projectiles = {} :: { [number]: any }

local function hatchetModel(): Model
	local m = Instance.new("Model")
	m.Name = "Hatchet"
	local handle = fxPart({
		Name = "Handle",
		Size = Vector3.new(0.18, 0.18, 1.8),
		Color = Color3.fromRGB(80, 55, 35),
		Material = Enum.Material.Wood,
	})
	handle.Parent = m
	local head = fxPart({
		Name = "Head",
		Size = Vector3.new(0.1, 0.8, 0.6),
		Color = Color3.fromRGB(170, 165, 160),
		Material = Enum.Material.Metal,
	})
	head.CFrame = handle.CFrame * CFrame.new(0, 0.3, -0.8)
	head.Parent = m
	m.PrimaryPart = handle
	m.Parent = folder
	return m
end

Remotes.Projectile.OnClientEvent:Connect(function(id, origin, velocity, gravity)
	projectiles[id] = {
		Model = hatchetModel(),
		Pos = origin,
		Vel = velocity,
		Gravity = Vector3.new(0, -gravity, 0),
		Spin = 0,
		Stuck = false,
	}
end)

Remotes.ProjectileEnd.OnClientEvent:Connect(function(id, pos, hitPlayer)
	local p = projectiles[id]
	if not p then
		return
	end
	projectiles[id] = nil
	if hitPlayer then
		p.Model:Destroy()
		return
	end
	-- Воткнулся
	local dir = p.Vel.Magnitude > 0.1 and p.Vel.Unit or Vector3.new(0, 0, -1)
	p.Model:PivotTo(CFrame.lookAt(pos - dir * 0.6, pos))
	task.delay(4, function()
		if p.Model.Parent then
			p.Model:Destroy()
		end
	end)
end)

local function updateProjectiles(dt: number)
	for _, p in projectiles do
		local newVel = p.Vel + p.Gravity * dt
		p.Pos += (p.Vel + newVel) * 0.5 * dt
		p.Vel = newVel
		p.Spin += dt * 25
		if p.Vel.Magnitude > 0.1 then
			p.Model:PivotTo(CFrame.lookAt(p.Pos, p.Pos + p.Vel) * CFrame.Angles(-p.Spin, 0, 0))
		end
	end
end

------------------------------------------------------------------------
-- Невидимость Призрака и красное пятно
------------------------------------------------------------------------

local cloakCache = {} :: { [Model]: number }

local function setModifier(char: Model, value: number)
	if cloakCache[char] == value then
		return
	end
	cloakCache[char] = value
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") or d:IsA("Decal") then
			d.LocalTransparencyModifier = value
		end
	end
end

local function updateCloak()
	for _, p in Players:GetPlayers() do
		local char = p.Character
		if not char or p:GetAttribute("Role") ~= "Killer" then
			continue
		end
		local state = p:GetAttribute("PowerState")
		if p ~= player then
			local value = 0
			if state == "Cloaked" then
				value = 0.93 + math.sin(os.clock() * 3) * 0.03
			elseif state == "Cloaking" or state == "Uncloaking" then
				value = 0.5 + math.sin(os.clock() * 20) * 0.3
			end
			setModifier(char, value)
		else
			-- Своё красное пятно маньяк не видит
			local head = char:FindFirstChild("Head")
			local stain = head and head:FindFirstChild("RedStain") :: SpotLight?
			if stain and stain.Enabled then
				stain.Enabled = false
			end
		end
	end
end

------------------------------------------------------------------------
-- Поршни генераторов
------------------------------------------------------------------------

local genState = {} :: { [Instance]: { Last: number, Active: number, Base: { [BasePart]: CFrame } } }

local function updateGenerators(dt: number)
	local map = workspace:FindFirstChild("Map")
	local gens = map and map:FindFirstChild("Generators")
	if not gens then
		table.clear(genState)
		return
	end
	local camPos = camera.CFrame.Position
	for _, gen in gens:GetChildren() do
		local body = (gen :: Model).PrimaryPart
		if not body or (body.Position - camPos).Magnitude > 90 then
			continue
		end
		local st = genState[gen]
		if not st then
			st = { Last = gen:GetAttribute("Progress") or 0, Active = 0, Base = {} }
			for i = 1, 2 do
				local piston = gen:FindFirstChild("Piston" .. i) :: BasePart?
				if piston then
					st.Base[piston] = piston.CFrame
				end
			end
			genState[gen] = st
		end
		local p = gen:GetAttribute("Progress") or 0
		if p > st.Last + 1e-5 then
			st.Active = 0.4
		end
		st.Last = p
		st.Active -= dt
		local running = st.Active > 0 or gen:GetAttribute("Done")
		local i = 0
		for piston, base in st.Base do
			i += 1
			local offset = running and math.sin(os.clock() * 22 + i * math.pi) * 0.22 or 0
			piston.CFrame = base * CFrame.new(offset, 0, 0)
		end
	end
end

------------------------------------------------------------------------
-- Шум (видит маньяк)
------------------------------------------------------------------------

function Effects.noise(position: Vector3)
	local p = fxPart({
		Name = "Noise",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(position + Vector3.new(0, 4, 0)),
		Transparency = 1,
	})
	local bb = Instance.new("BillboardGui")
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(70, 70)
	bb.Parent = p
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(1, 1)
	l.Text = "!"
	l.TextScaled = true
	l.Font = Enum.Font.GothamBlack
	l.TextColor3 = Color3.fromRGB(255, 200, 40)
	l.TextStrokeTransparency = 0.3
	l.Parent = bb
	TweenService:Create(l, TweenInfo.new(4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(p, 4)
end

function Effects.update(dt: number)
	updateTracks(dt)
	updateProjectiles(dt)
	updateCloak()
	updateGenerators(dt)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Input</string>
            <string name="Source"><![CDATA[-- Управление (клавиатура, геймпад, сенсорные кнопки на телефоне).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local SkillCheck = require(script.Parent.UI.SkillCheck)
local CameraController = require(script.Parent.CameraController)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Input = {}

Input.Primary = nil :: any
Input.Secondary = nil :: any

local holding = false
local sprinting = false
local crouching = false
local itemHeld = false
local boundRole: string? = nil

local Sink = Enum.ContextActionResult.Sink
local Pass = Enum.ContextActionResult.Pass
local Begin = Enum.UserInputState.Begin

local function isEnd(state: Enum.UserInputState): boolean
	return state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel
end

local function onInteract(_, state)
	if state == Begin then
		if Input.Primary then
			holding = true
			Remotes.BeginAction:FireServer(Input.Primary.Kind, Input.Primary.Target)
		end
	elseif isEnd(state) and holding then
		holding = false
		Remotes.EndAction:FireServer()
	end
	return Sink
end

local function onSecondary(_, state)
	if state ~= Begin then
		return Sink
	end
	local check = SkillCheck.get()
	if check then
		check.Press()
	elseif Input.Secondary then
		Remotes.BeginAction:FireServer(Input.Secondary.Kind, Input.Secondary.Target)
	end
	return Sink
end

local function onSprint(_, state, input)
	if input.UserInputType == Enum.UserInputType.Touch then
		if state == Begin then
			sprinting = not sprinting
			Remotes.Sprint:FireServer(sprinting)
		end
	elseif state == Begin then
		sprinting = true
		Remotes.Sprint:FireServer(true)
	elseif isEnd(state) then
		sprinting = false
		Remotes.Sprint:FireServer(false)
	end
	return Pass
end

local function onCrouch(_, state, input)
	if input.UserInputType == Enum.UserInputType.Touch then
		if state == Begin then
			crouching = not crouching
			Remotes.Crouch:FireServer(crouching)
		end
	elseif state == Begin then
		crouching = true
		Remotes.Crouch:FireServer(true)
	elseif isEnd(state) then
		crouching = false
		Remotes.Crouch:FireServer(false)
	end
	return Sink
end

local function onItem(_, state)
	if state == Begin then
		itemHeld = true
		Remotes.UseItem:FireServer(true, camera.CFrame.LookVector)
	elseif isEnd(state) then
		itemHeld = false
		Remotes.UseItem:FireServer(false, camera.CFrame.LookVector)
	end
	return Sink
end

local function onAttack(_, state)
	if state == Begin then
		Remotes.Attack:FireServer()
		if player:GetAttribute("Status") == "Playing" and not player:GetAttribute("Carrying") then
			CameraController.punch(-6)
		end
	end
	return Pass
end

local function onPower(_, state)
	if state == Begin then
		Remotes.UsePower:FireServer(true, camera.CFrame.LookVector)
	elseif isEnd(state) then
		Remotes.UsePower:FireServer(false, camera.CFrame.LookVector)
	end
	return Sink
end

local ACTIONS = { "DBDInteract", "DBDSecondary", "DBDSprint", "DBDCrouch", "DBDItem", "DBDAttack", "DBDPower" }

function Input.bind(role: string?)
	if boundRole == role then
		return
	end
	boundRole = role
	for _, name in ACTIONS do
		ContextActionService:UnbindAction(name)
	end
	if holding then
		holding = false
	end
	sprinting, crouching, itemHeld = false, false, false
	if not role then
		return
	end
	ContextActionService:BindActionAtPriority("DBDInteract", onInteract, true, 3000, Enum.KeyCode.E, Enum.KeyCode.ButtonX)
	ContextActionService:SetTitle("DBDInteract", "E")
	ContextActionService:SetPosition("DBDInteract", UDim2.new(1, -170, 1, -150))
	ContextActionService:BindActionAtPriority("DBDSecondary", onSecondary, true, 3000, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
	ContextActionService:SetTitle("DBDSecondary", "Прыг")
	ContextActionService:SetPosition("DBDSecondary", UDim2.new(1, -95, 1, -95))
	if role == "Survivor" then
		ContextActionService:BindAction("DBDSprint", onSprint, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
		ContextActionService:SetTitle("DBDSprint", "Бег")
		ContextActionService:SetPosition("DBDSprint", UDim2.new(1, -170, 1, -80))
		ContextActionService:BindActionAtPriority("DBDCrouch", onCrouch, true, 3000, Enum.KeyCode.LeftControl, Enum.KeyCode.C, Enum.KeyCode.ButtonB)
		ContextActionService:SetTitle("DBDCrouch", "Присесть")
		ContextActionService:SetPosition("DBDCrouch", UDim2.new(1, -245, 1, -80))
		ContextActionService:BindActionAtPriority("DBDItem", onItem, true, 3000, Enum.KeyCode.R, Enum.KeyCode.ButtonL2)
		ContextActionService:SetTitle("DBDItem", "Предмет")
		ContextActionService:SetPosition("DBDItem", UDim2.new(1, -245, 1, -150))
	else
		ContextActionService:BindAction("DBDAttack", onAttack, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
		ContextActionService:SetTitle("DBDAttack", "Удар")
		ContextActionService:SetPosition("DBDAttack", UDim2.new(1, -245, 1, -110))
		ContextActionService:BindActionAtPriority(
			"DBDPower",
			onPower,
			true,
			3000,
			Enum.UserInputType.MouseButton2,
			Enum.KeyCode.Q,
			Enum.KeyCode.ButtonL2
		)
		ContextActionService:SetTitle("DBDPower", "Сила")
		ContextActionService:SetPosition("DBDPower", UDim2.new(1, -245, 1, -180))
	end
end

-- Пока светим фонариком, отправляем направление камеры
local aimTimer = 0
function Input.update(dt: number)
	if itemHeld and player:GetAttribute("Item") == "Flashlight" then
		aimTimer -= dt
		if aimTimer <= 0 then
			aimTimer = 0.1
			Remotes.UseItem:FireServer(true, camera.CFrame.LookVector)
		end
	end
end

return Input
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Interaction</string>
            <string name="Source"><![CDATA[-- Поиск ближайшего доступного действия для подсказки и нажатия.
-- primary — кнопка E (держать), secondary — Пробел.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Util = require(ReplicatedStorage.Shared.Util)
local ActionInfo = require(ReplicatedStorage.Shared.ActionInfo)
local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)

local player = Players.LocalPlayer
local gameState = ReplicatedStorage:WaitForChild("GameState")

local Interaction = {}

export type Candidate = { Kind: string, Target: Instance, Text: string }

local function children(name: string): { Instance }
	local map = workspace:FindFirstChild("Map")
	local f = map and map:FindFirstChild(name)
	return f and f:GetChildren() or {}
end

local function hatch(): Instance?
	local map = workspace:FindFirstChild("Map")
	return map and map:FindFirstChild("Hatch")
end

local function add(list, kind: string, target: Instance, text: string?)
	table.insert(list, { Kind = kind, Target = target, Text = text or ActionInfo[kind].Label })
end

local function nearest(rootPos: Vector3, candidates): Candidate?
	local best, bestDist = nil, math.huge
	for _, c in candidates do
		local pos = Util.objectPosition(c.Target)
		if pos then
			local d = Util.flatDist(rootPos, pos)
			if d <= ActionInfo[c.Kind].Range and d < bestDist and math.abs(rootPos.Y - pos.Y) < 9 then
				best, bestDist = c, d
			end
		end
	end
	return best
end

local function myTrap(): Instance?
	for _, trap in children("Traps") do
		if trap:GetAttribute("Caught") == player.UserId then
			return trap
		end
	end
	return nil
end

local function myLocker(): Instance?
	for _, l in children("Lockers") do
		if l:GetAttribute("Occupant") == player.UserId then
			return l
		end
	end
	return nil
end

local function survivorCandidates(primary, secondary)
	if player:GetAttribute("Hidden") then
		local locker = myLocker()
		if locker then
			add(secondary, "ExitLocker", locker)
		end
		return true
	end
	if player:GetAttribute("Trapped") then
		local trap = myTrap()
		if trap then
			add(primary, "EscapeTrap", trap)
		end
		return true
	end
	if (player:GetAttribute("Health") or 0) <= 0 then
		return true
	end
	for _, p in Players:GetPlayers() do
		if p ~= player and p:GetAttribute("Role") == "Survivor" then
			local status = p:GetAttribute("Status")
			local health = p:GetAttribute("Health") or 2
			if status == "Hooked" then
				add(primary, "Unhook", p, "Снять " .. p.DisplayName .. " с крюка")
			elseif status == "Playing" and health < 2 and not p:GetAttribute("Hidden") and not p:GetAttribute("Trapped") then
				add(primary, "Heal", p, (health == 0 and "Поднять " or "Лечить ") .. p.DisplayName)
			end
		end
	end
	if (gameState:GetAttribute("GensLeft") or 0) > 0 then
		for _, gen in children("Generators") do
			if not gen:GetAttribute("Done") then
				add(primary, "Repair", gen)
			end
		end
	end
	for _, gate in children("ExitGates") do
		if gate:GetAttribute("Powered") and not gate:GetAttribute("Open") then
			add(primary, "OpenGate", gate)
		end
	end
	for _, totem in children("Totems") do
		if not totem:GetAttribute("Cleansed") then
			add(primary, "Cleanse", totem, totem:GetAttribute("Hex") and "Очистить проклятый тотем" or nil)
		end
	end
	for _, chest in children("Chests") do
		if not chest:GetAttribute("Opened") then
			add(primary, "OpenChest", chest)
		end
	end
	for _, trap in children("Traps") do
		local caught = trap:GetAttribute("Caught") or 0
		if caught ~= 0 then
			add(primary, "FreeTrap", trap)
		elseif trap:GetAttribute("Armed") then
			add(primary, "DisarmTrap", trap)
		end
	end
	local h = hatch()
	if h and h:GetAttribute("Open") then
		add(primary, "JumpHatch", h)
	end
	for _, pallet in children("Pallets") do
		local state = pallet:GetAttribute("State")
		if state == "Up" then
			add(secondary, "DropPallet", pallet)
		elseif state == "Dropped" then
			add(secondary, "Vault", pallet, "Перепрыгнуть паллету")
		end
	end
	for _, window in children("Windows") do
		add(secondary, "Vault", window, "Перелезть через окно")
	end
	for _, locker in children("Lockers") do
		if locker:GetAttribute("Occupant") == 0 then
			add(secondary, "EnterLocker", locker)
		end
	end
	return false
end

local function killerCandidates(primary, secondary)
	if player:GetAttribute("Stunned") or player:GetAttribute("Blinded") then
		return
	end
	if player:GetAttribute("Carrying") then
		for _, hook in children("Hooks") do
			if hook:GetAttribute("Occupant") == 0 then
				add(primary, "Hook", hook)
			end
		end
		return
	end
	local cloaked = player:GetAttribute("PowerState") == "Cloaked"
	if not cloaked then
		for _, p in Players:GetPlayers() do
			if p:GetAttribute("Role") == "Survivor" and p:GetAttribute("Status") == "Playing" and not p:GetAttribute("Hidden") then
				if p:GetAttribute("Health") == 0 or p:GetAttribute("Trapped") then
					add(primary, "Pickup", p, "Поднять " .. p.DisplayName)
				end
			end
		end
	end
	for _, pallet in children("Pallets") do
		if pallet:GetAttribute("State") == "Dropped" then
			add(primary, "Break", pallet)
		end
	end
	if (gameState:GetAttribute("GensLeft") or 0) > 0 then
		for _, gen in children("Generators") do
			if not gen:GetAttribute("Done") and (gen:GetAttribute("Progress") or 0) > 0 and not gen:GetAttribute("Regressing") then
				add(primary, "Kick", gen)
			end
		end
	end
	local huntress = player:GetAttribute("KillerType") == "Huntress"
	for _, locker in children("Lockers") do
		add(primary, "SearchLocker", locker, huntress and "Обыскать шкафчик / взять топоры" or nil)
	end
	local h = hatch()
	if h and h:GetAttribute("Open") then
		add(primary, "CloseHatch", h)
	end
	if player:GetAttribute("KillerType") == "Trapper" then
		local inHand = player:GetAttribute("PowerCount") or 0
		for _, trap in children("Traps") do
			if (trap:GetAttribute("Caught") or 0) == 0 then
				if not trap:GetAttribute("Armed") then
					add(primary, "ResetTrap", trap)
				elseif inHand < KillerDefs.Trapper.MaxTrapsInHand then
					add(primary, "PickupTrap", trap)
				end
			end
		end
	end
	for _, window in children("Windows") do
		add(secondary, "Vault", window, "Перелезть через окно")
	end
end

function Interaction.find(): (Candidate?, Candidate?)
	local root = Util.getRoot(player)
	local role = player:GetAttribute("Role")
	if not root or not role or player:GetAttribute("Status") ~= "Playing" or player:GetAttribute("ActionName") then
		return nil, nil
	end
	local primary, secondary = {}, {}
	local pos = root.Position
	if role == "Survivor" then
		local exclusive = survivorCandidates(primary, secondary)
		if exclusive then
			-- Из шкафчика / капкана есть только одно действие
			return primary[1], secondary[1]
		end
	else
		killerCandidates(primary, secondary)
	end
	return nearest(pos, primary), nearest(pos, secondary)
end

return Interaction
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="55">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- Основной интерфейс: генераторы, портреты выживших, подсказки, полоски,
-- способность/предмет, очки крови, уведомления, затемнения и эффекты экрана.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)
local ItemDefs = require(ReplicatedStorage.Shared.ItemDefs)
local Widgets = require(script.Parent.Widgets)
local SkillCheck = require(script.Parent.SkillCheck)

local new, label = Widgets.new, Widgets.label
local player = Players.LocalPlayer

local Hud = {}

local gui: ScreenGui
local edges = {}
local blindOverlay: Frame
local fadeOverlay: Frame
local fadeText: TextLabel
local genFrame: Frame
local genLabel: TextLabel
local genSub: TextLabel
local top: TextLabel
local topSub: TextLabel
local notifyHolder: Frame
local scoreHolder: Frame
local portraitHolder: Frame
local portraits = {}
local hintPrimary: TextLabel
local hintSecondary: TextLabel
local actionBar
local statusBar
local powerPanel: Frame
local powerTitle: TextLabel
local powerInfo: TextLabel
local powerBar
local controls: TextLabel
local notifyOrder = 0

function Hud.mount(playerGui: PlayerGui)
	gui = new("ScreenGui", {
		Name = "DBDHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	Hud.Gui = gui

	-- Красная виньетка радиуса ужаса
	for _, data in
		{
			{ UDim2.fromScale(1, 0.22), UDim2.fromScale(0, 0), 90 },
			{ UDim2.fromScale(1, 0.22), UDim2.fromScale(0, 0.78), -90 },
			{ UDim2.fromScale(0.18, 1), UDim2.fromScale(0, 0), 0 },
			{ UDim2.fromScale(0.18, 1), UDim2.fromScale(0.82, 0), 180 },
		}
	do
		table.insert(
			edges,
			new("Frame", {
				Parent = gui,
				Size = data[1],
				Position = data[2],
				BackgroundColor3 = Color3.fromRGB(150, 0, 0),
				BorderSizePixel = 0,
				BackgroundTransparency = 1,
				ZIndex = 0,
			}, { new("UIGradient", { Rotation = data[3], Transparency = NumberSequence.new(0, 1) }) })
		)
	end

	-- Счётчик генераторов (слева сверху)
	genFrame = new("Frame", {
		Parent = gui,
		Position = UDim2.fromOffset(16, 56),
		Size = UDim2.fromOffset(230, 64),
		BackgroundColor3 = Widgets.DARK,
		BackgroundTransparency = 0.35,
		Visible = false,
	}, { Widgets.corner(6), Widgets.stroke(Widgets.RED, 1, 0.4) })
	genLabel = label({
		Parent = genFrame,
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -24, 0, 32),
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
	})
	genSub = label({
		Parent = genFrame,
		Position = UDim2.fromOffset(12, 36),
		Size = UDim2.new(1, -24, 0, 22),
		TextSize = 14,
		Font = Widgets.FONT_REG,
		TextColor3 = Color3.fromRGB(255, 110, 90),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
	})

	top = label({
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 48),
		Size = UDim2.new(0.6, 0, 0, 32),
		TextSize = 24,
		Text = "",
	})
	topSub = label({
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 80),
		Size = UDim2.new(0.6, 0, 0, 22),
		TextSize = 17,
		TextColor3 = Color3.fromRGB(255, 120, 100),
		Text = "",
	})

	notifyHolder = new("Frame", {
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 110),
		Size = UDim2.new(0.7, 0, 0, 160),
		BackgroundTransparency = 1,
	}, {
		new("UIListLayout", {
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 2),
		}),
	})

	scoreHolder = new("Frame", {
		Parent = gui,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.42, 0),
		Size = UDim2.fromOffset(260, 200),
		BackgroundTransparency = 1,
	}, {
		new("UIListLayout", {
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 2),
		}),
	})

	-- Портреты выживших (слева снизу)
	portraitHolder = new("Frame", {
		Parent = gui,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -20),
		Size = UDim2.fromOffset(250, 230),
		BackgroundTransparency = 1,
	}, {
		new("UIListLayout", {
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 5),
		}),
	})

	hintPrimary = label({
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -150),
		Size = UDim2.new(0.6, 0, 0, 26),
		TextSize = 20,
		Text = "",
	})
	hintSecondary = label({
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -124),
		Size = UDim2.new(0.6, 0, 0, 26),
		TextSize = 20,
		Text = "",
	})
	actionBar = Widgets.bar(gui, UDim2.new(0.5, 0, 1, -92), UDim2.fromOffset(340, 14))
	statusBar = Widgets.bar(gui, UDim2.new(0.5, 0, 1, -200), UDim2.fromOffset(340, 10), Color3.fromRGB(200, 40, 40))

	-- Способность / предмет (справа снизу)
	powerPanel = new("Frame", {
		Parent = gui,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -20),
		Size = UDim2.fromOffset(260, 74),
		BackgroundColor3 = Widgets.DARK,
		BackgroundTransparency = 0.35,
		Visible = false,
	}, { Widgets.corner(6), Widgets.stroke(Widgets.RED, 1, 0.4) })
	powerTitle = label({
		Parent = powerPanel,
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -24, 0, 22),
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	powerInfo = label({
		Parent = powerPanel,
		Position = UDim2.fromOffset(12, 28),
		Size = UDim2.new(1, -24, 0, 18),
		TextSize = 13,
		Font = Widgets.FONT_REG,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(210, 210, 210),
	})
	powerBar = Widgets.bar(powerPanel, UDim2.new(0.5, 0, 1, -12), UDim2.new(1, -24, 0, 8), Color3.fromRGB(230, 200, 120))
	powerBar.Label.Visible = false

	controls = label({
		Parent = gui,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -104),
		Size = UDim2.fromOffset(360, 110),
		TextSize = 13,
		Font = Widgets.FONT_REG,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		TextTransparency = 0.25,
		Text = "",
	})

	-- Белая вспышка (ослепление) и затемнение (начало раунда)
	blindOverlay = new("Frame", {
		Parent = gui,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		ZIndex = 20,
	})
	fadeOverlay = new("Frame", {
		Parent = gui,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		ZIndex = 30,
	})
	fadeText = label({
		Parent = fadeOverlay,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.8, 0, 0, 120),
		TextSize = 48,
		Font = Widgets.FONT_TITLE,
		TextColor3 = Color3.fromRGB(200, 30, 30),
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		ZIndex = 31,
	})

	SkillCheck.mount(gui)
end

------------------------------------------------------------------------

function Hud.setTop(text: string?, sub: string?)
	top.Text = text or ""
	topSub.Text = sub or ""
end

function Hud.setGenerators(visible: boolean, text: string?, sub: string?)
	genFrame.Visible = visible
	genLabel.Text = text or ""
	genSub.Text = sub or ""
end

function Hud.setControls(text: string)
	controls.Text = text
end

function Hud.notify(text: string, color: Color3?)
	notifyOrder += 1
	local l = label({
		Parent = notifyHolder,
		LayoutOrder = notifyOrder,
		Size = UDim2.new(1, 0, 0, 24),
		TextSize = 20,
		Text = text,
		TextColor3 = color or Color3.new(1, 1, 1),
	})
	local labels = {}
	for _, c in notifyHolder:GetChildren() do
		if c:IsA("TextLabel") then
			table.insert(labels, c)
		end
	end
	if #labels > 5 then
		table.sort(labels, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		labels[1]:Destroy()
	end
	task.delay(4.5, function()
		if l.Parent then
			local tw = TweenService:Create(l, TweenInfo.new(1), { TextTransparency = 1, TextStrokeTransparency = 1 })
			tw:Play()
			tw.Completed:Wait()
			l:Destroy()
		end
	end)
end

function Hud.score(text: string, amount: number)
	notifyOrder += 1
	local l = label({
		Parent = scoreHolder,
		LayoutOrder = notifyOrder,
		Size = UDim2.new(1, 0, 0, 22),
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Right,
		RichText = true,
		Text = string.format('<font color="#ff4d4d">+%d</font>  %s', amount, text),
	})
	task.delay(3, function()
		if l.Parent then
			local tw = TweenService:Create(l, TweenInfo.new(0.8), { TextTransparency = 1, TextStrokeTransparency = 1 })
			tw:Play()
			tw.Completed:Wait()
			l:Destroy()
		end
	end)
end

function Hud.setHints(primary: string?, secondary: string?)
	hintPrimary.Text = primary or ""
	hintSecondary.Text = secondary or ""
end

function Hud.setAction(text: string?, fraction: number?)
	Widgets.setBar(actionBar, text, fraction)
end

function Hud.setStatus(text: string?, fraction: number?)
	Widgets.setBar(statusBar, text, fraction)
end

function Hud.setTerror(intensity: number)
	for _, f in edges do
		f.BackgroundTransparency = 1 - math.clamp(intensity, 0, 1) * 0.75
	end
end

------------------------------------------------------------------------
-- Портреты выживших
------------------------------------------------------------------------

local STATE_INFO = {
	Healthy = { "ЗДОРОВ", Color3.fromRGB(220, 220, 220) },
	Injured = { "РАНЕН", Color3.fromRGB(255, 160, 60) },
	Downed = { "ПОВЕРЖЕН", Color3.fromRGB(255, 70, 70) },
	Carried = { "НЕСУТ", Color3.fromRGB(255, 70, 70) },
	Hooked = { "НА КРЮКЕ", Color3.fromRGB(255, 40, 40) },
	Trapped = { "В КАПКАНЕ", Color3.fromRGB(255, 120, 60) },
	Dead = { "ПОГИБ", Color3.fromRGB(110, 110, 110) },
	Left = { "ВЫШЕЛ", Color3.fromRGB(110, 110, 110) },
	Escaped = { "СБЕЖАЛ", Color3.fromRGB(110, 255, 140) },
}

local function stateKey(p: Player): string
	local status = p:GetAttribute("Status") or "Playing"
	if status ~= "Playing" then
		return status
	end
	if p:GetAttribute("Trapped") then
		return "Trapped"
	end
	local h = p:GetAttribute("Health") or 2
	return h == 2 and "Healthy" or (h == 1 and "Injured" or "Downed")
end

local function makePortrait(index: number)
	local frame = new("Frame", {
		Parent = portraitHolder,
		LayoutOrder = index,
		Size = UDim2.fromOffset(250, 42),
		BackgroundColor3 = Widgets.DARK,
		BackgroundTransparency = 0.3,
	}, { Widgets.corner(5) })
	local stripe = new("Frame", {
		Parent = frame,
		Size = UDim2.new(0, 5, 1, 0),
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.new(1, 1, 1),
	})
	local name = label({
		Parent = frame,
		Position = UDim2.fromOffset(14, 2),
		Size = UDim2.new(1, -60, 0, 20),
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local state = label({
		Parent = frame,
		Position = UDim2.fromOffset(14, 21),
		Size = UDim2.new(1, -60, 0, 18),
		TextSize = 12,
		Font = Widgets.FONT_REG,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local pips = {}
	for i = 1, 2 do
		table.insert(
			pips,
			new("Frame", {
				Parent = frame,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10 - (2 - i) * 18, 0.5, 0),
				Size = UDim2.fromOffset(12, 12),
				Rotation = 45,
				BorderSizePixel = 0,
				BackgroundColor3 = Color3.fromRGB(60, 60, 60),
			})
		)
	end
	local bar = new("Frame", {
		Parent = frame,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 5, 1, 0),
		Size = UDim2.new(0, 0, 0, 3),
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromRGB(220, 40, 40),
	})
	return { Frame = frame, Stripe = stripe, Name = name, State = state, Pips = pips, Bar = bar }
end

function Hud.updatePortraits(visible: boolean)
	local list = {}
	if visible then
		for _, p in Players:GetPlayers() do
			if p:GetAttribute("Role") == "Survivor" then
				table.insert(list, p)
			end
		end
		table.sort(list, function(a, b)
			return a.UserId < b.UserId
		end)
	end
	for i, p in list do
		local row = portraits[i] or makePortrait(i)
		portraits[i] = row
		row.Frame.Visible = true
		local key = stateKey(p)
		local info = STATE_INFO[key] or STATE_INFO.Healthy
		row.Name.Text = p.DisplayName .. (p == player and " (ты)" or "")
		local item = p:GetAttribute("Item")
		row.State.Text = info[1] .. (item and ("  •  " .. ItemDefs[item].Name) or "")
		row.State.TextColor3 = info[2]
		row.Stripe.BackgroundColor3 = info[2]
		local hooks = p:GetAttribute("HookCount") or 0
		for j, pip in row.Pips do
			pip.BackgroundColor3 = hooks >= j and Color3.fromRGB(220, 30, 30) or Color3.fromRGB(60, 60, 60)
		end
		local f = p:GetAttribute("HookProgress") or p:GetAttribute("BleedOut")
		row.Bar.Size = UDim2.new(f and (1 - f) or 0, -5, 0, 3)
	end
	for i = #list + 1, #portraits do
		portraits[i].Frame.Visible = false
	end
end

------------------------------------------------------------------------
-- Способность маньяка / предмет выжившего
------------------------------------------------------------------------

function Hud.updatePower()
	local role = player:GetAttribute("Role")
	if role == "Killer" then
		local def = KillerDefs.get(player:GetAttribute("KillerType"))
		powerPanel.Visible = true
		powerTitle.Text = def.Name .. " — " .. def.PowerName
		local count = player:GetAttribute("PowerCount")
		if def.Id == "Trapper" then
			powerInfo.Text = string.format("Капканы в руках: %d   •   %s", count or 0, def.PowerHint)
			Widgets.setBar(powerBar, nil, nil)
		elseif def.Id == "Huntress" then
			powerInfo.Text = string.format("Топоры: %d/%d   •   %s", count or 0, def.MaxHatchets, "ПКМ/Q")
			local charge = player:GetAttribute("PowerCharge") or 0
			Widgets.setBar(powerBar, nil, charge > 0 and charge or nil)
		else
			local state = player:GetAttribute("PowerState") or "Visible"
			local names = { Visible = "видим", Cloaking = "звонит в колокол...", Uncloaking = "проявляется...", Cloaked = "НЕВИДИМ" }
			powerInfo.Text = "Состояние: " .. (names[state] or state) .. "   •   ПКМ/Q"
			Widgets.setBar(powerBar, nil, nil)
		end
	elseif role == "Survivor" and player:GetAttribute("Item") then
		local item = player:GetAttribute("Item")
		local def = ItemDefs[item]
		powerPanel.Visible = true
		powerTitle.Text = def.Name
		powerInfo.Text = def.Hint
		local max = player:GetAttribute("ItemMax") or 1
		Widgets.setBar(powerBar, nil, (player:GetAttribute("ItemCharges") or 0) / max)
	else
		powerPanel.Visible = false
	end
end

------------------------------------------------------------------------
-- Эффекты экрана
------------------------------------------------------------------------

function Hud.blind(duration: number)
	blindOverlay.BackgroundTransparency = 0
	TweenService:Create(blindOverlay, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		BackgroundTransparency = 1,
	}):Play()
end

function Hud.intro(text: string, sub: string?)
	fadeOverlay.BackgroundTransparency = 0
	fadeText.Text = text .. (sub and ("\n" .. sub) or "")
	fadeText.TextTransparency = 0
	task.delay(2, function()
		TweenService:Create(fadeOverlay, TweenInfo.new(1.5), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(fadeText, TweenInfo.new(1.2), { TextTransparency = 1 }):Play()
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">LobbyUI</string>
              <string name="Source"><![CDATA[-- Меню лобби: очки крови, «хочу быть маньяком», выбор маньяка.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Widgets = require(script.Parent.Widgets)

local new, label = Widgets.new, Widgets.label
local player = Players.LocalPlayer

local LobbyUI = {}

local panel: Frame
local bloodLabel: TextLabel
local wantButton: TextButton
local cards = {}

local function refresh()
	local want = player:GetAttribute("WantKiller") == true
	wantButton.Text = want and "Хочу быть маньяком: ДА" or "Хочу быть маньяком: НЕТ"
	wantButton.BackgroundColor3 = want and Color3.fromRGB(110, 20, 20) or Color3.fromRGB(35, 25, 25)
	local choice = player:GetAttribute("KillerChoice") or "Trapper"
	for id, card in cards do
		local selected = id == choice
		card.Stroke.Color = selected and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(80, 40, 40)
		card.Stroke.Thickness = selected and 2 or 1
		card.Frame.BackgroundTransparency = selected and 0.1 or 0.35
	end
	bloodLabel.Text = "Очки крови: " .. tostring(player:GetAttribute("Bloodpoints") or 0)
end

function LobbyUI.mount(gui: ScreenGui)
	panel = new("Frame", {
		Name = "Lobby",
		Parent = gui,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, 0),
		Size = UDim2.fromOffset(300, 420),
		BackgroundColor3 = Widgets.DARK,
		BackgroundTransparency = 0.25,
		Visible = false,
	}, { Widgets.corner(8), Widgets.stroke(Widgets.RED, 1, 0.3) })
	label({
		Parent = panel,
		Position = UDim2.fromOffset(0, 8),
		Size = UDim2.new(1, 0, 0, 40),
		Text = "DEAD BY DAYLIGHT",
		Font = Widgets.FONT_TITLE,
		TextSize = 34,
		TextColor3 = Color3.fromRGB(200, 25, 25),
	})
	bloodLabel = label({
		Parent = panel,
		Position = UDim2.fromOffset(0, 48),
		Size = UDim2.new(1, 0, 0, 20),
		TextSize = 15,
		TextColor3 = Color3.fromRGB(255, 90, 90),
	})
	wantButton = Widgets.button({
		Parent = panel,
		Position = UDim2.fromOffset(16, 78),
		Size = UDim2.new(1, -32, 0, 36),
	})
	wantButton.Activated:Connect(function()
		Remotes.LobbyChoice:FireServer("WantKiller", not player:GetAttribute("WantKiller"))
	end)
	label({
		Parent = panel,
		Position = UDim2.fromOffset(16, 120),
		Size = UDim2.new(1, -32, 0, 20),
		Text = "Маньяк (если выпадет роль):",
		TextSize = 14,
		Font = Widgets.FONT_REG,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	for i, id in KillerDefs.Order do
		local def = KillerDefs[id]
		local stroke = Widgets.stroke(Color3.fromRGB(80, 40, 40), 1, 0)
		local frame = new("TextButton", {
			Parent = panel,
			Position = UDim2.fromOffset(16, 146 + (i - 1) * 88),
			Size = UDim2.new(1, -32, 0, 80),
			BackgroundColor3 = Color3.fromRGB(30, 18, 18),
			BackgroundTransparency = 0.35,
			Text = "",
			AutoButtonColor = true,
		}, { Widgets.corner(6), stroke })
		label({
			Parent = frame,
			Position = UDim2.fromOffset(10, 4),
			Size = UDim2.new(1, -20, 0, 22),
			Text = def.Name .. "  —  " .. def.PowerName,
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		label({
			Parent = frame,
			Position = UDim2.fromOffset(10, 26),
			Size = UDim2.new(1, -20, 0, 50),
			Text = def.Description,
			TextSize = 12,
			Font = Widgets.FONT_REG,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextColor3 = Color3.fromRGB(200, 200, 200),
		})
		frame.Activated:Connect(function()
			Remotes.LobbyChoice:FireServer("Killer", id)
		end)
		cards[id] = { Frame = frame, Stroke = stroke }
	end
	for _, attr in { "WantKiller", "KillerChoice", "Bloodpoints" } do
		player:GetAttributeChangedSignal(attr):Connect(refresh)
	end
	refresh()
end

function LobbyUI.setVisible(visible: boolean)
	panel.Visible = visible
end

return LobbyUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Results</string>
              <string name="Source"><![CDATA[-- Экран итогов раунда с очками крови по категориям.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)
local Widgets = require(script.Parent.Widgets)

local new, label = Widgets.new, Widgets.label

local Results = {}

local panel: Frame
local title: TextLabel
local reason: TextLabel
local list: Frame

local STATUS_TEXT = {
	Escaped = '<font color="#6eff8c">сбежал</font>',
	Dead = '<font color="#ff5050">принесён в жертву</font>',
	Left = '<font color="#aaaaaa">вышел</font>',
	Playing = '<font color="#ffdc5a">выжил</font>',
	Hooked = '<font color="#ff5050">на крюке</font>',
	Carried = '<font color="#ff5050">в руках маньяка</font>',
}

function Results.mount(gui: ScreenGui)
	panel = new("Frame", {
		Name = "Results",
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(620, 420),
		BackgroundColor3 = Color3.fromRGB(12, 8, 8),
		BackgroundTransparency = 0.08,
		Visible = false,
		ZIndex = 10,
	}, { Widgets.corner(10), Widgets.stroke(Color3.fromRGB(150, 20, 20), 2, 0) })
	title = label({
		Parent = panel,
		Position = UDim2.fromOffset(0, 10),
		Size = UDim2.new(1, 0, 0, 44),
		TextSize = 40,
		Font = Widgets.FONT_TITLE,
		TextColor3 = Color3.fromRGB(230, 50, 50),
		ZIndex = 11,
	})
	reason = label({
		Parent = panel,
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 0, 20),
		TextSize = 15,
		Font = Widgets.FONT_REG,
		ZIndex = 11,
	})
	list = new("ScrollingFrame", {
		Parent = panel,
		Position = UDim2.fromOffset(16, 84),
		Size = UDim2.new(1, -32, 1, -100),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 11,
	}, { new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
end

function Results.show(titleText: string, reasonText: string, rows, duration: number)
	title.Text = titleText
	reason.Text = reasonText
	for _, c in list:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	for i, row in rows do
		local frame = new("Frame", {
			Parent = list,
			LayoutOrder = i,
			Size = UDim2.new(1, -6, 0, 58),
			BackgroundColor3 = row.Role == "Killer" and Color3.fromRGB(45, 12, 12) or Color3.fromRGB(28, 24, 24),
			BackgroundTransparency = 0.2,
			ZIndex = 11,
		}, { Widgets.corner(6) })
		local role = row.Role == "Killer" and ("Маньяк: " .. KillerDefs.get(row.KillerType).Name) or "Выживший"
		local status = row.Role == "Killer" and "" or ("  —  " .. (STATUS_TEXT[row.Status] or row.Status))
		label({
			Parent = frame,
			Position = UDim2.fromOffset(12, 4),
			Size = UDim2.new(0.7, 0, 0, 22),
			RichText = true,
			Text = string.format("<b>%s</b>  (%s)%s", row.Name, role, status),
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 12,
		})
		label({
			Parent = frame,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 4),
			Size = UDim2.new(0.3, 0, 0, 22),
			Text = tostring(row.Total) .. " очков",
			TextSize = 16,
			TextColor3 = Color3.fromRGB(255, 80, 80),
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 12,
		})
		local parts = {}
		for _, s in row.Score or {} do
			table.insert(parts, s.Name .. ": " .. s.Value)
		end
		label({
			Parent = frame,
			Position = UDim2.fromOffset(12, 30),
			Size = UDim2.new(1, -24, 0, 20),
			Text = table.concat(parts, "   •   "),
			TextSize = 13,
			Font = Widgets.FONT_REG,
			TextColor3 = Color3.fromRGB(200, 200, 200),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 12,
		})
	end
	panel.Visible = true
	task.delay(duration, function()
		panel.Visible = false
	end)
end

return Results
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">SkillCheck</string>
              <string name="Source"><![CDATA[-- Круглая проверка навыка, как в Dead by Daylight.
-- Кольцо — круг с обводкой, зона — дуга из маленьких повёрнутых квадратиков,
-- стрелка — повёрнутая полоска. Положения считаются через тригонометрию.
local Widgets = require(script.Parent.Widgets)
local new = Widgets.new

local SkillCheck = {}

local SIZE = 170
local RADIUS = 70

export type Check = {
	Press: () -> (),
	Update: () -> (),
	Cancel: () -> (),
	Done: boolean,
}

local root: Frame
local zoneHolder: Frame
local needle: Frame
local active: Check? = nil

local function pointOnCircle(angleDeg: number, r: number): UDim2
	local a = math.rad(angleDeg)
	return UDim2.new(0.5, math.sin(a) * r, 0.5, -math.cos(a) * r)
end

function SkillCheck.mount(parent: Instance)
	root = new("Frame", {
		Name = "SkillCheck",
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.55),
		Size = UDim2.fromOffset(SIZE, SIZE),
		BackgroundTransparency = 1,
		Visible = false,
	})
	new("Frame", {
		Parent = root,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(RADIUS * 2, RADIUS * 2),
		BackgroundTransparency = 1,
	}, { Widgets.corner(RADIUS), Widgets.stroke(Color3.new(1, 1, 1), 3, 0.1) })
	Widgets.label({
		Parent = root,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(80, 30),
		Text = "ПРОБЕЛ",
		TextSize = 14,
		TextTransparency = 0.2,
	})
	zoneHolder = new("Frame", { Parent = root, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
	needle = new("Frame", {
		Parent = root,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(4, RADIUS + 8),
		BackgroundColor3 = Color3.fromRGB(255, 40, 40),
		BorderSizePixel = 0,
		ZIndex = 5,
	})
end

local function drawZone(startDeg: number, endDeg: number, color: Color3, thickness: number)
	local a = startDeg
	while a <= endDeg do
		new("Frame", {
			Parent = zoneHolder,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = pointOnCircle(a, RADIUS),
			Size = UDim2.fromOffset(4, thickness),
			Rotation = a,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = 3,
		})
		a += 2
	end
end

local function setNeedle(angleDeg: number)
	needle.Position = pointOnCircle(angleDeg, (RADIUS + 8) / 2)
	needle.Rotation = angleDeg
end

-- zoneStart (0..1) от сервера, duration — время полного оборота
function SkillCheck.start(zoneStart: number, duration: number, onResult: (string) -> ()): Check
	if active then
		active.Cancel()
	end
	zoneHolder:ClearAllChildren()
	local GREAT = 0.035
	local ZONE = 0.13
	drawZone(zoneStart * 360, (zoneStart + GREAT) * 360, Color3.new(1, 1, 1), 14)
	drawZone((zoneStart + GREAT) * 360, (zoneStart + ZONE) * 360, Color3.fromRGB(200, 200, 200), 8)
	setNeedle(0)
	root.Visible = true

	local startAt = os.clock() + 0.55
	local check: Check
	local function finish(result: string)
		if check.Done then
			return
		end
		check.Done = true
		if active == check then
			active = nil
			root.Visible = false
		end
		onResult(result)
	end
	local function position(): number
		return math.clamp((os.clock() - startAt) / duration, 0, 1)
	end
	check = {
		Done = false,
		Press = function()
			if os.clock() < startAt then
				finish("fail")
				return
			end
			local p = position()
			if p >= zoneStart and p < zoneStart + GREAT then
				finish("great")
			elseif p >= zoneStart and p <= zoneStart + ZONE then
				finish("good")
			else
				finish("fail")
			end
		end,
		Update = function()
			setNeedle(position() * 360)
			if os.clock() > startAt + duration then
				finish("fail")
			end
		end,
		Cancel = function()
			check.Done = true
			if active == check then
				active = nil
				root.Visible = false
			end
		end,
	}
	active = check
	return check
end

function SkillCheck.get(): Check?
	return active
end

return SkillCheck
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">Widgets</string>
              <string name="Source"><![CDATA[-- Маленькие помощники для создания интерфейса из кода.
local Widgets = {}

Widgets.FONT = Enum.Font.GothamBold
Widgets.FONT_REG = Enum.Font.Gotham
Widgets.FONT_TITLE = Enum.Font.Creepster
Widgets.RED = Color3.fromRGB(190, 25, 25)
Widgets.DARK = Color3.fromRGB(14, 10, 10)

function Widgets.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end
local new = Widgets.new

function Widgets.corner(radius: number?): UICorner
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 6) })
end

function Widgets.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return new("UIStroke", {
		Color = color or Color3.fromRGB(200, 200, 200),
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Widgets.label(props: { [string]: any }): TextLabel
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.Font = props.Font or Widgets.FONT
	props.TextColor3 = props.TextColor3 or Color3.new(1, 1, 1)
	props.TextStrokeTransparency = props.TextStrokeTransparency or 0.6
	return new("TextLabel", props)
end

export type Bar = { Frame: Frame, Fill: Frame, Label: TextLabel }

function Widgets.bar(parent: Instance, position: UDim2, size: UDim2, color: Color3?): Bar
	local bg = new("Frame", {
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		Size = size,
		BackgroundColor3 = Color3.fromRGB(15, 15, 15),
		BackgroundTransparency = 0.2,
		Visible = false,
	}, { Widgets.corner(3), Widgets.stroke(Color3.fromRGB(180, 180, 180), 1, 0.3) })
	local fill = new("Frame", {
		Parent = bg,
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = color or Color3.fromRGB(230, 230, 230),
		BorderSizePixel = 0,
	}, { Widgets.corner(3) })
	local text = Widgets.label({
		Parent = bg,
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.new(0, 0, 0, -22),
		TextSize = 16,
	})
	return { Frame = bg, Fill = fill, Label = text }
end

function Widgets.setBar(bar: Bar, text: string?, fraction: number?)
	if fraction then
		bar.Frame.Visible = true
		bar.Fill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
		bar.Label.Text = text or ""
	else
		bar.Frame.Visible = false
	end
end

function Widgets.button(props: { [string]: any }): TextButton
	props.BackgroundColor3 = props.BackgroundColor3 or Color3.fromRGB(35, 25, 25)
	props.TextColor3 = props.TextColor3 or Color3.new(1, 1, 1)
	props.Font = props.Font or Widgets.FONT
	props.TextSize = props.TextSize or 16
	props.AutoButtonColor = true
	local b = new("TextButton", props, { Widgets.corner(6), Widgets.stroke(Widgets.RED, 1, 0.3) })
	return b
end

return Widgets
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
