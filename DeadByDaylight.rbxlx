  <Item class="ServerScriptService" referent="24">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="25">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Folder" referent="26">
        <Properties>
          <string name="Name">Core</string>
        </Properties>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Actions</string>
            <string name="Source"><![CDATA[-- Реестр действий (ремонт, лечение, крюк, шкафчики и т.д.).
-- Системы регистрируют действие: Validate, Begin, Tick, Complete, Progress, OnSkillCheck.
-- Здесь — общий цикл: проверка дистанции, длительность, проверки навыка, атрибуты для UI.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local ActionInfo = require(ReplicatedStorage.Shared.ActionInfo)
local State = require(script.Parent.State)

local Actions = {}

export type ActionDef = {
	Validate: (data: any, target: Instance) -> boolean,
	Begin: ((data: any, target: Instance) -> ())?,
	Tick: ((data: any, target: Instance, dt: number) -> ())?,
	Complete: ((data: any, target: Instance) -> ())?,
	Progress: ((data: any, target: Instance) -> number?)?,
	OnSkillCheck: ((data: any, target: Instance, result: string) -> ())?,
	OnCancel: ((data: any, target: Instance) -> ())?,
	SkillChecks: boolean?,
	AllowHidden: boolean?,
	AllowTrapped: boolean?,
	AllowCarrying: boolean?,
	AllowDowned: boolean?,
}

Actions.Defs = {} :: { [string]: ActionDef }

function Actions.register(kind: string, def: ActionDef)
	assert(ActionInfo[kind], "нет ActionInfo для " .. kind)
	Actions.Defs[kind] = def
end

function Actions.cancel(data)
	local a = data.Action
	data.Action = nil
	data.PendingCheck = nil
	data.Player:SetAttribute("ActionName", nil)
	data.Player:SetAttribute("ActionProgress", nil)
	if a then
		local def = Actions.Defs[a.Kind]
		if def and def.OnCancel then
			def.OnCancel(data, a.Target)
		end
	end
end

-- Общие условия: может ли игрок вообще что-то делать
function Actions.canAct(data, def: ActionDef?): boolean
	if data.Status ~= "Playing" then
		return false
	end
	local t = State.now()
	if t < data.VaultUntil then
		return false
	end
	if data.Hidden and not (def and def.AllowHidden) then
		return false
	end
	if data.Role == "Survivor" then
		if data.Trapped and not (def and def.AllowTrapped) then
			return false
		end
		return data.Health > 0 or (def ~= nil and def.AllowDowned == true)
	end
	if data.Carrying and not (def and def.AllowCarrying) then
		return false
	end
	return t >= data.StunnedUntil and t >= data.BlindUntil and not data.Lunging and not data.PowerBusy
end

local function inRange(data, kind: string, target: Instance, extra: number): boolean
	local info = ActionInfo[kind]
	if info.Range >= 1000 then
		return true
	end
	local root = Util.getRoot(data.Player)
	local pos = Util.objectPosition(target)
	return root ~= nil and pos ~= nil and Util.flatDist(root.Position, pos) <= info.Range + extra
end

local function roleAllowed(data, kind: string): boolean
	local info = ActionInfo[kind]
	return info.Role == "Any" or info.Role == data.Role
end

-- Начать действие (с клиента или из другой системы)
function Actions.start(data, kind: string, target: Instance): boolean
	local def = Actions.Defs[kind]
	local info = ActionInfo[kind]
	if not def or not info or not State.Active then
		return false
	end
	if data.Action or not roleAllowed(data, kind) or not Actions.canAct(data, def) then
		return false
	end
	if not inRange(data, kind, target, 1) or not def.Validate(data, target) then
		return false
	end
	if info.Instant then
		if def.Begin then
			def.Begin(data, target)
		end
		return true
	end
	data.Action = { Kind = kind, Target = target, Time = 0 }
	data.NextCheckRoll = State.now() + 1
	if def.Begin then
		def.Begin(data, target)
	end
	return true
end

------------------------------------------------------------------------
-- Проверки навыка
------------------------------------------------------------------------

local skillCheckCounter = 0
local rng = Random.new()

local function applySkillCheck(data, result: string)
	data.PendingCheck = nil
	local a = data.Action
	if not a then
		return
	end
	local def = Actions.Defs[a.Kind]
	if def and def.OnSkillCheck then
		def.OnSkillCheck(data, a.Target, result)
	end
end

local function tickSkillChecks(data, t: number)
	if data.PendingCheck then
		if t > data.PendingCheck.Deadline then
			applySkillCheck(data, "fail")
		end
		return
	end
	if t < data.NextCheckRoll then
		return
	end
	data.NextCheckRoll = t + 1
	local chance = Config.SkillCheckChancePerSecond
	if State.HexRuin then
		chance *= 1.3
	end
	if rng:NextNumber() < chance then
		skillCheckCounter += 1
		local zone = rng:NextNumber(0.45, 0.8)
		data.PendingCheck = { Id = skillCheckCounter, Deadline = t + Config.SkillCheckDuration + 2 }
		Remotes.SkillCheck:FireClient(data.Player, skillCheckCounter, zone)
	end
end

------------------------------------------------------------------------
-- Цикл
------------------------------------------------------------------------

function Actions.update(dt: number)
	local t = State.now()
	for _, data in State.Participants do
		local a = data.Action
		if not a then
			if data.PendingCheck then
				data.PendingCheck = nil
			end
			continue
		end
		local def = Actions.Defs[a.Kind]
		local info = ActionInfo[a.Kind]
		if not (Actions.canAct(data, def) and inRange(data, a.Kind, a.Target, 2) and def.Validate(data, a.Target)) then
			Actions.cancel(data)
			continue
		end
		a.Time += dt
		if def.Tick then
			def.Tick(data, a.Target, dt)
		end
		if data.Action ~= a then
			continue
		end
		local progress
		if info.Duration then
			progress = a.Time / info.Duration
			if progress >= 1 then
				Actions.cancel(data)
				if def.Complete then
					def.Complete(data, a.Target)
				end
				continue
			end
		elseif def.Progress then
			progress = def.Progress(data, a.Target)
		end
		data.Player:SetAttribute("ActionName", a.Kind)
		data.Player:SetAttribute("ActionProgress", progress)
		if def.SkillChecks then
			tickSkillChecks(data, t)
		end
	end
end

Remotes.BeginAction.OnServerEvent:Connect(function(player, kind, target)
	local data = State.get(player)
	if data and typeof(kind) == "string" and typeof(target) == "Instance" then
		Actions.start(data, kind, target)
	end
end)

Remotes.EndAction.OnServerEvent:Connect(function(player)
	local data = State.get(player)
	if data and data.Action then
		local info = ActionInfo[data.Action.Kind]
		-- Предмет и способность отпускаются своими кнопками
		if info and info.Key ~= "Item" and info.Key ~= "Power" then
			Actions.cancel(data)
		end
	end
end)

Remotes.SkillCheck.OnServerEvent:Connect(function(player, id, result)
	local data = State.get(player)
	if not data or not data.PendingCheck or data.PendingCheck.Id ~= id then
		return
	end
	if result ~= "great" and result ~= "good" then
		result = "fail"
	end
	applySkillCheck(data, result)
end)

return Actions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Characters</string>
            <string name="Source"><![CDATA[-- Персонажи R6: появление, внешний вид маньяков, группы столкновений.
-- Персонажи создаются вручную (CharacterAutoLoads = false), чтобы гарантировать R6
-- и полностью управлять анимациями (стандартный Animate удаляется).
local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)
local Util = require(ReplicatedStorage.Shared.Util)
local MapBuilder = require(script.Parent.Parent.Map.MapBuilder)
local KillerGear = require(script.Parent.Parent.Map.Art.KillerGear)

local Characters = {}

Characters.GROUP_ROOT = "DBDChars"
Characters.GROUP_LIMBS = "DBDLimbs"
Characters.GROUP_CARRIED = "DBDCarried"
Characters.GROUP_SEATS = "DBDSeats"

local function setupGroups()
	for _, g in { Characters.GROUP_ROOT, Characters.GROUP_LIMBS, Characters.GROUP_CARRIED, Characters.GROUP_SEATS } do
		PhysicsService:RegisterCollisionGroup(g)
	end
	-- Конечности не сталкиваются ни с чем: позы (ползание, крюк, перелезание) двигают их свободно.
	-- Сталкивается только HumanoidRootPart.
	for _, other in { "Default", Characters.GROUP_ROOT, Characters.GROUP_LIMBS, Characters.GROUP_CARRIED } do
		PhysicsService:CollisionGroupSetCollidable(Characters.GROUP_LIMBS, other, false)
		PhysicsService:CollisionGroupSetCollidable(Characters.GROUP_CARRIED, other, false)
	end
	-- Брёвна-сиденья в лобби «касаются» ног (у ног CanCollide = false, так что они не толкаются),
	-- иначе Seat не сработает: HumanoidRootPart висит выше бревна.
	PhysicsService:CollisionGroupSetCollidable(Characters.GROUP_SEATS, Characters.GROUP_LIMBS, true)
end
setupGroups()

-- Вызывается при смерти персонажа (Match подставляет свой обработчик)
Characters.OnDied = nil :: ((Player, Model) -> boolean)?

local descriptionCache = {}

local SKIN = {
	Color3.fromRGB(234, 184, 146),
	Color3.fromRGB(204, 142, 105),
	Color3.fromRGB(160, 110, 80),
	Color3.fromRGB(105, 70, 50),
}
local CLOTH = {
	Color3.fromRGB(60, 80, 110),
	Color3.fromRGB(110, 50, 45),
	Color3.fromRGB(70, 90, 60),
	Color3.fromRGB(120, 110, 90),
	Color3.fromRGB(50, 50, 55),
}

local function randomDescription(): HumanoidDescription
	local d = Instance.new("HumanoidDescription")
	local skin = SKIN[math.random(#SKIN)]
	local shirt = CLOTH[math.random(#CLOTH)]
	local pants = CLOTH[math.random(#CLOTH)]:Lerp(Color3.new(0, 0, 0), 0.3)
	d.HeadColor = skin
	d.LeftArmColor = skin
	d.RightArmColor = skin
	d.TorsoColor = shirt
	d.LeftLegColor = pants
	d.RightLegColor = pants
	return d
end

function Characters.getDescription(player: Player): HumanoidDescription
	local cached = descriptionCache[player]
	if cached then
		return cached:Clone()
	end
	local desc
	if player.UserId > 0 then
		local ok, result = pcall(function()
			return Players:GetHumanoidDescriptionFromUserId(player.UserId)
		end)
		if ok then
			desc = result
		end
	end
	desc = desc or randomDescription()
	descriptionCache[player] = desc
	return desc:Clone()
end

------------------------------------------------------------------------
-- Создание и появление
------------------------------------------------------------------------

local function stripDefaults(char: Model)
	for _, d in char:GetDescendants() do
		if d:IsA("Animator") or ((d:IsA("LocalScript") or d:IsA("Script")) and d.Name == "Animate") then
			d:Destroy()
		end
	end
end

function Characters.setCollision(char: Model, group: string?)
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") then
			if group then
				d.CollisionGroup = group
			elseif d.Name == "HumanoidRootPart" then
				d.CollisionGroup = Characters.GROUP_ROOT
				d.CanCollide = true
			else
				d.CollisionGroup = Characters.GROUP_LIMBS
			end
		end
	end
end

function Characters.build(player: Player, role: string?, killerType: string?): Model
	local desc
	local def
	if role == "Killer" then
		def = KillerDefs.get(killerType)
		desc = Instance.new("HumanoidDescription")
	else
		desc = Characters.getDescription(player)
	end
	local ok, char = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R6)
	end)
	if not ok or not char then
		warn("[DBD] Не удалось создать персонажа из описания: " .. tostring(char))
		char = Players:CreateHumanoidModelFromDescription(randomDescription(), Enum.HumanoidRigType.R6)
	end
	char.Name = player.Name
	stripDefaults(char)
	if def then
		KillerGear.dress(char, def)
		if def.Scale ~= 1 then
			pcall(function()
				char:ScaleTo(def.Scale)
			end)
		end
	end
	Characters.setCollision(char)
	char:SetAttribute("Role", role)
	char:SetAttribute("KillerType", def and def.Id or nil)
	char:SetAttribute("AnimSeq", 0)
	CollectionService:AddTag(char, "DBDChar")
	return char
end

function Characters.spawn(player: Player, cframe: CFrame, role: string?, killerType: string?): Model?
	if not player.Parent then
		return nil
	end
	local old = player.Character
	local char = Characters.build(player, role, killerType)
	if not player.Parent then
		char:Destroy()
		return nil
	end
	if old then
		old:Destroy()
	end
	char:PivotTo(cframe)
	char.Parent = workspace
	player.Character = char

	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.BreakJointsOnDeath = false
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		hum.UseJumpPower = true
		if role then
			hum.JumpPower = 0
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		else
			hum.JumpPower = 40
			hum.WalkSpeed = 14
		end
		hum.Died:Connect(function()
			local handled = Characters.OnDied and Characters.OnDied(player, char)
			if not handled then
				task.wait(3)
				if player.Parent and player.Character == char then
					Characters.spawnLobby(player)
				end
			end
		end)
	end
	return char
end

function Characters.spawnLobby(player: Player): Model?
	return Characters.spawn(player, MapBuilder.LobbySpawn(), nil, nil)
end

Players.PlayerRemoving:Connect(function(player)
	descriptionCache[player] = nil
end)

return Characters
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Lifecycle</string>
            <string name="Source"><![CDATA[-- Выбывание из раунда (смерть, побег, выход) и «отцепление» от объектов
-- (крюк, шкафчик, капкан, руки маньяка). Системы регистрируют свои обработчики,
-- чтобы не было циклических require.
local State = require(script.Parent.State)
local Actions = require(script.Parent.Actions)
local Characters = require(script.Parent.Characters)

local Lifecycle = {}

local detachers = {} :: { (data: any) -> () }

-- fn(data) должна освободить игрока от своего объекта, если он к нему привязан
function Lifecycle.addDetach(fn: (data: any) -> ())
	table.insert(detachers, fn)
end

function Lifecycle.detach(data)
	for _, fn in detachers do
		fn(data)
	end
end

-- Убрать выжившего из игры. status = "Dead" / "Escaped" / "Left"
function Lifecycle.remove(data, status: string, text: string?, color: Color3?)
	if not State.isInGame(data) then
		return
	end
	Lifecycle.detach(data)
	Actions.cancel(data)
	data.Status = status
	data.Player:SetAttribute("Status", status)
	if text then
		State.notifyAll(text, color)
	end
	local player = data.Player
	if status ~= "Left" then
		task.delay(status == "Dead" and 1.8 or 0.3, function()
			if player.Parent and State.Participants[player] == data then
				Characters.spawnLobby(player)
			end
		end)
	end
end

return Lifecycle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Lobby</string>
            <string name="Source"><![CDATA[-- Выбор в лобби: «хочу быть маньяком» и выбор маньяка.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)

local Lobby = {}

local function init(player: Player)
	player:SetAttribute("WantKiller", false)
	player:SetAttribute("KillerChoice", "Trapper")
end

Players.PlayerAdded:Connect(init)
for _, p in Players:GetPlayers() do
	init(p)
end

Remotes.LobbyChoice.OnServerEvent:Connect(function(player, key, value)
	if key == "WantKiller" and typeof(value) == "boolean" then
		player:SetAttribute("WantKiller", value)
	elseif key == "Killer" and typeof(value) == "string" and KillerDefs[value] and table.find(KillerDefs.Order, value) then
		player:SetAttribute("KillerChoice", value)
	end
end)

-- Выбирает маньяка: сначала среди желающих, иначе среди всех
function Lobby.pickKiller(list: { Player }): (Player?, string)
	if #list <= 1 then
		return nil, "Trapper"
	end
	local wanting = {}
	for _, p in list do
		if p:GetAttribute("WantKiller") then
			table.insert(wanting, p)
		end
	end
	local pool = #wanting > 0 and wanting or list
	local killer = pool[math.random(1, #pool)]
	return killer, killer:GetAttribute("KillerChoice") or "Trapper"
end

return Lobby
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Match</string>
            <string name="Source"><![CDATA[-- Один раунд: старт, главный цикл, конец.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)
local Server = script.Parent.Parent
local State = require(script.Parent.State)
local Actions = require(script.Parent.Actions)
local Lifecycle = require(script.Parent.Lifecycle)
local Scoring = require(script.Parent.Scoring)
local Characters = require(script.Parent.Characters)
local MapBuilder = require(Server.Map.MapBuilder)
local Powers = require(Server.Powers)
local Systems = Server.Systems
local Health = require(Systems.Health)
local Carry = require(Systems.Carry)
local Combat = require(Systems.Combat)
local Generators = require(Systems.Generators)
local Exits = require(Systems.Exits)
require(Systems.Obstacles)
require(Systems.Lockers)
local Totems = require(Systems.Totems)
local Items = require(Systems.Items)
local Crows = require(Systems.Crows)
local Chase = require(Systems.Chase)

local Match = {}

local PLAYER_ATTRS = {
	"Role",
	"KillerType",
	"Status",
	"Health",
	"HookCount",
	"HookProgress",
	"BleedOut",
	"Wiggle",
	"ActionName",
	"ActionProgress",
	"Stunned",
	"Blinded",
	"Carrying",
	"Running",
	"Crouching",
	"Hidden",
	"Trapped",
	"Chase",
	"Item",
	"ItemCharges",
	"ItemMax",
	"ItemActive",
	"PowerCount",
	"PowerCharge",
	"PowerState",
	"Cloaked",
	"TerrorRadius",
}

local function newData(player: Player, role: string, killerType: string?)
	local def = killerType and KillerDefs.get(killerType)
	return {
		Player = player,
		Role = role,
		KillerType = killerType,
		Scale = def and def.Scale or 1,
		Health = 2,
		Status = "Playing",
		HookCount = 0,
		HookTimer = 0,
		BleedOut = 0,
		Wiggle = 0,
		HealProgress = 0,
		Sprinting = false,
		Crouching = false,
		BoostUntil = 0,
		StunnedUntil = 0,
		BlindUntil = 0,
		AttackReadyAt = 0,
		LungeUntil = 0,
		Lunging = false,
		SlowUntil = 0,
		VaultUntil = 0,
		NextCheckRoll = 0,
		Score = {},
	}
end

function Match.isActive(): boolean
	return State.Active
end

function Match.Start(playerList: { Player }, killerPlayer: Player?, killerType: string)
	table.clear(State.Participants)
	State.Killer = nil
	State.GensDone = 0
	State.GatesPowered = false
	State.EndgameDeadline = nil
	State.StartTime = State.now()
	State.SoloTest = killerPlayer == nil
	State.HexRuin = false
	Generators.reset()
	State.Map = MapBuilder.BuildMap()

	for _, player in playerList do
		local isKiller = player == killerPlayer
		local data = newData(player, isKiller and "Killer" or "Survivor", isKiller and killerType or nil)
		State.Participants[player] = data
		if isKiller then
			State.Killer = data
		end
	end

	State.InitialSurvivors = #State.survivors()
	local def = KillerDefs.get(killerType)
	State.setGame("GensLeft", Config.GeneratorsRequired)
	State.setGame("EndGame", false)
	State.setGame("EndGameTimer", Config.EndGameCollapseTime)
	State.setGame("KillerName", State.Killer and State.Killer.Player.DisplayName or "—")
	State.setGame("KillerType", State.Killer and def.Id or nil)

	-- Появление персонажей
	local map = State.Map
	local sIndex = 0
	for player, data in State.Participants do
		player:SetAttribute("Role", data.Role)
		player:SetAttribute("KillerType", data.KillerType)
		player:SetAttribute("Status", data.Status)
		player:SetAttribute("Health", data.Health)
		local cf
		if data.Role == "Killer" then
			cf = CFrame.lookAt(map.KillerSpawn, map.SurvivorSpawn * Vector3.new(1, 0, 1) + Vector3.new(0, map.KillerSpawn.Y, 0))
		else
			sIndex += 1
			local angle = sIndex * math.pi / 2
			local pos = map.SurvivorSpawn + Vector3.new(math.cos(angle) * 4, 0, math.sin(angle) * 4)
			cf = CFrame.lookAt(pos, map.SurvivorSpawn)
		end
		local char = Characters.spawn(player, cf, data.Role, data.KillerType)
		if not char then
			data.Status = "Left"
		end
	end

	if State.Killer then
		Powers.call(State.Killer, "Setup")
	end
	Totems.setup()
	Crows.setup()
	State.Active = true
	State.setGame("Phase", "InGame")

	for player, data in State.Participants do
		State.effect(player, "Intro", {
			Role = data.Role,
			KillerName = def.Name,
		})
		if data.Role == "Killer" then
			State.notify(player, "Ты — " .. def.Name .. ". " .. def.PowerHint, State.RED)
		else
			State.notify(player, "Ты — ВЫЖИВШИЙ. Почини генераторы и сбеги!", State.GREEN)
		end
	end
end

function Match.End(reason: string?)
	if not State.Active then
		return
	end
	State.Active = false

	local rows = {}
	local escaped, dead = 0, 0
	for player, data in State.Participants do
		if data.Role == "Survivor" then
			if data.Status == "Escaped" then
				escaped += 1
			elseif data.Status == "Dead" or data.Status == "Left" then
				dead += 1
			end
		end
		local total = Scoring.total(data)
		table.insert(rows, {
			Name = player.DisplayName,
			Role = data.Role,
			KillerType = data.KillerType,
			Status = data.Status,
			Score = Scoring.summary(data),
			Total = total,
		})
		Scoring.commit(player, total)
	end
	table.sort(rows, function(a, b)
		if a.Role ~= b.Role then
			return a.Role == "Killer"
		end
		return a.Total > b.Total
	end)
	local title
	if State.SoloTest then
		title = escaped > 0 and "Тестовый раунд: ты сбежал!" or "Тестовый раунд окончен"
	elseif escaped > dead then
		title = "Победа выживших!"
	elseif dead > escaped then
		title = "Победа маньяка!"
	else
		title = "Ничья"
	end
	Remotes.Results:FireAllClients(title, reason or "", rows)

	if State.Killer then
		Powers.call(State.Killer, "Cleanup")
	end
	for player, data in State.Participants do
		Lifecycle.detach(data)
		Actions.cancel(data)
		Items.cleanup(data)
		local root = State.getRoot(player)
		if root then
			root.Anchored = false
		end
		for _, attr in PLAYER_ATTRS do
			player:SetAttribute(attr, nil)
		end
		if player.Parent then
			task.spawn(Characters.spawnLobby, player)
		end
	end
	table.clear(State.Participants)
	State.Killer = nil
	State.setGame("EndGame", false)
	State.setGame("HexRuin", false)
	if State.Map then
		State.Map.Model:Destroy()
		State.Map = nil
	end
end

function Match.OnPlayerRemoving(player: Player)
	local data = State.get(player)
	if not data then
		return
	end
	Lifecycle.detach(data)
	Actions.cancel(data)
	if data.Status ~= "Dead" and data.Status ~= "Escaped" then
		data.Status = "Left"
		State.notifyAll(player.DisplayName .. " покинул игру", State.YELLOW)
	end
end

-- Смерть персонажа (например, кнопка «Reset»)
Characters.OnDied = function(player: Player, char: Model): boolean
	local data = State.get(player)
	if not State.Active or not data or player.Character ~= char then
		return false
	end
	if data.Role == "Killer" then
		data.Status = "Dead"
		return false
	end
	if State.isInGame(data) then
		Lifecycle.remove(data, "Dead", player.DisplayName .. " погиб", State.RED)
		return true
	end
	return false
end

Remotes.Sprint.OnServerEvent:Connect(function(player, value)
	local data = State.get(player)
	if data then
		data.Sprinting = value == true
	end
end)

Remotes.Crouch.OnServerEvent:Connect(function(player, value)
	local data = State.get(player)
	if data and data.Role == "Survivor" then
		data.Crouching = value == true
	end
end)

------------------------------------------------------------------------
-- Скорость и атрибуты
------------------------------------------------------------------------

local function survivorSpeed(data, t: number): number
	if data.Action or t < data.VaultUntil or data.Trapped or data.Hidden then
		return 0
	end
	if data.Health == 0 then
		return Config.SurvivorCrawlSpeed
	end
	if t < data.BoostUntil then
		return Config.SurvivorHitBoostSpeed
	end
	if data.Crouching then
		return Config.SurvivorCrouchSpeed
	end
	return data.Sprinting and Config.SurvivorSprintSpeed or Config.SurvivorWalkSpeed
end

local function killerSpeed(data, t: number): number
	if t < data.StunnedUntil or data.Action or t < data.VaultUntil then
		return 0
	end
	if data.Lunging then
		return Config.KillerLungeSpeed
	end
	if t < data.SlowUntil then
		return Config.AttackSlowSpeed
	end
	if t < data.BlindUntil then
		return 8
	end
	local override = Powers.call(data, "SpeedOverride", t)
	if override then
		return override
	end
	if data.Carrying then
		return Config.KillerCarrySpeed
	end
	return KillerDefs.get(data.KillerType).Speed
end

local function syncPlayer(player: Player, data, t: number)
	local hum = State.getHumanoid(player)
	local root = State.getRoot(player)
	if hum and State.isInGame(data) then
		hum.WalkSpeed = data.Role == "Killer" and killerSpeed(data, t) or survivorSpeed(data, t)
	end
	local running = false
	if data.Role == "Survivor" and data.Status == "Playing" and data.Health > 0 and data.Sprinting and not data.Crouching and root then
		running = (root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude > 11
	end
	player:SetAttribute("Status", data.Status)
	player:SetAttribute("Health", data.Health)
	player:SetAttribute("HookCount", data.HookCount)
	player:SetAttribute("HookProgress", data.Status == "Hooked" and data.HookTimer / Config.HookStageTime or nil)
	player:SetAttribute("BleedOut", (data.Status == "Playing" and data.Health == 0) and data.BleedOut / Config.BleedOutTime or nil)
	player:SetAttribute("Wiggle", data.Status == "Carried" and data.Wiggle or nil)
	player:SetAttribute("Stunned", t < data.StunnedUntil)
	player:SetAttribute("Blinded", t < data.BlindUntil)
	player:SetAttribute("Carrying", data.Carrying ~= nil)
	player:SetAttribute("Running", running)
	player:SetAttribute("Crouching", data.Crouching and data.Role == "Survivor" and data.Health > 0)
	if data.Role == "Killer" then
		local tr = Powers.call(data, "TerrorRadius")
		player:SetAttribute("TerrorRadius", tr or KillerDefs.get(data.KillerType).TerrorRadius)
	end
end

function Match.Update(dt: number)
	if not State.Active then
		return
	end
	local t = State.now()

	Actions.update(dt)
	Combat.update(dt)
	Carry.update(dt)
	Health.update(dt)
	Generators.update(dt)
	Exits.update(dt)
	Powers.update(dt)
	Items.update(dt)
	Crows.update(dt)
	Chase.update(dt)

	for player, data in State.Participants do
		syncPlayer(player, data, t)
	end

	-- Условия окончания раунда
	local k = State.Killer
	if State.remainingSurvivors() == 0 then
		Match.End()
	elseif not State.SoloTest and (not k or k.Status ~= "Playing" or not k.Player.Parent) then
		Match.End("Маньяк выбыл из игры")
	elseif t - State.StartTime > Config.MaxRoundTime then
		Match.End("Время вышло")
	end
end

return Match
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Scoring</string>
            <string name="Source"><![CDATA[-- Очки крови: 4 категории у выживших и 4 у маньяка, сохраняются в DataStore.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)

local Scoring = {}

Scoring.SurvivorCategories = { "Objectives", "Survival", "Altruism", "Boldness" }
Scoring.KillerCategories = { "Brutality", "Deviousness", "Hunter", "Sacrifice" }
Scoring.CategoryNames = {
	Objectives = "Цели",
	Survival = "Выживание",
	Altruism = "Альтруизм",
	Boldness = "Смелость",
	Brutality = "Жестокость",
	Deviousness = "Коварство",
	Hunter = "Охота",
	Sacrifice = "Жертвоприношение",
}

local store
if Config.SaveBloodpoints then
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("DBD_Bloodpoints_v1")
	end)
	if ok then
		store = result
	end
end

-- Добавить очки. label = nil — без всплывающей надписи
function Scoring.add(player: Player?, category: string, amount: number, label: string?)
	local data = State.get(player)
	if not data or not player then
		return
	end
	data.Score = data.Score or {}
	local current = data.Score[category] or 0
	local added = math.min(amount, Config.ScoreCategoryCap - current)
	if added <= 0 then
		return
	end
	data.Score[category] = current + added
	if label then
		Remotes.Score:FireClient(player, label, math.floor(added + 0.5), category)
	end
end

function Scoring.total(data): number
	local sum = 0
	for _, v in data.Score or {} do
		sum += v
	end
	return math.floor(sum)
end

function Scoring.summary(data)
	local cats = data.Role == "Killer" and Scoring.KillerCategories or Scoring.SurvivorCategories
	local out = {}
	for _, c in cats do
		table.insert(out, { Name = Scoring.CategoryNames[c], Value = math.floor((data.Score or {})[c] or 0) })
	end
	return out
end

function Scoring.load(player: Player)
	player:SetAttribute("Bloodpoints", 0)
	if not store then
		return
	end
	task.spawn(function()
		local ok, value = pcall(function()
			return store:GetAsync("u" .. player.UserId)
		end)
		if ok and typeof(value) == "number" and player.Parent then
			player:SetAttribute("Bloodpoints", value)
		end
	end)
end

function Scoring.commit(player: Player, amount: number)
	if amount <= 0 or not player.Parent then
		return
	end
	local current: number = (player:GetAttribute("Bloodpoints") :: number?) or 0
	player:SetAttribute("Bloodpoints", current + amount)
	if not store or player.UserId <= 0 then
		return
	end
	task.spawn(function()
		pcall(function()
			store:UpdateAsync("u" .. player.UserId, function(old)
				local prev: number = if typeof(old) == "number" then old else 0
				return prev + amount
			end)
		end)
	end)
end

Players.PlayerAdded:Connect(Scoring.load)
for _, p in Players:GetPlayers() do
	Scoring.load(p)
end

return Scoring
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">SoundLibrary</string>
            <string name="Source"><![CDATA[-- Поиск настоящих звуков в публичной библиотеке Creator Store (AssetService:SearchAudioAsync).
-- Звуки и музыка Roblox из этой библиотеки бесплатны для любой игры.
-- Для каждого слота Sounds.List с полем Search ищем подходящие звуки и публикуем найденные ID
-- в ReplicatedStorage.SoundLibrary: атрибут <слот> = "rbxassetid://1,rbxassetid://2",
-- атрибут Version растёт при каждой публикации, Status = Searching / Ready / Offline / Disabled.
-- Поиск идёт в фоне и никогда не задерживает старт игры. Без доступа к поиску (Studio без сети,
-- эмулятор тестов) ничего не публикуется — клиенты играют встроенные звуки.
local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Sounds = require(ReplicatedStorage.Shared.Sounds)

local SoundLibrary = {}

export type Candidate = {
	Id: string,
	Title: string,
	Duration: number?,
	Endorsed: boolean,
	Roblox: boolean, -- загружен самим Roblox
	Rank: number, -- место в выдаче поиска
}

-- Названия полей результата не задокументированы — пробуем несколько вариантов
local ID_KEYS = { "Id", "AssetId", "id", "assetId", "ID" }
local TITLE_KEYS = { "Title", "Name", "title", "name", "DisplayName" }
local DURATION_KEYS = { "Duration", "duration", "Length", "TimeLength" }
local ENDORSED_KEYS = { "IsEndorsed", "Endorsed", "isEndorsed", "endorsed" }

-- Названия, с которыми звук точно не подходит хоррору (совпадение с начала слова)
local BAD_WORDS = {
	"meme", "earrape", "ear rape", "bass boost", "remix", "funny", "oof", "phonk",
	"tiktok", "lyrics", "nightcore", "troll", "cartoon", "8 bit", "8-bit",
}
local SFX_BAD_WORDS = { "song", "music", "beat drop" }

local ROBLOX_USER_ID = 1

local loggedKeys = false
local warnedFormat = false
local started = false
local queryCache: { [string]: { any } } = {}

local function field(r: { [any]: any }, keys: { string }): any
	for _, k in keys do
		local v = r[k]
		if v ~= nil then
			return v
		end
	end
	return nil
end

local function normalizeId(v: any): string?
	if type(v) == "number" then
		return v > 0 and ("rbxassetid://" .. string.format("%d", v)) or nil
	elseif type(v) == "string" then
		local digits = v:match("^rbxassetid://(%d+)$") or v:match("^(%d+)$")
		return digits and ("rbxassetid://" .. digits) or nil
	end
	return nil
end

local function isRoblox(r: { [any]: any }): boolean
	local creator = r.Creator or r.creator
	if type(creator) == "table" then
		local id = tonumber(creator.Id or creator.id or creator.CreatorTargetId or creator.UserId)
		local name = creator.Name or creator.name
		if id == ROBLOX_USER_ID or name == "Roblox" then
			return true
		end
	end
	return tonumber(r.CreatorId or r.CreatorTargetId) == ROBLOX_USER_ID or r.CreatorName == "Roblox"
end

-- Читает один результат поиска; nil — если у него нет понятного ID
function SoundLibrary.readResult(r: any, rank: number): Candidate?
	if type(r) ~= "table" then
		return nil
	end
	local id = normalizeId(field(r, ID_KEYS))
	if not id then
		return nil
	end
	local endorsed = field(r, ENDORSED_KEYS)
	return {
		Id = id,
		Title = tostring(field(r, TITLE_KEYS) or ""),
		Duration = tonumber(field(r, DURATION_KEYS)),
		Endorsed = endorsed == true,
		Roblox = isRoblox(r),
		Rank = rank,
	}
end

-- Есть ли в названии слово, начинающееся с одного из words ("oof" не задевает "roof")
local function hasWord(title: string, words: { string }): boolean
	for _, w in words do
		if title:find("%f[%w]" .. (w:gsub("%p", "%%%0"))) then
			return true
		end
	end
	return false
end

-- Оценка кандидата; nil — не подходит (длительность, плохие слова)
function SoundLibrary.score(c: Candidate, spec: Sounds.Search, keyword: string, total: number): number?
	local d = c.Duration
	if d and ((spec.Min and d < spec.Min) or (spec.Max and d > spec.Max)) then
		return nil
	end
	local title = c.Title:lower()
	if hasWord(title, BAD_WORDS) or (spec.Avoid and hasWord(title, spec.Avoid)) then
		return nil
	end
	if not spec.Music and hasWord(title, SFX_BAD_WORDS) then
		return nil
	end
	local s = 0
	if c.Endorsed then
		s += 6
	end
	if c.Roblox then
		s += 4
	end
	for word in keyword:lower():gmatch("%a+") do
		if title:find(word, 1, true) then
			s += 1.5
		end
	end
	if not d then
		s -= 1 -- длительность неизвестна: чуть ниже проверенных
	end
	-- Порядок выдачи поиска (релевантность)
	return s + (1 - (c.Rank - 1) / math.max(total, 1)) * 2
end

-- Лучшие кандидаты из страницы результатов (без повторов ID), лучший первым
function SoundLibrary.pick(results: { any }, spec: Sounds.Search, keyword: string, count: number): { Candidate }
	local scored = {}
	for i, r in results do
		local c = SoundLibrary.readResult(r, i)
		if c then
			local s = SoundLibrary.score(c, spec, keyword, #results)
			if s then
				table.insert(scored, { C = c, S = s })
			end
		end
	end
	table.sort(scored, function(a, b)
		if a.S ~= b.S then
			return a.S > b.S
		end
		return a.C.Rank < b.C.Rank
	end)
	local out, seen = {}, {}
	for _, e in scored do
		if #out >= count then
			break
		end
		if not seen[e.C.Id] then
			seen[e.C.Id] = true
			table.insert(out, e.C)
		end
	end
	return out
end

local function logFormat(results: { any })
	local first = results[1]
	if loggedKeys or type(first) ~= "table" then
		return
	end
	loggedKeys = true
	local keys = {}
	for k in first do
		table.insert(keys, tostring(k))
	end
	table.sort(keys)
	if not SoundLibrary.readResult(first, 1) and not warnedFormat then
		warnedFormat = true
		warn("[SoundLibrary] не удалось прочитать ID результата поиска, поля: " .. table.concat(keys, ", "))
	else
		print("[SoundLibrary] поля результата поиска: " .. table.concat(keys, ", "))
	end
end

local function mentions(err: any, words: { string }): boolean
	local e = tostring(err):lower()
	for _, w in words do
		if e:find(w, 1, true) then
			return true
		end
	end
	return false
end

-- Слишком много запросов: подождать и продолжить
function SoundLibrary.isRateLimit(err: any): boolean
	return mentions(err, { "429", "too many", "throttl", "rate limit" })
end

-- Поиск запрещён этому серверу (нет прав, выключен): повторять бессмысленно
function SoundLibrary.isPermanent(err: any): boolean
	return mentions(err, { "403", "forbidden", "capability", "cannot call", "not permitted", "permission", "not enabled" })
end

-- Общая очередь запросов сервера: не чаще одного запроса в Config.SoundSearchInterval
local nextRequestAt = 0

local function reserveRequest(deadline: number): boolean
	local at = math.max(os.clock(), nextRequestAt)
	if at > deadline then
		return false
	end
	nextRequestAt = at + Config.SoundSearchInterval
	if at > os.clock() then
		task.wait(at - os.clock())
	end
	return true
end

-- Пауза для всех запросов сервера (после ответа «слишком много запросов»)
local function backOff(seconds: number)
	nextRequestAt = math.max(nextRequestAt, os.clock() + seconds)
end

-- Один запрос поиска с повторами; кэшируется на весь сервер
function SoundLibrary.query(keyword: string, spec: Sounds.Search, deadline: number): (boolean, any)
	local key = table.concat({ keyword, spec.Music and "M" or "S", tostring(spec.Min), tostring(spec.Max) }, "|")
	local cached = queryCache[key]
	if cached then
		return true, cached
	end
	local err: any = "время поиска вышло"
	for attempt = 0, Config.SoundSearchRetries do
		if not reserveRequest(deadline) then
			break
		end
		local ok, result = pcall(function()
			local params = Instance.new("AudioSearchParams")
			params.SearchKeyword = keyword
			params.AudioSubType = if spec.Music then Enum.AudioSubType.Music else Enum.AudioSubType.SoundEffect
			if spec.Min then
				params.MinDuration = math.floor(spec.Min)
			end
			if spec.Max then
				params.MaxDuration = math.ceil(spec.Max)
			end
			local pages = AssetService:SearchAudioAsync(params)
			params:Destroy()
			return pages:GetCurrentPage()
		end)
		if ok and type(result) == "table" then
			queryCache[key] = result
			logFormat(result)
			return true, result
		end
		err = if ok then "пустой ответ" else result
		if SoundLibrary.isPermanent(err) then
			break
		end
		-- Нарастающая пауза перед повтором; при лимите запросов — длиннее и для всех запросов
		local limited = SoundLibrary.isRateLimit(err)
		if limited or attempt < Config.SoundSearchRetries then
			backOff(1.5 * 2 ^ attempt * (if limited then 3 else 1))
		end
	end
	return false, err
end

-- Ищет звуки одного слота. Возвращает ID (может быть пустым) или nil и ошибку
function SoundLibrary.findSlot(def: Sounds.Def, deadline: number): ({ string }?, any)
	local spec = def.Search :: Sounds.Search
	local count = spec.Count or 1
	local ids, seen = {}, {}
	for _, keyword in spec.Keywords do
		if #ids >= count or os.clock() > deadline then
			break
		end
		local ok, results = SoundLibrary.query(keyword, spec, deadline)
		if not ok then
			if #ids > 0 then
				break
			end
			return nil, results
		end
		for _, c in SoundLibrary.pick(results, spec, keyword, count - #ids) do
			if not seen[c.Id] then
				seen[c.Id] = true
				table.insert(ids, c.Id)
			end
		end
	end
	return ids, nil
end

function SoundLibrary.folder(): Folder
	local folder = ReplicatedStorage:FindFirstChild(Sounds.LibraryFolder) :: Folder?
	if not folder then
		local f = Instance.new("Folder")
		f.Name = Sounds.LibraryFolder
		f:SetAttribute("Version", 0)
		f.Parent = ReplicatedStorage
		folder = f
	end
	return folder :: Folder
end

local function publish(folder: Folder, name: string, ids: { string })
	folder:SetAttribute(name, Sounds.encodeIds(ids))
	folder:SetAttribute("Version", (tonumber(folder:GetAttribute("Version")) or 0) + 1)
end

-- Весь поиск (yields). Обычно вызывается через SoundLibrary.start()
function SoundLibrary.run()
	local folder = SoundLibrary.folder()
	if not Config.SoundLibraryEnabled then
		folder:SetAttribute("Status", "Disabled")
		return
	end
	folder:SetAttribute("Status", "Searching")
	local startTime = os.clock()
	local deadline = startTime + Config.SoundSearchTimeLimit
	local queue = {}
	for _, def in Sounds.List do
		local override = Config.SoundOverrides[def.Name]
		if def.Search and not override then
			table.insert(queue, def)
		end
	end
	local total = #queue
	local found, failStreak, running = 0, 0, 0
	local stop = false
	local lastError: any = nil

	local function worker()
		while not stop and #queue > 0 and os.clock() < deadline do
			local def = table.remove(queue, 1) :: Sounds.Def
			local ids, err = SoundLibrary.findSlot(def, deadline)
			if ids then
				failStreak = 0
				if #ids > 0 then
					found += 1
					publish(folder, def.Name, ids)
				end
			else
				lastError = err
				if SoundLibrary.isRateLimit(err) then
					-- Лимит запросов: слот в конец очереди, повторим после общей паузы
					table.insert(queue, def)
				else
					failStreak += 1
					-- Поиск запрещён или раз за разом падает: он недоступен, не тратим время
					if SoundLibrary.isPermanent(err) or failStreak >= (if found > 0 then 6 else 3) then
						stop = true
					end
				end
			end
		end
		running -= 1
	end

	for _ = 1, math.max(Config.SoundSearchWorkers, 1) do
		running += 1
		task.spawn(worker)
	end
	while running > 0 do
		task.wait(0.25)
	end

	local offline = found == 0 and lastError ~= nil
	folder:SetAttribute("Status", if offline then "Offline" else "Ready")
	if offline then
		print("[SoundLibrary] поиск звуков недоступен (" .. tostring(lastError) .. ") — играют встроенные звуки")
	else
		print(string.format("[SoundLibrary] найдено звуков: %d из %d за %.0f с", found, total, os.clock() - startTime))
	end
end

-- Запускает поиск в фоне один раз на сервер (результаты остаются в папке до конца жизни сервера)
function SoundLibrary.start()
	if started then
		return
	end
	started = true
	task.spawn(SoundLibrary.run)
end

return SoundLibrary
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[-- Общее состояние раунда и вспомогательные функции для всех систем.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)

local State = {}

State.Active = false
State.Participants = {} :: { [Player]: any }
State.Killer = nil :: any -- data маньяка
State.Map = nil :: any
State.SoloTest = false
State.GensDone = 0
State.GatesPowered = false
State.EndgameDeadline = nil :: number?
State.StartTime = 0
State.HexRuin = false
State.InitialSurvivors = 0

State.RED = Color3.fromRGB(255, 70, 70)
State.YELLOW = Color3.fromRGB(255, 220, 90)
State.GREEN = Color3.fromRGB(110, 255, 140)
State.WHITE = Color3.fromRGB(240, 240, 240)

State.getRoot = Util.getRoot
State.getHumanoid = Util.getHumanoid
State.flatDist = Util.flatDist

local gameState = ReplicatedStorage:FindFirstChild("GameState")
if not gameState then
	gameState = Instance.new("Folder")
	gameState.Name = "GameState"
	gameState.Parent = ReplicatedStorage
end
State.GameState = gameState

function State.now(): number
	return os.clock()
end

function State.setGame(key: string, value: any)
	gameState:SetAttribute(key, value)
end

function State.notifyAll(text: string, color: Color3?)
	Remotes.Notify:FireAllClients(text, color)
end

function State.notify(player: Player?, text: string, color: Color3?)
	if player and player.Parent then
		Remotes.Notify:FireClient(player, text, color)
	end
end

-- Звук для всех: where = Vector3, BasePart/Model или nil (без позиции)
function State.sfx(name: string, where: any?)
	Remotes.Sfx:FireAllClients(name, where)
end

function State.sfxTo(player: Player, name: string, where: any?)
	if player.Parent then
		Remotes.Sfx:FireClient(player, name, where)
	end
end

function State.effect(player: Player, name: string, value: any?)
	if player.Parent then
		Remotes.Effect:FireClient(player, name, value)
	end
end

-- Одноразовая анимация: клиенты видят смену AnimSeq и проигрывают позу
function State.playAnim(player: Player, name: string)
	local char = player.Character
	if char then
		char:SetAttribute("Anim", name)
		char:SetAttribute("AnimSeq", (char:GetAttribute("AnimSeq") or 0) + 1)
	end
end

-- Шум для маньяка (восклицательный знак на месте)
function State.noise(position: Vector3)
	local k = State.Killer
	if k and k.Player.Parent then
		Remotes.Noise:FireClient(k.Player, position)
	end
end

function State.isInGame(data): boolean
	return Util.isInGameStatus(data.Status)
end

function State.survivors(): { any }
	local list = {}
	for _, data in State.Participants do
		if data.Role == "Survivor" then
			table.insert(list, data)
		end
	end
	return list
end

function State.remainingSurvivors(): number
	local n = 0
	for _, data in State.Participants do
		if data.Role == "Survivor" and State.isInGame(data) then
			n += 1
		end
	end
	return n
end

function State.get(player: Player?)
	return player and State.Participants[player]
end

-- Можно ли выжившего ударить / схватить
function State.isTargetable(data): boolean
	return data.Status == "Playing" and not data.Hidden and State.now() >= data.VaultUntil
end

return State
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="35">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Точка входа сервера: лобби -> раунд -> результаты -> снова лобби.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

Players.CharacterAutoLoads = false

local Config = require(ReplicatedStorage.Shared.Config)
require(ReplicatedStorage.Shared.Remotes) -- создаёт RemoteEvent'ы
local MapBuilder = require(script.Parent.Map.MapBuilder)
local Characters = require(script.Parent.Core.Characters)
local Lobby = require(script.Parent.Core.Lobby)
local State = require(script.Parent.Core.State)
local Match = require(script.Parent.Core.Match)

-- Настоящие звуки из библиотеки Creator Store ищутся в фоне, игра их не ждёт
require(script.Parent.Core.SoundLibrary).start()

MapBuilder.SetupLighting()
MapBuilder.BuildLobby()
-- Все объекты карты строятся один раз заранее (с CSG), раунды только копируют их
require(script.Parent.Map.Art.Templates).prebuild()

local function onPlayerAdded(player: Player)
	-- Shift — это бег, поэтому Shift Lock отключаем
	pcall(function()
		player.DevEnableMouseLock = false
	end)
	task.spawn(Characters.spawnLobby, player)
end
Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	onPlayerAdded(player)
end
Players.PlayerRemoving:Connect(Match.OnPlayerRemoving)

RunService.Heartbeat:Connect(function(dt)
	local ok, err = pcall(Match.Update, dt)
	if not ok then
		warn("[DBD] Ошибка в Match.Update: " .. tostring(err))
	end
end)

local function minPlayers(): number
	if RunService:IsStudio() then
		return Config.StudioMinPlayers
	end
	return Config.MinPlayers
end

local function readyPlayers(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(list, player)
		end
	end
	return list
end

while true do
	State.setGame("Phase", "Waiting")
	State.setGame("Timer", 0)
	State.setGame("NeedPlayers", minPlayers())
	while #readyPlayers() < minPlayers() do
		task.wait(1)
	end

	local cancelled = false
	State.setGame("Phase", "Starting")
	for i = Config.LobbyCountdown, 1, -1 do
		State.setGame("Timer", i)
		task.wait(1)
		if #readyPlayers() < minPlayers() then
			cancelled = true
			break
		end
	end

	if not cancelled then
		local list = readyPlayers()
		local killer, killerType = Lobby.pickKiller(list)
		State.setGame("Phase", "Loading")
		local ok, err = pcall(Match.Start, list, killer, killerType)
		if not ok then
			warn("[DBD] Не удалось начать раунд: " .. tostring(err))
			State.Active = true
			Match.End("Ошибка запуска")
		end
		while State.Active do
			task.wait(0.5)
		end
		State.setGame("Phase", "Results")
		for i = Config.ResultsTime, 1, -1 do
			State.setGame("Timer", i)
			task.wait(1)
		end
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="36">
        <Properties>
          <string name="Name">Map</string>
        </Properties>
        <Item class="Folder" referent="37">
          <Properties>
            <string name="Name">Art</string>
          </Properties>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">Contract</string>
              <string name="Source"><![CDATA[-- Контракт моделей: что игровая логика ожидает от каждой модели.
-- Тесты проверяют каждый шаблон через Contract.check.
local Contract = {}

-- Бюджеты деталей (ПК + телефоны)
Contract.Budget = {
	Generator = 75,
	Hook = 50,
	Pallet = 26,
	Locker = 40,
	Totem = 45,
	HexTotem = 50,
	Chest = 30,
	Hatch = 30,
	Trap = 32,
	Crow = 14,
	ExitGate = 130,
}

local function hasAttr(inst: Instance, name: string): boolean
	return inst:GetAttribute(name) ~= nil
end

local function countAttr(model: Instance, name: string): number
	local n = 0
	for _, d in model:GetDescendants() do
		if d:GetAttribute(name) ~= nil then
			n += 1
		end
	end
	return n
end

local function groupCount(model: Instance, group: string): number
	local n = 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("FX") == group then
			n += 1
			if not (d:GetAttribute("CF0") and d:GetAttribute("CF1")) then
				return -1
			end
		end
	end
	return n
end

local function child(model: Instance, name: string, className: string?): Instance?
	local c = model:FindFirstChild(name, true)
	if c and className and not c:IsA(className) then
		return nil
	end
	return c
end

local function partCount(model: Instance): number
	local n = 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

local function hasLight(model: Instance, name: string?): boolean
	for _, d in model:GetDescendants() do
		if d:IsA("Light") and (name == nil or d.Name == name) then
			return true
		end
	end
	return false
end

-- Проверяет модель шаблона. Возвращает список ошибок (пустой = всё хорошо).
function Contract.check(name: string, model: Model): { string }
	local errors = {}
	local function need(cond: boolean, msg: string)
		if not cond then
			table.insert(errors, name .. ": " .. msg)
		end
	end
	need(model:IsA("Model"), "должна быть Model")
	need(model.PrimaryPart ~= nil, "нужен PrimaryPart")
	if model.PrimaryPart then
		need(model.PrimaryPart:GetAttribute("FX") == nil or name == "Pallet", "PrimaryPart не должен быть подвижным")
	end
	local kind = model:GetAttribute("Kind")
	local budget = Contract.Budget[name]
	if budget then
		need(partCount(model) <= budget, ("деталей %d > бюджет %d"):format(partCount(model), budget))
	end

	if name == "Generator" then
		need(kind == "Generator", "Kind=Generator")
		for _, a in { "Progress", "Done", "Regressing" } do
			need(hasAttr(model, a), "атрибут " .. a)
		end
		need(countAttr(model, "ProgressLight") >= 4, "4 детали ProgressLight")
		need(countAttr(model, "Bulb") >= 1, "деталь Bulb")
		need(child(model, "FX", "Attachment") ~= nil, "Attachment FX")
		need(model.PrimaryPart ~= nil and model.PrimaryPart.CanCollide, "PrimaryPart сталкивается")
	elseif name == "Hook" then
		need(kind == "Hook", "Kind=Hook")
		need(model:GetAttribute("Occupant") == 0, "Occupant=0")
		need(child(model, "HangPoint", "BasePart") ~= nil, "деталь HangPoint")
	elseif name == "Pallet" then
		need(kind == "Pallet", "Kind=Pallet")
		need(model:GetAttribute("State") == "Up", "State=Up")
		local hb = model.PrimaryPart
		need(hb ~= nil and hb.Name == "Hitbox", "PrimaryPart = Hitbox")
		if hb then
			need((hb.Size - Vector3.new(5.6, 3, 1.2)).Magnitude < 0.05, "Hitbox 5.6x3x1.2")
			need(hb.CanCollide == false, "Hitbox изначально не сталкивается")
		end
	elseif name == "Locker" then
		need(kind == "Locker", "Kind=Locker")
		need(model:GetAttribute("Occupant") == 0, "Occupant=0")
		need(child(model, "Inside", "BasePart") ~= nil, "деталь Inside")
		need(groupCount(model, "LockerDoor") > 0, "группа LockerDoor с CF0/CF1")
	elseif name == "Totem" or name == "HexTotem" then
		need(kind == "Totem", "Kind=Totem")
		need(hasAttr(model, "Hex") and hasAttr(model, "Progress") and hasAttr(model, "Cleansed"), "атрибуты Hex/Progress/Cleansed")
		need(groupCount(model, "Skull") > 0, "группа Skull с CF0/CF1")
		if name == "HexTotem" then
			need(model:GetAttribute("Hex") == true, "Hex=true")
			need(countAttr(model, "HexFlame") > 0, "огни HexFlame")
		end
	elseif name == "Chest" then
		need(kind == "Chest", "Kind=Chest")
		need(model:GetAttribute("Opened") == false, "Opened=false")
		need(groupCount(model, "ChestLid") > 0, "группа ChestLid")
		need(hasLight(model, "Glow"), "PointLight Glow")
	elseif name == "Hatch" then
		need(kind == "Hatch", "Kind=Hatch")
		need(model:GetAttribute("Open") == false and model:GetAttribute("Closed") == false, "Open/Closed=false")
		need(groupCount(model, "HatchDoor") > 0, "группа HatchDoor")
		need(hasLight(model, "Glow"), "PointLight Glow")
	elseif name == "Trap" then
		need(kind == "Trap", "Kind=Trap")
		need(model:GetAttribute("Armed") == true and model:GetAttribute("Caught") == 0, "Armed=true, Caught=0")
		need(groupCount(model, "TrapJaw") > 0, "группа TrapJaw")
	elseif name == "Crow" then
		need(kind == "Crow", "Kind=Crow")
	elseif name == "ExitGate" then
		need(kind == "ExitGate", "Kind=ExitGate")
		for _, a in { "Powered", "Progress", "Open" } do
			need(hasAttr(model, a), "атрибут " .. a)
		end
		need(child(model, "Switch", "BasePart") ~= nil, "деталь Switch")
		need(child(model, "EscapeZone", "BasePart") ~= nil, "деталь EscapeZone")
		need(child(model, "Siren", "BasePart") ~= nil, "деталь Siren")
		need(hasLight(model, "SirenLight"), "SpotLight SirenLight")
		need(countAttr(model, "GateLamp") >= 3, "3 лампы GateLamp")
		need(groupCount(model, "GateDoor") > 0, "группа GateDoor")
		need(groupCount(model, "GateLever") > 0, "группа GateLever")
	end
	return errors
end

return Contract
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">Items</string>
              <string name="Source"><![CDATA[-- Предметы выживших в руке: аптечка, ящик с инструментами, фонарик.
-- ItemArt.held(item, arm) возвращает Model, приваренную к руке (Massless, без столкновений).
-- У фонарика внутри должен быть SpotLight с именем "Beam" (светит вдоль руки, Enabled = false).
-- Координаты деталей — в пространстве кисти: начало в центре низа руки, +Y — вверх по руке,
-- -Z — вперёд. Аптечку и ящик несут за ручку, как чемодан (узкой стороной к ноге, чтобы не
-- пересекаться с ней), фонарик зажат в кулаке и смотрит вдоль руки.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Kit = require(script.Parent.Kit)

local ItemArt = {}

local A = Kit.A
local P = Kit.Palette
local Mat = Enum.Material

local function finish(m: Model, arm: BasePart)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.Massless = true
			Kit.decor(d)
			Util.weld(arm, d)
		end
	end
end

-- Цилиндр вдоль руки (ось Y кисти); его грань Left смотрит из кулака наружу
local function along(m: Model, hand: CFrame, y: number, length: number, diameter: number, color: Color3, material: Enum.Material?, z: number?): BasePart
	return Kit.cyl(m, hand * CFrame.new(0, y, z or 0) * A(0, 0, 90), length, diameter, color, material)
end

-- Цилиндр между точками (в пространстве кисти)
local function rod(m: Model, hand: CFrame, a: Vector3, b: Vector3, diameter: number, color: Color3, material: Enum.Material?)
	Kit.rod(m, hand:PointToWorldSpace(a), hand:PointToWorldSpace(b), diameter, color, material)
end

-- Ручка-скоба сверху: две стойки и перекладина в кулаке
local function carryHandle(m: Model, hand: CFrame, top: number, span: number, color: Color3)
	for _, z in { -span / 2, span / 2 } do
		Kit.box(m, hand * CFrame.new(0, (top + 0.08) / 2, z), Vector3.new(0.08, 0.08 - top, 0.08), color, Mat.Metal)
	end
	Kit.cyl(m, hand * CFrame.new(0, 0.06, 0) * A(0, 90, 0), span + 0.08, 0.1, P.Rubber, Mat.Rubber)
end

------------------------------------------------------------------------
-- Аптечка: облупленный красный жестяной ящик, белая панель с крестом с обеих сторон,
-- скруглённая крышка, защёлки, торчащий из-под крышки бинт
------------------------------------------------------------------------

local function medkit(m: Model, hand: CFrame, rng: Random): BasePart
	local red = Kit.jitter(Color3.fromRGB(132, 34, 28), 0.03, rng)
	local body = Kit.box(m, hand * CFrame.new(0, -0.76, 0), Vector3.new(0.42, 0.56, 1.12), red, Mat.Metal)
	Kit.box(m, hand * CFrame.new(0, -0.43, 0), Vector3.new(0.44, 0.12, 1.14), Kit.dark(red, 0.15), Mat.Metal)
	Kit.box(m, hand * CFrame.new(0, -0.35, 0), Vector3.new(0.24, 0.05, 1.1), Kit.dark(red, 0.1), Mat.Metal)
	for _, s in { -1, 1 } do
		Kit.wedge(m, hand * CFrame.new(0.17 * s, -0.35, 0) * A(0, -90 * s, 0), Vector3.new(1.1, 0.05, 0.1), Kit.dark(red, 0.1), Mat.Metal)
	end
	-- Панель и крест проходят ящик насквозь: видны с обеих сторон одной деталью
	local white = Color3.fromRGB(206, 200, 184)
	Kit.box(m, hand * CFrame.new(0, -0.74, 0.02), Vector3.new(0.45, 0.4, 0.42), white, Mat.SmoothPlastic)
	local cross = Color3.fromRGB(150, 26, 24)
	Kit.box(m, hand * CFrame.new(0, -0.74, 0.02), Vector3.new(0.46, 0.28, 0.09), cross, Mat.SmoothPlastic)
	Kit.box(m, hand * CFrame.new(0, -0.74, 0.02), Vector3.new(0.46, 0.09, 0.28), cross, Mat.SmoothPlastic)
	for _, z in { -0.36, 0.36 } do
		Kit.box(m, hand * CFrame.new(0, -0.46, z), Vector3.new(0.46, 0.13, 0.08), P.Steel, Mat.Metal)
	end
	-- Бинт, зажатый крышкой, свисает по боку
	Kit.box(m, hand * CFrame.new(0.225, -0.62, 0.48) * A(0, 0, 6), Vector3.new(0.02, 0.38, 0.13), Color3.fromRGB(196, 190, 172), Mat.Fabric)
	carryHandle(m, hand, -0.32, 0.56, P.DarkSteel)
	return body
end

------------------------------------------------------------------------
-- Ящик с инструментами: мятый открытый лоток из синей облезлой жести с ручкой вдоль,
-- из него торчат отвёртка, гаечный ключ и молоток
------------------------------------------------------------------------

local function toolbox(m: Model, hand: CFrame, rng: Random): BasePart
	local paint = Kit.jitter(Color3.fromRGB(90, 116, 126), 0.03, rng)
	local body = Kit.box(m, hand * CFrame.new(0, -0.98, 0), Vector3.new(0.6, 0.56, 1.4), paint, Mat.Metal)
	-- Борта лотка; правый помят (наклонён внутрь)
	Kit.box(m, hand * CFrame.new(-0.275, -0.58, 0), Vector3.new(0.05, 0.3, 1.4), Kit.dark(paint, 0.12), Mat.Metal)
	Kit.box(m, hand * CFrame.new(0.27, -0.58, 0.1) * A(0, 0, 6), Vector3.new(0.05, 0.3, 1.2), Kit.dark(paint, 0.12), Mat.Metal)
	for _, z in { -0.675, 0.675 } do
		Kit.box(m, hand * CFrame.new(0, -0.58, z), Vector3.new(0.6, 0.3, 0.05), Kit.dark(paint, 0.12), Mat.Metal)
	end
	-- Ржавая вмятина на боку и защёлки
	Kit.box(m, hand * CFrame.new(0.302, -1.02, -0.25) * A(4, 0, 0), Vector3.new(0.02, 0.26, 0.42), P.DarkRust, Mat.CorrodedMetal)
	for _, z in { -0.45, 0.45 } do
		Kit.box(m, hand * CFrame.new(0, -0.78, z), Vector3.new(0.62, 0.12, 0.1), P.Steel, Mat.Metal)
	end
	carryHandle(m, hand, -0.45, 1.2, P.DarkSteel)
	-- Отвёртка лежит наискось, жало торчит за торец
	rod(m, hand, Vector3.new(0.1, -0.6, 0.12), Vector3.new(0.12, -0.44, 0.52), 0.15, Color3.fromRGB(176, 120, 40), Mat.SmoothPlastic)
	rod(m, hand, Vector3.new(0.12, -0.44, 0.52), Vector3.new(0.14, -0.3, 0.98), 0.05, P.Steel, Mat.Metal)
	-- Гаечный ключ торчит вверх у переднего торца
	local chrome = Color3.fromRGB(150, 150, 146)
	rod(m, hand, Vector3.new(-0.12, -0.75, -0.5), Vector3.new(-0.16, -0.1, -0.64), 0.08, chrome, Mat.Metal)
	Kit.box(m, hand * CFrame.new(-0.16, -0.05, -0.65) * A(-10, 0, 0), Vector3.new(0.06, 0.14, 0.3), chrome, Mat.Metal)
	-- Молоток: рукоять из лотка, головка поперёк
	rod(m, hand, Vector3.new(0.12, -0.75, -0.25), Vector3.new(0.22, -0.2, -0.38), 0.09, P.Plank, Mat.Wood)
	Kit.box(m, hand * CFrame.new(0.22, -0.17, -0.38) * A(0, 0, 8), Vector3.new(0.14, 0.14, 0.42), P.Iron, Mat.Metal)
	return body
end

------------------------------------------------------------------------
-- Фонарик: тёмный корпус с резиновыми кольцами, кнопка, изолента, клипса,
-- широкая голова с хромированным ободом и стеклом. Луч светит из стекла вдоль руки.
------------------------------------------------------------------------

local function flashlight(m: Model, hand: CFrame, rng: Random): BasePart
	local z = -0.2 -- держим ближе к пальцам
	local metal = Kit.jitter(Color3.fromRGB(52, 54, 56), 0.03, rng)
	local body = along(m, hand, -0.15, 0.95, 0.28, metal, Mat.Metal, z)
	for _, y in { -0.08, -0.2, -0.32 } do
		along(m, hand, y, 0.06, 0.31, P.Rubber, Mat.Rubber, z)
	end
	Kit.box(m, hand * CFrame.new(0, -0.44, z - 0.15), Vector3.new(0.1, 0.13, 0.06), Color3.fromRGB(150, 70, 36), Mat.Rubber)
	along(m, hand, -0.6, 0.09, 0.295, Color3.fromRGB(112, 110, 102), Mat.Fabric, z)
	Kit.box(m, hand * CFrame.new(-0.15, -0.45, z), Vector3.new(0.04, 0.24, 0.07), P.Steel, Mat.Metal)
	along(m, hand, -0.68, 0.12, 0.35, metal, Mat.Metal, z)
	local head = along(m, hand, -0.89, 0.3, 0.44, Kit.dark(metal, 0.1), Mat.Metal, z)
	along(m, hand, -1.06, 0.06, 0.48, Color3.fromRGB(150, 150, 146), Mat.Metal, z)
	along(m, hand, -1.085, 0.02, 0.38, Color3.fromRGB(226, 224, 204), Mat.Glass, z).Transparency = 0.15
	local beam = Kit.spotLight(head, Color3.fromRGB(255, 250, 220), Config.FlashlightRange + 4, Config.FlashlightAngle * 2.5, 6, Enum.NormalId.Left, true)
	beam.Name = "Beam"
	beam.Enabled = false
	return body
end

local BUILD: { [string]: (Model, CFrame, Random) -> BasePart } = {
	Medkit = medkit,
	Toolbox = toolbox,
	Flashlight = flashlight,
}

-- Кисть руки R6 — низ детали "Right Arm"; локальная -Y руки = направление, куда указывает рука
function ItemArt.held(item: string, arm: BasePart): Model
	local m = Kit.model("HeldItem")
	local hand = arm.CFrame * CFrame.new(0, -arm.Size.Y / 2, 0)
	local build = BUILD[item] or BUILD.Medkit
	m.PrimaryPart = build(m, hand, Random.new(#item))
	finish(m, arm)
	return m
end

return ItemArt
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">KillerGear</string>
              <string name="Source"><![CDATA[-- Внешний вид маньяков: снаряжение из деталей, приваренное к частям тела R6.
-- KillerGear.dress(char, def) вызывается до масштабирования (char:ScaleTo), поэтому размеры заданы
-- в «родных» единицах R6: голова ~1.2, торс 2x2x1, руки и ноги 1x2x1, кисть — низ руки (y = -1).
-- Правила:
--   * детали — прямые потомки персонажа, приварены к своей части тела (процедурная анимация двигает
--     их вместе с ней), Massless, без столкновений и запросов, мелочь без тени;
--   * имена из CameraController.VIEWMODEL (оружие и снаряжение рук) остаются видны маньяку от первого
--     лица — прочему снаряжению эти имена давать нельзя;
--   * SurfaceGui только на оружии: рисунки не исчезают вместе с деталью (вид из головы, невидимость
--     Призрака), поэтому маски, одежда и всё у Призрака — только из деталей;
--   * родная голова скрыта (размер её меша у R6 непредсказуем) — голову целиком строит снаряжение;
--   * всё, что висит ниже пояса спереди и сзади, крепится к ногам: иначе ноги на бегу пронзают его.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Util = require(ReplicatedStorage.Shared.Util)
local Kit = require(script.Parent.Kit)

local KillerGear = {}

local A = Kit.A
local P = Kit.Palette
local Mat = Enum.Material

local LIMBS = { "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }

type Shape = "Block" | "Wedge" | "Ball" | "Cylinder"

type Gear = {
	char: Model,
	limbs: { [string]: BasePart },
	rng: Random,
}

local CLASS: { [Shape]: string } = { Block = "Part", Ball = "Part", Cylinder = "Part", Wedge = "WedgePart" }

------------------------------------------------------------------------
-- Детали снаряжения (координаты — в пространстве своей части тела)
------------------------------------------------------------------------

local function put(g: Gear, limb: string, name: string, shape: Shape, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?): BasePart
	local base = g.limbs[limb]
	local p = Kit.part(nil, {
		Name = name,
		Size = size,
		CFrame = base.CFrame * cf,
		Color = color,
		Material = material or Mat.SmoothPlastic,
		Anchored = false,
		Massless = true,
		Decor = true,
	}, CLASS[shape])
	if shape == "Ball" then
		(p :: any).Shape = Enum.PartType.Ball
	elseif shape == "Cylinder" then
		(p :: any).Shape = Enum.PartType.Cylinder
	end
	-- Крупные плоскости (фартук, плащ, клинок) отбрасывают тень, мелочь — нет
	local dims = { size.X, size.Y, size.Z }
	table.sort(dims)
	p.CastShadow = dims[2] >= 0.6
	Util.weld(base, p)
	p.Parent = g.char
	return p
end

local function tone(g: Gear, color: Color3, amount: number?): Color3
	return Kit.jitter(color, amount or 0.05, g.rng)
end

-- Цилиндр между точками a и b
local function rod(g: Gear, limb: string, name: string, a: Vector3, b: Vector3, diameter: number, color: Color3, material: Enum.Material?): BasePart
	local cf = CFrame.lookAt((a + b) / 2, b) * A(0, 90, 0)
	return put(g, limb, name, "Cylinder", cf, Vector3.new((b - a).Magnitude, diameter, diameter), color, material)
end

-- Вертикальный цилиндр (ось Y кадра cf)
local function disc(g: Gear, limb: string, name: string, cf: CFrame, height: number, diameter: number, color: Color3, material: Enum.Material?): BasePart
	return put(g, limb, name, "Cylinder", cf * A(0, 0, 90), Vector3.new(height, diameter, diameter), color, material)
end

-- Цилиндр вдоль оси Z кадра cf (рукояти оружия: от кисти вперёд)
local function shaft(g: Gear, limb: string, name: string, cf: CFrame, length: number, diameter: number, color: Color3, material: Enum.Material?): BasePart
	return put(g, limb, name, "Cylinder", cf * A(0, 90, 0), Vector3.new(length, diameter, diameter), color, material)
end

-- Обмотка вокруг части тела: полоса чуть шире самой части, наклонённая на tiltX/tiltZ градусов
local function wrap(g: Gear, limb: string, name: string, y: number, height: number, tiltX: number, tiltZ: number, color: Color3, material: Enum.Material?, pad: number?): BasePart
	local s = g.limbs[limb].Size
	local e = pad or 0.07
	return put(g, limb, name, "Block", CFrame.new(0, y, 0) * A(tiltX, 0, tiltZ), Vector3.new(s.X + e, height, s.Z + e), color, material or Mat.Fabric)
end

-- Рваная полоса ткани: top — середина верхнего края, локальная Z кадра смотрит наружу от тела.
-- Клин сужается книзу в косой «язык»; mirror — остриё с другой стороны.
local function rag(g: Gear, limb: string, name: string, top: CFrame, width: number, length: number, color: Color3, mirror: boolean?): BasePart
	local cf = top * CFrame.new(0, -length / 2, 0) * A(0, mirror and -90 or 90, 180)
	return put(g, limb, name, "Wedge", cf, Vector3.new(0.05, length, width), color, Mat.Fabric)
end

-- Осколок металла, торчащий из тела: основание base (утоплено), направление dir
local function shard(g: Gear, limb: string, base: Vector3, dir: Vector3, length: number, width: number, color: Color3)
	local d = dir.Unit
	local cf = CFrame.lookAt(base + d * length / 2, base + d * length) * A(-90, 0, 0) * A(0, g.rng:NextNumber(-40, 40), 0)
	put(g, limb, "Shard", "Wedge", cf, Vector3.new(0.06, length, width), color, Mat.CorrodedMetal)
end

------------------------------------------------------------------------
-- Траппер: белая маска-оскал, кожаный фартук в крови, капкан и крюк на поясе,
-- железо в плечах и спине, огромный тесак
------------------------------------------------------------------------

local GEAR = {}

function GEAR.Trapper(g: Gear, def)
	local rng = g.rng
	local bone = tone(g, P.Bone, 0.02)
	local leather = Color3.fromRGB(100, 70, 48)
	local strap = Color3.fromRGB(38, 29, 24)
	local cloth = Color3.fromRGB(96, 86, 70)
	local shirt = Kit.dark(def.ClothColor, 0.18)
	local hole = Color3.fromRGB(24, 12, 10)
	-- Грязная тёмная рубаха без рукавов: кожаный фартук на ней читается издалека
	g.limbs.Torso.Color = shirt

	-- Голова: тёмные волосы, ремень маски, маска с оскалом
	put(g, "Head", "Hair", "Ball", CFrame.new(0, 0.04, 0.1), Vector3.one * 1.18, Color3.fromRGB(40, 32, 28))
	disc(g, "Head", "MaskStrap", CFrame.new(0, 0.18, 0.1) * A(-6, 0, 0), 0.13, 1.24, strap, Mat.Leather)
	-- Лицевая пластина со скошенными боками: маска выпуклая и уходит к ушам
	put(g, "Head", "Mask", "Block", CFrame.new(0, 0.02, -0.46), Vector3.new(0.8, 1.06, 0.2), bone, Mat.Plaster)
	for _, s in { -1, 1 } do
		put(g, "Head", "Mask", "Wedge", CFrame.new(0.475 * s, 0.02, -0.46) * A(0, 0, -90 * s), Vector3.new(1.06, 0.15, 0.2), bone, Mat.Plaster)
	end
	put(g, "Head", "MaskBrow", "Wedge", CFrame.new(0, 0.64, -0.38), Vector3.new(0.8, 0.18, 0.36), bone, Mat.Plaster)
	local front = -0.56 -- передняя грань маски
	for _, s in { -1, 1 } do
		put(g, "Head", "MaskEye", "Block", CFrame.new(0.24 * s, 0.2, front - 0.005) * A(0, 0, 14 * s), Vector3.new(0.3, 0.14, 0.04), hole)
	end
	put(g, "Head", "MaskMouth", "Block", CFrame.new(0, -0.24, front - 0.005), Vector3.new(0.78, 0.3, 0.04), hole)
	-- Кривые зубы сверху и снизу (одного не хватает), между ними чернеет рот
	local teeth = { { -0.28, 1 }, { -0.08, 1 }, { 0.12, 1 }, { 0.3, 1 }, { -0.18, -1 } }
	for _, t in teeth do
		local h = rng:NextNumber(0.13, 0.2)
		local y = t[2] > 0 and -0.09 - h / 2 + 0.03 or -0.39 + h / 2 - 0.03
		local cf = CFrame.new(t[1] + rng:NextNumber(-0.03, 0.03), y, front - 0.02) * A(0, 0, rng:NextNumber(-12, 12))
		put(g, "Head", "MaskTooth", "Block", cf, Vector3.new(0.12, h, 0.05), tone(g, P.OldBone, 0.06))
	end
	-- Трещина через лоб к глазу
	put(g, "Head", "MaskCrack", "Block", CFrame.new(-0.1, 0.4, front - 0.006) * A(0, 0, -62), Vector3.new(0.38, 0.03, 0.03), hole)

	-- Сутулая спина
	put(g, "Torso", "Hump", "Wedge", CFrame.new(0, 0.5, 0.66) * A(180, 0, 0), Vector3.new(1.8, 1, 0.32), shirt, Mat.Fabric)
	-- Фартук: нагрудник и пояс на торсе, полы — на ногах (разрезной, как у кузнеца)
	put(g, "Torso", "ApronBib", "Block", CFrame.new(0, 0.45, -0.56), Vector3.new(1.4, 1.1, 0.1), leather, Mat.Leather)
	put(g, "Torso", "Apron", "Block", CFrame.new(0, -0.55, -0.57), Vector3.new(2.04, 0.95, 0.12), leather, Mat.Leather)
	put(g, "Torso", "ApronBlood", "Block", CFrame.new(0.3, -0.2, -0.64) * A(0, 0, -9), Vector3.new(0.26, 1.15, 0.02), P.DryBlood, Mat.Leather)
	for _, s in { -1, 1 } do
		local a = Vector3.new(0.6 * s, 1.0, -0.62)
		local b = Vector3.new(0.32 * s, 1.07, 0.3)
		put(g, "Torso", "ApronStrap", "Block", CFrame.lookAt((a + b) / 2, b), Vector3.new(0.1, 0.05, (b - a).Magnitude), strap, Mat.Leather)
	end
	put(g, "Torso", "Belt", "Block", CFrame.new(0, -0.82, 0.02), Vector3.new(2.08, 0.26, 1.08), strap, Mat.Leather)
	-- Капкан на левом бедре (сбоку — ноги его не задевают)
	local trap = CFrame.new(-1.14, -1.42, 0.1) * A(0, -32, 0)
	put(g, "Torso", "BeltTrap", "Cylinder", trap, Vector3.new(0.12, 0.94, 0.94), tone(g, P.DarkRust), Mat.CorrodedMetal)
	put(g, "Torso", "BeltTrap", "Block", trap * CFrame.new(-0.08, 0, 0) * A(16, 0, 0), Vector3.new(0.06, 0.14, 1.6), P.Iron, Mat.Metal)
	-- Мясной крюк на правом бедре
	rod(g, "Torso", "MeatHook", Vector3.new(1.07, -0.92, 0.2), Vector3.new(1.08, -1.5, 0.2), 0.07, P.Rust, Mat.CorrodedMetal)
	rod(g, "Torso", "MeatHook", Vector3.new(1.08, -1.47, 0.22), Vector3.new(1.08, -1.4, -0.12), 0.07, P.Rust, Mat.CorrodedMetal)
	-- Железо, вбитое в плечи и спину
	shard(g, "Torso", Vector3.new(0.7, 0.9, 0.05), Vector3.new(0.35, 0.85, 0.3), 0.95, 0.26, tone(g, P.Rust))
	shard(g, "Torso", Vector3.new(-0.62, 0.9, 0.18), Vector3.new(-0.3, 0.8, 0.5), 0.8, 0.22, tone(g, P.DarkRust))
	shard(g, "Torso", Vector3.new(-0.45, 0.55, 0.62), Vector3.new(-0.2, 0.35, 0.9), 0.62, 0.18, tone(g, P.Rust))

	-- Руки: обрывки рукавов, перчатка на правой, грязная обмотка на левой (кисти видны от первого лица)
	for _, arm in { "Left Arm", "Right Arm" } do
		wrap(g, arm, "Sleeve", 0.66, 0.68, 0, arm == "Left Arm" and -5 or 4, shirt, Mat.Fabric, 0.05)
	end
	put(g, "Right Arm", "Glove", "Block", CFrame.new(0, -0.74, 0), Vector3.new(1.06, 0.54, 1.06), Color3.fromRGB(44, 34, 28), Mat.Leather)
	wrap(g, "Left Arm", "Wrap", -0.58, 0.42, 0, 6, cloth)

	-- Ноги: полы фартука, обмотки-лохмотья, сапоги
	for _, leg in { "Left Leg", "Right Leg" } do
		local s = leg == "Left Leg" and -1 or 1
		put(g, leg, "ApronFlap", "Block", CFrame.new(0.01 * s, 0.24, -0.57) * A(4, 0, 0), Vector3.new(0.98, 1.4, 0.12), leather, Mat.Leather)
		wrap(g, leg, "LegRag", -0.3, 0.36, 4 * s, 7 * s, tone(g, cloth, 0.08))
		put(g, leg, "Boot", "Block", CFrame.new(0, -0.76, -0.07), Vector3.new(1.06, 0.5, 1.18), Color3.fromRGB(35, 28, 24), Mat.Leather)
	end

	-- Тесак: широкий клинок лезвием вниз, скошенное остриё.
	-- Хват: рукоять поперёк кулака, оружие чуть задрано и повёрнуто плашмя к камере от первого лица
	local grip = CFrame.new(0, -0.8, 0) * A(15, 0, -30)
	local arm = "Right Arm"
	shaft(g, arm, "Handle", grip * CFrame.new(0, 0, -0.12), 1.3, 0.22, tone(g, P.DarkWood), Mat.Wood)
	shaft(g, arm, "Handle", grip * CFrame.new(0, 0, 0.56), 0.1, 0.28, P.DarkSteel, Mat.Metal)
	put(g, arm, "Handle", "Block", grip * CFrame.new(0, -0.05, -0.83), Vector3.new(0.17, 0.34, 0.14), P.DarkSteel, Mat.Metal)
	local steel = Color3.fromRGB(104, 104, 102)
	local blade = put(g, arm, "Blade", "Block", grip * CFrame.new(0, -0.4, -1.95), Vector3.new(0.1, 1.05, 2.2), steel, Mat.Metal)
	put(g, arm, "Blade", "Wedge", grip * CFrame.new(0, -0.4, -3.3), Vector3.new(0.1, 1.05, 0.5), steel, Mat.Metal)
	put(g, arm, "Blade", "Block", grip * CFrame.new(0, 0.1, -1.95), Vector3.new(0.15, 0.1, 2.2), P.Iron, Mat.Metal)
	put(g, arm, "Blade", "Block", grip * CFrame.new(0, -0.86, -1.95), Vector3.new(0.104, 0.13, 2.2), Color3.fromRGB(160, 160, 156), Mat.Metal)
	put(g, arm, "Blade", "Cylinder", grip * CFrame.new(0, -0.12, -2.8), Vector3.new(0.108, 0.2, 0.2), hole)
	put(g, arm, "BladeBlood", "Block", grip * CFrame.new(0, -0.62, -2.55) * A(-8, 0, 0), Vector3.new(0.108, 0.5, 1.1), P.Blood)
	for _, face in { Enum.NormalId.Left, Enum.NormalId.Right } do
		Kit.rustStreaks(blade, face, rng, 5)
		Kit.rustStreaks(blade, face, rng, 3, P.DryBlood)
	end
end

------------------------------------------------------------------------
-- Охотница: маска-заяц с длинными ушами и росписью, меховой капюшон и накидка,
-- слои меха и кожи, запасные топорики у бёдер, большой обмотанный топор
------------------------------------------------------------------------

-- Запасной топорик на бедре: top — центр обуха, рукоять вниз по -Y, лезвие вперёд по -Z
local function thighHatchet(g: Gear, leg: string, top: CFrame)
	rod(g, leg, "SpareHatchet", (top * CFrame.new(0, 0.1, 0)).Position, (top * CFrame.new(0, -1.05, 0.04)).Position, 0.12, tone(g, P.Wood), Mat.Wood)
	put(g, leg, "SpareHatchet", "Block", top * CFrame.new(0, -0.04, -0.2), Vector3.new(0.07, 0.34, 0.46), tone(g, P.DarkSteel), Mat.CorrodedMetal)
end

function GEAR.Huntress(g: Gear, def)
	local rng = g.rng
	local furDark = Color3.fromRGB(70, 55, 44)
	local furLight = Color3.fromRGB(132, 124, 112) -- седой волчий мех
	local hide = Color3.fromRGB(116, 74, 48)
	local leather = Color3.fromRGB(58, 40, 30)
	local white = tone(g, Color3.fromRGB(216, 208, 190), 0.02)
	local paint = Color3.fromRGB(122, 32, 26)

	-- Капюшон из меха и маска-заяц
	put(g, "Head", "Hood", "Ball", CFrame.new(0, 0.12, 0.12), Vector3.one * 1.34, furDark, Mat.Fabric)
	disc(g, "Head", "Hood", CFrame.new(0, -0.2, 0.13), 0.72, 1.34, furDark, Mat.Fabric)
	put(g, "Head", "Mask", "Block", CFrame.new(0, -0.02, -0.6), Vector3.new(1, 1.02, 0.16), white, Mat.Wood)
	put(g, "Head", "MaskSnout", "Wedge", CFrame.new(0, -0.27, -0.81), Vector3.new(0.44, 0.4, 0.26), Kit.dark(white, 0.06), Mat.Wood)
	for _, s in { -1, 1 } do
		put(g, "Head", "MaskEye", "Block", CFrame.new(0.22 * s, 0.14, -0.69) * A(0, 0, 45), Vector3.new(0.19, 0.19, 0.04), Color3.fromRGB(16, 12, 10))
		put(g, "Head", "MaskPaint", "Block", CFrame.new(0.23 * s, -0.12, -0.685) * A(0, 0, 6 * s), Vector3.new(0.07, 0.4, 0.03), paint)
		-- Уши: длинные плоские, чуть назад и в стороны, со скруглённым концом и тёмной внутренней стороной
		local base = CFrame.new(0.26 * s, 0.46, -0.52) * A(14, 0, -9 * s)
		put(g, "Head", "MaskEar", "Block", base * CFrame.new(0, 0.6, 0), Vector3.new(0.36, 1.2, 0.1), white, Mat.Wood)
		shaft(g, "Head", "MaskEar", base * CFrame.new(0, 1.2, 0), 0.1, 0.36, white, Mat.Wood)
		put(g, "Head", "MaskEar", "Block", base * CFrame.new(0, 0.66, -0.055), Vector3.new(0.17, 1.02, 0.02), Color3.fromRGB(128, 84, 72))
	end

	-- Меховая накидка на плечах, воротник, плащ до бёдер
	-- (спереди накидка не выше подбородка, чтобы не закрывать маску)
	put(g, "Torso", "Mantle", "Block", CFrame.new(0, 1.1, 0.1), Vector3.new(2.4, 0.4, 1.24), furLight, Mat.Fabric)
	for _, s in { -1, 1 } do
		put(g, "Torso", "Mantle", "Wedge", CFrame.new(1.625 * s, 1.1, 0.1) * A(0, -90 * s, 0), Vector3.new(1.24, 0.4, 0.85), furLight, Mat.Fabric)
	end
	put(g, "Torso", "Collar", "Block", CFrame.new(0, 1.45, 0.48) * A(15, 0, 0), Vector3.new(1.7, 0.55, 0.45), tone(g, furLight, 0.06), Mat.Fabric)
	local cape = CFrame.new(0, -0.15, 0.62) * A(-5, 0, 0)
	put(g, "Torso", "Cape", "Block", cape, Vector3.new(2.3, 2.3, 0.14), furDark, Mat.Fabric)
	rag(g, "Torso", "Cape", cape * CFrame.new(-0.62, -1.12, 0), 0.62, 0.5, furDark)
	rag(g, "Torso", "Cape", cape * CFrame.new(0.55, -1.12, 0), 0.7, 0.42, furDark, true)
	-- Кожаный корсаж, пояс с пряжкой, меховая юбка на бёдрах, сумка на поясе
	put(g, "Torso", "Bodice", "Block", CFrame.new(0, 0.12, -0.55), Vector3.new(1.8, 1.25, 0.1), leather, Mat.Leather)
	put(g, "Torso", "Belt", "Block", CFrame.new(0, -0.66, 0), Vector3.new(2.08, 0.28, 1.1), leather, Mat.Leather)
	put(g, "Torso", "Buckle", "Block", CFrame.new(-0.15, -0.66, -0.58), Vector3.new(0.3, 0.3, 0.08), P.OldBone)
	put(g, "Torso", "FurSkirt", "Block", CFrame.new(0, -1.0, 0), Vector3.new(2.12, 0.55, 1.16), furLight, Mat.Fabric)
	put(g, "Torso", "Pouch", "Block", CFrame.new(0.6, -0.84, -0.66), Vector3.new(0.36, 0.4, 0.24), hide, Mat.Leather)

	-- Руки: обмотки из меха и кожи
	for _, arm in { "Left Arm", "Right Arm" } do
		wrap(g, arm, "Bracer", -0.38, 0.72, 0, 0, tone(g, hide, 0.04), Mat.Leather)
	end

	-- Ноги: кожаная юбка с рваным краем (на бёдрах), меховые сапоги с ремешками, топорики
	for _, leg in { "Left Leg", "Right Leg" } do
		local s = leg == "Left Leg" and -1 or 1
		put(g, leg, "Skirt", "Block", CFrame.new(0.03 * s, 0.42, -0.01), Vector3.new(1.06, 1.15, 1.1), hide, Mat.Leather)
		rag(g, leg, "Skirt", CFrame.new(0.08 * s, -0.12, -0.56) * A(0, 180, 0), 0.62, 0.48, hide, s > 0)
		put(g, leg, "Boot", "Block", CFrame.new(0, -0.62, -0.04), Vector3.new(1.1, 0.8, 1.16), furDark, Mat.Fabric)
		wrap(g, leg, "BootCord", -0.4, 0.08, 0, 6 * s, leather, Mat.Leather, 0.14)
		-- Запасной топорик заткнут под меховую юбку снаружи бедра
		thighHatchet(g, leg, CFrame.new(0.63 * s, 0.6, 0.05 + 0.08 * s) * A(-16 - 8 * s, 0, 0))
	end

	-- Большой топор: длинная рукоять с обмотками, широкое бородатое лезвие вниз
	local grip = CFrame.new(0, -0.8, 0) * A(15, 0, -30)
	local arm = "Right Arm"
	shaft(g, arm, "Handle", grip * CFrame.new(0, 0, -0.85), 2.5, 0.2, tone(g, P.Wood), Mat.Wood)
	shaft(g, arm, "Handle", grip * CFrame.new(0, 0, -1.42), 0.5, 0.25, Color3.fromRGB(122, 106, 84), Mat.Fabric)
	shaft(g, arm, "Handle", grip * CFrame.new(0, 0, 0.32), 0.22, 0.25, leather, Mat.Leather)
	put(g, arm, "AxeHead", "Block", grip * CFrame.new(0, -0.02, -1.98), Vector3.new(0.24, 0.44, 0.46), P.Iron, Mat.Metal)
	local steel = tone(g, P.DarkSteel, 0.04)
	local head = put(g, arm, "AxeHead", "Block", grip * CFrame.new(0, -0.62, -1.98), Vector3.new(0.12, 0.8, 0.54), steel, Mat.Metal)
	put(g, arm, "AxeHead", "Wedge", grip * CFrame.new(0, -0.62, -2.47), Vector3.new(0.12, 0.8, 0.44), steel, Mat.Metal)
	put(g, arm, "AxeHead", "Wedge", grip * CFrame.new(0, -0.62, -1.53) * A(0, 180, 0), Vector3.new(0.12, 0.8, 0.36), steel, Mat.Metal)
	put(g, arm, "AxeHead", "Block", grip * CFrame.new(0, -0.96, -2.01), Vector3.new(0.13, 0.13, 1.36), Color3.fromRGB(150, 150, 146), Mat.Metal)
	for _, face in { Enum.NormalId.Left, Enum.NormalId.Right } do
		Kit.rustStreaks(head, face, rng, 4)
	end
end

------------------------------------------------------------------------
-- Призрак: тело в бинтах, чёрные лохмотья, дубина из позвоночника с черепом,
-- колокол в левой руке. Никаких SurfaceGui: при невидимости они бы остались висеть в воздухе.
------------------------------------------------------------------------

function GEAR.Wraith(g: Gear, def)
	local rng = g.rng
	local skin = Kit.dark(def.BodyColor, 0.4)
	local bandage = def.ClothColor
	local ragColor = Color3.fromRGB(30, 28, 27)
	local bone = P.OldBone
	local bronze = Color3.fromRGB(112, 90, 56)
	for _, name in { "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg" } do
		g.limbs[name].Color = skin
	end
	local function bandageTone(): Color3
		return tone(g, rng:NextNumber() < 0.5 and bandage or Kit.dark(bandage, 0.2), 0.05)
	end

	-- Голова: обмотанный череп, светящиеся щели глаз, капюшон-тряпка и свисающие ленты
	put(g, "Head", "HeadWrap", "Ball", CFrame.new(0, 0.04, 0.05), Vector3.one * 1.12, Color3.fromRGB(36, 33, 31), Mat.Fabric)
	disc(g, "Head", "HeadBandage", CFrame.new(0, 0.3, 0.05) * A(-14, 0, 8), 0.16, 1.1, bandageTone())
	disc(g, "Head", "HeadBandage", CFrame.new(0, -0.22, 0.05) * A(10, 0, -12), 0.2, 1.12, bandageTone())
	for _, s in { -1, 1 } do
		put(g, "Head", "Eye", "Block", CFrame.new(0.21 * s, 0.07, -0.5) * A(0, 0, -10 * s), Vector3.new(0.22, 0.07, 0.05), Color3.fromRGB(240, 232, 205), Mat.Neon)
		rag(g, "Head", "HeadRag", CFrame.new(0.32 * s, -0.3, 0.62) * A(8, 0, 0), 0.32, 1.25, tone(g, ragColor, 0.08), s > 0)
	end
	put(g, "Head", "Hood", "Block", CFrame.new(0, -0.14, 0.55) * A(-14, 0, 0), Vector3.new(1.02, 0.85, 0.14), ragColor, Mat.Fabric)

	-- Бинты: полосы вокруг торса, рук и ног (на руках — видны от первого лица)
	for _, b in { { 0.64, 0.22, 4, 8 }, { 0.2, 0.18, -3, -10 }, { -0.26, 0.24, 5, 6 }, { -0.7, 0.18, -2, -5 } } do
		wrap(g, "Torso", "Bandage", b[1], b[2], b[3], b[4], bandageTone())
	end
	for _, arm in { "Left Arm", "Right Arm" } do
		for _, b in { { 0.5, 0.2, 6 }, { 0, 0.16, -9 }, { -0.48, 0.22, 7 } } do
			wrap(g, arm, "ArmWrap", b[1], b[2], 0, b[3], bandageTone())
		end
	end
	for _, leg in { "Left Leg", "Right Leg" } do
		for _, b in { { 0.35, 0.2, 7 }, { -0.42, 0.24, -6 } } do
			wrap(g, leg, "Bandage", b[1], b[2], 0, b[3], bandageTone())
		end
	end

	-- Лохмотья: ворот вокруг шеи, ленты со спины, по бокам пояса, на руках; спереди и сзади — на ногах
	put(g, "Torso", "Cowl", "Block", CFrame.new(0, 1.04, 0.06) * A(0, 0, 3), Vector3.new(1.36, 0.3, 1.16), ragColor, Mat.Fabric)
	for _, s in { -1, 1 } do
		rag(g, "Torso", "Rag", CFrame.new(0.55 * s, 0.95, 0.56) * A(-4, 0, 3 * s), 0.62, 2.05, tone(g, ragColor, 0.08), s < 0)
		rag(g, "Torso", "Rag", CFrame.new(1.03 * s, -0.92, 0.1) * A(0, 90 * s, 0), 0.6, 1.6 + rng:NextNumber(-0.15, 0.15), tone(g, ragColor, 0.08), s > 0)
	end
	for _, arm in { "Left Arm", "Right Arm" } do
		local s = arm == "Left Arm" and -1 or 1
		rag(g, arm, "ArmRag", CFrame.new(0.53 * s, -0.15, 0.05) * A(0, 90 * s, 0), 0.4, 1.05, tone(g, ragColor, 0.08), s > 0)
	end
	for _, leg in { "Left Leg", "Right Leg" } do
		local s = leg == "Left Leg" and -1 or 1
		rag(g, leg, "Rag", CFrame.new(0.06 * s, 0.98, -0.54) * A(0, 180, 0), 0.62, 1.3 + rng:NextNumber(0, 0.25), tone(g, ragColor, 0.08), s > 0)
		rag(g, leg, "Rag", CFrame.new(-0.05 * s, 0.98, 0.54), 0.66, 1.45 + rng:NextNumber(0, 0.25), tone(g, ragColor, 0.08), s < 0)
	end

	-- Дубина: позвоночник с позвонками, на конце череп (смотрит вперёд и вверх — виден и от первого лица)
	local grip = CFrame.new(0, -0.8, 0) * A(12, 0, -20)
	local arm = "Right Arm"
	shaft(g, arm, "Club", grip * CFrame.new(0, 0, -0.95), 2.35, 0.16, bone)
	for i, z in { -0.72, -1.14, -1.56 } do
		shaft(g, arm, "Club", grip * CFrame.new(0, 0, z) * A(0, 0, i * 40), 0.14, 0.3, tone(g, bone, 0.06))
	end
	local skull = grip * CFrame.new(0, 0.06, -2.36) * A(45, 0, 0)
	put(g, arm, "Skull", "Ball", skull * CFrame.new(0, 0.06, 0.04), Vector3.one * 0.64, P.Bone)
	put(g, arm, "Skull", "Block", skull * CFrame.new(0, -0.14, -0.14), Vector3.new(0.44, 0.34, 0.3), P.OldBone)
	for _, s in { -1, 1 } do
		put(g, arm, "Skull", "Block", skull * CFrame.new(0.12 * s, 0.02, -0.28), Vector3.new(0.14, 0.13, 0.06), Color3.fromRGB(22, 17, 14))
	end

	-- Колокол в левой руке: ось наклонена так, что при поднятой руке (поза Призрака) он висит отвесно
	local bell = CFrame.new(0, -0.82, -0.05) * A(-50, 0, 0)
	disc(g, "Left Arm", "Bell", bell * CFrame.new(0, -0.1, 0), 0.75, 0.15, P.DarkWood, Mat.Wood)
	put(g, "Left Arm", "Bell", "Ball", bell * CFrame.new(0, -0.52, 0), Vector3.one * 0.34, bronze, Mat.Metal)
	disc(g, "Left Arm", "Bell", bell * CFrame.new(0, -0.78, 0), 0.36, 0.6, bronze, Mat.Metal)
	disc(g, "Left Arm", "Bell", bell * CFrame.new(0, -1.08, 0), 0.32, 0.82, tone(g, bronze, 0.04), Mat.Metal)
	disc(g, "Left Arm", "Bell", bell * CFrame.new(0, -1.27, 0), 0.1, 0.94, Kit.dark(bronze, 0.25), Mat.CorrodedMetal)
	put(g, "Left Arm", "Bell", "Ball", bell * CFrame.new(0, -1.4, 0), Vector3.one * 0.2, P.Iron, Mat.Metal)
end

------------------------------------------------------------------------

function KillerGear.dress(char: Model, def)
	for _, d in char:GetDescendants() do
		if d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") or d:IsA("Accessory") or d:IsA("BodyColors") then
			d:Destroy()
		end
	end
	local head = char:FindFirstChild("Head") :: BasePart?
	if head then
		for _, d in head:GetChildren() do
			if d:IsA("Decal") then
				d:Destroy()
			end
		end
	end
	local limbs: { [string]: BasePart } = {}
	local found = 0
	for _, name in LIMBS do
		local p = char:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			limbs[name] = p
			found += 1
			p.Color = (name == "Torso" or name == "Left Leg" or name == "Right Leg") and def.ClothColor or def.BodyColor
		end
	end
	local builder = GEAR[def.Id]
	if builder and found == #LIMBS then
		-- Голову целиком заменяет снаряжение
		limbs.Head.Transparency = 1
		-- Постоянное зерно на маньяка: внешний вид одинаков в каждом матче
		local seed = 0
		for i = 1, #def.Id do
			seed += string.byte(def.Id, i) * i
		end
		builder({ char = char, limbs = limbs, rng = Random.new(seed) }, def)
	end
	-- Красное пятно перед маньяком (видят выжившие)
	if head then
		local stain = Instance.new("SpotLight")
		stain.Name = "RedStain"
		stain.Color = Color3.fromRGB(255, 20, 20)
		stain.Range = 24
		stain.Angle = 35
		stain.Brightness = 4
		stain.Face = Enum.NormalId.Front
		stain.Parent = head
	end
end

return KillerGear
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[-- Набор инструментов для моделирования из деталей (Part).
-- Все художественные модули (MapProps, Structures, Nature, KillerGear, Items, Lobby) строят модели через Kit,
-- чтобы стиль, флаги производительности и запасные варианты (CSG) были одинаковыми.
local Kit = {}

local rad = math.rad
local Mat = Enum.Material
Kit.Mat = Mat

------------------------------------------------------------------------
-- Палитра (мрачная, приглушённая, как в DBD)
------------------------------------------------------------------------

Kit.Palette = {
	Rust = Color3.fromRGB(112, 62, 38),
	DarkRust = Color3.fromRGB(70, 40, 28),
	Steel = Color3.fromRGB(120, 122, 125),
	DarkSteel = Color3.fromRGB(58, 60, 64),
	Iron = Color3.fromRGB(42, 42, 45),
	Paint = Color3.fromRGB(74, 86, 70), -- облезлая армейская краска
	Wood = Color3.fromRGB(110, 82, 55),
	OldWood = Color3.fromRGB(92, 78, 64),
	DarkWood = Color3.fromRGB(62, 46, 34),
	Plank = Color3.fromRGB(128, 100, 70),
	Bone = Color3.fromRGB(222, 212, 186),
	OldBone = Color3.fromRGB(190, 176, 146),
	Blood = Color3.fromRGB(92, 8, 8),
	DryBlood = Color3.fromRGB(60, 10, 8),
	Concrete = Color3.fromRGB(104, 102, 98),
	DarkConcrete = Color3.fromRGB(70, 69, 66),
	Brick = Color3.fromRGB(116, 62, 48),
	Plaster = Color3.fromRGB(150, 140, 120),
	Roof = Color3.fromRGB(60, 50, 46),
	Leaf = Color3.fromRGB(34, 50, 32),
	Pine = Color3.fromRGB(28, 44, 32),
	Grass = Color3.fromRGB(56, 70, 40),
	Hay = Color3.fromRGB(186, 158, 92),
	Fabric = Color3.fromRGB(90, 78, 60),
	Leather = Color3.fromRGB(70, 48, 34),
	Rubber = Color3.fromRGB(28, 28, 30),
	Warning = Color3.fromRGB(210, 170, 40),
	Wax = Color3.fromRGB(232, 222, 190),
	Flame = Color3.fromRGB(255, 170, 70),
	Neon = Color3.fromRGB(255, 220, 140),
	Black = Color3.fromRGB(18, 18, 20),
}

------------------------------------------------------------------------
-- Случайность и цвет
------------------------------------------------------------------------

-- Небольшое случайное отклонение яркости/оттенка, чтобы одинаковые детали не выглядели клонами
function Kit.jitter(color: Color3, amount: number?, rng: Random?): Color3
	local a = amount or 0.06
	local r = rng and rng:NextNumber(-a, a) or 0
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(h, math.clamp(s + r * 0.5, 0, 1), math.clamp(v + r, 0, 1))
end

function Kit.dark(color: Color3, k: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), k)
end

function Kit.A(x: number?, y: number?, z: number?): CFrame
	return CFrame.Angles(rad(x or 0), rad(y or 0), rad(z or 0))
end

------------------------------------------------------------------------
-- Детали
------------------------------------------------------------------------

export type Props = { [string]: any }

-- Базовое создание детали. Флаг Decor = мелочь без столкновений/лучей/тени.
function Kit.part(parent: Instance?, props: Props, className: string?): BasePart
	local p = Instance.new(className or "Part") :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Mat.SmoothPlastic
	local decor = props.Decor
	for k, v in props do
		if k ~= "Decor" and k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	if decor then
		Kit.decor(p)
	end
	if parent then
		p.Parent = parent
	end
	return p
end

function Kit.decor(p: BasePart)
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
end

local function merge(base: Props, extra: Props?): Props
	if extra then
		for k, v in extra do
			base[k] = v
		end
	end
	return base
end

function Kit.box(parent: Instance?, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?, extra: Props?): BasePart
	return Kit.part(parent, merge({ CFrame = cf, Size = size, Color = color, Material = material or Mat.SmoothPlastic }, extra))
end

-- Клин: наклонная грань смотрит вперёд (-Z) и вверх, высокая сторона сзади (+Z)
function Kit.wedge(parent: Instance?, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?, extra: Props?): BasePart
	return Kit.part(
		parent,
		merge({ CFrame = cf, Size = size, Color = color, Material = material or Mat.SmoothPlastic }, extra),
		"WedgePart"
	)
end

-- Цилиндр вдоль локальной оси X: length — длина, diameter — диаметр
function Kit.cyl(parent: Instance?, cf: CFrame, length: number, diameter: number, color: Color3, material: Enum.Material?, extra: Props?): BasePart
	return Kit.part(
		parent,
		merge({
			Shape = Enum.PartType.Cylinder,
			CFrame = cf,
			Size = Vector3.new(length, diameter, diameter),
			Color = color,
			Material = material or Mat.SmoothPlastic,
		}, extra)
	)
end

-- Вертикальный цилиндр (ось Y) с центром в cf
function Kit.vcyl(parent: Instance?, cf: CFrame, height: number, diameter: number, color: Color3, material: Enum.Material?, extra: Props?): BasePart
	return Kit.cyl(parent, cf * CFrame.Angles(0, 0, rad(90)), height, diameter, color, material, extra)
end

function Kit.ball(parent: Instance?, cf: CFrame, diameter: number, color: Color3, material: Enum.Material?, extra: Props?): BasePart
	return Kit.part(
		parent,
		merge({
			Shape = Enum.PartType.Ball,
			CFrame = cf,
			Size = Vector3.new(diameter, diameter, diameter),
			Color = color,
			Material = material or Mat.SmoothPlastic,
		}, extra)
	)
end

-- Брусок/палка между двумя точками (квадратное сечение thickness x depth)
function Kit.bar(parent: Instance?, a: Vector3, b: Vector3, thickness: number, color: Color3, material: Enum.Material?, extra: Props?, depth: number?): BasePart?
	local d = b - a
	local len = d.Magnitude
	if len < 1e-3 then
		return nil
	end
	local cf = CFrame.lookAt((a + b) / 2, b)
	return Kit.box(parent, cf, Vector3.new(thickness, depth or thickness, len), color, material, extra)
end

-- Цилиндр между двумя точками
function Kit.rod(parent: Instance?, a: Vector3, b: Vector3, diameter: number, color: Color3, material: Enum.Material?, extra: Props?): BasePart?
	local d = b - a
	local len = d.Magnitude
	if len < 1e-3 then
		return nil
	end
	local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, rad(90), 0)
	return Kit.cyl(parent, cf, len, diameter, color, material, extra)
end

-- Коробка со скошенными верхними рёбрами (выглядит менее «пластмассово»). 6 деталей.
function Kit.bevelBox(parent: Instance?, cf: CFrame, size: Vector3, bevel: number, color: Color3, material: Enum.Material?, extra: Props?)
	local b = math.min(bevel, size.X / 3, size.Z / 3, size.Y / 2)
	local parts = {}
	table.insert(parts, Kit.box(parent, cf * CFrame.new(0, -b / 2, 0), Vector3.new(size.X, size.Y - b, size.Z), color, material, extra))
	table.insert(parts, Kit.box(parent, cf * CFrame.new(0, size.Y / 2 - b / 2, 0), Vector3.new(size.X - 2 * b, b, size.Z - 2 * b), color, material, extra))
	local hx, hz, y = size.X / 2, size.Z / 2, size.Y / 2 - b / 2
	-- Клинья вдоль четырёх верхних рёбер
	table.insert(parts, Kit.wedge(parent, cf * CFrame.new(0, y, -hz + b / 2) * CFrame.Angles(0, 0, 0), Vector3.new(size.X - 2 * b, b, b), color, material, extra))
	table.insert(parts, Kit.wedge(parent, cf * CFrame.new(0, y, hz - b / 2) * CFrame.Angles(0, math.pi, 0), Vector3.new(size.X - 2 * b, b, b), color, material, extra))
	table.insert(parts, Kit.wedge(parent, cf * CFrame.new(-hx + b / 2, y, 0) * CFrame.Angles(0, rad(-90), 0), Vector3.new(size.Z - 2 * b, b, b), color, material, extra))
	table.insert(parts, Kit.wedge(parent, cf * CFrame.new(hx - b / 2, y, 0) * CFrame.Angles(0, rad(90), 0), Vector3.new(size.Z - 2 * b, b, b), color, material, extra))
	return parts
end

-- Дуга из цилиндров в плоскости XY локальной системы cf (угол 0 = +X, против часовой к +Y)
function Kit.arc(parent: Instance?, cf: CFrame, radius: number, a0: number, a1: number, segments: number, thickness: number, color: Color3, material: Enum.Material?, extra: Props?)
	local parts = {}
	local prev
	for i = 0, segments do
		local a = rad(a0 + (a1 - a0) * i / segments)
		local p = cf:PointToWorldSpace(Vector3.new(math.cos(a) * radius, math.sin(a) * radius, 0))
		if prev then
			local seg = Kit.rod(parent, prev, p, thickness, color, material, extra)
			if seg then
				table.insert(parts, seg)
			end
		end
		prev = p
	end
	return parts
end

-- Кольцо (полная дуга)
function Kit.ring(parent: Instance?, cf: CFrame, radius: number, segments: number, thickness: number, color: Color3, material: Enum.Material?, extra: Props?)
	return Kit.arc(parent, cf, radius, 0, 360, segments, thickness, color, material, extra)
end

-- Провисающая кривая (верёвка/кабель/цепь) между a и b
function Kit.sag(a: Vector3, b: Vector3, sag: number, n: number): { Vector3 }
	local pts = {}
	for i = 0, n do
		local t = i / n
		local p = a:Lerp(b, t) - Vector3.new(0, sag * 4 * t * (1 - t), 0)
		table.insert(pts, p)
	end
	return pts
end

function Kit.cable(parent: Instance?, points: { Vector3 }, diameter: number, color: Color3, material: Enum.Material?, extra: Props?)
	local parts = {}
	for i = 1, #points - 1 do
		local seg = Kit.rod(parent, points[i], points[i + 1], diameter, color, material, extra)
		if seg then
			table.insert(parts, seg)
		end
	end
	return parts
end

-- Цепь из чередующихся звеньев вдоль кривой
function Kit.chain(parent: Instance?, points: { Vector3 }, link: number, color: Color3, extra: Props?)
	local parts = {}
	local total = 0
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local len = (b - a).Magnitude
		local count = math.max(1, math.floor(len / link))
		for j = 0, count - 1 do
			local p0 = a:Lerp(b, j / count)
			local p1 = a:Lerp(b, (j + 1) / count)
			total += 1
			local cf = CFrame.lookAt((p0 + p1) / 2, p1) * CFrame.Angles(0, 0, total % 2 == 0 and rad(90) or 0)
			table.insert(parts, Kit.box(parent, cf, Vector3.new(link * 0.45, link * 0.12, link * 1.05), color, Mat.Metal, merge({ Decor = true }, extra)))
		end
	end
	return parts
end

-- Ряд заклёпок от a до b
function Kit.rivets(parent: Instance?, a: Vector3, b: Vector3, count: number, diameter: number, color: Color3)
	local parts = {}
	for i = 0, count - 1 do
		local t = count == 1 and 0.5 or i / (count - 1)
		table.insert(parts, Kit.ball(parent, CFrame.new(a:Lerp(b, t)), diameter, color, Mat.Metal, { Decor = true }))
	end
	return parts
end

-- Стена из досок. cf — центр стены, size — (ширина, высота, толщина); доски идут вдоль direction ("X" — горизонтально, "Y" — вертикально)
function Kit.planks(parent: Instance?, cf: CFrame, size: Vector3, options: Props?)
	local opts: Props = options or {}
	local rng: Random = opts.Rng or Random.new(1)
	local dir = opts.Direction or "X"
	local width = opts.PlankWidth or 0.9
	local gap = opts.Gap or 0.08
	local color = opts.Color or Kit.Palette.Plank
	local material = opts.Material or Mat.WoodPlanks
	local missing = opts.Missing or 0
	local tilt = opts.Tilt or 0
	local parts = {}
	local span = dir == "X" and size.Y or size.X
	local count = math.max(1, math.floor(span / (width + gap)))
	local step = span / count
	for i = 0, count - 1 do
		if rng:NextNumber() >= missing then
			local offset = -span / 2 + step * (i + 0.5)
			local plankSize, pos
			if dir == "X" then
				plankSize = Vector3.new(size.X * rng:NextNumber(0.97, 1), step - gap, size.Z)
				pos = CFrame.new(rng:NextNumber(-0.05, 0.05), offset, rng:NextNumber(-0.04, 0.04))
			else
				plankSize = Vector3.new(step - gap, size.Y * rng:NextNumber(0.94, 1), size.Z)
				pos = CFrame.new(offset, -size.Y * rng:NextNumber(0, 0.03), rng:NextNumber(-0.04, 0.04))
			end
			local rot = tilt > 0 and CFrame.Angles(0, 0, rad(rng:NextNumber(-tilt, tilt))) or CFrame.identity
			table.insert(parts, Kit.box(parent, cf * pos * rot, plankSize, Kit.jitter(color, 0.08, rng), material, opts.Extra))
		end
	end
	return parts
end

------------------------------------------------------------------------
-- Рисунки на поверхности (SurfaceGui), без загрузки текстур
------------------------------------------------------------------------

local function surface(part: BasePart, face: Enum.NormalId, ppu: number?): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = ppu or 40
	gui.LightInfluence = 1
	gui.Brightness = 1
	gui.MaxDistance = 120
	gui.Parent = part
	return gui
end

local function frame(parent: Instance, props: Props): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	for k, v in props do
		(f :: any)[k] = v
	end
	f.Parent = parent
	return f
end

-- Диагональные полосы «опасность» (жёлто-чёрные)
function Kit.hazardStripes(part: BasePart, face: Enum.NormalId, color: Color3?, count: number?)
	local gui = surface(part, face, 30)
	local holder = frame(gui, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color or Kit.Palette.Warning, ClipsDescendants = true })
	local n = count or 6
	for i = -n, n * 2 do
		frame(holder, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(i / n, 0.5),
			Size = UDim2.new(0.5 / n, 0, 3, 0),
			Rotation = 35,
			BackgroundColor3 = Kit.Palette.Black,
		})
	end
	return gui
end

-- Ржавые потёки сверху вниз
function Kit.rustStreaks(part: BasePart, face: Enum.NormalId, rng: Random, count: number?, color: Color3?)
	local gui = surface(part, face, 20)
	for _ = 1, count or 5 do
		local f = frame(gui, {
			Position = UDim2.fromScale(rng:NextNumber(0, 0.95), 0),
			Size = UDim2.fromScale(rng:NextNumber(0.02, 0.07), rng:NextNumber(0.3, 0.9)),
			BackgroundColor3 = color or Kit.Palette.DarkRust,
			BackgroundTransparency = rng:NextNumber(0.25, 0.5),
		})
		local g = Instance.new("UIGradient")
		g.Rotation = 90
		g.Transparency = NumberSequence.new(0, 1)
		g.Parent = f
	end
	return gui
end

-- Грязь/копоть: тёмный градиент снизу
function Kit.grime(part: BasePart, face: Enum.NormalId, strength: number?)
	local gui = surface(part, face, 10)
	local f = frame(gui, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0 })
	local g = Instance.new("UIGradient")
	g.Rotation = -90
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1 - (strength or 0.6)),
		NumberSequenceKeypoint.new(0.6, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	g.Parent = f
	return gui
end

-- Круглая шкала со стрелкой
function Kit.gauge(part: BasePart, face: Enum.NormalId, value: number?)
	local gui = surface(part, face, 80)
	local dial = frame(gui, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.86, 0.86),
		BackgroundColor3 = Color3.fromRGB(220, 214, 190),
	})
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = dial
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Kit.Palette.Iron
	stroke.Parent = dial
	frame(dial, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.05, 0.42),
		Rotation = -60 + 120 * (value or 0.3),
		BackgroundColor3 = Color3.fromRGB(170, 20, 20),
	})
	return gui
end

-- Надпись
function Kit.label(part: BasePart, face: Enum.NormalId, text: string, color: Color3?, font: Enum.Font?)
	local gui = surface(part, face, 40)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextScaled = true
	l.Font = font or Enum.Font.SpecialElite
	l.TextColor3 = color or Kit.Palette.Black
	l.Parent = gui
	return gui
end

-- Красный крест (аптечка)
function Kit.cross(part: BasePart, face: Enum.NormalId)
	local gui = surface(part, face, 60)
	frame(gui, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(230, 228, 220) })
	frame(gui, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.6, 0.2), BackgroundColor3 = Color3.fromRGB(190, 20, 20) })
	frame(gui, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.2, 0.6), BackgroundColor3 = Color3.fromRGB(190, 20, 20) })
	return gui
end

------------------------------------------------------------------------
-- Свет и частицы (только встроенные текстуры)
------------------------------------------------------------------------

Kit.Tex = {
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Sparkles = "rbxasset://textures/particles/sparkles_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
	FireSparks = "rbxasset://textures/particles/fire_sparks_main.dds",
}

function Kit.pointLight(parent: Instance, color: Color3, range: number, brightness: number, shadows: boolean?): PointLight
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = shadows == true
	l.Parent = parent
	return l
end

function Kit.spotLight(parent: Instance, color: Color3, range: number, angle: number, brightness: number, face: Enum.NormalId, shadows: boolean?): SpotLight
	local l = Instance.new("SpotLight")
	l.Color = color
	l.Range = range
	l.Angle = angle
	l.Brightness = brightness
	l.Face = face
	l.Shadows = shadows == true
	l.Parent = parent
	return l
end

-- Готовые наборы частиц: "Fire", "Embers", "Smoke", "Sparks", "Fog", "Fireflies", "Dust"
function Kit.emitter(parent: Instance, preset: string, scale: number?): ParticleEmitter
	local s = scale or 1
	local e = Instance.new("ParticleEmitter")
	e.Name = preset
	if preset == "Fire" then
		e.Texture = Kit.Tex.Fire
		e.Color = ColorSequence.new(Color3.fromRGB(255, 170, 60), Color3.fromRGB(255, 70, 20))
		e.LightEmission = 1
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9 * s), NumberSequenceKeypoint.new(1, 0) })
		e.Transparency = NumberSequence.new(0.1, 1)
		e.Lifetime = NumberRange.new(0.5, 1)
		e.Rate = 35
		e.Speed = NumberRange.new(2 * s, 4 * s)
		e.SpreadAngle = Vector2.new(12, 12)
		e.RotSpeed = NumberRange.new(-60, 60)
		e.Rotation = NumberRange.new(0, 360)
	elseif preset == "Embers" then
		e.Texture = Kit.Tex.FireSparks
		e.Color = ColorSequence.new(Color3.fromRGB(255, 160, 60))
		e.LightEmission = 1
		e.Size = NumberSequence.new(0.12 * s, 0)
		e.Lifetime = NumberRange.new(1.5, 3)
		e.Rate = 6
		e.Speed = NumberRange.new(2, 5)
		e.SpreadAngle = Vector2.new(25, 25)
		e.Acceleration = Vector3.new(0, 1.5, 0)
	elseif preset == "Smoke" then
		e.Texture = Kit.Tex.Smoke
		e.Color = ColorSequence.new(Color3.fromRGB(40, 40, 42))
		e.Size = NumberSequence.new(1.2 * s, 4 * s)
		e.Transparency = NumberSequence.new(0.35, 1)
		e.Lifetime = NumberRange.new(2, 4)
		e.Rate = 4
		e.Speed = NumberRange.new(1.5, 3)
		e.SpreadAngle = Vector2.new(15, 15)
		e.RotSpeed = NumberRange.new(-20, 20)
	elseif preset == "Sparks" then
		e.Texture = Kit.Tex.Sparkles
		e.Color = ColorSequence.new(Color3.fromRGB(255, 190, 80))
		e.LightEmission = 1
		e.Size = NumberSequence.new(0.3 * s, 0)
		e.Speed = NumberRange.new(10, 18)
		e.SpreadAngle = Vector2.new(70, 70)
		e.Lifetime = NumberRange.new(0.3, 0.7)
		e.Acceleration = Vector3.new(0, -40, 0)
		e.Rate = 0
	elseif preset == "Fog" then
		e.Texture = Kit.Tex.Smoke
		e.Color = ColorSequence.new(Color3.fromRGB(150, 155, 170))
		e.Size = NumberSequence.new(8 * s, 14 * s)
		e.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.3, 0.88),
			NumberSequenceKeypoint.new(1, 1),
		})
		e.Lifetime = NumberRange.new(10, 16)
		e.Rate = 0.6
		e.Speed = NumberRange.new(0.3, 1)
		e.SpreadAngle = Vector2.new(180, 10)
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-5, 5)
	elseif preset == "Fireflies" then
		e.Texture = Kit.Tex.Sparkles
		e.Color = ColorSequence.new(Color3.fromRGB(220, 255, 140))
		e.LightEmission = 1
		e.Size = NumberSequence.new(0.15 * s)
		e.Lifetime = NumberRange.new(4, 7)
		e.Rate = 1.5
		e.Speed = NumberRange.new(0.5, 1.2)
		e.SpreadAngle = Vector2.new(180, 180)
	else -- Dust
		e.Texture = Kit.Tex.Smoke
		e.Color = ColorSequence.new(Color3.fromRGB(120, 110, 95))
		e.Size = NumberSequence.new(0.6 * s, 1.6 * s)
		e.Transparency = NumberSequence.new(0.6, 1)
		e.Lifetime = NumberRange.new(1, 2)
		e.Rate = 0
		e.Speed = NumberRange.new(1, 3)
		e.SpreadAngle = Vector2.new(60, 60)
	end
	e.Parent = parent
	return e
end

------------------------------------------------------------------------
-- CSG (объединение/вычитание). Если движок не может (или мы в тестах) — остаются обычные детали.
------------------------------------------------------------------------

function Kit.union(parts: { BasePart }, name: string?): BasePart?
	if #parts < 2 then
		return parts[1]
	end
	local first = parts[1]
	local rest = table.move(parts, 2, #parts, 1, {})
	local ok, result = pcall(function()
		return (first :: any):UnionAsync(rest)
	end)
	if not ok or not result then
		return nil
	end
	local u = result :: BasePart
	u.Name = name or first.Name
	u.Anchored = true
	u.CanCollide = first.CanCollide
	u.CanQuery = first.CanQuery
	u.CanTouch = first.CanTouch
	u.CastShadow = first.CastShadow
	pcall(function()
		(u :: any).UsePartColor = true
	end)
	u.Color = first.Color
	u.Material = first.Material
	u.Parent = first.Parent
	for _, p in parts do
		p:Destroy()
	end
	return u
end

-- Вычесть cutters из base. При неудаче резаки просто удаляются, остаётся base.
function Kit.subtract(base: BasePart, cutters: { BasePart }): BasePart
	local ok, result = pcall(function()
		return (base :: any):SubtractAsync(cutters)
	end)
	for _, c in cutters do
		c:Destroy()
	end
	if not ok or not result then
		return base
	end
	local u = result :: BasePart
	u.Name = base.Name
	u.Anchored = true
	u.CanCollide = base.CanCollide
	u.CastShadow = base.CastShadow
	pcall(function()
		(u :: any).UsePartColor = true
	end)
	u.Color = base.Color
	u.Material = base.Material
	u.Parent = base.Parent
	base:Destroy()
	return u
end

------------------------------------------------------------------------
-- Модели
------------------------------------------------------------------------

function Kit.model(name: string, parent: Instance?): Model
	local m = Instance.new("Model")
	m.Name = name
	if parent then
		m.Parent = parent
	end
	return m
end

-- Назначить PrimaryPart и сделать опору модели равной origin (по умолчанию — начало координат).
-- Вызывать сразу после создания PrimaryPart и ДО Kit.movable.
function Kit.setOrigin(model: Model, primary: BasePart, origin: CFrame?)
	model.PrimaryPart = primary
	primary.PivotOffset = primary.CFrame:ToObjectSpace(origin or CFrame.identity)
end

function Kit.count(root: Instance): number
	local n = 0
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

-- Пометить подвижную деталь: группа FX и два состояния (мировые CFrame на момент постройки).
-- Хранятся относительно опоры модели (model:GetPivot()), поэтому PrimaryPart модели должен быть
-- уже назначен и сам НЕ должен быть подвижным. PropFX.setGroup(model, group, alpha) двигает детали
-- группы между CF0 (alpha = 0) и CF1 (alpha = 1).
function Kit.movable(model: Model, part: BasePart, group: string, cf0: CFrame, cf1: CFrame)
	local pivot = model:GetPivot()
	part:SetAttribute("FX", group)
	part:SetAttribute("CF0", pivot:ToObjectSpace(cf0))
	part:SetAttribute("CF1", pivot:ToObjectSpace(cf1))
	part.CFrame = cf0
end

-- Повернуть CFrame вокруг шарнира (для подготовки CF1 у дверей/крышек)
function Kit.aroundHinge(cf: CFrame, hinge: CFrame, rotation: CFrame): CFrame
	return hinge * rotation * hinge:Inverse() * cf
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">Lobby</string>
              <string name="Source"><![CDATA[-- Лобби: лагерь у костра на поляне в тёмном лесу (как главное меню DBD).
-- Lobby.build() строит модель (сиденья — Seat в группе "DBDSeats"), Lobby.spawnCFrame() — точка появления.
-- Земля — Terrain (Terrain.buildLobby); здесь только детали. Бюджет ≤ 700 деталей.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.Kit)
local Trees = require(script.Parent.NatureTrees)
local Ground = require(script.Parent.NatureGround)
local FX = require(script.Parent.NatureFX)
local Camp = require(script.Parent.LobbyCamp)
local Terrain = require(script.Parent.Parent.Terrain)

local C = CFrame.new

local Lobby = {}

-- Кольцо появления игроков (см. spawnCFrame): в полосе 11..17 от костра ничего твёрдого
local SPAWN_RADIUS = 14

-- Точка на кругу вокруг костра (угол в градусах от +X к +Z), «перед» (-Z) смотрит на костёр
local function around(center: Vector3, deg: number, r: number, turn: number?): CFrame
	local a = math.rad(deg)
	local p = center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
	return CFrame.lookAt(p, center) * CFrame.Angles(0, math.rad(turn or 0), 0)
end

-- Расстояние от точки до отрезка (в плоскости XZ)
local function segDist(p: Vector3, a: Vector3, b: Vector3): number
	local ab = (b - a) * Vector3.new(1, 0, 1)
	local t = math.clamp((p - a):Dot(ab) / ab:Dot(ab), 0, 1)
	return ((a + ab * t - p) * Vector3.new(1, 0, 1)).Magnitude
end

-- Лес вокруг поляны: три смещённых кольца (ближнее — подробные ели, дальние — силуэты),
-- деревья по равным секторам со случайным сдвигом, тропы и ограда (±57) остаются свободными.
local function forest(parent: Instance, center: Vector3, rng: Random)
	local paths = {}
	for _, deg in Terrain.LobbyPaths do
		local a = math.rad(deg)
		table.insert(paths, center + Vector3.new(math.cos(a) * 80, 0, math.sin(a) * 80))
	end
	local function onPath(p: Vector3): boolean
		for _, far in paths do
			if segDist(p, center, far) < 4.5 then
				return true
			end
		end
		return false
	end
	-- {деревьев, радиус от, радиус до, детализация}. Внешнее кольцо видно почти только из лагеря —
	-- там силуэты, повёрнутые к костру (дешевле, поэтому их больше).
	for ring, spec in { { 8, 28, 33, "mid" }, { 14, 38, 45, "far" }, { 22, 49, 80, "far" } } do
		local count, r0, r1, lod = spec[1], spec[2], spec[3], spec[4]
		for i = 1, count do
			for _ = 1, 6 do
				local a = (i + ring * 0.37 + rng:NextNumber(-0.3, 0.3)) / count * math.pi * 2
				local c, s = math.cos(a), math.sin(a)
				-- Внешнее кольцо заходит в углы квадратной ограды, но не за неё
				local rMax = math.min(r1, 57 / math.max(math.abs(c), math.abs(s)))
				local r = rng:NextNumber(r0, math.max(r0, rMax))
				local p = center + Vector3.new(c * r, 0, s * r)
				if not onPath(p) then
					local facing = ring == 3 and (center - p).Unit or nil
					Trees.pine(parent, CFrame.new(p), rng, { Lod = lod, Lowest = rng:NextNumber(3.5, 6), Scale = ring == 3 and 1.3 or 1, Facing = facing })
					break
				end
			end
		end
	end
end

function Lobby.build(): Model
	local existing = workspace:FindFirstChild("Lobby")
	if existing then
		return existing :: Model
	end
	local rng = Random.new(42)
	local lobby = Kit.model("Lobby")
	local pos = Config.LobbyPosition
	local base = CFrame.new(pos)

	-- Невидимые стены
	for _, d in
		{
			{ Vector3.new(0, 15, 60), Vector3.new(120, 30, 2) },
			{ Vector3.new(0, 15, -60), Vector3.new(120, 30, 2) },
			{ Vector3.new(60, 15, 0), Vector3.new(2, 30, 120) },
			{ Vector3.new(-60, 15, 0), Vector3.new(2, 30, 120) },
		}
	do
		Kit.box(lobby, base * C(d[1]), d[2], Color3.new(0, 0, 0), Kit.Mat.SmoothPlastic, { Name = "Barrier", Transparency = 1 })
	end

	-- Костёр и брёвна-сиденья вокруг
	Camp.firePit(lobby, base, rng)
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		local seatPos = pos + Vector3.new(math.cos(a) * 9, 0.7, math.sin(a) * 9)
		Camp.logSeat(lobby, seatPos, pos, rng)
	end

	-- Лагерь за кольцом появления: палатки, припасы, фонари, поленница, табличка
	Camp.tent(lobby, around(pos, 128, 23, -8), rng)
	Camp.tent(lobby, around(pos, 207, 22.5, 14), rng, 0.85)
	local stash = around(pos, 104, 20.5, 20)
	Camp.crate(lobby, stash, Vector3.new(2.6, 2, 2), rng, "SUPPLY 7-B")
	Camp.crate(lobby, stash * C(2.7, 0, 0.3) * CFrame.Angles(0, math.rad(-12), 0), Vector3.new(2.2, 1.8, 1.9), rng)
	Camp.crate(lobby, stash * C(0.3, 2, 0.1) * CFrame.Angles(0, math.rad(9), 0), Vector3.new(2, 1.5, 1.7), rng)
	Camp.lantern(lobby, stash * C(-0.4, 3.5, -0.2), rng)
	Camp.drum(lobby, stash * C(-2.6, 0, 0.6), rng)
	Camp.duffel(lobby, stash * C(1.2, 0, -1.9) * CFrame.Angles(0, math.rad(15), 0), rng)
	Camp.lanternPost(lobby, around(pos, 152, 18), rng)
	Camp.lanternPost(lobby, around(pos, 252, 23, 160), rng)
	Camp.woodpile(lobby, around(pos, 328, 20), rng)
	Camp.clothesline(lobby, around(pos, 18, 22), around(pos, 50, 21.5), rng)
	Camp.sign(lobby, around(pos, 270, 26), rng, "DEAD BY DAYLIGHT")

	-- Трава и папоротники у подножия построек лагеря (угол, радиус)
	for _, spot in { { 270, 27.5 }, { 262, 25 }, { 128, 27 }, { 207, 26 }, { 104, 22.5 }, { 328, 22 } } do
		Ground.tuft(lobby, around(pos, spot[1] + rng:NextNumber(-3, 3), spot[2]), rng)
	end
	for _, spot in { { 150, 27 }, { 300, 26 } } do
		Ground.fern(lobby, around(pos, spot[1], spot[2]), rng)
	end

	-- Лес и туман
	forest(lobby, pos, rng)
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local r = i == 6 and 20 or rng:NextNumber(34, 50)
		FX.fog(lobby, pos + Vector3.new(math.cos(a) * r, 1, math.sin(a) * r), rng)
	end

	lobby.Parent = workspace
	return lobby
end

-- Точка появления в лобби (по кругу у костра)
function Lobby.spawnCFrame(): CFrame
	local pos = Config.LobbyPosition
	local a = math.random() * math.pi * 2
	local p = pos + Vector3.new(math.cos(a) * SPAWN_RADIUS, 3.5, math.sin(a) * SPAWN_RADIUS)
	return CFrame.lookAt(p, Vector3.new(pos.X, p.Y, pos.Z))
end

return Lobby
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">LobbyCamp</string>
              <string name="Source"><![CDATA[-- Реквизит лагеря в лобби: кострище, бревно-сиденье, палатка, ящики, бочка, фонарь,
-- резная табличка, поленница, бельевая верёвка. cf — точка на земле, «перед» смотрит в -Z.
local Kit = require(script.Parent.Kit)
local Nature = require(script.Parent.Nature)
local Trees = require(script.Parent.NatureTrees)
local Ground = require(script.Parent.NatureGround)

local P = Kit.Palette
local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new

local Camp = {}

local DECOR = { Decor = true }
local CANVAS = Color3.fromRGB(112, 104, 78)
local BARK = Color3.fromRGB(66, 52, 40)
local CUT = Color3.fromRGB(132, 104, 74)
local IRON = Color3.fromRGB(40, 38, 36)

------------------------------------------------------------------------
-- Кострище
------------------------------------------------------------------------

-- Кострище: зола, угли, кольцо камней, «шалаш» горящих брёвен, тренога с котелком и огонь
function Camp.firePit(parent: Instance, cf: CFrame, rng: Random): BasePart
	Kit.vcyl(parent, cf * C(0, 0.05, 0), 0.1, 4.6, Color3.fromRGB(34, 31, 29), Mat.Slate, DECOR)
	-- Тлеющие угли (Neon светится в темноте)
	for _ = 1, 5 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(0.3, 1.4)
		local s = V(0.5, 0.22, 0.4) * rng:NextNumber(0.7, 1.3)
		Kit.box(parent, cf * C(math.cos(a) * r, 0.12, math.sin(a) * r) * A(rng:NextNumber(-15, 15), rng:NextNumber(0, 360), 0), s, Color3.fromRGB(150, 46, 14), Mat.Neon, DECOR)
	end
	-- Кольцо камней: изнутри закопчённые
	local n = 11
	for i = 1, n do
		local a = i / n * math.pi * 2 + rng:NextNumber(-0.08, 0.08)
		local s = V(rng:NextNumber(1, 1.5), rng:NextNumber(0.6, 1), rng:NextNumber(0.8, 1.1))
		local rot = cf * C(math.cos(a) * 2.6, 0, math.sin(a) * 2.6) * A(0, -math.deg(a) + 90 + rng:NextNumber(-15, 15), 0) * A(rng:NextNumber(-12, 12), 0, rng:NextNumber(-12, 12))
		local stone = Kit.jitter(Color3.fromRGB(84, 82, 80), 0.06, rng):Lerp(Color3.fromRGB(26, 24, 22), rng:NextNumber(0.1, 0.45))
		local p = Kit.box(parent, Ground.seat(rot, s, s.Y * 0.3), s, stone, rng:NextNumber() < 0.5 and Mat.Slate or Mat.Rock)
		p.Name = "FireStone"
	end
	-- «Шалаш» из брёвен: обугленные, сходятся над углями
	for i = 1, 5 do
		local a = i / 5 * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
		local bottom = cf * C(math.cos(a) * 1.55, 0.25, math.sin(a) * 1.55)
		local top = cf * C(math.cos(a + 0.5) * 0.2, rng:NextNumber(1.6, 1.9), math.sin(a + 0.5) * 0.2)
		local charred = Color3.fromRGB(44, 33, 26):Lerp(Color3.fromRGB(20, 18, 17), rng:NextNumber(0, 0.6))
		Kit.rod(parent, bottom.Position, top.Position, rng:NextNumber(0.42, 0.56), charred, Mat.Wood, DECOR)
	end
	-- Тренога с котелком на цепи
	local apex = cf * C(0, 5.3, 0)
	local yaw = rng:NextNumber(0, math.pi * 2)
	for i = 1, 3 do
		local a = yaw + i / 3 * math.pi * 2
		local foot = cf * C(math.cos(a) * 3.3, -0.2, math.sin(a) * 3.3)
		local dir = (apex.Position - foot.Position).Unit
		Kit.bar(parent, foot.Position, apex.Position + dir * 0.5, 0.2, Kit.jitter(P.DarkWood, 0.06, rng), Mat.Wood, DECOR)
	end
	local potTop = cf * C(0, 3.1, 0)
	Kit.chain(parent, { apex.Position - Vector3.new(0, 0.15, 0), potTop.Position + Vector3.new(0, 0.55, 0) }, 0.42, Color3.fromRGB(58, 54, 50))
	Kit.vcyl(parent, potTop * C(0, -0.4, 0), 0.8, 1.15, IRON, Mat.Metal, DECOR)
	Kit.vcyl(parent, potTop * C(0, 0.02, 0), 0.1, 1.25, Kit.dark(IRON, 0.2), Mat.Metal, DECOR)
	Kit.arc(parent, potTop * A(0, math.deg(yaw), 0), 0.6, 0, 180, 3, 0.06, IRON, Mat.Metal, DECOR)
	return Nature.fire(parent, cf * C(0, 0.6, 0), 2.2)
end

------------------------------------------------------------------------
-- Бревно-сиденье
------------------------------------------------------------------------

-- Бревно-сиденье. Сама деталь Seat — бревно (цилиндр 5 x 1.4, группа DBDSeats), смотрит на lookAt.
-- Спилы, сучок и подпорки — декор, не мешают садиться.
function Camp.logSeat(parent: Instance, pos: Vector3, lookAt: Vector3, rng: Random): Seat
	local seat = Kit.part(parent, {
		Name = "LogSeat",
		Shape = Enum.PartType.Cylinder,
		Size = V(5, 1.4, 1.4),
		CFrame = CFrame.lookAt(pos, Vector3.new(lookAt.X, pos.Y, lookAt.Z)),
		Color = Kit.jitter(BARK, 0.06, rng),
		Material = Mat.Wood,
	}, "Seat") :: Seat
	seat.CollisionGroup = "DBDSeats"
	local cf = seat.CFrame
	-- Спилы на торцах, на одном — тёмная сердцевина
	for _, s in { -1, 1 } do
		Kit.cyl(parent, cf * C(s * 2.5, 0, 0), 0.08, 1.3, Kit.jitter(CUT, 0.05, rng), Mat.Wood, DECOR)
	end
	Kit.cyl(parent, cf * C(2.55, 0, 0), 0.04, 0.55, Kit.dark(CUT, 0.3), Mat.Wood, DECOR)
	-- Обрубленный сучок
	local x = rng:NextNumber(-1.6, 1.6)
	local stub = cf * C(x, 0, 0) * A(rng:NextNumber(-70, -20), 0, 0)
	Kit.cyl(parent, stub * C(0, 0, -0.75) * A(0, 90, 0), 0.5, 0.32, Kit.dark(BARK, 0.1), Mat.Wood, DECOR)
	-- Подпорки-клинья с двух сторон, чтобы бревно не катилось
	for _, side in { -1, 1 } do
		Kit.wedge(parent, cf * C(side * 1.6, -0.5, side * 0.75) * A(0, side == 1 and 0 or 180, 0), V(0.5, 0.4, 0.5), Kit.jitter(P.DarkWood, 0.06, rng), Mat.Wood, DECOR)
	end
	return seat
end

------------------------------------------------------------------------
-- Палатка
------------------------------------------------------------------------

-- Полоса брезента между точками p и q сечения (локальная плоскость XY палатки), длиной len по Z
local function panel(parent: Instance, cf: CFrame, p: Vector3, q: Vector3, len: number, color: Color3, extra: Kit.Props?): BasePart
	local right = (q - p).Unit
	local local_ = CFrame.fromMatrix((p + q) / 2, right, Vector3.zAxis:Cross(right))
	return Kit.box(parent, cf * local_, V((q - p).Magnitude + 0.1, 0.12, len), color, Mat.Fabric, extra)
end

-- Старая армейская палатка-«домик»: брезент провисает, вход наполовину открыт, растяжки и колья.
-- Боковые полотнища твёрдые (сквозь палатку не пройти), остальное — декор.
function Camp.tent(parent: Instance, cf: CFrame, rng: Random, scale: number?)
	local k = scale or 1
	local W, H, L = 5.4 * k, 4.4 * k, 7 * k
	local canvas = Kit.jitter(CANVAS, 0.05, rng)
	local pole = Kit.jitter(P.DarkWood, 0.05, rng)
	-- Подстилка и спальник внутри
	Kit.box(parent, cf * C(0, 0.04, -0.3), V(W + 0.6, 0.08, L + 1.2), Kit.jitter(Color3.fromRGB(58, 56, 46), 0.04, rng), Mat.Fabric, DECOR)
	Kit.cyl(parent, cf * C(W * 0.18, 0.38, 0.6) * A(0, 90, 0), L * 0.55, 0.7, Kit.jitter(Color3.fromRGB(70, 74, 52), 0.05, rng), Mat.Fabric, DECOR)
	-- Конёк и А-образные стойки
	Kit.cyl(parent, cf * C(0, H, 0) * A(0, 90, 0), L + 0.8, 0.22, pole, Mat.Wood, DECOR)
	for _, z in { -L / 2 - 0.15, L / 2 + 0.15 } do
		for _, x in { -1, 1 } do
			local foot = cf * C(x * (W / 2 + 0.15), -0.1, z)
			local top = cf * C(-x * 0.25, H + 0.35, z)
			Kit.bar(parent, foot.Position, top.Position, 0.18, pole, Mat.Wood, DECOR)
		end
	end
	-- Бока: по два полотнища с провисом внутрь
	for _, x in { -1, 1 } do
		local top = V(0, H, 0)
		local bottom = V(x * W / 2, 0.12, 0)
		local mid = top:Lerp(bottom, 0.5) + V(-x * 0.2, -0.12, 0)
		local upper = panel(parent, cf, top, mid, L, canvas)
		-- Низ полотнища темнее: грязь и сырость от земли
		local lower = panel(parent, cf, mid, bottom, L, Kit.jitter(Kit.dark(canvas, 0.14), 0.03, rng))
		upper.Name, lower.Name = "Canvas", "Canvas"
		-- Заплата снаружи (у левого бока локальная Y полотнища смотрит внутрь)
		Kit.box(parent, upper.CFrame * C(rng:NextNumber(-0.6, 0.6), x * 0.07, rng:NextNumber(-L / 3, L / 3)), V(0.9, 0.04, 1.1), Kit.jitter(Color3.fromRGB(86, 82, 60), 0.05, rng), Mat.Fabric, DECOR)
	end
	-- Задняя стенка — два клина; спереди закрыта только половина, вторая скатана у стойки
	for _, x in { -1, 1 } do
		Kit.wedge(parent, cf * C(x * W / 4, H / 2, L / 2) * A(0, -x * 90, 0), V(0.12, H, W / 2), Kit.dark(canvas, 0.08), Mat.Fabric, DECOR)
	end
	Kit.wedge(parent, cf * C(W / 4, H / 2, -L / 2) * A(0, -90, 0), V(0.12, H, W / 2), Kit.dark(canvas, 0.04), Mat.Fabric, DECOR)
	Kit.rod(parent, (cf * C(-0.4, H - 0.4, -L / 2 - 0.1)).Position, (cf * C(-W / 2 + 0.5, 0.4, -L / 2 - 0.15)).Position, 0.38, Kit.dark(canvas, 0.12), Mat.Fabric, DECOR)
	-- Растяжки от конька к кольям
	for _, z in { -1, 1 } do
		local from = cf * C(0, H + 0.1, z * (L / 2 + 0.4))
		local stake = cf * C(rng:NextNumber(-0.3, 0.3), 0.15, z * (L / 2 + 2.6))
		Kit.bar(parent, from.Position, stake.Position, 0.05, Color3.fromRGB(150, 140, 110), Mat.Fabric, DECOR)
		Kit.box(parent, stake * A(z * 20, 0, 0), V(0.14, 0.6, 0.14), pole, Mat.Wood, DECOR)
	end
end

------------------------------------------------------------------------
-- Ящики, бочка, мешок
------------------------------------------------------------------------

-- Деревянный ящик: доски, обвязка, по желанию — надпись по трафарету
function Camp.crate(parent: Instance, cf: CFrame, size: Vector3, rng: Random, label: string?)
	local wood = Kit.jitter(P.Plank, 0.07, rng):Lerp(P.OldWood, rng:NextNumber(0.2, 0.6))
	local body = Kit.box(parent, cf * C(0, size.Y / 2, 0), size, wood, Mat.WoodPlanks)
	body.Name = "Crate"
	local batten = Kit.dark(wood, 0.25)
	for _, y in { -1, 1 } do
		Kit.box(parent, cf * C(0, size.Y / 2 + y * (size.Y / 2 - 0.14), -size.Z / 2 - 0.04), V(size.X + 0.04, 0.22, 0.1), batten, Mat.Wood, DECOR)
	end
	local diag = math.deg(math.atan2(size.Y - 0.5, size.X))
	Kit.box(parent, cf * C(0, size.Y / 2, -size.Z / 2 - 0.04) * A(0, 0, diag), V(math.sqrt(size.X ^ 2 + (size.Y - 0.5) ^ 2) - 0.2, 0.2, 0.08), batten, Mat.Wood, DECOR)
	if label then
		local plate = Kit.box(parent, cf * C(0, size.Y * 0.62, -size.Z / 2 - 0.1), V(size.X * 0.7, size.Y * 0.22, 0.02), wood, Mat.SmoothPlastic, { Decor = true, Transparency = 1 })
		Kit.label(plate, Enum.NormalId.Front, label, Color3.fromRGB(30, 26, 22))
	end
	Kit.grime(body, Enum.NormalId.Front, 0.5)
end

-- Ржавая бочка с обручами
function Camp.drum(parent: Instance, cf: CFrame, rng: Random)
	local rust = Kit.jitter(P.Rust, 0.08, rng):Lerp(Color3.fromRGB(60, 70, 58), rng:NextNumber(0, 0.5))
	local body = Kit.vcyl(parent, cf * C(0, 1.4, 0), 2.8, 1.9, rust, Mat.CorrodedMetal)
	body.Name = "Drum"
	for _, y in { 0.7, 2.1 } do
		Kit.vcyl(parent, cf * C(0, y, 0), 0.14, 1.98, Kit.dark(rust, 0.25), Mat.CorrodedMetal, DECOR)
	end
	Kit.vcyl(parent, cf * C(0, 2.81, 0), 0.04, 1.7, Kit.dark(rust, 0.4), Mat.CorrodedMetal, DECOR)
end

-- Вещмешок, прислонённый к чему-нибудь
function Camp.duffel(parent: Instance, cf: CFrame, rng: Random)
	local color = Kit.jitter(Color3.fromRGB(72, 76, 52), 0.06, rng)
	local bag = cf * C(0, 0.55, 0) * A(0, 0, rng:NextNumber(-8, 8))
	Kit.cyl(parent, bag, 2.2, 1.1, color, Mat.Fabric, DECOR)
	Kit.cyl(parent, bag * C(1.12, 0, 0), 0.1, 0.8, Kit.dark(color, 0.2), Mat.Leather, DECOR)
	Kit.box(parent, bag * C(0, 0.5, 0) * A(0, 0, 8), V(1.8, 0.08, 0.25), Color3.fromRGB(56, 44, 34), Mat.Leather, DECOR)
end

------------------------------------------------------------------------
-- Фонарь
------------------------------------------------------------------------

-- Керосиновый фонарь (cf — дно). Тёплый свет без теней, малый радиус.
function Camp.lantern(parent: Instance, cf: CFrame, rng: Random)
	local metal = Kit.jitter(Color3.fromRGB(58, 52, 44), 0.05, rng)
	Kit.vcyl(parent, cf * C(0, 0.09, 0), 0.18, 0.7, metal, Mat.Metal, DECOR)
	Kit.vcyl(parent, cf * C(0, 0.55, 0), 0.75, 0.55, Color3.fromRGB(255, 214, 150), Mat.Glass, { Decor = true, Transparency = 0.45 })
	local flame = Kit.ball(parent, cf * C(0, 0.5, 0), 0.22, Color3.fromRGB(255, 176, 90), Mat.Neon, DECOR)
	Kit.vcyl(parent, cf * C(0, 1.02, 0), 0.2, 0.62, metal, Mat.Metal, DECOR)
	Kit.arc(parent, cf * C(0, 1.1, 0) * A(0, rng:NextNumber(0, 180), 0), 0.32, 0, 180, 3, 0.05, Kit.dark(metal, 0.3), Mat.Metal, DECOR)
	Kit.pointLight(flame, Color3.fromRGB(255, 168, 88), 11, 1.3)
end

-- Фонарь на столбе с кронштейном
function Camp.lanternPost(parent: Instance, cf: CFrame, rng: Random)
	local wood = Kit.jitter(P.DarkWood, 0.06, rng)
	Kit.box(parent, cf * C(0, 2.6, 0) * A(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2)), V(0.35, 5.6, 0.35), wood, Mat.Wood).Name = "LanternPost"
	Kit.bar(parent, (cf * C(0, 5, 0)).Position, (cf * C(0, 5.1, -1.4)).Position, 0.16, wood, Mat.Wood, DECOR)
	Kit.bar(parent, (cf * C(0, 4.98, -1.25)).Position, (cf * C(0, 4.55, -1.25)).Position, 0.05, IRON, Mat.Metal, DECOR)
	Camp.lantern(parent, cf * C(0, 3.35, -1.25), rng)
end

------------------------------------------------------------------------
-- Табличка, поленница, верёвка
------------------------------------------------------------------------

-- Резная табличка на двух столбах под козырьком. Надпись «вырезана»: тёмные буквы со светлым краем.
function Camp.sign(parent: Instance, cf: CFrame, rng: Random, text: string)
	for _, x in { -4.7, 4.7 } do
		Kit.vcyl(parent, cf * C(x, 3, 0) * A(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2)), 6.6, 0.6, Kit.jitter(BARK, 0.06, rng), Mat.Wood).Name = "SignPost"
	end
	local board = cf * C(0, 4.2, 0)
	Kit.planks(parent, board, V(9.6, 2.7, 0.3), { Rng = Random.new(rng:NextInteger(1, 1e6)), PlankWidth = 0.8, Gap = 0.07, Color = P.OldWood, Tilt = 0.8 })
	-- Поперечины за досками
	for _, x in { -3.2, 3.2 } do
		Kit.box(parent, board * C(x, 0, 0.24), V(0.3, 3, 0.18), Kit.dark(P.OldWood, 0.2), Mat.Wood, DECOR)
	end
	-- Двускатный козырёк (крутой, с выносом над досками)
	for _, s in { -1, 1 } do
		Kit.box(parent, cf * C(0, 6.15, s * 0.42) * A(s * 42, 0, 0), V(10.8, 0.14, 1.25), Kit.jitter(P.DarkWood, 0.05, rng), Mat.WoodPlanks, DECOR)
	end
	-- Надпись на прозрачной пластине перед досками
	local face = Kit.box(parent, board * C(0, 0, -0.17), V(9.2, 2.4, 0.02), P.OldWood, Mat.SmoothPlastic, { Decor = true, Transparency = 1 })
	face.Name = "SignFace"
	local gui = Kit.label(face, Enum.NormalId.Front, text, Color3.fromRGB(46, 20, 16), Enum.Font.Creepster)
	local label = gui:FindFirstChildOfClass("TextLabel")
	if label then
		label.TextStrokeColor3 = Color3.fromRGB(160, 128, 92)
		label.TextStrokeTransparency = 0.55
	end
end

-- Поленница между двумя кольями и колода с воткнутым топором
function Camp.woodpile(parent: Instance, cf: CFrame, rng: Random)
	local rows = { 4, 3, 2 }
	for r, count in rows do
		for i = 1, count do
			local x = (i - (count + 1) / 2) * 0.72
			local d = rng:NextNumber(0.6, 0.72)
			local log = cf * C(x + rng:NextNumber(-0.05, 0.05), 0.33 + (r - 1) * 0.6, rng:NextNumber(-0.15, 0.15)) * A(0, 90 + rng:NextNumber(-4, 4), 0)
			local p = Kit.cyl(parent, log, rng:NextNumber(2.4, 2.8), d, Kit.jitter(BARK, 0.07, rng), Mat.Wood, r > 1 and DECOR or nil)
			if r == 1 then
				p.Name = "Woodpile"
			end
		end
	end
	for _, x in { -1.75, 1.75 } do
		Kit.box(parent, cf * C(x, 1, 0) * A(0, 0, x > 0 and -4 or 4), V(0.2, 2.2, 0.2), Kit.jitter(P.DarkWood, 0.05, rng), Mat.Wood, DECOR)
	end
	-- Колода с топором
	local block = cf * C(3.4, 0, -0.8)
	local top = Trees.stump(parent, block, rng, {})
	-- Лезвие наполовину в древесине, топорище смотрит вверх-назад
	local head = block * C(0.1, top - 0.05, 0) * A(0, rng:NextNumber(0, 360), 0) * A(-20, 0, 0)
	Kit.box(parent, head, V(0.14, 0.5, 0.8), Color3.fromRGB(86, 88, 90), Mat.Metal, DECOR)
	Kit.bar(parent, (head * C(0, 0.15, 0.3)).Position, (head * C(0, 1, 2.5)).Position, 0.16, Color3.fromRGB(118, 92, 62), Mat.Wood, DECOR)
end

-- Бельевая верёвка между двумя шестами, на ней сохнут тряпки
function Camp.clothesline(parent: Instance, a: CFrame, b: CFrame, rng: Random)
	local wood = Kit.jitter(P.DarkWood, 0.05, rng)
	for _, p in { a, b } do
		Kit.box(parent, p * C(0, 2.7, 0), V(0.22, 5.4, 0.22), wood, Mat.Wood, DECOR)
	end
	local pa, pb = (a * C(0, 5.1, 0)).Position, (b * C(0, 5.1, 0)).Position
	local pts = Kit.sag(pa, pb, 0.5, 4)
	Kit.cable(parent, pts, 0.05, Color3.fromRGB(150, 140, 110), Mat.Fabric, DECOR)
	local dir = (pb - pa).Unit
	for i, t in { 0.33, 0.62 } do
		local top = pa:Lerp(pb, t) - Vector3.new(0, 0.5 * 4 * t * (1 - t), 0)
		local w = rng:NextNumber(1, 1.5)
		local h = rng:NextNumber(1.2, 1.8)
		local cloth = CFrame.lookAt(top, top + dir) * A(0, 90, 0) * C(0, -h / 2, 0) * A(rng:NextNumber(-6, 6), 0, 0)
		local color = i == 1 and Color3.fromRGB(150, 140, 118) or Color3.fromRGB(104, 50, 40)
		Kit.box(parent, cloth, V(w, h, 0.05), Kit.jitter(color, 0.05, rng), Mat.Fabric, DECOR)
	end
end

return Camp
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">MapProps</string>
              <string name="Source"><![CDATA[-- Сборник шаблонов объектов карты. Каждый объект живёт в своём модуле Art/Props/<Имя>.lua,
-- который возвращает { Templates = { <Имя> = { Variants, Build(rng, variant) } }, ... }.
local Props = script.Parent.Props

local MapProps = {}
MapProps.Templates = {}

for _, name in { "Generator", "Hook", "Pallet", "Locker", "Totem", "Chest", "Hatch", "Trap", "Crow", "ExitGate" } do
	local mod = require(Props:FindFirstChild(name) :: ModuleScript)
	for templateName, def in mod.Templates do
		MapProps.Templates[templateName] = def
	end
end

-- Лапы Сущности вокруг висящего на крюке (hangPoint — мировой CFrame точки HangPoint)
MapProps.entityLegs = require(Props.Hook).entityLegs

return MapProps
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">Nature</string>
              <string name="Source"><![CDATA[-- Природа: деревья, сухие деревья, камни, кукуруза, туман, огонь, мелочи по всей карте.
-- Функции ячеек получают (map, cf, rng); cf — центр ячейки 22x22, ничего твёрдого дальше ±10.5.
-- Модули: NatureTrees (ели, сухие деревья, пни), NatureGround (камни, кукуруза, трава),
-- NatureFX (огонь, туман), NatureScatter (разброс мелочей и лес за стеной).
local Trees = require(script.Parent.NatureTrees)
local Ground = require(script.Parent.NatureGround)
local FX = require(script.Parent.NatureFX)
local Scatter = require(script.Parent.NatureScatter)

local Nature = {}

-- Группа из 2-3 елей в ячейке (≤ 40 деталей на дерево; твёрдый только ствол)
function Nature.trees(map, cf: CFrame, rng: Random)
	local count = rng:NextInteger(2, 3)
	local yaw = rng:NextNumber(0, math.pi * 2)
	for i = 1, count do
		-- Разносим деревья по кругу, чтобы кроны не слипались в один ком; первое — самое большое
		local a = yaw + i * math.pi * 2 / count + rng:NextNumber(-0.3, 0.3)
		local r = rng:NextNumber(6, 8.5)
		Trees.pine(map.Walls, cf * CFrame.new(math.cos(a) * r, 0, math.sin(a) * r), rng, { Scale = i == 1 and 1.1 or 0.85 })
	end
end

-- Сухое дерево (на нём сидят вороны)
function Nature.deadTree(map, cf: CFrame, rng: Random)
	Trees.dead(map.Walls, cf, rng)
	table.insert(map.CrowSpots, cf * CFrame.new(0, 0, 3))
end

-- Группа валунов на каменном бугре (≤ 14 деталей)
function Nature.rocks(map, cf: CFrame, rng: Random)
	Ground.rocks(map.Walls, cf, rng)
end

-- Кукурузное поле: сквозь него можно пройти и спрятаться (≤ 120 деталей, ничего не сталкивается)
function Nature.corn(map, cf: CFrame, rng: Random)
	Ground.corn(map.Decor, cf, rng)
end

-- Низкий туман (одна деталь-излучатель)
function Nature.fog(map, pos: Vector3, rng: Random)
	FX.fog(map.Decor, pos, rng)
end

-- Огонь (костёр, бочка). Возвращает невидимую деталь-источник.
function Nature.fire(parent: Instance, cf: CFrame, size: number): BasePart
	return FX.fire(parent, cf, size)
end

-- Одиночная ель (лобби, края карты)
function Nature.tree(parent: Instance, cf: CFrame, rng: Random)
	Trees.pine(parent, cf, rng)
end

-- Мелочи по всей карте и лес за внешней стеной (≤ 450 деталей)
function Nature.scatter(map, rng: Random)
	Scatter.run(map, rng)
end

return Nature
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">NatureFX</string>
              <string name="Source"><![CDATA[-- Огонь и туман: только частицы со встроенными текстурами и один тёплый свет.
local Kit = require(script.Parent.Kit)

local FX = {}

-- Невидимая деталь-источник для частиц
local function source(parent: Instance, name: string, cf: CFrame, size: Vector3): BasePart
	local p = Kit.box(parent, cf, size, Color3.new(0, 0, 0), Kit.Mat.SmoothPlastic, { Decor = true, Transparency = 1 })
	p.Name = name
	return p
end

local function attachment(parent: BasePart, offset: Vector3): Attachment
	local a = Instance.new("Attachment")
	a.Position = offset
	a.Parent = parent
	return a
end

-- Огонь: яркое ядро, языки пламени, искры, дым над огнём и тёплый неподвижный свет.
-- size — ширина очага (1 — бочка, 2-2.5 — костёр). Возвращает невидимую деталь-источник.
function FX.fire(parent: Instance, cf: CFrame, size: number): BasePart
	local p = source(parent, "FireSource", cf, Vector3.new(size, 0.4, size))
	local lift = math.sqrt(size) -- скорость подъёма: пламя костра ~2-3 стада, бочки ~1-1.5
	-- Ядро: маленькое, светлое, частое
	local core = Kit.emitter(p, "Fire", size * 0.7)
	core.Name = "FireCore"
	core.Color = ColorSequence.new(Color3.fromRGB(255, 214, 120), Color3.fromRGB(255, 120, 40))
	core.Lifetime = NumberRange.new(0.35, 0.7)
	core.Speed = NumberRange.new(1.2 * lift, 2.4 * lift)
	core.Rate = 24
	-- Языки: крупнее, темнее, выше, с лёгким сносом
	local flames = Kit.emitter(p, "Fire", size)
	flames.Name = "Flames"
	flames.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 150, 50)),
		ColorSequenceKeypoint.new(0.6, Color3.fromRGB(220, 70, 20)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 30, 10)),
	})
	flames.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(0.5, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	flames.Lifetime = NumberRange.new(0.6, 1.1)
	flames.Speed = NumberRange.new(1.5 * lift, 3 * lift)
	flames.Rate = 14
	flames.Acceleration = Vector3.new(0.4, 1.5, 0)
	-- Искры
	local embers = Kit.emitter(p, "Embers", size)
	embers.Rate = 4 + 3 * size
	-- Дым поднимается над языками пламени
	local smokeAt = attachment(p, Vector3.new(0, 1.6 * size, 0))
	local smoke = Kit.emitter(smokeAt, "Smoke", size * 0.8)
	smoke.Rate = 2 + size
	smoke.Color = ColorSequence.new(Color3.fromRGB(46, 42, 40), Color3.fromRGB(30, 30, 32))
	smoke.Acceleration = Vector3.new(0.6, 0.8, 0)
	-- Тёплый свет; тени — только у большого костра (там они окупаются)
	local light = Kit.pointLight(p, Color3.fromRGB(255, 136, 60), math.clamp(10 + 8 * size, 14, 30), 1.8, size >= 2)
	light.Name = "FireLight"
	return p
end

-- Туман у земли (одна деталь): медленные широкие клубы, иногда светлячки или пыль
function FX.fog(parent: Instance, pos: Vector3, rng: Random): BasePart
	local p = source(parent, "FogEmitter", CFrame.new(pos), Vector3.new(22, 1, 22))
	local fog = Kit.emitter(p, "Fog", rng:NextNumber(0.9, 1.3))
	fog.Color = ColorSequence.new(Color3.fromRGB(138, 146, 164), Color3.fromRGB(112, 118, 136))
	fog.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.25, 0.84),
		NumberSequenceKeypoint.new(0.7, 0.88),
		NumberSequenceKeypoint.new(1, 1),
	})
	fog.Rate = rng:NextNumber(0.5, 0.8)
	fog.Lifetime = NumberRange.new(12, 18)
	fog.Acceleration = Vector3.new(rng:NextNumber(-0.06, 0.06), -0.02, rng:NextNumber(-0.06, 0.06))
	fog.LightInfluence = 0.7
	local roll = rng:NextNumber()
	if roll < 0.35 then
		local flies = Kit.emitter(p, "Fireflies")
		flies.Rate = rng:NextNumber(0.8, 1.6)
		flies.Acceleration = Vector3.new(0, 0.15, 0)
	elseif roll < 0.55 then
		-- Пыль/пыльца, медленно оседающая в свете фонарей
		local dust = Kit.emitter(p, "Dust", 0.4)
		dust.Rate = 2
		dust.Speed = NumberRange.new(0.1, 0.4)
		dust.Lifetime = NumberRange.new(5, 8)
		dust.Transparency = NumberSequence.new(0.75, 1)
		dust.Acceleration = Vector3.new(0, -0.05, 0)
		dust.LightInfluence = 0.8
	end
	return p
end

return FX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">NatureGround</string>
              <string name="Source"><![CDATA[-- Камни, кукуруза и мелкая растительность (трава, папоротник, куст, камешки).
local Kit = require(script.Parent.Kit)
local Terrain = require(script.Parent.Parent.Terrain)

local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new

local Ground = {}

local DECOR = { Decor = true }

local STONE = {
	Color3.fromRGB(86, 86, 90),
	Color3.fromRGB(96, 92, 86),
	Color3.fromRGB(74, 76, 80),
}
local MOSS = Color3.fromRGB(64, 80, 46)

------------------------------------------------------------------------
-- Камни
------------------------------------------------------------------------

-- Поставить повёрнутую коробку так, чтобы её нижний угол ушёл в землю (y = cf.Y) на sink
local function seat(cf: CFrame, size: Vector3, sink: number): CFrame
	local r = cf.Rotation
	local hy = (math.abs(r.XVector.Y) * size.X + math.abs(r.YVector.Y) * size.Y + math.abs(r.ZVector.Y) * size.Z) / 2
	return r + Vector3.new(cf.X, cf.Y + hy - sink, cf.Z)
end
Ground.seat = seat

-- Валун из сильно наклонённых, наполовину вкопанных блоков и клина сверху: над землёй видны
-- косые плоскости сколов, а не коробка. facets = 2..4 детали; твёрдые — две основные плиты.
-- Возвращает CFrame основного блока и его размер (для мха).
local function boulder(parent: Instance, at: CFrame, size: Vector3, facets: number, rng: Random): (CFrame, Vector3)
	local color = Kit.jitter(STONE[rng:NextInteger(1, #STONE)], 0.05, rng)
	local mat = rng:NextNumber() < 0.6 and Mat.Slate or Mat.Rock
	local yaw = rng:NextNumber(0, 360)
	-- Основа — плита, наклонённая на 18-32° и почти наполовину вкопанная
	local lean = rng:NextNumber() < 0.5 and -1 or 1
	local rot = at * A(0, yaw, 0) * A(rng:NextNumber(18, 32) * lean, 0, rng:NextNumber(-12, 12))
	local core = seat(rot, size, size.Y * 0.45)
	local p = Kit.box(parent, core, size, color, mat)
	p.Name = "Rock"
	-- Вторая плита почти того же размера, развёрнута поперёк и наклонена в другую сторону:
	-- вместе они дают ломаный силуэт двух сросшихся глыб
	local side = size * V(rng:NextNumber(0.75, 0.95), rng:NextNumber(0.8, 0.95), rng:NextNumber(0.85, 1.05))
	local sideRot = at * C(rot:VectorToWorldSpace(V(size.X * 0.2, 0, 0))) * A(0, yaw + rng:NextNumber(40, 80), 0) * A(-lean * rng:NextNumber(14, 28), 0, rng:NextNumber(-18, 18))
	Kit.box(parent, seat(sideRot, side, side.Y * 0.4), side, Kit.jitter(color, 0.04, rng), mat).Name = "Rock"
	-- Клин-скол сверху с налётом мха
	if facets >= 3 then
		local top = V(size.X * rng:NextNumber(0.6, 0.8), size.Y * rng:NextNumber(0.35, 0.55), size.Z * rng:NextNumber(0.6, 0.8))
		local topRot = at * C(rot:VectorToWorldSpace(V(-size.X * 0.15, 0, 0))) * A(0, rng:NextNumber(0, 360), 0) * A(rng:NextNumber(-12, 12), 0, rng:NextNumber(-12, 12))
		Kit.wedge(parent, seat(topRot, top, -size.Y * 0.32), top, Kit.jitter(color:Lerp(MOSS, 0.22), 0.04, rng), mat, DECOR)
	end
	-- Ещё один плоский обломок у подножия
	if facets >= 4 then
		local slab = size * V(rng:NextNumber(0.5, 0.7), 0.35, rng:NextNumber(0.4, 0.6))
		local slabRot = at * C(rot:VectorToWorldSpace(V(-size.X * 0.45, 0, size.Z * 0.3))) * A(rng:NextNumber(-25, 25), rng:NextNumber(0, 360), rng:NextNumber(-25, 25))
		Kit.box(parent, seat(slabRot, slab, slab.Y * 0.3), slab, Kit.jitter(color, 0.05, rng), mat, DECOR)
	end
	return core, size
end

-- Пятно мха на верхней грани блока: косой плоский клин, наполовину утопленный в камень
local function moss(parent: Instance, core: CFrame, size: Vector3, rng: Random)
	local s = V(size.X * rng:NextNumber(0.35, 0.55), 0.2, size.Z * rng:NextNumber(0.4, 0.6))
	local cf = core * C(size.X * rng:NextNumber(-0.15, 0.15), size.Y / 2 + 0.02, size.Z * rng:NextNumber(-0.15, 0.15)) * A(0, rng:NextNumber(25, 65), 0)
	Kit.wedge(parent, cf, s, Kit.jitter(MOSS, 0.06, rng), Mat.LeafyGrass, DECOR)
end

-- Мелкий камень (1 деталь, декор)
function Ground.pebble(parent: Instance, cf: CFrame, rng: Random)
	local size = V(rng:NextNumber(0.8, 1.6), rng:NextNumber(0.35, 0.7), rng:NextNumber(0.7, 1.3))
	local rot = cf * A(rng:NextNumber(-20, 20), rng:NextNumber(0, 360), rng:NextNumber(-20, 20))
	local color = Kit.jitter(Kit.dark(STONE[rng:NextInteger(1, #STONE)], 0.1), 0.06, rng)
	if rng:NextNumber() < 0.7 then
		Kit.wedge(parent, seat(rot, size, size.Y * 0.4), size, color, Mat.Slate, DECOR)
	else
		Kit.box(parent, seat(rot, size, size.Y * 0.5), size, color, Mat.Rock, DECOR)
	end
end

-- Группа валунов (≤ 14 деталей) на каменном бугре из Terrain. Твёрдое — в радиусе ~4.5 от cf.
-- MapBuilder ставит камни и в 6 стадах перед тотемом (тотем — в -Z от cf), поэтому группа
-- смещена в +Z: подойти к тотему и обойти его можно с любой стороны.
function Ground.rocks(parent: Instance, cf: CFrame, rng: Random)
	local base = cf * C(0, 0, 0.8)
	-- Главный валун: шире, чем выше
	local main = V(rng:NextNumber(5, 6), rng:NextNumber(5, 6), rng:NextNumber(3.2, 4))
	local core, size = boulder(parent, base * C(rng:NextNumber(-0.4, 0.4), 0, rng:NextNumber(0, 0.4)), main, 4, rng)
	moss(parent, core, size, rng)
	-- Два валуна поменьше рядом, с дальней от тотема стороны
	for i = 1, 2 do
		local a = math.rad(i == 1 and rng:NextNumber(15, 70) or rng:NextNumber(110, 165))
		local d = rng:NextNumber(2.3, 2.9)
		local s = V(rng:NextNumber(1.8, 2.4), rng:NextNumber(1.3, 2.3), rng:NextNumber(1.6, 2.2))
		local c2, s2 = boulder(parent, base * C(math.cos(a) * d, 0, math.sin(a) * d), s, 4 - i, rng)
		if i == 1 then
			moss(parent, c2, s2, rng)
		end
	end
	-- Осыпь
	for _ = 1, 3 do
		local a = rng:NextNumber(0, math.pi * 2)
		local d = rng:NextNumber(3, 4.5)
		Ground.pebble(parent, base * C(math.cos(a) * d, 0, math.sin(a) * d), rng)
	end
	-- Бугор под группой (заливается вместе с ландшафтом): земляная «юбка», из неё — каменное ядро
	local p = base.Position
	Terrain.defer("FillBall", Vector3.new(p.X, -4.2, p.Z), 5.5, Enum.Material.Ground)
	Terrain.defer("FillBall", Vector3.new(p.X, -2.2, p.Z), 3.6, Enum.Material.Rock)
end

------------------------------------------------------------------------
-- Кукуруза
------------------------------------------------------------------------

local STALK = { Color3.fromRGB(150, 140, 72), Color3.fromRGB(122, 124, 60), Color3.fromRGB(166, 148, 86) }
local LEAF = { Color3.fromRGB(150, 146, 78), Color3.fromRGB(110, 118, 56), Color3.fromRGB(170, 152, 96), Color3.fromRGB(132, 112, 70) }
local HUSK = Color3.fromRGB(184, 166, 112)

-- Лист: тонкий высокий треугольник от стебля (широкое основание у стебля, кончик отклонён наружу).
-- Листья под разными углами перекрывают друг друга и закрывают обзор лучше плоских лент.
local function leaf(parent: Instance, at: CFrame, yaw: number, lean: number, len: number, width: number, rng: Random)
	local cf = at * A(0, yaw, 0) * A(-lean, 0, 0) * C(0, len / 2, -width / 2)
	Kit.wedge(parent, cf, V(0.05, len, width), Kit.jitter(LEAF[rng:NextInteger(1, #LEAF)], 0.06, rng), Mat.Grass, DECOR)
end

-- Кукурузное поле ±8.5 (≤ 120 деталей): ряды стеблей с листьями, початками и метёлками.
-- Сквозь поле можно пройти (ничего не сталкивается), но листва закрывает обзор.
function Ground.corn(parent: Instance, cf: CFrame, rng: Random)
	local count = 0
	local LIMIT = 120
	local rows = 7
	for r = 1, rows do
		local z = -7.5 + (r - 1) * 2.5 + rng:NextNumber(-0.25, 0.25)
		local x0, x1 = -8.5 + rng:NextNumber(0, 1.2), 8.5 - rng:NextNumber(0, 1.2)
		local row = cf * C(0, 0, z) * A(0, rng:NextNumber(-2, 2), 0)
		local n = rng:NextInteger(5, 6)
		for i = 0, n - 1 do
			if count > LIMIT - 4 then
				return
			end
			local x = x0 + (i + rng:NextNumber(0.15, 0.85)) * (x1 - x0) / n
			local h = rng:NextNumber(6, 9)
			local stalk = row * C(x, 0, rng:NextNumber(-0.4, 0.4)) * A(rng:NextNumber(-5, 5), rng:NextNumber(0, 360), rng:NextNumber(-5, 5))
			Kit.box(parent, stalk * C(0, h / 2 - 0.2, 0), V(0.22, h, 0.22), Kit.jitter(STALK[rng:NextInteger(1, #STALK)], 0.05, rng), Mat.Grass, DECOR)
			-- Два листа: нижний широкий и пониклый, верхний узкий и торчащий
			local yaw = rng:NextNumber(0, 360)
			leaf(parent, stalk * C(0, h * rng:NextNumber(0.12, 0.25), 0), yaw, rng:NextNumber(28, 44), h * rng:NextNumber(0.5, 0.62), rng:NextNumber(1.1, 1.6), rng)
			leaf(parent, stalk * C(0, h * rng:NextNumber(0.4, 0.55), 0), yaw + rng:NextNumber(140, 220), rng:NextNumber(14, 30), h * rng:NextNumber(0.4, 0.5), rng:NextNumber(0.8, 1.2), rng)
			count += 3
			local roll = rng:NextNumber()
			if roll < 0.3 then
				-- Початок в обёртке, отходит от стебля
				local cob = stalk * C(0, h * 0.48, 0) * A(0, yaw + 90, 0) * A(-28, 0, 0) * C(0, 0.5, -0.25)
				Kit.vcyl(parent, cob, 1, 0.36, Kit.jitter(HUSK, 0.05, rng), Mat.Fabric, DECOR)
				count += 1
			elseif roll < 0.55 then
				-- Сухая метёлка на макушке
				leaf(parent, stalk * C(0, h - 0.3, 0), yaw + 60, rng:NextNumber(4, 14), rng:NextNumber(1, 1.6), 0.45, rng)
				count += 1
			end
		end
	end
	-- Под полем — вспаханная земля
	local p = cf.Position
	Terrain.defer("FillBlock", CFrame.new(p.X, -1, p.Z) * cf.Rotation, Vector3.new(18, 2, 18), Enum.Material.Ground)
end

------------------------------------------------------------------------
-- Мелкая растительность для разброса
------------------------------------------------------------------------

local GRASS = { Color3.fromRGB(78, 88, 50), Color3.fromRGB(96, 96, 58), Color3.fromRGB(66, 80, 46), Color3.fromRGB(110, 102, 64) }

-- Пучок травы: 2-3 узких клина веером (2-3 детали)
function Ground.tuft(parent: Instance, cf: CFrame, rng: Random)
	local color = GRASS[rng:NextInteger(1, #GRASS)]
	local yaw = rng:NextNumber(0, 360)
	for k = 1, rng:NextInteger(2, 3) do
		local h = rng:NextNumber(0.9, 1.8)
		local w = rng:NextNumber(0.9, 1.6)
		local blade = cf * A(0, yaw + k * 60, 0) * A(0, 0, rng:NextNumber(-18, 18)) * C(0, h / 2 - 0.1, 0) * A(0, 90, 0)
		Kit.wedge(parent, blade, V(0.05, h, w), Kit.jitter(color, 0.06, rng), Mat.Grass, DECOR)
	end
end

-- Папоротник: розетка из 4-5 провисающих листьев (4-5 деталей)
function Ground.fern(parent: Instance, cf: CFrame, rng: Random)
	local color = Kit.jitter(Color3.fromRGB(58, 76, 42), 0.06, rng)
	local n = rng:NextInteger(4, 5)
	local yaw0 = rng:NextNumber(0, 360)
	for k = 1, n do
		local len = rng:NextNumber(1.6, 2.4)
		local cf2 = cf * C(0, 0.15, 0) * A(0, yaw0 + k * 360 / n + rng:NextNumber(-15, 15), 0) * A(rng:NextNumber(18, 34), 0, 0) * C(0, 0, -len / 2) * A(0, 0, 90)
		Kit.wedge(parent, cf2, V(0.05, rng:NextNumber(0.6, 0.8), len), Kit.jitter(color, 0.05, rng), Mat.LeafyGrass, DECOR)
	end
end

-- Куст: низкий колючий холмик из клиньев, расходящихся от центра, и пара сухих веток (5-6 деталей)
function Ground.bush(parent: Instance, cf: CFrame, rng: Random)
	local color = Kit.jitter(Color3.fromRGB(46, 60, 38), 0.06, rng)
	local r = rng:NextNumber(1.3, 1.9)
	local h = rng:NextNumber(1.2, 1.8)
	local n = 4
	local yaw0 = rng:NextNumber(0, 360)
	for k = 1, n do
		local rr = r * rng:NextNumber(0.8, 1.15)
		local hh = h * rng:NextNumber(0.75, 1.1)
		local wedge = cf * A(0, yaw0 + k * 360 / n + rng:NextNumber(-20, 20), 0) * A(rng:NextNumber(-8, 4), 0, rng:NextNumber(-12, 12)) * C(0, hh / 2 - 0.15, -rr / 2 + 0.2)
		Kit.wedge(parent, wedge, V(rr * 1.1, hh, rr), Kit.jitter(color, 0.06, rng), Mat.LeafyGrass, DECOR)
	end
	-- Сухие прутья торчат из куста
	for _ = 1, rng:NextInteger(1, 2) do
		local a = rng:NextNumber(0, math.pi * 2)
		local from = cf.Position + Vector3.new(0, 0.3, 0)
		local to = from + Vector3.new(math.cos(a) * r * 0.8, h * rng:NextNumber(0.9, 1.3), math.sin(a) * r * 0.8)
		Kit.bar(parent, from, to, 0.1, Color3.fromRGB(78, 64, 50), Mat.Wood, DECOR)
	end
end

return Ground
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">NatureScatter</string>
              <string name="Source"><![CDATA[-- Разброс мелочей по карте (≤ 450 деталей на всю карту): трава, папоротники, кусты, ветки, пни,
-- камешки — в свободных местах, чаще у подножия стен, камней и деревьев; и кольцо елей за внешней
-- стеной, чтобы мир не обрывался голыми холмами. Всё — декор (не сталкивается, не мешает лучам).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.Kit)
local Trees = require(script.Parent.NatureTrees)
local Ground = require(script.Parent.NatureGround)

local Scatter = {}

local BUDGET = 450
local CELL = 2 -- шаг сетки занятости, стад

-- Сетка занятости: клетки, над которыми у земли (ниже 4 стад) есть детали карты
type Grid = { n: number, half: number, busy: { [number]: boolean } }

local function buildGrid(root: Instance, half: number): Grid
	local n = math.ceil(half * 2 / CELL)
	local busy = {}
	for _, d in root:GetDescendants() do
		if not d:IsA("BasePart") or d.Transparency >= 1 then
			continue
		end
		local cf, s = d.CFrame, d.Size / 2
		local r = cf.Rotation
		local ex = math.abs(r.XVector.X) * s.X + math.abs(r.YVector.X) * s.Y + math.abs(r.ZVector.X) * s.Z + 0.6
		local ey = math.abs(r.XVector.Y) * s.X + math.abs(r.YVector.Y) * s.Y + math.abs(r.ZVector.Y) * s.Z
		local ez = math.abs(r.XVector.Z) * s.X + math.abs(r.YVector.Z) * s.Y + math.abs(r.ZVector.Z) * s.Z + 0.6
		if cf.Y - ey > 4 then
			continue
		end
		local x0 = math.max(0, math.floor((cf.X - ex + half) / CELL))
		local x1 = math.min(n - 1, math.floor((cf.X + ex + half) / CELL))
		local z0 = math.max(0, math.floor((cf.Z - ez + half) / CELL))
		local z1 = math.min(n - 1, math.floor((cf.Z + ez + half) / CELL))
		for ix = x0, x1 do
			for iz = z0, z1 do
				busy[ix + iz * n] = true
			end
		end
	end
	return { n = n, half = half, busy = busy }
end

-- Свободные клетки: «у края» (рядом занятая) и «открытые»
local function freeCells(g: Grid): ({ Vector3 }, { Vector3 })
	local edge, open = {}, {}
	local n = g.n
	for ix = 1, n - 2 do
		for iz = 1, n - 2 do
			if not g.busy[ix + iz * n] then
				local p = Vector3.new((ix + 0.5) * CELL - g.half, 0, (iz + 0.5) * CELL - g.half)
				local near = g.busy[ix + 1 + iz * n] or g.busy[ix - 1 + iz * n] or g.busy[ix + (iz + 1) * n] or g.busy[ix + (iz - 1) * n]
				-- Тропа к воротам по оси x = 0 остаётся чистой
				if math.abs(p.X) > 4 then
					table.insert(near and edge or open, p)
				end
			end
		end
	end
	return edge, open
end

-- Кольцо елей-силуэтов за внешней стеной (стена на ±half). Коридоры ворот (север/юг) свободны.
local function treeRing(parent: Instance, rng: Random, half: number, limit: number)
	local spots = {}
	for _, side in { Vector3.xAxis, -Vector3.xAxis, Vector3.zAxis, -Vector3.zAxis } do
		local along = Vector3.new(side.Z, 0, side.X)
		local gated = side.Z ~= 0
		local a = -half - 20 + rng:NextNumber(0, 10)
		while a < half + 20 do
			local dist = half + rng:NextNumber(5, 24)
			if not (gated and math.abs(a) < 16) then
				table.insert(spots, side * dist + along * a)
			end
			a += rng:NextNumber(24, 30)
		end
	end
	for i = #spots, 2, -1 do
		local j = rng:NextInteger(1, i)
		spots[i], spots[j] = spots[j], spots[i]
	end
	local used = 0
	for _, p in spots do
		if used + 7 > limit then
			break
		end
		local before = Kit.count(parent)
		local inward = -Vector3.new(p.X, 0, p.Z).Unit
		Trees.pine(parent, CFrame.new(p), rng, { Lod = "far", Scale = rng:NextNumber(1.35, 1.75), Lowest = rng:NextNumber(4, 9), Facing = inward })
		used += Kit.count(parent) - before
	end
	return used
end

function Scatter.run(map, rng: Random)
	local half = Config.MapSize / 2
	local folder = Instance.new("Folder")
	folder.Name = "Scatter"
	folder.Parent = map.Decor
	-- Сначала кольцо деревьев (бюджет ~230), затем мелочи на остаток
	local used = treeRing(folder, rng, half, 230)
	local edge, open = freeCells(buildGrid(map.Model, half))

	local function pick(list: { Vector3 }): Vector3?
		if #list == 0 then
			return nil
		end
		local i = rng:NextInteger(1, #list)
		local p = list[i]
		list[i] = list[#list]
		list[#list] = nil
		return p + Vector3.new(rng:NextNumber(-0.6, 0.6), 0, rng:NextNumber(-0.6, 0.6))
	end
	-- {функция, сколько, доля «у края», детали на штуку (макс.)}
	local kinds: { { any } } = {
		{ Ground.tuft, 40, 0.7, 3 },
		{ Ground.fern, 10, 0.8, 5 },
		{ Ground.bush, 7, 0.8, 6 },
		{ Ground.pebble, 12, 0.6, 1 },
		{ Trees.fallenBranch, 7, 0.3, 3 },
		{ Trees.stump, 5, 0.2, 4 },
	}
	for round = 1, 40 do
		for _, k in kinds do
			if round <= k[2] and used + k[4] <= BUDGET then
				local p = pick(rng:NextNumber() < k[3] and edge or open)
				if p then
					local before = Kit.count(folder)
					k[1](folder, CFrame.new(p) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0), rng)
					used += Kit.count(folder) - before
				end
			end
		end
	end
end

return Scatter
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">NatureTrees</string>
              <string name="Source"><![CDATA[-- Деревья: ель (с уровнями детализации), сухое дерево, пень, упавшая ветка.
-- Всё строится от точки на земле cf (y = 0); сталкивается только нижняя часть ствола.
local Kit = require(script.Parent.Kit)

local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new

local Trees = {}

local DECOR = { Decor = true }

-- Хвоя: наружные ярусы, внутренние (тёмные) и макушка
local NEEDLES = {
	Color3.fromRGB(34, 52, 40),
	Color3.fromRGB(40, 56, 38),
	Color3.fromRGB(30, 48, 44),
}
local BARK = Color3.fromRGB(64, 50, 40)
local DEAD_BARK = Color3.fromRGB(84, 76, 68)

------------------------------------------------------------------------
-- Ель
------------------------------------------------------------------------

export type PineOpts = {
	Lod: string?, -- "full" (≤ 38 деталей), "mid" (≤ 21), "far" (≤ 10, силуэт)
	Scale: number?,
	Lowest: number?, -- высота нижнего яруса хвои
	-- Для силуэтов: направление к зрителю. Ярусы тогда из двух клиньев поперёк взгляда —
	-- к зрителю они стоят треугольником (7 деталей на дерево вместо 10).
	Facing: Vector3?,
}

type SkirtOpts = {
	Droop: number,
	Width: number,
	Missing: number,
	Roll: number, -- наклон «лапы» вокруг своей оси: видны две грани и рваный кончик
	Yaw: number?, -- направление первого клина (иначе случайное)
}

-- Ярус-«юбка» из клиньев вокруг ствола. center — основание яруса на оси ствола;
-- клин стоит высокой стороной у ствола, скат смотрит наружу и чуть вниз (ветви провисают).
local function skirt(parent: Instance, center: CFrame, radius: number, height: number, n: number, color: Color3, rng: Random, o: SkirtOpts)
	local yaw0 = if o.Yaw then o.Yaw + rng:NextNumber(-20, 20) else rng:NextNumber(0, 360)
	for k = 1, n do
		if k > 2 and rng:NextNumber() < o.Missing then
			continue
		end
		local r = radius * rng:NextNumber(0.85, 1.12)
		local h = height * rng:NextNumber(0.85, 1.1)
		local yaw = yaw0 + k * 360 / n + rng:NextNumber(-14, 14)
		local roll = A(0, 0, rng:NextNumber(-o.Roll, o.Roll))
		local cf = center * A(0, yaw, 0) * A(-o.Droop * rng:NextNumber(0.6, 1.4), 0, 0) * roll * C(0, h / 2, -r / 2)
		Kit.wedge(parent, cf, V(r * o.Width, h, r), Kit.jitter(color, 0.05, rng), Mat.LeafyGrass, DECOR)
	end
end

-- Корневые наплывы у основания ствола
local function roots(parent: Instance, base: CFrame, d: number, n: number, color: Color3, rng: Random)
	local yaw0 = rng:NextNumber(0, 360)
	for k = 1, n do
		local h = d * rng:NextNumber(0.9, 1.4)
		local depth = d * rng:NextNumber(0.9, 1.3)
		local cf = base * A(0, yaw0 + k * 360 / n + rng:NextNumber(-20, 20), 0) * C(0, h / 2 - 0.25, -(depth / 2 + d * 0.22))
		Kit.wedge(parent, cf, V(d * 0.55, h, depth), Kit.dark(color, 0.1), Mat.Wood, DECOR)
	end
end

-- Ель: конус из провисающих ярусов, между ними тёмные внутренние ярусы
function Trees.pine(parent: Instance, cf: CFrame, rng: Random, opts: PineOpts?): BasePart
	local o: PineOpts = opts or {}
	local lod = o.Lod or "full"
	local s = (o.Scale or 1) * rng:NextNumber(0.85, 1.18)
	local height = rng:NextNumber(25, 33) * s
	local lowest = o.Lowest or rng:NextNumber(6.5, 8.5)
	local yawB = rng:NextNumber(0, 360)
	local base = cf * A(0, yawB, 0) * A(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3)) * C(0, -0.3, 0)
	local d = rng:NextNumber(1.4, 1.8) * math.sqrt(s)
	local bark = Kit.jitter(BARK, 0.06, rng)
	local needles = NEEDLES[rng:NextInteger(1, #NEEDLES)]

	local crown = height - lowest
	local rMax = (crown * 0.22 + 1) * rng:NextNumber(0.9, 1.1)

	-- Ствол: нижняя часть твёрдая (за ней можно спрятаться), выше — тёмная сердцевина кроны
	local trunkH = lowest + 2
	local trunk = Kit.vcyl(parent, base * C(0, trunkH / 2, 0), trunkH, d, bark, Mat.Wood)
	trunk.Name = "Trunk"
	if lod ~= "far" then
		roots(parent, base, d, lod == "full" and 3 or 2, bark, rng)
	end

	-- Ярусы: широкие внизу, узкие и крутые наверху; верхние светлее (ловят лунный свет).
	-- Между ними — тёмные внутренние ярусы поменьше: глубина кроны вместо просвета насквозь.
	local tiers = lod == "far" and 3 or 4
	local per = lod == "far" and 3 or (lod == "mid" and 4 or 6)
	local gap = crown / (tiers + 0.3)
	-- Ширина «лапы» относительно длины: у подробной ели лапы уже, их больше, и они сильнее повёрнуты
	local width = lod == "full" and 0.7 or (lod == "mid" and 0.95 or 1.05)
	local skirtOpts: SkirtOpts = { Droop = rng:NextNumber(8, 16), Width = width, Missing = lod == "full" and 0.1 or 0, Roll = lod == "full" and 18 or 10 }
	if o.Facing and lod == "far" then
		-- Клин смотрит наружу вдоль -Z после поворота на yaw: ставим клинья поперёк взгляда
		local f = cf:VectorToObjectSpace(o.Facing)
		skirtOpts.Yaw = math.deg(math.atan2(-f.X, -f.Z)) + 90 - yawB
		per = 2
	end
	local innerOpts: SkirtOpts = { Droop = 6, Width = 1.1, Missing = 0, Roll = 10 }
	local inner = Kit.dark(needles, 0.5)
	for i = 0, tiers - 1 do
		local t = i / tiers
		local y = lowest + gap * i + rng:NextNumber(-0.25, 0.25)
		local r = rMax * (1 - t) ^ 0.9 + 0.9
		local tone = Kit.dark(needles, 0.2 * (1 - t)):Lerp(Color3.fromRGB(64, 76, 52), t * 0.3)
		local center = base * C(rng:NextNumber(-0.2, 0.2), y, rng:NextNumber(-0.2, 0.2))
		-- Чем выше ярус, тем уже «лапы»: верхушка остаётся острой, без плоских граней
		skirtOpts.Width = width - t * (lod == "full" and 0.3 or 0.45)
		skirt(parent, center, r, gap * (lod == "far" and 1.2 + t * 0.4 or 1.25 - t * 0.2), per, tone, rng, skirtOpts)
		if lod == "full" and i < tiers - 1 then
			skirt(parent, base * C(0, y + gap * 0.7, 0), r * 0.78, gap * 0.95, 3, inner, rng, innerOpts)
		elseif lod == "mid" and i == 0 then
			-- Тёмная масса под кроной (одна деталь вместо внутренних ярусов)
			Kit.vcyl(parent, base * C(0, y + gap, 0), gap * 2, r * 0.9, inner, Mat.LeafyGrass, DECOR)
		end
	end
	-- Верхушка: тонкий побег над последним ярусом (у силуэта её роль играет верхний ярус)
	if lod ~= "far" then
		local topY = lowest + gap * (tiers - 0.2)
		Kit.vcyl(parent, base * C(0, (topY + height) / 2, 0), height - topY, 0.35, needles, Mat.LeafyGrass, DECOR)
	end
	return trunk
end

------------------------------------------------------------------------
-- Сухое дерево
------------------------------------------------------------------------

-- Повернуть направление на случайный угол (градусы) вокруг случайной перпендикулярной оси
local function bend(dir: Vector3, maxDeg: number, rng: Random): Vector3
	local side = dir:Cross(Vector3.yAxis)
	if side.Magnitude < 1e-3 then
		side = Vector3.xAxis
	end
	local axis = (CFrame.fromAxisAngle(dir, rng:NextNumber(0, math.pi * 2)) * side.Unit).Unit
	return (CFrame.fromAxisAngle(axis, math.rad(rng:NextNumber(-maxDeg, maxDeg))) * dir).Unit
end

-- Сухое дерево: изогнутый ствол, рекурсивные ветви, корни, обломанная верхушка (≤ 40 деталей)
function Trees.dead(parent: Instance, cf: CFrame, rng: Random): BasePart
	local LIMIT = 40
	local count = 0
	local s = rng:NextNumber(0.85, 1.15)
	local height = rng:NextNumber(18, 24) * s
	local bark = Kit.jitter(DEAD_BARK, 0.05, rng)
	local base = cf * A(0, rng:NextNumber(0, 360), 0)

	-- Деталь-брусок с перекрытием на стыках (чтобы не было щелей на изгибах)
	local function limb(a: Vector3, b: Vector3, t: number, solid: boolean?): BasePart?
		count += 1
		local dir = (b - a).Unit
		local color = Kit.jitter(rng:NextNumber() < 0.3 and Kit.dark(bark, 0.25) or bark, 0.06, rng)
		local p = Kit.bar(parent, a - dir * t * 0.35, b + dir * t * 0.25, t, color, Mat.Wood, not solid and DECOR or nil, t * rng:NextNumber(0.85, 1))
		if p then
			p.CFrame *= A(0, 0, rng:NextNumber(0, 90))
		end
		return p
	end

	-- Ствол из трёх изогнутых отрезков
	local points = { base.Position + Vector3.new(0, -0.4, 0) }
	local thick = { 1.65 * s, 1.3 * s, 0.95 * s }
	local dir = bend(Vector3.yAxis, 10, rng)
	for i, frac in { 0.42, 0.33, 0.25 } do
		dir = bend((dir + Vector3.yAxis * 0.6).Unit, 9, rng)
		table.insert(points, points[i] + dir * height * frac)
	end
	local trunk = limb(points[1], points[2], thick[1], true) :: BasePart
	trunk.Name = "DeadTrunk"
	limb(points[2], points[3], thick[2])
	limb(points[3], points[4], thick[3])
	-- Обломанная верхушка: острый скол
	local top = points[4]
	Kit.wedge(parent, CFrame.lookAt(top, top + dir) * A(-90, 0, 0) * C(0, 0.6 * s, 0) * A(0, rng:NextNumber(0, 360), 0), V(thick[3] * 0.8, 1.4 * s, thick[3] * 0.8), Kit.dark(bark, 0.1), Mat.Wood, DECOR)
	count += 1

	-- Корни уходят в землю
	local yaw0 = rng:NextNumber(0, math.pi * 2)
	for k = 1, 4 do
		local a = yaw0 + k * math.pi / 2 + rng:NextNumber(-0.4, 0.4)
		local r = rng:NextNumber(2.1, 2.9) * s
		local from = base.Position + Vector3.new(math.cos(a) * 0.3, rng:NextNumber(1.4, 2), math.sin(a) * 0.3)
		limb(from, base.Position + Vector3.new(math.cos(a) * r, -0.5, math.sin(a) * r), rng:NextNumber(0.7, 0.9) * s)
	end
	-- Дупло
	local hollowY = height * rng:NextNumber(0.18, 0.3)
	local hollowPos = points[1]:Lerp(points[2], hollowY / (height * 0.42))
	local hollowCF = CFrame.lookAt(hollowPos, hollowPos + Vector3.new(math.cos(yaw0), 0, math.sin(yaw0))) * C(0, 0, -thick[1] * 0.42)
	Kit.box(parent, hollowCF, V(thick[1] * 0.4, thick[1] * 0.7, 0.2), Color3.fromRGB(16, 13, 12), Mat.SmoothPlastic, DECOR)
	count += 1

	-- Ветви (рекурсивно, пока хватает бюджета)
	local function grow(from: Vector3, d: Vector3, len: number, t: number, depth: number)
		if count >= LIMIT then
			return
		end
		local to = from + d * len
		limb(from, to, t)
		if depth >= 3 or rng:NextNumber() < 0.12 * depth then
			return -- обломанная ветка
		end
		for _ = 1, 2 do
			local nd = bend((d + Vector3.yAxis * 0.25).Unit, rng:NextNumber(22, 42), rng)
			grow(to, nd, len * rng:NextNumber(0.55, 0.7), t * 0.62, depth + 1)
		end
	end
	-- Иногда ствол раздваивается: второй лидер уходит в сторону от середины ствола
	if rng:NextNumber() < 0.35 then
		local side = bend((dir + Vector3.new(math.cos(yaw0 + 2), 0, math.sin(yaw0 + 2)) * 0.8).Unit, 8, rng)
		grow(points[3], side, height * rng:NextNumber(0.25, 0.32), thick[3] * 0.9, 1)
	end
	local branches = rng:NextInteger(4, 5)
	for k = 1, branches do
		local h = rng:NextNumber(0.4, 0.9)
		local seg = h < 0.42 and 1 or (h < 0.75 and 2 or 3)
		local p = points[seg]:Lerp(points[seg + 1], rng:NextNumber(0.3, 0.9))
		local a = yaw0 + k * math.pi * 2 / branches + rng:NextNumber(-0.5, 0.5)
		local out = Vector3.new(math.cos(a), math.tan(math.rad(rng:NextNumber(15, 50))), math.sin(a)).Unit
		grow(p, out, rng:NextNumber(4.5, 7) * s * (1.2 - h * 0.45), thick[seg] * 0.45, 1)
	end
	return trunk
end

------------------------------------------------------------------------
-- Мелочи: пень и упавшая ветка
------------------------------------------------------------------------

-- Пень со спилом и корнями (4 детали). extra — свойства ствола (по умолчанию декор).
-- Возвращает высоту спила над cf.
function Trees.stump(parent: Instance, cf: CFrame, rng: Random, extra: Kit.Props?): number
	local d = rng:NextNumber(1.3, 2)
	local h = rng:NextNumber(0.7, 1.3)
	local bark = Kit.jitter(BARK, 0.08, rng)
	local base = cf * A(rng:NextNumber(-4, 4), rng:NextNumber(0, 360), rng:NextNumber(-4, 4))
	Kit.vcyl(parent, base * C(0, h / 2 - 0.1, 0), h, d, bark, Mat.Wood, extra or DECOR)
	-- Спил: светлая древесина, чуть наклонён
	Kit.vcyl(parent, base * C(0, h - 0.07, 0) * A(rng:NextNumber(-6, 6), 0, rng:NextNumber(-6, 6)), 0.12, d * 0.86, Kit.jitter(Color3.fromRGB(120, 98, 72), 0.06, rng), Mat.Wood, DECOR)
	roots(parent, base, d * 0.8, 2, bark, rng)
	return h - 0.05
end

-- Упавшая ветка с отростками (2-3 детали)
function Trees.fallenBranch(parent: Instance, cf: CFrame, rng: Random)
	local len = rng:NextNumber(3, 6)
	local t = rng:NextNumber(0.25, 0.45)
	local color = Kit.jitter(DEAD_BARK, 0.08, rng)
	local a = (cf * C(-len / 2, t * 0.35, 0)).Position
	local b = (cf * C(len / 2, t * 0.35, rng:NextNumber(-0.6, 0.6))).Position
	Kit.bar(parent, a, b, t, color, Mat.Wood, DECOR)
	for _ = 1, rng:NextInteger(1, 2) do
		local p = a:Lerp(b, rng:NextNumber(0.3, 0.8))
		local side = (cf * A(0, rng:NextNumber(-60, 60) + (rng:NextNumber() < 0.5 and 0 or 180), 0)).LookVector
		Kit.bar(parent, p, p + side * rng:NextNumber(1, 2) + Vector3.new(0, 0.1, 0), t * 0.5, color, Mat.Wood, DECOR)
	end
end

return Trees
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="50">
            <Properties>
              <string name="Name">Props</string>
            </Properties>
            <Item class="ModuleScript" referent="51">
              <Properties>
                <string name="Name">Chest</string>
                <string name="Source"><![CDATA[-- Сундук
-- Модель строится в начале координат: земля y = 0, «перед» модели смотрит в -Z.
-- Требования — Art/Contract.lua; подвижные части — Kit.movable (см. Map/PropFX.lua).
local Kit = require(script.Parent.Parent.Kit)

local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new

local M = {}
local T = {}
M.Templates = T

------------------------------------------------------------------------
-- Деревянный сундук: корпус на основании, оковка (полосы, углы, обод), замок, ручки по бокам.
-- Крышка (группа ChestLid) — полукруглая из досок с железными полосами, откидывается на петлях сзади.
------------------------------------------------------------------------

local W, D = 2.9, 1.9 -- корпус
local BASE_H = 0.16
local TOP = 1.55 -- верх корпуса = низ крышки
local ARCH_H = 0.5 -- высота свода крышки
local PLANKS = 4
local PLANK_T = 0.14
local BAND_X = 0.85 -- полосы оковки

local DECOR = { Decor = true }

type Style = {
	Wood: Color3,
	Iron: Color3, -- уголки, обод, ручки, накладка
	IronMat: Enum.Material,
	Band: Color3, -- полосы на корпусе и крышке: железо или кожаные ремни
	BandMat: Enum.Material,
	Lock: Color3,
	RopeHandles: boolean,
	MissingCorner: boolean,
	Ajar: number, -- крышка чуть приоткрыта в закрытом состоянии (градусы)
}

local STYLES: { Style } = {
	-- дуб, окованный чёрным железом, латунный замок
	{ Wood = Color3.fromRGB(92, 64, 44), Iron = Color3.fromRGB(46, 46, 48), IronMat = Mat.Metal, Band = Color3.fromRGB(46, 46, 48), BandMat = Mat.Metal, Lock = Color3.fromRGB(128, 106, 62), RopeHandles = false, MissingCorner = false, Ajar = 0 },
	-- серое выветренное дерево, всё в ржавчине, верёвочные ручки, крышка не закрывается до конца
	{ Wood = Color3.fromRGB(108, 98, 84), Iron = Color3.fromRGB(96, 58, 38), IronMat = Mat.CorrodedMetal, Band = Color3.fromRGB(100, 60, 40), BandMat = Mat.CorrodedMetal, Lock = Color3.fromRGB(90, 62, 44), RopeHandles = true, MissingCorner = true, Ajar = 4 },
	-- тёмный сундук с кожаными ремнями
	{ Wood = Color3.fromRGB(70, 48, 36), Iron = Color3.fromRGB(50, 50, 52), IronMat = Mat.Metal, Band = Color3.fromRGB(118, 82, 54), BandMat = Mat.Leather, Lock = Color3.fromRGB(78, 78, 80), RopeHandles = false, MissingCorner = false, Ajar = 0 },
}

-- Свод крышки: радиус и центр дуги (по хорде D и высоте ARCH_H)
local HALF = D / 2 + 0.02
local R = (HALF * HALF + ARCH_H * ARCH_H) / (2 * ARCH_H)
local CY = TOP + ARCH_H - R
local SPAN = math.deg(math.asin(HALF / R)) -- полуугол свода

-- Замочная скважина на передней грани накладки (SurfaceGui: кружок и щель)
local function keyhole(part: BasePart)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 100
	gui.LightInfluence = 1
	gui.MaxDistance = 40
	gui.Parent = part
	for _, spec in { { 0.38, 0.22, 0.32 }, { 0.56, 0.1, 0.3 } } do
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(0.5, spec[1])
		f.Size = UDim2.fromScale(spec[2] * 2, spec[3])
		f.BackgroundColor3 = Color3.fromRGB(14, 12, 10)
		f.BorderSizePixel = 0
		f.Parent = gui
		if spec[1] < 0.5 then
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0.5, 0)
			corner.Parent = f
		end
	end
end

-- Деталь на своде под углом phi (градусы от вертикали, минус — к переду), на радиусе rad
local function onArch(x: number, phi: number, rad: number): CFrame
	local a = math.rad(phi)
	return C(x, CY + rad * math.cos(a), rad * math.sin(a)) * A(phi, 0, 0)
end

T.Chest = {
	Variants = 3,
	Build = function(rng: Random, variant: number)
		local s = STYLES[variant] or STYLES[1]
		local m = Kit.model("Chest")
		m:SetAttribute("Kind", "Chest")
		local wood = Kit.jitter(s.Wood, 0.04, rng)
		local iron = Kit.jitter(s.Iron, 0.04, rng)

		-- Корпус
		local box = Kit.box(m, C(0, (BASE_H + TOP) / 2, 0), V(W, TOP - BASE_H, D), wood, Mat.WoodPlanks)
		box.Name = "Box"
		Kit.setOrigin(m, box)
		Kit.box(m, C(0, BASE_H / 2, 0), V(W + 0.08, BASE_H, D + 0.08), Kit.dark(wood, 0.35), Mat.Wood)
		-- оковка: две вертикальные полосы, обод под крышкой, уголки
		local band = Kit.jitter(s.Band, 0.04, rng)
		for _, x in { -BAND_X, BAND_X } do
			Kit.box(m, C(x, (BASE_H + TOP) / 2, 0), V(0.2, TOP - BASE_H + 0.02, D + 0.04), band, s.BandMat, DECOR)
		end
		Kit.box(m, C(0, TOP - 0.08, 0), V(W + 0.04, 0.14, D + 0.04), Kit.dark(iron, 0.1), s.IronMat, DECOR)
		for i, c in { V(-1, 0, -1), V(1, 0, -1), V(-1, 0, 1), V(1, 0, 1) } do
			if not (s.MissingCorner and i == 2) then
				Kit.box(m, C(c.X * (W / 2 - 0.06), (BASE_H + TOP) / 2, c.Z * (D / 2 - 0.06)), V(0.2, TOP - BASE_H + 0.03, 0.2), Kit.dark(iron, 0.05), s.IronMat, DECOR)
			end
		end
		-- замок с замочной скважиной
		local lock = Kit.box(m, C(0, TOP - 0.3, -D / 2 - 0.03), V(0.36, 0.44, 0.05), Kit.jitter(s.Lock, 0.05, rng), Mat.Metal, DECOR)
		keyhole(lock)
		-- ручки по бокам: железные скобы или верёвочные петли
		for _, sx in { -1, 1 } do
			local cf = C(sx * (W / 2 + 0.07), TOP - 0.55, 0)
			if s.RopeHandles then
				Kit.box(m, cf * C(0, -0.08, 0) * A(0, 0, sx * 12), V(0.06, 0.1, 0.62), Color3.fromRGB(128, 110, 80), Mat.Fabric, DECOR)
			else
				Kit.box(m, cf, V(0.07, 0.08, 0.6), Kit.dark(iron, 0.1), Mat.Metal, DECOR)
			end
		end
		-- грязь снизу по стенкам
		Kit.grime(box, Enum.NormalId.Front, 0.55)
		Kit.grime(box, Enum.NormalId.Back, 0.55)
		-- тёмное нутро (видно, когда крышка открыта), в нём свет Glow
		local cavity = Kit.box(m, C(0, TOP + 0.006, 0), V(W - 0.3, 0.012, D - 0.3), Color3.fromRGB(24, 18, 14), Mat.SmoothPlastic, DECOR)
		local glow = Kit.pointLight(cavity, Color3.fromRGB(255, 214, 140), 7, 1.4)
		glow.Name = "Glow"
		glow.Enabled = false

		-- Крышка (группа ChestLid): сердцевина из двух клиньев, доски по своду, полосы поверх досок, накладка замка
		local lid: { BasePart } = {}
		local apex = CY + (R - PLANK_T) * math.cos(math.rad(SPAN / PLANKS)) - 0.05
		for _, side in { -1, 1 } do
			local core = C(0, (TOP + apex) / 2, side * D / 4) * A(0, side < 0 and 0 or 180, 0)
			-- сердцевина отбрасывает тень за всю крышку (без столкновений)
			table.insert(lid, Kit.wedge(m, core, V(W + 0.02, apex - TOP, D / 2), Kit.dark(wood, 0.3), Mat.Wood, { CanCollide = false, CanQuery = false, CanTouch = false }))
		end
		local step = 2 * SPAN / PLANKS
		local width = 2 * R * math.sin(math.rad(step / 2)) + 0.03
		for i = 0, PLANKS - 1 do
			local phi = -SPAN + step * (i + 0.5)
			table.insert(lid, Kit.box(m, onArch(rng:NextNumber(-0.02, 0.02), phi, R - PLANK_T / 2), V(W + 0.02, PLANK_T, width), Kit.jitter(wood, 0.07, rng), Mat.Wood, DECOR))
			for _, x in { -BAND_X, BAND_X } do
				table.insert(lid, Kit.box(m, onArch(x, phi, R + 0.02), V(0.2, 0.05, width + 0.01), band, s.BandMat, DECOR))
			end
		end
		-- накладка (пробой) свисает с крышки на замок
		table.insert(lid, Kit.box(m, C(0, TOP - 0.05, -D / 2 - 0.06), V(0.16, 0.32, 0.04), Kit.dark(iron, 0.15), Mat.Metal, DECOR))

		local hinge = C(0, TOP, D / 2)
		local closed = CFrame.identity
		local shut = Kit.aroundHinge(closed, hinge, A(s.Ajar, 0, 0))
		local open = Kit.aroundHinge(closed, hinge, A(100, 0, 0))
		for _, p in lid do
			Kit.movable(m, p, "ChestLid", shut * p.CFrame, open * p.CFrame)
		end

		m:SetAttribute("Opened", false)
		return m
	end,
}

return M
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="52">
              <Properties>
                <string name="Name">Crow</string>
                <string name="Source"><![CDATA[-- Ворона
-- Модель строится в начале координат: земля y = 0, «перед» модели смотрит в -Z.
-- Требования — Art/Contract.lua; подвижные части — Kit.movable (см. Map/PropFX.lua).
local Kit = require(script.Parent.Parent.Kit)

local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new

local M = {}
local T = {}
M.Templates = T

------------------------------------------------------------------------
-- Сидящая ворона (опора — лапы на насесте, клюв в -Z). Тело наклонено: грудь вверх-вперёд,
-- хвост вниз-назад; сложенные крылья перекрещиваются над хвостом. Всё — декор без столкновений.
------------------------------------------------------------------------

local DECOR = { Decor = true }
local FEATHER = Color3.fromRGB(22, 22, 26)
local GLOSS = Color3.fromRGB(28, 30, 40) -- синеватый отлив крыльев и хвоста
local BEAK = Color3.fromRGB(36, 34, 34)

T.Crow = {
	Variants = 1,
	Build = function(rng: Random)
		local m = Kit.model("Crow")
		m:SetAttribute("Kind", "Crow")
		local body = Kit.jitter(FEATHER, 0.03, rng)
		local gloss = Kit.jitter(GLOSS, 0.03, rng)

		-- Туловище: цилиндр по оси тела (опора модели), круглая грудь и толстая шея
		local trunk = Kit.rod(m, V(0, 0.46, -0.1), V(0, 0.36, 0.32), 0.42, body, Mat.Fabric, DECOR) :: BasePart
		trunk.Name = "Body"
		Kit.setOrigin(m, trunk)
		Kit.ball(m, C(0, 0.45, -0.12), 0.48, body, Mat.Fabric, DECOR)
		Kit.ball(m, C(0, 0.64, -0.24), 0.3, body, Mat.Fabric, DECOR)

		-- Голова, клюв (надклювье и подклювье), глаза
		local head = V(0, 0.78, -0.27)
		Kit.ball(m, C(head), 0.32, body, Mat.SmoothPlastic, DECOR)
		Kit.wedge(m, C(0, 0.775, -0.49) * A(-6, 0, 0), V(0.09, 0.08, 0.26), BEAK, Mat.SmoothPlastic, DECOR)
		Kit.wedge(m, C(0, 0.72, -0.46) * A(4, 0, 180), V(0.08, 0.04, 0.2), Kit.dark(BEAK, 0.2), Mat.SmoothPlastic, DECOR)
		for _, x in { -0.115, 0.115 } do
			Kit.ball(m, C(head + V(x, 0.03, -0.08)), 0.065, Color3.fromRGB(10, 8, 6), Mat.Glass, DECOR)
		end

		-- Сложенные крылья: перевёрнутый клин — прямой верх вдоль спины, низ сходится к кончику над хвостом
		for _, sx in { -1, 1 } do
			Kit.wedge(m, C(sx * 0.15, 0.5, 0.24) * A(12, sx * -4, 0) * A(180, 0, 0), V(0.09, 0.3, 0.86), gloss, Mat.SmoothPlastic, DECOR)
		end

		-- Хвост: два слоя перьев веером вниз-назад
		Kit.box(m, C(0, 0.3, 0.64) * A(24, 0, 0), V(0.24, 0.03, 0.5), gloss, Mat.SmoothPlastic, DECOR)
		Kit.box(m, C(0, 0.27, 0.68) * A(30, rng:NextNumber(-6, 6), 0), V(0.18, 0.03, 0.5), Kit.dark(gloss, 0.15), Mat.SmoothPlastic, DECOR)

		-- Короткие лапы, чуть вынесенные вперёд
		for _, x in { -0.08, 0.08 } do
			Kit.rod(m, V(x, 0, -0.07), V(x * 1.15, 0.26, -0.01), 0.045, BEAK, Mat.SmoothPlastic, DECOR)
		end

		return m
	end,
}

return M
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="53">
              <Properties>
                <string name="Name">ExitGate</string>
                <string name="Source"><![CDATA[-- Ворота выхода: бетонная проходная (пилоны с цоколем и оголовком, ригель с двутавром), большая рифлёная
-- откатная дверь на роликах (уезжает вбок за правый пилон, в карман снаружи стены), щиток с рычагом,
-- тремя лампами и лампой питания, сирена на левом пилоне, коридор наружу и зона побега.
-- Опора — центр проёма на линии стены (стена карты: |x| >= 8, z = -1..1, высота 16); -Z внутрь карты, +Z наружу.
-- Проём 12 стад (x = -6..6), закрытая дверь его перекрывает; зона побега — там же, где и раньше.
-- Требования — Art/Contract.lua; подвижные части — Kit.movable (см. Map/PropFX.lua).
-- Switch, EscapeZone — прямые потомки модели (их ищут FindFirstChild без рекурсии).
local Kit = require(script.Parent.Parent.Kit)

local P = Kit.Palette
local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new

local M = {}
local T = {}
M.Templates = T

local SOLID = { CanCollide = false, CanQuery = false, CanTouch = false }
local DECOR = { Decor = true }

local SLIDE = V(12.6, 0, 0) -- куда уезжает дверь при открытии
local DOOR_Z = 1.85 -- плоскость полотна двери (снаружи стены)
local PILLAR_X, PILLAR_Z = 7.8, -0.6 -- центры пилонов (x = 6..9.6, z = -2.4..1.2)
local PILLAR_SIZE = V(3.6, 18.5, 3.6) -- выше стены и ригеля: проходную видно издалека

type Look = {
	Pillar: Color3,
	PillarMat: Enum.Material,
	Door: Color3,
	DoorMat: Enum.Material,
	Wire: boolean, -- колючая проволока на ригеле
	Cables: boolean, -- провисшие кабели между пилонами
}

local LOOKS: { Look } = {
	{ Pillar = P.Concrete, PillarMat = Mat.Concrete, Door = Color3.fromRGB(62, 66, 68), DoorMat = Mat.DiamondPlate, Wire = true, Cables = false },
	{ Pillar = Color3.fromRGB(104, 62, 50), PillarMat = Mat.Brick, Door = Color3.fromRGB(96, 60, 42), DoorMat = Mat.CorrodedMetal, Wire = false, Cables = true },
}

------------------------------------------------------------------------
-- Проходная
------------------------------------------------------------------------

-- Пилоны с цоколем, оголовком, облупленной штукатуркой и арматурой; ригель над проёмом
local function gatehouse(m: Model, rng: Random, look: Look): BasePart
	local concrete = Kit.jitter(P.Concrete, 0.03, rng)
	local lintel = Kit.box(m, C(0, 14.7, -0.6), V(19.2, 3.4, 3.2), Kit.jitter(P.DarkConcrete, 0.03, rng), Mat.Concrete)
	lintel.Name = "Frame"
	Kit.box(m, C(0, 16.58, -0.6), V(19.6, 0.35, 3.6), concrete, Mat.Concrete, SOLID)
	Kit.rustStreaks(lintel, Enum.NormalId.Front, rng, 7, Kit.dark(P.DarkRust, 0.2))
	for _, sx in { -1, 1 } do
		local x = sx * PILLAR_X
		local pillar = Kit.box(m, C(x, PILLAR_SIZE.Y / 2, PILLAR_Z), PILLAR_SIZE, Kit.jitter(look.Pillar, 0.04, rng), look.PillarMat)
		Kit.grime(pillar, Enum.NormalId.Front, 0.75)
		Kit.rustStreaks(pillar, Enum.NormalId.Front, rng, 3, Kit.dark(P.DarkConcrete, 0.3))
		local plinth = Kit.box(m, C(sx * 7.9, 0.6, PILLAR_Z), V(3.8, 1.2, 4.0), Kit.dark(concrete, 0.18), Mat.Concrete, SOLID)
		Kit.hazardStripes(plinth, Enum.NormalId.Front, Kit.dark(P.Warning, 0.35), 4)
		Kit.box(m, C(x, PILLAR_SIZE.Y + 0.25, PILLAR_Z), V(4.0, 0.5, 4.0), concrete, Mat.Concrete, SOLID)
		Kit.box(m, C(x, PILLAR_SIZE.Y + 0.65, PILLAR_Z), V(3.0, 0.3, 3.0), Kit.dark(concrete, 0.08), Mat.Concrete, DECOR)
		Kit.box(m, C(x, 7, PILLAR_Z), V(3.8, 0.4, 3.8), concrete, Mat.Concrete, DECOR)
		-- Отвалившийся кусок облицовки: под ним старая кладка (на кирпичном пилоне — бетон)
		local patch = look.PillarMat == Mat.Brick and Mat.Concrete or Mat.Brick
		local patchColor = patch == Mat.Brick and Kit.jitter(P.Brick, 0.05, rng) or Kit.dark(concrete, 0.1)
		Kit.box(m, C(x + sx * rng:NextNumber(-0.4, 0.4), rng:NextNumber(4.5, 9), PILLAR_Z - 1.82) * A(0, 0, rng:NextNumber(-8, 8)), V(1.5, 2.2, 0.06), patchColor, patch, DECOR)
	end
	-- Арматура из обломанного угла правого пилона
	for i = 0, 1 do
		local base = V(PILLAR_X + 1.2 - i * 0.5, PILLAR_SIZE.Y + 0.4, -2.1 + i * 0.3)
		Kit.rod(m, base, base + V(0.3 + i * 0.2, 1.1 - i * 0.3, -0.25), 0.1, P.Rust, Mat.CorrodedMetal, DECOR)
	end
	-- Стальной двутавр над проёмом и трафаретная табличка
	local header = Kit.box(m, C(0, 12.6, -2.3), V(12.6, 0.8, 0.5), Kit.jitter(P.DarkSteel, 0.04, rng), Mat.Metal, SOLID)
	Kit.hazardStripes(header, Enum.NormalId.Front, Kit.dark(P.Warning, 0.3), 8)
	local sign = Kit.box(m, C(0, 14.9, -2.24) * A(0, 0, -2), V(4.2, 1.3, 0.08), Kit.jitter(Color3.fromRGB(120, 116, 100), 0.05, rng), Mat.Metal, DECOR)
	Kit.label(sign, Enum.NormalId.Front, "EXIT", Color3.fromRGB(70, 22, 18))
	-- Контрфорс у левого пилона со стороны карты (справа место занимает щиток)
	Kit.wedge(m, C(-10.4, 3.5, -2.5), V(1.6, 7, 3), Kit.jitter(P.DarkConcrete, 0.04, rng), Mat.Concrete)
	return lintel
end

------------------------------------------------------------------------
-- Откатная дверь
------------------------------------------------------------------------

-- Полотно с рёбрами, ригелями, раскосами, подвесами и роликами; всё — группа GateDoor
local function door(m: Model, rng: Random, look: Look)
	local function slide(part: BasePart?)
		if part then
			Kit.movable(m, part, "GateDoor", part.CFrame, part.CFrame + SLIDE)
		end
	end
	local color = Kit.jitter(look.Door, 0.04, rng)
	local plate = Kit.box(m, C(0, 6, DOOR_Z), V(12, 12, 0.3), color, look.DoorMat)
	plate.Name = "Door"
	Kit.rustStreaks(plate, Enum.NormalId.Front, rng, 9)
	Kit.grime(plate, Enum.NormalId.Front, 0.7)
	slide(plate)
	local ribZ = DOOR_Z - 0.275
	for i = -3, 3 do
		slide(Kit.box(m, C(i * 1.7, 6, ribZ), V(0.42, 11.4, 0.25), Kit.dark(color, 0.22), Mat.Metal, DECOR))
	end
	for _, y in { 0.6, 6, 11.4 } do
		local rail = Kit.box(m, C(0, y, ribZ - 0.225), V(12, 0.45, 0.2), Kit.dark(color, 0.32), Mat.Metal, DECOR)
		if y < 1 then
			Kit.hazardStripes(rail, Enum.NormalId.Front, Kit.dark(P.Warning, 0.25), 10)
		end
		slide(rail)
	end
	-- Раскосы в двух полях между ригелями
	for _, y in { 3.3, 8.7 } do
		slide(Kit.bar(m, V(-5.6, y - 2.4, ribZ - 0.25), V(5.6, y + 2.4, ribZ - 0.25), 0.3, Kit.dark(color, 0.28), Mat.Metal, DECOR, 0.16))
	end
	-- Ручка у переднего края, подвесы и ролики на рельсе
	slide(Kit.box(m, C(-5.4, 4.2, ribZ - 0.45), V(0.16, 1.6, 0.16), P.Iron, Mat.Metal, DECOR))
	for _, x in { -4, 4 } do
		slide(Kit.box(m, C(x, 12.9, DOOR_Z - 0.3), V(0.5, 1.9, 0.12), P.DarkSteel, Mat.Metal, DECOR))
		slide(Kit.cyl(m, C(x, 13.7, DOOR_Z) * A(0, 90, 0), 0.3, 0.5, P.Iron, Mat.Metal, DECOR))
	end
end

-- Рельс над проёмом (снаружи, на кронштейнах) и карман, куда уезжает дверь
local function track(m: Model, rng: Random)
	local steel = Kit.jitter(P.DarkSteel, 0.04, rng)
	Kit.box(m, C(7.1, 13.32, DOOR_Z), V(26.2, 0.25, 0.45), steel, Mat.Metal, SOLID)
	for _, x in { -3, 7.8, 17 } do
		Kit.box(m, C(x, 13.45, 1.4), V(0.35, 0.5, 0.9), Kit.dark(steel, 0.2), Mat.Metal, DECOR)
	end
	local sheet = Kit.jitter(Color3.fromRGB(84, 78, 70), 0.05, rng)
	Kit.box(m, C(13.3, 7, 2.55), V(14.6, 14, 0.3), sheet, Mat.CorrodedMetal)
	Kit.box(m, C(20.7, 7, 1.8), V(0.6, 14, 1.8), Kit.dark(sheet, 0.2), Mat.CorrodedMetal)
	Kit.box(m, C(13.6, 14.1, 1.8), V(14.4, 0.2, 1.9), Kit.dark(sheet, 0.1), Mat.CorrodedMetal, SOLID)
end

------------------------------------------------------------------------
-- Щиток, сирена
------------------------------------------------------------------------

-- Щиток на стене справа от проёма: рычаг (группа GateLever), 3 лампы GateLamp, лампа питания, кабель-канал
local function leverBox(m: Model, rng: Random)
	local body = Kit.jitter(Color3.fromRGB(66, 72, 68), 0.04, rng)
	local cabinet = Kit.box(m, C(10.6, 3.1, -1.5), V(1.9, 2.4, 1.0), body, Mat.Metal)
	Kit.rustStreaks(cabinet, Enum.NormalId.Front, rng, 4)
	Kit.box(m, C(10.6, 4.38, -1.58) * A(-12, 0, 0), V(2.1, 0.1, 1.3), Kit.dark(body, 0.2), Mat.Metal, DECOR)
	local switch = Kit.box(m, C(10.6, 2.85, -2.05), V(1.5, 1.4, 0.1), Color3.fromRGB(50, 50, 50), Mat.Metal, DECOR)
	switch.Name = "Switch"
	-- Рычаг: вверху — ожидание (CF0), внизу — ворота открыты (CF1)
	local pivot = C(10.6, 2.75, -2.3)
	Kit.cyl(m, pivot, 0.55, 0.36, P.Iron, Mat.Metal, DECOR)
	local up, down = pivot * A(-25, 0, 0), pivot * A(-155, 0, 0)
	local arm = Kit.box(m, up * C(0, 0.65, 0), V(0.18, 1.3, 0.18), P.DarkSteel, Mat.Metal, DECOR)
	arm.Name = "Lever"
	Kit.movable(m, arm, "GateLever", up * C(0, 0.65, 0), down * C(0, 0.65, 0))
	local grip = Kit.cyl(m, up * C(0, 1.3, 0), 0.5, 0.24, Kit.dark(P.Blood, 0.1), Mat.Rubber, DECOR)
	Kit.movable(m, grip, "GateLever", up * C(0, 1.3, 0), down * C(0, 1.3, 0))
	Kit.box(m, C(10.6, 3.92, -2.03), V(1.6, 0.5, 0.08), P.Black, Mat.Metal, DECOR)
	for i = 1, 3 do
		local lamp = Kit.cyl(m, C(10.1 + (i - 1) * 0.5, 3.92, -2.1) * A(0, 90, 0), 0.12, 0.32, Color3.fromRGB(40, 0, 0), Mat.Neon, DECOR)
		lamp.Name = "GateLamp" .. i
		lamp:SetAttribute("GateLamp", i)
	end
	local power = Kit.ball(m, C(11.2, 4.55, -1.45), 0.34, Color3.fromRGB(70, 60, 40), Mat.Glass, DECOR)
	power.Name = "PowerLight"
	power:SetAttribute("PowerLight", true)
	-- Кабель-канал вверх по боку пилона к ригелю и кабель в землю
	Kit.rod(m, V(9.72, 4.3, -1.6), V(9.72, 12.6, -1.6), 0.22, P.DarkSteel, Mat.Metal, DECOR)
	Kit.box(m, C(9.8, 12.6, -1.6), V(0.4, 0.65, 0.55), Kit.dark(body, 0.15), Mat.Metal, DECOR)
	Kit.rod(m, V(11.1, 1.9, -1.5), V(11.3, -0.1, -1.6), 0.16, P.Rubber, Mat.Rubber, DECOR)
	-- Тусклый фонарь в решётке на боку пилона над щитком: щиток видно в темноте
	local lamp = Kit.box(m, C(9.88, 6.0, -1.7), V(0.55, 0.5, 0.5), P.Iron, Mat.Metal, DECOR)
	local glass = Kit.box(m, C(10.18, 6.0, -1.7), V(0.08, 0.34, 0.34), Color3.fromRGB(200, 170, 110), Mat.Glass, DECOR)
	Kit.pointLight(glass, Color3.fromRGB(255, 190, 120), 12, 0.9)
	Kit.box(m, lamp.CFrame * C(0, 0.3, -0.05) * A(-15, 0, 0), V(0.7, 0.06, 0.65), Kit.dark(body, 0.25), Mat.Metal, DECOR)
end

-- Сирена на оголовке левого пилона: светит вдоль проёма внутрь карты, пока ворота открывают
local function siren(m: Model)
	local x, y, z = -PILLAR_X + 0.4, PILLAR_SIZE.Y + 0.8, PILLAR_Z - 0.7
	Kit.vcyl(m, C(x, y + 0.18, z), 0.36, 0.9, P.Iron, Mat.Metal, DECOR)
	local dome = Kit.ball(m, C(x, y + 0.48, z), 0.86, Color3.fromRGB(80, 10, 10), Mat.Glass, DECOR)
	dome.Name = "Siren"
	local light = Kit.spotLight(dome, Color3.fromRGB(255, 30, 20), 28, 60, 4, Enum.NormalId.Front)
	light.Name = "SirenLight"
	light.Enabled = false
	Kit.vcyl(m, C(x, y + 0.92, z), 0.12, 0.4, P.Iron, Mat.Metal, DECOR)
end

------------------------------------------------------------------------
-- Коридор наружу и зона побега
------------------------------------------------------------------------

local function corridor(m: Model, rng: Random)
	Kit.box(m, C(0, -0.5, 16.6), V(12, 1, 28.4), Kit.jitter(Color3.fromRGB(56, 48, 40), 0.04, rng), Mat.Ground)
	local wall = Kit.jitter(P.DarkConcrete, 0.04, rng)
	-- справа стена начинается за карманом двери
	for _, w in { { x = -6.75, z0 = 1.2 }, { x = 6.75, z0 = 2.7 } } do
		local len = 30.75 - w.z0
		Kit.box(m, C(w.x, 6.5, w.z0 + len / 2), V(1.5, 13, len), wall, Mat.Concrete)
		local inward = w.x < 0 and 1 or -1
		for _, z in { 11, 21 } do
			Kit.box(m, C(w.x + inward * 0.9, 6.5, z), V(0.3, 13, 0.9), Kit.dark(wall, 0.12), Mat.Concrete, SOLID)
		end
	end
	-- Обломки на полу коридора
	for i = 1, 3 do
		local s = V(rng:NextNumber(0.6, 1.3), rng:NextNumber(0.3, 0.6), rng:NextNumber(0.5, 1.1))
		Kit.box(m, C(rng:NextNumber(-4.5, 4.5), s.Y / 2 - 0.05, 4 + i * 4.5) * A(0, rng:NextNumber(0, 180), rng:NextNumber(-8, 8)), s, Kit.jitter(P.DarkConcrete, 0.08, rng), Mat.Concrete, DECOR)
	end
	local escape = Kit.box(m, C(0, 6, 24), V(12, 12, 10), Color3.new(1, 1, 1), Mat.ForceField, { Decor = true, Transparency = 0.6 })
	escape.Name = "EscapeZone"
	-- свет «в конце коридора»; радиус не дотягивается сквозь закрытую дверь внутрь карты
	Kit.pointLight(escape, Color3.fromRGB(235, 240, 255), 24, 2)
end

------------------------------------------------------------------------
-- Мелочи: колючая проволока, кабели, обломки у пилонов
------------------------------------------------------------------------

local function dressing(m: Model, rng: Random, look: Look)
	if look.Wire then
		local posts = {}
		for i, x in { -9.2, -3, 3.2, 9.2 } do
			local base = V(x, 16.7, -0.6 + (i % 2) * 0.3)
			local top = base + V(0, 1.4, -0.35)
			Kit.rod(m, base, top, 0.12, P.Iron, Mat.Metal, DECOR)
			table.insert(posts, top)
		end
		for i = 1, #posts - 1 do
			Kit.cable(m, Kit.sag(posts[i] - V(0, 0.15, 0), posts[i + 1] - V(0, 0.15, 0), 0.35, 2), 0.06, P.DarkSteel, Mat.Metal, DECOR)
			Kit.cable(m, Kit.sag(posts[i] - V(0, 0.75, 0), posts[i + 1] - V(0, 0.75, 0), 0.25, 1), 0.06, P.DarkSteel, Mat.Metal, DECOR)
		end
	end
	if look.Cables then
		Kit.cable(m, Kit.sag(V(-6.2, 11.4, -2.45), V(6.2, 11.6, -2.45), 1.8, 4), 0.14, P.Rubber, Mat.Rubber, DECOR)
		Kit.cable(m, Kit.sag(V(-6.2, 12.2, -2.5), V(4.0, 12.1, -2.5), 1.1, 3), 0.1, P.Black, Mat.Rubber, DECOR)
	end
	-- Ржавая бочка рядом со щитком
	local drum = C(12.7, 1.35, -2.3)
	local rust = Kit.jitter(Color3.fromRGB(92, 52, 36), 0.05, rng)
	Kit.vcyl(m, drum, 2.7, 1.8, rust, Mat.CorrodedMetal)
	for _, dy in { -0.45, 0.45 } do
		Kit.vcyl(m, drum * C(0, dy, 0), 0.1, 1.86, Kit.dark(rust, 0.25), Mat.CorrodedMetal, DECOR)
	end
	for i = 1, 4 do
		local sx = i <= 2 and -1 or 1
		local s = V(rng:NextNumber(0.5, 1.1), rng:NextNumber(0.3, 0.7), rng:NextNumber(0.5, 0.9))
		local pos = V(sx * rng:NextNumber(5.4, 10.5), s.Y * 0.35, rng:NextNumber(-3.6, -2.8))
		if math.abs(pos.X) < 6 then
			pos = V(sx * 6.4, pos.Y, -3.0)
		end
		Kit.box(m, C(pos) * A(rng:NextNumber(-12, 12), rng:NextNumber(0, 180), rng:NextNumber(-12, 12)), s, Kit.jitter(P.Concrete, 0.08, rng), Mat.Concrete, DECOR)
	end
end

T.ExitGate = {
	Variants = #LOOKS,
	Build = function(rng: Random, variant: number)
		local look = LOOKS[(variant - 1) % #LOOKS + 1]
		local m = Kit.model("ExitGate")
		m:SetAttribute("Kind", "ExitGate")
		local frame = gatehouse(m, rng, look)
		Kit.setOrigin(m, frame)
		door(m, rng, look)
		track(m, rng)
		leverBox(m, rng)
		siren(m)
		corridor(m, rng)
		dressing(m, rng, look)
		m:SetAttribute("Powered", false)
		m:SetAttribute("Progress", 0)
		m:SetAttribute("Open", false)
		return m
	end,
}

return M
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="54">
              <Properties>
                <string name="Name">Generator</string>
                <string name="Source"><![CDATA[-- Генератор (как в DBD): стальные салазки на опорах, двигатель с рёбрами охлаждения и двумя поршнями,
-- маховик с ремнём, динамо, топливный бак, выхлоп, щиток со шкалами и 4 лампами прогресса, лампа в клетке.
-- Модель строится в начале координат: земля y = 0, «перед» модели смотрит в -Z.
-- Сталкивается только невидимый корпус Body 4x3x3 (центр y = 2): его обходят и чинят со всех четырёх сторон,
-- поэтому всё видимое — без столкновений и почти не выступает за его габарит.
-- Требования — Art/Contract.lua; поршни (AnimatedPiston) качает клиент (client/Effects.lua) по своей оси X.
local Kit = require(script.Parent.Parent.Kit)

local P = Kit.Palette
local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new

local M = {}
local T = {}
M.Templates = T

-- Крупные видимые детали: не сталкиваются (это делает корпус), но отбрасывают тень
local SOLID = { CanCollide = false, CanQuery = false, CanTouch = false }
local DECOR = { Decor = true }

local LIGHT_OFF = Color3.fromRGB(45, 40, 30) -- как в PropFX

-- Варианты окраски и набора деталей (геймплей одинаковый)
type Look = {
	Paint: Color3, -- краска корпусов
	Tank: Color3, -- топливный бак
	Engine: Color3, -- чугун двигателя
	TwinExhaust: boolean,
	JerryCan: boolean,
	Damaged: boolean, -- погнутая клетка, сорванная крышка щитка, тряпка
}

local LOOKS: { Look } = {
	{ Paint = Color3.fromRGB(70, 84, 66), Tank = Color3.fromRGB(96, 40, 32), Engine = Color3.fromRGB(54, 56, 58), TwinExhaust = true, JerryCan = false, Damaged = false },
	{ Paint = Color3.fromRGB(104, 62, 50), Tank = Color3.fromRGB(66, 72, 58), Engine = Color3.fromRGB(48, 46, 46), TwinExhaust = false, JerryCan = true, Damaged = false },
	{ Paint = Color3.fromRGB(110, 98, 68), Tank = Color3.fromRGB(88, 54, 36), Engine = Color3.fromRGB(58, 56, 52), TwinExhaust = false, JerryCan = false, Damaged = true },
}

-- Цилиндр вдоль мировой оси Z (торец Right смотрит в -Z)
local function zcyl(m: Model, pos: Vector3, length: number, diameter: number, color: Color3, material: Enum.Material, extra: Kit.Props?): BasePart
	return Kit.cyl(m, C(pos) * A(0, 90, 0), length, diameter, color, material, extra)
end

-- Салазки: два полоза со скошенными концами на четырёх опорах, рифлёная палуба
local function skid(m: Model, rng: Random, look: Look)
	local frame = Kit.jitter(P.DarkRust, 0.04, rng)
	for _, z in { -1.2, 1.2 } do
		Kit.box(m, C(0, 0.36, z), V(3.8, 0.42, 0.36), frame, Mat.CorrodedMetal, SOLID)
		for _, sx in { -1, 1 } do
			-- клин: высокая сторона смотрит внутрь, скос — наружу
			Kit.wedge(m, C(sx * 2.06, 0.36, z) * A(0, -sx * 90, 0), V(0.36, 0.42, 0.32), frame, Mat.CorrodedMetal, DECOR)
			Kit.box(m, C(sx * 1.6, 0.075, z), V(0.62, 0.15, 0.62), Kit.dark(frame, 0.3), Mat.Metal, DECOR)
		end
	end
	Kit.box(m, C(0, 0.64, 0), V(4, 0.14, 2.9), Kit.jitter(Kit.dark(look.Paint, 0.35), 0.03, rng), Mat.DiamondPlate, SOLID)
end

-- Двигатель: картер, блок с рёбрами, головка, две гильзы с поршнями
local function engine(m: Model, rng: Random, look: Look)
	local iron = Kit.jitter(look.Engine, 0.03, rng)
	local crank = Kit.box(m, C(-0.95, 1.35, 0.05), V(1.9, 1.28, 2.1), iron, Mat.Metal, SOLID)
	Kit.grime(crank, Enum.NormalId.Front, 0.7)
	Kit.box(m, C(-0.95, 2.4, 0.05), V(1.5, 0.82, 1.6), Kit.dark(iron, 0.15), Mat.Metal, SOLID)
	for i = 0, 2 do
		Kit.box(m, C(-0.95, 2.14 + i * 0.26, 0.05), V(1.8, 0.07, 1.9), Kit.jitter(P.DarkSteel, 0.04, rng), Mat.Metal, DECOR)
	end
	Kit.box(m, C(-0.95, 2.98, 0.05), V(1.7, 0.34, 1.75), Kit.jitter(look.Paint, 0.04, rng), Mat.Metal, SOLID)
	for i, x in { -1.35, -0.55 } do
		Kit.vcyl(m, C(x, 3.42, 0.05), 0.55, 0.62, P.DarkSteel, Mat.Metal, DECOR)
		local rod = Kit.vcyl(m, C(x, 3.95, 0.05), 1.0, 0.4, Kit.jitter(P.Steel, 0.05, rng), Mat.Metal, DECOR)
		rod.Name = "Piston" .. i
		rod:SetAttribute("AnimatedPiston", true)
	end
end

-- Маховик на левом торце, шкив вентилятора и ремень между ними
local function flywheel(m: Model, rng: Random)
	local iron = Kit.jitter(P.Iron, 0.04, rng)
	local c1, r1 = V(-2.05, 1.62, -0.25), 0.9
	local c2, r2 = V(-2.05, 3.0, 0.5), 0.3
	Kit.cyl(m, C(c1), 0.22, r1 * 2, iron, Mat.Metal, SOLID)
	Kit.cyl(m, C(c1 - V(0.06, 0, 0)), 0.42, 0.45, P.DarkSteel, Mat.Metal, DECOR)
	for _, a in { 25, -65 } do
		Kit.box(m, C(c1 - V(0.13, 0, 0)) * A(a, 0, 0), V(0.06, r1 * 1.8, 0.16), Kit.dark(iron, 0.3), Mat.Metal, DECOR)
	end
	Kit.cyl(m, C(c2), 0.2, r2 * 2, P.DarkSteel, Mat.Metal, DECOR)
	-- Ремень: две касательные (без учёта разницы радиусов — на глаз не видно)
	local dir = (c2 - c1).Unit
	local n = Vector3.new(1, 0, 0):Cross(dir).Unit
	for _, s in { 1, -1 } do
		Kit.bar(m, c1 + n * s * r1, c2 + n * s * r2, 0.2, P.Rubber, Mat.Rubber, DECOR, 0.07)
	end
end

-- Динамо, щиток с лампами прогресса и шкалами, радиатор сзади
local function dynamo(m: Model, rng: Random, look: Look)
	local paint = Kit.jitter(look.Paint, 0.04, rng)
	Kit.cyl(m, C(1.0, 1.42, 0.35), 1.7, 1.4, paint, Mat.Metal, SOLID)
	Kit.cyl(m, C(1.9, 1.42, 0.35), 0.16, 1.15, P.DarkSteel, Mat.Metal, DECOR)
	local cabinet = Kit.box(m, C(1.0, 1.55, -0.95), V(1.8, 1.65, 0.9), paint, Mat.Metal, SOLID)
	Kit.rustStreaks(cabinet, Enum.NormalId.Front, rng, 6)
	Kit.box(m, C(1.0, 2.13, -1.44), V(1.72, 0.44, 0.1), P.Black, Mat.Metal, DECOR)
	Kit.box(m, C(1.0, 2.4, -1.55) * A(-12, 0, 0), V(1.8, 0.06, 0.34), Kit.dark(paint, 0.2), Mat.Metal, DECOR)
	for i = 1, 4 do
		local lamp = zcyl(m, V(0.4 + (i - 1) * 0.4, 2.13, -1.5), 0.12, 0.3, LIGHT_OFF, Mat.Glass, DECOR)
		lamp.Name = "ProgressLight" .. i
		lamp:SetAttribute("ProgressLight", i)
	end
	for i, x in { 0.55, 1.4 } do
		local g = zcyl(m, V(x, 1.42, -1.44), 0.1, 0.52, P.DarkSteel, Mat.Metal, DECOR)
		Kit.gauge(g, Enum.NormalId.Right, rng:NextNumber(0.1, 0.9) * i / 2)
	end
	Kit.box(m, C(0.97, 0.95, -1.44), V(0.2, 0.3, 0.1), Kit.jitter(P.Blood, 0.05, rng), Mat.Metal, DECOR)
	-- Лючок обслуживания на боковой стенке щитка
	Kit.box(m, C(1.93, 1.5, -0.95), V(0.05, 1.15, 0.62), Kit.jitter(Kit.dark(paint, 0.12), 0.04, rng), Mat.Metal, DECOR)
	local radiator = Kit.box(m, C(1.0, 1.5, 1.27), V(1.5, 1.4, 0.25), Kit.dark(paint, 0.25), Mat.Metal, SOLID)
	Kit.grime(radiator, Enum.NormalId.Back, 0.6)
	for i = 0, 2 do
		Kit.box(m, C(1.0, 1.1 + i * 0.4, 1.42), V(1.42, 0.09, 0.06), P.Iron, Mat.Metal, DECOR)
	end
end

-- Топливный бак на ложементе: два хомута и крышка горловины
local function tank(m: Model, rng: Random, look: Look)
	local color = Kit.jitter(look.Tank, 0.05, rng)
	Kit.cyl(m, C(1.0, 2.86, 0.3), 1.8, 1.05, color, Mat.CorrodedMetal, SOLID)
	Kit.box(m, C(1.0, 2.25, 0.45), V(1.5, 0.25, 0.8), P.DarkSteel, Mat.Metal, DECOR)
	for _, x in { 0.45, 1.55 } do
		Kit.cyl(m, C(x, 2.86, 0.3), 0.08, 1.11, P.Iron, Mat.CorrodedMetal, DECOR)
	end
	Kit.vcyl(m, C(1.45, 3.43, 0.3), 0.18, 0.3, P.DarkSteel, Mat.Metal, DECOR)
end

-- Выхлоп: колено из блока, вертикальная труба, (глушитель), наклонный срез сверху
local function exhaust(m: Model, x: number, height: number, muffler: boolean)
	local rust = P.Rust
	Kit.rod(m, V(x, 2.4, 1.0), V(x, 2.4, 1.38), 0.26, rust, Mat.CorrodedMetal, DECOR)
	Kit.rod(m, V(x, 2.3, 1.38), V(x, height, 1.38), 0.24, rust, Mat.CorrodedMetal, DECOR)
	if muffler then
		Kit.vcyl(m, C(x, 3.3, 1.38), 0.9, 0.42, Kit.dark(rust, 0.35), Mat.CorrodedMetal, DECOR)
	end
	Kit.box(m, C(x, height + 0.06, 1.38) * A(30, 0, 0), V(0.32, 0.04, 0.36), P.Iron, Mat.Metal, DECOR)
end

-- Лампа в проволочной клетке на стойке (горит, когда генератор починен)
local function bulb(m: Model, look: Look)
	local base = V(0.15, 3.75, -0.55)
	Kit.rod(m, V(base.X, 2.37, base.Z), base, 0.14, P.DarkSteel, Mat.Metal, DECOR)
	Kit.vcyl(m, C(base), 0.1, 0.78, P.Iron, Mat.Metal, DECOR)
	local b = Kit.ball(m, C(base + V(0, 0.15, 0)), 0.42, Color3.fromRGB(60, 60, 50), Mat.Glass, DECOR)
	b.Name = "Bulb"
	b:SetAttribute("Bulb", true)
	local light = Kit.pointLight(b, Color3.fromRGB(255, 226, 150), 18, 2.2)
	light.Enabled = false
	local tilt = look.Damaged and A(0, 0, 14) or CFrame.identity
	Kit.arc(m, C(base) * tilt, 0.37, 0, 180, 3, 0.05, P.Iron, Mat.Metal, DECOR)
	if not look.Damaged then
		Kit.arc(m, C(base) * A(0, 90, 0), 0.37, 0, 180, 3, 0.05, P.Iron, Mat.Metal, DECOR)
	end
end

-- Провисающие кабели между щитком, двигателем и стойкой лампы
local function cables(m: Model)
	Kit.cable(m, Kit.sag(V(0.12, 2.25, -1.25), V(-0.85, 2.95, -0.86), 0.35, 3), 0.1, P.Rubber, Mat.Rubber, DECOR)
	Kit.cable(m, Kit.sag(V(0.15, 3.5, -0.55), V(1.8, 2.3, -1.38), 0.45, 3), 0.08, P.Black, Mat.Rubber, DECOR)
end

-- Канистра у полоза (вариант)
local function jerryCan(m: Model, rng: Random)
	local cf = C(2.25, 0.55, 0.55) * A(0, -12, 0)
	Kit.box(m, cf, V(0.42, 1.1, 0.8), Kit.jitter(Color3.fromRGB(86, 42, 34), 0.05, rng), Mat.Metal, DECOR)
	Kit.box(m, cf * C(0, 0.62, 0.12), V(0.14, 0.14, 0.4), P.DarkSteel, Mat.Metal, DECOR)
end

-- Повреждения (вариант): оторванная крышка щитка у полоза и промасленная тряпка на баке
local function damage(m: Model, rng: Random, look: Look)
	Kit.box(m, C(1.3, 0.2, -1.75) * A(-70, 18, 0), V(1.0, 0.07, 0.8), Kit.jitter(look.Paint, 0.06, rng), Mat.Metal, DECOR)
	Kit.box(m, C(0.75, 3.38, 0.25) * A(0, 0, -6), V(0.8, 0.06, 1.0), Kit.jitter(P.Fabric, 0.06, rng), Mat.Fabric, DECOR)
	Kit.box(m, C(0.4, 3.02, -0.27) * A(-72, 0, -4), V(0.75, 0.05, 0.6), Kit.jitter(P.Fabric, 0.06, rng), Mat.Fabric, DECOR)
end

T.Generator = {
	Variants = #LOOKS,
	Build = function(rng: Random, variant: number)
		local look = LOOKS[(variant - 1) % #LOOKS + 1]
		local m = Kit.model("Generator")
		m:SetAttribute("Kind", "Generator")
		-- Невидимый корпус: столкновения, звук, точка искр
		local body = Kit.box(m, C(0, 2, 0), V(4, 3, 3), P.DarkSteel, Mat.SmoothPlastic, { Transparency = 1, CastShadow = false })
		body.Name = "Body"
		Kit.setOrigin(m, body)
		local fx = Instance.new("Attachment")
		fx.Name = "FX"
		fx.Position = V(-0.95, 1.4, 0.05)
		fx.Parent = body

		skid(m, rng, look)
		engine(m, rng, look)
		flywheel(m, rng)
		dynamo(m, rng, look)
		tank(m, rng, look)
		exhaust(m, -1.35, 4.9, true)
		if look.TwinExhaust then
			exhaust(m, -0.55, 4.5, false)
		end
		bulb(m, look)
		cables(m)
		if look.JerryCan then
			jerryCan(m, rng)
		end
		if look.Damaged then
			damage(m, rng, look)
		end

		m:SetAttribute("Progress", 0)
		m:SetAttribute("Done", false)
		m:SetAttribute("Regressing", false)
		return m
	end,
}

return M
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="55">
              <Properties>
                <string name="Name">Hatch</string>
                <string name="Source"><![CDATA[-- Люк: бетонная (или каменная) плита вровень с землёй со скошенными краями, тёмный провал в стальной
-- окантовке и две решётчатые створки, открывающиеся вверх; вокруг — немного грязи и обломков.
-- Модель строится в начале координат: земля y = 0, «перед» модели смотрит в -Z.
-- Ничто не сталкивается: по люку ходят, в него прыгают (JumpHatch — по расстоянию до опоры).
-- Требования — Art/Contract.lua; подвижные части — Kit.movable (см. Map/PropFX.lua).
local Kit = require(script.Parent.Parent.Kit)

local P = Kit.Palette
local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new

local M = {}
local T = {}
M.Templates = T

local DECOR = { Decor = true }
local FLAT = { CanCollide = false, CanQuery = false, CanTouch = false } -- плита: без столкновений, но с тенью

local SLAB = 4.4 -- сторона плиты
local HOLE = 3.0 -- сторона провала
local TOP = 0.16 -- верх плиты над землёй

type Look = {
	Slab: Color3,
	SlabMat: Enum.Material,
	Door: Color3,
	DoorMat: Enum.Material,
	Moss: boolean,
}

local LOOKS: { Look } = {
	{ Slab = Color3.fromRGB(86, 84, 80), SlabMat = Mat.Concrete, Door = Color3.fromRGB(96, 58, 40), DoorMat = Mat.CorrodedMetal, Moss = false },
	{ Slab = Color3.fromRGB(84, 78, 70), SlabMat = Mat.Cobblestone, Door = Color3.fromRGB(52, 54, 56), DoorMat = Mat.Metal, Moss = true },
}

-- Плита со скошенными краями, провал, стальная окантовка
local function frame(m: Model, rng: Random, look: Look): BasePart
	local color = Kit.jitter(look.Slab, 0.04, rng)
	local slab = Kit.box(m, C(0, TOP / 2, 0), V(SLAB, TOP, SLAB), color, look.SlabMat, FLAT)
	slab.Name = "Frame"
	-- Скосы по периметру (клин смотрит наружу, высокая сторона у плиты)
	for i, yaw in { 0, -90, 180, 90 } do
		local cf = A(0, yaw, 0) * C(0, TOP / 2, -SLAB / 2 - 0.25)
		Kit.wedge(m, cf, V(SLAB + 0.5, TOP, 0.5), Kit.jitter(Kit.dark(color, 0.1), 0.04, rng), i % 2 == 0 and look.SlabMat or Mat.Ground, DECOR)
	end
	local void = Kit.box(m, C(0, TOP + 0.01, 0), V(HOLE, 0.02, HOLE), Color3.fromRGB(6, 6, 8), Mat.SmoothPlastic, DECOR)
	void.Name = "Pit"
	local glow = Kit.pointLight(void, Color3.fromRGB(180, 200, 255), 14, 2)
	glow.Name = "Glow"
	glow.Enabled = false
	local rim = Kit.jitter(P.DarkSteel, 0.04, rng)
	for _, yaw in { 0, 90 } do
		for _, s in { -1, 1 } do
			Kit.box(m, A(0, yaw, 0) * C(0, TOP + 0.05, s * (HOLE / 2 + 0.1)), V(HOLE + 0.4, 0.1, 0.2), rim, Mat.Metal, DECOR)
		end
	end
	return slab
end

-- Две решётчатые створки (группа HatchDoor) на петлях у внешних краёв провала
local function doors(m: Model, rng: Random, look: Look)
	local y = TOP + 0.16
	local half = HOLE / 2
	for _, sx in { -1, 1 } do
		local color = Kit.jitter(look.Door, 0.05, rng)
		local hinge = C(sx * half, y, 0)
		local opened = A(0, 0, -100 * sx)
		local function swing(part: BasePart)
			Kit.movable(m, part, "HatchDoor", part.CFrame, Kit.aroundHinge(part.CFrame, hinge, opened))
		end
		-- продольные полосы по краям створки
		for _, x in { 0.09, half - 0.09 } do
			swing(Kit.box(m, C(sx * x, y, 0), V(0.18, 0.14, HOLE), color, look.DoorMat, DECOR))
		end
		-- поперечные планки решётки
		for i = 0, 4 do
			local z = -half + 0.12 + i * (HOLE - 0.24) / 4
			swing(Kit.box(m, C(sx * half / 2, y, z), V(half - 0.1, 0.09, 0.16), Kit.dark(color, 0.1), look.DoorMat, DECOR))
		end
		if sx > 0 then
			-- скоба-ручка на правой створке
			swing(Kit.box(m, C(0.32, y + 0.12, 0), V(0.12, 0.12, 0.7), P.Iron, Mat.Metal, DECOR))
		end
	end
end

-- Холмик грязи у угла, два камня; на бетонном варианте — обломок доски, на каменном — пучок травы
local function debris(m: Model, rng: Random, look: Look)
	local dirt = Kit.jitter(Color3.fromRGB(70, 56, 42), 0.05, rng)
	local mound = C(1.9, 0.17, 2.6) * A(0, 200, 0)
	Kit.wedge(m, mound * C(0, 0, -0.3), V(1.5, 0.34, 0.6), dirt, Mat.Mud, DECOR)
	Kit.wedge(m, mound * C(0, 0, 0.3) * A(0, 180, 0), V(1.5, 0.34, 0.6), Kit.dark(dirt, 0.1), Mat.Mud, DECOR)
	local a = rng:NextNumber(0, math.pi * 2)
	for i = 0, 1 do
		local b = a + i * 2.4
		local s = rng:NextNumber(0.3, 0.55)
		Kit.box(m, C(math.cos(b) * 2.9, s * 0.3, math.sin(b) * 2.9) * A(rng:NextNumber(-20, 20), rng:NextNumber(0, 180), 0), V(s, s * 0.7, s * 0.9), Kit.jitter(P.DarkConcrete, 0.06, rng), Mat.Rock, DECOR)
	end
	if look.Moss then
		Kit.wedge(m, C(math.cos(a + 1.2) * 2.4, 0.15, math.sin(a + 1.2) * 2.4) * A(0, math.deg(a), 0), V(0.8, 0.3, 0.45), Kit.jitter(P.Grass, 0.06, rng), Mat.Grass, DECOR)
	else
		Kit.box(m, C(-2.6, 0.08, -1.2) * A(0, 28, 4), V(0.35, 0.12, 2.2), Kit.jitter(P.OldWood, 0.06, rng), Mat.WoodPlanks, DECOR)
	end
end

T.Hatch = {
	Variants = #LOOKS,
	Build = function(rng: Random, variant: number)
		local look = LOOKS[(variant - 1) % #LOOKS + 1]
		local m = Kit.model("Hatch")
		m:SetAttribute("Kind", "Hatch")
		local slab = frame(m, rng, look)
		Kit.setOrigin(m, slab)
		doors(m, rng, look)
		debris(m, rng, look)
		m:SetAttribute("Open", false)
		m:SetAttribute("Closed", false)
		return m
	end,
}

return M
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="56">
              <Properties>
                <string name="Name">Hook</string>
                <string name="Source"><![CDATA[-- Крюк и лапы Сущности
-- Крюк: груда камней и костей, клёпаный ржавый столб с подкосами, консоль с гнутым концом и дугообразной
-- подпоркой, цепь и мясной крюк из сегментов дуги. Висящий (HangPoint) — спиной к столбу, остриё крюка
-- проходит сквозь его правое плечо. Крюк и консоль повёрнуты на ~10° вокруг столба, чтобы попасть в плечо.
-- Модель строится в начале координат: земля y = 0, «перед» модели смотрит в -Z.
-- Требования — Art/Contract.lua. HangPoint (прямой потомок модели) стоит ровно там же, что и раньше;
-- верх столба (y = 12 над опорой) — точка посадки ворона (MapBuilder).
local Kit = require(script.Parent.Parent.Kit)

local P = Kit.Palette
local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new

local M = {}
local T = {}
M.Templates = T

local SOLID = { CanCollide = false, CanQuery = false, CanTouch = false }
local DECOR = { Decor = true }

local HANG_POINT = C(0.25, 7, -4.3) -- где висит выживший (корень персонажа)
local TOP = 12 -- верх колпака столба
local POLE = 0.84 -- сечение столба

-- Варианты: цвет металла и камней, кости, кровь, особая деталь
type Look = {
	Metal: Color3,
	Stone: Color3,
	Skull: boolean,
	Bones: number,
	ExtraBlood: boolean,
	BrokenChain: boolean, -- обрывок цепи свисает с консоли
	Stakes: boolean, -- заострённые колья в груде камней
}

local LOOKS: { Look } = {
	{ Metal = Color3.fromRGB(104, 50, 34), Stone = Color3.fromRGB(92, 90, 86), Skull = true, Bones = 2, ExtraBlood = false, BrokenChain = false, Stakes = false },
	{ Metal = Color3.fromRGB(58, 46, 42), Stone = Color3.fromRGB(70, 76, 66), Skull = false, Bones = 1, ExtraBlood = true, BrokenChain = true, Stakes = false },
	{ Metal = Color3.fromRGB(124, 72, 42), Stone = Color3.fromRGB(104, 98, 90), Skull = true, Bones = 1, ExtraBlood = false, BrokenChain = false, Stakes = true },
}

-- Столб: гильза в основании, хомуты, заклёпки, колпак, два подкоса назад
local function pole(m: Model, rng: Random, metal: Color3): BasePart
	local post = Kit.box(m, C(0, TOP / 2 - 0.15, 0), V(POLE, TOP - 0.3, POLE), metal, Mat.CorrodedMetal)
	post.Name = "Pole"
	Kit.rustStreaks(post, Enum.NormalId.Front, rng, 5, Kit.dark(metal, 0.45))
	Kit.rustStreaks(post, Enum.NormalId.Right, rng, 4, Kit.dark(metal, 0.45))
	local dark = Kit.dark(metal, 0.3)
	Kit.box(m, C(0, 0.6, 0), V(POLE + 0.36, 1.6, POLE + 0.36), dark, Mat.CorrodedMetal, SOLID)
	Kit.rivets(m, V(-0.32, 1.05, -0.62), V(0.32, 1.05, -0.62), 2, 0.17, dark)
	for _, y in { 2.6, 8.2 } do
		Kit.box(m, C(0, y, 0), V(POLE + 0.16, 0.32, POLE + 0.16), dark, Mat.CorrodedMetal, DECOR)
	end
	Kit.box(m, C(0, TOP - 0.15, 0), V(POLE + 0.3, 0.3, POLE + 0.3), dark, Mat.CorrodedMetal, SOLID)
	for _, sx in { -1, 1 } do
		local foot = V(sx * 1.45, 0.12, 1.95)
		Kit.bar(m, V(sx * 0.28, 4.3, 0.35), foot + V(0, 0.1, 0), 0.28, metal, Mat.CorrodedMetal, SOLID)
		Kit.box(m, C(foot) * A(0, sx * 25, 0), V(0.6, 0.14, 0.6), dark, Mat.Metal, DECOR)
	end
	return post
end

-- Консоль, подпорка, цепь и крюк в плоскости, повёрнутой вокруг столба к правому плечу висящего.
-- Локальные координаты плоскости: -Z — от столба к висящему, y — высота от земли.
local function crane(m: Model, rng: Random, metal: Color3, look: Look)
	local hp = HANG_POINT.Position
	local reach = V(hp.X + 0.5, 0, hp.Z)
	local F = CFrame.lookAt(Vector3.zero, reach)
	local function at(z: number, y: number): Vector3
		return F:PointToWorldSpace(V(0, y, z))
	end
	local d = reach.Magnitude -- расстояние от столба до центра чаши крюка
	local dark = Kit.dark(metal, 0.3)
	local r, bowlY = 0.68, 8.1 -- радиус и высота центра чаши (чаша проходит сквозь плечо)
	local armY, bend = 11.25, 0.6
	local shankZ = -(d - r)
	local armEnd = shankZ + bend -- конец прямой части, дальше загиб вниз
	local face = -POLE / 2
	-- Консоль и накладка, которой она прикручена к столбу
	Kit.bar(m, at(0.1, armY), at(armEnd, armY), 0.56, metal, Mat.CorrodedMetal, SOLID, 0.6)
	Kit.box(m, F * C(0, armY, face - 0.07), V(1.0, 1.1, 0.14), dark, Mat.Metal, DECOR)
	-- Загиб на конце консоли (дуга вниз) и дугообразная подпорка между столбом и консолью
	Kit.arc(m, F * C(0, armY - bend, armEnd) * A(0, 90, 0), bend, 90, 0, 3, 0.56, metal, Mat.CorrodedMetal, DECOR)
	Kit.arc(m, F * C(0, armY - 0.28, face) * A(0, 90, 0), 2.4, -90, 0, 4, 0.3, dark, Mat.CorrodedMetal, DECOR)
	-- Цепь от загиба до ушка крюка
	local eyeY = 9.55
	Kit.chain(m, { at(shankZ, armY - bend - 0.1), at(shankZ, eyeY + 0.12) }, 0.42, P.DarkSteel)
	if look.BrokenChain then
		local from = at(-1.6, armY - 0.3)
		Kit.chain(m, { from, from + V(0.1, -1.3, 0) }, 0.42, Kit.dark(P.Rust, 0.2))
	end
	-- Крюк: ушко, стержень, чаша (низ в запёкшейся крови), остриё
	local steel = Kit.jitter(P.Steel, 0.04, rng)
	local bowlZ = shankZ - r
	Kit.cyl(m, C(at(shankZ, eyeY)) * F.Rotation, 0.12, 0.44, P.DarkSteel, Mat.Metal, DECOR)
	Kit.rod(m, at(shankZ, eyeY - 0.12), at(shankZ, bowlY), 0.26, steel, Mat.Metal, DECOR)
	local bowl = Kit.arc(m, F * C(0, bowlY, bowlZ) * A(0, 90, 0), r, 180, 360, 5, 0.26, steel, Mat.Metal, DECOR)
	for i = 2, 5 do
		bowl[i].Color = Kit.dark(P.Blood, 0.2 + i * 0.05)
	end
	local tipBase = at(bowlZ - r, bowlY)
	local tip = Kit.wedge(m, C(tipBase + V(0, 0.3, 0)) * F.Rotation, V(0.24, 0.62, 0.26), P.Blood, Mat.Metal, DECOR)
	tip.Name = "HookTip"
end

-- Груда камней у основания, кости, череп, (колья)
local function rubble(m: Model, rng: Random, look: Look)
	Kit.box(m, C(0, 0.14, 0.1) * A(0, 20, 0), V(2.6, 0.32, 2.4), Kit.jitter(look.Stone, 0.05, rng), Mat.Slate, SOLID)
	for i = 1, 4 do
		local a = math.rad(i * 90 + rng:NextNumber(-25, 25) + 45)
		local r = rng:NextNumber(1.2, 1.6)
		local s = V(rng:NextNumber(0.9, 1.5), rng:NextNumber(0.6, 1.0), rng:NextNumber(0.8, 1.2))
		Kit.box(m, C(math.cos(a) * r, s.Y * 0.3, math.sin(a) * r) * A(rng:NextNumber(-15, 15), rng:NextNumber(0, 180), rng:NextNumber(-15, 15)), s, Kit.jitter(look.Stone, 0.08, rng), Mat.Rock, SOLID)
	end
	local bone = Kit.jitter(P.OldBone, 0.05, rng)
	local spots = { { V(1.25, 0.1, -1.1), 30 }, { V(-1.1, 0.12, -1.35), -50 } }
	for i = 1, look.Bones do
		local pos, yaw = spots[i][1], spots[i][2]
		local cf = C(pos) * A(0, yaw, rng:NextNumber(-8, 8))
		Kit.cyl(m, cf, 1.0, 0.15, bone, Mat.SmoothPlastic, DECOR)
		Kit.ball(m, cf * C(0.52, 0.02, 0), 0.26, bone, Mat.SmoothPlastic, DECOR)
	end
	if look.Skull then
		local cf = C(-0.8, 0.3, -1.0) * A(-15, 35, 10)
		Kit.ball(m, cf, 0.6, bone, Mat.SmoothPlastic, DECOR)
		Kit.box(m, cf * C(0, -0.22, -0.18), V(0.34, 0.16, 0.28), Kit.dark(bone, 0.15), Mat.SmoothPlastic, DECOR)
	end
	if look.Stakes then
		for i, a in { 150, 215 } do
			local base = V(math.cos(math.rad(a)) * 1.5, 0, math.sin(math.rad(a)) * 1.5)
			local top = base + V(math.cos(math.rad(a)) * 0.5, 1.6 + i * 0.3, math.sin(math.rad(a)) * 0.5)
			Kit.bar(m, base, top, 0.22, Kit.jitter(P.DarkWood, 0.06, rng), Mat.Wood, DECOR)
		end
	end
end

-- Кровь: неровная лужа под висящим (несколько пятен), мазок на столбе
local function blood(m: Model, rng: Random, look: Look)
	local hp = HANG_POINT.Position
	local function stain(x: number, z: number, size: number, color: Color3)
		Kit.cyl(m, C(hp.X + x, 0.02 + size * 0.004, hp.Z + z) * A(0, 0, 90), 0.04, size, color, Mat.SmoothPlastic, DECOR)
	end
	stain(0.45, 0.1, 1.9, P.DryBlood)
	stain(0.95, -0.55, 1.0, Kit.dark(P.Blood, 0.1))
	stain(-0.35, 0.75, 0.6, P.DryBlood)
	if look.ExtraBlood then
		stain(1.4, 0.9, 0.5, P.DryBlood)
	end
	Kit.box(m, C(0.05, 6.6, -POLE / 2 - 0.01) * A(0, 0, rng:NextNumber(-6, 6)), V(0.45, 1.7, 0.03), P.DryBlood, Mat.SmoothPlastic, DECOR)
end

T.Hook = {
	Variants = #LOOKS,
	Build = function(rng: Random, variant: number)
		local look = LOOKS[(variant - 1) % #LOOKS + 1]
		local m = Kit.model("Hook")
		m:SetAttribute("Kind", "Hook")
		local metal = Kit.jitter(look.Metal, 0.04, rng)
		local post = pole(m, rng, metal)
		Kit.setOrigin(m, post)
		crane(m, rng, metal, look)
		rubble(m, rng, look)
		blood(m, rng, look)
		local hp = Kit.box(m, HANG_POINT, V(1, 1, 1), P.Black, Mat.SmoothPlastic, { Decor = true, Transparency = 1 })
		hp.Name = "HangPoint"
		m:SetAttribute("Occupant", 0)
		return m
	end,
}

------------------------------------------------------------------------
-- Лапы Сущности
------------------------------------------------------------------------

-- Каждая лапа — ломаная из точек {радиус от висящего, высота над HangPoint}: из земли наружу и вверх,
-- выше головы загибается внутрь и вниз, короткий коготь (тёмно-красный, светится) бьёт в плечи и грудь.
-- Угол — от «вперёд» (-Z точки HangPoint); сзади (180°) стоит столб, туда лапы не ставим, спереди — просвет,
-- чтобы висящего было видно.
type Leg = { Angle: number, Points: { Vector2 } }

local LEGS: { Leg } = {
	{ Angle = -145, Points = { Vector2.new(2.4, -7.3), Vector2.new(4.3, -0.8), Vector2.new(3.8, 4.8), Vector2.new(1.3, 3.5), Vector2.new(0.5, 1.6) } },
	{ Angle = -82, Points = { Vector2.new(2.7, -7.3), Vector2.new(4.7, -1.4), Vector2.new(4.2, 4.2), Vector2.new(1.4, 3.1), Vector2.new(0.6, 1.0) } },
	{ Angle = -28, Points = { Vector2.new(2.5, -7.3), Vector2.new(4.1, -0.2), Vector2.new(3.5, 5.3), Vector2.new(1.2, 3.8), Vector2.new(0.55, 1.9) } },
	{ Angle = 38, Points = { Vector2.new(2.8, -7.3), Vector2.new(4.6, -1.0), Vector2.new(4.0, 4.6), Vector2.new(1.3, 3.3), Vector2.new(0.6, 1.3) } },
	{ Angle = 108, Points = { Vector2.new(2.5, -7.3), Vector2.new(4.4, -1.6), Vector2.new(4.1, 4.0), Vector2.new(1.4, 2.9), Vector2.new(0.5, 0.8) } },
}

local SEGMENT_WIDTH = { 0.46, 0.36, 0.26, 0.15 } -- сужение к когтю

-- Лапы Сущности вокруг висящего (hangPoint — мировой CFrame точки HangPoint). Только декор, 25 деталей.
function M.entityLegs(hangPoint: CFrame): Model
	local m = Kit.model("EntityLegs")
	local shell = Color3.fromRGB(22, 14, 16)
	local claw = Color3.fromRGB(120, 12, 10)
	for _, leg in LEGS do
		local a = math.rad(leg.Angle)
		local dir = V(math.sin(a), 0, -math.cos(a))
		local pts = {}
		for i, q in leg.Points do
			pts[i] = hangPoint:PointToWorldSpace(dir * q.X + V(0, q.Y, 0))
		end
		for i = 1, #pts - 1 do
			local last = i == #pts - 1
			local seg = Kit.bar(m, pts[i], pts[i + 1], SEGMENT_WIDTH[i], last and claw or Kit.jitter(shell, 0.04), last and Mat.Neon or Mat.Slate, DECOR)
			if seg then
				-- ромбовидное сечение — хитин выглядит острее
				seg.CFrame *= A(0, 0, 45)
			end
		end
		-- шип на верхнем изгибе смотрит вверх и наружу
		local knee = pts[3]
		local out = knee + dir * 0.7 + V(0, 1.1, 0)
		Kit.wedge(m, CFrame.lookAt((knee + out) / 2, out) * A(-90, 0, 0), V(0.2, 1.3, 0.3), shell, Mat.Slate, DECOR)
	end
	return m
end

return M
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="57">
              <Properties>
                <string name="Name">Locker</string>
                <string name="Source"><![CDATA[-- Шкафчик
-- Модель строится в начале координат: земля y = 0, «перед» модели смотрит в -Z.
-- Требования — Art/Contract.lua; подвижные части — Kit.movable (см. Map/PropFX.lua).
local Kit = require(script.Parent.Parent.Kit)

local P = Kit.Palette
local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new

local M = {}
local T = {}
M.Templates = T

------------------------------------------------------------------------
-- Старый стальной шкафчик (опора — пол в центре, дверь спереди -Z, петли слева по -X).
-- Внутри свободный объём под выжившего (точка Inside), перед дверью ~3 стада свободного места.
------------------------------------------------------------------------

local W, D = 3.2, 2.6 -- наружные ширина и глубина
local TOP = 7.2 -- верх стенок
local DOOR_Y0, DOOR_Y1 = 0.62, 6.83 -- проём двери по высоте
local DOOR_Z = -D / 2 + 0.03 -- центр двери чуть впереди кромок боковин
local HINGE_X = -1.42

local DECOR = { Decor = true }

-- Варианты: краска, материал корпуса, наклонная крыша, тряпка в двери, приоткрытая дверь, коробка сверху
type Style = {
	Paint: Color3,
	Body: Enum.Material,
	Door: Color3?, -- дверь от другого шкафчика (своя краска), иначе в цвет корпуса
	BottomVents: boolean,
	Padlock: boolean,
	SlopedTop: boolean,
	Ajar: number, -- угол, на который дверь приоткрыта в закрытом состоянии
	Rag: boolean,
	Box: boolean,
	Rust: number, -- сколько ржавых пятен-деталей
	Number: string,
}

local STYLES: { Style } = {
	{ Paint = Color3.fromRGB(72, 92, 90), Body = Mat.Metal, BottomVents = true, Padlock = true, SlopedTop = false, Ajar = 0, Rag = false, Box = true, Rust = 2, Number = "17" },
	{ Paint = Color3.fromRGB(84, 86, 66), Body = Mat.Metal, BottomVents = true, Padlock = false, SlopedTop = false, Ajar = 3, Rag = true, Box = false, Rust = 3, Number = "4" },
	{ Paint = Color3.fromRGB(96, 60, 46), Body = Mat.CorrodedMetal, BottomVents = false, Padlock = false, SlopedTop = true, Ajar = 0, Rag = false, Box = false, Rust = 3, Number = "31", Door = Color3.fromRGB(80, 88, 92) },
}

local function frame(parent: Instance, props: { [string]: any }): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	for k, v in props do
		(f :: any)[k] = v
	end
	f.Parent = parent
	return f
end

local function fade(f: Frame, rotation: number, from: number, to: number)
	local g = Instance.new("UIGradient")
	g.Rotation = rotation
	g.Transparency = NumberSequence.new(from, to)
	g.Parent = f
end

-- Износ одной грани в одном SurfaceGui: грязь снизу, ржавые потёки и вмятины (тёмная тень с бликом снизу)
local function weathering(part: BasePart, face: Enum.NormalId, rng: Random, streaks: number, dents: number)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 1
	gui.MaxDistance = 90
	gui.Parent = part
	local grime = frame(gui, { Position = UDim2.fromScale(0, 0.62), Size = UDim2.fromScale(1, 0.38), BackgroundColor3 = Color3.fromRGB(32, 24, 18) })
	fade(grime, 90, 1, 0.3)
	for _ = 1, streaks do
		local streak = frame(gui, {
			Position = UDim2.fromScale(rng:NextNumber(0.05, 0.9), rng:NextNumber(0, 0.35)),
			Size = UDim2.fromScale(rng:NextNumber(0.015, 0.045), rng:NextNumber(0.15, 0.45)),
			BackgroundColor3 = Kit.jitter(P.Rust, 0.08, rng),
			BackgroundTransparency = rng:NextNumber(0.25, 0.5),
		})
		fade(streak, 90, 0, 1)
	end
	for _ = 1, dents do
		local x, y, s = rng:NextNumber(0.2, 0.8), rng:NextNumber(0.25, 0.75), rng:NextInteger(8, 16)
		local dent = frame(gui, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(x, y),
			Size = UDim2.fromOffset(s, s * 0.7),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.55,
		})
		fade(dent, 90, 0, 1)
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = dent
		local glint = frame(dent, {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.75),
			Size = UDim2.fromScale(0.8, 0.22),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.82,
		})
		local c2 = Instance.new("UICorner")
		c2.CornerRadius = UDim.new(0.5, 0)
		c2.Parent = glint
	end
	return gui
end

-- Жалюзи: тёмная подложка и ряд наклонных козырьков (клин: толстый низ — щель, верх сливается с дверью)
local function louvres(parts: { BasePart }, m: Model, door: CFrame, y: number, count: number, paint: Color3)
	local step = 0.16
	local h = count * step
	table.insert(parts, Kit.box(m, door * C(0, y, -0.045), V(1.74, h + 0.06, 0.01), Kit.dark(paint, 0.8), Mat.SmoothPlastic, DECOR))
	for i = 0, count - 1 do
		local ly = y - h / 2 + step * (i + 0.5)
		table.insert(parts, Kit.wedge(m, door * C(0, ly, -0.08), V(1.62, 0.11, 0.07), Kit.dark(paint, 0.05), Mat.Metal, DECOR))
	end
end

T.Locker = {
	Variants = 3,
	Build = function(rng: Random, variant: number)
		local s = STYLES[variant] or STYLES[1]
		local m = Kit.model("Locker")
		m:SetAttribute("Kind", "Locker")
		local paint = Kit.jitter(s.Paint, 0.04, rng)
		local dark = Kit.dark(paint, 0.35)
		local rust = Kit.jitter(P.Rust, 0.06, rng)

		-- Корпус (сталкивается)
		local back = Kit.box(m, C(0, (TOP + 0.3) / 2, D / 2 - 0.08), V(W, TOP - 0.3, 0.16), paint, s.Body)
		back.Name = "Back"
		Kit.setOrigin(m, back)
		local sides = {}
		for _, sx in { -1, 1 } do
			table.insert(sides, Kit.box(m, C(sx * (W / 2 - 0.08), (TOP + 0.3) / 2, 0), V(0.16, TOP - 0.3, D), paint, s.Body))
		end
		Kit.box(m, C(0, 0.17, 0.05), V(W - 0.2, 0.34, D - 0.2), Kit.dark(paint, 0.55), Mat.Metal)
		local cap = Kit.box(m, C(0, TOP + 0.07, 0), V(W + 0.12, 0.14, D + 0.12), Kit.dark(paint, 0.12), s.Body)
		if s.SlopedTop then
			-- наклонная крыша: высокая сторона сзади, скат к двери
			Kit.wedge(m, C(0, TOP + 0.14 + 0.35, 0), V(W + 0.12, 0.7, D + 0.12), Kit.dark(paint, 0.08), s.Body)
		end
		-- рамка проёма: перемычка сверху и цоколь снизу
		Kit.box(m, C(0, (DOOR_Y1 + TOP) / 2 + 0.01, -D / 2 + 0.05), V(W - 0.32, TOP - DOOR_Y1, 0.1), Kit.dark(paint, 0.1), s.Body, DECOR)
		Kit.box(m, C(0, (0.34 + DOOR_Y0) / 2, -D / 2 + 0.05), V(W - 0.32, DOOR_Y0 - 0.34, 0.1), Kit.dark(paint, 0.25), Mat.DiamondPlate, DECOR)
		-- полка для шапки внутри (выше головы спрятавшегося)
		Kit.box(m, C(0, 6.15, 0.5), V(W - 0.32, 0.06, 1.3), dark, Mat.Metal, DECOR)

		-- Дверь (группа LockerDoor, открывается наружу на петлях по -X)
		local doorH = DOOR_Y1 - DOOR_Y0
		local closed = C(0, (DOOR_Y0 + DOOR_Y1) / 2, DOOR_Z)
		local hinge = C(HINGE_X, closed.Y, DOOR_Z)
		local door: { BasePart } = {}
		local doorPaint = s.Door and Kit.jitter(s.Door, 0.04, rng) or paint
		local doorMat = s.Door and Mat.Metal or s.Body
		local panel = Kit.box(m, closed, V(W - 0.38, doorH, 0.08), Kit.jitter(doorPaint, 0.03, rng), doorMat)
		panel.Name = "Door"
		table.insert(door, panel)
		-- выдавленная филёнка в нижней половине двери: на уровне глаз спрятавшегося дверь остаётся
		-- чистой (камера изнутри смотрит сквозь полупрозрачную деталь Door, см. CameraController)
		table.insert(door, Kit.box(m, closed * C(-0.1, -1.35, -0.05), V(1.9, 1.8, 0.02), Kit.jitter(doorPaint, 0.04, rng), doorMat, DECOR))
		louvres(door, m, closed, doorH / 2 - 0.55, 5, doorPaint)
		if s.BottomVents then
			louvres(door, m, closed, -doorH / 2 + 0.42, 3, doorPaint)
		end
		-- ручка-защёлка и накладка
		table.insert(door, Kit.box(m, closed * C(1.08, 0, -0.06), V(0.26, 0.9, 0.04), P.DarkSteel, Mat.Metal, DECOR))
		table.insert(door, Kit.box(m, closed * C(1.08, 0.06, -0.13), V(0.1, 0.44, 0.12), P.Steel, Mat.Metal, DECOR))
		if s.Padlock then
			table.insert(door, Kit.box(m, closed * C(1.08, -0.42, -0.13), V(0.2, 0.24, 0.1), Color3.fromRGB(120, 104, 64), Mat.Metal, DECOR))
			table.insert(door, Kit.cyl(m, closed * C(1.08, -0.27, -0.13) * A(0, 90, 0), 0.03, 0.17, P.Steel, Mat.Metal, DECOR))
		end
		-- петли
		for _, hy in { -doorH / 2 + 0.6, 0, doorH / 2 - 0.6 } do
			table.insert(door, Kit.vcyl(m, closed * C(HINGE_X + 0.01, hy, -0.04), 0.42, 0.12, P.Iron, Mat.Metal, DECOR))
		end
		-- табличка с номером
		local plate = Kit.box(m, closed * C(0, doorH / 2 - 1.2, -0.05), V(0.5, 0.26, 0.02), Color3.fromRGB(150, 140, 112), Mat.Metal, DECOR)
		Kit.label(plate, Enum.NormalId.Front, s.Number, Color3.fromRGB(30, 28, 24), Enum.Font.Oswald)
		table.insert(door, plate)
		-- ржавчина ползёт от нижней кромки двери: широкое пятно и «язык» повыше (неровный край)
		local rx = rng:NextNumber(-0.6, 0.2)
		table.insert(door, Kit.box(m, closed * C(rx, -doorH / 2 + 0.3, -0.045) * A(0, 0, rng:NextNumber(-4, 4)), V(rng:NextNumber(1.0, 1.4), 0.45, 0.012), rust, Mat.CorrodedMetal, DECOR))
		table.insert(door, Kit.box(m, closed * C(rx + rng:NextNumber(-0.3, 0.3), -doorH / 2 + 0.62, -0.046) * A(0, 0, rng:NextNumber(15, 30)), V(0.42, 0.3, 0.012), Kit.dark(rust, 0.12), Mat.CorrodedMetal, DECOR))
		-- и на боковинах у пола
		for i = 2, s.Rust do
			local sx = i % 2 == 0 and 1 or -1
			local z, h = rng:NextNumber(-0.6, 0.4), rng:NextNumber(0.45, 0.8)
			Kit.box(m, C(sx * (W / 2 + 0.003), 0.3 + h / 2, z) * A(rng:NextNumber(-7, 7), 0, 0), V(0.012, h, rng:NextNumber(1.0, 1.6)), Kit.jitter(Kit.dark(rust, 0.15), 0.06, rng), Mat.CorrodedMetal, DECOR)
		end
		if s.Rag then
			-- тряпка, зажатая дверью
			table.insert(door, Kit.box(m, closed * C(1.33, -0.6, -0.07) * A(0, 0, -7), V(0.24, 1.2, 0.03), Color3.fromRGB(96, 46, 38), Mat.Fabric, DECOR))
		end
		local ajar = Kit.aroundHinge(closed, hinge, A(0, s.Ajar, 0))
		local open = Kit.aroundHinge(closed, hinge, A(0, 100, 0))
		for _, p in door do
			local rel = closed:ToObjectSpace(p.CFrame)
			Kit.movable(m, p, "LockerDoor", ajar * rel, open * rel)
		end

		if s.Box then
			-- картонная коробка на крыше с отогнутым клапаном
			local boxCF = C(0.45, TOP + 0.14 + 0.42, 0.25) * A(0, rng:NextNumber(8, 20), 0)
			Kit.box(m, boxCF, V(1.4, 0.84, 1.1), Color3.fromRGB(118, 96, 68), Mat.Cardboard, DECOR)
			Kit.box(m, boxCF * C(0, 0.42, -0.55) * A(-35, 0, 0) * C(0, 0, -0.25), V(1.36, 0.02, 0.5), Color3.fromRGB(104, 84, 60), Mat.Cardboard, DECOR)
		end

		-- износ поверх деталей (SurfaceGui, без лишних деталей)
		weathering(panel, Enum.NormalId.Front, rng, 4, 2)
		weathering(sides[1], Enum.NormalId.Left, rng, 3, 1)
		weathering(sides[2], Enum.NormalId.Right, rng, 3, 1)
		weathering(cap, Enum.NormalId.Front, rng, 2, 0)

		local inside = Kit.box(m, C(0, 3, 0.2), V(1, 1, 1), P.Black, Mat.SmoothPlastic, { Decor = true, Transparency = 1 })
		inside.Name = "Inside"
		m:SetAttribute("Occupant", 0)
		return m
	end,
}

return M
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="58">
              <Properties>
                <string name="Name">Pallet</string>
                <string name="Source"><![CDATA[-- Паллета
-- Модель строится в начале координат: земля y = 0, «перед» модели смотрит в -Z.
-- Требования — Art/Contract.lua; подвижные части — Kit.movable (см. Map/PropFX.lua).
local Kit = require(script.Parent.Parent.Kit)

local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new

local M = {}
local T = {}
M.Templates = T

------------------------------------------------------------------------
-- Паллета (собирается в ОПУЩЕННОМ положении: хитбокс в начале координат, длинная сторона по X).
-- Настил (верхние доски) смотрит в -Z, нижние доски — в +Z, между ними три лаги вдоль Y.
-- Сталкивается только Hitbox; доски без столкновений и лучей, но крупные отбрасывают тень.
------------------------------------------------------------------------

local LEN, HGT = 5.6, 3
local BOARD_T = 0.18 -- толщина доски
local DECK_Z, BACK_Z = -0.44, 0.44
local STRINGER_W, STRINGER_D = 0.42, 0.7
local STRINGERS = { -2.55, 0, 2.55 }

local BOARD = { CanCollide = false, CanQuery = false, CanTouch = false }
local NAIL = Color3.fromRGB(52, 44, 38)

type Board = {
	X0: number, -- левый и правый концы доски
	X1: number,
	Y: number, -- центр по высоте
	W: number, -- ширина доски
	Color: Color3,
	Tilt: number?, -- поворот вокруг Z (градусы), доски «на глаз»
	Nailed: boolean?, -- рисовать шляпки гвоздей
}

-- Центры досок снизу вверх с равными щелями (края настила совпадают с краями лаг)
local function layout(widths: { number }): { number }
	local total = 0
	for _, w in widths do
		total += w
	end
	local gap = (HGT - total) / (#widths - 1)
	local ys = {}
	local y = -HGT / 2
	for _, w in widths do
		table.insert(ys, y + w / 2)
		y += w + gap
	end
	return ys
end

local function board(m: Model, b: Board, z: number, material: Enum.Material?): BasePart
	local cf = C((b.X0 + b.X1) / 2, b.Y, z) * A(0, 0, b.Tilt or 0)
	return Kit.box(m, cf, V(b.X1 - b.X0, b.W, BOARD_T), b.Color, material or Mat.Wood, BOARD)
end

-- Обломанный конец доски: острая щепа-клин в плоскости настила (dir = +1 — обломан правый конец)
local function splinter(m: Model, b: Board, z: number, dir: number, len: number, frac: number, top: boolean)
	local h = b.W * frac
	local x = (dir > 0 and b.X1 or b.X0) + dir * len / 2
	local y = top and b.Y + b.W / 2 - h / 2 or b.Y - b.W / 2 + h / 2
	local cf = C(x, y, z) * A(0, dir > 0 and -90 or 90, top and 180 or 0)
	Kit.wedge(m, cf, V(BOARD_T * 0.8, h, len), Kit.dark(b.Color, 0.08), Mat.Wood, { Decor = true })
end

-- Шляпки гвоздей: один SurfaceGui на невидимой пластине перед настилом вместо десятков деталей
local function nailHeads(m: Model, boards: { Board }, rng: Random)
	local plate = Kit.box(m, C(0, 0, DECK_Z - BOARD_T / 2 - 0.012), V(LEN, HGT, 0.02), NAIL, Mat.SmoothPlastic, { Decor = true, Transparency = 1 })
	plate.Name = "Nails"
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.LightInfluence = 1
	gui.MaxDistance = 45
	gui.Parent = plate
	local function dot(x: number, y: number, px: number, color: Color3, transparency: number)
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		-- на передней грани левый край GUI соответствует +X детали
		f.Position = UDim2.fromScale(0.5 - x / LEN, 0.5 - y / HGT)
		f.Size = UDim2.fromOffset(px, px)
		f.BorderSizePixel = 0
		f.BackgroundColor3 = color
		f.BackgroundTransparency = transparency
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = f
		f.Parent = gui
	end
	for _, b in boards do
		if not b.Nailed then
			continue
		end
		for _, sx in STRINGERS do
			if sx > b.X0 + 0.15 and sx < b.X1 - 0.15 then
				for _, k in { -0.24, 0.24 } do
					local x, y = sx + rng:NextNumber(-0.08, 0.08), b.Y + k * b.W
					-- ржавый ореол вокруг шляпки и сама шляпка
					dot(x, y, 9, Kit.dark(b.Color, 0.45), 0.55)
					dot(x, y, 5, Kit.jitter(NAIL, 0.08, rng), 0)
				end
			end
		end
	end
end

local function stringer(m: Model, x: number, color: Color3, notched: boolean)
	if not notched then
		Kit.box(m, C(x, 0, 0), V(STRINGER_W, HGT, STRINGER_D), color, Mat.Wood, BOARD)
		return
	end
	-- Лага с вырезами под вилы погрузчика: сплошная часть у настила и три «ножки» у нижних досок
	local front = 0.45
	Kit.box(m, C(x, 0, -STRINGER_D / 2 + front / 2), V(STRINGER_W, HGT, front), color, Mat.Wood, BOARD)
	for _, y in { -1.2, 0, 1.2 } do
		Kit.box(m, C(x, y, -STRINGER_D / 2 + front + (STRINGER_D - front) / 2), V(STRINGER_W, 0.6, STRINGER_D - front), Kit.dark(color, 0.06), Mat.Wood, BOARD)
	end
end

-- Нижние доски (обратная сторона, +Z)
local function backBoards(m: Model, rng: Random, color: Color3, skip: number?)
	for i, y in { -1.2, 0, 1.2 } do
		if i ~= skip then
			local b: Board = {
				X0 = -LEN / 2 + rng:NextNumber(0, 0.08),
				X1 = LEN / 2 - rng:NextNumber(0, 0.08),
				Y = y,
				W = 0.58,
				Color = Kit.jitter(color, 0.08, rng),
				Tilt = rng:NextNumber(-0.5, 0.5),
			}
			board(m, b, BACK_Z)
		end
	end
end

-- Обычная доска настила во всю длину
local function full(rng: Random, y: number, w: number, color: Color3): Board
	return {
		X0 = -LEN / 2 + rng:NextNumber(0, 0.06),
		X1 = LEN / 2 - rng:NextNumber(0, 0.06),
		Y = y,
		W = w,
		Color = Kit.jitter(color, 0.09, rng),
		Tilt = rng:NextNumber(-0.6, 0.6),
		Nailed = true,
	}
end

T.Pallet = {
	Variants = 3,
	Build = function(rng: Random, variant: number)
		local m = Kit.model("Pallet")
		m:SetAttribute("Kind", "Pallet")
		local hitbox = Kit.box(m, CFrame.identity, V(LEN, HGT, 1.2), Color3.new(0, 0, 0), Mat.SmoothPlastic, { Transparency = 1, CanCollide = false })
		hitbox.Name = "Hitbox"
		Kit.setOrigin(m, hitbox)

		local deck: { Board } = {}
		if variant == 1 then
			-- Заводская: пять ровных досок, лаги с вырезами
			local wood = Kit.jitter(Color3.fromRGB(134, 110, 82), 0.04, rng)
			local widths = { 0.5, 0.38, 0.42, 0.38, 0.5 }
			for i, y in layout(widths) do
				table.insert(deck, full(rng, y, widths[i], wood))
			end
			-- верхняя доска сдвинута и торчит, у нижней отколот угол
			deck[5].X0 += 0.25
			deck[5].X1 += 0.12
			deck[1].X1 -= 0.35
			for _, b in deck do
				board(m, b, DECK_Z)
			end
			splinter(m, deck[1], DECK_Z, 1, 0.3, 0.6, true)
			for _, x in STRINGERS do
				stringer(m, x, Kit.dark(wood, 0.24), true)
			end
			backBoards(m, rng, Kit.dark(wood, 0.08))
		elseif variant == 2 then
			-- Старая и сырая: доска сломана и висит на одном гвозде, другой не хватает, одна заменена
			local wood = Kit.jitter(Color3.fromRGB(98, 84, 68), 0.04, rng)
			local widths = { 0.54, 0.5, 0.5, 0.48, 0.52 }
			local ys = layout(widths)
			deck[1] = full(rng, ys[1], widths[1], wood)
			deck[2] = full(rng, ys[2], widths[2], wood)
			deck[2].X1 = -0.25 -- правая половина отломана
			deck[3] = full(rng, ys[3], widths[3], wood)
			deck[3].X1 = 0.45
			deck[4] = full(rng, ys[4], widths[4], Color3.fromRGB(150, 122, 86)) -- новая доска взамен сгнившей
			deck[5] = full(rng, ys[5], widths[5], wood)
			deck[5].X0 += 0.3
			for _, b in deck do
				board(m, b, DECK_Z)
			end
			splinter(m, deck[2], DECK_Z, 1, 0.45, 0.7, false)
			splinter(m, deck[3], DECK_Z, 1, 0.35, 0.55, true)
			-- обломок средней доски провис на гвозде правой лаги
			local hanging: Board = {
				X0 = 0.8,
				X1 = LEN / 2 - 0.05,
				Y = ys[3],
				W = widths[3],
				Color = Kit.jitter(wood, 0.06, rng),
			}
			local piece = board(m, hanging, DECK_Z - 0.04)
			local pivot = C(STRINGERS[3], ys[3], DECK_Z - 0.04)
			piece.CFrame = Kit.aroundHinge(piece.CFrame, pivot, A(0, 4, 19))
			splinter(m, hanging, DECK_Z - 0.04, -1, 0.3, 0.6, false)
			for _, x in STRINGERS do
				stringer(m, x, Kit.dark(wood, 0.2), false)
			end
			backBoards(m, rng, Kit.dark(wood, 0.05), 2)
		else
			-- Самодельная: шесть разномастных узких досок (одна — крашеная от старого ящика) и косая распорка сзади
			local wood = Kit.jitter(Color3.fromRGB(122, 98, 72), 0.04, rng)
			local widths = { 0.42, 0.36, 0.4, 0.34, 0.42, 0.38 }
			local colors = { wood, Color3.fromRGB(86, 94, 98), wood, Kit.dark(wood, 0.3), wood, Color3.fromRGB(140, 116, 84) }
			for i, y in layout(widths) do
				local b = full(rng, y, widths[i], colors[i])
				b.X0 += rng:NextNumber(-0.05, 0.25)
				b.X1 -= rng:NextNumber(-0.05, 0.25)
				b.Tilt = rng:NextNumber(-1.2, 1.2)
				table.insert(deck, b)
			end
			for _, b in deck do
				board(m, b, DECK_Z)
			end
			for _, x in STRINGERS do
				stringer(m, x + rng:NextNumber(-0.1, 0.1), Kit.dark(wood, 0.22), false)
			end
			backBoards(m, rng, Kit.dark(wood, 0.1))
			-- косая распорка поверх нижних досок
			local z = BACK_Z + BOARD_T / 2 + 0.07
			Kit.bar(m, V(-2.3, -1.3, z), V(2.3, 1.3, z), 0.14, Kit.jitter(wood, 0.08, rng), Mat.Wood, BOARD, 0.4)
		end
		nailHeads(m, deck, rng)
		m:SetAttribute("State", "Up")
		return m
	end,
}

return M
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="59">
              <Properties>
                <string name="Name">Totem</string>
                <string name="Source"><![CDATA[-- Тотемы (обычный и проклятый)
-- Модель строится в начале координат: земля y = 0, «перед» модели смотрит в -Z.
-- Требования — Art/Contract.lua; подвижные части — Kit.movable (см. Map/PropFX.lua).
local Kit = require(script.Parent.Parent.Kit)

local P = Kit.Palette
local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new

local M = {}
local T = {}
M.Templates = T

------------------------------------------------------------------------
-- Тотем: кривой кол в холмике земли, на нём череп; кости и рёбра примотаны верёвкой,
-- сзади рога или веер палок, вокруг оплывшие свечи. У проклятого свечи горят (HexFlame),
-- глазницы светятся (SkullEye). Череп (группа Skull) падает при очистке.
------------------------------------------------------------------------

local DECOR = { Decor = true }
local SHADOW = { CanCollide = false, CanQuery = false, CanTouch = false } -- крупные детали: без столкновений, но с тенью
local DIRT = Color3.fromRGB(62, 50, 40)
local STICK = Color3.fromRGB(70, 54, 40)
local ROPE = Color3.fromRGB(122, 104, 76)
local ANTLER = Color3.fromRGB(170, 154, 126)

-- Два бугра холмика: шары, утопленные в землю (центр, радиус). Над землёй (y = 0) торчит лишь
-- низкий купол, остальное скрыто ландшафтом карты (рендер превью рисует шары целиком).
local MOUND = {
	{ Pos = V(0, -1.15, 0), R = 1.5 },
	{ Pos = V(0.55, -0.9, 0.45), R = 1.15 },
}

-- Высота холмика в точке (x, z)
local function groundAt(x: number, z: number): number
	local h = 0
	for _, b in MOUND do
		local dx, dz = x - b.Pos.X, z - b.Pos.Z
		local r2 = b.R * b.R - dx * dx - dz * dz
		if r2 > 0 then
			h = math.max(h, b.Pos.Y + math.sqrt(r2))
		end
	end
	return h
end

type Style = {
	Lean: number, -- наклон кола (градусы вокруг Z)
	Crown: string, -- "Antlers" | "Fan" | "Broken"
	Crossbar: boolean,
	Ribs: number,
	Rags: number,
	Jaw: boolean, -- нижняя челюсть на месте (иначе валяется на земле)
	Chime: boolean, -- подвешенные на верёвках косточки
	Candles: number,
	Stones: number,
	RagColor: Color3,
}

local STYLES: { Style } = {
	{ Lean = 3, Crown = "Antlers", Crossbar = true, Ribs = 2, Rags = 2, Jaw = true, Chime = false, Candles = 3, Stones = 2, RagColor = Color3.fromRGB(96, 82, 62) },
	{ Lean = -4, Crown = "Fan", Crossbar = false, Ribs = 3, Rags = 1, Jaw = true, Chime = false, Candles = 3, Stones = 3, RagColor = Color3.fromRGB(84, 70, 60) },
	{ Lean = 11, Crown = "Broken", Crossbar = true, Ribs = 0, Rags = 3, Jaw = false, Chime = true, Candles = 2, Stones = 2, RagColor = Color3.fromRGB(74, 66, 58) },
}
local HEX_STYLE: Style = { Lean = 4, Crown = "Antlers", Crossbar = true, Ribs = 2, Rags = 2, Jaw = true, Chime = false, Candles = 5, Stones = 1, RagColor = Color3.fromRGB(78, 30, 26) }

-- Длинная кость: стержень и утолщения на концах (knobs = 1 или 2)
local function bone(m: Model, a: Vector3, b: Vector3, d: number, color: Color3, knobs: number)
	Kit.rod(m, a, b, d, color, Mat.SmoothPlastic, DECOR)
	Kit.ball(m, C(a), d * 1.9, Kit.dark(color, 0.04), Mat.SmoothPlastic, DECOR)
	if knobs > 1 then
		Kit.ball(m, C(b), d * 1.7, Kit.dark(color, 0.06), Mat.SmoothPlastic, DECOR)
	end
end

-- Изогнутая палка/ребро по трём точкам (2 детали)
local function curve(m: Model, a: Vector3, mid: Vector3, b: Vector3, d: number, color: Color3, material: Enum.Material)
	Kit.rod(m, a, mid, d, color, material, DECOR)
	Kit.rod(m, mid, b, d * 0.85, color, material, DECOR)
end

-- Обмотка верёвкой вокруг оси (axis — направление палки)
local function lashing(m: Model, at: Vector3, axis: Vector3, d: number, len: number)
	local cf = CFrame.lookAt(at, at + axis) * A(0, 90, 0)
	Kit.cyl(m, cf, len, d, ROPE, Mat.Fabric, DECOR)
end

-- Череп в локальной системе skull (начало — центр черепной коробки, лицо в -Z).
-- Возвращает детали группы Skull; глазницы помечены SkullEye.
local function skull(m: Model, cf: CFrame, hex: boolean, withJaw: boolean, rng: Random): { BasePart }
	local ivory = Kit.jitter(P.OldBone, 0.05, rng)
	local hollow = Color3.fromRGB(22, 16, 12)
	local parts = {}
	local function add(p: BasePart)
		table.insert(parts, p)
	end
	-- черепная коробка, надбровье, лицевая часть (скулы и верхняя челюсть)
	add(Kit.ball(m, C((cf * C(0, 0.1, 0.08)).Position), 0.8, ivory, Mat.SmoothPlastic, SHADOW))
	add(Kit.box(m, cf * C(0, 0.07, -0.29), V(0.64, 0.08, 0.12), Kit.dark(ivory, 0.06), Mat.SmoothPlastic, DECOR))
	add(Kit.box(m, cf * C(0, -0.16, -0.18), V(0.58, 0.4, 0.28), Kit.dark(ivory, 0.03), Mat.SmoothPlastic, DECOR))
	-- глазницы: тёмные диски чуть впереди лица (у проклятого светятся)
	for _, x in { -0.15, 0.15 } do
		local eye = Kit.cyl(m, cf * C(x, -0.07, -0.31) * A(0, 90, 0), 0.06, 0.24, hex and Color3.fromRGB(255, 72, 30) or hollow, hex and Mat.Neon or Mat.SmoothPlastic, DECOR)
		eye:SetAttribute("SkullEye", true)
		add(eye)
	end
	-- носовая впадина ромбом
	add(Kit.box(m, cf * C(0, -0.22, -0.33) * A(0, 0, 45), V(0.1, 0.1, 0.02), hollow, Mat.SmoothPlastic, DECOR))
	-- верхние зубы (чуть утоплены)
	add(Kit.box(m, cf * C(0, -0.4, -0.26), V(0.34, 0.08, 0.08), Color3.fromRGB(190, 172, 132), Mat.SmoothPlastic, DECOR))
	if withJaw then
		-- приоткрытая нижняя челюсть
		local jaw = Kit.aroundHinge(cf * C(0, -0.49, -0.15), cf * C(0, -0.42, 0.03), A(-12, 0, 0))
		add(Kit.box(m, jaw, V(0.44, 0.1, 0.34), Kit.dark(ivory, 0.08), Mat.SmoothPlastic, DECOR))
	end
	return parts
end

local function buildTotem(rng: Random, hex: boolean, style: Style): Model
	local m = Kit.model(hex and "HexTotem" or "Totem")
	m:SetAttribute("Kind", "Totem")

	-- Холмик земли и камни
	local root = Kit.ball(m, C(MOUND[1].Pos), MOUND[1].R * 2, Kit.jitter(DIRT, 0.04, rng), Mat.Ground, DECOR)
	root.Name = "Base"
	Kit.setOrigin(m, root)
	Kit.ball(m, C(MOUND[2].Pos), MOUND[2].R * 2, Kit.jitter(Kit.dark(DIRT, 0.12), 0.04, rng), Mat.Mud, DECOR)
	for i = 1, style.Stones do
		local a = math.rad(-150 + i * 95 + rng:NextNumber(-20, 20))
		local r = rng:NextNumber(0.9, 1.15)
		local x, z = math.cos(a) * r, math.sin(a) * r
		local stone = Kit.jitter(Color3.fromRGB(86, 84, 80), 0.06, rng)
		local g = groundAt(x, z)
		if i == 2 then
			-- круглый валун, наполовину в земле
			Kit.ball(m, C(x, g - 0.08, z), rng:NextNumber(0.55, 0.7), stone, Mat.Rock, DECOR)
		else
			-- острый осколок камня (клин)
			local size = V(rng:NextNumber(0.45, 0.6), rng:NextNumber(0.4, 0.55), rng:NextNumber(0.6, 0.8))
			Kit.wedge(m, C(x, g + size.Y / 2 - 0.1, z) * A(rng:NextNumber(-8, 8), math.deg(-a) + 90 + rng:NextNumber(-30, 30), 0), size, stone, Mat.Slate, DECOR)
		end
	end

	-- Кривой кол (нижняя часть сталкивается, чтобы сквозь тотем не ходили)
	local lean = CFrame.Angles(0, 0, math.rad(style.Lean))
	local function up(v: Vector3): Vector3
		return lean:PointToWorldSpace(v)
	end
	local stakeTop = up(V(0, 2.35, 0.03))
	local stakeMid = up(V(0.07, 1.25, 0.06))
	Kit.rod(m, V(0, 0.05, 0.04), stakeMid, 0.24, Kit.jitter(STICK, 0.05, rng), Mat.Wood)
	Kit.rod(m, stakeMid, stakeTop, 0.2, Kit.jitter(STICK, 0.05, rng), Mat.Wood, SHADOW)

	-- Подпорки шалашом
	for i = 1, 3 do
		local a = math.rad(i * 120 + rng:NextNumber(-25, 25) + 30)
		local foot = V(math.cos(a) * 0.85, 0, math.sin(a) * 0.85)
		foot += V(0, groundAt(foot.X, foot.Z) - 0.05, 0)
		local cross = up(V(0, 1.45 + i * 0.12, 0.04))
		local tip = cross + (cross - foot).Unit * rng:NextNumber(0.35, 0.6)
		Kit.rod(m, foot, tip, rng:NextNumber(0.09, 0.12), Kit.jitter(STICK, 0.08, rng), Mat.Wood, DECOR)
	end
	lashing(m, up(V(0.04, 1.62, 0.05)), up(V(0, 1, 0)) - up(V(0, 0, 0)), 0.32, 0.3)

	-- Перекладина с тряпками и рёбрами
	local barL, barR = up(V(-0.85, 1.92, 0.12)), up(V(0.82, 1.84, 0.12))
	if style.Crossbar then
		Kit.rod(m, barL, barR, 0.12, Kit.jitter(STICK, 0.06, rng), Mat.Wood, DECOR)
		lashing(m, up(V(0, 1.88, 0.08)), V(1, 0, 0), 0.3, 0.22)
	end
	-- без перекладины тряпки повязаны на кол
	local hangs = style.Crossbar and { barL:Lerp(barR, 0.06), barR:Lerp(barL, 0.1), barL:Lerp(barR, 0.3) }
		or { up(V(0.1, 2.05, -0.1)), up(V(-0.12, 1.75, -0.1)), up(V(0, 1.5, -0.12)) }
	for i = 1, style.Rags do
		local top = hangs[i] + V(0, -0.04, -0.02)
		local len = rng:NextNumber(0.7, 1.1)
		local rag = C(top + V(0, -len / 2, -0.04)) * A(rng:NextNumber(-8, 8), rng:NextNumber(-35, 35), rng:NextNumber(-8, 8))
		Kit.box(m, rag, V(rng:NextNumber(0.16, 0.26), len, 0.03), Kit.jitter(style.RagColor, 0.06, rng), Mat.Fabric, DECOR)
	end

	-- Скрещённые кости перед колом
	local boneColor = Kit.jitter(P.OldBone, 0.05, rng)
	local c = up(V(0.02, 1.15, -0.2))
	bone(m, c + V(-0.36, -0.42, 0.02), c + V(0.34, 0.44, 0.02), 0.13, boneColor, 2)
	bone(m, c + V(0.36, -0.4, -0.04), c + V(-0.3, 0.38, -0.04), 0.11, Kit.dark(boneColor, 0.05), 1)
	lashing(m, c + V(0, 0.01, -0.02), V(0, 0, 1), 0.24, 0.22)

	-- Рёбра: изогнутые дуги, свисающие с перекладины (или примотанные к колу веером)
	for i = 1, style.Ribs do
		local side = i % 2 == 1 and -1 or 1
		local a = style.Crossbar and barL:Lerp(barR, 0.5 + side * (0.22 + i * 0.05)) or up(V(side * 0.1, 1.3 + i * 0.18, 0.08))
		local mid = a + V(side * 0.28, -0.32, -0.16)
		local b = mid + V(-side * 0.08, -0.36, -0.1)
		curve(m, a, mid, b, 0.07, Kit.jitter(P.Bone, 0.06, rng), Mat.SmoothPlastic)
	end

	-- Подвешенные на верёвках косточки
	if style.Chime then
		for i, t in { 0.72, 0.9 } do
			local top = barL:Lerp(barR, t)
			local low = top + V(0, -0.35 - i * 0.12, 0)
			Kit.rod(m, top, low, 0.03, ROPE, Mat.Fabric, DECOR)
			Kit.rod(m, low, low + V(0.05, -0.3, 0.02), 0.07, Kit.jitter(P.Bone, 0.06, rng), Mat.SmoothPlastic, DECOR)
		end
	end

	-- Корона за черепом: рога, веер палок или обломанный рог
	local crownBase = stakeTop + V(0, -0.1, 0.12)
	if style.Crown == "Antlers" or style.Crown == "Broken" then
		for _, side in { -1, 1 } do
			-- ствол рога уходит в сторону и вверх, отросток смотрит вперёд
			local col = Kit.jitter(ANTLER, 0.05, rng)
			local p0 = crownBase + V(side * 0.1, 0.05, 0.02)
			if style.Crown == "Broken" and side == 1 then
				Kit.rod(m, p0, p0 + V(side * 0.32, 0.2, 0.06), 0.13, col, Mat.SmoothPlastic, DECOR) -- обломанный пенёк
				continue
			end
			local p1 = p0 + V(side * 0.55, 0.32, 0.1)
			local p2 = p1 + V(side * 0.15, 0.62, -0.08)
			Kit.rod(m, p0, p1, 0.13, col, Mat.SmoothPlastic, DECOR)
			Kit.rod(m, p1, p2, 0.09, col, Mat.SmoothPlastic, DECOR)
			local fork = p1:Lerp(p2, 0.3)
			Kit.rod(m, fork, fork + V(-side * 0.12, 0.42, -0.24), 0.07, col, Mat.SmoothPlastic, DECOR)
		end
	else
		for i = 1, 5 do
			local a = math.rad(-60 + (i - 1) * 30 + rng:NextNumber(-6, 6))
			local dir = V(math.sin(a), math.cos(a), 0.12)
			Kit.rod(m, crownBase, crownBase + dir * rng:NextNumber(1.0, 1.35), rng:NextNumber(0.05, 0.08), Kit.jitter(STICK, 0.1, rng), Mat.Wood, DECOR)
		end
	end
	lashing(m, crownBase + V(0, -0.02, -0.02), up(V(0, 1, 0)) - up(V(0, 0, 0)), 0.28, 0.24)

	-- Череп (группа Skull): на колу; при очистке падает и откатывается вперёд
	local skullCF = C(stakeTop + V(0, 0.24, -0.02)) * lean * A(rng:NextNumber(-6, 4), rng:NextNumber(-12, 12), rng:NextNumber(-6, 6))
	local fallen = C(0.75, 0.43, -1.25) * A(-15, rng:NextNumber(20, 60), 78)
	for _, p in skull(m, skullCF, hex, style.Jaw, rng) do
		local rel = skullCF:ToObjectSpace(p.CFrame)
		local cf0, cf1 = skullCF * rel, fallen * rel
		if (p :: Part).Shape == Enum.PartType.Ball then
			-- шару поворот не нужен: храним только положение
			cf0, cf1 = C(cf0.Position), C(cf1.Position)
		end
		Kit.movable(m, p, "Skull", cf0, cf1)
	end
	if not style.Jaw then
		-- челюсть давно отвалилась и лежит на холмике
		local x, z = -0.55, -0.7
		Kit.box(m, C(x, groundAt(x, z) + 0.04, z) * A(-8, 35, 4), V(0.48, 0.12, 0.42), Kit.dark(boneColor, 0.1), Mat.SmoothPlastic, DECOR)
	end

	-- Оплывшие свечи (у проклятого горят)
	local flames = 0
	for i = 1, style.Candles do
		local a = math.rad(200 + (i - 0.5) * (150 / style.Candles) + rng:NextNumber(-8, 8))
		local r = rng:NextNumber(0.75, 1.15)
		local x, z = math.cos(a) * r, math.sin(a) * r
		local g = groundAt(x, z)
		local h = rng:NextNumber(0.3, hex and 0.8 or 0.6)
		local d = rng:NextNumber(0.2, 0.3)
		local wax = Kit.jitter(P.Wax, 0.05, rng)
		Kit.vcyl(m, C(x, g + h / 2 - 0.02, z) * A(rng:NextNumber(-5, 5), 0, rng:NextNumber(-5, 5)), h, d, wax, Mat.SmoothPlastic, DECOR)
		if i <= 2 then
			Kit.vcyl(m, C(x, g + 0.01, z), 0.05, d * 2.1, Kit.dark(wax, 0.06), Mat.SmoothPlastic, DECOR)
		end
		if hex then
			local flame = Kit.box(m, C(x, g + h + 0.1, z) * A(0, 45, 0), V(0.09, 0.2, 0.09), P.Flame, Mat.Neon, DECOR)
			flame:SetAttribute("HexFlame", true)
			flames += 1
			if flames == 2 then
				Kit.pointLight(flame, Color3.fromRGB(255, 130, 60), 10, 1.8)
				Kit.emitter(flame, "Fire", 0.12).Rate = 10
			end
		end
	end

	-- Мелкая косточка на холмике
	if not hex then
		local x, z = 0.4, -0.75
		local g = groundAt(x, z)
		Kit.rod(m, V(x - 0.2, g + 0.03, z), V(x + 0.2, g + 0.06, z - 0.1), 0.07, Kit.jitter(P.Bone, 0.06, rng), Mat.SmoothPlastic, DECOR)
	end

	m:SetAttribute("Hex", hex)
	m:SetAttribute("Progress", 0)
	m:SetAttribute("Cleansed", false)
	return m
end

T.Totem = {
	Variants = 3,
	Build = function(rng: Random, variant: number)
		return buildTotem(rng, false, STYLES[variant] or STYLES[1])
	end,
}
T.HexTotem = {
	Variants = 1,
	Build = function(rng: Random)
		return buildTotem(rng, true, HEX_STYLE)
	end,
}

return M
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="60">
              <Properties>
                <string name="Name">Trap</string>
                <string name="Source"><![CDATA[-- Медвежий капкан
-- Модель строится в начале координат: земля y = 0, «перед» модели смотрит в -Z.
-- Требования — Art/Contract.lua; подвижные части — Kit.movable (см. Map/PropFX.lua).
local Kit = require(script.Parent.Parent.Kit)

local P = Kit.Palette
local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new

local M = {}
local T = {}
M.Templates = T

------------------------------------------------------------------------
-- Медвежий капкан Траппера: лежит на земле. Две полукруглые челюсти с зубьями шарнирно
-- закреплены по оси X; взведён (CF0) — челюсти раскрыты и лежат плашмя кольцом вокруг тарелки,
-- сработал (CF1) — обе поднялись и сомкнулись зубьями над тарелкой. По бокам — листовые пружины,
-- от левой пружины цепь к колышку в земле.
------------------------------------------------------------------------

local R = 1.0 -- радиус челюстей
local PIVOT_Y = 0.1 -- высота оси шарниров
local JAW_W, JAW_T = 0.15, 0.08 -- высота и толщина полосы челюсти
local CLOSE = 86 -- угол смыкания: кромки челюстей сходятся над центром
local SPRING = 1.05 -- длина пружины от шарнира наружу

local DECOR = { Decor = true }
local IRON = Color3.fromRGB(58, 54, 50)
local STEEL = Color3.fromRGB(112, 108, 102)

-- Точка на дуге челюсти (side = -1 — передняя, +1 — задняя), theta 0..180
local function arcPoint(side: number, theta: number): Vector3
	local a = math.rad(theta)
	return V(R * math.cos(a), PIVOT_Y, side * R * math.sin(a))
end

T.Trap = {
	Variants = 1,
	Build = function(rng: Random)
		local m = Kit.model("BearTrap")
		m:SetAttribute("Kind", "Trap")
		local iron = Kit.jitter(IRON, 0.04, rng)
		local rust = Kit.jitter(P.Rust, 0.05, rng)

		-- Тарелка-спуск в центре (опора модели) и основание под ней
		local plate = Kit.vcyl(m, C(0, 0.09, 0), 0.05, 0.72, Kit.jitter(Color3.fromRGB(74, 66, 58), 0.04, rng), Mat.CorrodedMetal, { CanCollide = false, CanQuery = false, CanTouch = false })
		plate.Name = "Plate"
		Kit.setOrigin(m, plate)
		Kit.box(m, C(0, 0.03, 0), V(2 * R + 0.2, 0.05, 0.2), Kit.dark(iron, 0.15), Mat.CorrodedMetal, DECOR)
		-- собачка: планка поверх передней челюсти держит её до нажатия на тарелку
		Kit.bar(m, V(-0.1, 0.13, -R - 0.02), V(-0.06, 0.12, -0.3), 0.08, Kit.dark(iron, 0.05), Mat.Metal, DECOR, 0.03)

		-- Челюсти (группа TrapJaw)
		local hinge = C(0, PIVOT_Y, 0)
		local teeth = { [-1] = { 35, 75, 105, 145 }, [1] = { 18, 55, 90, 125, 162 } }
		for _, side in { -1, 1 } do
			local parts: { BasePart } = {}
			local pts = { 0, 60, 120, 180 }
			for i = 1, #pts - 1 do
				local seg = Kit.bar(m, arcPoint(side, pts[i]), arcPoint(side, pts[i + 1]), JAW_T, iron, Mat.CorrodedMetal, DECOR, JAW_W)
				if seg then
					table.insert(parts, seg)
				end
			end
			for _, theta in teeth[side] do
				-- зуб-клин на верхней кромке челюсти (острый, как у пилы), основание утоплено в полосу
				local h = 0.24
				local p = arcPoint(side, theta) + V(0, JAW_W / 2 + h / 2 - 0.04, 0)
				local tangent = arcPoint(side, theta + 1) - arcPoint(side, theta - 1)
				local cf = CFrame.lookAt(p, p + tangent * side)
				local color = rng:NextNumber() < 0.25 and STEEL:Lerp(P.DryBlood, 0.45) or Kit.jitter(STEEL, 0.05, rng)
				table.insert(parts, Kit.wedge(m, cf, V(0.05, h, 0.13), color, Mat.Metal, DECOR))
			end
			local sprung = Kit.aroundHinge(CFrame.identity, hinge, A(side < 0 and CLOSE or -CLOSE, 0, 0))
			for _, p in parts do
				Kit.movable(m, p, "TrapJaw", p.CFrame, sprung * p.CFrame)
			end
		end

		-- Листовые пружины: нижний лист на земле, верхний поднимается к ушку на концах челюстей
		for _, sx in { -1, 1 } do
			local near, far = sx * (R + 0.06), sx * (R + SPRING)
			Kit.box(m, C((near + far) / 2, 0.025, 0), V(SPRING, 0.04, 0.17), Kit.dark(iron, 0.05), Mat.CorrodedMetal, DECOR)
			Kit.bar(m, V(far, 0.05, 0), V(near + sx * 0.08, 0.2, 0), 0.17, iron, Mat.CorrodedMetal, DECOR, 0.04)
			Kit.cyl(m, C(far + sx * 0.02, 0.06, 0) * A(0, 90, 0), 0.17, 0.11, Kit.dark(iron, 0.1), Mat.CorrodedMetal, DECOR)
			-- ушко, охватывающее концы обеих челюстей
			Kit.cyl(m, C(near, PIVOT_Y + 0.07, 0), 0.1, 0.3, Kit.dark(rust, 0.3), Mat.CorrodedMetal, DECOR)
		end

		-- Цепь от левой пружины к колышку
		local anchor = V(-(R + SPRING) - 0.06, 0.05, 0)
		local stake = V(-(R + SPRING) - 0.55, 0.06, 0.5)
		Kit.chain(m, Kit.sag(anchor, stake, -0.02, 2), 0.3, Kit.dark(STEEL, 0.4))
		Kit.vcyl(m, C(stake.X, 0.0, stake.Z) * A(6, 0, -8), 0.3, 0.1, Kit.dark(iron, 0.2), Mat.CorrodedMetal, DECOR)
		Kit.vcyl(m, C(stake.X - 0.01, 0.16, stake.Z), 0.05, 0.18, Kit.dark(iron, 0.1), Mat.Metal, DECOR)

		m:SetAttribute("Armed", true)
		m:SetAttribute("Caught", 0)
		return m
	end,
}

return M
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">Structures</string>
              <string name="Source"><![CDATA[-- Постройки. Модули: Buildings (здания, внешняя стена), Dressing (оформление ячеек), Common (игровые помощники).
-- Правила геймплея для всех построек:
--   * ничего твёрдого дальше ±10.5 от центра ячейки 22x22;
--   * паллета — Common.pallet, окно — Common.windowSill, шкафчик — Common.locker;
--   * стены «петель» и зданий ≥ 7 в высоту (закрывают обзор), проходы ≥ 5 шириной;
--   * точки для системы: map.TrapSpots / CrowSpots / ChestSpots / TotemSpots (CFrame).
local Common = require(script.Common)
local Buildings = require(script.Buildings)
local Dressing = require(script.Dressing)

local Structures = {}
for _, mod in { Common, Buildings, Dressing } do
	for k, v in mod do
		Structures[k] = v
	end
end

return Structures
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="62">
              <Properties>
                <string name="Name">BuildingHouse</string>
                <string name="Source"><![CDATA[-- Дом из двух комнат: оштукатуренные стены с обвалившейся штукатуркой (видна кладка), каменный цоколь
-- и угловые камни, окна для прыжка с рамами, осколками и ставнями, дверные коробки, двускатная крыша
-- из рядов кровли, свесы с водостоком, фронтоны из досок, печная труба, крыльцо с навесом на столбах,
-- обстановка (стол, опрокинутый стул, кровать, полка). Сталкиваются корпус стен (как раньше),
-- ряды кровли и фронтоны (выше 10: камера не залетает внутрь сверху).
local Kit = require(script.Parent.Parent.Kit)
local Common = require(script.Parent.Common)
local W = require(script.Parent.BuildingWalls)

local P = Kit.Palette
local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new
local DECOR = W.DECOR
local SOLID = W.SOLID

local H = 10
local PITCH = 28
local SLOPE = math.tan(math.rad(PITCH))
local RISE = 9.5 * SLOPE -- конёк над верхом стен
local OUTSIDE = { -1, 1, -1, 1 }

local function walls(cf: CFrame): ({ W.Wall }, W.Wall)
	return {
		W.wall(cf * C(0, 0, -9), 21, H, 1, { { Center = -5, Width = 5.8, Sill = 0, Top = 7.5 }, { Center = 5, Width = 4, Sill = 3, Top = 7 } }),
		W.wall(cf * C(0, 0, 9), 21, H, 1, { { Center = -5, Width = 4, Sill = 3, Top = 7 }, { Center = 5, Width = 4.5, Sill = 0, Top = 7.5 } }),
		W.wall(cf * C(-10, 0, 0) * A(0, 90, 0), 17, H, 1, { { Center = 2, Width = 4, Sill = 3, Top = 7 } }),
		W.wall(cf * C(10, 0, 0) * A(0, 90, 0), 17, H, 1),
	}, W.wall(cf * A(0, 90, 0), 17, H, 0.8, { { Center = 3, Width = 4.5, Sill = 0, Top = 7.5 } })
end

-- Удлинить крайние куски полосы (чтобы цоколь и карниз заходили за угол)
local function extend(r: W.Rect, length: number, e: number): (number, number)
	local a = r[1] <= -length / 2 + 1e-3 and r[1] - e or r[1]
	local b = r[2] >= length / 2 - 1e-3 and r[2] + e or r[2]
	return a, b
end

type Look = { Plaster: Color3, Stone: Color3, Trim: Color3, Brick: Color3, Roof: Color3, Gable: Color3 }

-- Наружные стены и перегородка
local function buildShell(map, cf: CFrame, rng: Random, look: Look)
	local outer, inner = walls(cf)
	for i, w in outer do
		local out = OUTSIDE[i]
		local zo = out * w.Thick / 2
		local face = out < 0 and Enum.NormalId.Front or Enum.NormalId.Back
		for _, p in W.core(map, w, look.Plaster, Mat.Plaster) do
			if p.Size.Y >= H - 0.01 then
				Kit.grime(p, face, 0.55)
			end
		end
		local ext = i <= 2 and 0.12 or 1
		-- каменный цоколь и деревянный карниз снаружи
		for _, r in W.band(w, 0, 1.2) do
			local a, b = extend(r, w.Length, ext)
			Kit.box(map.Decor, w.CF * C((a + b) / 2, 0.6, zo + out * 0.06), V(b - a, 1.2, 0.12), look.Stone, Mat.Concrete, DECOR)
		end
		Kit.box(map.Decor, w.CF * C(0, H - 0.3, zo + out * 0.09), V(w.Length + ext * 2 + 0.12, 0.6, 0.18), look.Trim, Mat.Wood, DECOR)
		-- изнутри: панели из досок по низу стены
		for _, r in W.band(w, 0, 3.2) do
			Kit.box(map.Decor, w.CF * C((r[1] + r[2]) / 2, (r[3] + r[4]) / 2, -zo - out * 0.04), V(r[2] - r[1], r[4] - r[3], 0.08), Kit.dark(look.Trim, 0.1), Mat.WoodPlanks, DECOR)
		end
		-- обвалившаяся штукатурка: неровные пятна кладки
		for _ = 1, 2 do
			local x, y = W.spot(w, rng, 2.4, 8, 1.5)
			if x then
				W.patch(map.Decor, rng, w, out, x, y, Vector2.new(rng:NextNumber(1.2, 2.6), rng:NextNumber(0.8, 1.5)), look.Brick, Mat.Brick)
			end
		end
		for _, o in w.Openings do
			W.frame(map.Decor, w, o, look.Trim, Mat.Wood, 0.2)
			if o.Sill > 0 then
				W.shards(map.Decor, w, o, rng, 2)
				-- ставня сбоку от окна и трещина от угла рамы
				local s = rng:NextNumber() < 0.5 and -1 or 1
				local sx = o.Center + s * (o.Width / 2 + 1.35)
				Kit.box(map.Decor, w.CF * C(sx, 5, zo + out * 0.11) * A(0, 0, rng:NextNumber(-7, 7)), V(1.85, 3.7, 0.12), Kit.jitter(Color3.fromRGB(62, 74, 70), 0.06, rng), Mat.Wood, DECOR)
				local cx = o.Center - s * (o.Width / 2 + 0.3)
				local p0 = w.CF * C(cx, o.Top + 0.3, zo + out * 0.01)
				local p1 = w.CF * C(cx - s * 0.5, o.Top + 1.1, zo + out * 0.01)
				local p2 = w.CF * C(cx - s * 0.7, H - 0.6, zo + out * 0.01)
				Kit.bar(map.Decor, p0.Position, p1.Position, 0.02, P.Black, Mat.SmoothPlastic, DECOR, 0.07)
				Kit.bar(map.Decor, p1.Position, p2.Position, 0.02, P.Black, Mat.SmoothPlastic, DECOR, 0.05)
			end
		end
	end
	-- угловые камни (поочерёдно длинные и короткие вдоль каждой грани)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			for k = 0, 5 do
				local lx, lz = k % 2 == 0 and 1.4 or 0.8, k % 2 == 0 and 0.8 or 1.4
				local pos = cf * C(sx * (10.6 - lx / 2), 1.85 + k * 1.37, sz * (9.6 - lz / 2))
				Kit.box(map.Decor, pos, V(lx, 1.25, lz), Kit.jitter(P.Concrete, 0.05, rng), Mat.Concrete, DECOR)
			end
		end
	end
	-- перегородка: доски, коробка двери, распахнутая дверь у стены
	local wood = Kit.jitter(P.OldWood, 0.04, rng)
	W.core(map, inner, wood, Mat.WoodPlanks)
	W.frame(map.Decor, inner, inner.Openings[1], look.Trim, Mat.Wood, 0.18)
	local door = cf * C(0.7, 3.65, 1.75)
	Kit.box(map.Decor, door, V(0.15, 7.1, 4.2), Kit.jitter(Color3.fromRGB(88, 70, 54), 0.05, rng), Mat.Wood, DECOR)
	for _, dy in { -1.7, 1.6 } do
		Kit.box(map.Decor, door * C(0.09, dy, 0), V(0.05, 2.4, 3.0), Kit.jitter(Color3.fromRGB(78, 62, 48), 0.05, rng), Mat.Wood, DECOR)
	end
	Kit.ball(map.Decor, door * C(0.14, -0.3, 1.7), 0.22, P.Steel, Mat.Metal, DECOR)
end

-- Крыша: ряды кровли (каждый следующий ложится на предыдущий), конёк, ветровые доски, фронтоны, труба
local function buildRoof(map, cf: CFrame, rng: Random, look: Look)
	local cosP = math.cos(math.rad(PITCH))
	local u0, u1 = -0.9 / cosP, 9.5 / cosP
	local courses, cw = 7, 2
	for _, s in { -1, 1 } do
		local sf = cf * C(0, H, s * 9.5) * (s < 0 and A(-PITCH, 0, 0) or A(0, 180, 0) * A(-PITCH, 0, 0))
		local first, last = u0 + cw / 2, u1 - cw / 2 + 0.15
		local moss = rng:NextInteger(1, courses - 2)
		for k = 0, courses - 1 do
			local u = first + (last - first) * k / (courses - 1)
			local course = sf * C(0, 0.16, u) * A(2.5, 0, 0)
			local p = Kit.box(map.Walls, course, V(21, 0.22, cw), Kit.jitter(look.Roof, 0.05, rng), Mat.RoofShingles)
			p.Name = "Roof"
			if k == moss then
				-- мох на одном ряду
				Kit.box(map.Decor, course * C(rng:NextNumber(-7, 7), 0.125, rng:NextNumber(-0.2, 0.2)), V(rng:NextNumber(1.5, 3), 0.04, 1.2), Kit.jitter(Color3.fromRGB(66, 74, 54), 0.05, rng), Mat.Grass, DECOR)
			end
		end
		for _, x in { -10.62, 10.62 } do
			Kit.box(map.Decor, sf * C(x, 0.12, (u0 + u1) / 2 + 0.05), V(0.22, 0.6, u1 - u0 + 0.1), look.Trim, Mat.Wood, SOLID)
		end
		Kit.box(map.Decor, cf * C(0, H - 0.9 * SLOPE - 0.1, s * 10.33), V(21.4, 0.55, 0.14), Kit.dark(look.Trim, 0.1), Mat.Wood, DECOR)
		-- фронтоны (половинки треугольника, высокая сторона к коньку) с вентиляционной решёткой
		for _, sx in { -1, 1 } do
			Kit.wedge(map.Walls, cf * C(sx * 10, H + RISE / 2, s * 4.75) * A(0, s < 0 and 0 or 180, 0), V(1, RISE, 9.5), look.Gable, Mat.WoodPlanks)
		end
	end
	for _, sx in { -1, 1 } do
		Kit.box(map.Decor, cf * C(sx * 10.54, H + RISE * 0.42, 0), V(0.08, 1.4, 1.8), look.Trim, Mat.Wood, DECOR)
		Kit.box(map.Decor, cf * C(sx * 10.55, H + RISE * 0.42, 0), V(0.1, 1.0, 1.4), P.Black, Mat.SmoothPlastic, DECOR)
	end
	Kit.box(map.Decor, cf * C(0, H + RISE + 0.36, 0), V(21.3, 0.32, 1.2), Kit.dark(look.Roof, 0.2), Mat.Slate, SOLID)
	Kit.box(map.Decor, cf * C(0, H + RISE + 0.6, 0), V(21.3, 0.2, 0.6), Kit.dark(look.Roof, 0.25), Mat.Slate, SOLID)
	-- водосток сзади: часть оторвалась и висит, труба уходит к стене
	local gutter = Kit.jitter(P.DarkSteel, 0.05, rng)
	Kit.cyl(map.Decor, cf * C(-3.25, 9.25, 10.5), 14.5, 0.4, gutter, Mat.Metal, DECOR)
	Kit.cyl(map.Decor, cf * C(4, 9.25, 10.5) * A(0, 0, -18) * C(3.1, 0, 0), 6.2, 0.4, gutter, Mat.Metal, DECOR)
	Kit.rod(map.Decor, (cf * C(-10.1, 9.2, 10.5)).Position, (cf * C(-10.1, 8.3, 9.78)).Position, 0.3, gutter, Mat.Metal, DECOR)
	Kit.rod(map.Decor, (cf * C(-10.1, 8.45, 9.78)).Position, (cf * C(-10.1, 0.2, 9.78)).Position, 0.3, gutter, Mat.Metal, DECOR)
	-- печная труба над задним скатом
	local chimney = cf * C(7.2, 0, 4.2)
	Kit.box(map.Decor, chimney * C(0, 14.95, 0), V(1.8, 5.3, 1.8), Kit.jitter(look.Brick, 0.04, rng), Mat.Brick, SOLID)
	Kit.box(map.Decor, chimney * C(0, 17.15, 0), V(1.84, 0.9, 1.84), Kit.dark(look.Brick, 0.6), Mat.Brick, DECOR)
	Kit.box(map.Decor, chimney * C(0, 17.75, 0), V(2.2, 0.3, 2.2), P.DarkConcrete, Mat.Concrete, SOLID)
	Kit.vcyl(map.Decor, chimney * C(0.2, 18.35, -0.1), 0.9, 0.6, Kit.jitter(Color3.fromRGB(120, 72, 52), 0.05, rng), Mat.Slate, DECOR)
end

-- Крыльцо перед входом с паллетой: настил, ступень, столбы, балка, навес
local function buildPorch(map, cf: CFrame, rng: Random, look: Look)
	local deck = Kit.jitter(P.OldWood, 0.05, rng)
	for k, z in { -9.72, -10.17 } do
		Kit.box(map.Decor, cf * C(-5, 0.125, z), V(9.2, 0.25, 0.42), Kit.jitter(deck, 0.06, rng), Mat.WoodPlanks, DECOR)
		if k == 1 then
			Kit.box(map.Decor, cf * C(-5, 0.06, -10.62), V(5, 0.12, 0.45), Kit.dark(deck, 0.15), Mat.WoodPlanks, DECOR)
		end
	end
	for _, x in { -9.55, -0.45 } do
		Kit.box(map.Decor, cf * C(x, 4.15, -10.15) * A(rng:NextNumber(-1.5, 1.5), 0, rng:NextNumber(-1.5, 1.5)), V(0.42, 8.3, 0.42), Kit.jitter(look.Trim, 0.05, rng), Mat.Wood, DECOR)
	end
	Kit.box(map.Decor, cf * C(-5, 8.5, -10.15), V(9.6, 0.4, 0.4), look.Trim, Mat.Wood, DECOR)
	Kit.bar(map.Decor, (cf * C(-5, 9.05, -9.45)).Position, (cf * C(-5, 8.55, -10.75)).Position, 10.2, Kit.jitter(look.Roof, 0.05, rng), Mat.RoofShingles, SOLID, 0.18)
	-- погасший фонарь у двери
	Kit.box(map.Decor, cf * C(-1.3, 6.4, -9.58), V(0.35, 0.5, 0.16), P.Iron, Mat.Metal, DECOR)
	Kit.ball(map.Decor, cf * C(-1.3, 6.1, -9.75), 0.35, Color3.fromRGB(90, 84, 70), Mat.Glass, DECOR)
end

-- Обстановка (декор у стен, проходы свободны)
local function buildInterior(map, cf: CFrame, rng: Random)
	-- пол из досок (часть выпала)
	local floor = Kit.jitter(Kit.dark(P.OldWood, 0.2), 0.04, rng)
	for i = 0, 18 do
		if rng:NextNumber() > 0.05 then
			Kit.box(map.Decor, cf * C(-9 + i, 0.1, 0), V(0.95, 0.2, 16.9), Kit.jitter(floor, 0.07, rng), Mat.WoodPlanks, DECOR)
		end
	end
	Kit.box(map.Decor, cf * C(-5.2, 0.215, 0.2) * A(0, rng:NextNumber(-6, 6), 0), V(4.2, 0.03, 3), Kit.jitter(Color3.fromRGB(92, 52, 44), 0.05, rng), Mat.Fabric, DECOR)
	-- левая комната: стол у перегородки и опрокинутый стул
	local wood = Kit.jitter(P.Wood, 0.05, rng)
	local tableCF = cf * C(-1.9, 0, 3.7)
	Kit.box(map.Decor, tableCF * C(0, 2.9, 0), V(2.4, 0.16, 3.2), wood, Mat.Wood, DECOR)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.box(map.Decor, tableCF * C(sx * 1.0, 1.5, sz * 1.4), V(0.2, 2.8, 0.2), Kit.dark(wood, 0.15), Mat.Wood, DECOR)
		end
	end
	Kit.vcyl(map.Decor, tableCF * C(0.4, 3.23, -0.6), 0.5, 0.22, Color3.fromRGB(60, 86, 62), Mat.Glass, DECOR)
	Kit.vcyl(map.Decor, tableCF * C(-0.3, 3.0, 0.5), 0.04, 0.75, P.OldBone, Mat.SmoothPlastic, DECOR)
	local chair = cf * C(-4.1, 0.86, 2.4) * A(0, rng:NextNumber(20, 60), 0) * A(90, 0, 0)
	Kit.box(map.Decor, chair * C(0, 1.6, 0), V(1.3, 0.14, 1.3), wood, Mat.Wood, DECOR)
	Kit.box(map.Decor, chair * C(0, 2.45, 0.6), V(1.3, 1.6, 0.12), wood, Mat.Wood, DECOR)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.box(map.Decor, chair * C(sx * 0.55, 0.8, sz * 0.55), V(0.14, 1.6, 0.14), Kit.dark(wood, 0.15), Mat.Wood, DECOR)
		end
	end
	-- правая комната: кровать у торцевой стены и полка у перегородки
	local bed = cf * C(7.85, 0, -0.2)
	local iron = Kit.jitter(P.DarkSteel, 0.05, rng)
	for _, sx in { -1, 1 } do
		Kit.box(map.Decor, bed * C(sx * 1.45, 1.0, 0), V(0.18, 0.45, 6.4), iron, Mat.Metal, DECOR)
	end
	Kit.box(map.Decor, bed * C(0, 1.6, 3.2), V(3.1, 3.2, 0.2), iron, Mat.Metal, DECOR)
	Kit.box(map.Decor, bed * C(0, 1.0, -3.3), V(3.1, 2.0, 0.2), iron, Mat.Metal, DECOR)
	Kit.box(map.Decor, bed * C(0, 1.4, 0) * A(0, 1.5, 0), V(2.8, 0.45, 6.1), Kit.jitter(Color3.fromRGB(128, 118, 96), 0.05, rng), Mat.Fabric, DECOR)
	Kit.box(map.Decor, bed * C(rng:NextNumber(-0.5, 0.5), 1.63, rng:NextNumber(-1.5, 1.5)), V(1.3, 0.02, 1.7), P.DryBlood, Mat.Fabric, DECOR)
	local shelf = cf * C(0.9, 0, 6.1)
	local board = Kit.jitter(P.Plank, 0.05, rng)
	for _, sz in { -1, 1 } do
		Kit.box(map.Decor, shelf * C(0, 2.75, sz * 1.44), V(0.9, 5.5, 0.12), Kit.dark(board, 0.1), Mat.Wood, DECOR)
	end
	for k = 0, 3 do
		Kit.box(map.Decor, shelf * C(0, 0.5 + k * 1.4, 0) * A(0, 0, k == 2 and 4 or 0), V(0.86, 0.1, 2.76), board, Mat.Wood, DECOR)
	end
	for k = 0, 2 do
		Kit.vcyl(map.Decor, shelf * C(rng:NextNumber(-0.15, 0.15), 2.18, -0.9 + k * 0.55), 0.5, 0.32, Kit.jitter(Color3.fromRGB(100, 110, 84), 0.1, rng), Mat.Glass, DECOR)
	end
	Kit.box(map.Decor, shelf * C(0, 3.75, 0.6) * A(12, 0, 0), V(0.6, 0.8, 0.22), Kit.jitter(Color3.fromRGB(80, 40, 34), 0.08, rng), Mat.Fabric, DECOR)
	Kit.box(map.Decor, shelf * C(0, 0.85, -0.4), V(0.7, 0.6, 1.0), Kit.jitter(P.Plank, 0.08, rng), Mat.Cardboard, DECOR)
	-- лампочки на шнурах под коньком
	for _, x in { -5, 5 } do
		Kit.rod(map.Decor, (cf * C(x, H + RISE - 0.1, 0)).Position, (cf * C(x, 8.9, 0)).Position, 0.06, P.Black, Mat.Rubber, DECOR)
		Kit.vcyl(map.Decor, cf * C(x, 8.82, 0), 0.25, 0.22, P.DarkSteel, Mat.Metal, DECOR)
		local bulb = Kit.ball(map.Decor, cf * C(x, 8.6, 0), 0.45, Color3.fromRGB(255, 206, 140), Mat.Neon, DECOR)
		bulb.Name = "Bulb"
		Kit.pointLight(bulb, Color3.fromRGB(255, 170, 100), 14, 0.9)
	end
end

local function house(map, cf: CFrame, rng: Random)
	local look: Look = {
		Plaster = Kit.jitter(Kit.dark(P.Plaster, 0.22), 0.03, rng),
		Stone = Kit.jitter(P.DarkConcrete, 0.04, rng),
		Trim = Kit.jitter(P.DarkWood, 0.05, rng),
		Brick = Kit.jitter(P.Brick, 0.04, rng),
		Roof = Kit.jitter(rng:NextNumber() < 0.5 and Color3.fromRGB(58, 52, 50) or Color3.fromRGB(78, 50, 42), 0.03, rng),
		Gable = Kit.jitter(Color3.fromRGB(74, 66, 58), 0.04, rng),
	}
	buildShell(map, cf, rng, look)
	buildRoof(map, cf, rng, look)
	buildPorch(map, cf, rng, look)
	buildInterior(map, cf, rng)
	Common.pallet(map, rng, cf * CFrame.new(-6.8, 3, -8) * A(0, 0, 78), cf * CFrame.new(-5, 1.5, -9))
	Common.locker(map, rng, cf * CFrame.new(-8, 0, 6.8))
	Common.locker(map, rng, cf * CFrame.new(7.6, 0, 6.8))
	table.insert(map.ChestSpots, cf * CFrame.new(-7.5, 0, -2) * A(0, 90, 0))
	table.insert(map.TotemSpots, cf * CFrame.new(7, 0, -6))
end

return house
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="63">
              <Properties>
                <string name="Name">BuildingPerimeter</string>
                <string name="Source"><![CDATA[-- Внешняя стена карты: пролёты из бетона и кирпича между пилонами, парапет поверху, потёки, заплаты.
-- Высота 16 везде, толщина 2, проёмы ворот ровно gateGap (север и юг). Стена сплошная, непрозрачная
-- и сталкивается целиком (пролёты стыкуются без щелей). Снаружи у ворот — карман откатной двери,
-- поэтому всё выступающее — только с внутренней стороны (выше 16 парапет выступает на 0.25 с обеих).
local Kit = require(script.Parent.Parent.Kit)

local P = Kit.Palette
local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new
local DECOR = { Decor = true }

local HEIGHT = 16
local THICK = 2
local SECTION = 12 -- примерная длина пролёта между пилонами
local PIER = 0.6 -- насколько пилон выступает внутрь

-- Прямой участок стены: Frame — X вдоль стены, Z наружу (y = 0 на земле); From..To — отрезок по X
type Run = { Frame: CFrame, From: number, To: number, GateFrom: boolean, GateTo: boolean }

local STYLES = {
	{ Color = P.Concrete, Mat = Mat.Concrete, Weight = 0.55 },
	{ Color = P.DarkConcrete, Mat = Mat.Concrete, Weight = 0.25 },
	{ Color = Kit.dark(P.Brick, 0.15), Mat = Mat.Brick, Weight = 0.2 },
}

local function pickStyle(rng: Random)
	local r = rng:NextNumber()
	for _, s in STYLES do
		r -= s.Weight
		if r <= 0 then
			return s
		end
	end
	return STYLES[1]
end

-- Мелочи на внутренней грани пролёта (x — центр, len — длина)
local function sectionDetail(parent: Instance, rng: Random, f: CFrame, x: number, len: number, core: BasePart)
	local zi = -THICK / 2
	local r = rng:NextNumber()
	if r < 0.3 then
		-- потёки от парапета
		for _ = 1, rng:NextInteger(1, 2) do
			local h = rng:NextNumber(3, 8)
			Kit.box(parent, f * C(x + rng:NextNumber(-len / 2 + 1, len / 2 - 1), HEIGHT - h / 2, zi - 0.02), V(rng:NextNumber(0.25, 0.6), h, 0.04), Kit.jitter(Color3.fromRGB(52, 44, 38), 0.06, rng), Mat.Concrete, DECOR)
		end
		Kit.rustStreaks(core, Enum.NormalId.Front, rng, 4)
	elseif r < 0.45 then
		-- ржавая заплата на болтах
		local plate = Kit.box(parent, f * C(x + rng:NextNumber(-2, 2), rng:NextNumber(3, 10), zi - 0.06) * A(0, 0, rng:NextNumber(-4, 4)), V(rng:NextNumber(2, 3.2), rng:NextNumber(2.2, 3.6), 0.12), Kit.jitter(P.Rust, 0.06, rng), Mat.CorrodedMetal, DECOR)
		Kit.rustStreaks(plate, Enum.NormalId.Front, rng, 3)
	elseif r < 0.55 then
		-- осыпавшиеся куски у основания
		for _ = 1, 2 do
			local s = rng:NextNumber(0.5, 1.1)
			Kit.box(parent, f * C(x + rng:NextNumber(-len / 3, len / 3), s * 0.35, zi - rng:NextNumber(0.4, 1.0)) * A(rng:NextNumber(-20, 20), rng:NextNumber(0, 90), 0), V(s, s * 0.7, s * 0.9), Kit.jitter(P.DarkConcrete, 0.06, rng), Mat.Slate, DECOR)
		end
	elseif r < 0.63 then
		-- оголённая арматура над парапетом
		for _ = 1, 2 do
			local bx = x + rng:NextNumber(-len / 3, len / 3)
			local top = f * C(bx + rng:NextNumber(-0.3, 0.3), HEIGHT + rng:NextNumber(1.0, 1.8), rng:NextNumber(-0.6, 0.6))
			Kit.rod(parent, (f * C(bx, HEIGHT + 0.3, 0)).Position, top.Position, 0.14, P.DarkRust, Mat.CorrodedMetal, DECOR)
		end
	elseif r < 0.68 then
		-- табличка
		local sign = Kit.box(parent, f * C(x + rng:NextNumber(-2, 2), rng:NextNumber(6, 8), zi - 0.04) * A(0, 0, rng:NextNumber(-6, 6)), V(3, 1.4, 0.06), Kit.jitter(Color3.fromRGB(150, 140, 112), 0.05, rng), Mat.Metal, DECOR)
		Kit.label(sign, Enum.NormalId.Front, "NO TRESPASSING", Color3.fromRGB(120, 20, 16), Enum.Font.Oswald)
	end
end

local function outerWalls(map, size: number, gateGap: number)
	local half = size / 2
	local rng = Random.new(size * 7 + gateGap)
	local runs: { Run } = {}
	for _, side in { 1, -1 } do
		local ns = CFrame.fromMatrix(V(0, 0, side * half), V(side, 0, 0), V(0, 1, 0))
		table.insert(runs, { Frame = ns, From = gateGap / 2, To = half, GateFrom = true, GateTo = false })
		table.insert(runs, { Frame = ns, From = -half, To = -gateGap / 2, GateFrom = false, GateTo = true })
		local ew = CFrame.fromMatrix(V(side * half, 0, 0), V(0, 0, -side), V(0, 1, 0))
		table.insert(runs, { Frame = ew, From = -half, To = half, GateFrom = false, GateTo = false })
	end
	local cap = Kit.jitter(P.DarkConcrete, 0.03, rng)
	for _, run in runs do
		local f = run.Frame
		local len = run.To - run.From
		local n = math.max(1, math.floor(len / SECTION + 0.5))
		local step = len / n
		for k = 0, n - 1 do
			local x = run.From + step * (k + 0.5)
			local style = pickStyle(rng)
			local core = Kit.box(map.Walls, f * C(x, HEIGHT / 2, 0), V(step, HEIGHT, THICK), Kit.jitter(style.Color, 0.04, rng), style.Mat)
			core.Name = "OuterWall"
			Kit.grime(core, Enum.NormalId.Front, 0.6)
			sectionDetail(map.Decor, rng, f, x, step, core)
			if k > 0 then
				-- пилон на стыке пролётов (только внутрь) с оголовком
				local bx = run.From + step * k
				local pier = Kit.jitter(P.Concrete, 0.04, rng)
				Kit.box(map.Decor, f * C(bx, (HEIGHT + 1.2) / 2, -THICK / 2 - PIER / 2 + 0.05), V(1.6, HEIGHT + 1.2, PIER + 0.1), pier, Mat.Concrete, DECOR)
				Kit.box(map.Decor, f * C(bx, HEIGHT + 1.38, -THICK / 2 - PIER / 2 + 0.05), V(2, 0.36, PIER + 0.9), Kit.dark(pier, 0.15), Mat.Concrete, DECOR)
			end
		end
		-- парапет вдоль участка (у ворот отступает от ригеля ворот)
		local a = run.GateFrom and run.From + 1.9 or run.From
		local b = run.GateTo and run.To - 1.9 or run.To
		Kit.box(map.Decor, f * C((a + b) / 2, HEIGHT + 0.225, 0), V(b - a, 0.45, THICK + 0.5), cap, Mat.Concrete, DECOR)
	end
	-- угловые башенки
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local pos = C(sx * half, 0, sz * half)
			local pier = Kit.jitter(P.Concrete, 0.04, rng)
			Kit.box(map.Decor, pos * C(0, (HEIGHT + 1.6) / 2, 0), V(3, HEIGHT + 1.6, 3), pier, Mat.Concrete, DECOR)
			Kit.box(map.Decor, pos * C(0, HEIGHT + 1.8, 0), V(3.5, 0.4, 3.5), Kit.dark(pier, 0.15), Mat.Concrete, DECOR)
		end
	end
end

return outerWalls
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="64">
              <Properties>
                <string name="Name">BuildingShack</string>
                <string name="Source"><![CDATA[-- Хижина маньяка (центр карты): брусчатый каркас, обшивка досками с щелями и сорванными досками,
-- односкатная крыша из ржавого профнастила на стропилах и обрешётке, две двери, два окна, паллета.
-- Сталкиваются: корпус стен (как раньше: 4 стены высотой 9 с проёмами) и листы крыши (камера не пролетает внутрь).
local Kit = require(script.Parent.Parent.Kit)
local Common = require(script.Parent.Common)
local W = require(script.Parent.BuildingWalls)

local P = Kit.Palette
local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new
local DECOR = W.DECOR

local H = 9 -- высота стен
local PLATE = H + 0.1 -- верх обвязки, на ней лежат стропила
local PITCH = 7 -- уклон крыши (градусы), высокая сторона — +X
local SLOPE = math.tan(math.rad(PITCH))

-- Стены и их наружные грани (±1 по локальной Z стены)
local function walls(cf: CFrame): { W.Wall }
	return {
		W.wall(cf * C(0, 0, -8), 17, H, 1, { { Center = 0, Width = 5.8, Sill = 0, Top = 7 } }),
		W.wall(cf * C(0, 0, 8), 17, H, 1, { { Center = 3, Width = 4, Sill = 3, Top = 7 } }),
		W.wall(cf * C(-8, 0, 0) * A(0, 90, 0), 15, H, 1, { { Center = 2, Width = 4, Sill = 3, Top = 7 } }),
		W.wall(cf * C(8, 0, 0) * A(0, 90, 0), 15, H, 1, { { Center = -2, Width = 5, Sill = 0, Top = 7 } }),
	}
end
local OUTSIDE = { -1, 1, -1, 1 }

-- Стены: корпус, наружная обшивка, внутренние стойки и ригель, нижняя и верхняя обвязка, рамы проёмов
local function buildWalls(map, cf: CFrame, rng: Random)
	local core = Kit.jitter(Color3.fromRGB(46, 36, 28), 0.03, rng)
	local board = Kit.jitter(P.OldWood, 0.04, rng)
	local timber = Kit.jitter(P.DarkWood, 0.05, rng)
	for i, w in walls(cf) do
		local out = OUTSIDE[i]
		W.core(map, w, core, Mat.WoodPlanks)
		W.boards(map.Decor, w, out, { Rng = rng, Color = board, Row = 0.95, Gap = 0.13, Missing = 0.05, Broken = 0.1, MaxLen = 7, Y0 = 0.4, Y1 = H - 0.5 })
		-- изнутри: стойки каркаса через ~2.4 и ригель на середине высоты (не у краёв проёмов)
		local zin = -out * (w.Thick / 2 + 0.15)
		local lim = w.Length / 2 - 1.2
		for _, r in W.solid(w, 0.4, H - 0.6) do
			local a, b = math.max(r[1] + 0.55, -lim), math.min(r[2] - 0.55, lim)
			if b > a then
				local n = math.max(1, math.floor((b - a) / 2.4 + 0.5))
				for k = 0, n do
					local x = a + (b - a) * k / n
					Kit.box(map.Decor, w.CF * C(x, (H - 0.2) / 2, zin), V(0.35, H - 1, 0.3), Kit.jitter(timber, 0.05, rng), Mat.Wood, DECOR)
				end
			end
		end
		for _, r in W.band(w, 4.4, 4.75) do
			local a, b = math.max(r[1], -lim - 0.6), math.min(r[2], lim + 0.6)
			if b - a > 0.8 then
				Kit.box(map.Decor, w.CF * C((a + b) / 2, 4.575, zin - out * 0.02), V(b - a, 0.35, 0.26), timber, Mat.Wood, DECOR)
			end
		end
		-- нижняя обвязка (поверх обшивки) и верхняя обвязка на всю толщину
		for _, r in W.band(w, 0, 0.4) do
			Kit.box(map.Decor, w.CF * C((r[1] + r[2]) / 2, 0.2, 0), V(r[2] - r[1], 0.4, w.Thick + 0.45), Kit.dark(timber, 0.1), Mat.Wood, DECOR)
		end
		local plateY = i <= 2 and PLATE - 0.3 or PLATE - 0.32
		Kit.box(map.Decor, w.CF * C(0, plateY, 0), V(w.Length, 0.6, w.Thick + 0.5), timber, Mat.Wood, DECOR)
		for _, o in w.Openings do
			W.frame(map.Decor, w, o, Kit.jitter(timber, 0.04, rng), Mat.Wood, 0.22)
			if o.Sill > 0 then
				W.shards(map.Decor, w, o, rng, 2)
			else
				-- порог
				Kit.box(map.Decor, w.CF * C(o.Center, 0.12, 0), V(o.Width, 0.24, w.Thick + 0.3), Kit.dark(timber, 0.2), Mat.Wood, DECOR)
			end
		end
	end
	-- угловые столбы
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.box(map.Decor, cf * C(sx * 8, PLATE / 2, sz * 8) * A(0, rng:NextNumber(-2, 2), 0), V(1.3, PLATE, 1.3), Kit.jitter(timber, 0.05, rng), Mat.Wood, DECOR)
		end
	end
	-- фронтоны под скатом (спереди и сзади — треугольники, справа — полоса)
	local rise = 17 * SLOPE
	for _, sz in { -1, 1 } do
		Kit.wedge(map.Walls, cf * C(0, PLATE + rise / 2, sz * 8) * A(0, 90, 0), V(1, rise, 17), Kit.dark(board, 0.15), Mat.WoodPlanks)
	end
	local riseR = 16.5 * SLOPE
	Kit.box(map.Walls, cf * C(8, PLATE + riseR / 2, 0), V(1, riseR, 15), Kit.dark(board, 0.15), Mat.WoodPlanks)
end

-- Крыша: стропила вдоль ската, обрешётка поперёк, два ряда профлистов с волнами; один лист сорван,
-- один задран ветром. Возвращает функцию «точка на крыше» для ворона.
local function buildRoof(map, cf: CFrame, rng: Random): (number, number) -> Vector3
	local ro = cf * C(-8.5, PLATE, 0) * A(0, 0, PITCH)
	local cosP = math.cos(math.rad(PITCH))
	local s0, s1 = -1.4 / cosP, 18.4 / cosP -- свесы по 1.4 за стены
	local timber = Kit.jitter(P.DarkWood, 0.04, rng)
	for _, z in { -8, -4, 0, 4, 8 } do
		Kit.box(map.Decor, ro * C((s0 + s1) / 2, 0.25, z), V(s1 - s0, 0.5, 0.35), Kit.jitter(timber, 0.05, rng), Mat.Wood, DECOR)
	end
	for _, s in { 0.4, 6, 11.6, 17.2 } do
		Kit.box(map.Decor, ro * C(s, 0.65, 0), V(0.4, 0.3, 19.6), Kit.dark(timber, 0.08), Mat.Wood, DECOR)
	end
	local cols, sheetW = 6, 3.5
	local step = (19.4 - sheetW) / (cols - 1)
	local mid = (s0 + s1) / 2
	local missing = rng:NextInteger(1, cols - 2)
	local lifted = rng:NextNumber() < 0.5 and 0 or cols - 1
	local tones = { Kit.dark(P.Rust, 0.15), P.DarkRust, Kit.dark(P.Steel, 0.45), Color3.fromRGB(88, 66, 50) }
	for row = 0, 1 do
		local a, b = row == 0 and s0 or mid - 0.5, row == 0 and mid + 0.5 or s1
		local len = b - a
		for col = 0, cols - 1 do
			if not (row == 0 and col == missing) then
				local z = -9.7 + sheetW / 2 + step * col + rng:NextNumber(-0.08, 0.08)
				local n = 0.84 + (col % 2) * 0.07 + row * 0.15
				local color = Kit.jitter(tones[rng:NextInteger(1, #tones)], 0.05, rng)
				local base = ro * C((a + b) / 2, n, z)
				if row == 0 and col == lifted then
					base = ro * C(b, n, z) * A(0, 0, -6) * C(-len / 2, 0, 0)
				end
				local sheet = Kit.box(map.Walls, base, V(len, 0.08, sheetW), color, Mat.CorrodedMetal)
				sheet.Name = "Roof"
				if rng:NextNumber() < 0.35 then
					Kit.rustStreaks(sheet, Enum.NormalId.Top, rng, 4)
				end
				for k = 0, 3 do
					Kit.cyl(map.Decor, base * C(0, 0.04, -1.3 + k * 0.866), len, 0.14, Kit.jitter(color, 0.03, rng), Mat.CorrodedMetal, DECOR)
				end
			end
		end
	end
	-- старая покрышка и пара кирпичей прижимают листы
	local top = 0.84 + 0.07 + 0.15 + 0.04
	Kit.cyl(map.Decor, ro * C(12, top + 0.25, 3.4) * A(0, 0, 90), 0.5, 2.1, P.Rubber, Mat.Rubber, DECOR)
	for _, at in { { 10.5, -4.4 }, { 15.5, 6.1 } } do
		Kit.box(map.Decor, ro * C(at[1], top + 0.2, at[2]) * A(0, rng:NextNumber(0, 90), 0), V(0.9, 0.4, 0.45), Kit.jitter(P.Brick, 0.06, rng), Mat.Brick, DECOR)
	end
	return function(x: number, z: number): Vector3
		return (ro * C((x + 8.5) / cosP, top + 0.2, z)).Position
	end
end

-- Пол из досок (несколько выпало), пятна крови
local function buildFloor(map, cf: CFrame, rng: Random)
	local base = Kit.jitter(P.OldWood, 0.04, rng)
	for i = 0, 14 do
		if rng:NextNumber() > 0.08 then
			local x = -7.0 + i
			Kit.box(map.Decor, cf * C(x, 0.1, rng:NextNumber(-0.05, 0.05)), V(0.94, 0.2, 14.9), Kit.jitter(Kit.dark(base, 0.15), 0.07, rng), Mat.WoodPlanks, DECOR)
		end
	end
	for _ = 1, 2 do
		Kit.box(map.Decor, cf * C(rng:NextNumber(-3, 3), 0.21, rng:NextNumber(-3, 3)) * A(0, rng:NextNumber(0, 180), 0), V(rng:NextNumber(1, 2.2), 0.02, rng:NextNumber(0.6, 1.2)), P.DryBlood, Mat.SmoothPlastic, DECOR)
	end
end

-- Внутренняя обстановка у стен (декор): верстак, ящики, цепь с крюком, лампочка на шнуре
local function buildInterior(map, cf: CFrame, rng: Random, roofY: (number) -> number)
	local wood = Kit.jitter(P.Wood, 0.05, rng)
	-- верстак в переднем правом углу
	local bench = cf * C(5.8, 0, -6.75)
	Kit.box(map.Decor, bench * C(0, 3.0, 0), V(3.2, 0.18, 1.2), wood, Mat.Wood, DECOR)
	Kit.box(map.Decor, bench * C(0, 0.9, 0), V(2.9, 0.1, 1.0), Kit.dark(wood, 0.15), Mat.Wood, DECOR)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.box(map.Decor, bench * C(sx * 1.45, 1.46, sz * 0.45), V(0.2, 2.9, 0.2), Kit.dark(wood, 0.2), Mat.Wood, DECOR)
		end
	end
	Kit.box(map.Decor, bench * C(-0.6, 3.37, 0.1) * A(0, 8, 0), V(1.1, 0.55, 0.55), Kit.jitter(Color3.fromRGB(110, 40, 30), 0.05, rng), Mat.Metal, DECOR)
	Kit.cyl(map.Decor, bench * C(0.8, 3.12, 0.15) * A(0, 0, 90), 0.05, 1.0, P.Steel, Mat.Metal, DECOR)
	-- ящики в переднем левом углу
	local crate = Kit.jitter(P.Plank, 0.06, rng)
	Kit.box(map.Decor, cf * C(-6.4, 0.95, -6.4) * A(0, rng:NextNumber(-8, 8), 0), V(1.7, 1.5, 1.7), crate, Mat.WoodPlanks, DECOR)
	Kit.box(map.Decor, cf * C(-6.3, 2.3, -6.5) * A(0, rng:NextNumber(10, 25), 0), V(1.3, 1.2, 1.3), Kit.dark(crate, 0.15), Mat.WoodPlanks, DECOR)
	-- цепь с мясным крюком над полом (выше головы)
	local hx, hz = -3.6, -4
	local hook = cf * C(hx, 7.1, hz)
	Kit.chain(map.Decor, { (cf * C(hx, roofY(hx), hz)).Position, hook.Position }, 0.36, P.Iron)
	Kit.box(map.Decor, hook * C(0, -0.35, 0), V(0.08, 0.6, 0.08), P.DarkSteel, Mat.Metal, DECOR)
	Kit.wedge(map.Decor, hook * C(0, -0.72, -0.12) * A(180, 0, 0), V(0.07, 0.25, 0.3), P.DarkSteel, Mat.Metal, DECOR)
	-- лампочка на шнуре в центре
	local bulbY = 8
	Kit.rod(map.Decor, (cf * C(0, roofY(0), 0)).Position, (cf * C(0, bulbY + 0.3, 0)).Position, 0.06, P.Black, Mat.Rubber, DECOR)
	Kit.vcyl(map.Decor, cf * C(0, bulbY + 0.22, 0), 0.25, 0.22, P.DarkSteel, Mat.Metal, DECOR)
	local bulb = Kit.ball(map.Decor, cf * C(0, bulbY, 0), 0.45, Color3.fromRGB(255, 196, 120), Mat.Neon, DECOR)
	bulb.Name = "Bulb"
	Kit.pointLight(bulb, Color3.fromRGB(255, 160, 90), 16, 1.1)
	-- снаружи: доски у задней стены и поленница у левой
	for k = 0, 1 do
		local x = -6.3 + k * 0.9
		Kit.bar(map.Decor, (cf * C(x + 0.3, 0.05, 9.9 - k * 0.2)).Position, (cf * C(x, 4.2, 8.75)).Position, 0.8, Kit.jitter(P.OldWood, 0.06, rng), Mat.WoodPlanks, DECOR, 0.12)
	end
	for k = 0, 2 do
		local y = k == 2 and 1.0 or 0.36
		local z = 3.5 + (k == 2 and 0 or (k - 0.5) * 0.74)
		Kit.cyl(map.Decor, cf * C(-9.0, y, z) * A(0, 90, 0), 1.9, 0.72, Kit.jitter(Color3.fromRGB(78, 62, 48), 0.06, rng), Mat.Wood, DECOR)
	end
end

local function shack(map, cf: CFrame, rng: Random)
	buildWalls(map, cf, rng)
	local roofAt = buildRoof(map, cf, rng)
	local function roofY(x: number): number
		-- низ стропил над точкой x
		return PLATE + (x + 8.5) * SLOPE
	end
	buildFloor(map, cf, rng)
	buildInterior(map, cf, rng, roofY)
	Common.pallet(map, rng, cf * CFrame.new(-1.8, 3, -7) * A(0, 0, 78), cf * CFrame.new(0, 1.5, -8))
	Common.locker(map, rng, cf * CFrame.new(-5.5, 0, 6.2))
	table.insert(map.ChestSpots, cf * CFrame.new(5.2, 0, 5.4))
	table.insert(map.TotemSpots, cf * CFrame.new(-11, 0, -9))
	table.insert(map.CrowSpots, CFrame.new(roofAt(6, -6)) * cf.Rotation)
end

return shack
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="65">
              <Properties>
                <string name="Name">BuildingWalls</string>
                <string name="Source"><![CDATA[-- Общие помощники стен для зданий и оформления ячеек.
-- Стена (тип Wall): CF — центр основания (y = 0), длина вдоль локальной X, толщина вдоль локальной Z.
-- Сталкивается только корпус W.core (те же коробки, что и раньше: сегменты вокруг проёмов + подоконники
-- Common.windowSill высотой ровно 3); доски, рамы, обломки и прочее — декор без столкновений.
local Kit = require(script.Parent.Parent.Kit)
local Common = require(script.Parent.Common)

local P = Kit.Palette
local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new

local W = {}

W.DECOR = { Decor = true }
-- Крупные видимые детали без столкновений, но с тенью (крыши навесов, трубы)
W.SOLID = { CanCollide = false, CanQuery = false, CanTouch = false }
local DECOR = W.DECOR

export type Opening = { Center: number, Width: number, Sill: number, Top: number }
export type Wall = { CF: CFrame, Length: number, Height: number, Thick: number, Openings: { Opening } }
-- Прямоугольник на стене: x0, x1, y0, y1 (локальные координаты стены)
export type Rect = { number }

function W.wall(cf: CFrame, length: number, height: number, thick: number, openings: { Opening }?): Wall
	local list = table.clone(openings or {})
	table.sort(list, function(a, b)
		return a.Center < b.Center
	end)
	return { CF = cf, Length = length, Height = height, Thick = thick, Openings = list }
end

-- Сплошной корпус стены (map.Walls) с проёмами; Sill > 0 — окно с подоконником Common.windowSill.
function W.core(map, w: Wall, color: Color3, material: Enum.Material): { BasePart }
	local parts = {}
	local function seg(x0: number, x1: number, y0: number, y1: number)
		if x1 - x0 > 0.05 and y1 - y0 > 0.05 then
			local p = Kit.box(map.Walls, w.CF * C((x0 + x1) / 2, (y0 + y1) / 2, 0), V(x1 - x0, y1 - y0, w.Thick), color, material)
			p.Name = "Wall"
			table.insert(parts, p)
		end
	end
	local x = -w.Length / 2
	for _, o in w.Openings do
		local x0, x1 = o.Center - o.Width / 2, o.Center + o.Width / 2
		seg(x, x0, 0, w.Height)
		seg(x0, x1, o.Top, w.Height)
		if o.Sill > 0 then
			Common.windowSill(map, w.CF * C(o.Center, 0, 0), o.Width, w.Thick, color, material)
		end
		x = x1
	end
	seg(x, w.Length / 2, 0, w.Height)
	return parts
end

-- Куски горизонтальной полосы [y0, y1] вдоль стены без проёмов (под окном и над проёмом — отдельные куски)
function W.band(w: Wall, y0: number, y1: number): { Rect }
	local out: { Rect } = {}
	local function add(x0: number, x1: number, a: number, b: number)
		if x1 - x0 > 0.2 and b - a > 0.05 then
			table.insert(out, { x0, x1, a, b })
		end
	end
	local x = -w.Length / 2
	for _, o in w.Openings do
		local x0, x1 = o.Center - o.Width / 2, o.Center + o.Width / 2
		if y1 > o.Sill and y0 < o.Top then
			add(x, x0, y0, y1)
			if y0 < o.Sill then
				add(x0, x1, y0, math.min(y1, o.Sill))
			end
			if y1 > o.Top then
				add(x0, x1, math.max(y0, o.Top), y1)
			end
			x = x1
		end
	end
	add(x, w.Length / 2, y0, y1)
	return out
end

-- Сплошные (на всю высоту полосы) куски — туда можно ставить стойки, швы, заплатки
function W.solid(w: Wall, y0: number, y1: number): { Rect }
	local out = {}
	for _, r in W.band(w, y0, y1) do
		if r[3] <= y0 and r[4] >= y1 then
			table.insert(out, r)
		end
	end
	return out
end

-- Случайная точка на сплошной части стены (с отступом от краёв куска) или nil
function W.spot(w: Wall, rng: Random, y0: number, y1: number, margin: number): (number?, number)
	local list = {}
	for _, r in W.solid(w, y0, y1) do
		if r[2] - r[1] > margin * 2 then
			table.insert(list, r)
		end
	end
	local y = rng:NextNumber(y0, y1)
	if #list == 0 then
		return nil, y
	end
	local r = list[rng:NextInteger(1, #list)]
	return rng:NextNumber(r[1] + margin, r[2] - margin), y
end

export type BoardOpts = {
	Rng: Random,
	Color: Color3,
	Row: number?, -- ширина доски (шаг рядов)
	Gap: number?, -- щель между досками
	Y0: number?,
	Y1: number?,
	Missing: number?, -- вероятность выпавшей доски
	Broken: number?, -- вероятность сорванной доски (висит на одном гвозде)
	MaxLen: number?, -- длинные ряды режутся на доски не длиннее этого
}

-- Обшивка горизонтальными досками грани side (±1 по локальной Z): щели, выпавшие и сорванные доски.
function W.boards(parent: Instance, w: Wall, side: number, o: BoardOpts)
	local rng = o.Rng
	local row, gap, depth = o.Row or 0.9, o.Gap or 0.1, 0.14
	local y0, y1 = o.Y0 or 0, o.Y1 or w.Height
	local mat = Mat.WoodPlanks
	local n = math.max(1, math.floor((y1 - y0) / row + 0.5))
	local step = (y1 - y0) / n
	local z = side * (w.Thick / 2 + depth / 2)
	local function plank(x0: number, x1: number, ya: number, yb: number)
		local len, cy = x1 - x0, (ya + yb) / 2
		local color = Kit.jitter(o.Color, 0.09, rng)
		local size = V(len, yb - ya, depth)
		if len > 2.2 and rng:NextNumber() < (o.Broken or 0) then
			-- одна половина прибита, вторая повисла на гвозде (чуть отстаёт от стены, чтобы не слипаться с соседней)
			local cut = x0 + len * rng:NextNumber(0.35, 0.6)
			Kit.box(parent, w.CF * C((x0 + cut) / 2, cy, z), V(cut - x0, size.Y, depth), color, mat, DECOR)
			local rest = x1 - cut
			local drop = math.deg(math.asin(math.clamp((cy - 0.15) / rest, 0, 1)))
			local ang = math.min(rng:NextNumber(12, 30), drop)
			local flip = rng:NextNumber() < 0.5
			local pivot = flip and C(cut, cy, z + side * depth * 0.9) or C(x1, cy, z + side * depth * 0.9)
			local dir = flip and 1 or -1
			Kit.box(parent, w.CF * pivot * A(0, 0, -dir * ang) * C(dir * rest / 2, 0, 0), V(rest, size.Y, depth), Kit.dark(color, 0.08), mat, DECOR)
		else
			Kit.box(parent, w.CF * C((x0 + x1) / 2, cy, z + rng:NextNumber(-0.02, 0.02)), size, color, mat, DECOR)
		end
	end
	for i = 0, n - 1 do
		local ya = y0 + step * i + gap / 2
		local yb = ya + step - gap
		for _, r in W.band(w, ya, yb) do
			if rng:NextNumber() >= (o.Missing or 0) then
				local len = r[2] - r[1]
				local pieces = o.MaxLen and math.max(1, math.ceil(len / o.MaxLen)) or 1
				local x = r[1]
				for k = 1, pieces do
					local x1 = k == pieces and r[2] or r[1] + len * (k / pieces) + rng:NextNumber(-0.6, 0.6)
					plank(x + (k > 1 and 0.04 or 0), x1, r[3], r[4])
					x = x1
				end
			end
		end
	end
end

-- Рама проёма: косяки и перемычка насквозь (выступают из обеих граней на proud), у окна — отлив.
-- Края рамы на 0.05 заходят в проём, чтобы не совпадать с торцами корпуса.
function W.frame(parent: Instance, w: Wall, o: Opening, color: Color3, material: Enum.Material?, proud: number?)
	local m = material or Mat.Wood
	local pr = proud or 0.25
	local jw = 0.35
	local x0, x1 = o.Center - o.Width / 2, o.Center + o.Width / 2
	local depth = w.Thick + pr * 2
	local jh = o.Top - o.Sill
	for _, s in { -1, 1 } do
		local xe = s < 0 and x0 or x1
		Kit.box(parent, w.CF * C(xe + s * (jw / 2 - 0.05), o.Sill + jh / 2, 0), V(jw, jh, depth), color, m, DECOR)
	end
	Kit.box(parent, w.CF * C(o.Center, o.Top + jw / 2 - 0.05, 0), V(o.Width + jw * 2 + 0.1, jw, depth + 0.06), Kit.dark(color, 0.12), m, DECOR)
	if o.Sill > 0 then
		Kit.box(parent, w.CF * C(o.Center, o.Sill + 0.07, 0), V(o.Width + jw * 2 + 0.3, 0.16, depth + 0.3), Kit.dark(color, 0.05), m, DECOR)
	end
end

-- Осколки стекла, торчащие из углов оконной рамы (в плоскости окна)
local GLASS = Color3.fromRGB(150, 168, 172)
function W.shards(parent: Instance, w: Wall, o: Opening, rng: Random, count: number)
	local x0, x1 = o.Center - o.Width / 2 + 0.05, o.Center + o.Width / 2 - 0.05
	for _ = 1, count do
		local left, top = rng:NextNumber() < 0.5, rng:NextNumber() < 0.6
		local h, d = rng:NextNumber(0.45, 1.1), rng:NextNumber(0.3, 0.7)
		local x = left and x0 + d / 2 or x1 - d / 2
		local y = top and o.Top - 0.05 - h / 2 or o.Sill + 0.15 + h / 2
		-- клин: прямой угол — в углу рамы
		local rot = A(0, left and -90 or 90, 0)
		if top then
			rot = A(0, left and 90 or -90, 0) * A(180, 0, 0)
		end
		Kit.wedge(parent, w.CF * C(x, y, rng:NextNumber(-0.1, 0.1)) * rot, V(0.05, h, d), GLASS, Mat.Glass, { Decor = true, Transparency = 0.35 })
	end
end

-- Рваный верх над корпусом: ступенчатый профиль (высота шагает на ±1 ступень, до 3 ступеней по maxStep/3),
-- соседние одинаковые ступени слиты в одну деталь. width — средняя ширина ступени,
-- clear — участок по X, который оставить ровным.
function W.jagged(parent: Instance, rng: Random, w: Wall, color: Color3, material: Enum.Material, maxStep: number, width: number, clear: { number }?)
	local unit = maxStep / 3
	local half = w.Length / 2
	local level = rng:NextInteger(0, 3)
	local x, runStart, runLevel = -half, -half, -1
	local function flush(x1: number)
		if runLevel > 0 and x1 - runStart > 0.05 then
			local h = runLevel * unit
			Kit.box(parent, w.CF * C((runStart + x1) / 2, w.Height + h / 2, 0), V(x1 - runStart, h, w.Thick), Kit.jitter(color, 0.03, rng), material, DECOR)
		end
	end
	while x < half - 1e-3 do
		local wd = math.min(rng:NextNumber(0.6, 1.4) * width, half - x)
		level = math.clamp(level + (rng:NextNumber() < 0.5 and -1 or 1), 0, 3)
		local lv = (clear and x < clear[2] and x + wd > clear[1]) and 0 or level
		if lv ~= runLevel then
			flush(x)
			runStart, runLevel = x, lv
		end
		x += wd
	end
	flush(half)
end

-- Неровное пятно штукатурки (или другого покрытия) на грани side: два перекрывающихся куска
function W.patch(parent: Instance, rng: Random, w: Wall, side: number, x: number, y: number, size: Vector2, color: Color3, material: Enum.Material)
	local z = side * w.Thick / 2
	Kit.box(parent, w.CF * C(x, y, z + side * 0.02), V(size.X, size.Y, 0.04), Kit.jitter(color, 0.04, rng), material, DECOR)
	local function off(): number
		return (rng:NextNumber() < 0.5 and -1 or 1) * rng:NextNumber(0.3, 0.45)
	end
	Kit.box(parent, w.CF * C(x + off() * size.X, y + off() * size.Y, z + side * 0.025), V(size.X * 0.6, size.Y * 0.7, 0.05), Kit.jitter(color, 0.06, rng), material, DECOR)
end

-- Обломки у основания: n кирпичей/кусков и куча щебня с одной стороны
function W.debris(parent: Instance, rng: Random, w: Wall, color: Color3, material: Enum.Material, n: number, size: Vector3)
	for _ = 1, n do
		local s = rng:NextNumber() < 0.5 and -1 or 1
		local x = rng:NextNumber(-w.Length / 2 + 0.4, w.Length / 2 - 0.4)
		local z = s * (w.Thick / 2 + rng:NextNumber(0.3, 1.3))
		local tilt = rng:NextNumber() < 0.3 and rng:NextNumber(15, 35) or 0
		Kit.box(parent, w.CF * C(x, size.Y / 2 + tilt / 120, z) * A(tilt, rng:NextNumber(0, 180), 0), size, Kit.jitter(color, 0.08, rng), material, DECOR)
	end
	local s = rng:NextNumber() < 0.5 and -1 or 1
	local x = rng:NextNumber(-w.Length / 2 + 1, w.Length / 2 - 1)
	-- клин высокой стороной к стене
	Kit.wedge(parent, w.CF * C(x, 0.3, s * (w.Thick / 2 + 0.55)) * A(0, s > 0 and 180 or 0, 0), V(rng:NextNumber(1.4, 2.2), 0.6, 1.1), Kit.jitter(P.DarkConcrete, 0.06, rng), Mat.Slate, DECOR)
end

return W
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="66">
              <Properties>
                <string name="Name">Buildings</string>
                <string name="Source"><![CDATA[-- Здания: хижина маньяка (центр карты), дом из двух комнат, внешняя стена карты.
-- Функции получают map (папки и списки точек из MapBuilder), cf (центр ячейки 22x22, -Z = «перед») и rng.
-- Построение — в BuildingShack / BuildingHouse / BuildingPerimeter, общие помощники стен — BuildingWalls.
local Buildings = {}

Buildings.shack = require(script.Parent.BuildingShack)
Buildings.house = require(script.Parent.BuildingHouse)
Buildings.outerWalls = require(script.Parent.BuildingPerimeter)

return Buildings
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="67">
              <Properties>
                <string name="Name">Common</string>
                <string name="Source"><![CDATA[-- Общие игровые помощники для построек (НЕ художественные — их не меняем):
-- паллета и шкафчик из шаблонов, подоконник окна с правильной высотой.
local Templates = require(script.Parent.Parent.Templates)

local Common = {}

-- Паллета: upCF — положение хитбокса в поднятом состоянии, dropCF — опущенная паллета поперёк проёма
-- (хитбокс 5.6x3x1.2, длинная сторона по локальной X, проход — вдоль локальной Z).
function Common.pallet(map, rng: Random, upCF: CFrame, dropCF: CFrame): Model
	local pallet = Templates.spawn("Pallet", upCF, map.Pallets, rng)
	pallet:SetAttribute("DropCFrame", dropCF)
	return pallet
end

-- Шкафчик: cf — пол, дверь смотрит в -Z (перед дверью нужно ~3 стада свободного места)
function Common.locker(map, rng: Random, cf: CFrame): Model
	return Templates.spawn("Locker", cf, map.Lockers, rng)
end

-- Подоконник окна, через который перелезают вдоль локальной Z.
-- cf — центр проёма на уровне земли (y = 0), width — ширина проёма, thick — толщина стены.
-- Возвращает деталь подоконника (Kind = "Window", высота ровно 3).
function Common.windowSill(map, cf: CFrame, width: number, thick: number, color: Color3?, material: Enum.Material?): BasePart
	local sill = Instance.new("Part")
	sill.Name = "Window"
	sill.Anchored = true
	sill.TopSurface = Enum.SurfaceType.Smooth
	sill.BottomSurface = Enum.SurfaceType.Smooth
	sill.Size = Vector3.new(width, 3, thick)
	sill.CFrame = cf * CFrame.new(0, 1.5, 0)
	sill.Color = color or Color3.fromRGB(75, 60, 45)
	sill.Material = material or Enum.Material.Wood
	sill:SetAttribute("Kind", "Window")
	sill.Parent = map.Windows
	return sill
end

return Common
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="68">
              <Properties>
                <string name="Name">Dressing</string>
                <string name="Source"><![CDATA[-- Оформление ячеек: петли с паллетой/окном, укрытие у генератора, шкафчики (DressingLoops) и
-- свалка, бочки, сено, надгробия, забор, фонарь (DressingProps).
-- Функции получают map, cf (центр ячейки 22x22, -Z = «перед») и rng.
local Loops = require(script.Parent.DressingLoops)
local Props = require(script.Parent.DressingProps)

local Dressing = {}
for _, mod in { Loops, Props } do
	for k, v in mod do
		Dressing[k] = v
	end
end

return Dressing
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="69">
              <Properties>
                <string name="Name">DressingLoops</string>
                <string name="Source"><![CDATA[-- Стенки «петель» (паллета, окно) и укрытия (у генератора, ниша со шкафчиками) в разных стилях:
-- дощатая стенка на столбах, кирпичная руина с рваным верхом, бетонные плиты с арматурой,
-- профнастил на столбах. Сталкивается только корпус стены (те же коробки, что и раньше), остальное — декор.
local Kit = require(script.Parent.Parent.Kit)
local Common = require(script.Parent.Common)
local W = require(script.Parent.BuildingWalls)

local P = Kit.Palette
local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new
local DECOR = W.DECOR

-- Clear — участок верха (по X стены), который оставить ровным (там сидит ворон);
-- Back = false — обратная грань закрыта (шкафчиками): на ней ничего не строим
type StyleOpts = { Clear: { number }?, Back: boolean? }
type Style = (map: any, rng: Random, w: W.Wall, front: number, opts: StyleOpts) -> ()

local SHEET_TONES = { Kit.dark(P.Rust, 0.15), P.DarkRust, Kit.dark(P.Steel, 0.45), Color3.fromRGB(62, 72, 74), Color3.fromRGB(92, 82, 60) }

-- Столбы на концах стены (не выходят за её торцы); при Back = false обратная грань остаётся ровной
local function posts(parent: Instance, rng: Random, w: W.Wall, front: number, color: Color3, back: boolean)
	local zMin = back and -(w.Thick / 2 + 0.25) or -(w.Thick / 2 - 0.02)
	local zMax = w.Thick / 2 + 0.25
	if front < 0 then
		zMin, zMax = -zMax, -zMin
	end
	for _, s in { -1, 1 } do
		local h = w.Height + 0.4 + rng:NextNumber(0, 0.4)
		Kit.box(parent, w.CF * C(s * (w.Length / 2 - 0.28), h / 2 - 0.1, (zMin + zMax) / 2) * A(0, 0, rng:NextNumber(-1, 1)), V(0.6, h, zMax - zMin), Kit.jitter(color, 0.06, rng), Mat.Wood, DECOR)
	end
end

-- Каркас на обратной грани: два ригеля (в обход проёмов)
local function rails(parent: Instance, rng: Random, w: W.Wall, side: number, color: Color3)
	local z = side * (w.Thick / 2 + 0.15)
	for _, y in { 1.3, w.Height - 1.3 } do
		for _, r in W.band(w, y - 0.2, y + 0.2) do
			Kit.box(parent, w.CF * C((r[1] + r[2]) / 2, y, z), V(r[2] - r[1] - 0.1, 0.4, 0.3), Kit.jitter(color, 0.05, rng), Mat.Wood, DECOR)
		end
	end
end

-- Дощатая стенка: доски с щелями на лицевой грани, ригели и раскос сзади, столбы
local function planks(map, rng: Random, w: W.Wall, front: number, opts: StyleOpts)
	local timber = Kit.jitter(P.DarkWood, 0.05, rng)
	W.core(map, w, Kit.jitter(Color3.fromRGB(48, 38, 30), 0.03, rng), Mat.WoodPlanks)
	W.boards(map.Decor, w, front, { Rng = rng, Color = Kit.jitter(P.OldWood, 0.05, rng), Row = 1.3, Gap = 0.14, Missing = 0.06, Broken = 0.15 })
	local back = opts.Back ~= false
	if back then
		rails(map.Decor, rng, w, -front, timber)
		if #w.Openings == 0 and w.Length >= 4 then
			local z = -front * (w.Thick / 2 + 0.12)
			local a = w.CF * C(-w.Length / 2 + 0.7, 1.4, z)
			local b = w.CF * C(w.Length / 2 - 0.7, w.Height - 1.4, z)
			Kit.bar(map.Decor, a.Position, b.Position, 0.24, Kit.dark(timber, 0.1), Mat.Wood, DECOR, 0.35)
		end
	end
	posts(map.Decor, rng, w, front, timber, back)
end

-- Кирпичная руина: рваный верх, остатки штукатурки, упавшие кирпичи и щебень
local function brick(map, rng: Random, w: W.Wall, _front: number, opts: StyleOpts)
	local color = Kit.jitter(P.Brick, 0.05, rng)
	W.core(map, w, color, Mat.Brick)
	W.jagged(map.Decor, rng, w, color, Mat.Brick, 1.5, 0.8, opts.Clear)
	if w.Length >= 5 then
		-- остатки старой штукатурки
		local x, y = W.spot(w, rng, 1.6, w.Height - 2, 1.4)
		if x then
			local side = rng:NextNumber() < 0.5 and -1 or 1
			W.patch(map.Decor, rng, w, side, x, y, Vector2.new(rng:NextNumber(1.4, 2.4), rng:NextNumber(1.2, 2.0)), Kit.dark(P.Plaster, 0.35), Mat.Plaster)
		end
	end
	W.debris(map.Decor, rng, w, color, Mat.Brick, math.clamp(math.floor(w.Length / 2.5), 1, 4), V(0.9, 0.38, 0.44))
end

-- Бетонные плиты: швы, отверстия от стяжек опалубки, обломанный верх с ржавой арматурой и потёками
local function concrete(map, rng: Random, w: W.Wall, _front: number, opts: StyleOpts)
	local color = Kit.jitter(P.Concrete, 0.04, rng)
	W.core(map, w, color, Mat.Concrete)
	for _, r in W.solid(w, 0, w.Height) do
		if r[2] - r[1] >= 6 then
			local x = (r[1] + r[2]) / 2 + rng:NextNumber(-1, 1)
			Kit.box(map.Decor, w.CF * C(x, w.Height / 2, 0), V(0.08, w.Height - 0.02, w.Thick + 0.02), Kit.dark(color, 0.35), Mat.Concrete, DECOR)
		end
	end
	local ty = w.Height * 0.62
	for _, r in W.solid(w, ty - 0.2, ty + 0.2) do
		local n = math.floor((r[2] - r[1]) / 3.2)
		for i = 1, n do
			local x = r[1] + (r[2] - r[1]) * i / (n + 1)
			Kit.cyl(map.Decor, w.CF * C(x, ty, 0) * A(0, 90, 0), w.Thick + 0.03, 0.22, Kit.dark(color, 0.55), Mat.Concrete, DECOR)
		end
	end
	W.jagged(map.Decor, rng, w, color, Mat.Concrete, 0.9, 1.6, opts.Clear)
	local clear = opts.Clear
	for i = 1, 2 do
		local x = rng:NextNumber(-w.Length / 2 + 0.5, w.Length / 2 - 0.5)
		if not (clear and x > clear[1] - 0.3 and x < clear[2] + 0.3) then
			local z = rng:NextNumber(-0.3, 0.3)
			local mid = w.CF * C(x + rng:NextNumber(-0.2, 0.2), w.Height + rng:NextNumber(0.7, 1.4), z)
			local tip = mid * C(rng:NextNumber(-0.6, 0.6), rng:NextNumber(0.1, 0.4), rng:NextNumber(-0.5, 0.5))
			Kit.rod(map.Decor, (w.CF * C(x, w.Height - 0.2, z)).Position, mid.Position, 0.12, P.DarkRust, Mat.CorrodedMetal, DECOR)
			Kit.rod(map.Decor, mid.Position, tip.Position, 0.12, P.DarkRust, Mat.CorrodedMetal, DECOR)
			if i == 1 then
				local s = rng:NextNumber() < 0.5 and -1 or 1
				Kit.box(map.Decor, w.CF * C(x, w.Height - 1, s * (w.Thick / 2 + 0.01)), V(0.2, 1.9, 0.02), Kit.jitter(P.Rust, 0.06, rng), Mat.CorrodedMetal, DECOR)
			end
		end
	end
	W.debris(map.Decor, rng, w, color, Mat.Concrete, 1, V(0.8, 0.45, 0.6))
end

-- Профнастил на столбах: листы с волнами на лицевой грани (в обход проёмов), ригели сзади
local function sheets(map, rng: Random, w: W.Wall, front: number, opts: StyleOpts)
	local timber = Kit.jitter(P.DarkWood, 0.05, rng)
	W.core(map, w, Kit.jitter(Color3.fromRGB(50, 44, 40), 0.03, rng), Mat.CorrodedMetal)
	local i = 0
	for _, r in W.band(w, 0.05, w.Height) do
		local len = r[2] - r[1]
		local n = math.max(1, math.floor(len / 3.3 + 0.5))
		local sw = len / n
		for k = 0, n - 1 do
			i += 1
			local a = math.max(r[1], r[1] + sw * k - 0.1)
			local b = math.min(r[2], r[1] + sw * (k + 1) + 0.1)
			local y1 = r[4] >= w.Height - 0.01 and r[4] + rng:NextNumber(0, 0.6) or r[4]
			local h = y1 - r[3]
			local color = Kit.jitter(SHEET_TONES[rng:NextInteger(1, #SHEET_TONES)], 0.05, rng)
			local sheet = w.CF * C((a + b) / 2, r[3] + h / 2, front * (w.Thick / 2 + 0.04 + (i % 2) * 0.07))
			Kit.box(map.Decor, sheet, V(b - a, h, 0.06), color, Mat.CorrodedMetal, DECOR)
			if b - a > 1.2 then
				for _, dx in { -0.25, 0.25 } do
					Kit.vcyl(map.Decor, sheet * C(dx * (b - a), 0, front * 0.04), h, 0.14, Kit.jitter(color, 0.03, rng), Mat.CorrodedMetal, DECOR)
				end
			end
		end
	end
	local back = opts.Back ~= false
	if back then
		rails(map.Decor, rng, w, -front, timber)
	end
	posts(map.Decor, rng, w, front, timber, back)
end

local STYLES: { Style } = { planks, brick, concrete, sheets }
local COVER: { Style } = { planks, brick, sheets }

local function pick(list: { Style }, rng: Random): Style
	return list[rng:NextInteger(1, #list)]
end

local Loops = {}

-- Петля с паллетой: две стенки по бокам проёма 5.6 и две поперечные «крылья»
function Loops.palletLoop(map, cf: CFrame, rng: Random)
	local style = pick(STYLES, rng)
	local f = rng:NextNumber() < 0.5 and -1 or 1
	style(map, rng, W.wall(cf * C(-5.6, 0, 0), 5.6, 8, 1.5), f, { Clear = { -0.8, 0.8 } })
	style(map, rng, W.wall(cf * C(5.6, 0, 0), 5.6, 8, 1.5), -f, {})
	style(map, rng, W.wall(cf * C(-8.6, 0, 4) * A(0, 90, 0), 8, 8, 1.5), 1, {})
	style(map, rng, W.wall(cf * C(8.6, 0, -4) * A(0, 90, 0), 8, 8, 1.5), -1, {})
	local upCF = cf * CFrame.new(-1.8, 3, 1) * A(0, 0, 78)
	Common.pallet(map, rng, upCF, cf * CFrame.new(0, 1.5, 0))
	table.insert(map.TrapSpots, cf * CFrame.new(0, 0, rng:NextNumber() < 0.5 and 3.5 or -3.5))
	table.insert(map.CrowSpots, cf * CFrame.new(-5.6, 8, 0))
end

-- Петля с окном: стена 18x10 с окном посередине и две боковые стенки
function Loops.windowLoop(map, cf: CFrame, rng: Random)
	local style = pick(STYLES, rng)
	local front = rng:NextNumber() < 0.5 and -1 or 1
	local main = W.wall(cf, 18, 10, 1.5, { { Center = 0, Width = 4, Sill = 3, Top = 7 } })
	style(map, rng, main, front, {})
	style(map, rng, W.wall(cf * C(-9.75, 0, -5) * A(0, 90, 0), 10, 10, 1.5), 1, {})
	style(map, rng, W.wall(cf * C(9.75, 0, 5) * A(0, 90, 0), 10, 10, 1.5), -1, {})
	-- рама с осколками, оторванная доска у окна и ещё одна под ним
	local o = main.Openings[1]
	local wood = Kit.jitter(P.DarkWood, 0.05, rng)
	W.frame(map.Decor, main, o, wood, Mat.Wood, 0.32)
	W.shards(map.Decor, main, o, rng, 3)
	local s = rng:NextNumber() < 0.5 and -1 or 1
	local side = rng:NextNumber() < 0.5 and -1 or 1
	local board = Kit.jitter(P.OldWood, 0.06, rng)
	Kit.box(map.Decor, main.CF * C(s * (o.Width / 2 + 0.85), 5.2, side * (main.Thick / 2 + 0.4)) * A(0, 0, s * rng:NextNumber(8, 20)), V(0.7, 3.6, 0.12), board, Mat.WoodPlanks, DECOR)
	Kit.box(map.Decor, main.CF * C(rng:NextNumber(-1.5, 1.5), 0.06, -side * rng:NextNumber(1.8, 2.6)) * A(0, rng:NextNumber(-40, 40), 0), V(0.7, 0.12, 3.4), Kit.dark(board, 0.1), Mat.WoodPlanks, DECOR)
	table.insert(map.TrapSpots, cf * CFrame.new(0, 0, -3))
end

-- Укрытие за генератором (генератор стоит в cf, стенка — сзади, лицом к нему)
function Loops.generatorCover(map, cf: CFrame, rng: Random)
	pick(COVER, rng)(map, rng, W.wall(cf * C(0, 0, 6.5), 10, 6, 1.5), -1, {})
end

-- Стенка с двумя шкафчиками (3.4 между центрами) под навесом
function Loops.lockerNook(map, cf: CFrame, rng: Random)
	local w = W.wall(cf * C(0, 0, 2), 8, 8, 1.2)
	local scrap = rng:NextNumber() < 0.5
	if scrap then
		sheets(map, rng, w, 1, { Back = false })
	else
		planks(map, rng, w, 1, { Back = false })
	end
	-- навес: брус на стене, кровля над шкафчиками, два подкоса по краям
	local timber = Kit.jitter(P.DarkWood, 0.05, rng)
	Kit.box(map.Decor, cf * C(0, 8.165, 2.0), V(8.4, 0.33, 0.5), timber, Mat.Wood, DECOR)
	local hi, lo = 8.42, 7.85
	if scrap then
		for _, x in { -2.1, 2.1 } do
			local color = Kit.jitter(SHEET_TONES[rng:NextInteger(1, #SHEET_TONES)], 0.05, rng)
			local sheet = Kit.bar(map.Decor, (cf * C(x, hi + (x > 0 and 0.04 or 0), 2.1)).Position, (cf * C(x, lo + (x > 0 and 0.04 or 0), -1.7)).Position, 4.4, color, Mat.CorrodedMetal, W.SOLID, 0.06)
			if sheet then
				for _, dx in { -1.4, 0, 1.4 } do
					Kit.cyl(map.Decor, sheet.CFrame * C(dx, 0.04, 0) * A(0, 90, 0), sheet.Size.Z, 0.14, Kit.jitter(color, 0.03, rng), Mat.CorrodedMetal, DECOR)
				end
			end
		end
	else
		for _, x in { -2.85, 0, 2.85 } do
			Kit.bar(map.Decor, (cf * C(x, hi, 2.1)).Position, (cf * C(x, lo + rng:NextNumber(-0.05, 0.05), -1.7)).Position, 2.75, Kit.jitter(P.OldWood, 0.07, rng), Mat.WoodPlanks, W.SOLID, 0.14)
		end
	end
	for _, x in { -3.9, 3.9 } do
		Kit.bar(map.Decor, (cf * C(x, 6.4, 1.4)).Position, (cf * C(x, 8.0, -0.9)).Position, 0.25, Kit.dark(timber, 0.1), Mat.Wood, DECOR, 0.3)
	end
	-- ведро у правого шкафчика
	local bucket = cf * C(3.75, 0, 0.6)
	Kit.vcyl(map.Decor, bucket * C(0, 0.45, 0), 0.9, 0.8, Kit.jitter(P.DarkSteel, 0.06, rng), Mat.Metal, DECOR)
	Kit.vcyl(map.Decor, bucket * C(0, 0.88, 0), 0.06, 0.84, P.Rust, Mat.CorrodedMetal, DECOR)
	Common.locker(map, rng, cf * CFrame.new(-2, 0, 0.3))
	Common.locker(map, rng, cf * CFrame.new(1.4, 0, 0.3))
end

return Loops
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="70">
              <Properties>
                <string name="Name">DressingProps</string>
                <string name="Source"><![CDATA[-- Оформление ячеек предметами: свалка (остов машины или пачка смятых кузовов, шины, бочка, лом),
-- горящая бочка с сеном, тюки сена, надгробия, забор, фонарь.
-- Сталкиваются те же крупные формы, что и раньше (кузов и кабина, шины, бочки, тюки, камни, невидимая
-- стенка забора, столб фонаря); всё мелкое — декор.
local Kit = require(script.Parent.Parent.Kit)
local Nature = require(script.Parent.Parent.Nature)

local P = Kit.Palette
local Mat = Kit.Mat
local A = Kit.A
local V = Vector3.new
local C = CFrame.new
local DECOR = { Decor = true }

local Props = {}

------------------------------------------------------------------------
-- Бочки и сено (общие для свалки и костра)
------------------------------------------------------------------------

local BARREL_PAINT = { Color3.fromRGB(110, 46, 34), Color3.fromRGB(58, 72, 84), Color3.fromRGB(78, 86, 62), Color3.fromRGB(120, 96, 52) }

-- Бочка 200 л (корпус d 2, h 3 сталкивается): обручи, бортик, ржавый низ; горящая — закопчённая,
-- с прогоревшими дырами, углями и огнём
local function barrel(map, cf: CFrame, rng: Random, burning: boolean)
	local paint = Kit.jitter(BARREL_PAINT[rng:NextInteger(1, #BARREL_PAINT)], 0.05, rng)
	if burning then
		paint = Kit.dark(paint, 0.6)
	end
	local body = Kit.vcyl(map.Walls, cf * C(0, 1.5, 0), 3, 2, paint, Mat.CorrodedMetal)
	body.Name = "Barrel"
	for _, y in { 1.0, 2.0 } do
		Kit.vcyl(map.Decor, cf * C(0, y, 0), 0.14, 2.08, Kit.dark(paint, 0.2), Mat.CorrodedMetal, DECOR)
	end
	Kit.vcyl(map.Decor, cf * C(0, 2.94, 0), 0.16, 2.06, Kit.dark(paint, 0.3), Mat.Metal, DECOR)
	if burning then
		Kit.vcyl(map.Decor, cf * C(0, 3.03, 0), 0.06, 1.75, Color3.fromRGB(220, 90, 30), Mat.Neon, DECOR)
		for k = 1, 3 do
			Kit.box(map.Decor, cf * A(0, k * 120 + rng:NextNumber(-25, 25), 0) * C(0, rng:NextNumber(0.4, 0.75), -0.99), V(0.22, 0.2, 0.05), Color3.fromRGB(255, 120, 40), Mat.Neon, DECOR)
		end
		Nature.fire(map.Decor, cf * C(0, 3.2, 0), 1)
	else
		Kit.vcyl(map.Decor, cf * C(0, 0.3, 0), 0.6, 2.03, Kit.jitter(P.DarkRust, 0.05, rng), Mat.CorrodedMetal, DECOR)
		Kit.vcyl(map.Decor, cf * C(0.5, 3.04, 0.25), 0.08, 0.3, Kit.dark(paint, 0.4), Mat.Metal, DECOR)
	end
end

-- Тюк сена 3x2x4.5 (сталкивается) с двумя бечёвками вдоль
local function bale(map, cf: CFrame, rng: Random, color: Color3)
	local body = Kit.box(map.Walls, cf, V(3, 2, 4.5), color, Mat.Grass)
	body.Name = "Hay"
	for _, x in { -0.75, 0.75 } do
		Kit.box(map.Decor, cf * C(x, 0, 0), V(0.08, 2.04, 4.54), Kit.jitter(Color3.fromRGB(140, 112, 68), 0.05, rng), Mat.Fabric, DECOR)
	end
end

function Props.hay(map, cf: CFrame, rng: Random)
	local base = Kit.jitter(Kit.dark(P.Hay, 0.14), 0.04, rng)
	local old = Color3.fromRGB(118, 110, 88)
	for i = 1, rng:NextInteger(2, 4) do
		local color = Kit.jitter(base:Lerp(old, rng:NextNumber(0.1, 0.55)), 0.04, rng)
		bale(map, cf * C((i - 2) * 3.2, 1, rng:NextNumber(-0.5, 0.5)) * A(0, rng:NextNumber(-10, 10), 0), rng, color)
	end
	if rng:NextNumber() > 0.5 then
		bale(map, cf * C(-1.6, 3, 0) * A(0, 8, 0), rng, Kit.jitter(Kit.dark(base, 0.08), 0.04, rng))
	end
end

function Props.barrelFire(map, cf: CFrame, rng: Random)
	barrel(map, cf * C(-3, 0, 0), rng, true)
	barrel(map, cf * C(-0.6, 0, 1), rng, false)
	Props.hay(map, cf * C(4, 0, 0), rng)
	-- дрова у огня и колода с топором
	local log = Kit.jitter(Color3.fromRGB(78, 62, 48), 0.05, rng)
	local pile = cf * C(-3.6, 0, -1.9) * A(0, 8, 0)
	for k = 0, 2 do
		local y = k == 2 and 0.82 or 0.3
		local z = k == 2 and 0 or (k - 0.5) * 0.62
		Kit.cyl(map.Decor, pile * C(0, y, z), 2.2, 0.6, Kit.jitter(log, 0.06, rng), Mat.Wood, DECOR)
	end
	local stump = cf * C(-3.3, 0, 2.4)
	Kit.vcyl(map.Decor, stump * C(0, 0.6, 0), 1.2, 1.4, Kit.jitter(log, 0.05, rng), Mat.Wood, DECOR)
	-- топор: лезвие в колоде, топорище наискось вверх
	local axe = stump * C(0, 1.25, 0) * A(0, rng:NextNumber(0, 180), -25)
	Kit.box(map.Decor, axe, V(0.5, 0.35, 0.08), P.DarkSteel, Mat.Metal, DECOR)
	Kit.box(map.Decor, axe * C(0.2, 0.9, 0), V(0.12, 1.8, 0.12), Kit.jitter(P.Wood, 0.05, rng), Mat.Wood, DECOR)
end

------------------------------------------------------------------------
-- Свалка
------------------------------------------------------------------------

local CAR_PAINT = { Color3.fromRGB(96, 40, 34), Color3.fromRGB(52, 66, 78), Color3.fromRGB(150, 140, 112), Color3.fromRGB(64, 78, 58), Color3.fromRGB(88, 84, 80) }
local GLASS = Color3.fromRGB(34, 42, 46)

-- Колесо: шина и ржавый диск (ось — локальная X); без колеса машина стоит на шлакоблоке
local function wheel(map, cf: CFrame, rng: Random)
	if rng:NextNumber() < 0.75 then
		Kit.cyl(map.Decor, cf, 0.6, 1.8, P.Rubber, Mat.Rubber, DECOR)
		Kit.cyl(map.Decor, cf, 0.64, 1.0, Kit.jitter(P.DarkRust, 0.06, rng), Mat.Metal, DECOR)
	else
		Kit.box(map.Decor, cf * C(0, -0.5, 0), V(0.8, 0.8, 1.5), Kit.jitter(P.Concrete, 0.05, rng), Mat.Concrete, DECOR)
	end
end

-- Остов седана (кузов и кабина сталкиваются, как раньше): капот (иногда открыт), стойки, стёкла,
-- бамперы (один висит), фары, решётка, швы дверей, ржавчина, колёса
local function wreck(map, car: CFrame, rng: Random)
	local paint = Kit.jitter(CAR_PAINT[rng:NextInteger(1, #CAR_PAINT)], 0.05, rng)
	local dark = Kit.dark(paint, 0.25)
	local rust = Kit.jitter(P.DarkRust, 0.06, rng)
	local body = Kit.box(map.Walls, car * C(0, 1.6, 0), V(4.4, 1.8, 9), paint, Mat.CorrodedMetal)
	body.Name = "CarBody"
	local cabin = Kit.box(map.Walls, car * C(0, 3.3, 0.6), V(4, 1.6, 4), GLASS, Mat.Glass)
	cabin.Name = "CarCabin"
	Kit.box(map.Decor, car * C(0, 4.18, 0.6), V(4.1, 0.16, 4.1), Kit.dark(paint, 0.08), Mat.CorrodedMetal, DECOR)
	for _, z in { -1.35, 0.6, 2.55 } do
		for _, sx in { -1, 1 } do
			Kit.box(map.Decor, car * C(sx * 1.98, 3.3, z), V(0.16, 1.62, 0.28), dark, Mat.CorrodedMetal, DECOR)
		end
	end
	Kit.wedge(map.Decor, car * C(0, 3.25, -1.9), V(3.9, 1.5, 1.0), GLASS, Mat.Glass, DECOR)
	Kit.wedge(map.Decor, car * C(0, 3.25, 3.1) * A(0, 180, 0), V(3.9, 1.5, 1.0), GLASS, Mat.Glass, DECOR)
	if rng:NextNumber() < 0.35 then
		-- открытый капот, под ним двигатель
		Kit.box(map.Decor, car * C(0, 2.62, -1.85) * A(38, 0, 0) * C(0, 0, -1.3), V(4.2, 0.12, 2.6), paint, Mat.CorrodedMetal, DECOR)
		Kit.box(map.Decor, car * C(0, 2.75, -3.0), V(2.2, 0.5, 1.6), P.Iron, Mat.Metal, DECOR)
	else
		Kit.box(map.Decor, car * C(0, 2.56, -3.15), V(4.2, 0.12, 2.6), paint, Mat.CorrodedMetal, DECOR)
		Kit.box(map.Decor, car * C(rng:NextNumber(-1, 1), 2.63, -3.2), V(rng:NextNumber(1, 2), 0.02, rng:NextNumber(0.8, 1.6)), rust, Mat.CorrodedMetal, DECOR)
	end
	Kit.box(map.Decor, car * C(0, 2.56, 4.05), V(4.2, 0.12, 0.9), paint, Mat.CorrodedMetal, DECOR)
	-- бамперы: задний висит на одном креплении
	Kit.box(map.Decor, car * C(0, 1.05, -4.62), V(4.5, 0.4, 0.3), P.Steel, Mat.Metal, DECOR)
	Kit.box(map.Decor, car * C(-2.2, 1.05, 4.62) * A(0, 0, -14) * C(2.2, 0, 0), V(4.4, 0.4, 0.3), Kit.dark(P.Steel, 0.3), Mat.Metal, DECOR)
	-- фары (одна разбита), решётка, задние фонари
	for _, sx in { -1, 1 } do
		local lamp = sx < 0 and Color3.fromRGB(150, 146, 120) or P.Black
		Kit.cyl(map.Decor, car * C(sx * 1.5, 1.95, -4.52) * A(0, 90, 0), 0.08, 0.55, lamp, Mat.Glass, DECOR)
		Kit.box(map.Decor, car * C(sx * 1.6, 2.0, 4.52), V(0.6, 0.35, 0.06), Color3.fromRGB(80, 20, 18), Mat.Glass, DECOR)
	end
	Kit.box(map.Decor, car * C(0, 1.95, -4.52), V(2.0, 0.5, 0.06), P.Iron, Mat.DiamondPlate, DECOR)
	-- швы дверей и ржавчина на боках
	for _, sx in { -1, 1 } do
		for _, z in { -1.4, 0.6 } do
			Kit.box(map.Decor, car * C(sx * 2.21, 1.75, z), V(0.04, 1.3, 0.05), Kit.dark(paint, 0.5), Mat.SmoothPlastic, DECOR)
		end
		Kit.box(map.Decor, car * C(sx * 2.205, 1.2, rng:NextNumber(-3, 3)) * A(rng:NextNumber(-8, 8), 0, 0), V(0.02, 0.7, rng:NextNumber(1, 2.2)), rust, Mat.CorrodedMetal, DECOR)
	end
	for _, wpos in { { -2.2, -3 }, { 2.2, -3 }, { -2.2, 3 }, { 2.2, 3 } } do
		wheel(map, car * C(wpos[1], 0.9, wpos[2]), rng)
	end
end

-- Пачка смятых кузовов (все слои сталкиваются): полоса окон, ржавчина, торчащий диск
local function crushed(map, cf: CFrame, rng: Random)
	local y = 0
	for i = 1, 3 do
		local h = rng:NextNumber(0.95, 1.25)
		local paint = Kit.jitter(CAR_PAINT[rng:NextInteger(1, #CAR_PAINT)], 0.06, rng)
		local layer = cf * C(rng:NextNumber(-0.3, 0.3), y + h / 2, rng:NextNumber(-0.4, 0.4)) * A(rng:NextNumber(-2, 2), rng:NextNumber(-8, 8), rng:NextNumber(-2, 2))
		local slab = Kit.box(map.Walls, layer, V(4.3, h, 8.4), paint, Mat.CorrodedMetal)
		slab.Name = "CrushedCar"
		Kit.box(map.Decor, layer * C(0, h * 0.22, 0.4), V(4.36, h * 0.28, 5), GLASS, Mat.Glass, DECOR)
		Kit.box(map.Decor, layer * C(0, h / 2 + 0.01, rng:NextNumber(-2.5, 2.5)), V(rng:NextNumber(1.5, 3), 0.02, rng:NextNumber(1.5, 3)), Kit.jitter(P.DarkRust, 0.06, rng), Mat.CorrodedMetal, DECOR)
		local sx = rng:NextNumber() < 0.5 and -1 or 1
		Kit.cyl(map.Decor, layer * C(sx * 2.1, -h * 0.1, rng:NextNumber(-3, 3)) * A(0, 0, sx * 12), 0.4, 1.1, Kit.jitter(P.DarkRust, 0.05, rng), Mat.Metal, DECOR)
		y += h - 0.04
	end
end

function Props.junk(map, cf: CFrame, rng: Random)
	if rng:NextNumber() < 0.65 then
		wreck(map, cf * A(0, rng:NextNumber(-25, 25), rng:NextNumber(-6, 6)), rng)
	else
		crushed(map, cf * A(0, rng:NextNumber(-25, 25), 0), rng)
	end
	-- стопка шин (сталкиваются) и одна прислонённая
	local tires = cf * C(rng:NextNumber(-7, -5), 0, rng:NextNumber(-6, 6))
	for i = 1, rng:NextInteger(2, 4) do
		local t = tires * C(rng:NextNumber(-0.2, 0.2), 0.45 + (i - 1) * 0.9, 0) * A(0, 0, 90)
		local tire = Kit.cyl(map.Walls, t, 0.9, 2.6, P.Rubber, Mat.Rubber)
		tire.Name = "Tire"
		Kit.cyl(map.Decor, t, 0.94, 1.3, P.Black, Mat.SmoothPlastic, DECOR)
	end
	local lean = tires * C(1.85, 1.25, 0.3) * A(0, 0, 14)
	Kit.cyl(map.Decor, lean, 0.9, 2.6, Kit.jitter(P.Rubber, 0.04, rng), Mat.Rubber, DECOR)
	Kit.cyl(map.Decor, lean, 0.94, 1.3, P.Black, Mat.SmoothPlastic, DECOR)
	barrel(map, cf * C(rng:NextNumber(5, 7), 0, rng:NextNumber(-5, 5)), rng, false)
	-- лом: согнутый лист профнастила, блок двигателя, колпак
	local sheet = cf * C(rng:NextNumber(-3, 3), 0, rng:NextNumber() < 0.5 and -7.6 or 7.6) * A(0, rng:NextNumber(0, 180), 0)
	local tone = Kit.jitter(P.Rust, 0.06, rng)
	Kit.box(map.Decor, sheet * C(0, 0.05, 0), V(2.6, 0.06, 1.8), tone, Mat.CorrodedMetal, DECOR)
	Kit.box(map.Decor, sheet * C(0, 0.05, 0.9) * A(-35, 0, 0) * C(0, 0, 0.7), V(2.6, 0.06, 1.4), Kit.dark(tone, 0.1), Mat.CorrodedMetal, DECOR)
	local engine = cf * C(rng:NextNumber(-2, 2), 0, rng:NextNumber() < 0.5 and -8.4 or 8.4) * A(0, rng:NextNumber(0, 180), 0)
	Kit.box(map.Decor, engine * C(0, 0.45, 0), V(1.6, 0.9, 1.1), P.Iron, Mat.Metal, DECOR)
	Kit.box(map.Decor, engine * C(0, 1.0, 0), V(1.2, 0.2, 0.6), P.DarkRust, Mat.CorrodedMetal, DECOR)
	Kit.cyl(map.Decor, cf * C(rng:NextNumber(-4, 4), 0.03, rng:NextNumber(-8, 8)) * A(0, 0, 90), 0.06, 1.0, P.Steel, Mat.Metal, DECOR)
end

------------------------------------------------------------------------
-- Надгробия
------------------------------------------------------------------------

local STONE = { Color3.fromRGB(104, 104, 108), Color3.fromRGB(88, 90, 86), Color3.fromRGB(122, 118, 108), Color3.fromRGB(78, 82, 80) }

-- Одна могила: камень (сталкивается, как раньше) одного из видов и холмик земли перед ним
local function grave(map, g: CFrame, h: number, rng: Random)
	local stone = Kit.jitter(STONE[rng:NextInteger(1, #STONE)], 0.04, rng)
	local tilt = A(rng:NextNumber(-10, 10), 0, rng:NextNumber(-8, 8))
	local base = g * C(0, -0.3, 0) * tilt
	local kind = rng:NextInteger(1, 4)
	local main: BasePart
	if kind == 1 then
		-- закруглённая плита с надписью
		main = Kit.box(map.Walls, base * C(0, (h - 1) / 2, 0), V(2, h - 1, 0.6), stone, Mat.Slate)
		Kit.cyl(map.Decor, base * C(0, h - 1, 0) * A(0, 90, 0), 0.6, 2, stone, Mat.Slate, DECOR)
		Kit.label(main, Enum.NormalId.Front, "R.I.P.", Kit.dark(stone, 0.5), Enum.Font.Fantasy)
	elseif kind == 2 then
		-- крест на постаменте
		main = Kit.box(map.Walls, base * C(0, (h + 1) / 2, 0), V(0.45, h + 1, 0.45), stone, Mat.Slate)
		Kit.box(map.Decor, base * C(0, h * 0.72 + 0.3, 0), V(1.9, 0.42, 0.42), stone, Mat.Slate, DECOR)
		Kit.box(map.Decor, base * C(0, 0.45, 0), V(1.2, 0.5, 1.0), Kit.dark(stone, 0.12), Mat.Slate, DECOR)
	elseif kind == 3 then
		-- разбитая плита: обломок верха лежит у основания
		local stub = h * 0.5
		main = Kit.box(map.Walls, base * C(0, stub / 2, 0), V(2, stub, 0.6), stone, Mat.Slate)
		Kit.wedge(map.Decor, base * C(-0.5, stub + 0.2, 0) * A(0, 90, 0), V(0.6, 0.4, 1), stone, Mat.Slate, DECOR)
		Kit.box(map.Decor, g * C(rng:NextNumber(-0.5, 0.5), 0.3, -1.2) * A(80, rng:NextNumber(-30, 30), 0), V(2, h * 0.45, 0.6), Kit.dark(stone, 0.06), Mat.Slate, DECOR)
	else
		-- узкая плита с двускатным верхом
		main = Kit.box(map.Walls, base * C(0, h / 2, 0), V(1.6, h, 0.8), stone, Mat.Slate)
		for _, s in { -1, 1 } do
			Kit.wedge(map.Decor, base * C(s * 0.4, h + 0.25, 0) * A(0, -s * 90, 0), V(0.8, 0.5, 0.8), stone, Mat.Slate, DECOR)
		end
	end
	main.Name = "Tombstone"
	-- холмик: округлый — лежащий вдоль могилы цилиндр, утопленный в землю (иногда осевший),
	-- и пологий скат земли в ногах
	local mound = g * C(rng:NextNumber(-0.15, 0.15), 0, -2.0) * A(0, rng:NextNumber(-4, 4), 0)
	local earth = Kit.jitter(Color3.fromRGB(58, 46, 36), 0.06, rng)
	local mh = rng:NextNumber(0.22, 0.4)
	local d = 1.9
	Kit.cyl(map.Decor, mound * C(0, mh - d / 2, 0) * A(0, 90, 0), 3.0, d, earth, Mat.Ground, DECOR)
	local foot = 2 * math.sqrt(math.max((d / 2) ^ 2 - (d / 2 - mh) ^ 2, 0.01))
	Kit.wedge(map.Decor, mound * C(0, mh / 2 - 0.02, -1.5 - 0.35), V(foot * 0.9, mh, 0.7), Kit.dark(earth, 0.05), Mat.Ground, DECOR)
	if kind == 1 and rng:NextNumber() < 0.5 then
		-- погасшая лампадка у камня
		Kit.vcyl(map.Decor, g * C(rng:NextNumber(-0.6, 0.6), 0.25, -0.55), 0.5, 0.26, Kit.jitter(Color3.fromRGB(150, 54, 40), 0.08, rng), Mat.Glass, DECOR)
	end
end

function Props.tombstones(map, cf: CFrame, rng: Random)
	local n = rng:NextInteger(4, 7)
	for i = 1, n do
		local x = ((i - 1) % 4 - 1.5) * 4
		local z = math.floor((i - 1) / 4) * 5 - 2.5
		grave(map, cf * C(x, 0, z) * A(0, rng:NextNumber(-10, 10), 0), rng:NextNumber(2, 3.5), rng)
	end
	-- лопата, воткнутая у крайней могилы
	local spade = cf * C(((n - 1) % 4 - 1.5) * 4 + 1.4, 0, math.floor((n - 1) / 4) * 5 - 4.2) * A(rng:NextNumber(-15, 15), rng:NextNumber(0, 180), 12)
	Kit.box(map.Decor, spade * C(0, 1.6, 0), V(0.12, 3.2, 0.12), Kit.jitter(P.Wood, 0.05, rng), Mat.Wood, DECOR)
	Kit.box(map.Decor, spade * C(0, 0.1, 0), V(0.7, 0.9, 0.05), P.DarkSteel, Mat.Metal, DECOR)
end

------------------------------------------------------------------------
-- Забор: невидимая стенка (сталкивается, как раньше) и видимый забор поверх
------------------------------------------------------------------------

local function woodFence(parent: Instance, f: CFrame, rng: Random, length: number)
	local wood = Kit.jitter(Color3.fromRGB(96, 86, 72), 0.05, rng)
	local spans = 4
	local step = length / spans
	for i = 0, spans do
		local h = rng:NextNumber(4.4, 4.9)
		Kit.box(parent, f * C(-length / 2 + i * step, h / 2 - 0.2, 0) * A(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3)), V(0.5, h, 0.5), Kit.jitter(Kit.dark(wood, 0.2), 0.05, rng), Mat.Wood, DECOR)
	end
	for i = 0, spans - 1 do
		local x0 = -length / 2 + i * step
		for _, y in { 1.2, 3.5 } do
			if rng:NextNumber() < 0.15 then
				-- сорванная жердь висит одним концом
				Kit.box(parent, f * C(x0 + 0.25, y, -0.31) * A(0, 0, -rng:NextNumber(10, 22)) * C(step / 2 - 0.25, 0, 0), V(step - 0.5, 0.32, 0.12), Kit.jitter(wood, 0.06, rng), Mat.Wood, DECOR)
			else
				Kit.box(parent, f * C(x0 + step / 2, y + rng:NextNumber(-0.08, 0.08), -0.31), V(step, 0.32, 0.12), Kit.jitter(wood, 0.06, rng), Mat.Wood, DECOR)
			end
		end
		-- штакетник поверх жердей: часть выпала, часть покосилась
		for k = 0, 4 do
			if rng:NextNumber() > 0.12 then
				local ph = rng:NextNumber(3.7, 4.1)
				Kit.box(parent, f * C(x0 + 0.4 + k * (step - 0.8) / 4, ph / 2, -0.43) * A(0, 0, rng:NextNumber() < 0.12 and rng:NextNumber(-7, 7) or 0), V(0.42, ph, 0.08), Kit.jitter(wood, 0.08, rng), Mat.WoodPlanks, DECOR)
			end
		end
	end
end

local function wireFence(parent: Instance, f: CFrame, rng: Random, length: number)
	local spans = 4
	local step = length / spans
	local wire = Kit.jitter(P.DarkSteel, 0.05, rng)
	local tops = {}
	for i = 0, spans do
		local tilt = i == 2 and rng:NextNumber() < 0.5 and 14 or rng:NextNumber(-4, 4)
		local post = f * C(-length / 2 + i * step, 0, 0) * A(rng:NextNumber(-3, 3), 0, tilt)
		Kit.vcyl(parent, post * C(0, 2.2, 0), 4.6, 0.42, Kit.jitter(Color3.fromRGB(70, 60, 50), 0.06, rng), Mat.Wood, DECOR)
		table.insert(tops, post)
	end
	for i = 1, spans do
		for _, y in { 1.3, 2.5, 3.7 } do
			local a = (tops[i] * C(0, y, -0.22)).Position
			local b = (tops[i + 1] * C(0, y, -0.22)).Position
			Kit.cable(parent, Kit.sag(a, b, rng:NextNumber(0.12, 0.45), 2), 0.05, wire, Mat.Metal, DECOR)
		end
	end
	-- тряпка, зацепившаяся за проволоку
	local rag = tops[rng:NextInteger(1, spans)] * C(step * 0.4, 2.3, -0.24)
	Kit.box(parent, rag * A(0, 0, rng:NextNumber(-15, 15)), V(0.5, 0.7, 0.03), Color3.fromRGB(90, 70, 58), Mat.Fabric, DECOR)
end

function Props.fence(map, cf: CFrame, rng: Random)
	local f = cf * C(0, 0, -4)
	local length = 16
	local block = Kit.box(map.Walls, f * C(0, 2.25, 0), V(length, 4.5, 0.4), P.Black, Mat.SmoothPlastic, { Transparency = 1 })
	block.Name = "FenceBlock"
	if rng:NextNumber() < 0.5 then
		woodFence(map.Decor, f, rng, length)
	else
		wireFence(map.Decor, f, rng, length)
	end
	table.insert(map.CrowSpots, cf * CFrame.new(rng:NextNumber(-6, 6), 4.5, -4))
end

------------------------------------------------------------------------
-- Фонарь: деревянный столб (сталкивается), траверса, изогнутый кронштейн, абажур с решёткой,
-- тусклая лампа (PointLight без теней), провисший провод
------------------------------------------------------------------------

function Props.lamp(map, cf: CFrame, rng: Random)
	local base = cf * A(rng:NextNumber(-2, 2), rng:NextNumber(0, 360), rng:NextNumber(-2, 2))
	local pole = Kit.vcyl(map.Decor, base * C(0, 6.1, 0), 12.6, 0.62, Kit.jitter(Color3.fromRGB(62, 52, 44), 0.05, rng), Mat.Wood)
	pole.Name = "LampPost"
	local iron = Kit.jitter(P.Iron, 0.05, rng)
	Kit.box(map.Decor, base * C(0, 11.7, 0), V(2.6, 0.26, 0.3), Kit.jitter(P.DarkWood, 0.05, rng), Mat.Wood, DECOR)
	local root, elbow = base * C(0, 10.6, -0.3), base * C(0, 11.25, -1.6)
	local headCF = base * C(0, 11.0, -2.25)
	Kit.rod(map.Decor, root.Position, elbow.Position, 0.14, iron, Mat.Metal, DECOR)
	Kit.rod(map.Decor, elbow.Position, (headCF * C(0, 0.3, 0)).Position, 0.14, iron, Mat.Metal, DECOR)
	local shade = Kit.jitter(rng:NextNumber() < 0.5 and Color3.fromRGB(56, 70, 62) or Color3.fromRGB(70, 64, 56), 0.05, rng)
	Kit.vcyl(map.Decor, headCF * C(0, 0.12, 0), 0.32, 0.7, shade, Mat.Metal, DECOR)
	Kit.vcyl(map.Decor, headCF * C(0, -0.08, 0), 0.1, 1.5, shade, Mat.Metal, DECOR)
	local bulb = Kit.ball(map.Decor, headCF * C(0, -0.3, 0), 0.42, Color3.fromRGB(255, 196, 120), Mat.Neon, DECOR)
	bulb.Name = "LampHead"
	Kit.pointLight(bulb, Color3.fromRGB(255, 170, 90), 22, 0.85)
	-- решётка: три прута от края абажура к нижней точке
	for k = 0, 2 do
		Kit.rod(map.Decor, (headCF * A(0, k * 120, 0) * C(0.68, -0.1, 0)).Position, (headCF * C(0, -0.62, 0)).Position, 0.05, iron, Mat.Metal, DECOR)
	end
	Kit.cable(map.Decor, Kit.sag((base * C(0.9, 11.85, 0)).Position, (headCF * C(0, 0.3, 0)).Position, 0.35, 2), 0.05, P.Black, Mat.Rubber, DECOR)
end

return Props
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">Templates</string>
              <string name="Source"><![CDATA[-- Реестр шаблонов объектов. Каждый объект строится ОДИН раз (с CSG) в начале работы сервера
-- в нескольких вариантах, хранится в ServerStorage, а на карту попадают копии (Clone + PivotTo).
local ServerStorage = game:GetService("ServerStorage")

local MapProps = require(script.Parent.MapProps)

local Templates = {}

export type Def = {
	Build: (rng: Random, variant: number) -> Model,
	Variants: number?,
}

local defs: { [string]: Def } = {}
local built: { [string]: { Model } } = {}

local storage: Folder?

local function getStorage(): Folder
	if storage and storage.Parent then
		return storage
	end
	local f = ServerStorage:FindFirstChild("PropTemplates") :: Folder?
	if not f then
		f = Instance.new("Folder")
		f.Name = "PropTemplates"
		f.Parent = ServerStorage
	end
	storage = f
	return f :: Folder
end

function Templates.register(name: string, def: Def)
	defs[name] = def
end

for name, def in MapProps.Templates do
	Templates.register(name, def)
end

function Templates.names(): { string }
	local list = {}
	for name in defs do
		table.insert(list, name)
	end
	table.sort(list)
	return list
end

-- Построить все варианты шаблона (CSG требует, чтобы детали были в workspace — строим в «мастерской» под картой)
function Templates.build(name: string): { Model }
	if built[name] then
		return built[name]
	end
	local def = defs[name]
	assert(def, "нет шаблона " .. name)
	local list = {}
	local workshop = Instance.new("Model")
	workshop.Name = "TemplateWorkshop"
	workshop.Parent = workspace
	for v = 1, def.Variants or 1 do
		local rng = Random.new(v * 7919 + #name * 131)
		local model = def.Build(rng, v)
		model.Name = name
		model.Parent = workshop
		model:SetAttribute("Template", name)
		model.Parent = getStorage()
		table.insert(list, model)
	end
	workshop:Destroy()
	built[name] = list
	return list
end

function Templates.prebuild()
	for name in defs do
		Templates.build(name)
	end
end

-- Поставить копию шаблона. cframe — опора модели (земля в центре, -Z = «перед»).
function Templates.spawn(name: string, cframe: CFrame, parent: Instance, rng: Random?): Model
	local list = Templates.build(name)
	local index = rng and rng:NextInteger(1, #list) or 1
	local model = list[index]:Clone()
	model:PivotTo(cframe)
	model:SetAttribute("Origin", cframe)
	model.Parent = parent
	return model
end

-- Для тестов: последний построенный вариант (без копирования)
function Templates.get(name: string, variant: number?): Model
	local list = Templates.build(name)
	return list[variant or 1]
end

return Templates
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[-- Процедурно строит карту (каждый раунд новая раскладка) и освещение.
-- Здесь только РАСКЛАДКА по ячейкам 22x22; внешний вид — в модулях Art/* и Terrain.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage.Shared.Config)
local Templates = require(script.Parent.Art.Templates)
local Structures = require(script.Parent.Art.Structures)
local Nature = require(script.Parent.Art.Nature)
local Lobby = require(script.Parent.Art.Lobby)
local Terrain = require(script.Parent.Terrain)

local function A(x: number?, y: number?, z: number?): CFrame
	return CFrame.Angles(math.rad(x or 0), math.rad(y or 0), math.rad(z or 0))
end

local MapBuilder = {}

local CELL = 22
local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function shuffle(list, rng: Random)
	for i = #list, 2, -1 do
		local j = rng:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
end

export type MapData = {
	Model: Model,
	Walls: Folder,
	Decor: Folder,
	Generators: Folder,
	Hooks: Folder,
	Pallets: Folder,
	Windows: Folder,
	ExitGates: Folder,
	Lockers: Folder,
	Totems: Folder,
	Chests: Folder,
	Traps: Folder,
	Crows: Folder,
	Effects: Folder,
	Hatch: Model,
	TrapSpots: { CFrame },
	CrowSpots: { CFrame },
	SurvivorSpawn: Vector3,
	KillerSpawn: Vector3,
	ChestSpots: { CFrame },
	TotemSpots: { CFrame },
}


function MapBuilder.BuildMap(seed: number?): MapData
	local old = workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end

	local rng = Random.new(seed or os.clock() * 1000)
	local size = Config.MapSize
	local half = size / 2

	local model = Instance.new("Model")
	model.Name = "Map"
	local map = {
		Model = model,
		Walls = folder("Walls", model),
		Decor = folder("Decor", model),
		Generators = folder("Generators", model),
		Hooks = folder("Hooks", model),
		Pallets = folder("Pallets", model),
		Windows = folder("Windows", model),
		ExitGates = folder("ExitGates", model),
		Lockers = folder("Lockers", model),
		Totems = folder("Totems", model),
		Chests = folder("Chests", model),
		Traps = folder("Traps", model),
		Crows = folder("Crows", model),
		Effects = folder("Effects", model),
		TrapSpots = {},
		CrowSpots = {},
		ChestSpots = {},
		TotemSpots = {},
	}

	-- Внешние стены с проёмами под ворота на севере и юге
	Structures.outerWalls(map, size, 16)
	for i, side in { 1, -1 } do
		local gateCF = CFrame.new(0, 0, side * half) * A(0, side == 1 and 0 or 180, 0)
		local gate = Templates.spawn("ExitGate", gateCF, map.ExitGates, rng)
		gate.Name = "ExitGate" .. i
	end

	-- Сетка ячеек
	local n = math.floor(size / CELL)
	local cells = {}
	local center
	for ix = 1, n do
		for iz = 1, n do
			local cx = -half + CELL * (ix - 0.5)
			local cz = -half + CELL * (iz - 0.5)
			local nearGate = math.abs(cx) < CELL and (iz == 1 or iz == n)
			if ix == math.ceil(n / 2) and iz == math.ceil(n / 2) then
				center = Vector3.new(cx, 0, cz)
			elseif not nearGate then
				table.insert(cells, Vector3.new(cx, 0, cz))
			end
		end
	end
	shuffle(cells, rng)

	local idx = 0
	local function nextCell(): (CFrame, Vector3)
		idx += 1
		local c = cells[idx]
		local rot = rng:NextInteger(0, 3) * 90
		return CFrame.new(c) * A(0, rot, 0), c
	end

	Structures.shack(map, CFrame.new(center) * A(0, rng:NextInteger(0, 3) * 90, 0), rng)
	Structures.house(map, (nextCell()), rng)

	for i = 1, Config.GeneratorCount do
		local cf = nextCell()
		local gen = Templates.spawn("Generator", cf, map.Generators, rng)
		gen.Name = "Generator" .. i
		Structures.generatorCover(map, cf, rng)
		table.insert(map.TrapSpots, cf * CFrame.new(rng:NextNumber(-4, 4), 0, -4))
	end
	for i = 1, 8 do
		local cf = nextCell()
		local hook = Templates.spawn("Hook", cf, map.Hooks, rng)
		hook.Name = "Hook" .. i
		table.insert(map.CrowSpots, cf * CFrame.new(0, 12, 0))
	end
	for _ = 1, 8 do
		Structures.palletLoop(map, (nextCell()), rng)
	end
	for _ = 1, 3 do
		Structures.windowLoop(map, (nextCell()), rng)
	end
	for _ = 1, 2 do
		Structures.lockerNook(map, (nextCell()), rng)
	end
	for _ = 1, 3 do
		local cf = nextCell()
		table.insert(map.TotemSpots, cf)
		Nature.rocks(map, cf * CFrame.new(0, 0, 6), rng)
	end
	for _ = 1, 3 do
		local cf = nextCell()
		table.insert(map.ChestSpots, cf)
		Structures.hay(map, cf * CFrame.new(0, 0, 5), rng)
	end

	-- Люк
	local hatchCF = nextCell()
	map.Hatch = Templates.spawn("Hatch", hatchCF, map.Model, rng)

	-- Тотемы (один — проклятый) и сундуки
	shuffle(map.TotemSpots, rng)
	for i = 1, math.min(5, #map.TotemSpots) do
		Templates.spawn(i == 1 and "HexTotem" or "Totem", map.TotemSpots[i], map.Totems, rng)
	end
	for _, cf in map.ChestSpots do
		Templates.spawn("Chest", cf, map.Chests, rng)
	end

	-- Декор
	for _ = 1, 4 do
		Structures.junk(map, (nextCell()), rng)
	end
	for _ = 1, 3 do
		Nature.corn(map, (nextCell()), rng)
	end
	for _ = 1, 6 do
		Nature.trees(map, (nextCell()), rng)
	end
	for _ = 1, 3 do
		Nature.deadTree(map, (nextCell()), rng)
	end
	for _ = 1, 4 do
		Nature.rocks(map, (nextCell()), rng)
	end
	for _ = 1, 2 do
		Structures.tombstones(map, (nextCell()), rng)
	end
	for _ = 1, 3 do
		Structures.barrelFire(map, (nextCell()), rng)
	end
	for _ = 1, 3 do
		Structures.fence(map, (nextCell()), rng)
	end
	for _ = 1, 5 do
		Structures.lamp(map, (nextCell()), rng)
	end

	-- Туман по всей карте
	for _ = 1, 14 do
		Nature.fog(map, Vector3.new(rng:NextNumber(-half, half), 1, rng:NextNumber(-half, half)), rng)
	end
	Nature.scatter(map, rng)

	-- Оставшиеся пустые ячейки — для спавна
	local free = {}
	for i = idx + 1, #cells do
		table.insert(free, cells[i])
	end
	local survivorSpawn = free[1] or Vector3.new(30, 0, 30)
	local killerSpawn = survivorSpawn
	local best = -1
	for _, c in free do
		local d = (c - survivorSpawn).Magnitude
		if d > best then
			best = d
			killerSpawn = c
		end
	end
	map.SurvivorSpawn = survivorSpawn + Vector3.new(0, 3.2, 0)
	map.KillerSpawn = killerSpawn + Vector3.new(0, 3.5, 0)
	for i = 2, #free do
		table.insert(map.CrowSpots, CFrame.new(free[i] + Vector3.new(rng:NextNumber(-6, 6), 0, rng:NextNumber(-6, 6))))
	end

	-- Ландшафт: тропинки от центра к воротам и между соседними ячейками
	local paths = {
		{ From = center, To = Vector3.new(0, 0, half), Width = 6 },
		{ From = center, To = Vector3.new(0, 0, -half), Width = 6 },
	}
	for i = 1, 10 do
		local a, b = cells[i], cells[i + 1]
		if a and b and (a - b).Magnitude < CELL * 3 then
			table.insert(paths, { From = a, To = b, Width = 4 })
		end
	end
	Terrain.buildMap(rng, paths)

	model.Parent = workspace
	return map :: any
end


------------------------------------------------------------------------
-- Освещение
------------------------------------------------------------------------

-- Лобби (модуль Art/Lobby) и ландшафт поляны
function MapBuilder.BuildLobby(): Model
	local existing = workspace:FindFirstChild("Lobby")
	if existing then
		return existing :: Model
	end
	Terrain.setupColors()
	Terrain.buildLobby()
	return Lobby.build()
end

function MapBuilder.LobbySpawn(): CFrame
	return Lobby.spawnCFrame()
end

function MapBuilder.SetupLighting()
	Lighting.ClockTime = 0.3
	Lighting.Brightness = 1.2
	Lighting.Ambient = Color3.fromRGB(35, 35, 50)
	Lighting.OutdoorAmbient = Color3.fromRGB(70, 70, 90)
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.GlobalShadows = true
	Lighting.FogEnd = 100000
	for _, child in Lighting:GetChildren() do
		child:Destroy()
	end

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.48
	atmosphere.Offset = 0.1
	atmosphere.Color = Color3.fromRGB(120, 130, 155)
	atmosphere.Decay = Color3.fromRGB(40, 45, 60)
	atmosphere.Glare = 0
	atmosphere.Haze = 2.2
	atmosphere.Parent = Lighting

	local sky = Instance.new("Sky")
	sky.CelestialBodiesShown = true
	sky.MoonAngularSize = 14
	sky.StarCount = 1500
	sky.Parent = Lighting

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = -0.35
	cc.Contrast = 0.15
	cc.Brightness = 0.02
	cc.TintColor = Color3.fromRGB(215, 225, 255)
	cc.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 30
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">PropFX</string>
            <string name="Source"><![CDATA[-- Визуальные состояния объектов карты. Игровые системы вызывают только эти функции,
-- поэтому внутреннее устройство моделей (Art/*) можно менять свободно.
--
-- Соглашения для моделей (проверяются Art/Contract.lua):
--   * подвижные детали: атрибуты FX = "<группа>", CF0/CF1 = положения относительно model:GetPivot()
--     (см. Kit.movable). Группы: LockerDoor, HatchDoor, TrapJaw, ChestLid, GateDoor, GateLever, Skull.
--   * генератор: детали с атрибутом ProgressLight = 1..4, деталь с атрибутом Bulb (внутри PointLight),
--     Attachment "FX" (точка для искр/дыма), детали поршней — атрибут AnimatedPiston (анимирует клиент).
--   * ворота: детали GateLamp = 1..3, деталь "Siren" с SpotLight "SirenLight", деталь "Switch".
--   * тотем: детали HexFlame (гаснут), SkullEye (темнеют), группа Skull (череп падает).
--   * люк/сундук: PointLight с именем "Glow" где-нибудь внутри модели.
local TweenService = game:GetService("TweenService")

local Kit = require(script.Parent.Art.Kit)
local MapProps = require(script.Parent.Art.MapProps)

local PropFX = {}

------------------------------------------------------------------------
-- Общие подвижные группы
------------------------------------------------------------------------

function PropFX.parts(model: Instance, group: string): { BasePart }
	local out = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("FX") == group then
			table.insert(out, d)
		end
	end
	return out
end

function PropFX.setGroup(model: Model, group: string, alpha: number)
	local pivot = model:GetPivot()
	for _, part in PropFX.parts(model, group) do
		local cf0 = part:GetAttribute("CF0") :: CFrame?
		local cf1 = part:GetAttribute("CF1") :: CFrame?
		if cf0 and cf1 then
			part.CFrame = (pivot * cf0):Lerp(pivot * cf1, math.clamp(alpha, 0, 1))
		end
	end
	model:SetAttribute("FX_" .. group, alpha)
end

-- Плавно перевести группу в состояние alpha (сервер, все видят)
function PropFX.tweenGroup(model: Model, group: string, alpha: number, duration: number, style: Enum.EasingStyle?): Tween?
	local from = (model:GetAttribute("FX_" .. group) :: number?) or 0
	local value = Instance.new("NumberValue")
	value.Value = from
	value.Changed:Connect(function(v)
		if model.Parent then
			PropFX.setGroup(model, group, v)
		end
	end)
	local tw = TweenService:Create(value, TweenInfo.new(duration, style or Enum.EasingStyle.Quad), { Value = alpha })
	tw.Completed:Connect(function()
		if model.Parent then
			PropFX.setGroup(model, group, alpha)
		end
		value:Destroy()
	end)
	tw:Play()
	return tw
end

local function findLight(model: Instance, name: string): Light?
	for _, d in model:GetDescendants() do
		if d:IsA("Light") and d.Name == name then
			return d
		end
	end
	return nil
end

------------------------------------------------------------------------
-- Генератор
------------------------------------------------------------------------

local LIGHT_OFF = Color3.fromRGB(45, 40, 30)
local LIGHT_ON = Color3.fromRGB(255, 220, 120)

function PropFX.genProgress(gen: Model, progress: number)
	for _, d in gen:GetDescendants() do
		local i = d:GetAttribute("ProgressLight")
		if i and d:IsA("BasePart") then
			local on = progress >= (i :: number) / 4 - 0.001
			d.Color = on and LIGHT_ON or LIGHT_OFF
			d.Material = on and Enum.Material.Neon or Enum.Material.Glass
		end
	end
end

function PropFX.genDone(gen: Model)
	PropFX.genProgress(gen, 1)
	for _, d in gen:GetDescendants() do
		if d:GetAttribute("Bulb") and d:IsA("BasePart") then
			d.Color = Color3.fromRGB(255, 230, 140)
			d.Material = Enum.Material.Neon
			for _, l in d:GetChildren() do
				if l:IsA("Light") then
					l.Enabled = true
				end
			end
		end
	end
end

local function fxAttachment(model: Model): Attachment?
	for _, d in model:GetDescendants() do
		if d:IsA("Attachment") and d.Name == "FX" then
			return d
		end
	end
	return nil
end

-- Взрыв при проваленной проверке навыка: искры и дым
function PropFX.genExplode(gen: Model)
	local att = fxAttachment(gen)
	if not att then
		return
	end
	local sparks = att:FindFirstChild("Sparks") :: ParticleEmitter?
	if not sparks then
		sparks = Kit.emitter(att, "Sparks")
		sparks.Enabled = false
	end
	local smoke = att:FindFirstChild("Smoke") :: ParticleEmitter?
	if not smoke then
		smoke = Kit.emitter(att, "Smoke", 1.4)
		smoke.Enabled = false
	end
	;(sparks :: ParticleEmitter):Emit(45)
	local s = smoke :: ParticleEmitter
	s.Enabled = true
	task.delay(2.5, function()
		if s.Parent then
			s.Enabled = false
		end
	end)
end

------------------------------------------------------------------------
-- Ворота
------------------------------------------------------------------------

function PropFX.gateProgress(gate: Model, progress: number)
	for _, d in gate:GetDescendants() do
		local i = d:GetAttribute("GateLamp")
		if i and d:IsA("BasePart") then
			local on = progress >= (i :: number) / 3
			d.Color = on and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(40, 0, 0)
			d.Material = Enum.Material.Neon
		end
	end
	PropFX.setGroup(gate, "GateLever", progress)
end

function PropFX.gatePowered(gate: Model)
	local sw = gate:FindFirstChild("Switch", true) :: BasePart?
	if sw then
		sw.Color = Color3.fromRGB(150, 130, 40)
	end
	for _, d in gate:GetDescendants() do
		if d:GetAttribute("PowerLight") and d:IsA("BasePart") then
			d.Material = Enum.Material.Neon
			d.Color = Color3.fromRGB(255, 200, 90)
		end
	end
end

function PropFX.gateSiren(gate: Model, on: boolean)
	local siren = gate:FindFirstChild("Siren", true)
	local light = siren and siren:FindFirstChild("SirenLight") :: Light?
	if light then
		light.Enabled = on
	end
	if siren and siren:IsA("BasePart") then
		siren.Material = on and Enum.Material.Neon or Enum.Material.Glass
		siren.Color = on and Color3.fromRGB(255, 40, 30) or Color3.fromRGB(80, 10, 10)
	end
end

function PropFX.gateOpen(gate: Model)
	PropFX.gateProgress(gate, 1)
	for _, p in PropFX.parts(gate, "GateDoor") do
		p.CanCollide = false
	end
	PropFX.tweenGroup(gate, "GateDoor", 1, 2.5)
end

------------------------------------------------------------------------
-- Шкафчик, люк, капкан, сундук
------------------------------------------------------------------------

function PropFX.lockerDoor(locker: Model, alpha: number)
	PropFX.setGroup(locker, "LockerDoor", alpha)
end

-- Открыть дверь и закрыть через holdTime
function PropFX.swingLockerDoor(locker: Model, holdTime: number, onSound: (() -> ())?)
	PropFX.tweenGroup(locker, "LockerDoor", 1, 0.2)
	if onSound then
		onSound()
	end
	task.delay(0.2 + holdTime, function()
		if locker.Parent then
			PropFX.tweenGroup(locker, "LockerDoor", 0, 0.25)
			if onSound then
				task.delay(0.25, onSound)
			end
		end
	end)
end

function PropFX.hatch(hatch: Model, open: boolean)
	PropFX.tweenGroup(hatch, "HatchDoor", open and 1 or 0, 0.6, Enum.EasingStyle.Back)
	local glow = findLight(hatch, "Glow")
	if glow then
		glow.Enabled = open
	end
end

-- armed = true: челюсти раскрыты (CF0), false: захлопнуты (CF1)
function PropFX.trap(trap: Model, armed: boolean)
	PropFX.setGroup(trap, "TrapJaw", armed and 0 or 1)
end

function PropFX.chestOpen(chest: Model)
	PropFX.tweenGroup(chest, "ChestLid", 1, 0.5, Enum.EasingStyle.Back)
	local glow = findLight(chest, "Glow")
	if glow then
		glow.Enabled = true
	end
end

------------------------------------------------------------------------
-- Тотем
------------------------------------------------------------------------

function PropFX.totemCleansed(totem: Model)
	for _, d in totem:GetDescendants() do
		if d:GetAttribute("HexFlame") then
			d:Destroy()
		elseif d:GetAttribute("SkullEye") and d:IsA("BasePart") then
			d.Color = Color3.fromRGB(20, 20, 22)
			d.Material = Enum.Material.SmoothPlastic
		end
	end
	PropFX.tweenGroup(totem, "Skull", 1, 0.6, Enum.EasingStyle.Bounce)
end

------------------------------------------------------------------------
-- Паллета
------------------------------------------------------------------------

local function tweenModel(model: Model, target: CFrame, duration: number)
	local value = Instance.new("CFrameValue")
	value.Value = model:GetPivot()
	value.Changed:Connect(function(cf)
		if model.Parent then
			model:PivotTo(cf)
		end
	end)
	local tw = TweenService:Create(value, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Value = target })
	tw.Completed:Connect(function()
		if model.Parent then
			model:PivotTo(target)
		end
		value:Destroy()
	end)
	tw:Play()
end

function PropFX.palletDrop(pallet: Model)
	local dropCF = pallet:GetAttribute("DropCFrame") :: CFrame
	local hitbox = pallet.PrimaryPart
	if hitbox then
		hitbox.CanCollide = true
	end
	tweenModel(pallet, dropCF, 0.25)
end

-- Обломки разлетаются и исчезают
function PropFX.palletBreak(pallet: Model, debrisParent: Instance?)
	for _, d in pallet:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.AssemblyLinearVelocity = Vector3.new(math.random(-15, 15), math.random(8, 18), math.random(-15, 15))
		end
	end
	if debrisParent then
		pallet.Parent = debrisParent
	end
	task.delay(2, function()
		pallet:Destroy()
	end)
end

------------------------------------------------------------------------
-- Сущность на крюке
------------------------------------------------------------------------

PropFX.EntityBuilder = MapProps.entityLegs :: ((hangPoint: CFrame) -> Model)?

function PropFX.entity(hook: Model, on: boolean)
	local existing = hook:FindFirstChild("EntityLegs")
	if not on then
		if existing then
			existing:Destroy()
		end
		return
	end
	if existing then
		return
	end
	local hp = hook:FindFirstChild("HangPoint", true) :: BasePart?
	if not hp or not PropFX.EntityBuilder then
		return
	end
	local legs = PropFX.EntityBuilder(hp.CFrame)
	legs.Name = "EntityLegs"
	legs.Parent = hook
end

return PropFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">Terrain</string>
            <string name="Source"><![CDATA[-- Ландшафт (Roblox Terrain): трава, тропинки, грязь, камни, холмы за стенами.
-- Поверхность земли на карте — y = 0, внутри стен она ровная (рельеф — только снаружи).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Terrain = {}

local M = Enum.Material

local function terrain(): Terrain?
	return workspace:FindFirstChildOfClass("Terrain")
end

-- Вызов метода Terrain с защитой (в тестах/эмуляторе части методов может не быть)
local function call(method: string, ...)
	local t = terrain()
	if not t then
		return
	end
	local args = table.pack(...)
	pcall(function()
		(t :: any)[method](t, table.unpack(args, 1, args.n))
	end)
end
Terrain.call = call

-- Отложенные заливки. Природа (бугры под камнями, земля под кукурузой) добавляет их во время
-- раскладки ячеек, а buildMap применяет после основы — иначе clearMap стёр бы их.
local pending: { any } = {}

function Terrain.defer(method: string, ...)
	table.insert(pending, table.pack(method, ...))
end

local function flush()
	for _, job in pending do
		call(table.unpack(job, 1, job.n))
	end
	table.clear(pending)
end

function Terrain.setupColors()
	call("SetMaterialColor", M.Grass, Color3.fromRGB(60, 72, 42))
	call("SetMaterialColor", M.LeafyGrass, Color3.fromRGB(42, 56, 34))
	call("SetMaterialColor", M.Ground, Color3.fromRGB(76, 63, 48))
	call("SetMaterialColor", M.Mud, Color3.fromRGB(52, 42, 34))
	call("SetMaterialColor", M.Rock, Color3.fromRGB(88, 86, 84))
	call("SetMaterialColor", M.Slate, Color3.fromRGB(68, 68, 72))
end

-- Очистить область карты (лобби высоко над картой не трогаем)
function Terrain.clearMap()
	local size = Config.MapSize + 280
	call("FillBlock", CFrame.new(0, 20, 0), Vector3.new(size, 80, size), M.Air)
end

-- Пятно материала заподлицо с землёй (верх на y = top): 2-3 перекрывающихся круга — неровный край
local function patch(pos: Vector3, radius: number, material: Enum.Material, rng: Random, top: number?)
	local y = (top or 0) - 1
	for i = 1, rng:NextInteger(2, 3) do
		local a = rng:NextNumber(0, math.pi * 2)
		local d = i == 1 and 0 or radius * rng:NextNumber(0.4, 0.8)
		local r = radius * (i == 1 and 1 or rng:NextNumber(0.45, 0.75))
		call("FillCylinder", CFrame.new(pos.X + math.cos(a) * d, y, pos.Z + math.sin(a) * d), 2, r, material)
	end
end

-- Извилистая полоса (тропа) от a до b: отрезки со смещёнными серединами
local function track(a: Vector3, b: Vector3, width: number, material: Enum.Material, rng: Random, top: number?)
	local y = (top or 0) - 1
	local len = (b - a).Magnitude
	if len < 1 then
		return
	end
	local dir = (b - a).Unit
	local side = Vector3.new(-dir.Z, 0, dir.X)
	local steps = math.max(1, math.floor(len / 9))
	local prev = a
	for i = 1, steps do
		local t = i / steps
		local p = a:Lerp(b, t)
		if i < steps then
			p += side * rng:NextNumber(-1.4, 1.4)
		end
		local mid = (prev + p) / 2
		local seg = (p - prev).Magnitude
		local cf = CFrame.lookAt(Vector3.new(mid.X, y, mid.Z), Vector3.new(p.X, y, p.Z))
		call("FillBlock", cf, Vector3.new(width * rng:NextNumber(0.85, 1.15), 2, seg + width * 0.6), material)
		prev = p
	end
end

-- Холмы и скальные выходы за стенами. Ничего выше y = 0 не заходит ближе inner к центру по оси стены,
-- коридоры ворот (север/юг, |x| < 14) остаются свободными. side: (нормаль наружу, вдоль стены).
local function borderHills(rng: Random, half: number)
	local inner = half + 3
	local sides = {
		{ Vector3.new(1, 0, 0), Vector3.new(0, 0, 1), false },
		{ Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), false },
		{ Vector3.new(0, 0, 1), Vector3.new(1, 0, 0), true },
		{ Vector3.new(0, 0, -1), Vector3.new(1, 0, 0), true },
	}
	-- Шар с верхом на высоте top: возвращает центр по высоте и радиус «шапки» над землёй
	local function cap(r: number, top: number): (number, number)
		local yc = top - r
		return yc, math.sqrt(math.max(r * r - yc * yc, 0))
	end
	for _, s in sides do
		local out: Vector3, along: Vector3, gated: boolean = s[1], s[2], s[3]
		local a = -half - 70
		while a < half + 70 do
			local function ok(dist: number, reach: number): boolean
				-- Коридор ворот уходит от стены на ~40 стад: рядом с ним — только дальние холмы
				return not (gated and math.abs(a) < 14 + reach and dist - reach < half + 45)
			end
			-- Ближний вал: невысокий, травянистый
			local r1 = rng:NextNumber(9, 15)
			local yc1, rc1 = cap(r1, rng:NextNumber(4, 11))
			local d1 = inner + rc1 + rng:NextNumber(0, 6)
			if ok(d1, rc1) then
				local p = out * d1 + along * a + Vector3.new(0, yc1, 0)
				call("FillBall", p, r1, rng:NextNumber() < 0.65 and M.LeafyGrass or M.Grass)
			end
			-- Дальний холм: высокий, с камнем
			local r2 = rng:NextNumber(18, 28)
			local top2 = rng:NextNumber(16, 32)
			local yc2, rc2 = cap(r2, top2)
			local d2 = math.max(half + 28 + rng:NextNumber(0, 18), inner + rc2)
			if ok(d2, rc2) then
				local roll = rng:NextNumber()
				local mat = roll < 0.72 and M.LeafyGrass or (roll < 0.88 and M.Ground or M.Grass)
				call("FillBall", out * d2 + along * a + Vector3.new(0, yc2, 0), r2, mat)
				-- Скальный выход на склоне, обращённом к карте
				if rng:NextNumber() < 0.45 then
					local size = Vector3.new(rng:NextNumber(6, 13), rng:NextNumber(5, 10), rng:NextNumber(4, 8))
					local reach = size.Magnitude / 2
					local dist = math.max(d2 - rc2 * 0.45, inner + reach)
					local h = math.max(top2 * 0.45, 2)
					local cf = CFrame.new(out * dist + along * (a + rng:NextNumber(-4, 4)) + Vector3.new(0, h, 0))
						* CFrame.Angles(math.rad(rng:NextNumber(-30, 30)), rng:NextNumber(0, math.pi * 2), math.rad(rng:NextNumber(-30, 30)))
					call("FillBlock", cf, size, rng:NextNumber() < 0.6 and M.Rock or M.Slate)
				elseif rng:NextNumber() < 0.3 then
					-- Валун, наполовину ушедший в склон
					local rb = rng:NextNumber(3.5, 6)
					local dist = math.max(d2 - rc2 * 0.6, inner + rb)
					call("FillBall", out * dist + along * a + Vector3.new(0, top2 * 0.35, 0), rb, M.Rock)
				end
			end
			a += rng:NextNumber(10, 16)
		end
	end
	-- Дорога из ворот в лес
	for _, z in { 1, -1 } do
		track(Vector3.new(0, 0, z * (half + 2)), Vector3.new(0, 0, z * (half + 120)), 7, M.Ground, rng)
	end
end

-- Земля карты. paths — список {From = Vector3, To = Vector3, Width = number} (тропинки между ячейками)
function Terrain.buildMap(rng: Random, paths: { any }?)
	local size = Config.MapSize
	local half = size / 2
	Terrain.clearMap()
	-- Основание: трава толщиной 8 стад, верх на y = 0
	call("FillBlock", CFrame.new(0, -4, 0), Vector3.new(size + 260, 8, size + 260), M.Grass)
	-- Пятна: густая трава, голая земля, лужи грязи (неровные, разного размера)
	for _, spec in { { 26, M.LeafyGrass, 5, 12 }, { 16, M.Ground, 3, 7 }, { 10, M.Mud, 2, 4.5 } } do
		for _ = 1, spec[1] do
			patch(Vector3.new(rng:NextNumber(-half, half), 0, rng:NextNumber(-half, half)), rng:NextNumber(spec[3], spec[4]), spec[2], rng)
		end
	end
	-- Густая трава вдоль подножия внешних стен
	for _, s in { 1, -1 } do
		call("FillBlock", CFrame.new(s * (half - 2.5), -1, 0), Vector3.new(4, 2, size), M.LeafyGrass)
		call("FillBlock", CFrame.new(0, -1, s * (half - 2.5)), Vector3.new(size, 2, 4), M.LeafyGrass)
	end
	-- Тропинки (земля, местами грязь)
	if paths then
		for _, path in paths do
			local a: Vector3, b: Vector3 = path.From, path.To
			local w = path.Width or 5
			track(a, b, w, M.Ground, rng)
			if rng:NextNumber() < 0.5 then
				local p = a:Lerp(b, rng:NextNumber(0.2, 0.8))
				patch(p, w * 0.45, M.Mud, rng)
			end
		end
	end
	flush()
	borderHills(rng, half)
end

-- Направления троп от костра в лобби (градусы от +X к +Z)
Terrain.LobbyPaths = { 34, 166, 290 }

-- Поляна в лобби: плоская внутри ограды (±60), холмы и скалы снаружи
function Terrain.buildLobby()
	local pos = Config.LobbyPosition
	local rng = Random.new(7)
	call("FillBlock", CFrame.new(pos + Vector3.new(0, -4, 0)), Vector3.new(240, 8, 240), M.Grass)
	-- Опушка: густая трава кольцом, ближе к костру — вытоптанная земля
	for _ = 1, 22 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(26, 56)
		patch(pos + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r), rng:NextNumber(6, 12), M.LeafyGrass, rng, pos.Y)
	end
	patch(pos, 12, M.Ground, rng, pos.Y)
	patch(pos, 5, M.Mud, rng, pos.Y)
	for _ = 1, 8 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(8, 16)
		patch(pos + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r), rng:NextNumber(2.5, 4.5), rng:NextNumber() < 0.5 and M.Mud or M.Ground, rng, pos.Y)
	end
	-- Тропы от костра в лес (Art/Lobby оставляет их свободными от деревьев)
	for _, deg in Terrain.LobbyPaths do
		local a = math.rad(deg)
		track(pos, pos + Vector3.new(math.cos(a) * 58, 0, math.sin(a) * 58), 4, M.Ground, rng, pos.Y)
	end
	-- Холмы за оградой
	for i = 1, 30 do
		local a = i / 30 * math.pi * 2 + rng:NextNumber(-0.08, 0.08)
		local r = rng:NextNumber(14, 24)
		local top = rng:NextNumber(8, 22)
		local dist = 64 + math.sqrt(math.max(r * r - (top - r) ^ 2, 0)) + rng:NextNumber(0, 10)
		local p = pos + Vector3.new(math.cos(a) * dist, top - r, math.sin(a) * dist)
		call("FillBall", p, r, rng:NextNumber() < 0.75 and M.LeafyGrass or M.Ground)
		if rng:NextNumber() < 0.4 then
			local size = Vector3.new(rng:NextNumber(5, 10), rng:NextNumber(4, 8), rng:NextNumber(4, 7))
			local cf = CFrame.new(pos + Vector3.new(math.cos(a) * (dist - r * 0.4), top * 0.5, math.sin(a) * (dist - r * 0.4)))
				* CFrame.Angles(math.rad(rng:NextNumber(-25, 25)), rng:NextNumber(0, math.pi * 2), math.rad(rng:NextNumber(-25, 25)))
			call("FillBlock", cf, size, M.Slate)
		end
	end
end

return Terrain
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="75">
        <Properties>
          <string name="Name">Powers</string>
          <string name="Source"><![CDATA[-- Диспетчер способностей маньяков.
-- Каждый модуль может определить: Setup, Press, Release, Update, CanAttack, SpeedOverride,
-- TerrorRadius, OnStun, OnBlind, OnHit, OnLockerSearched, Cleanup.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.Core.State)

local Powers = {}

local modules = {
	Trapper = require(script.Trapper),
	Huntress = require(script.Huntress),
	Wraith = require(script.Wraith),
}

function Powers.module(kdata)
	return kdata and modules[kdata.KillerType]
end

-- Вызывает функцию способности, если она есть. Возвращает её результат или nil.
function Powers.call(kdata, fnName: string, ...): any
	local m = Powers.module(kdata)
	local fn = m and m[fnName]
	if fn then
		return fn(kdata, ...)
	end
	return nil
end

function Powers.update(dt: number)
	local k = State.Killer
	if k and k.Status == "Playing" then
		Powers.call(k, "Update", dt)
	end
end

local function validAim(aim: any): Vector3?
	if typeof(aim) ~= "Vector3" then
		return nil
	end
	local m = aim.Magnitude
	if m ~= m or m < 0.5 or m > 1.5 then
		return nil
	end
	return aim.Unit
end

Remotes.UsePower.OnServerEvent:Connect(function(player, isDown, aim)
	local data = State.get(player)
	if not State.Active or not data or data.Role ~= "Killer" or data.Status ~= "Playing" then
		return
	end
	if isDown == true then
		Powers.call(data, "Press", validAim(aim))
	else
		Powers.call(data, "Release", validAim(aim))
	end
end)

return Powers
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">Huntress</string>
            <string name="Source"><![CDATA[-- Охотница: метательные топоры (сервер считает полёт, клиенты рисуют).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Server = script.Parent.Parent
local State = require(Server.Core.State)
local Scoring = require(Server.Core.Scoring)
local Health = require(Server.Systems.Health)

local DEF = KillerDefs.Huntress
local Huntress = {}

local projectiles = {}
local nextId = 0
local GRAVITY = Vector3.new(0, -DEF.Gravity, 0)

local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
params.RespectCanCollide = true

local function setAttrs(kdata)
	kdata.Player:SetAttribute("PowerCount", kdata.Power.Hatchets)
	local charge = 0
	if kdata.Power.WindupStart then
		charge = math.clamp((State.now() - kdata.Power.WindupStart) / DEF.FullWindup, 0, 1)
	end
	kdata.Player:SetAttribute("PowerCharge", charge)
end

function Huntress.Setup(kdata)
	kdata.Power = { Hatchets = DEF.MaxHatchets, WindupStart = nil }
	table.clear(projectiles)
	setAttrs(kdata)
end

local function cancelWindup(kdata)
	if kdata.Power.WindupStart then
		kdata.Power.WindupStart = nil
		kdata.PowerBusy = false
		State.playAnim(kdata.Player, "Cancel")
		setAttrs(kdata)
	end
end

function Huntress.Press(kdata)
	local t = State.now()
	if kdata.Power.Hatchets <= 0 then
		State.notify(kdata.Player, "Топоры кончились — пополни их в шкафчике (E)", State.WHITE)
		return
	end
	if kdata.Power.WindupStart or kdata.Carrying or kdata.Action or kdata.Lunging then
		return
	end
	if t < kdata.StunnedUntil or t < kdata.BlindUntil or t < kdata.VaultUntil then
		return
	end
	kdata.Power.WindupStart = t
	kdata.PowerBusy = true
	State.playAnim(kdata.Player, "Windup")
	State.sfx("Hum", State.getRoot(kdata.Player))
end

local function throw(kdata, aim: Vector3?, charge: number)
	local char = kdata.Player.Character
	local head = char and char:FindFirstChild("Head") :: BasePart?
	local root = State.getRoot(kdata.Player)
	if not head or not root then
		return
	end
	local look = root.CFrame.LookVector
	local dir = aim or head.CFrame.LookVector
	-- Нельзя бросать назад
	if dir:Dot(look) < 0.2 then
		dir = look
	end
	local k = math.clamp((charge - DEF.MinWindup) / (DEF.FullWindup - DEF.MinWindup), 0, 1)
	local speed = DEF.ThrowSpeedMin + (DEF.ThrowSpeedMax - DEF.ThrowSpeedMin) * k
	local origin = head.Position + root.CFrame.RightVector * 0.8 + dir * 1.2
	local vel = dir * speed
	nextId += 1
	table.insert(projectiles, { Id = nextId, Pos = origin, Vel = vel, Life = 0, Owner = kdata })
	kdata.Power.Hatchets -= 1
	Remotes.Projectile:FireAllClients(nextId, origin, vel, DEF.Gravity)
	State.sfx("Throw", origin)
	State.playAnim(kdata.Player, "Throw")
end

function Huntress.Release(kdata, aim: Vector3?)
	local start = kdata.Power.WindupStart
	if not start then
		return
	end
	local charge = State.now() - start
	kdata.Power.WindupStart = nil
	kdata.PowerBusy = false
	if charge >= DEF.MinWindup and kdata.Status == "Playing" then
		throw(kdata, aim, charge)
	else
		State.playAnim(kdata.Player, "Cancel")
	end
	setAttrs(kdata)
end

function Huntress.CanAttack(kdata)
	return kdata.Power.WindupStart == nil
end

function Huntress.SpeedOverride(kdata, _t)
	if kdata.Power.WindupStart then
		return DEF.WindupSpeed
	end
	return nil
end

function Huntress.OnStun(kdata)
	cancelWindup(kdata)
end
Huntress.OnBlind = Huntress.OnStun

function Huntress.OnLockerSearched(kdata)
	if kdata.Power.Hatchets < DEF.MaxHatchets then
		kdata.Power.Hatchets = DEF.MaxHatchets
		setAttrs(kdata)
		State.notify(kdata.Player, "Топоры пополнены", State.WHITE)
		State.sfx("Rustle", State.getRoot(kdata.Player))
	end
end

local function survivorFromPart(part: Instance)
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		for player, data in State.Participants do
			if player.Character == model and data.Role == "Survivor" then
				return data
			end
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

function Huntress.Update(kdata, dt: number)
	setAttrs(kdata)
	if #projectiles == 0 then
		return
	end
	local exclude = { kdata.Player.Character }
	if State.Map then
		table.insert(exclude, State.Map.Effects)
		table.insert(exclude, State.Map.Crows)
		table.insert(exclude, State.Map.Traps)
	end
	-- Спрятанных и висящих не задеваем
	for _, data in State.Participants do
		if data.Role == "Survivor" and data.Player.Character and (data.Status ~= "Playing" or data.Hidden) then
			table.insert(exclude, data.Player.Character)
		end
	end
	params.FilterDescendantsInstances = exclude
	for i = #projectiles, 1, -1 do
		local p = projectiles[i]
		local newVel = p.Vel + GRAVITY * dt
		local newPos = p.Pos + (p.Vel + newVel) * 0.5 * dt
		p.Life += dt
		local result = workspace:Raycast(p.Pos, newPos - p.Pos, params)
		local done = false
		if result then
			local sdata = survivorFromPart(result.Instance)
			if sdata and sdata.Status == "Playing" and sdata.Health > 0 then
				Health.damage(sdata, "Hatchet")
				Scoring.add(kdata.Player, "Deviousness", 700, "Попадание топором")
				Remotes.ProjectileEnd:FireAllClients(p.Id, result.Position, true)
			else
				Remotes.ProjectileEnd:FireAllClients(p.Id, result.Position, false)
				State.sfx("Thud", result.Position)
			end
			done = true
		elseif p.Life > 4 or newPos.Y < -20 then
			Remotes.ProjectileEnd:FireAllClients(p.Id, newPos, false)
			done = true
		end
		if done then
			table.remove(projectiles, i)
		else
			p.Pos = newPos
			p.Vel = newVel
		end
	end
end

function Huntress.Cleanup(_kdata)
	table.clear(projectiles)
end

return Huntress
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">Trapper</string>
            <string name="Source"><![CDATA[-- Траппер: медвежьи капканы.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)
local Server = script.Parent.Parent
local State = require(Server.Core.State)
local Actions = require(Server.Core.Actions)
local Lifecycle = require(Server.Core.Lifecycle)
local Scoring = require(Server.Core.Scoring)
local PropFX = require(Server.Map.PropFX)
local Templates = require(Server.Map.Art.Templates)
local Health = require(Server.Systems.Health)

local DEF = KillerDefs.Trapper
local Trapper = {}

local rng = Random.new()

local function setCount(kdata)
	kdata.Player:SetAttribute("PowerCount", kdata.Power.InHand)
end

local function isTrap(target: Instance): boolean
	return target:GetAttribute("Kind") == "Trap"
end

local function trapPosition(trap: Model): Vector3
	return (trap:GetAttribute("Origin") :: CFrame).Position
end

function Trapper.Setup(kdata)
	kdata.Power = { InHand = DEF.TrapsInHand }
	setCount(kdata)
	local map = State.Map
	if not map then
		return
	end
	local spots = table.clone(map.TrapSpots)
	for i = #spots, 2, -1 do
		local j = rng:NextInteger(1, i)
		spots[i], spots[j] = spots[j], spots[i]
	end
	for i = 1, math.min(DEF.TrapsOnMap, #spots) do
		local trap = Templates.spawn("Trap", spots[i] * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0), map.Traps, rng)
		trap:SetAttribute("Owner", kdata.Player.UserId)
	end
end

-- Отпустить выжившего из капкана
local function release(sdata)
	local trap = sdata.Trapped
	if not trap then
		return
	end
	sdata.Trapped = nil
	sdata.Player:SetAttribute("Trapped", nil)
	if trap.Parent then
		trap:SetAttribute("Caught", 0)
	end
	local root = State.getRoot(sdata.Player)
	if root then
		root.Anchored = false
	end
end

local function catch(sdata, trap: Model)
	Actions.cancel(sdata)
	trap:SetAttribute("Armed", false)
	trap:SetAttribute("Caught", sdata.Player.UserId)
	PropFX.trap(trap, false)
	sdata.Trapped = trap
	sdata.TrapAttempts = 0
	sdata.Player:SetAttribute("Trapped", true)
	local root = State.getRoot(sdata.Player)
	local pos = trapPosition(trap)
	if root then
		root.Anchored = true
		root.CFrame = CFrame.new(pos.X, root.Position.Y, pos.Z) * root.CFrame.Rotation
	end
	State.sfx("TrapSnap", pos)
	Health.damage(sdata, "Trap")
	State.sfx("Scream", pos)
	State.noise(pos)
	local k = State.Killer
	if k then
		State.notify(k.Player, sdata.Player.DisplayName .. " попал в капкан!", State.RED)
		Scoring.add(k.Player, "Deviousness", 500, "Пойман в капкан")
	end
end

function Trapper.Press(kdata)
	if kdata.Power.InHand > 0 and not kdata.Action then
		Actions.start(kdata, "SetTrap", kdata.Player)
	elseif kdata.Power.InHand <= 0 then
		State.notify(kdata.Player, "Нет капканов в руках — подбери капкан на карте (E)", State.WHITE)
	end
end

function Trapper.Release(kdata)
	if kdata.Action and kdata.Action.Kind == "SetTrap" then
		Actions.cancel(kdata)
	end
end

function Trapper.Update(kdata, _dt)
	local map = State.Map
	if not map then
		return
	end
	for _, trap in map.Traps:GetChildren() do
		if not trap:GetAttribute("Armed") then
			continue
		end
		local pos = trapPosition(trap :: Model)
		for _, sdata in State.survivors() do
			if sdata.Status ~= "Playing" or sdata.Hidden or sdata.Trapped or State.now() < sdata.VaultUntil then
				continue
			end
			local root = State.getRoot(sdata.Player)
			if root and State.flatDist(root.Position, pos) < 1.4 and root.Position.Y - pos.Y < 4.5 then
				catch(sdata, trap :: Model)
				break
			end
		end
	end
	setCount(kdata)
end

------------------------------------------------------------------------
-- Действия
------------------------------------------------------------------------

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.RespectCanCollide = true

Actions.register("SetTrap", {
	Validate = function(data, _target)
		return data.KillerType == "Trapper" and data.Power ~= nil and data.Power.InHand > 0
	end,
	Complete = function(data, _target)
		local root = State.getRoot(data.Player)
		if not root or not State.Map then
			return
		end
		local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
		local origin = root.Position + look.Unit * 2.5
		local exclude = { State.Map.Traps, State.Map.Effects }
		for p in State.Participants do
			if p.Character then
				table.insert(exclude, p.Character)
			end
		end
		groundParams.FilterDescendantsInstances = exclude
		local hit = workspace:Raycast(origin, Vector3.new(0, -12, 0), groundParams)
		local ground = hit and hit.Position or Vector3.new(origin.X, 0, origin.Z)
		local trap = Templates.spawn("Trap", CFrame.lookAt(ground, ground + look), State.Map.Traps)
		trap:SetAttribute("Owner", data.Player.UserId)
		data.Power.InHand -= 1
		setCount(data)
		State.sfx("Clank", ground)
	end,
})

Actions.register("PickupTrap", {
	Validate = function(data, target)
		return data.KillerType == "Trapper"
			and isTrap(target)
			and target:GetAttribute("Caught") == 0
			and data.Power.InHand < DEF.MaxTrapsInHand
	end,
	Complete = function(data, target)
		target:Destroy()
		data.Power.InHand += 1
		setCount(data)
		State.sfx("Rustle", State.getRoot(data.Player))
	end,
})

Actions.register("ResetTrap", {
	Validate = function(data, target)
		return data.KillerType == "Trapper" and isTrap(target) and not target:GetAttribute("Armed") and target:GetAttribute("Caught") == 0
	end,
	Complete = function(_data, target)
		target:SetAttribute("Armed", true)
		PropFX.trap(target :: Model, true)
		State.sfx("Clank", trapPosition(target :: Model))
	end,
})

Actions.register("DisarmTrap", {
	Validate = function(_data, target)
		return isTrap(target) and target:GetAttribute("Armed") == true
	end,
	Complete = function(data, target)
		target:SetAttribute("Armed", false)
		PropFX.trap(target :: Model, false)
		State.sfx("TrapSnap", trapPosition(target :: Model))
		Scoring.add(data.Player, "Boldness", 300, "Капкан обезврежен")
	end,
})

Actions.register("EscapeTrap", {
	AllowTrapped = true,
	Validate = function(data, target)
		return data.Trapped ~= nil and data.Trapped == target
	end,
	Complete = function(data, _target)
		data.TrapAttempts = (data.TrapAttempts or 0) + 1
		local chance = DEF.TrapEscapeChance + data.TrapAttempts * 0.05
		if rng:NextNumber() < chance then
			release(data)
			State.notify(data.Player, "Ты вырвался из капкана!", State.GREEN)
			Scoring.add(data.Player, "Survival", 500, "Вырвался из капкана")
		else
			local root = State.getRoot(data.Player)
			if root then
				State.sfx("Pain", root)
			end
		end
	end,
})

Actions.register("FreeTrap", {
	Validate = function(data, target)
		if not isTrap(target) then
			return false
		end
		local caught = target:GetAttribute("Caught") :: number
		return caught ~= 0 and caught ~= data.Player.UserId
	end,
	Complete = function(data, target)
		for _, sdata in State.Participants do
			if sdata.Trapped == target then
				release(sdata)
				State.notify(sdata.Player, data.Player.DisplayName .. " освободил тебя из капкана", State.GREEN)
				Scoring.add(data.Player, "Altruism", 1000, "Освобождение из капкана")
			end
		end
	end,
})

Lifecycle.addDetach(function(data)
	if data.Trapped then
		release(data)
	end
end)

return Trapper
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">Wraith</string>
            <string name="Source"><![CDATA[-- Призрак: колокол, невидимость и рывок после проявления.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)
local Server = script.Parent.Parent
local State = require(Server.Core.State)
local Scoring = require(Server.Core.Scoring)

local DEF = KillerDefs.Wraith
local Wraith = {}

local function setCloaked(kdata, cloaked: boolean)
	kdata.Power.Cloaked = cloaked
	kdata.Player:SetAttribute("Cloaked", cloaked)
	local char = kdata.Player.Character
	if char then
		char:SetAttribute("Cloaked", cloaked)
		-- Красное пятно не видно, пока Призрак невидим
		local head = char:FindFirstChild("Head")
		local stain = head and head:FindFirstChild("RedStain") :: SpotLight?
		if stain then
			stain.Enabled = not cloaked
		end
	end
end

function Wraith.Setup(kdata)
	kdata.Power = { Cloaked = false, Transition = nil, TransitionEnd = 0, BoostUntil = 0, UncloakedAt = 0 }
	setCloaked(kdata, false)
	kdata.Player:SetAttribute("PowerState", "Visible")
end

local function startTransition(kdata, kind: string, duration: number)
	kdata.Power.Transition = kind
	kdata.Power.TransitionEnd = State.now() + duration
	kdata.PowerBusy = true
	kdata.Player:SetAttribute("PowerState", kind)
	State.playAnim(kdata.Player, "Bell")
	State.sfx("Bell", State.getRoot(kdata.Player))
end

function Wraith.Press(kdata)
	local p = kdata.Power
	local t = State.now()
	if p.Transition or kdata.Carrying or kdata.Action or kdata.Lunging then
		return
	end
	if t < kdata.StunnedUntil or t < kdata.BlindUntil or t < kdata.VaultUntil then
		return
	end
	if p.Cloaked then
		startTransition(kdata, "Uncloaking", DEF.UncloakTime)
	else
		startTransition(kdata, "Cloaking", DEF.CloakTime)
	end
end

function Wraith.Update(kdata, _dt)
	local p = kdata.Power
	if p.Transition and State.now() >= p.TransitionEnd then
		if p.Transition == "Cloaking" then
			setCloaked(kdata, true)
			kdata.Player:SetAttribute("PowerState", "Cloaked")
		else
			setCloaked(kdata, false)
			p.BoostUntil = State.now() + DEF.UncloakBoostTime
			p.UncloakedAt = State.now()
			kdata.Player:SetAttribute("PowerState", "Visible")
		end
		p.Transition = nil
		kdata.PowerBusy = false
	end
end

function Wraith.CanAttack(kdata)
	return not kdata.Power.Cloaked and kdata.Power.Transition == nil
end

function Wraith.SpeedOverride(kdata, t: number)
	local p = kdata.Power
	if p.Transition then
		return 4
	end
	if p.Cloaked then
		return DEF.CloakedSpeed
	end
	if t < p.BoostUntil then
		return DEF.UncloakBoostSpeed
	end
	return nil
end

function Wraith.TerrorRadius(kdata)
	if kdata.Power.Cloaked then
		return 0
	end
	return DEF.TerrorRadius
end

-- Фонарик проявляет Призрака
function Wraith.OnBlind(kdata)
	local p = kdata.Power
	if p.Cloaked or p.Transition == "Cloaking" then
		p.Transition = nil
		kdata.PowerBusy = false
		setCloaked(kdata, false)
		kdata.Player:SetAttribute("PowerState", "Visible")
		State.notifyAll("Призрак проявлен светом!", State.YELLOW)
	end
end

function Wraith.OnStun(kdata)
	local p = kdata.Power
	if p.Transition then
		p.Transition = nil
		kdata.PowerBusy = false
		kdata.Player:SetAttribute("PowerState", p.Cloaked and "Cloaked" or "Visible")
	end
end

function Wraith.OnHit(kdata, _sdata)
	if State.now() - (kdata.Power.UncloakedAt or 0) < 2 then
		Scoring.add(kdata.Player, "Deviousness", 500, "Внезапный удар")
	end
end

function Wraith.Cleanup(kdata)
	setCloaked(kdata, false)
end

return Wraith
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="79">
        <Properties>
          <string name="Name">Systems</string>
        </Properties>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">Carry</string>
            <string name="Source"><![CDATA[-- Подъём, перенос на плече, вырывание, крюки, Сущность и жертвоприношение.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Actions = require(Core.Actions)
local Lifecycle = require(Core.Lifecycle)
local Scoring = require(Core.Scoring)
local Characters = require(Core.Characters)
local PropFX = require(script.Parent.Parent.Map.PropFX)

local Carry = {}

local function killerScale(kdata): number
	local char = kdata.Player.Character
	local ok, s = pcall(function()
		return char:GetScale()
	end)
	return ok and s or 1
end

------------------------------------------------------------------------
-- Перенос
------------------------------------------------------------------------

function Carry.startCarry(kdata, sdata)
	local kroot = State.getRoot(kdata.Player)
	local sroot = State.getRoot(sdata.Player)
	local shum = State.getHumanoid(sdata.Player)
	local schar = sdata.Player.Character
	if not kroot or not sroot or not shum or not schar then
		return
	end
	Lifecycle.detach(sdata)
	Actions.cancel(sdata)
	sdata.Status = "Carried"
	sdata.CarriedBy = kdata
	sdata.Wiggle = 0
	kdata.Carrying = sdata
	sdata.SavedMassless = {}
	for _, d in schar:GetDescendants() do
		if d:IsA("BasePart") then
			sdata.SavedMassless[d] = d.Massless
			d.Massless = true
		end
	end
	Characters.setCollision(schar, Characters.GROUP_CARRIED)
	shum.PlatformStand = true
	sroot.Anchored = false
	local s = killerScale(kdata)
	-- Тело лежит на правом плече животом вниз, голова за спиной маньяка
	sroot.CFrame = kroot.CFrame
		* CFrame.new(1.4 * s, 1.7 * s, 0.6 * s)
		* CFrame.Angles(math.rad(90), 0, 0)
		* CFrame.Angles(0, math.pi, 0)
	sdata.CarryWeld = Util.weld(kroot, sroot)
	pcall(function()
		sroot:SetNetworkOwner(kdata.Player)
	end)
	State.playAnim(kdata.Player, "Pickup")
	State.sfx("Rustle", kroot)
	State.notifyAll(sdata.Player.DisplayName .. " схвачен маньяком!", State.RED)
	Scoring.add(kdata.Player, "Hunter", 200, "Поднял")
end

function Carry.release(sdata)
	local kdata = sdata.CarriedBy
	if kdata then
		kdata.Carrying = nil
	end
	sdata.CarriedBy = nil
	if sdata.CarryWeld then
		sdata.CarryWeld:Destroy()
		sdata.CarryWeld = nil
	end
	local char = sdata.Player.Character
	if not char then
		return
	end
	for part, massless in sdata.SavedMassless or {} do
		if part.Parent then
			part.Massless = massless
		end
	end
	sdata.SavedMassless = nil
	Characters.setCollision(char)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.PlatformStand = false
	end
	local sroot = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local kroot = kdata and State.getRoot(kdata.Player)
	if sroot and kroot then
		local look = kroot.CFrame.LookVector * Vector3.new(1, 0, 1)
		local pos = kroot.Position + look.Unit * 3
		sroot.CFrame = CFrame.lookAt(pos, pos + look)
	end
	if sroot then
		pcall(function()
			sroot:SetNetworkOwner(sdata.Player)
		end)
	end
end

-- Выживший вырвался (сам, паллетой или фонариком)
function Carry.escape(sdata, scoreLabel: string?)
	Carry.release(sdata)
	sdata.Status = "Playing"
	sdata.Health = 1
	sdata.Wiggle = 0
	sdata.BoostUntil = State.now() + Config.SurvivorHitBoostTime
	State.notifyAll(sdata.Player.DisplayName .. " вырвался из рук маньяка!", State.GREEN)
	Scoring.add(sdata.Player, "Survival", 1000, scoreLabel or "Вырвался")
end

------------------------------------------------------------------------
-- Крюки
------------------------------------------------------------------------

local function clearEntity(hook: Instance?)
	if hook and hook:IsA("Model") then
		PropFX.entity(hook, false)
	end
end

local function summonEntity(hook: Model)
	if not hook:FindFirstChild("EntityLegs") then
		PropFX.entity(hook, true)
		State.sfx("EntityDrone", hook:FindFirstChild("HangPoint", true))
	end
end

function Carry.sacrifice(sdata)
	if sdata.Sacrificing then
		return
	end
	sdata.Sacrificing = true
	local hook = sdata.Hook
	if hook then
		summonEntity(hook)
	end
	State.playAnim(sdata.Player, "Entity")
	local root = State.getRoot(sdata.Player)
	if root then
		State.sfx("Scream", root)
	end
	local killer = State.Killer and State.Killer.Player
	Scoring.add(killer, "Sacrifice", 2000, "Жертвоприношение")
	task.delay(1.6, function()
		local r = State.getRoot(sdata.Player)
		if r and State.Map then
			local fx = Instance.new("Part")
			fx.Anchored = true
			fx.CanCollide = false
			fx.CanQuery = false
			fx.Shape = Enum.PartType.Ball
			fx.Material = Enum.Material.Neon
			fx.Color = Color3.fromRGB(255, 60, 20)
			fx.Size = Vector3.new(2, 2, 2)
			fx.CFrame = r.CFrame
			fx.Parent = State.Map.Effects
			TweenService:Create(fx, TweenInfo.new(1.4), { Size = Vector3.new(14, 14, 14), Transparency = 1 }):Play()
			Debris:AddItem(fx, 1.5)
			TweenService:Create(r, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				CFrame = r.CFrame + Vector3.new(0, 30, 0),
			}):Play()
		end
		task.delay(1.1, function()
			clearEntity(hook)
			Lifecycle.remove(sdata, "Dead", sdata.Player.DisplayName .. " принесён в жертву Сущности", State.RED)
		end)
	end)
end

function Carry.hang(kdata, hook: Model)
	local sdata = kdata.Carrying
	if not sdata then
		return
	end
	Carry.release(sdata)
	local sroot = State.getRoot(sdata.Player)
	local hp = hook:FindFirstChild("HangPoint") :: BasePart?
	if not sroot or not hp then
		sdata.Status = "Playing"
		return
	end
	sdata.Status = "Hooked"
	sdata.Hook = hook
	sdata.HookTimer = 0
	sdata.HookCount += 1
	sdata.BleedOut = 0
	sdata.Health = 0
	hook:SetAttribute("Occupant", sdata.Player.UserId)
	sroot.Anchored = true
	sroot.CFrame = hp.CFrame
	State.sfx("HookImpale", hp)
	State.sfx("Scream", hp)
	State.playAnim(sdata.Player, "HookScream")
	Scoring.add(kdata.Player, "Sacrifice", 1000, "Повешен на крюк")
	if sdata.HookCount >= Config.MaxHooks then
		Carry.sacrifice(sdata)
	else
		if sdata.HookCount >= 2 then
			summonEntity(hook)
		end
		State.notifyAll(string.format("%s на крюке! (стадия %d)", sdata.Player.DisplayName, sdata.HookCount), State.RED)
	end
end

function Carry.unhook(sdata, rescuer: Player)
	local hook = sdata.Hook
	local sroot = State.getRoot(sdata.Player)
	if hook then
		hook:SetAttribute("Occupant", 0)
		clearEntity(hook)
	end
	sdata.Hook = nil
	sdata.Status = "Playing"
	sdata.Health = 1
	sdata.HealProgress = 0
	sdata.HookTimer = 0
	sdata.BoostUntil = State.now() + 1.5
	if sroot then
		sroot.Anchored = false
		local hp = hook and hook:FindFirstChild("HangPoint") :: BasePart?
		if hp then
			sroot.CFrame = hp.CFrame * CFrame.new(0, -4, -3)
		end
	end
	State.playAnim(rescuer, "Flinch")
	State.notifyAll(rescuer.DisplayName .. " снял(а) " .. sdata.Player.DisplayName .. " с крюка", State.GREEN)
	Scoring.add(rescuer, "Altruism", 1500, "Спасение")
end

------------------------------------------------------------------------
-- Действия
------------------------------------------------------------------------

local function isCloaked(kdata): boolean
	return kdata.Power ~= nil and (kdata.Power.Cloaked == true or kdata.Power.Transition ~= nil)
end

Actions.register("Pickup", {
	Validate = function(data, target)
		if not target:IsA("Player") or data.Carrying or isCloaked(data) then
			return false
		end
		local td = State.get(target :: Player)
		return td ~= nil
			and td.Role == "Survivor"
			and td.Status == "Playing"
			and not td.Hidden
			and (td.Health == 0 or td.Trapped ~= nil)
			and State.now() >= td.VaultUntil
	end,
	Begin = function(data, target)
		Carry.startCarry(data, State.get(target :: Player))
	end,
})

Actions.register("Hook", {
	AllowCarrying = true,
	Validate = function(data, target)
		return data.Carrying ~= nil and target:GetAttribute("Kind") == "Hook" and target:GetAttribute("Occupant") == 0
	end,
	Complete = function(data, target)
		Carry.hang(data, target :: Model)
	end,
})

Actions.register("Unhook", {
	Validate = function(data, target)
		if not target:IsA("Player") then
			return false
		end
		local td = State.get(target :: Player)
		return td ~= nil and td ~= data and td.Status == "Hooked" and not td.Sacrificing
	end,
	Complete = function(data, target)
		local td = State.get(target :: Player)
		if td and td.Status == "Hooked" and not td.Sacrificing then
			Carry.unhook(td, data.Player)
		end
	end,
})

------------------------------------------------------------------------
-- Цикл
------------------------------------------------------------------------

function Carry.update(dt: number)
	local t = State.now()
	for _, data in State.Participants do
		if data.Role ~= "Survivor" then
			continue
		end
		if data.Status == "Hooked" and not data.Sacrificing then
			data.HookTimer += dt
			if data.HookTimer >= Config.HookStageTime then
				data.HookTimer = 0
				data.HookCount += 1
				if data.HookCount >= Config.MaxHooks then
					Carry.sacrifice(data)
				else
					if data.Hook then
						summonEntity(data.Hook)
					end
					State.notifyAll(data.Player.DisplayName .. " борется с Сущностью!", State.RED)
				end
			end
		elseif data.Status == "Carried" then
			data.Wiggle += dt / Config.WiggleTime
			if data.Wiggle >= 1 then
				local kdata = data.CarriedBy
				Carry.escape(data)
				if kdata then
					kdata.StunnedUntil = t + 3
					State.playAnim(kdata.Player, "Stun")
				end
			end
		end
	end
end

-- Освобождение при выбывании/выходе
Lifecycle.addDetach(function(data)
	if data.CarriedBy then
		Carry.release(data)
	end
	if data.Carrying then
		local carried = data.Carrying
		Carry.release(carried)
		carried.Status = "Playing"
	end
	if data.Hook then
		data.Hook:SetAttribute("Occupant", 0)
		clearEntity(data.Hook)
		data.Hook = nil
		local root = State.getRoot(data.Player)
		if root then
			root.Anchored = false
		end
	end
end)

return Carry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">Chase</string>
            <string name="Source"><![CDATA[-- Погоня: маньяк видит бегущего рядом выжившего -> музыка погони и очки.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Scoring = require(Core.Scoring)
local Combat = require(script.Parent.Combat)

local Chase = {}

local timer = 0
local GRACE = 2.5

function Chase.update(dt: number)
	timer += dt
	if timer < 0.25 then
		return
	end
	local step = timer
	timer = 0
	local k = State.Killer
	local kroot = k and State.getRoot(k.Player)
	local t = State.now()
	local anyChase = false
	for _, data in State.survivors() do
		local inChase = false
		local root = State.getRoot(data.Player)
		if kroot and root and k.Status == "Playing" and data.Status == "Playing" and not data.Hidden then
			local offset = (root.Position - kroot.Position) * Vector3.new(1, 0, 1)
			local d = offset.Magnitude
			if d <= Config.ChaseDistance and d > 0.1 then
				local facing = kroot.CFrame.LookVector:Dot(offset.Unit)
				local fleeing = data.Player:GetAttribute("Running") == true or d < 12
				if facing > 0.3 and fleeing and Combat.lineOfSight(kroot.Position, root.Position) then
					inChase = true
				end
			end
		end
		if inChase then
			data.ChaseUntil = t + GRACE
		end
		local chased = t < (data.ChaseUntil or 0) and data.Status == "Playing"
		data.Chase = chased
		data.Player:SetAttribute("Chase", chased)
		if chased then
			anyChase = true
			Scoring.add(data.Player, "Boldness", 20 * step, nil)
			if k then
				Scoring.add(k.Player, "Hunter", 15 * step, nil)
			end
		end
	end
	if k then
		k.Player:SetAttribute("Chase", anyChase)
	end
end

return Chase
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">Combat</string>
            <string name="Source"><![CDATA[-- Атака маньяка (выпад), оглушение паллетой и ослепление фонариком.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Actions = require(Core.Actions)
local Health = require(script.Parent.Health)
local Carry = require(script.Parent.Carry)
local Powers = require(script.Parent.Parent.Powers)

local Combat = {}

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
raycastParams.RespectCanCollide = true

-- Исключаем персонажей и мелкий декор при проверке прямой видимости
function Combat.lineOfSight(from: Vector3, to: Vector3): boolean
	local exclude = {}
	for p in State.Participants do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	if State.Map then
		table.insert(exclude, State.Map.Effects)
		table.insert(exclude, State.Map.Traps)
		table.insert(exclude, State.Map.Crows)
	end
	raycastParams.FilterDescendantsInstances = exclude
	return workspace:Raycast(from, to - from, raycastParams) == nil
end

local function tryHit(kdata): boolean
	local kroot = State.getRoot(kdata.Player)
	if not kroot then
		return false
	end
	local forward = kroot.CFrame.LookVector * Vector3.new(1, 0, 1)
	if forward.Magnitude < 0.01 then
		return false
	end
	forward = forward.Unit
	-- Бьём ближайшего выжившего перед собой (а не первого попавшегося)
	local best, bestDist = nil, math.huge
	for _, sdata in State.survivors() do
		local sroot = State.getRoot(sdata.Player)
		if sdata.Status == "Playing" and not sdata.Hidden and sdata.Health > 0 and sroot then
			local offset = sroot.Position - kroot.Position
			local flat = offset * Vector3.new(1, 0, 1)
			local d = flat.Magnitude
			if d < bestDist and d <= Config.AttackRange * (kdata.Scale or 1) and (d < 1 or forward:Dot(flat.Unit) >= 0.3) then
				if Combat.lineOfSight(kroot.Position, sroot.Position) then
					best, bestDist = sdata, d
				end
			end
		end
	end
	if best then
		Health.damage(best, "M1")
		Powers.call(kdata, "OnHit", best)
		return true
	end
	return false
end

function Combat.onAttack(player: Player)
	local data = State.get(player)
	if not State.Active or not data or data.Role ~= "Killer" then
		return
	end
	local t = State.now()
	if not Actions.canAct(data) or data.Action or t < data.AttackReadyAt then
		return
	end
	if Powers.call(data, "CanAttack") == false then
		return
	end
	data.Lunging = true
	data.LungeUntil = t + Config.KillerLungeTime
	data.AttackReadyAt = math.huge
	State.playAnim(player, "Swing")
	local root = State.getRoot(player)
	if root then
		State.sfx("Swing", root)
	end
end

-- Оглушение (паллета). Маньяк роняет выжившего.
function Combat.stun(duration: number)
	local kdata = State.Killer
	if not kdata or kdata.Status ~= "Playing" then
		return
	end
	kdata.StunnedUntil = State.now() + duration
	kdata.Lunging = false
	kdata.AttackReadyAt = State.now() + duration
	Actions.cancel(kdata)
	Powers.call(kdata, "OnStun")
	if kdata.Carrying then
		Carry.escape(kdata.Carrying, "Спасение паллетой")
	end
	State.playAnim(kdata.Player, "Stun")
	State.effect(kdata.Player, "Stun", duration)
	State.notify(kdata.Player, "Оглушён!", State.YELLOW)
end

-- Ослепление (фонарик)
function Combat.blind(duration: number): boolean
	local kdata = State.Killer
	if not kdata or kdata.Status ~= "Playing" or State.now() < kdata.BlindUntil then
		return false
	end
	kdata.BlindUntil = State.now() + duration
	kdata.Lunging = false
	kdata.AttackReadyAt = math.max(kdata.AttackReadyAt, State.now() + 0.5)
	Actions.cancel(kdata)
	Powers.call(kdata, "OnBlind")
	if kdata.Carrying then
		Carry.escape(kdata.Carrying, "Спасение фонариком")
	end
	State.playAnim(kdata.Player, "Blind")
	State.effect(kdata.Player, "Blind", duration)
	State.notify(kdata.Player, "Ослеплён!", State.YELLOW)
	return true
end

function Combat.update(_dt: number)
	local k = State.Killer
	if not k or not k.Lunging then
		return
	end
	local t = State.now()
	if tryHit(k) then
		k.Lunging = false
		k.SlowUntil = t + Config.AttackCooldownHit
		k.AttackReadyAt = t + Config.AttackCooldownHit
		State.playAnim(k.Player, "Wipe")
	elseif t >= k.LungeUntil then
		k.Lunging = false
		k.SlowUntil = t + Config.AttackCooldownMiss
		k.AttackReadyAt = t + Config.AttackCooldownMiss
	end
end

Remotes.Attack.OnServerEvent:Connect(Combat.onAttack)

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">Crows</string>
            <string name="Source"><![CDATA[-- Вороны: взлетают, когда рядом пробегает выживший, и выдают его маньяку.
local TweenService = game:GetService("TweenService")

local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Templates = require(script.Parent.Parent.Map.Art.Templates)

local Crows = {}

local crows = {}
local spots = {}
local timer = 0
local rng = Random.new()

local COUNT = 12

local function spawnCrow()
	if #spots == 0 or not State.Map then
		return
	end
	local spot = spots[rng:NextInteger(1, #spots)]
	local cf = spot * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	local model = Templates.spawn("Crow", cf, State.Map.Crows, rng)
	table.insert(crows, { Model = model, Pos = cf.Position })
end

local function flyAway(crow)
	local model = crow.Model
	local pivot = model:GetPivot()
	local dir = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1))
	if dir.Magnitude < 0.1 then
		dir = Vector3.new(1, 0, 0)
	end
	local target = pivot.Position + dir.Unit * 40 + Vector3.new(0, 30, 0)
	local value = Instance.new("CFrameValue")
	value.Value = pivot
	value.Changed:Connect(function(cf)
		if model.Parent then
			model:PivotTo(cf)
		end
	end)
	local tw = TweenService:Create(value, TweenInfo.new(2.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Value = CFrame.lookAt(target, target + dir),
	})
	tw.Completed:Connect(function()
		value:Destroy()
		model:Destroy()
	end)
	tw:Play()
	State.sfx("Crow", pivot.Position)
	State.sfx("Flutter", pivot.Position)
	State.noise(pivot.Position)
	task.delay(25, function()
		if State.Active then
			spawnCrow()
		end
	end)
end

function Crows.setup()
	table.clear(crows)
	spots = State.Map and State.Map.CrowSpots or {}
	for _ = 1, COUNT do
		spawnCrow()
	end
end

function Crows.update(dt: number)
	timer += dt
	if timer < 0.2 then
		return
	end
	timer = 0
	local positions = {}
	for _, data in State.Participants do
		if data.Role == "Survivor" and data.Status == "Playing" and not data.Hidden then
			local root = State.getRoot(data.Player)
			if root then
				table.insert(positions, { root.Position, data.Player:GetAttribute("Running") == true })
			end
		end
	end
	for i = #crows, 1, -1 do
		local crow = crows[i]
		if not crow.Model.Parent then
			table.remove(crows, i)
			continue
		end
		for _, p in positions do
			local d = (p[1] - crow.Pos).Magnitude
			if d < 2.5 or (p[2] and d < 8) then
				table.remove(crows, i)
				flyAway(crow)
				break
			end
		end
	end
end

return Crows
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">Exits</string>
            <string name="Source"><![CDATA[-- Ворота, обрушение Сущности (эндгейм) и люк.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Actions = require(Core.Actions)
local Lifecycle = require(Core.Lifecycle)
local Scoring = require(Core.Scoring)
local PropFX = require(script.Parent.Parent.Map.PropFX)

local Exits = {}

function Exits.startEndgame(text: string?)
	if State.EndgameDeadline then
		return
	end
	State.EndgameDeadline = State.now() + Config.EndGameCollapseTime
	State.setGame("EndGame", true)
	State.sfx("EntityDrone", nil)
	if text then
		State.notifyAll(text, State.YELLOW)
	end
end

function Exits.powerGates()
	if State.GatesPowered or not State.Map then
		return
	end
	State.GatesPowered = true
	State.setGame("GensLeft", 0)
	for _, gate in State.Map.ExitGates:GetChildren() do
		gate:SetAttribute("Powered", true)
		PropFX.gatePowered(gate)
	end
	State.sfx("GatePowered", nil)
	State.notifyAll("Все генераторы починены! Ворота запитаны — открывайте их!", State.YELLOW)
end

local function openGate(gate: Model, opener: Player?)
	gate:SetAttribute("Progress", 1)
	gate:SetAttribute("Open", true)
	PropFX.gateOpen(gate)
	local sw = gate:FindFirstChild("Switch", true)
	State.sfx("GateOpen", sw)
	if opener then
		Scoring.add(opener, "Objectives", 1250, "Ворота открыты")
	end
	if State.EndgameDeadline then
		State.notifyAll("Вторые ворота открыты!", State.YELLOW)
	else
		Exits.startEndgame("Ворота открыты! Обрушение Сущности началось — бегите!")
	end
end

local function setSiren(gate: Model, on: boolean)
	PropFX.gateSiren(gate, on)
end

Actions.register("OpenGate", {
	Validate = function(_data, target)
		return target:GetAttribute("Kind") == "ExitGate" and target:GetAttribute("Powered") == true and not target:GetAttribute("Open")
	end,
	Begin = function(_data, target)
		setSiren(target :: Model, true)
	end,
	Tick = function(data, target, dt)
		local p = (target:GetAttribute("Progress") :: number) + dt / Config.OpenGateTime
		if p >= 1 then
			Actions.cancel(data)
			openGate(target :: Model, data.Player)
		else
			target:SetAttribute("Progress", p)
			PropFX.gateProgress(target :: Model, p)
		end
	end,
	Progress = function(_data, target)
		return target:GetAttribute("Progress") :: number
	end,
})

------------------------------------------------------------------------
-- Люк
------------------------------------------------------------------------

local function isHatch(target: Instance): boolean
	return target:GetAttribute("Kind") == "Hatch"
end

Actions.register("JumpHatch", {
	Validate = function(_data, target)
		return isHatch(target) and target:GetAttribute("Open") == true
	end,
	Begin = function(data, target)
		State.sfx("Vault", (target :: Model).PrimaryPart)
		Scoring.add(data.Player, "Survival", 7000, "Побег через люк")
		Lifecycle.remove(data, "Escaped", data.Player.DisplayName .. " сбежал через люк!", State.GREEN)
	end,
})

Actions.register("CloseHatch", {
	Validate = function(_data, target)
		return isHatch(target) and target:GetAttribute("Open") == true
	end,
	Complete = function(data, target)
		target:SetAttribute("Open", false)
		target:SetAttribute("Closed", true)
		PropFX.hatch(target :: Model, false)
		State.sfx("Clank", (target :: Model).PrimaryPart)
		Scoring.add(data.Player, "Hunter", 1000, "Люк закрыт")
		Exits.powerGates()
		Exits.startEndgame("Маньяк закрыл люк! Обрушение Сущности началось.")
	end,
})

------------------------------------------------------------------------
-- Цикл
------------------------------------------------------------------------

function Exits.update(_dt: number)
	local map = State.Map
	if not map then
		return
	end
	local t = State.now()

	-- Побег через открытые ворота
	for _, data in State.survivors() do
		if data.Status ~= "Playing" then
			continue
		end
		local root = State.getRoot(data.Player)
		if not root then
			continue
		end
		for _, gate in map.ExitGates:GetChildren() do
			local zone = gate:FindFirstChild("EscapeZone") :: BasePart?
			if gate:GetAttribute("Open") and zone then
				local rel = zone.CFrame:PointToObjectSpace(root.Position)
				local half = zone.Size / 2
				if math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y + 2 and math.abs(rel.Z) <= half.Z then
					Scoring.add(data.Player, "Survival", 5000, "Побег")
					Lifecycle.remove(data, "Escaped", data.Player.DisplayName .. " сбежал!", State.GREEN)
					break
				end
			end
		end
	end

	-- Люк открывается, когда остался один выживший
	local hatch = map.Hatch
	if hatch and not State.SoloTest and not hatch:GetAttribute("Open") and not hatch:GetAttribute("Closed") then
		local earned = State.InitialSurvivors >= 2 or State.GensDone >= 2
		if earned and State.remainingSurvivors() == 1 and not State.EndgameDeadline then
			hatch:SetAttribute("Open", true)
			PropFX.hatch(hatch, true)
			State.sfx("Clank", hatch.PrimaryPart)
			for _, data in State.survivors() do
				if State.isInGame(data) then
					State.notify(data.Player, "Ты остался один. Люк открылся — найди его по звуку ветра!", State.YELLOW)
				end
			end
		end
	end

	-- Обрушение
	if State.EndgameDeadline then
		local left = State.EndgameDeadline - t
		State.setGame("EndGameTimer", math.max(math.ceil(left), 0))
		if left <= 0 then
			for _, data in State.survivors() do
				if State.isInGame(data) then
					Lifecycle.remove(data, "Dead", data.Player.DisplayName .. " забран Сущностью", State.RED)
				end
			end
		end
	end
end

return Exits
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">Generators</string>
            <string name="Source"><![CDATA[-- Генераторы: ремонт, проверки навыка, повреждение маньяком, Проклятие «Руина».
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Actions = require(Core.Actions)
local Scoring = require(Core.Scoring)
local Exits = require(script.Parent.Exits)
local PropFX = require(script.Parent.Parent.Map.PropFX)

local Generators = {}

local lastRepair = {} :: { [Instance]: number }

-- Бонус ящика с инструментами (тратит заряд)
local function toolboxBonus(data, dt: number): number
	if data.Item == "Toolbox" and (data.ItemCharges or 0) > 0 then
		data.ItemCharges -= dt
		data.Player:SetAttribute("ItemCharges", math.max(data.ItemCharges, 0))
		if data.ItemCharges <= 0 then
			Generators.onItemEmpty(data)
		end
		return Config.ToolboxBonus
	end
	return 0
end
Generators.onItemEmpty = function(_data) end -- подменяется Items


function Generators.setProgress(gen: Model, p: number)
	gen:SetAttribute("Progress", p)
	PropFX.genProgress(gen, p)
end

local function completeGenerator(gen: Model)
	Generators.setProgress(gen, 1)
	gen:SetAttribute("Done", true)
	gen:SetAttribute("Regressing", false)
	PropFX.genDone(gen)
	State.GensDone += 1
	State.sfx("GenDone", nil)
	State.sfx("Clank", gen.PrimaryPart)
	for _, data in State.Participants do
		if data.Action and data.Action.Target == gen then
			Actions.cancel(data)
			Scoring.add(data.Player, "Objectives", 1250, "Генератор починен")
		end
	end
	local left = math.max(Config.GeneratorsRequired - State.GensDone, 0)
	State.setGame("GensLeft", left)
	if left > 0 then
		State.notifyAll("Генератор починен! Осталось: " .. left, State.YELLOW)
	else
		Exits.powerGates()
	end
end

local function explode(gen: Model)
	PropFX.genExplode(gen)
	local body = gen.PrimaryPart
	if body then
		State.sfx("GenExplode", body)
		State.noise(body.Position)
	end
end

local function isGen(target: Instance): boolean
	return target:GetAttribute("Kind") == "Generator"
end

Actions.register("Repair", {
	SkillChecks = true,
	Validate = function(_data, target)
		return isGen(target) and not target:GetAttribute("Done") and not State.GatesPowered
	end,
	Begin = function(_data, target)
		target:SetAttribute("Regressing", false)
	end,
	Tick = function(data, target, dt)
		local rate = (1 + toolboxBonus(data, dt)) / Config.GeneratorRepairTime
		local p = (target:GetAttribute("Progress") :: number) + dt * rate
		lastRepair[target] = State.now()
		Scoring.add(data.Player, "Objectives", dt * rate * 1250, nil)
		if p >= 1 then
			completeGenerator(target :: Model)
		else
			Generators.setProgress(target :: Model, p)
		end
	end,
	Progress = function(_data, target)
		return target:GetAttribute("Progress") :: number
	end,
	OnSkillCheck = function(data, target, result)
		local p = target:GetAttribute("Progress") :: number
		if result == "great" then
			Generators.setProgress(target :: Model, math.min(p + Config.SkillCheckGreatBonus, 0.999))
			Scoring.add(data.Player, "Objectives", 100, "Отличная проверка")
		elseif result == "good" then
			Scoring.add(data.Player, "Objectives", 50, nil)
		else
			Generators.setProgress(target :: Model, math.max(p - Config.SkillCheckFailPenalty, 0))
			explode(target :: Model)
			State.effect(data.Player, "Shake", 0.5)
			State.notify(data.Player, "Генератор взорвался! Маньяк услышал шум.", State.RED)
		end
	end,
})

Actions.register("Kick", {
	Validate = function(_data, target)
		return isGen(target)
			and not target:GetAttribute("Done")
			and not State.GatesPowered
			and (target:GetAttribute("Progress") :: number) > 0
			and not target:GetAttribute("Regressing")
	end,
	Complete = function(data, target)
		local p = math.max((target:GetAttribute("Progress") :: number) - Config.GeneratorKickRegression, 0)
		Generators.setProgress(target :: Model, p)
		target:SetAttribute("Regressing", p > 0)
		State.sfx("Clank", (target :: Model).PrimaryPart)
		explode(target :: Model)
		Scoring.add(data.Player, "Brutality", 100, "Повреждение генератора")
	end,
})

function Generators.update(dt: number)
	local map = State.Map
	if not map or State.GatesPowered then
		return
	end
	local t = State.now()
	for _, gen in map.Generators:GetChildren() do
		if gen:GetAttribute("Done") then
			continue
		end
		local p = gen:GetAttribute("Progress") :: number
		local beingRepaired = t - (lastRepair[gen] or 0) < 0.2
		if p > 0 and not beingRepaired then
			local rate = 0
			if gen:GetAttribute("Regressing") then
				rate += Config.GeneratorRegressPerSecond
			end
			if State.HexRuin then
				rate += Config.RuinRegressPerSecond
			end
			if rate > 0 then
				p = math.max(p - rate * dt, 0)
				Generators.setProgress(gen :: Model, p)
				if p <= 0 then
					gen:SetAttribute("Regressing", false)
				end
			end
		end
	end
end

function Generators.reset()
	table.clear(lastRepair)
end

return Generators
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">Health</string>
            <string name="Source"><![CDATA[-- Здоровье выживших: удары, повержение, лечение, истекание кровью.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage.Shared.Config)
local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Actions = require(Core.Actions)
local Lifecycle = require(Core.Lifecycle)
local Scoring = require(Core.Scoring)

local Health = {}

local function bloodBurst(part: BasePart)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(150, 0, 0))
	emitter.Size = NumberSequence.new(0.5, 0)
	emitter.Speed = NumberRange.new(6, 14)
	emitter.SpreadAngle = Vector2.new(60, 60)
	emitter.Lifetime = NumberRange.new(0.4, 0.9)
	emitter.Acceleration = Vector3.new(0, -35, 0)
	emitter.Enabled = false
	emitter.Parent = part
	emitter:Emit(35)
	Debris:AddItem(emitter, 2)
end

-- source: "M1" | "Hatchet" | "Trap"
function Health.damage(sdata, source: string)
	Actions.cancel(sdata)
	sdata.HealProgress = 0
	local root = State.getRoot(sdata.Player)
	if source == "Trap" then
		sdata.Health = math.max(sdata.Health - 1, 1)
	else
		sdata.Health -= 1
	end
	if root then
		bloodBurst(root)
		State.sfx("Hit", root)
	end
	State.playAnim(sdata.Player, "Flinch")
	State.effect(sdata.Player, "Shake", 0.6)
	local killer = State.Killer and State.Killer.Player
	if sdata.Health >= 1 then
		if source ~= "Trap" then
			sdata.BoostUntil = State.now() + Config.SurvivorHitBoostTime
		end
		if root then
			State.sfx("Pain", root)
		end
		State.notify(sdata.Player, "Тебя ранили! Беги!", State.RED)
		Scoring.add(killer, "Brutality", 300, "Удар")
	else
		sdata.Health = 0
		sdata.BleedOut = 0
		if root then
			State.sfx("Scream", root)
		end
		State.notifyAll(sdata.Player.DisplayName .. " повержен!", State.RED)
		Scoring.add(killer, "Brutality", 500, "Повержен")
	end
end

Actions.register("Heal", {
	SkillChecks = true,
	Validate = function(data, target)
		if not target:IsA("Player") then
			return false
		end
		local td = State.get(target :: Player)
		return td ~= nil
			and td ~= data
			and td.Role == "Survivor"
			and td.Status == "Playing"
			and td.Health < 2
			and not td.Hidden
			and not td.Trapped
			and State.now() >= td.VaultUntil
	end,
	Tick = function(data, target, dt)
		local td = State.get(target :: Player)
		td.HealProgress += dt / Config.HealTime
		td.HealedAt = State.now()
		if td.HealProgress >= 1 then
			td.HealProgress = 0
			td.Health += 1
			Actions.cancel(data)
			if td.Health == 1 then
				State.notify(td.Player, "Тебя подняли!", State.GREEN)
				Scoring.add(data.Player, "Altruism", 1250, "Подъём")
			else
				State.notify(td.Player, "Ты полностью вылечен", State.GREEN)
				Scoring.add(data.Player, "Altruism", 1000, "Лечение")
			end
		end
	end,
	Progress = function(_data, target)
		local td = State.get(target :: Player)
		return td and td.HealProgress
	end,
	OnSkillCheck = function(data, target, result)
		local td = State.get(target :: Player)
		if not td then
			return
		end
		if result == "great" then
			td.HealProgress = math.min(td.HealProgress + Config.SkillCheckGreatBonus, 0.999)
			Scoring.add(data.Player, "Altruism", 50, "Отличная проверка")
		elseif result == "fail" then
			td.HealProgress = math.max(td.HealProgress - Config.SkillCheckFailPenalty, 0)
			local root = State.getRoot(td.Player)
			if root then
				State.noise(root.Position)
				State.sfx("Pain", root)
			end
			State.notify(data.Player, "Провал! Маньяк услышал крик.", State.RED)
		end
	end,
})

function Health.update(dt: number)
	local t = State.now()
	for _, data in State.Participants do
		if data.Role == "Survivor" and data.Status == "Playing" and data.Health == 0 then
			if t - (data.HealedAt or 0) > 0.25 then
				data.BleedOut += dt
				if data.BleedOut >= Config.BleedOutTime then
					Lifecycle.remove(data, "Dead", data.Player.DisplayName .. " истёк кровью", State.RED)
				end
			end
		end
	end
end

return Health
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">Items</string>
            <string name="Source"><![CDATA[-- Сундуки и предметы: аптечка, ящик с инструментами, фонарик.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local ItemDefs = require(ReplicatedStorage.Shared.ItemDefs)
local Util = require(ReplicatedStorage.Shared.Util)
local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Actions = require(Core.Actions)
local Lifecycle = require(Core.Lifecycle)
local Scoring = require(Core.Scoring)
local PropFX = require(script.Parent.Parent.Map.PropFX)
local ItemArt = require(script.Parent.Parent.Map.Art.Items)
local Combat = require(script.Parent.Combat)
local Generators = require(script.Parent.Generators)

local Items = {}

local rng = Random.new()

local function rollItem(): string
	local total = 0
	for _, w in Config.ChestItemWeights do
		total += w
	end
	local r = rng:NextNumber(0, total)
	for name, w in Config.ChestItemWeights do
		r -= w
		if r <= 0 then
			return name
		end
	end
	return "Medkit"
end

local function removeModel(data)
	if data.ItemModel then
		data.ItemModel:Destroy()
		data.ItemModel = nil
	end
end

-- Предмет в руке (виден всем); модель — в Art/Items
local function buildModel(data, item: string)
	removeModel(data)
	local char = data.Player.Character
	local arm = char and char:FindFirstChild("Right Arm") :: BasePart?
	if not arm then
		return
	end
	local m = ItemArt.held(item, arm)
	m.Parent = char
	data.ItemModel = m
end

function Items.give(data, item: string)
	data.Item = item
	data.ItemCharges = ItemDefs[item].Charges
	data.ItemActive = false
	data.Player:SetAttribute("Item", item)
	data.Player:SetAttribute("ItemCharges", data.ItemCharges)
	data.Player:SetAttribute("ItemMax", data.ItemCharges)
	data.Player:SetAttribute("ItemActive", false)
	buildModel(data, item)
end

function Items.remove(data)
	if data.Item then
		State.notify(data.Player, ItemDefs[data.Item].Name .. " закончился", State.WHITE)
	end
	data.Item = nil
	data.ItemCharges = 0
	data.ItemActive = false
	data.Player:SetAttribute("Item", nil)
	data.Player:SetAttribute("ItemCharges", nil)
	data.Player:SetAttribute("ItemActive", nil)
	removeModel(data)
end
Generators.onItemEmpty = Items.remove

local function setFlashlight(data, on: boolean)
	data.ItemActive = on
	data.Player:SetAttribute("ItemActive", on)
	local beam = data.ItemModel and data.ItemModel:FindFirstChild("Beam", true) :: SpotLight?
	if beam then
		beam.Enabled = on
	end
	if data.ItemModel then
		State.sfx("Click", data.ItemModel)
	end
end

Actions.register("OpenChest", {
	Validate = function(_data, target)
		return target:GetAttribute("Kind") == "Chest" and not target:GetAttribute("Opened")
	end,
	Begin = function(_data, target)
		State.sfx("Chest", (target :: Model).PrimaryPart)
	end,
	Complete = function(data, target)
		if target:GetAttribute("Opened") then
			return
		end
		target:SetAttribute("Opened", true)
		PropFX.chestOpen(target :: Model)
		local item = rollItem()
		Items.give(data, item)
		State.notify(data.Player, "Ты нашёл: " .. ItemDefs[item].Name .. ". " .. ItemDefs[item].Hint, State.YELLOW)
		Scoring.add(data.Player, "Objectives", 250, "Сундук открыт")
	end,
})

Actions.register("SelfHeal", {
	SkillChecks = true,
	Validate = function(data, _target)
		return data.Item == "Medkit" and (data.ItemCharges or 0) > 0 and data.Health == 1
	end,
	Tick = function(data, _target, dt)
		data.HealProgress += dt / Config.MedkitHealTime
		data.ItemCharges -= dt
		data.Player:SetAttribute("ItemCharges", math.max(data.ItemCharges, 0))
		if data.HealProgress >= 1 then
			data.HealProgress = 0
			data.Health = 2
			Actions.cancel(data)
			State.notify(data.Player, "Ты вылечился аптечкой", State.GREEN)
			Scoring.add(data.Player, "Survival", 500, "Самолечение")
		end
		if data.ItemCharges <= 0 then
			Actions.cancel(data)
			Items.remove(data)
		end
	end,
	Progress = function(data, _target)
		return data.HealProgress
	end,
	OnSkillCheck = function(data, _target, result)
		if result == "great" then
			data.HealProgress = math.min(data.HealProgress + Config.SkillCheckGreatBonus, 0.999)
		elseif result == "fail" then
			data.HealProgress = math.max(data.HealProgress - Config.SkillCheckFailPenalty, 0)
			local root = State.getRoot(data.Player)
			if root then
				State.noise(root.Position)
				State.sfx("Pain", root)
			end
		end
	end,
})

Remotes.UseItem.OnServerEvent:Connect(function(player, isDown, aim)
	local data = State.get(player)
	if not State.Active or not data or data.Role ~= "Survivor" or not data.Item then
		return
	end
	if typeof(aim) == "Vector3" and aim.Magnitude > 0.5 and aim.Magnitude < 1.5 then
		data.ItemAim = aim.Unit
	end
	if data.Item == "Medkit" then
		if isDown == true then
			Actions.start(data, "SelfHeal", player)
		elseif data.Action and data.Action.Kind == "SelfHeal" then
			Actions.cancel(data)
		end
	elseif data.Item == "Flashlight" then
		local on = isDown == true and data.Status == "Playing" and data.Health > 0 and not data.Hidden
		if on ~= data.ItemActive then
			setFlashlight(data, on)
		end
	end
end)

-- Фонарик: светим в лицо маньяку
function Items.update(dt: number)
	local k = State.Killer
	local khead = k and k.Player.Character and k.Player.Character:FindFirstChild("Head") :: BasePart?
	local kroot = k and State.getRoot(k.Player)
	for _, data in State.Participants do
		if data.Item ~= "Flashlight" or not data.ItemActive then
			continue
		end
		if data.Status ~= "Playing" or data.Health <= 0 or data.Hidden or data.Action then
			setFlashlight(data, false)
			continue
		end
		data.ItemCharges -= dt
		data.Player:SetAttribute("ItemCharges", math.max(data.ItemCharges, 0))
		if data.ItemCharges <= 0 then
			Items.remove(data)
			continue
		end
		local shead = data.Player.Character and data.Player.Character:FindFirstChild("Head") :: BasePart?
		local hit = false
		if khead and kroot and shead and k.Status == "Playing" then
			local toKiller = khead.Position - shead.Position
			local dist = toKiller.Magnitude
			local aim = data.ItemAim or shead.CFrame.LookVector
			if dist <= Config.FlashlightRange and dist > 0.1 then
				local angle = math.deg(math.acos(math.clamp(aim:Dot(toKiller.Unit), -1, 1)))
				local facing = kroot.CFrame.LookVector:Dot(-toKiller.Unit)
				if angle <= Config.FlashlightAngle and facing > 0.4 and Combat.lineOfSight(shead.Position, khead.Position) then
					hit = true
				end
			end
		end
		if hit then
			data.BlindAccum = (data.BlindAccum or 0) + dt
			if data.BlindAccum >= Config.FlashlightBlindTime then
				data.BlindAccum = 0
				if Combat.blind(Config.BlindDuration) then
					Scoring.add(data.Player, "Boldness", 1250, "Ослепление")
				end
			end
		else
			data.BlindAccum = math.max((data.BlindAccum or 0) - dt * 0.5, 0)
		end
	end
end

Lifecycle.addDetach(function(data)
	if data.ItemActive then
		setFlashlight(data, false)
	end
end)

function Items.cleanup(data)
	removeModel(data)
end

return Items
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">Lockers</string>
            <string name="Source"><![CDATA[-- Шкафчики: спрятаться, выйти, обыскать (маньяк хватает выжившего).
local TweenService = game:GetService("TweenService")

local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Actions = require(Core.Actions)
local Lifecycle = require(Core.Lifecycle)
local Scoring = require(Core.Scoring)
local PropFX = require(script.Parent.Parent.Map.PropFX)
local Carry = require(script.Parent.Carry)
local Powers = require(script.Parent.Parent.Powers)

local Lockers = {}

-- Открыть и закрыть дверь (анимация на сервере, видят все)
local function swingDoor(locker: Model, holdTime: number)
	PropFX.swingLockerDoor(locker, holdTime, function()
		if locker.Parent then
			State.sfx("LockerDoor", locker.PrimaryPart)
		end
	end)
end

local function insideCF(locker: Model): CFrame?
	local inside = locker:FindFirstChild("Inside") :: BasePart?
	return inside and inside.CFrame
end

local function moveRoot(root: BasePart, target: CFrame, duration: number)
	local tw = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Quad), { CFrame = target })
	tw:Play()
end

-- Вытащить игрока из шкафчика без анимации входа/выхода
local function freeFromLocker(data, moveOut: boolean)
	local locker = data.Hidden
	if not locker then
		return
	end
	data.Hidden = nil
	data.Player:SetAttribute("Hidden", nil)
	locker:SetAttribute("Occupant", 0)
	local root = State.getRoot(data.Player)
	local cf = insideCF(locker)
	if root then
		if moveOut and cf then
			root.CFrame = cf * CFrame.new(0, 0, -2.8)
		end
		root.Anchored = false
	end
end

Actions.register("EnterLocker", {
	Validate = function(data, target)
		return target:GetAttribute("Kind") == "Locker" and target:GetAttribute("Occupant") == 0 and not data.Hidden
	end,
	Begin = function(data, target)
		local locker = target :: Model
		local root = State.getRoot(data.Player)
		local cf = insideCF(locker)
		if not root or not cf then
			return
		end
		local fast = data.Sprinting
		local duration = fast and 0.35 or 0.7
		locker:SetAttribute("Occupant", data.Player.UserId)
		data.Hidden = locker
		data.Player:SetAttribute("Hidden", true)
		data.VaultUntil = State.now() + duration
		root.Anchored = true
		moveRoot(root, cf, duration)
		swingDoor(locker, duration - 0.1)
		if fast then
			State.noise(cf.Position)
		end
	end,
})

Actions.register("ExitLocker", {
	AllowHidden = true,
	Validate = function(data, target)
		return data.Hidden == target
	end,
	Begin = function(data, target)
		local locker = target :: Model
		local root = State.getRoot(data.Player)
		local cf = insideCF(locker)
		data.Hidden = nil
		data.Player:SetAttribute("Hidden", nil)
		locker:SetAttribute("Occupant", 0)
		data.VaultUntil = State.now() + 0.6
		swingDoor(locker, 0.4)
		if root and cf then
			moveRoot(root, cf * CFrame.new(0, 0, -2.8), 0.5)
			task.delay(0.55, function()
				if root.Parent and data.Status == "Playing" and not data.Hidden and not data.Trapped then
					root.Anchored = false
				end
			end)
		elseif root then
			root.Anchored = false
		end
	end,
})

Actions.register("SearchLocker", {
	Validate = function(_data, target)
		return target:GetAttribute("Kind") == "Locker"
	end,
	Begin = function(_data, target)
		swingDoor(target :: Model, 0.8)
	end,
	Complete = function(data, target)
		local occupantId = target:GetAttribute("Occupant") :: number
		if occupantId ~= 0 then
			for _, sdata in State.Participants do
				if sdata.Hidden == target and sdata.Status == "Playing" then
					freeFromLocker(sdata, true)
					sdata.Health = 0
					Carry.startCarry(data, sdata)
					State.notifyAll(sdata.Player.DisplayName .. " вытащен из шкафчика!", State.RED)
					Scoring.add(data.Player, "Deviousness", 1000, "Вытащил из шкафчика")
					return
				end
			end
		end
		Powers.call(data, "OnLockerSearched")
	end,
})

Lifecycle.addDetach(function(data)
	if data.Hidden then
		freeFromLocker(data, true)
	end
end)

return Lockers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">Obstacles</string>
            <string name="Source"><![CDATA[-- Паллеты и перелезание через окна/паллеты.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Actions = require(Core.Actions)
local Scoring = require(Core.Scoring)
local Combat = require(script.Parent.Combat)
local PropFX = require(script.Parent.Parent.Map.PropFX)

local Obstacles = {}

-- Плавно двигает модель паллеты (сервер, короткий твин)

local function obstacleCFrame(target: Instance): CFrame?
	local kind = target:GetAttribute("Kind")
	if kind == "Pallet" then
		return target:GetAttribute("DropCFrame") :: CFrame
	elseif kind == "Window" and target:IsA("BasePart") then
		return target.CFrame
	end
	return nil
end

Actions.register("DropPallet", {
	Validate = function(_data, target)
		return target:GetAttribute("Kind") == "Pallet" and target:GetAttribute("State") == "Up"
	end,
	Begin = function(data, target)
		local pallet = target :: Model
		local dropCF = pallet:GetAttribute("DropCFrame") :: CFrame
		pallet:SetAttribute("State", "Dropped")
		PropFX.palletDrop(pallet)
		State.playAnim(data.Player, "PalletDrop")
		task.delay(0.22, function()
			State.sfx("PalletSlam", dropCF.Position)
		end)
		local k = State.Killer
		if k and k.Status == "Playing" then
			local kroot = State.getRoot(k.Player)
			if kroot then
				local rel = dropCF:PointToObjectSpace(kroot.Position)
				if math.abs(rel.X) < 3.5 and math.abs(rel.Z) < 2.4 then
					-- маньяк стоял прямо под паллетой — отталкиваем на его сторону
					local side = rel.Z >= 0 and 1 or -1
					local w = dropCF:PointToWorldSpace(Vector3.new(rel.X, 0, side * 2.8))
					kroot.CFrame = CFrame.new(w.X, kroot.Position.Y, w.Z) * kroot.CFrame.Rotation
				end
				if State.flatDist(kroot.Position, dropCF.Position) <= Config.PalletStunRange then
					Combat.stun(Config.PalletStunTime)
					Scoring.add(data.Player, "Boldness", 1000, "Оглушение паллетой")
				end
			end
		end
	end,
})

Actions.register("Break", {
	Validate = function(_data, target)
		return target:GetAttribute("Kind") == "Pallet" and target:GetAttribute("State") == "Dropped"
	end,
	Complete = function(data, target)
		target:SetAttribute("State", "Broken")
		local pos = (target :: Model):GetPivot().Position
		State.sfx("PalletBreak", pos)
		PropFX.palletBreak(target :: Model, State.Map and State.Map.Effects)
		Scoring.add(data.Player, "Brutality", 100, "Паллета сломана")
	end,
})

Actions.register("Vault", {
	Validate = function(data, target)
		local kind = target:GetAttribute("Kind")
		if data.Carrying then
			return false
		end
		if kind == "Window" then
			return true
		end
		return kind == "Pallet" and data.Role == "Survivor" and target:GetAttribute("State") == "Dropped"
	end,
	Begin = function(data, target)
		local root = State.getRoot(data.Player)
		local ocf = obstacleCFrame(target)
		if not root or not ocf then
			return
		end
		local rel = ocf:PointToObjectSpace(root.Position)
		local side = rel.Z >= 0 and 1 or -1
		local x = math.clamp(rel.X, -1.2, 1.2)
		local y = root.Position.Y
		local function at(z: number): Vector3
			local w = ocf:PointToWorldSpace(Vector3.new(x, 0, z))
			return Vector3.new(w.X, y, w.Z)
		end
		local mid = at(0) + Vector3.new(0, 2.2, 0)
		local finish = at(-side * 3.4)
		local dir = (finish - root.Position) * Vector3.new(1, 0, 1)
		if dir.Magnitude < 0.1 then
			return
		end
		dir = dir.Unit
		local duration
		if data.Role == "Killer" then
			duration = 1.6
			State.playAnim(data.Player, "KillerVault")
		else
			duration = data.Sprinting and 0.55 or 0.95
			-- длительность клипа должна совпасть с перемещением: быстрый прыжок или шагом
			State.playAnim(data.Player, data.Sprinting and "Vault" or "VaultWalk")
			if data.Sprinting then
				-- быстрый прыжок шумит
				State.noise(root.Position)
				State.sfx("Vault", root)
				if data.Chase then
					Scoring.add(data.Player, "Boldness", 100, "Прыжок")
				end
			end
		end
		data.VaultUntil = State.now() + duration
		Actions.cancel(data)
		root.Anchored = true
		task.spawn(function()
			local info = TweenInfo.new(duration / 2, Enum.EasingStyle.Linear)
			local t1 = TweenService:Create(root, info, { CFrame = CFrame.lookAt(mid, mid + dir) })
			t1:Play()
			t1.Completed:Wait()
			local t2 = TweenService:Create(root, info, { CFrame = CFrame.lookAt(finish, finish + dir) })
			t2:Play()
			t2.Completed:Wait()
			if root.Parent and data.Status == "Playing" and not data.Hidden and not data.Trapped then
				root.Anchored = false
			end
		end)
	end,
})

return Obstacles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">Totems</string>
            <string name="Source"><![CDATA[-- Тотемы: очистка выжившими, проклятый тотем включает Проклятие «Руина».
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Core = script.Parent.Parent.Core
local State = require(Core.State)
local Actions = require(Core.Actions)
local Scoring = require(Core.Scoring)
local PropFX = require(script.Parent.Parent.Map.PropFX)

local Totems = {}

local function cleanse(totem: Model, by: Player)
	totem:SetAttribute("Cleansed", true)
	totem:SetAttribute("Progress", 1)
	PropFX.totemCleansed(totem)
	State.sfx("Rustle", totem.PrimaryPart)
	if totem:GetAttribute("Hex") then
		State.HexRuin = false
		State.setGame("HexRuin", false)
		State.sfx("EntityDrone", totem.PrimaryPart)
		State.notifyAll("Проклятие «Руина» снято!", State.GREEN)
		Scoring.add(by, "Objectives", 1500, "Проклятый тотем очищен")
	else
		Scoring.add(by, "Objectives", 1000, "Тотем очищен")
	end
end

Actions.register("Cleanse", {
	Validate = function(_data, target)
		return target:GetAttribute("Kind") == "Totem" and not target:GetAttribute("Cleansed")
	end,
	Tick = function(data, target, dt)
		local p = (target:GetAttribute("Progress") :: number) + dt / Config.CleanseTime
		if p >= 1 then
			Actions.cancel(data)
			cleanse(target :: Model, data.Player)
		else
			target:SetAttribute("Progress", p)
		end
	end,
	Progress = function(_data, target)
		return target:GetAttribute("Progress") :: number
	end,
})

function Totems.setup()
	local hex = false
	if State.Map then
		for _, totem in State.Map.Totems:GetChildren() do
			if totem:GetAttribute("Hex") then
				hex = true
			end
		end
	end
	State.HexRuin = hex
	State.setGame("HexRuin", hex)
	if hex and State.Killer then
		State.notify(State.Killer.Player, "Проклятие «Руина» активно: генераторы сами откатываются", State.RED)
	end
end

return Totems
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="91">
    <Properties>
      <string name="Name">SoundService</string>
      <token name="AmbientReverb">0</token>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="92">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="93">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="94">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">Animator</string>
            <string name="Source"><![CDATA[-- Процедурные анимации R6 для всех персонажей.
-- Motor6D.Transform не реплицируется, поэтому каждый клиент анимирует всех сам,
-- по реплицированным атрибутам (состояние, действие, одноразовые анимации AnimSeq).
-- Поза (Anim/Poses) -> пружины суставов (Anim/Driver) -> Motor6D.Transform.
-- Здесь же считаются параметры движения для походки: ускорение, поворот, усталость, дыхание.
-- LOD: дальние персонажи обновляются реже, далеко за кадром — не обновляются вовсе
-- (пружины решаются точно при любом шаге, так что редкие обновления не ломают позу).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local UserInputService = game:GetService("UserInputService")

local Anim = ReplicatedStorage.Shared.Anim
local Rig = require(Anim.Rig)
local Poses = require(Anim.Poses)
local Clip = require(Anim.Clip)
local Driver = require(Anim.Driver)
local Util = require(ReplicatedStorage.Shared.Util)
local Audio = require(script.Parent.Audio)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Animator = {}

local TAU = math.pi * 2
local exp, clamp = math.exp, math.clamp
local FLAT = Vector3.new(1, 0, 1)

-- Уровни детализации: до Full стадов — каждый кадр, дальше — с интервалом.
-- На телефонах (сенсор без клавиатуры) дистанции короче.
local MOBILE = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
local LOD_K = MOBILE and 0.6 or 1
local LOD = {
	MaxDistance = 260 * LOD_K, -- дальше не анимируем
	Full = 35 * LOD_K,
	Steps = { { 75 * LOD_K, 1 / 30 }, { 150 * LOD_K, 1 / 15 }, { math.huge, 1 / 8 } },
	OffscreenNear = 18, -- за кадром ближе этого — раз в 0.1 с (тени, край экрана)
	OffscreenInterval = 0.1,
	SnapAfter = 0.5, -- после такого перерыва поза ставится сразу, без пружин
}

-- Cut — момент отмены: слой не обрывается, а плавно уходит за CUT_FADE
type Shot = { Name: string, Def: any, Start: number, Cut: number? }

local CUT_FADE = 0.22 -- с: плавная отмена одноразовой анимации (Cancel)
local ACTION_FADE_IN = 0.3 -- с: вход в действие (присесть к генератору и т.п.)
local ACTION_FADE_OUT = 0.25 -- с: выход из действия

type Entry = {
	Char: Model,
	Driver: Driver.Driver?,
	Phase: number,
	Breath: number,
	Step: number,
	Seq: number,
	Shot: Shot?,
	LocalShot: { Name: string, At: number }?,
	Vel: Vector3?,
	Yaw: number?,
	Fwd: Vector3,
	AccelF: number,
	AccelS: number,
	TurnRate: number,
	Exertion: number,
	Seed: number,
	Pending: number,
	Pose: { [string]: any },
	Concealed: boolean?,
	Action: string?, -- текущее действие и когда оно началось (клипы действий идут от начала)
	ActionStart: number,
	PrevAction: string?, -- закончившееся действие, пока его слой плавно уходит
	PrevStart: number,
	PrevEnd: number,
	RunAt: number, -- когда последний раз бежал (быстрый прыжок через окно)
}

-- Спрятавшийся в шкафчике шире шкафчика: другим игрокам его не видно (как в DBD)
-- Снимаем только своё скрытие (= 1): Effects.updateCloak (RenderStepped, раньше нас в кадре)
-- мог уже поставить свою прозрачность — маньяк вытащил из шкафчика: Hidden и Status = Carried
-- приходят вместе, и обнуление здесь навсегда перебило бы его 0.75 (он кэширует значение).
local function conceal(entry: Entry, on: boolean)
	if (entry.Concealed or false) == on then
		return
	end
	entry.Concealed = on
	for _, d in entry.Char:GetDescendants() do
		if d:IsA("BasePart") or d:IsA("Decal") then
			local v = d :: any
			if on then
				v.LocalTransparencyModifier = 1
			elseif v.LocalTransparencyModifier == 1 then
				v.LocalTransparencyModifier = 0
			end
		end
	end
end

local entries = {} :: { [Model]: Entry }

local function register(char: Instance)
	if not char:IsA("Model") or entries[char] then
		return
	end
	local entry: Entry = {
		Char = char,
		Driver = nil,
		Phase = 0,
		Breath = math.random() * TAU,
		Step = 0,
		Seq = char:GetAttribute("AnimSeq") or 0,
		Shot = nil,
		LocalShot = nil,
		Vel = nil,
		Yaw = nil,
		Fwd = Vector3.new(0, 0, -1),
		AccelF = 0,
		AccelS = 0,
		TurnRate = 0,
		Exertion = 0,
		Seed = math.random(),
		-- случайный сдвиг, чтобы редко обновляемые персонажи не считались в одном кадре
		Pending = math.random() * 0.1,
		Pose = {},
		ActionStart = 0,
		PrevStart = 0,
		PrevEnd = 0,
		RunAt = -math.huge,
	}
	entries[char] = entry
	char.Destroying:Connect(function()
		entries[char] = nil
	end)
end

CollectionService:GetInstanceAddedSignal("DBDChar"):Connect(register)
CollectionService:GetInstanceRemovedSignal("DBDChar"):Connect(function(char)
	entries[char :: Model] = nil
end)
for _, char in CollectionService:GetTagged("DBDChar") do
	register(char)
end

local function startShot(entry: Entry, name: string, t: number)
	if name == "Cancel" then
		local shot = entry.Shot
		if shot and not shot.Cut then
			shot.Cut = t
		end
		return
	end
	local def = Poses.OneShot[name]
	if def then
		entry.Shot = { Name = name, Def = def, Start = t }
	end
end

-- Мгновенно проиграть анимацию у своего персонажа (не ждать сервер)
function Animator.playLocal(name: string)
	local char = player.Character
	local entry = char and entries[char]
	if entry then
		startShot(entry, name, os.clock())
		entry.LocalShot = { Name = name, At = os.clock() }
	end
end

local function findKillerRoot(): BasePart?
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("Role") == "Killer" then
			return Util.getRoot(p)
		end
	end
	return nil
end

local function wrapAngle(a: number): number
	return (a + math.pi) % TAU - math.pi
end

-- Скорость, ускорение, поворот, усталость, дыхание
local function trackMotion(entry: Entry, root: BasePart, dt: number, vel: Vector3, isKiller: boolean, injured: boolean)
	local look = root.CFrame.LookVector * FLAT
	if look.Magnitude > 0.2 then
		entry.Fwd = look.Unit
	end
	local fwd = entry.Fwd
	local yaw = math.atan2(-fwd.X, -fwd.Z)
	local h = math.max(dt, 1 / 240)
	if entry.Vel and entry.Yaw and dt < LOD.SnapAfter then
		local acc = (vel - entry.Vel) / h
		local right = Vector3.new(-fwd.Z, 0, fwd.X)
		local k = 1 - exp(-dt / 0.15)
		entry.AccelF += (clamp(acc:Dot(fwd), -150, 150) - entry.AccelF) * k
		entry.AccelS += (clamp(acc:Dot(right), -150, 150) - entry.AccelS) * k
		local turn = clamp(wrapAngle(yaw - entry.Yaw) / h, -12, 12)
		entry.TurnRate += (turn - entry.TurnRate) * (1 - exp(-dt / 0.12))
	else
		entry.AccelF, entry.AccelS, entry.TurnRate = 0, 0, 0
	end
	entry.Vel, entry.Yaw = vel, yaw
	local speed = vel.Magnitude
	entry.Exertion = clamp(entry.Exertion + (speed > 12 and dt / 8 or -dt / 14), 0, 1)
	local hz = (0.28 + 0.45 * entry.Exertion + (injured and 0.2 or 0)) * (isKiller and 0.8 or 1)
	entry.Breath = (entry.Breath + TAU * hz * dt) % (TAU * 64)
end

local function choosePose(entry: Entry, t: number, dt: number, killerRoot: BasePart?)
	local char = entry.Char
	local owner = Players:GetPlayerFromCharacter(char)
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local driver = entry.Driver
	if not hum or not root or not driver then
		return nil
	end
	local function attr(name: string): any
		return owner and owner:GetAttribute(name)
	end
	local role = char:GetAttribute("Role")
	local isKiller = role == "Killer"
	local status = attr("Status")
	local health = attr("Health") or 2
	local crouching = attr("Crouching") == true
	local vel = root.Anchored and Vector3.zero or root.AssemblyLinearVelocity * FLAT
	local speed = vel.Magnitude
	local injured = health == 1 and not isKiller
	trackMotion(entry, root, dt, vel, isKiller, injured)

	-- Голова поворачивается к маньяку
	local lookYaw = 0
	if not isKiller and killerRoot and status == "Playing" then
		local rel = root.CFrame:PointToObjectSpace(killerRoot.Position)
		if rel.Magnitude < 30 then
			lookYaw = clamp(math.deg(math.atan2(-rel.X, -rel.Z)), -70, 70)
		end
	end

	local fwd, side = 1, 0
	if speed > 0.5 then
		local dir = vel / speed
		fwd = dir:Dot(entry.Fwd)
		side = dir:Dot(Vector3.new(-entry.Fwd.Z, 0, entry.Fwd.X))
	end
	local p: Poses.Params = {
		Speed = speed,
		Phase = entry.Phase,
		Injured = injured,
		Crouching = crouching,
		Killer = isKiller,
		Carrying = attr("Carrying") == true,
		Wiggle = attr("Wiggle"),
		Struggle = (attr("HookCount") or 0) >= 2,
		LookYaw = lookYaw,
		KillerType = char:GetAttribute("KillerType"),
		Scale = driver.Rig.Scale,
		Forward = fwd,
		Strafe = side,
		AccelForward = entry.AccelF,
		AccelSide = entry.AccelS,
		TurnRate = entry.TurnRate,
		Exertion = entry.Exertion,
		Breath = entry.Breath,
		Seed = entry.Seed,
	}

	-- Фаза шага и звуки шагов (касание стопы — каждые π)
	entry.Phase += Poses.stepRate(speed, crouching, p) * dt
	p.Phase = entry.Phase
	local step = math.floor(entry.Phase / math.pi)
	if step ~= entry.Step then
		entry.Step = step
		local grounded = Audio.floorMaterial(char) ~= nil
		if speed > 1.5 and grounded and status ~= "Hooked" and status ~= "Carried" and health > 0 then
			Audio.footstep(char, isKiller, speed, crouching)
		end
	end

	conceal(entry, char ~= player.Character and attr("Hidden") == true)
	if attr("Running") then
		entry.RunAt = t
	end

	local base
	local action = attr("ActionName")
	local locomotion = false
	if status == "Hooked" then
		base = Poses.State.Hooked(t, p)
	elseif status == "Carried" then
		base = Poses.State.Carried(t, p)
	elseif attr("Hidden") then
		base = Poses.State.Hidden(t, p)
	elseif attr("Trapped") and action ~= "EscapeTrap" then
		base = Poses.State.Trapped(t, p)
	elseif not isKiller and status == "Playing" and health == 0 then
		base = Poses.State.Crawl(t, p)
	elseif hum.Sit then
		base = Poses.State.Sit(t, p)
	else
		base = Poses.locomotion(t, p)
		locomotion = true
	end
	-- своя таблица позы: слои кладутся в неё, не трогая возвращённые позы
	local pose = Clip.copy(base, entry.Pose)
	-- действие: клип идёт от начала действия, слой плавно входит и плавно уходит
	if action ~= entry.Action then
		if entry.Action and Poses.Action[entry.Action] then
			entry.PrevAction, entry.PrevStart, entry.PrevEnd = entry.Action, entry.ActionStart, t
		end
		entry.Action, entry.ActionStart = action, t
	end
	if locomotion then
		local prev = entry.PrevAction
		if prev then
			local k = (t - entry.PrevEnd) / ACTION_FADE_OUT
			if k >= 1 then
				entry.PrevAction = nil
			else
				Clip.layer(pose, Poses.Action[prev](t - entry.PrevStart, p), Clip.Ease.SineInOut(1 - k))
			end
		end
		local actionPose = action and Poses.Action[action]
		if actionPose then
			local e = t - entry.ActionStart
			Clip.layer(pose, actionPose(e, p), Clip.Ease.SineInOut(math.min(e / ACTION_FADE_IN, 1)))
		end
		if attr("Item") == "Flashlight" and attr("ItemActive") then
			pose.RArm = Poses.A(92 + math.sin(t * 3) * 2, 0, 4)
		end
	end

	-- Одноразовая анимация поверх (с плавным входом/выходом, если они заданы)
	local seq = char:GetAttribute("AnimSeq") or 0
	if seq ~= entry.Seq then
		entry.Seq = seq
		local name = char:GetAttribute("Anim")
		local loc = entry.LocalShot
		if not (loc and loc.Name == name and os.clock() - loc.At < 0.5) and typeof(name) == "string" then
			-- сервер шлёт одно имя на разные длительности (прыжок с бега/шагом, колокол)
			startShot(entry, Poses.shotVariant(name, t - entry.RunAt < 0.4, attr("PowerState")), t)
		end
	end
	local stiffness = 1
	local shot = entry.Shot
	if shot then
		local def = shot.Def
		local elapsed = t - shot.Start
		if not shot.Cut and shot.Name == "Windup" and attr("PowerCharge") == 0 and elapsed > 0.3 then
			shot.Cut = t
		end
		local cut = shot.Cut and (t - shot.Cut) / CUT_FADE or 0
		if elapsed >= def.Duration or cut >= 1 then
			entry.Shot = nil
		else
			stiffness = Poses.applyShot(pose, def, elapsed, p, 1 - Clip.Ease.SineInOut(cut))
		end
	end
	return pose, stiffness
end

-- Как часто обновлять персонажа: 0 — каждый кадр, nil — не обновлять
local function lodInterval(pos: Vector3, scale: number, camCF: CFrame, halfFov: number): number?
	local rel = pos - camCF.Position
	local dist = rel.Magnitude
	if dist > LOD.MaxDistance then
		return nil
	end
	local radius = 4 * scale
	if dist > radius then
		local angle = math.acos(clamp(rel:Dot(camCF.LookVector) / dist, -1, 1))
		if angle > halfFov + math.asin(radius / dist) then
			return dist < LOD.OffscreenNear and LOD.OffscreenInterval or nil
		end
	end
	if dist < LOD.Full then
		return 0
	end
	for _, s in LOD.Steps do
		if dist < s[1] then
			return s[2]
		end
	end
	return nil
end

-- Половина угла обзора по диагонали экрана (с запасом — персонаж «у края» тоже виден)
local function halfFov(): number
	local vp = camera.ViewportSize
	local aspect = (vp and vp.Y > 0) and vp.X / vp.Y or 16 / 9
	local tanV = math.tan(math.rad(camera.FieldOfView) / 2)
	return math.atan(tanV * math.sqrt(1 + aspect * aspect))
end

local function update(entry: Entry, t: number, dt: number, killerRoot: BasePart?)
	if not entry.Driver then
		local rig = Rig.find(entry.Char)
		if not rig then
			return
		end
		entry.Driver = Driver.new(rig)
	end
	local driver = entry.Driver :: Driver.Driver
	local pose, stiffness = choosePose(entry, t, dt, killerRoot)
	if not pose then
		return
	end
	if dt > LOD.SnapAfter then
		Driver.snap(driver)
	end
	if not Driver.apply(driver, pose, dt, stiffness) then
		entry.Driver = nil
	end
end

RunService.PreSimulation:Connect(function(dt)
	local t = os.clock()
	local camCF = camera.CFrame
	local fov = halfFov()
	local killerRoot = findKillerRoot()
	local own = player.Character
	for char, entry in entries do
		if not char.Parent then
			continue
		end
		local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			continue
		end
		entry.Pending += dt
		local scale = entry.Driver and entry.Driver.Rig.Scale or 1
		local interval = if char == own then 0 else lodInterval(root.Position, scale, camCF, fov)
		if interval and entry.Pending >= interval then
			local edt = entry.Pending
			entry.Pending = 0
			update(entry, t, edt, killerRoot)
		end
	end
end)

return Animator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[-- Звук на клиенте.
--  * Микшер: SoundGroup Master -> SFX / Ambience / Music / Voice / UI с эквалайзером, ревербом
--    и компрессором; приглушение атмосферы в погоне, «глухой» звук из шкафчика.
--  * Одноразовые звуки (Audio.play): варианты без повторов подряд, разброс высоты и громкости,
--    отсев слишком далёких, предел одновременных звуков (на телефоне меньше), уборка за собой.
--  * Петли «по требованию» (want): существуют, только пока нужны в этом кадре, плавно
--    появляются и затухают — атмосфера, радиус ужаса, погоня, генераторы, дыхание, костёр.
--  * Найденные сервером звуки библиотеки сначала проверяются (ContentProvider:PreloadAsync,
--    IsLoaded); не загрузился — слот навсегда переходит на встроенный синтез.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Sounds = require(ReplicatedStorage.Shared.Sounds)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)

local player = Players.LocalPlayer
local Audio = {}

local MOBILE = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
local MAX_SOUNDS = if MOBILE then Config.MaxSoundsMobile else Config.MaxSounds

------------------------------------------------------------------------
-- Микшер
------------------------------------------------------------------------

-- Группы и их эффекты (свойства эффектов Roblox). Громкости — Config.SoundGroupVolumes.
-- Реверберация леса — в группах (SoundService.AmbientReverb выключен), поэтому музыка и интерфейс сухие.
local MIX = {
	{
		Name = "Master",
		Compressor = { Threshold = -16, Ratio = 3, Attack = 0.005, Release = 0.25, GainMakeup = 2 },
		-- Динамики телефона не тянут низы: убираем гул, поднимаем середину
		Equalizer = if MOBILE then { LowGain = -5, MidGain = 2, HighGain = 0 } else nil,
	},
	{
		Name = "SFX",
		Parent = "Master",
		Equalizer = { LowGain = 1, MidGain = 0, HighGain = 0 },
		Reverb = { DecayTime = 1.8, Density = 0.7, Diffusion = 0.8, DryLevel = 0, WetLevel = -12 },
	},
	{
		Name = "Ambience",
		Parent = "Master",
		Equalizer = { LowGain = -2, MidGain = -3, HighGain = -4 },
		Reverb = { DecayTime = 3, Density = 1, Diffusion = 1, DryLevel = 0, WetLevel = -14 },
	},
	{
		Name = "Music",
		Parent = "Master",
		Equalizer = { LowGain = 0, MidGain = -2, HighGain = -1 },
		Compressor = { Threshold = -20, Ratio = 2, Attack = 0.02, Release = 0.4, GainMakeup = 0 },
	},
	{
		Name = "Voice",
		Parent = "Master",
		Equalizer = { LowGain = -3, MidGain = 2, HighGain = 0 },
		Reverb = { DecayTime = 1.4, Density = 0.8, Diffusion = 0.8, DryLevel = 0, WetLevel = -16 },
	},
	{ Name = "UI", Parent = "Master" },
} :: { { [string]: any } }

-- Группы, которые глушатся, когда выживший в шкафчике (музыка и сердце — «в голове», их не глушим)
local MUFFLED = { SFX = true, Ambience = true, Voice = true }

Audio.Groups = {} :: { [string]: SoundGroup }
local groupEq: { [string]: EqualizerSoundEffect } = {}
local baseHighGain: { [string]: number } = {}

for _, spec in MIX do
	local parent: Instance = if spec.Parent then Audio.Groups[spec.Parent] else SoundService
	local group = parent:FindFirstChild(spec.Name) :: SoundGroup?
	if not (group and group:IsA("SoundGroup")) then
		local g = Instance.new("SoundGroup")
		g.Name = spec.Name
		for _, class in { "Equalizer", "Compressor", "Reverb" } do
			local props = spec[class]
			if props then
				local effect = Instance.new(class .. "SoundEffect") :: any
				for k, v in props do
					effect[k] = v
				end
				effect.Parent = g
			end
		end
		g.Parent = parent
		group = g
	end
	local g = group :: SoundGroup
	g.Volume = Config.SoundGroupVolumes[spec.Name] or 1
	Audio.Groups[spec.Name] = g
	local eq = g:FindFirstChildOfClass("EqualizerSoundEffect")
	if eq then
		groupEq[spec.Name] = eq
		baseHighGain[spec.Name] = eq.HighGain
	end
end

------------------------------------------------------------------------
-- Создание звуков
------------------------------------------------------------------------

local function addEffects(sound: Sound, fx: Sounds.Effects?)
	if not fx then
		return
	end
	if fx.Distortion then
		local d = Instance.new("DistortionSoundEffect")
		d.Level = fx.Distortion
		d.Parent = sound
	end
	if fx.Echo then
		local e = Instance.new("EchoSoundEffect")
		e.Delay = fx.Echo[1]
		e.Feedback = fx.Echo[2]
		e.WetLevel = -6
		e.Parent = sound
	end
	if fx.LowPass or fx.HighPass then
		local cut = fx.LowPass or 0
		local eq = Instance.new("EqualizerSoundEffect")
		eq.HighGain = -cut
		eq.MidGain = -cut * 0.3
		eq.LowGain = (if fx.LowPass then 3 else 0) - (fx.HighPass or 0)
		eq.Parent = sound
	end
	if fx.Tremolo then
		local t = Instance.new("TremoloSoundEffect")
		t.Frequency = fx.Tremolo[1]
		t.Depth = fx.Tremolo[2]
		t.Duty = fx.Tremolo[3] or 0.5
		t.Parent = sound
	end
	if fx.Reverb then
		local r = Instance.new("ReverbSoundEffect")
		r.DecayTime = fx.Reverb[1]
		r.WetLevel = fx.Reverb[2]
		r.Parent = sound
	end
	if fx.Octave then
		local p = Instance.new("PitchShiftSoundEffect")
		p.Octave = fx.Octave
		p.Parent = sound
	end
end

local function newSound(layer: Sounds.Layer, def: Sounds.Def, parent: Instance, looped: boolean): Sound
	local s = Instance.new("Sound")
	s.Name = def.Name
	s.SoundId = layer.Id
	s.Looped = looped
	s.PlaybackSpeed = layer.Speed
	if layer.Start then
		s.TimePosition = layer.Start
	end
	s.SoundGroup = Audio.Groups[def.Group]
	if def.MaxDistance then
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = def.MinDistance or 6
		s.RollOffMaxDistance = def.MaxDistance
	end
	addEffects(s, layer.Effects)
	s.Parent = parent
	return s
end

local function listenerPosition(): Vector3
	local cam = workspace.CurrentCamera
	return if cam then cam.CFrame.Position else Vector3.zero
end

local function near(pos: Vector3, range: number): boolean
	return (pos - listenerPosition()).Magnitude <= range
end

-- Где звучит: деталь/вложение (звук едет вместе с ней) или точка в мире
local function locate(where: any): (Instance?, Vector3?)
	if typeof(where) == "Vector3" then
		return nil, where
	elseif typeof(where) ~= "Instance" then
		return nil, nil
	end
	local inst: Instance? = where
	if (where :: Instance):IsA("Model") then
		local m = where :: Model
		inst = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
	end
	if inst and inst:IsA("BasePart") then
		return inst, (inst :: BasePart).Position
	elseif inst and inst:IsA("Attachment") then
		return inst, (inst :: Attachment).WorldPosition
	end
	return nil, nil
end

------------------------------------------------------------------------
-- Проверка загрузки найденных звуков
------------------------------------------------------------------------

type Loop = {
	Name: string,
	Where: Instance?,
	Resolved: Sounds.Resolved,
	Sounds: { Sound },
	Base: { number }, -- громкость слоя
	Speeds: { number }, -- скорость слоя
	Gain: number,
	Target: number,
	Speed: number,
	Seen: number,
	Clock: number, -- мелодия: время до следующей ноты
	Note: number,
}
local loops: { [string]: { [Instance]: Loop } } = {}
local refreshLoops: () -> ()

-- Первый запуск каждого ID библиотеки: если звук так и не загрузился — больше его не берём
local watched: { [string]: boolean } = {}
local function watchLoad(s: Sound)
	local id = s.SoundId
	if watched[id] then
		return
	end
	watched[id] = true
	task.delay(Config.SoundLoadTimeout, function()
		if s.IsLoaded then
			return
		end
		if s.Parent == nil then
			watched[id] = nil -- звук убран раньше, чем успел загрузиться: проверим в следующий раз
			return
		end
		Sounds.markFailed(id)
		refreshLoops()
	end)
end

type Job = { Name: string, Ids: { string }, Library: boolean }
local jobs: { Job } = {}
local verified: { [string]: boolean } = {}
local workers = 0

-- Загружает ID слота через PreloadAsync и ждёт результата не дольше SoundLoadTimeout
local function verify(job: Job)
	local def = Sounds.Defs[job.Name]
	local timeout = Config.SoundLoadTimeout * (if def and def.Group == "Music" then 3 else 1) -- музыка длинная
	local probes: { [string]: Sound } = {}
	local status: { [string]: Enum.AssetFetchStatus } = {}
	local list = {}
	for _, id in job.Ids do
		if verified[id] == nil and not probes[id] then
			local probe = Instance.new("Sound")
			probe.Name = "Preload"
			probe.SoundId = id
			probe.Volume = 0
			probe.Parent = SoundService
			probes[id] = probe
			table.insert(list, probe)
		end
	end
	if #list > 0 then
		task.spawn(function()
			pcall(function()
				ContentProvider:PreloadAsync(list, function(contentId: string, fetch: Enum.AssetFetchStatus)
					local digits = contentId:match("%d+$")
					for id in probes do
						if id == contentId or (digits and id:match("%d+$") == digits) then
							status[id] = fetch
						end
					end
				end)
			end)
		end)
		local t0 = os.clock()
		while os.clock() - t0 < timeout do
			local pending = false
			for id, probe in probes do
				if status[id] == nil and not probe.IsLoaded then
					pending = true
				end
			end
			if not pending then
				break
			end
			task.wait(0.25)
		end
		for id, probe in probes do
			local fetch = status[id]
			local ok = if fetch then fetch == Enum.AssetFetchStatus.Success else probe.IsLoaded
			verified[id] = ok
			if not ok then
				Sounds.markFailed(id)
			end
			probe:Destroy()
		end
	end
	if job.Library then
		local good = {}
		for _, id in job.Ids do
			if verified[id] then
				table.insert(good, id)
			end
		end
		Sounds.setLibrary(job.Name, good)
	end
	refreshLoops()
end

local function pumpJobs()
	while workers < 3 and #jobs > 0 do
		workers += 1
		task.spawn(function()
			while #jobs > 0 do
				verify(table.remove(jobs, 1) :: Job)
			end
			workers -= 1
		end)
	end
end

-- Свои ID из Config тоже проверяем: не загрузились — библиотека или синтез
for _, def in Sounds.List do
	local ids = Sounds.parseIds(Config.SoundOverrides[def.Name])
	if #ids > 0 then
		table.insert(jobs, { Name = def.Name, Ids = ids, Library = false })
	end
end

-- Сервер публикует найденное постепенно: следим за версией папки
local libVersion: any = nil
local seenRaw: { [string]: string } = {}
local function syncLibrary()
	local folder = ReplicatedStorage:FindFirstChild(Sounds.LibraryFolder)
	if not folder then
		return
	end
	local version = folder:GetAttribute("Version")
	if version == libVersion then
		return
	end
	libVersion = version
	for _, def in Sounds.List do
		local raw = folder:GetAttribute(def.Name)
		if type(raw) == "string" and raw ~= seenRaw[def.Name] then
			seenRaw[def.Name] = raw
			table.insert(jobs, { Name = def.Name, Ids = Sounds.parseIds(raw), Library = true })
		end
	end
	pumpJobs()
end

------------------------------------------------------------------------
-- Одноразовые звуки
------------------------------------------------------------------------

type Voice = { Sound: Sound, Priority: number, Born: number }
local active: { Voice } = {}
local lastVariant: { [string]: number } = {}

-- Убирает звук и временную точку, на которой он висел
local function release(s: Sound)
	local holder = s.Parent
	s:Destroy()
	if holder and holder.Name == "SfxPoint" and #holder:GetChildren() == 0 then
		holder:Destroy()
	end
end

local function fadeOut(s: Sound, time: number)
	local tw = TweenService:Create(s, TweenInfo.new(time), { Volume = 0 })
	tw.Completed:Connect(function()
		release(s)
	end)
	tw:Play()
end

-- Освобождает место под need звуков приоритета priority; false — новый звук не нужен
local function makeRoom(priority: number, need: number): boolean
	for i = #active, 1, -1 do
		if active[i].Sound.Parent == nil then
			table.remove(active, i)
		end
	end
	while #active + need > MAX_SOUNDS do
		local victim = 0
		for i, v in active do
			local w = active[victim]
			if victim == 0 or v.Priority < w.Priority or (v.Priority == w.Priority and v.Born < w.Born) then
				victim = i
			end
		end
		if victim == 0 or active[victim].Priority > priority then
			return false
		end
		release((table.remove(active, victim) :: Voice).Sound)
	end
	return true
end

local function pickVariant(r: Sounds.Resolved): { Sounds.Layer }
	local n = #r.Variants
	if n <= 1 then
		return r.Variants[1]
	end
	-- Без повторов подряд
	local last = lastVariant[r.Name]
	local k = math.random(1, if last then n - 1 else n)
	if last and k >= last then
		k += 1
	end
	lastVariant[r.Name] = k
	return r.Variants[k]
end

local function spawnLayers(r: Sounds.Resolved, layers: { Sounds.Layer }, where: any, volume: number, speed: number): Sound?
	local def = r.Def
	local anchor, pos = nil, nil
	if def.MaxDistance then
		anchor, pos = locate(where)
		if pos and not near(pos, def.MaxDistance) then
			return nil -- всё равно не слышно
		end
	end
	local priority = def.Priority or 2
	if not makeRoom(priority, #layers) then
		return nil
	end
	local parent: Instance = anchor or SoundService
	if pos and not anchor then
		local att = Instance.new("Attachment")
		att.Name = "SfxPoint"
		att.Parent = workspace.Terrain
		att.WorldPosition = pos
		parent = att
	end
	local life = math.max(12, def.Search and def.Search.Max or 0)
	local first: Sound? = nil
	for _, layer in layers do
		local s = newSound(layer, def, parent, false)
		s.Volume = layer.Volume * volume
		s.PlaybackSpeed = layer.Speed * speed
		table.insert(active, { Sound = s, Priority = priority, Born = os.clock() })
		local delay = layer.Delay or 0
		if delay > 0 then
			task.delay(delay, function()
				if s.Parent then
					s:Play()
				end
			end)
		else
			s:Play()
		end
		s.Ended:Connect(function()
			release(s)
		end)
		local cut = layer.Duration or def.Duration
		if cut then
			task.delay(delay + cut, function()
				if s.Parent then
					fadeOut(s, 0.12)
				end
			end)
		end
		task.delay(delay + (cut or life) + 0.5, function()
			if s.Parent then
				release(s)
			end
		end)
		first = first or s
	end
	if r.Source ~= "Synth" and first then
		watchLoad(first)
	end
	return first
end

-- Проиграть звук слота. where: BasePart / Model / Attachment / Vector3 / nil (2D)
function Audio.play(name: string, where: any?, volumeScale: number?, speedScale: number?): Sound?
	local r = Sounds.get(name)
	if not r then
		return nil
	end
	local def = r.Def
	local volume = def.Volume * (volumeScale or 1) * (1 + (math.random() * 2 - 1) * (def.Jitter or 0))
	local speed = (speedScale or 1) * (1 + (math.random() * 2 - 1) * (def.Pitch or 0))
	return spawnLayers(r, pickVariant(r), where, volume, speed)
end

Remotes.Sfx.OnClientEvent:Connect(function(name, where)
	Audio.play(name, where)
end)

Remotes.Notify.OnClientEvent:Connect(function()
	Audio.play("Notify")
end)

Remotes.Effect.OnClientEvent:Connect(function(name)
	if name == "Intro" then
		Audio.play("EntityDrone")
	end
end)

------------------------------------------------------------------------
-- Петли по требованию
------------------------------------------------------------------------

local frame = 0

local function clearLoop(e: Loop)
	for _, s in e.Sounds do
		s:Destroy()
	end
	table.clear(e.Sounds)
	table.clear(e.Base)
	table.clear(e.Speeds)
end

local function buildLoop(e: Loop)
	clearLoop(e)
	local r = e.Resolved
	if r.Source == "Synth" and r.Def.Melody then
		return -- синтез мелодии играется отдельными нотами
	end
	local layers = r.Variants[math.random(1, #r.Variants)]
	for _, layer in layers do
		local s = newSound(layer, r.Def, e.Where or SoundService, true)
		s.Volume = 0
		table.insert(e.Sounds, s)
		table.insert(e.Base, layer.Volume * r.Def.Volume)
		table.insert(e.Speeds, layer.Speed)
	end
	if r.Source ~= "Synth" and e.Sounds[1] then
		watchLoad(e.Sounds[1])
	end
end

-- Источник слота сменился (библиотека проверена или звук не загрузился): пересобираем петли
refreshLoops = function()
	for _, byKey in loops do
		for key, e in byKey do
			local r = Sounds.get(e.Name)
			if not r then
				clearLoop(e)
				byKey[key] = nil
			elseif r ~= e.Resolved then
				e.Resolved = r
				buildLoop(e)
			end
		end
	end
end

-- Петля нужна в этом кадре. where — деталь (nil = 2D), gain — громкость 0..1
local function want(name: string, where: Instance?, gain: number, speed: number?)
	local byKey = loops[name]
	if not byKey then
		byKey = {}
		loops[name] = byKey
	end
	local key: Instance = where or SoundService
	local e: Loop? = byKey[key]
	if not e then
		local r = Sounds.get(name)
		if gain <= 0 or not r then
			return
		end
		local created: Loop = {
			Name = name,
			Where = where,
			Resolved = r,
			Sounds = {},
			Base = {},
			Speeds = {},
			Gain = 0,
			Target = 0,
			Speed = 1,
			Seen = 0,
			Clock = 0,
			Note = 0,
		}
		buildLoop(created)
		byKey[key] = created
		e = created
	end
	local loop = e :: Loop
	loop.Target = math.clamp(gain, 0, 1)
	loop.Speed = speed or 1
	loop.Seen = frame
end

local function tickMelody(e: Loop, dt: number)
	local melody = e.Resolved.Def.Melody :: Sounds.Melody
	e.Clock -= dt
	if e.Clock > 0 then
		return
	end
	e.Clock += melody.Step
	e.Note = e.Note % #melody.Notes + 1
	local note = melody.Notes[e.Note]
	if note then
		spawnLayers(e.Resolved, { melody.Layer }, e.Where, e.Gain * e.Resolved.Def.Volume, e.Speed * 2 ^ (note / 12))
	end
end

local function updateLoops(dt: number)
	for _, byKey in loops do
		for key, e in byKey do
			if e.Seen ~= frame or (e.Where and e.Where.Parent == nil) then
				e.Target = 0
			end
			local def = e.Resolved.Def
			if e.Target > e.Gain then
				e.Gain = math.min(e.Target, e.Gain + dt / (def.FadeIn or 0.5))
			else
				e.Gain = math.max(e.Target, e.Gain - dt / (def.FadeOut or 1))
			end
			if e.Gain <= 0 then
				clearLoop(e)
				byKey[key] = nil
				continue
			end
			for i, s in e.Sounds do
				s.Volume = e.Base[i] * e.Gain
				s.PlaybackSpeed = e.Speeds[i] * e.Speed
				if not s.Playing then
					s:Play()
				end
			end
			if #e.Sounds == 0 and def.Melody then
				tickMelody(e, dt)
			end
		end
	end
end

------------------------------------------------------------------------
-- Шаги (вызывает Animator в такт шагам)
------------------------------------------------------------------------

-- Материал пола (имя Enum.Material) -> слот шага
local SURFACE: { [string]: string } = {
	Grass = "FootstepDirt",
	LeafyGrass = "FootstepDirt",
	Ground = "FootstepDirt",
	Mud = "FootstepDirt",
	Sand = "FootstepDirt",
	Snow = "FootstepDirt",
	Pebble = "FootstepDirt",
	Wood = "FootstepWood",
	WoodPlanks = "FootstepWood",
	Metal = "FootstepMetal",
	DiamondPlate = "FootstepMetal",
	CorrodedMetal = "FootstepMetal",
	Concrete = "FootstepStone",
	Brick = "FootstepStone",
	Slate = "FootstepStone",
	Rock = "FootstepStone",
	Cobblestone = "FootstepStone",
	Pavement = "FootstepStone",
	Asphalt = "FootstepStone",
	Granite = "FootstepStone",
	Marble = "FootstepStone",
	Basalt = "FootstepStone",
	Limestone = "FootstepStone",
	Sandstone = "FootstepStone",
}

-- Слот шага для материала пола
function Audio.surface(material: Enum.Material): string
	return SURFACE[material.Name] or "Footstep"
end

-- Материал пола под персонажем. У чужих персонажей на клиенте Humanoid.FloorMaterial бывает Air
-- (их физику считает не этот клиент), поэтому тогда смотрим лучом вниз. nil — персонаж в воздухе.
local floorParams = RaycastParams.new()
floorParams.FilterType = Enum.RaycastFilterType.Exclude
function Audio.floorMaterial(char: Model): Enum.Material?
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum and hum.FloorMaterial ~= Enum.Material.Air then
		return hum.FloorMaterial
	end
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	floorParams.FilterDescendantsInstances = { char }
	-- R6: центр корня на 3 стада над землёй (у масштабированного маньяка — больше), плюс запас
	local hit = workspace:Raycast(root.Position, Vector3.new(0, -(root.Size.Y * 1.5 + 1.5), 0), floorParams)
	return if hit then (hit.Material or Enum.Material.Plastic) else nil
end

function Audio.footstep(char: Model, isKiller: boolean, speed: number, crouching: boolean)
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local floor = Audio.floorMaterial(char)
	local slot = if floor then Audio.surface(floor) else "Footstep"
	local vol = if crouching then 0.35 else math.clamp(speed / 16, 0.45, 1.1)
	if isKiller and char == player.Character then
		vol *= 0.6 -- свои шаги маньяк слышит у самой камеры
	end
	if isKiller then
		-- Маньяк: тот же пол, но ниже и громче, плюс тяжёлый удар сапога
		Audio.play(slot, root, vol * 1.15, 0.85)
		Audio.play("KillerFootstep", root, vol)
	else
		Audio.play(slot, root, vol)
	end
end

------------------------------------------------------------------------
-- Радиус ужаса
------------------------------------------------------------------------

local function findKiller(): Player?
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("Role") == "Killer" then
			return p
		end
	end
	return nil
end

-- Близость маньяка для локального выжившего: 0 — вне радиуса (радиус × scale), 1 — вплотную
local function killerProximity(killer: Player?, scale: number): number
	if not killer or player:GetAttribute("Role") ~= "Survivor" or not Util.isInGameStatus(player:GetAttribute("Status")) then
		return 0
	end
	local kroot = Util.getRoot(killer)
	local myRoot = Util.getRoot(player)
	local tr = (tonumber(killer:GetAttribute("TerrorRadius")) or 32) * scale
	if not kroot or not myRoot or tr <= 0 then
		return 0
	end
	return math.clamp(1 - Util.flatDist(kroot.Position, myRoot.Position) / tr, 0, 1)
end

-- Сила радиуса ужаса для локального выжившего (0..1)
function Audio.terrorIntensity(): number
	return killerProximity(findKiller(), 1)
end

------------------------------------------------------------------------
-- Щелчки кнопок интерфейса
------------------------------------------------------------------------

local hooked: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function hookButton(inst: Instance)
	-- Кнопку, перенесённую внутри PlayerGui, второй раз не подключаем (иначе щелчок двойной)
	if not inst:IsA("GuiButton") or hooked[inst] then
		return
	end
	-- Экранные кнопки управления (прыжок, действия) не щёлкают
	if inst:FindFirstAncestor("ContextActionGui") or inst:FindFirstAncestor("TouchGui") then
		return
	end
	hooked[inst] = true
	local button = inst :: GuiButton
	button.Activated:Connect(function()
		Audio.play("UiClick")
	end)
end

task.spawn(function()
	local gui = player:WaitForChild("PlayerGui", 30)
	if gui then
		for _, d in gui:GetDescendants() do
			hookButton(d)
		end
		gui.DescendantAdded:Connect(hookButton)
	end
end)

------------------------------------------------------------------------
-- Кадр
------------------------------------------------------------------------

local syncTimer = 0
local fireTimer = 0
local fires: { BasePart } = {}
local scannedMap: Instance? = nil
local scannedLobby: Instance? = nil
local crowTimer = 20
local thunderTimer = 45
local beatTimer = 0
local fatigue = 0
local duck = 0
local muffle = 0
local gateSeen: { [Instance]: { Progress: number, Changed: number } } = {}
local lastBeat: Sound? = nil

-- Костры в лобби и на карте (детали FireSource)
local function collectFires(container: Instance?)
	if not container then
		return
	end
	for _, d in container:GetDescendants() do
		if d.Name == "FireSource" and d:IsA("BasePart") then
			table.insert(fires, d)
		end
	end
end

local function updateMap(map: Instance, now: number)
	-- Генераторы гудят, пока их чинят и после починки
	local gens = map:FindFirstChild("Generators")
	if gens then
		for _, gen in gens:GetChildren() do
			local part = gen:IsA("Model") and (gen :: Model).PrimaryPart
			local p = gen:GetAttribute("Progress") or 0
			if part and p > 0 and near(part.Position, 70) then
				if gen:GetAttribute("Done") then
					want("GenLoop", part, 0.7, 1.1)
				else
					want("GenLoop", part, 0.35 + 0.65 * p, 0.92 + 0.16 * p)
				end
			end
		end
	end

	-- Люк воет ветром
	local hatch = map:FindFirstChild("Hatch")
	local hatchPart = hatch and hatch:IsA("Model") and (hatch :: Model).PrimaryPart
	if hatch and hatchPart and hatch:GetAttribute("Open") and near(hatchPart.Position, 55) then
		want("HatchWind", hatchPart, 1)
	end

	-- Сирена ворот, пока их открывают
	local gates = map:FindFirstChild("ExitGates")
	if gates then
		for _, gate in gates:GetChildren() do
			local p = gate:GetAttribute("Progress") or 0
			local seen = gateSeen[gate]
			if not seen or seen.Progress ~= p then
				gateSeen[gate] = { Progress = p, Changed = if seen then now else -math.huge }
			end
			local opening = now - gateSeen[gate].Changed < 1
			if opening and gate:GetAttribute("Powered") and not gate:GetAttribute("Open") then
				local siren = gate:FindFirstChild("Siren", true) or (gate:IsA("Model") and (gate :: Model).PrimaryPart)
				if siren and siren:IsA("BasePart") then
					want("GateSiren", siren, 1)
				end
			end
		end
	end
end

local function updateBreathing(dt: number, killer: Player?)
	-- Раненые и лежащие выжившие тяжело дышат (слышно и маньяку)
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("Role") == "Survivor" and p:GetAttribute("Status") == "Playing" then
			local hp = p:GetAttribute("Health") or 2
			local root = Util.getRoot(p)
			if hp < 2 and root and near(root.Position, 34) then
				want("BreathInjured", root, if hp == 0 then 1 else 0.75, if hp == 0 then 0.85 else 1)
			end
		end
	end

	-- Одышка после долгого бега
	local me = player:GetAttribute("Role") == "Survivor" and player:GetAttribute("Status") == "Playing"
	local running = me and player:GetAttribute("Running") == true
	fatigue = if running then math.min(fatigue + dt / 6, 1) else math.max(fatigue - dt / 5, 0)
	if me and (player:GetAttribute("Health") or 2) == 2 and fatigue > 0.3 then
		want("BreathExhausted", nil, (fatigue - 0.3) / 0.7 * (if running then 0.5 else 1))
	end

	-- Дыхание маньяка совсем рядом (кроме невидимого Призрака: радиус ужаса 0)
	local kroot = Util.getRoot(killer)
	if me and killer and kroot and (tonumber(killer:GetAttribute("TerrorRadius")) or 32) > 0 and near(kroot.Position, 26) then
		want("KillerBreath", kroot, 1)
	end
end

function Audio.update(dt: number)
	frame += 1
	local now = os.clock()
	local map = workspace:FindFirstChild("Map")
	local role = player:GetAttribute("Role")
	local inGame = role ~= nil and Util.isInGameStatus(player:GetAttribute("Status"))

	syncTimer -= dt
	if syncTimer <= 0 then
		syncTimer = 1
		syncLibrary()
	end

	-- Атмосфера
	want("Wind", nil, if map and role then 1 else 0.6)
	want("NightInsects", nil, 1)
	want("AmbientMusic", nil, if role then 0 else 1)
	-- Костры ищем при смене карты/лобби и изредка (части карты могут догружаться)
	local lobby = workspace:FindFirstChild("Lobby")
	fireTimer -= dt
	if fireTimer <= 0 or map ~= scannedMap or lobby ~= scannedLobby then
		if map ~= scannedMap then
			table.clear(gateSeen)
		end
		fireTimer = 15
		scannedMap, scannedLobby = map, lobby
		table.clear(fires)
		collectFires(lobby)
		collectFires(map)
	end
	for _, fire in fires do
		if fire.Parent and near(fire.Position, 50) then
			want("Campfire", fire, 1)
		end
	end
	thunderTimer -= dt
	if thunderTimer <= 0 then
		thunderTimer = 50 + math.random() * 70
		Audio.play("Thunder", nil, 0.5 + math.random() * 0.5)
	end
	if map and inGame then
		crowTimer -= dt
		if crowTimer <= 0 then
			crowTimer = 15 + math.random() * 25
			local a = math.random() * math.pi * 2
			local pos = listenerPosition() + Vector3.new(math.cos(a) * 60, 10, math.sin(a) * 60)
			Audio.play("Crow", pos, 0.5)
		end
	end

	-- Радиус ужаса: дальний гул -> сердце -> погоня (у Охотницы вместо гула и сердца — колыбельная)
	local killer = findKiller()
	local intensity = killerProximity(killer, 1)
	local chase = inGame and player:GetAttribute("Chase") == true
	duck = if chase then math.min(duck + dt * 1.5, 1) else math.max(duck - dt * 0.4, 0)
	local lullaby = killer and KillerDefs.get(killer:GetAttribute("KillerType")).Lullaby
	if lullaby then
		want("Lullaby", nil, killerProximity(killer, 1.8) ^ 0.8)
	elseif intensity > 0 then
		want("TerrorDrone", nil, intensity ^ 0.7 * (1 - 0.8 * duck), 0.9 + 0.2 * intensity)
	end
	if intensity > 0 and not lullaby then
		beatTimer -= dt
		if beatTimer <= 0 then
			beatTimer = 1.2 - 0.75 * intensity
			if lastBeat and lastBeat.Parent then
				fadeOut(lastBeat, 0.08)
			end
			lastBeat = Audio.play("Heartbeat", nil, 0.3 + 0.7 * intensity, 0.96 + 0.08 * intensity)
		end
	else
		beatTimer = 0
	end
	if chase then
		want("ChaseMusic", nil, 1)
	end

	if map and inGame then
		updateMap(map, now)
	end
	if inGame then
		updateBreathing(dt, killer)
	end

	-- Микс: в погоне и у маньяка атмосфера тише, из шкафчика всё звучит глухо
	Audio.Groups.Ambience.Volume = (Config.SoundGroupVolumes.Ambience or 1) * (1 - 0.6 * duck) * (1 - 0.35 * intensity)
	local hidden = inGame and player:GetAttribute("Hidden") == true
	muffle = if hidden then math.min(muffle + dt * 3, 1) else math.max(muffle - dt * 3, 0)
	for name, eq in groupEq do
		if MUFFLED[name] then
			eq.HighGain = baseHighGain[name] - 18 * muffle
		end
	end

	updateLoops(dt)
end

pumpJobs()

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">Auras</string>
            <string name="Source"><![CDATA[-- Ауры (подсветка сквозь стены), как в DBD.
-- Выжившие видят висящих/поверженных товарищей и запитанные ворота.
-- Маньяк видит генераторы, а когда несёт выжившего — свободные крюки.
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Auras = {}

local auras = {} :: { [Instance]: Highlight }

local RED = Color3.fromRGB(255, 50, 50)
local YELLOW = Color3.fromRGB(255, 220, 90)
local WHITE = Color3.fromRGB(235, 235, 235)

local function children(name: string): { Instance }
	local map = workspace:FindFirstChild("Map")
	local f = map and map:FindFirstChild(name)
	return f and f:GetChildren() or {}
end

function Auras.update()
	local wanted = {} :: { [Instance]: Color3 }
	local role = player:GetAttribute("Role")
	local status = player:GetAttribute("Status")
	local inGame = status == "Playing" or status == "Carried" or status == "Hooked"
	if role == "Survivor" and inGame then
		for _, p in Players:GetPlayers() do
			if p ~= player and p:GetAttribute("Role") == "Survivor" and p.Character then
				local s = p:GetAttribute("Status")
				if s == "Hooked" or (s == "Playing" and p:GetAttribute("Health") == 0 and not p:GetAttribute("Hidden")) then
					wanted[p.Character] = RED
				end
			end
		end
		for _, gate in children("ExitGates") do
			if gate:GetAttribute("Powered") and not gate:GetAttribute("Open") then
				wanted[gate] = YELLOW
			end
		end
	elseif role == "Killer" and status == "Playing" then
		if player:GetAttribute("Carrying") then
			for _, hook in children("Hooks") do
				if hook:GetAttribute("Occupant") == 0 then
					wanted[hook] = WHITE
				end
			end
		end
		for _, gen in children("Generators") do
			if not gen:GetAttribute("Done") then
				wanted[gen] = WHITE
			end
		end
	end

	for inst, h in auras do
		if not wanted[inst] or not inst.Parent then
			h:Destroy()
			auras[inst] = nil
		end
	end
	for inst, color in wanted do
		local h = auras[inst]
		if not h then
			h = Instance.new("Highlight")
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.FillTransparency = 0.85
			h.OutlineTransparency = 0.1
			h.Adornee = inst
			h.Parent = camera
			auras[inst] = h
		end
		h.OutlineColor = color
		h.FillColor = color
	end
end

return Auras
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[-- Камера: маньяк от первого лица с покачиванием, выживший от третьего,
-- ползание ниже, вид из шкафчика, наблюдение, тряска и наклон при оглушении.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local CameraController = {}

local shake = 0
local stunUntil = 0
local stunStart = 0
local fovPunch = 0
local mode = ""
local bob = 0
local lockerMode = false
local lockerDoor: Model? = nil
local lockerDoorParts: { BasePart } = {}
local spectateTarget: Player? = nil
local appliedFX = CFrame.identity

-- Детали снаряжения маньяков, которые видны от первого лица (имена — из Art/KillerGear)
local VIEWMODEL = {
	-- оружие: тесак Траппера, топор Охотницы, дубина и колокол Призрака
	Handle = true,
	Blade = true,
	BladeBlood = true,
	AxeHead = true,
	Club = true,
	Skull = true,
	Bell = true,
	-- снаряжение кистей и предплечий
	Glove = true,
	Wrap = true,
	Bracer = true,
	ArmWrap = true,
	ArmRag = true,
}

function CameraController.shake(amount: number)
	shake = math.max(shake, amount)
end

function CameraController.stun(duration: number)
	stunStart = os.clock()
	stunUntil = stunStart + duration
	shake = math.max(shake, 0.4)
end

function CameraController.punch(amount: number)
	fovPunch = amount
end

------------------------------------------------------------------------
-- Режимы
------------------------------------------------------------------------

local function setMode(newMode: string)
	if mode == newMode then
		return
	end
	local wasKiller = mode == "Killer"
	mode = newMode
	if newMode == "Killer" then
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		player.CameraMaxZoomDistance = 0.5
		player.CameraMinZoomDistance = 0.5
		return
	end
	player.CameraMode = Enum.CameraMode.Classic
	-- Сначала максимум, потом минимум: минимум больше 0.5 «выталкивает» камеру
	-- из вида от первого лица, иначе после раунда за маньяка мышь остаётся
	-- заблокированной по центру и по меню нельзя кликнуть.
	if newMode == "Survivor" then
		player.CameraMaxZoomDistance = 16
		player.CameraMinZoomDistance = 7
	else
		player.CameraMaxZoomDistance = 30
		player.CameraMinZoomDistance = 6
	end
	if wasKiller then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	end
end

------------------------------------------------------------------------
-- Наблюдение
------------------------------------------------------------------------

local function isSpectatable(p: Player): boolean
	return p ~= player
		and p.Parent ~= nil
		and p:GetAttribute("Role") ~= nil
		and Util.isInGameStatus(p:GetAttribute("Status") :: string?)
		and Util.getHumanoid(p) ~= nil
end

function CameraController.spectateCandidates(): { Player }
	local list = {}
	for _, p in Players:GetPlayers() do
		if isSpectatable(p) then
			table.insert(list, p)
		end
	end
	return list
end

-- nil — вернуться к своему персонажу
function CameraController.spectate(target: Player?)
	spectateTarget = target
end

function CameraController.getSpectateTarget(): Player?
	return spectateTarget
end

------------------------------------------------------------------------
-- Шкафчик
------------------------------------------------------------------------

local function findLocker(): Model?
	local map = workspace:FindFirstChild("Map")
	local lockers = map and map:FindFirstChild("Lockers")
	if not lockers then
		return nil
	end
	for _, l in lockers:GetChildren() do
		if l:GetAttribute("Occupant") == player.UserId then
			return l :: Model
		end
	end
	return nil
end

-- Все детали двери шкафчика (группа LockerDoor), сквозь которые смотрит спрятавшийся
local function setLockerDoor(locker: Model?)
	if lockerDoor == locker then
		return
	end
	if lockerDoor then
		for _, part in lockerDoorParts do
			if part.Parent then
				part.LocalTransparencyModifier = 0
			end
		end
	end
	lockerDoor = locker
	lockerDoorParts = {}
	if locker then
		-- Изнутри видно сквозь щели
		for _, d in locker:GetDescendants() do
			if d:IsA("BasePart") and (d:GetAttribute("FX") == "LockerDoor" or d.Name == "Door") then
				d.LocalTransparencyModifier = 0.7
				table.insert(lockerDoorParts, d)
			end
		end
	end
end

------------------------------------------------------------------------
-- Каждый кадр
------------------------------------------------------------------------

function CameraController.update(dt: number)
	local role = player:GetAttribute("Role")
	local status = player:GetAttribute("Status")
	local inGame = Util.isInGameStatus(status)
	local hum = Util.getHumanoid(player)

	if role == "Killer" and status == "Playing" and Config.KillerFirstPerson then
		setMode("Killer")
	elseif role == "Survivor" and inGame then
		setMode("Survivor")
	else
		setMode("Lobby")
	end

	-- Смещение камеры: ползание, приседание, покачивание головы маньяка
	if hum then
		local target = Vector3.zero
		local root = Util.getRoot(player)
		local speed = root and (root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude or 0
		if role == "Survivor" and status == "Playing" then
			if (player:GetAttribute("Health") or 2) == 0 then
				target = Vector3.new(0, -2.2, 0)
			elseif player:GetAttribute("Crouching") or player:GetAttribute("ActionName") then
				target = Vector3.new(0, -1, 0)
			end
		elseif mode == "Killer" then
			bob += dt * speed * 0.6
			local amp = math.clamp(speed / 18, 0, 1)
			target = Vector3.new(math.cos(bob) * 0.08 * amp, math.abs(math.sin(bob)) * 0.15 * amp, 0)
		end
		hum.CameraOffset = hum.CameraOffset:Lerp(target, math.min(dt * 8, 1))
	end

	local wantFov = mode == "Killer" and 85 or 70
	camera.FieldOfView += (wantFov + fovPunch - camera.FieldOfView) * math.min(dt * 10, 1)
	fovPunch *= math.exp(-dt * 6)

	-- Шкафчик: камера внутри, смотрит наружу через щели
	local locker = player:GetAttribute("Hidden") and findLocker()
	local inside = locker and locker:FindFirstChild("Inside") :: BasePart?
	if locker and inside then
		if not lockerMode then
			lockerMode = true
			camera.CameraType = Enum.CameraType.Scriptable
		end
		setLockerDoor(locker)
		local look = inside.CFrame * CFrame.new(0, 1.8, -0.4)
		local sway = CFrame.Angles(math.sin(os.clock() * 0.7) * 0.02, math.sin(os.clock() * 0.5) * 0.08, 0)
		camera.CFrame = camera.CFrame:Lerp(look * sway, math.min(dt * 6, 1))
		return
	end
	if lockerMode then
		lockerMode = false
		setLockerDoor(nil)
	end

	-- Камера всегда должна быть обычной и смотреть на живого персонажа.
	-- Персонажи создаются вручную, поэтому привязываем её сами.
	if camera.CameraType ~= Enum.CameraType.Custom then
		camera.CameraType = Enum.CameraType.Custom
	end
	local subject: Humanoid? = hum
	if spectateTarget then
		if isSpectatable(spectateTarget) then
			subject = Util.getHumanoid(spectateTarget)
		else
			-- Тот, за кем смотрели, сбежал или погиб — переключаемся на следующего
			local list = CameraController.spectateCandidates()
			spectateTarget = list[1]
			subject = spectateTarget and Util.getHumanoid(spectateTarget) or hum
		end
	end
	if subject and camera.CameraSubject ~= subject then
		camera.CameraSubject = subject
	end
end

------------------------------------------------------------------------
-- Тряска и наклон
-- Стандартная камера Roblox берёт направление взгляда из прошлого кадра, поэтому
-- эффект нужно убирать перед её обновлением и добавлять заново после — иначе
-- наклон накапливается и камера «уезжает» в землю.
------------------------------------------------------------------------

RunService:BindToRenderStep("DBDCameraFXRemove", Enum.RenderPriority.Camera.Value - 1, function()
	if appliedFX ~= CFrame.identity then
		if camera.CameraType ~= Enum.CameraType.Scriptable then
			camera.CFrame *= appliedFX:Inverse()
		end
		appliedFX = CFrame.identity
	end
end)

RunService:BindToRenderStep("DBDCameraFXApply", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local t = os.clock()
	local extra = CFrame.identity
	if shake > 0.01 then
		extra *= CFrame.Angles(math.noise(t * 25, 0) * shake * 0.08, math.noise(0, t * 25) * shake * 0.08, 0)
		shake *= math.exp(-dt * 5)
	else
		shake = 0
	end
	if t < stunUntil then
		local a = (t - stunStart) / (stunUntil - stunStart)
		extra *= CFrame.Angles(math.rad(-12) * (1 - a), 0, math.rad(18) * math.sin(a * math.pi))
	end
	if extra ~= CFrame.identity and camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CFrame *= extra
		appliedFX = extra
	end

	-- От первого лица Roblox прячет всё тело. Маньяку оставляем руки и оружие,
	-- чтобы был виден замах, как в DBD.
	if mode == "Killer" then
		local char = player.Character
		if char then
			for _, d in char:GetChildren() do
				if d:IsA("BasePart") and (VIEWMODEL[d.Name] or d.Name == "Left Arm" or d.Name == "Right Arm") then
					d.LocalTransparencyModifier = 0
				end
			end
		end
	end
end)

------------------------------------------------------------------------
-- Персонаж: никаких падений и лазания по стенам (сталкивается только HumanoidRootPart)
------------------------------------------------------------------------

local function onCharacter(char: Model)
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if not hum then
		return
	end
	for _, state in
		{ Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.Climbing }
	do
		hum:SetStateEnabled(state, false)
	end
	camera.CameraType = Enum.CameraType.Custom
	if not spectateTarget then
		camera.CameraSubject = hum
	end
end

player.CharacterAdded:Connect(onCharacter)
if player.Character then
	task.spawn(onCharacter, player.Character)
end

return CameraController
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="99">
          <Properties>
            <string name="Name">Client</string>
            <string name="Source"><![CDATA[-- Клиент: связывает интерфейс, управление, анимации, камеру, звук и эффекты.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)
local Util = require(ReplicatedStorage.Shared.Util)

local Hud = require(script.Parent.UI.Hud)
local SkillCheck = require(script.Parent.UI.SkillCheck)
local LobbyUI = require(script.Parent.UI.LobbyUI)
local Results = require(script.Parent.UI.Results)
local Widgets = require(script.Parent.UI.Widgets)
require(script.Parent.Animator)
local Audio = require(script.Parent.Audio)
local CameraController = require(script.Parent.CameraController)
local Effects = require(script.Parent.Effects)
local Auras = require(script.Parent.Auras)
local Interaction = require(script.Parent.Interaction)
local Input = require(script.Parent.Input)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local gameState = ReplicatedStorage:WaitForChild("GameState")

Hud.mount(player:WaitForChild("PlayerGui") :: PlayerGui)
LobbyUI.mount(Hud.Gui)
Results.mount(Hud.Gui)

------------------------------------------------------------------------
-- События сервера
------------------------------------------------------------------------

Remotes.Notify.OnClientEvent:Connect(function(text, color)
	Hud.notify(text, color)
end)

Remotes.Score.OnClientEvent:Connect(function(text, amount)
	Hud.score(text, amount)
end)

Remotes.SkillCheck.OnClientEvent:Connect(function(id, zone)
	Audio.play("SkillWarn")
	SkillCheck.start(zone, Config.SkillCheckDuration, function(result)
		Remotes.SkillCheck:FireServer(id, result)
		if result == "great" then
			Audio.play("SkillGood", nil, 1, 1.2)
			Hud.notify("Отлично!", Color3.new(1, 1, 1))
		elseif result == "good" then
			Audio.play("SkillGood")
		else
			Hud.notify("Провал!", Color3.fromRGB(255, 70, 70))
			CameraController.shake(0.5)
		end
	end)
end)

Remotes.Noise.OnClientEvent:Connect(function(position)
	Effects.noise(position)
end)

Remotes.Results.OnClientEvent:Connect(function(title, reason, rows)
	Results.show(title, reason, rows, Config.ResultsTime)
end)

Remotes.Effect.OnClientEvent:Connect(function(name, value)
	if name == "Shake" then
		CameraController.shake(tonumber(value) or 0.5)
	elseif name == "Stun" then
		CameraController.stun(tonumber(value) or 2)
	elseif name == "Blind" then
		Hud.blind(tonumber(value) or 2)
		CameraController.shake(0.3)
	elseif name == "Intro" and typeof(value) == "table" then
		if value.Role == "Killer" then
			Hud.intro("Ты — " .. tostring(value.KillerName), "Принеси их в жертву Сущности")
		else
			Hud.intro("Выживи", "Маньяк: " .. tostring(value.KillerName))
		end
	end
end)

------------------------------------------------------------------------
-- Наблюдение за раундом (после смерти / побега)
------------------------------------------------------------------------

local spectateButton = Widgets.button({
	Parent = Hud.Gui,
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -24),
	Size = UDim2.fromOffset(240, 40),
	Text = "Наблюдать",
	Visible = false,
})
local spectateIndex = 0

spectateButton.Activated:Connect(function()
	local list = CameraController.spectateCandidates()
	if #list == 0 then
		CameraController.spectate(nil)
		return
	end
	spectateIndex = spectateIndex % #list + 1
	CameraController.spectate(list[spectateIndex])
end)

------------------------------------------------------------------------
-- Главный цикл
------------------------------------------------------------------------

local ACTION_TEXT = {
	Repair = "Ремонт генератора",
	Heal = "Лечение",
	SelfHeal = "Лечение аптечкой",
	Unhook = "Снятие с крюка",
	OpenGate = "Открытие ворот",
	Cleanse = "Очищение тотема",
	OpenChest = "Открытие сундука",
	EscapeTrap = "Попытка вырваться",
	FreeTrap = "Освобождение из капкана",
	DisarmTrap = "Обезвреживание капкана",
	Hook = "Вешаем на крюк",
	Break = "Ломаем паллету",
	Kick = "Повреждаем генератор",
	SearchLocker = "Обыскиваем шкафчик",
	CloseHatch = "Закрываем люк",
	PickupTrap = "Забираем капкан",
	ResetTrap = "Взводим капкан",
	SetTrap = "Ставим капкан",
}

local CONTROLS_SURVIVOR = "Shift — бег   •   Ctrl/C — присесть\n"
	.. "E (держать) — чинить, лечить, снять с крюка, сундук, тотем\n"
	.. "Пробел — паллета, окно, шкафчик, проверка навыка\n"
	.. "R — использовать предмет"
local CONTROLS_LOBBY = "Dead by Daylight в Roblox\nВыжившие чинят генераторы и сбегают,\nманьяк вешает их на крюки.\nСядь на бревно у костра и жди раунда."

local pulse = 0

RunService.RenderStepped:Connect(function(dt)
	local role = player:GetAttribute("Role")
	local status = player:GetAttribute("Status")
	local phase = gameState:GetAttribute("Phase")
	local timer = gameState:GetAttribute("Timer") or 0
	local inMatch = role ~= nil and Util.isInGameStatus(status)

	Input.bind(inMatch and role or nil)

	-- Верхние надписи
	if phase == "InGame" then
		local gens = gameState:GetAttribute("GensLeft") or 0
		local sub
		if gameState:GetAttribute("EndGame") then
			sub = "ОБРУШЕНИЕ: " .. (gameState:GetAttribute("EndGameTimer") or 0) .. " с"
		elseif gameState:GetAttribute("HexRuin") and role then
			sub = "Проклятие: Руина"
		end
		Hud.setGenerators(role ~= nil, gens > 0 and ("Генераторы: " .. gens) or "Ворота запитаны!", sub)
		Hud.setTop(not role and "Идёт раунд — подожди следующего" or nil, nil)
	else
		Hud.setGenerators(false)
		if phase == "Starting" then
			Hud.setTop("Раунд начнётся через " .. timer, "Маньяк выбирается среди желающих")
		elseif phase == "Loading" then
			Hud.setTop("Загрузка карты...")
		elseif phase == "Results" then
			Hud.setTop("Новый раунд через " .. timer)
		else
			local need = gameState:GetAttribute("NeedPlayers") or Config.MinPlayers
			Hud.setTop("Ожидание игроков (" .. #Players:GetPlayers() .. "/" .. need .. ")")
		end
	end

	LobbyUI.setVisible(role == nil and phase ~= "InGame" and phase ~= "Loading")
	Hud.updatePortraits(phase == "InGame")
	Hud.updatePower()

	if role == "Killer" then
		local def = KillerDefs.get(player:GetAttribute("KillerType"))
		Hud.setControls("ЛКМ — удар   •   " .. def.PowerHint .. "\nE — поднять, повесить, сломать, обыскать\nПробел — перелезть через окно")
	elseif role == "Survivor" then
		Hud.setControls(CONTROLS_SURVIVOR)
	else
		Hud.setControls(CONTROLS_LOBBY)
	end

	-- Действия и подсказки
	local primary, secondary = nil, nil
	if inMatch then
		primary, secondary = Interaction.find()
	end
	Input.Primary, Input.Secondary = primary, secondary
	local actionName = player:GetAttribute("ActionName")
	if actionName then
		Hud.setHints(nil, nil)
		Hud.setAction(ACTION_TEXT[actionName] or actionName, player:GetAttribute("ActionProgress") or 0)
	else
		Hud.setAction(nil, nil)
		Hud.setHints(
			primary and ("[E] " .. primary.Text) or nil,
			secondary and ("[Пробел] " .. secondary.Text) or nil
		)
		local check = SkillCheck.get()
		if check then
			check.Cancel()
		end
	end
	local check = SkillCheck.get()
	if check then
		check.Update()
	end

	-- Личный статус
	if player:GetAttribute("HookProgress") then
		local stage = player:GetAttribute("HookCount") or 1
		Hud.setStatus("На крюке — стадия " .. stage .. ". Жди помощи!", 1 - player:GetAttribute("HookProgress"))
	elseif player:GetAttribute("Wiggle") then
		Hud.setStatus("Вырываешься из рук маньяка...", player:GetAttribute("Wiggle"))
	elseif player:GetAttribute("BleedOut") then
		Hud.setStatus("Ты повержен — истекаешь кровью. Жди помощи!", 1 - player:GetAttribute("BleedOut"))
	elseif player:GetAttribute("Trapped") then
		Hud.setStatus("Ты в капкане! Держи E, чтобы вырваться", 1)
	elseif player:GetAttribute("Stunned") then
		Hud.setStatus("Оглушён!", 1)
	elseif player:GetAttribute("Hidden") then
		Hud.setStatus("Ты прячешься в шкафчике. Пробел — выйти", 1)
	else
		Hud.setStatus(nil, nil)
	end

	-- Пульсирующая красная виньетка радиуса ужаса
	local intensity = Audio.terrorIntensity()
	if intensity > 0 then
		pulse += dt * (1 + intensity * 2.5)
		Hud.setTerror(intensity * (0.35 + 0.65 * math.abs(math.sin(pulse * math.pi))))
	else
		Hud.setTerror(0)
	end

	-- Наблюдение
	local canSpectate = phase == "InGame" and not inMatch
	spectateButton.Visible = canSpectate
	local target = CameraController.getSpectateTarget()
	if target and not canSpectate then
		CameraController.spectate(nil)
		target = nil
	end
	spectateButton.Text = target and ("Следующий (" .. target.DisplayName .. ")") or "Наблюдать"

	Auras.update()
	Effects.update(dt)
	Audio.update(dt)
	CameraController.update(dt)
	Input.update(dt)
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="100">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- Визуальные эффекты на клиенте: следы бега и кровь (видит только маньяк),
-- полёт топоров, невидимость Призрака, поршни генераторов, шумы.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local Hatchet = require(ReplicatedStorage.Shared.Art.Hatchet)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Effects = {}

local folder = Instance.new("Folder")
folder.Name = "DBDLocalFX"
folder.Parent = workspace

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.RespectCanCollide = true

local function groundBelow(pos: Vector3): (Vector3?, Vector3?)
	local exclude = { folder }
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	groundParams.FilterDescendantsInstances = exclude
	local hit = workspace:Raycast(pos, Vector3.new(0, -8, 0), groundParams)
	if hit then
		return hit.Position, hit.Normal
	end
	return nil, nil
end

local function fxPart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = folder
	return p
end

local function fadeOut(part: BasePart, delayTime: number, duration: number)
	task.delay(delayTime, function()
		if part.Parent then
			TweenService:Create(part, TweenInfo.new(duration), { Transparency = 1 }):Play()
			Debris:AddItem(part, duration + 0.1)
		end
	end)
end

------------------------------------------------------------------------
-- Следы и кровь (только для маньяка)
------------------------------------------------------------------------

local trackTimers = {} :: { [Player]: { Scratch: number, Blood: number } }

local function scratchMark(pos: Vector3)
	local ground = groundBelow(pos)
	if not ground then
		return
	end
	local yaw = math.random() * math.pi * 2
	for i = 1, 3 do
		local p = fxPart({
			Name = "Scratch",
			Size = Vector3.new(0.12, 0.05, 1.6 + math.random()),
			CFrame = CFrame.new(ground + Vector3.new(0, 0.06, 0)) * CFrame.Angles(0, yaw, 0) * CFrame.new((i - 2) * 0.35, 0, 0) * CFrame.Angles(
				0,
				(math.random() - 0.5) * 0.4,
				0
			),
			Color = Color3.fromRGB(255, 80, 40),
			Material = Enum.Material.Neon,
			Transparency = 0.15,
		})
		fadeOut(p, 5, 3)
	end
end

local function bloodPool(pos: Vector3)
	local ground = groundBelow(pos)
	if not ground then
		return
	end
	local r = 0.8 + math.random() * 1.2
	local p = fxPart({
		Name = "Blood",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.05, r, r),
		CFrame = CFrame.new(ground + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(110, 0, 0),
		Material = Enum.Material.Glass,
		Transparency = 0.1,
	})
	fadeOut(p, 7, 3)
end

local function updateTracks(dt: number)
	local isKiller = player:GetAttribute("Role") == "Killer" and player:GetAttribute("Status") == "Playing"
	if not isKiller then
		return
	end
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("Role") ~= "Survivor" or p:GetAttribute("Status") ~= "Playing" or p:GetAttribute("Hidden") then
			continue
		end
		local root = Util.getRoot(p)
		if not root then
			continue
		end
		local timers = trackTimers[p] or { Scratch = 0, Blood = 0 }
		trackTimers[p] = timers
		timers.Scratch -= dt
		timers.Blood -= dt
		if p:GetAttribute("Running") and timers.Scratch <= 0 then
			timers.Scratch = 0.3
			scratchMark(root.Position + Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1))
		end
		local health = p:GetAttribute("Health") or 2
		local moving = (root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude > 1
		if health < 2 and moving and timers.Blood <= 0 then
			timers.Blood = 1.4
			bloodPool(root.Position)
		end
	end
end

------------------------------------------------------------------------
-- Топоры Охотницы
------------------------------------------------------------------------

local projectiles = {} :: { [number]: any }

local function hatchetModel(): Model
	local m = Hatchet.build()
	m.Parent = folder
	return m
end

Remotes.Projectile.OnClientEvent:Connect(function(id, origin, velocity, gravity)
	projectiles[id] = {
		Model = hatchetModel(),
		Pos = origin,
		Vel = velocity,
		Gravity = Vector3.new(0, -gravity, 0),
		Spin = 0,
		Stuck = false,
	}
end)

Remotes.ProjectileEnd.OnClientEvent:Connect(function(id, pos, hitPlayer)
	local p = projectiles[id]
	if not p then
		return
	end
	projectiles[id] = nil
	if hitPlayer then
		p.Model:Destroy()
		return
	end
	-- Воткнулся
	local dir = p.Vel.Magnitude > 0.1 and p.Vel.Unit or Vector3.new(0, 0, -1)
	p.Model:PivotTo(CFrame.lookAt(pos - dir * 0.6, pos))
	task.delay(4, function()
		if p.Model.Parent then
			p.Model:Destroy()
		end
	end)
end)

local function updateProjectiles(dt: number)
	for _, p in projectiles do
		local newVel = p.Vel + p.Gravity * dt
		p.Pos += (p.Vel + newVel) * 0.5 * dt
		p.Vel = newVel
		p.Spin += dt * 25
		if p.Vel.Magnitude > 0.1 then
			p.Model:PivotTo(CFrame.lookAt(p.Pos, p.Pos + p.Vel) * CFrame.Angles(-p.Spin, 0, 0))
		end
	end
end

------------------------------------------------------------------------
-- Невидимость Призрака и красное пятно
------------------------------------------------------------------------

local cloakCache = {} :: { [Model]: number }

local function setModifier(char: Model, value: number)
	if cloakCache[char] == value then
		return
	end
	cloakCache[char] = value
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") or d:IsA("Decal") then
			d.LocalTransparencyModifier = value
		end
	end
end

local function updateCloak()
	local iAmKiller = player:GetAttribute("Role") == "Killer"
	for _, p in Players:GetPlayers() do
		local char = p.Character
		if not char then
			continue
		end
		if p:GetAttribute("Role") ~= "Killer" then
			-- Выжившего на плече маньяк видит полупрозрачным, иначе тот закрывает обзор
			local carried = iAmKiller and p:GetAttribute("Status") == "Carried"
			setModifier(char, carried and 0.75 or 0)
			continue
		end
		local state = p:GetAttribute("PowerState")
		if p ~= player then
			local value = 0
			if state == "Cloaked" then
				value = 0.93 + math.sin(os.clock() * 3) * 0.03
			elseif state == "Cloaking" or state == "Uncloaking" then
				value = 0.5 + math.sin(os.clock() * 20) * 0.3
			end
			setModifier(char, value)
		else
			-- Своё красное пятно маньяк не видит
			local head = char:FindFirstChild("Head")
			local stain = head and head:FindFirstChild("RedStain") :: SpotLight?
			if stain and stain.Enabled then
				stain.Enabled = false
			end
		end
	end
end

------------------------------------------------------------------------
-- Поршни генераторов
------------------------------------------------------------------------

local genState = {} :: { [Instance]: { Last: number, Active: number, Base: { [BasePart]: CFrame } } }

local function updateGenerators(dt: number)
	local map = workspace:FindFirstChild("Map")
	local gens = map and map:FindFirstChild("Generators")
	if not gens then
		table.clear(genState)
		return
	end
	local camPos = camera.CFrame.Position
	for _, gen in gens:GetChildren() do
		local body = (gen :: Model).PrimaryPart
		if not body or (body.Position - camPos).Magnitude > 90 then
			continue
		end
		local st = genState[gen]
		if not st then
			st = { Last = gen:GetAttribute("Progress") or 0, Active = 0, Base = {} }
			for _, d in gen:GetDescendants() do
				if d:IsA("BasePart") and d:GetAttribute("AnimatedPiston") then
					st.Base[d] = d.CFrame
				end
			end
			genState[gen] = st
		end
		local p = gen:GetAttribute("Progress") or 0
		if p > st.Last + 1e-5 then
			st.Active = 0.4
		end
		st.Last = p
		st.Active -= dt
		local running = st.Active > 0 or gen:GetAttribute("Done")
		local i = 0
		for piston, base in st.Base do
			i += 1
			local offset = running and math.sin(os.clock() * 22 + i * math.pi) * 0.22 or 0
			piston.CFrame = base * CFrame.new(offset, 0, 0)
		end
	end
end

------------------------------------------------------------------------
-- Шум (видит маньяк)
------------------------------------------------------------------------

function Effects.noise(position: Vector3)
	local p = fxPart({
		Name = "Noise",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(position + Vector3.new(0, 4, 0)),
		Transparency = 1,
	})
	local bb = Instance.new("BillboardGui")
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(70, 70)
	bb.Parent = p
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(1, 1)
	l.Text = "!"
	l.TextScaled = true
	l.Font = Enum.Font.GothamBlack
	l.TextColor3 = Color3.fromRGB(255, 200, 40)
	l.TextStrokeTransparency = 0.3
	l.Parent = bb
	TweenService:Create(l, TweenInfo.new(4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(p, 4)
end

function Effects.update(dt: number)
	updateTracks(dt)
	updateProjectiles(dt)
	updateCloak()
	updateGenerators(dt)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">Input</string>
            <string name="Source"><![CDATA[-- Управление (клавиатура, геймпад, сенсорные кнопки на телефоне).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local SkillCheck = require(script.Parent.UI.SkillCheck)
local CameraController = require(script.Parent.CameraController)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Input = {}

Input.Primary = nil :: any
Input.Secondary = nil :: any

local holding = false
local sprinting = false
local crouching = false
local itemHeld = false
local boundRole: string? = nil

local Sink = Enum.ContextActionResult.Sink
local Pass = Enum.ContextActionResult.Pass
local Begin = Enum.UserInputState.Begin

local function isEnd(state: Enum.UserInputState): boolean
	return state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel
end

local function onInteract(_, state)
	if state == Begin then
		if Input.Primary then
			holding = true
			Remotes.BeginAction:FireServer(Input.Primary.Kind, Input.Primary.Target)
		end
	elseif isEnd(state) and holding then
		holding = false
		Remotes.EndAction:FireServer()
	end
	return Sink
end

local function onSecondary(_, state)
	if state ~= Begin then
		return Sink
	end
	local check = SkillCheck.get()
	if check then
		check.Press()
	elseif Input.Secondary then
		Remotes.BeginAction:FireServer(Input.Secondary.Kind, Input.Secondary.Target)
	end
	return Sink
end

local function onSprint(_, state, input)
	if input.UserInputType == Enum.UserInputType.Touch then
		if state == Begin then
			sprinting = not sprinting
			Remotes.Sprint:FireServer(sprinting)
		end
	elseif state == Begin then
		sprinting = true
		Remotes.Sprint:FireServer(true)
	elseif isEnd(state) then
		sprinting = false
		Remotes.Sprint:FireServer(false)
	end
	-- Sink: иначе Shift заодно включает Shift Lock и камера «залипает»
	return Sink
end

local function onCrouch(_, state, input)
	if input.UserInputType == Enum.UserInputType.Touch then
		if state == Begin then
			crouching = not crouching
			Remotes.Crouch:FireServer(crouching)
		end
	elseif state == Begin then
		crouching = true
		Remotes.Crouch:FireServer(true)
	elseif isEnd(state) then
		crouching = false
		Remotes.Crouch:FireServer(false)
	end
	return Sink
end

local function onItem(_, state)
	if state == Begin then
		itemHeld = true
		Remotes.UseItem:FireServer(true, camera.CFrame.LookVector)
	elseif isEnd(state) then
		itemHeld = false
		Remotes.UseItem:FireServer(false, camera.CFrame.LookVector)
	end
	return Sink
end

local function onAttack(_, state)
	if state == Begin then
		Remotes.Attack:FireServer()
		if player:GetAttribute("Status") == "Playing" and not player:GetAttribute("Carrying") then
			CameraController.punch(-6)
		end
	end
	return Pass
end

local function onPower(_, state)
	if state == Begin then
		Remotes.UsePower:FireServer(true, camera.CFrame.LookVector)
	elseif isEnd(state) then
		Remotes.UsePower:FireServer(false, camera.CFrame.LookVector)
	end
	return Sink
end

local ACTIONS = { "DBDInteract", "DBDSecondary", "DBDSprint", "DBDCrouch", "DBDItem", "DBDAttack", "DBDPower" }

function Input.bind(role: string?)
	if boundRole == role then
		return
	end
	boundRole = role
	for _, name in ACTIONS do
		ContextActionService:UnbindAction(name)
	end
	if holding then
		holding = false
	end
	sprinting, crouching, itemHeld = false, false, false
	if not role then
		return
	end
	ContextActionService:BindActionAtPriority("DBDInteract", onInteract, true, 3000, Enum.KeyCode.E, Enum.KeyCode.ButtonX)
	ContextActionService:SetTitle("DBDInteract", "E")
	ContextActionService:SetPosition("DBDInteract", UDim2.new(1, -170, 1, -150))
	ContextActionService:BindActionAtPriority("DBDSecondary", onSecondary, true, 3000, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
	ContextActionService:SetTitle("DBDSecondary", "Прыг")
	ContextActionService:SetPosition("DBDSecondary", UDim2.new(1, -95, 1, -95))
	if role == "Survivor" then
		ContextActionService:BindActionAtPriority(
			"DBDSprint",
			onSprint,
			true,
			3000,
			Enum.KeyCode.LeftShift,
			Enum.KeyCode.RightShift,
			Enum.KeyCode.ButtonL3
		)
		ContextActionService:SetTitle("DBDSprint", "Бег")
		ContextActionService:SetPosition("DBDSprint", UDim2.new(1, -170, 1, -80))
		ContextActionService:BindActionAtPriority("DBDCrouch", onCrouch, true, 3000, Enum.KeyCode.LeftControl, Enum.KeyCode.C, Enum.KeyCode.ButtonB)
		ContextActionService:SetTitle("DBDCrouch", "Присесть")
		ContextActionService:SetPosition("DBDCrouch", UDim2.new(1, -245, 1, -80))
		ContextActionService:BindActionAtPriority("DBDItem", onItem, true, 3000, Enum.KeyCode.R, Enum.KeyCode.ButtonL2)
		ContextActionService:SetTitle("DBDItem", "Предмет")
		ContextActionService:SetPosition("DBDItem", UDim2.new(1, -245, 1, -150))
	else
		ContextActionService:BindAction("DBDAttack", onAttack, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
		ContextActionService:SetTitle("DBDAttack", "Удар")
		ContextActionService:SetPosition("DBDAttack", UDim2.new(1, -245, 1, -110))
		ContextActionService:BindActionAtPriority(
			"DBDPower",
			onPower,
			true,
			3000,
			Enum.UserInputType.MouseButton2,
			Enum.KeyCode.Q,
			Enum.KeyCode.ButtonL2
		)
		ContextActionService:SetTitle("DBDPower", "Сила")
		ContextActionService:SetPosition("DBDPower", UDim2.new(1, -245, 1, -180))
	end
end

-- Пока светим фонариком, отправляем направление камеры
local aimTimer = 0
function Input.update(dt: number)
	if itemHeld and player:GetAttribute("Item") == "Flashlight" then
		aimTimer -= dt
		if aimTimer <= 0 then
			aimTimer = 0.1
			Remotes.UseItem:FireServer(true, camera.CFrame.LookVector)
		end
	end
end

return Input
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="102">
          <Properties>
            <string name="Name">Interaction</string>
            <string name="Source"><![CDATA[-- Поиск ближайшего доступного действия для подсказки и нажатия.
-- primary — кнопка E (держать), secondary — Пробел.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Util = require(ReplicatedStorage.Shared.Util)
local ActionInfo = require(ReplicatedStorage.Shared.ActionInfo)
local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)

local player = Players.LocalPlayer
local gameState = ReplicatedStorage:WaitForChild("GameState")

local Interaction = {}

export type Candidate = { Kind: string, Target: Instance, Text: string }

local function children(name: string): { Instance }
	local map = workspace:FindFirstChild("Map")
	local f = map and map:FindFirstChild(name)
	return f and f:GetChildren() or {}
end

local function hatch(): Instance?
	local map = workspace:FindFirstChild("Map")
	return map and map:FindFirstChild("Hatch")
end

local function add(list, kind: string, target: Instance, text: string?)
	table.insert(list, { Kind = kind, Target = target, Text = text or ActionInfo[kind].Label })
end

local function nearest(rootPos: Vector3, candidates): Candidate?
	local best, bestDist = nil, math.huge
	for _, c in candidates do
		local pos = Util.objectPosition(c.Target)
		if pos then
			local d = Util.flatDist(rootPos, pos)
			if d <= ActionInfo[c.Kind].Range and d < bestDist and math.abs(rootPos.Y - pos.Y) < 9 then
				best, bestDist = c, d
			end
		end
	end
	return best
end

local function myTrap(): Instance?
	for _, trap in children("Traps") do
		if trap:GetAttribute("Caught") == player.UserId then
			return trap
		end
	end
	return nil
end

local function myLocker(): Instance?
	for _, l in children("Lockers") do
		if l:GetAttribute("Occupant") == player.UserId then
			return l
		end
	end
	return nil
end

local function survivorCandidates(primary, secondary)
	if player:GetAttribute("Hidden") then
		local locker = myLocker()
		if locker then
			add(secondary, "ExitLocker", locker)
		end
		return true
	end
	if player:GetAttribute("Trapped") then
		local trap = myTrap()
		if trap then
			add(primary, "EscapeTrap", trap)
		end
		return true
	end
	if (player:GetAttribute("Health") or 0) <= 0 then
		return true
	end
	for _, p in Players:GetPlayers() do
		if p ~= player and p:GetAttribute("Role") == "Survivor" then
			local status = p:GetAttribute("Status")
			local health = p:GetAttribute("Health") or 2
			if status == "Hooked" then
				add(primary, "Unhook", p, "Снять " .. p.DisplayName .. " с крюка")
			elseif status == "Playing" and health < 2 and not p:GetAttribute("Hidden") and not p:GetAttribute("Trapped") then
				add(primary, "Heal", p, (health == 0 and "Поднять " or "Лечить ") .. p.DisplayName)
			end
		end
	end
	if (gameState:GetAttribute("GensLeft") or 0) > 0 then
		for _, gen in children("Generators") do
			if not gen:GetAttribute("Done") then
				add(primary, "Repair", gen)
			end
		end
	end
	for _, gate in children("ExitGates") do
		if gate:GetAttribute("Powered") and not gate:GetAttribute("Open") then
			add(primary, "OpenGate", gate)
		end
	end
	for _, totem in children("Totems") do
		if not totem:GetAttribute("Cleansed") then
			add(primary, "Cleanse", totem, totem:GetAttribute("Hex") and "Очистить проклятый тотем" or nil)
		end
	end
	for _, chest in children("Chests") do
		if not chest:GetAttribute("Opened") then
			add(primary, "OpenChest", chest)
		end
	end
	for _, trap in children("Traps") do
		local caught = trap:GetAttribute("Caught") or 0
		if caught ~= 0 then
			add(primary, "FreeTrap", trap)
		elseif trap:GetAttribute("Armed") then
			add(primary, "DisarmTrap", trap)
		end
	end
	local h = hatch()
	if h and h:GetAttribute("Open") then
		add(primary, "JumpHatch", h)
	end
	for _, pallet in children("Pallets") do
		local state = pallet:GetAttribute("State")
		if state == "Up" then
			add(secondary, "DropPallet", pallet)
		elseif state == "Dropped" then
			add(secondary, "Vault", pallet, "Перепрыгнуть паллету")
		end
	end
	for _, window in children("Windows") do
		add(secondary, "Vault", window, "Перелезть через окно")
	end
	for _, locker in children("Lockers") do
		if locker:GetAttribute("Occupant") == 0 then
			add(secondary, "EnterLocker", locker)
		end
	end
	return false
end

local function killerCandidates(primary, secondary)
	if player:GetAttribute("Stunned") or player:GetAttribute("Blinded") then
		return
	end
	if player:GetAttribute("Carrying") then
		for _, hook in children("Hooks") do
			if hook:GetAttribute("Occupant") == 0 then
				add(primary, "Hook", hook)
			end
		end
		return
	end
	local cloaked = player:GetAttribute("PowerState") == "Cloaked"
	if not cloaked then
		for _, p in Players:GetPlayers() do
			if p:GetAttribute("Role") == "Survivor" and p:GetAttribute("Status") == "Playing" and not p:GetAttribute("Hidden") then
				if p:GetAttribute("Health") == 0 or p:GetAttribute("Trapped") then
					add(primary, "Pickup", p, "Поднять " .. p.DisplayName)
				end
			end
		end
	end
	for _, pallet in children("Pallets") do
		if pallet:GetAttribute("State") == "Dropped" then
			add(primary, "Break", pallet)
		end
	end
	if (gameState:GetAttribute("GensLeft") or 0) > 0 then
		for _, gen in children("Generators") do
			if not gen:GetAttribute("Done") and (gen:GetAttribute("Progress") or 0) > 0 and not gen:GetAttribute("Regressing") then
				add(primary, "Kick", gen)
			end
		end
	end
	local huntress = player:GetAttribute("KillerType") == "Huntress"
	for _, locker in children("Lockers") do
		add(primary, "SearchLocker", locker, huntress and "Обыскать шкафчик / взять топоры" or nil)
	end
	local h = hatch()
	if h and h:GetAttribute("Open") then
		add(primary, "CloseHatch", h)
	end
	if player:GetAttribute("KillerType") == "Trapper" then
		local inHand = player:GetAttribute("PowerCount") or 0
		for _, trap in children("Traps") do
			if (trap:GetAttribute("Caught") or 0) == 0 then
				if not trap:GetAttribute("Armed") then
					add(primary, "ResetTrap", trap)
				elseif inHand < KillerDefs.Trapper.MaxTrapsInHand then
					add(primary, "PickupTrap", trap)
				end
			end
		end
	end
	for _, window in children("Windows") do
		add(secondary, "Vault", window, "Перелезть через окно")
	end
end

function Interaction.find(): (Candidate?, Candidate?)
	local root = Util.getRoot(player)
	local role = player:GetAttribute("Role")
	if not root or not role or player:GetAttribute("Status") ~= "Playing" or player:GetAttribute("ActionName") then
		return nil, nil
	end
	local primary, secondary = {}, {}
	local pos = root.Position
	if role == "Survivor" then
		local exclusive = survivorCandidates(primary, secondary)
		if exclusive then
			-- Из шкафчика / капкана есть только одно действие
			return primary[1], secondary[1]
		end
	else
		killerCandidates(primary, secondary)
	end
	return nearest(pos, primary), nearest(pos, secondary)
end

return Interaction
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="103">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- Основной интерфейс: генераторы, портреты выживших, подсказки, полоски,
-- способность/предмет, очки крови, уведомления, затемнения и эффекты экрана.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)
local ItemDefs = require(ReplicatedStorage.Shared.ItemDefs)
local Widgets = require(script.Parent.Widgets)
local SkillCheck = require(script.Parent.SkillCheck)

local new, label = Widgets.new, Widgets.label
local player = Players.LocalPlayer

local Hud = {}

local gui: ScreenGui
local edges = {}
local blindOverlay: Frame
local fadeOverlay: Frame
local fadeText: TextLabel
local genFrame: Frame
local genLabel: TextLabel
local genSub: TextLabel
local top: TextLabel
local topSub: TextLabel
local notifyHolder: Frame
local scoreHolder: Frame
local portraitHolder: Frame
local portraits = {}
local hintPrimary: TextLabel
local hintSecondary: TextLabel
local actionBar
local statusBar
local powerPanel: Frame
local powerTitle: TextLabel
local powerInfo: TextLabel
local powerBar
local controls: TextLabel
local notifyOrder = 0

function Hud.mount(playerGui: PlayerGui)
	gui = new("ScreenGui", {
		Name = "DBDHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	Hud.Gui = gui

	-- Красная виньетка радиуса ужаса
	for _, data in
		{
			{ UDim2.fromScale(1, 0.22), UDim2.fromScale(0, 0), 90 },
			{ UDim2.fromScale(1, 0.22), UDim2.fromScale(0, 0.78), -90 },
			{ UDim2.fromScale(0.18, 1), UDim2.fromScale(0, 0), 0 },
			{ UDim2.fromScale(0.18, 1), UDim2.fromScale(0.82, 0), 180 },
		}
	do
		table.insert(
			edges,
			new("Frame", {
				Parent = gui,
				Size = data[1],
				Position = data[2],
				BackgroundColor3 = Color3.fromRGB(150, 0, 0),
				BorderSizePixel = 0,
				BackgroundTransparency = 1,
				ZIndex = 0,
			}, { new("UIGradient", { Rotation = data[3], Transparency = NumberSequence.new(0, 1) }) })
		)
	end

	-- Счётчик генераторов (слева сверху)
	genFrame = new("Frame", {
		Parent = gui,
		Position = UDim2.fromOffset(16, 56),
		Size = UDim2.fromOffset(230, 64),
		BackgroundColor3 = Widgets.DARK,
		BackgroundTransparency = 0.35,
		Visible = false,
	}, { Widgets.corner(6), Widgets.stroke(Widgets.RED, 1, 0.4) })
	genLabel = label({
		Parent = genFrame,
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -24, 0, 32),
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
	})
	genSub = label({
		Parent = genFrame,
		Position = UDim2.fromOffset(12, 36),
		Size = UDim2.new(1, -24, 0, 22),
		TextSize = 14,
		Font = Widgets.FONT_REG,
		TextColor3 = Color3.fromRGB(255, 110, 90),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
	})

	top = label({
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 48),
		Size = UDim2.new(0.6, 0, 0, 32),
		TextSize = 24,
		Text = "",
	})
	topSub = label({
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 80),
		Size = UDim2.new(0.6, 0, 0, 22),
		TextSize = 17,
		TextColor3 = Color3.fromRGB(255, 120, 100),
		Text = "",
	})

	notifyHolder = new("Frame", {
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 110),
		Size = UDim2.new(0.7, 0, 0, 160),
		BackgroundTransparency = 1,
	}, {
		new("UIListLayout", {
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 2),
		}),
	})

	scoreHolder = new("Frame", {
		Parent = gui,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.42, 0),
		Size = UDim2.fromOffset(260, 200),
		BackgroundTransparency = 1,
	}, {
		new("UIListLayout", {
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 2),
		}),
	})

	-- Портреты выживших (слева снизу)
	portraitHolder = new("Frame", {
		Parent = gui,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -20),
		Size = UDim2.fromOffset(250, 230),
		BackgroundTransparency = 1,
	}, {
		new("UIListLayout", {
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 5),
		}),
	})

	hintPrimary = label({
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -150),
		Size = UDim2.new(0.6, 0, 0, 26),
		TextSize = 20,
		Text = "",
	})
	hintSecondary = label({
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -124),
		Size = UDim2.new(0.6, 0, 0, 26),
		TextSize = 20,
		Text = "",
	})
	actionBar = Widgets.bar(gui, UDim2.new(0.5, 0, 1, -92), UDim2.fromOffset(340, 14))
	statusBar = Widgets.bar(gui, UDim2.new(0.5, 0, 1, -200), UDim2.fromOffset(340, 10), Color3.fromRGB(200, 40, 40))

	-- Способность / предмет (справа снизу)
	powerPanel = new("Frame", {
		Parent = gui,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -20),
		Size = UDim2.fromOffset(260, 74),
		BackgroundColor3 = Widgets.DARK,
		BackgroundTransparency = 0.35,
		Visible = false,
	}, { Widgets.corner(6), Widgets.stroke(Widgets.RED, 1, 0.4) })
	powerTitle = label({
		Parent = powerPanel,
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -24, 0, 22),
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	powerInfo = label({
		Parent = powerPanel,
		Position = UDim2.fromOffset(12, 28),
		Size = UDim2.new(1, -24, 0, 18),
		TextSize = 13,
		Font = Widgets.FONT_REG,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(210, 210, 210),
	})
	powerBar = Widgets.bar(powerPanel, UDim2.new(0.5, 0, 1, -12), UDim2.new(1, -24, 0, 8), Color3.fromRGB(230, 200, 120))
	powerBar.Label.Visible = false

	controls = label({
		Parent = gui,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -104),
		Size = UDim2.fromOffset(360, 110),
		TextSize = 13,
		Font = Widgets.FONT_REG,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		TextTransparency = 0.25,
		Text = "",
	})

	-- Белая вспышка (ослепление) и затемнение (начало раунда)
	blindOverlay = new("Frame", {
		Parent = gui,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		ZIndex = 20,
	})
	fadeOverlay = new("Frame", {
		Parent = gui,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		ZIndex = 30,
	})
	fadeText = label({
		Parent = fadeOverlay,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.8, 0, 0, 120),
		TextSize = 48,
		Font = Widgets.FONT_TITLE,
		TextColor3 = Color3.fromRGB(200, 30, 30),
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		ZIndex = 31,
	})

	SkillCheck.mount(gui)
end

------------------------------------------------------------------------

function Hud.setTop(text: string?, sub: string?)
	top.Text = text or ""
	topSub.Text = sub or ""
end

function Hud.setGenerators(visible: boolean, text: string?, sub: string?)
	genFrame.Visible = visible
	genLabel.Text = text or ""
	genSub.Text = sub or ""
end

function Hud.setControls(text: string)
	controls.Text = text
end

function Hud.notify(text: string, color: Color3?)
	notifyOrder += 1
	local l = label({
		Parent = notifyHolder,
		LayoutOrder = notifyOrder,
		Size = UDim2.new(1, 0, 0, 24),
		TextSize = 20,
		Text = text,
		TextColor3 = color or Color3.new(1, 1, 1),
	})
	local labels = {}
	for _, c in notifyHolder:GetChildren() do
		if c:IsA("TextLabel") then
			table.insert(labels, c)
		end
	end
	if #labels > 5 then
		table.sort(labels, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		labels[1]:Destroy()
	end
	task.delay(4.5, function()
		if l.Parent then
			local tw = TweenService:Create(l, TweenInfo.new(1), { TextTransparency = 1, TextStrokeTransparency = 1 })
			tw:Play()
			tw.Completed:Wait()
			l:Destroy()
		end
	end)
end

function Hud.score(text: string, amount: number)
	notifyOrder += 1
	local l = label({
		Parent = scoreHolder,
		LayoutOrder = notifyOrder,
		Size = UDim2.new(1, 0, 0, 22),
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Right,
		RichText = true,
		Text = string.format('<font color="#ff4d4d">+%d</font>  %s', amount, text),
	})
	task.delay(3, function()
		if l.Parent then
			local tw = TweenService:Create(l, TweenInfo.new(0.8), { TextTransparency = 1, TextStrokeTransparency = 1 })
			tw:Play()
			tw.Completed:Wait()
			l:Destroy()
		end
	end)
end

function Hud.setHints(primary: string?, secondary: string?)
	hintPrimary.Text = primary or ""
	hintSecondary.Text = secondary or ""
end

function Hud.setAction(text: string?, fraction: number?)
	Widgets.setBar(actionBar, text, fraction)
end

function Hud.setStatus(text: string?, fraction: number?)
	Widgets.setBar(statusBar, text, fraction)
end

function Hud.setTerror(intensity: number)
	for _, f in edges do
		f.BackgroundTransparency = 1 - math.clamp(intensity, 0, 1) * 0.75
	end
end

------------------------------------------------------------------------
-- Портреты выживших
------------------------------------------------------------------------

local STATE_INFO = {
	Healthy = { "ЗДОРОВ", Color3.fromRGB(220, 220, 220) },
	Injured = { "РАНЕН", Color3.fromRGB(255, 160, 60) },
	Downed = { "ПОВЕРЖЕН", Color3.fromRGB(255, 70, 70) },
	Carried = { "НЕСУТ", Color3.fromRGB(255, 70, 70) },
	Hooked = { "НА КРЮКЕ", Color3.fromRGB(255, 40, 40) },
	Trapped = { "В КАПКАНЕ", Color3.fromRGB(255, 120, 60) },
	Dead = { "ПОГИБ", Color3.fromRGB(110, 110, 110) },
	Left = { "ВЫШЕЛ", Color3.fromRGB(110, 110, 110) },
	Escaped = { "СБЕЖАЛ", Color3.fromRGB(110, 255, 140) },
}

local function stateKey(p: Player): string
	local status = p:GetAttribute("Status") or "Playing"
	if status ~= "Playing" then
		return status
	end
	if p:GetAttribute("Trapped") then
		return "Trapped"
	end
	local h = p:GetAttribute("Health") or 2
	return h == 2 and "Healthy" or (h == 1 and "Injured" or "Downed")
end

local function makePortrait(index: number)
	local frame = new("Frame", {
		Parent = portraitHolder,
		LayoutOrder = index,
		Size = UDim2.fromOffset(250, 42),
		BackgroundColor3 = Widgets.DARK,
		BackgroundTransparency = 0.3,
	}, { Widgets.corner(5) })
	local stripe = new("Frame", {
		Parent = frame,
		Size = UDim2.new(0, 5, 1, 0),
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.new(1, 1, 1),
	})
	local name = label({
		Parent = frame,
		Position = UDim2.fromOffset(14, 2),
		Size = UDim2.new(1, -60, 0, 20),
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local state = label({
		Parent = frame,
		Position = UDim2.fromOffset(14, 21),
		Size = UDim2.new(1, -60, 0, 18),
		TextSize = 12,
		Font = Widgets.FONT_REG,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local pips = {}
	for i = 1, 2 do
		table.insert(
			pips,
			new("Frame", {
				Parent = frame,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10 - (2 - i) * 18, 0.5, 0),
				Size = UDim2.fromOffset(12, 12),
				Rotation = 45,
				BorderSizePixel = 0,
				BackgroundColor3 = Color3.fromRGB(60, 60, 60),
			})
		)
	end
	local bar = new("Frame", {
		Parent = frame,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 5, 1, 0),
		Size = UDim2.new(0, 0, 0, 3),
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromRGB(220, 40, 40),
	})
	return { Frame = frame, Stripe = stripe, Name = name, State = state, Pips = pips, Bar = bar }
end

function Hud.updatePortraits(visible: boolean)
	local list = {}
	if visible then
		for _, p in Players:GetPlayers() do
			if p:GetAttribute("Role") == "Survivor" then
				table.insert(list, p)
			end
		end
		table.sort(list, function(a, b)
			return a.UserId < b.UserId
		end)
	end
	for i, p in list do
		local row = portraits[i] or makePortrait(i)
		portraits[i] = row
		row.Frame.Visible = true
		local key = stateKey(p)
		local info = STATE_INFO[key] or STATE_INFO.Healthy
		row.Name.Text = p.DisplayName .. (p == player and " (ты)" or "")
		local item = p:GetAttribute("Item")
		row.State.Text = info[1] .. (item and ("  •  " .. ItemDefs[item].Name) or "")
		row.State.TextColor3 = info[2]
		row.Stripe.BackgroundColor3 = info[2]
		local hooks = p:GetAttribute("HookCount") or 0
		for j, pip in row.Pips do
			pip.BackgroundColor3 = hooks >= j and Color3.fromRGB(220, 30, 30) or Color3.fromRGB(60, 60, 60)
		end
		local f = p:GetAttribute("HookProgress") or p:GetAttribute("BleedOut")
		row.Bar.Size = UDim2.new(f and (1 - f) or 0, -5, 0, 3)
	end
	for i = #list + 1, #portraits do
		portraits[i].Frame.Visible = false
	end
end

------------------------------------------------------------------------
-- Способность маньяка / предмет выжившего
------------------------------------------------------------------------

function Hud.updatePower()
	local role = player:GetAttribute("Role")
	if role == "Killer" then
		local def = KillerDefs.get(player:GetAttribute("KillerType"))
		powerPanel.Visible = true
		powerTitle.Text = def.Name .. " — " .. def.PowerName
		local count = player:GetAttribute("PowerCount")
		if def.Id == "Trapper" then
			powerInfo.Text = string.format("Капканы в руках: %d   •   %s", count or 0, def.PowerHint)
			Widgets.setBar(powerBar, nil, nil)
		elseif def.Id == "Huntress" then
			powerInfo.Text = string.format("Топоры: %d/%d   •   %s", count or 0, def.MaxHatchets, "ПКМ/Q")
			local charge = player:GetAttribute("PowerCharge") or 0
			Widgets.setBar(powerBar, nil, charge > 0 and charge or nil)
		else
			local state = player:GetAttribute("PowerState") or "Visible"
			local names = { Visible = "видим", Cloaking = "звонит в колокол...", Uncloaking = "проявляется...", Cloaked = "НЕВИДИМ" }
			powerInfo.Text = "Состояние: " .. (names[state] or state) .. "   •   ПКМ/Q"
			Widgets.setBar(powerBar, nil, nil)
		end
	elseif role == "Survivor" and player:GetAttribute("Item") then
		local item = player:GetAttribute("Item")
		local def = ItemDefs[item]
		powerPanel.Visible = true
		powerTitle.Text = def.Name
		powerInfo.Text = def.Hint
		local max = player:GetAttribute("ItemMax") or 1
		Widgets.setBar(powerBar, nil, (player:GetAttribute("ItemCharges") or 0) / max)
	else
		powerPanel.Visible = false
	end
end

------------------------------------------------------------------------
-- Эффекты экрана
------------------------------------------------------------------------

function Hud.blind(duration: number)
	blindOverlay.BackgroundTransparency = 0
	TweenService:Create(blindOverlay, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		BackgroundTransparency = 1,
	}):Play()
end

function Hud.intro(text: string, sub: string?)
	fadeOverlay.BackgroundTransparency = 0
	fadeText.Text = text .. (sub and ("\n" .. sub) or "")
	fadeText.TextTransparency = 0
	task.delay(2, function()
		TweenService:Create(fadeOverlay, TweenInfo.new(1.5), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(fadeText, TweenInfo.new(1.2), { TextTransparency = 1 }):Play()
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="105">
            <Properties>
              <string name="Name">LobbyUI</string>
              <string name="Source"><![CDATA[-- Меню лобби: очки крови, «хочу быть маньяком», выбор маньяка.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Widgets = require(script.Parent.Widgets)

local new, label = Widgets.new, Widgets.label
local player = Players.LocalPlayer

local LobbyUI = {}

local panel: Frame
local bloodLabel: TextLabel
local wantButton: TextButton
local cards = {}

local function refresh()
	local want = player:GetAttribute("WantKiller") == true
	wantButton.Text = want and "Хочу быть маньяком: ДА" or "Хочу быть маньяком: НЕТ"
	wantButton.BackgroundColor3 = want and Color3.fromRGB(110, 20, 20) or Color3.fromRGB(35, 25, 25)
	local choice = player:GetAttribute("KillerChoice") or "Trapper"
	for id, card in cards do
		local selected = id == choice
		card.Stroke.Color = selected and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(80, 40, 40)
		card.Stroke.Thickness = selected and 2 or 1
		card.Frame.BackgroundTransparency = selected and 0.1 or 0.35
	end
	bloodLabel.Text = "Очки крови: " .. tostring(player:GetAttribute("Bloodpoints") or 0)
end

function LobbyUI.mount(gui: ScreenGui)
	panel = new("Frame", {
		Name = "Lobby",
		Parent = gui,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, 0),
		Size = UDim2.fromOffset(300, 420),
		BackgroundColor3 = Widgets.DARK,
		BackgroundTransparency = 0.25,
		Visible = false,
	}, { Widgets.corner(8), Widgets.stroke(Widgets.RED, 1, 0.3) })
	label({
		Parent = panel,
		Position = UDim2.fromOffset(0, 8),
		Size = UDim2.new(1, 0, 0, 40),
		Text = "DEAD BY DAYLIGHT",
		Font = Widgets.FONT_TITLE,
		TextSize = 34,
		TextColor3 = Color3.fromRGB(200, 25, 25),
	})
	bloodLabel = label({
		Parent = panel,
		Position = UDim2.fromOffset(0, 48),
		Size = UDim2.new(1, 0, 0, 20),
		TextSize = 15,
		TextColor3 = Color3.fromRGB(255, 90, 90),
	})
	wantButton = Widgets.button({
		Parent = panel,
		Position = UDim2.fromOffset(16, 78),
		Size = UDim2.new(1, -32, 0, 36),
	})
	wantButton.Activated:Connect(function()
		Remotes.LobbyChoice:FireServer("WantKiller", not player:GetAttribute("WantKiller"))
	end)
	label({
		Parent = panel,
		Position = UDim2.fromOffset(16, 120),
		Size = UDim2.new(1, -32, 0, 20),
		Text = "Маньяк (если выпадет роль):",
		TextSize = 14,
		Font = Widgets.FONT_REG,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	for i, id in KillerDefs.Order do
		local def = KillerDefs[id]
		local stroke = Widgets.stroke(Color3.fromRGB(80, 40, 40), 1, 0)
		local frame = new("TextButton", {
			Parent = panel,
			Position = UDim2.fromOffset(16, 146 + (i - 1) * 88),
			Size = UDim2.new(1, -32, 0, 80),
			BackgroundColor3 = Color3.fromRGB(30, 18, 18),
			BackgroundTransparency = 0.35,
			Text = "",
			AutoButtonColor = true,
		}, { Widgets.corner(6), stroke })
		label({
			Parent = frame,
			Position = UDim2.fromOffset(10, 4),
			Size = UDim2.new(1, -20, 0, 22),
			Text = def.Name .. "  —  " .. def.PowerName,
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		label({
			Parent = frame,
			Position = UDim2.fromOffset(10, 26),
			Size = UDim2.new(1, -20, 0, 50),
			Text = def.Description,
			TextSize = 12,
			Font = Widgets.FONT_REG,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextColor3 = Color3.fromRGB(200, 200, 200),
		})
		frame.Activated:Connect(function()
			Remotes.LobbyChoice:FireServer("Killer", id)
		end)
		cards[id] = { Frame = frame, Stroke = stroke }
	end
	for _, attr in { "WantKiller", "KillerChoice", "Bloodpoints" } do
		player:GetAttributeChangedSignal(attr):Connect(refresh)
	end
	refresh()
end

function LobbyUI.setVisible(visible: boolean)
	panel.Visible = visible
end

return LobbyUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">Results</string>
              <string name="Source"><![CDATA[-- Экран итогов раунда с очками крови по категориям.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local KillerDefs = require(ReplicatedStorage.Shared.KillerDefs)
local Widgets = require(script.Parent.Widgets)

local new, label = Widgets.new, Widgets.label

local Results = {}

local panel: Frame
local title: TextLabel
local reason: TextLabel
local list: Frame

local STATUS_TEXT = {
	Escaped = '<font color="#6eff8c">сбежал</font>',
	Dead = '<font color="#ff5050">принесён в жертву</font>',
	Left = '<font color="#aaaaaa">вышел</font>',
	Playing = '<font color="#ffdc5a">выжил</font>',
	Hooked = '<font color="#ff5050">на крюке</font>',
	Carried = '<font color="#ff5050">в руках маньяка</font>',
}

function Results.mount(gui: ScreenGui)
	panel = new("Frame", {
		Name = "Results",
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(620, 420),
		BackgroundColor3 = Color3.fromRGB(12, 8, 8),
		BackgroundTransparency = 0.08,
		Visible = false,
		ZIndex = 10,
	}, { Widgets.corner(10), Widgets.stroke(Color3.fromRGB(150, 20, 20), 2, 0) })
	title = label({
		Parent = panel,
		Position = UDim2.fromOffset(0, 10),
		Size = UDim2.new(1, 0, 0, 44),
		TextSize = 40,
		Font = Widgets.FONT_TITLE,
		TextColor3 = Color3.fromRGB(230, 50, 50),
		ZIndex = 11,
	})
	reason = label({
		Parent = panel,
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 0, 20),
		TextSize = 15,
		Font = Widgets.FONT_REG,
		ZIndex = 11,
	})
	list = new("ScrollingFrame", {
		Parent = panel,
		Position = UDim2.fromOffset(16, 84),
		Size = UDim2.new(1, -32, 1, -100),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 11,
	}, { new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
end

function Results.show(titleText: string, reasonText: string, rows, duration: number)
	title.Text = titleText
	reason.Text = reasonText
	for _, c in list:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	for i, row in rows do
		local frame = new("Frame", {
			Parent = list,
			LayoutOrder = i,
			Size = UDim2.new(1, -6, 0, 58),
			BackgroundColor3 = row.Role == "Killer" and Color3.fromRGB(45, 12, 12) or Color3.fromRGB(28, 24, 24),
			BackgroundTransparency = 0.2,
			ZIndex = 11,
		}, { Widgets.corner(6) })
		local role = row.Role == "Killer" and ("Маньяк: " .. KillerDefs.get(row.KillerType).Name) or "Выживший"
		local status = row.Role == "Killer" and "" or ("  —  " .. (STATUS_TEXT[row.Status] or row.Status))
		label({
			Parent = frame,
			Position = UDim2.fromOffset(12, 4),
			Size = UDim2.new(0.7, 0, 0, 22),
			RichText = true,
			Text = string.format("<b>%s</b>  (%s)%s", row.Name, role, status),
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 12,
		})
		label({
			Parent = frame,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 4),
			Size = UDim2.new(0.3, 0, 0, 22),
			Text = tostring(row.Total) .. " очков",
			TextSize = 16,
			TextColor3 = Color3.fromRGB(255, 80, 80),
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 12,
		})
		local parts = {}
		for _, s in row.Score or {} do
			table.insert(parts, s.Name .. ": " .. s.Value)
		end
		label({
			Parent = frame,
			Position = UDim2.fromOffset(12, 30),
			Size = UDim2.new(1, -24, 0, 20),
			Text = table.concat(parts, "   •   "),
			TextSize = 13,
			Font = Widgets.FONT_REG,
			TextColor3 = Color3.fromRGB(200, 200, 200),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 12,
		})
	end
	panel.Visible = true
	task.delay(duration, function()
		panel.Visible = false
	end)
end

return Results
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="107">
            <Properties>
              <string name="Name">SkillCheck</string>
              <string name="Source"><![CDATA[-- Круглая проверка навыка, как в Dead by Daylight.
-- Кольцо — круг с обводкой, зона — дуга из маленьких повёрнутых квадратиков,
-- стрелка — повёрнутая полоска. Положения считаются через тригонометрию.
local Widgets = require(script.Parent.Widgets)
local new = Widgets.new

local SkillCheck = {}

local SIZE = 170
local RADIUS = 70

export type Check = {
	Press: () -> (),
	Update: () -> (),
	Cancel: () -> (),
	Done: boolean,
}

local root: Frame
local zoneHolder: Frame
local needle: Frame
local active: Check? = nil

local function pointOnCircle(angleDeg: number, r: number): UDim2
	local a = math.rad(angleDeg)
	return UDim2.new(0.5, math.sin(a) * r, 0.5, -math.cos(a) * r)
end

function SkillCheck.mount(parent: Instance)
	root = new("Frame", {
		Name = "SkillCheck",
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.55),
		Size = UDim2.fromOffset(SIZE, SIZE),
		BackgroundTransparency = 1,
		Visible = false,
	})
	new("Frame", {
		Parent = root,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(RADIUS * 2, RADIUS * 2),
		BackgroundTransparency = 1,
	}, { Widgets.corner(RADIUS), Widgets.stroke(Color3.new(1, 1, 1), 3, 0.1) })
	Widgets.label({
		Parent = root,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(80, 30),
		Text = "ПРОБЕЛ",
		TextSize = 14,
		TextTransparency = 0.2,
	})
	zoneHolder = new("Frame", { Parent = root, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
	needle = new("Frame", {
		Parent = root,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(4, RADIUS + 8),
		BackgroundColor3 = Color3.fromRGB(255, 40, 40),
		BorderSizePixel = 0,
		ZIndex = 5,
	})
end

local function drawZone(startDeg: number, endDeg: number, color: Color3, thickness: number)
	local a = startDeg
	while a <= endDeg do
		new("Frame", {
			Parent = zoneHolder,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = pointOnCircle(a, RADIUS),
			Size = UDim2.fromOffset(4, thickness),
			Rotation = a,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = 3,
		})
		a += 2
	end
end

local function setNeedle(angleDeg: number)
	needle.Position = pointOnCircle(angleDeg, (RADIUS + 8) / 2)
	needle.Rotation = angleDeg
end

-- zoneStart (0..1) от сервера, duration — время полного оборота
function SkillCheck.start(zoneStart: number, duration: number, onResult: (string) -> ()): Check
	if active then
		active.Cancel()
	end
	zoneHolder:ClearAllChildren()
	local GREAT = 0.035
	local ZONE = 0.13
	drawZone(zoneStart * 360, (zoneStart + GREAT) * 360, Color3.new(1, 1, 1), 14)
	drawZone((zoneStart + GREAT) * 360, (zoneStart + ZONE) * 360, Color3.fromRGB(200, 200, 200), 8)
	setNeedle(0)
	root.Visible = true

	local startAt = os.clock() + 0.55
	local check: Check
	local function finish(result: string)
		if check.Done then
			return
		end
		check.Done = true
		if active == check then
			active = nil
			root.Visible = false
		end
		onResult(result)
	end
	local function position(): number
		return math.clamp((os.clock() - startAt) / duration, 0, 1)
	end
	check = {
		Done = false,
		Press = function()
			if os.clock() < startAt then
				finish("fail")
				return
			end
			local p = position()
			if p >= zoneStart and p < zoneStart + GREAT then
				finish("great")
			elseif p >= zoneStart and p <= zoneStart + ZONE then
				finish("good")
			else
				finish("fail")
			end
		end,
		Update = function()
			setNeedle(position() * 360)
			if os.clock() > startAt + duration then
				finish("fail")
			end
		end,
		Cancel = function()
			check.Done = true
			if active == check then
				active = nil
				root.Visible = false
			end
		end,
	}
	active = check
	return check
end

function SkillCheck.get(): Check?
	return active
end

return SkillCheck
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="108">
            <Properties>
              <string name="Name">Widgets</string>
              <string name="Source"><![CDATA[-- Маленькие помощники для создания интерфейса из кода.
local Widgets = {}

Widgets.FONT = Enum.Font.GothamBold
Widgets.FONT_REG = Enum.Font.Gotham
Widgets.FONT_TITLE = Enum.Font.Creepster
Widgets.RED = Color3.fromRGB(190, 25, 25)
Widgets.DARK = Color3.fromRGB(14, 10, 10)

function Widgets.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end
local new = Widgets.new

function Widgets.corner(radius: number?): UICorner
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 6) })
end

function Widgets.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return new("UIStroke", {
		Color = color or Color3.fromRGB(200, 200, 200),
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Widgets.label(props: { [string]: any }): TextLabel
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.Font = props.Font or Widgets.FONT
	props.TextColor3 = props.TextColor3 or Color3.new(1, 1, 1)
	props.TextStrokeTransparency = props.TextStrokeTransparency or 0.6
	return new("TextLabel", props)
end

export type Bar = { Frame: Frame, Fill: Frame, Label: TextLabel }

function Widgets.bar(parent: Instance, position: UDim2, size: UDim2, color: Color3?): Bar
	local bg = new("Frame", {
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		Size = size,
		BackgroundColor3 = Color3.fromRGB(15, 15, 15),
		BackgroundTransparency = 0.2,
		Visible = false,
	}, { Widgets.corner(3), Widgets.stroke(Color3.fromRGB(180, 180, 180), 1, 0.3) })
	local fill = new("Frame", {
		Parent = bg,
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = color or Color3.fromRGB(230, 230, 230),
		BorderSizePixel = 0,
	}, { Widgets.corner(3) })
	local text = Widgets.label({
		Parent = bg,
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.new(0, 0, 0, -22),
		TextSize = 16,
	})
	return { Frame = bg, Fill = fill, Label = text }
end

function Widgets.setBar(bar: Bar, text: string?, fraction: number?)
	if fraction then
		bar.Frame.Visible = true
		bar.Fill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
		bar.Label.Text = text or ""
	else
		bar.Frame.Visible = false
	end
end

function Widgets.button(props: { [string]: any }): TextButton
	props.BackgroundColor3 = props.BackgroundColor3 or Color3.fromRGB(35, 25, 25)
	props.TextColor3 = props.TextColor3 or Color3.new(1, 1, 1)
	props.Font = props.Font or Widgets.FONT
	props.TextSize = props.TextSize or 16
	props.AutoButtonColor = true
	local b = new("TextButton", props, { Widgets.corner(6), Widgets.stroke(Widgets.RED, 1, 0.3) })
	return b
end

return Widgets
]]></string>
            </Properties>
          </Item>
        </Item>
