        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Driver</string>
            <string name="Source"><![CDATA[-- Привод суставов персонажа: поза -> пружины (Anim/Spring.lua) -> Motor6D.Transform.
-- Один на персонажа. Используется Animator'ом на клиенте и превью (tools/preview).
local Rig = require(script.Parent.Rig)
local Spring = require(script.Parent.Spring)

local Driver = {}

export type Driver = {
	Rig: Rig.RigData,
	Springs: { [string]: Spring.Rot },
	RootPos: Spring.Vec,
}

local ZERO = Vector3.zero
local IDENTITY = CFrame.identity

function Driver.new(rig: Rig.RigData): Driver
	local springs = {}
	for _, name in Rig.JointNames do
		springs[name] = Spring.rot(Spring.R6[name])
	end
	return { Rig = rig, Springs = springs, RootPos = Spring.vec(Spring.R6.RootPos) }
end

-- Следующая поза встанет сразу, без пружин (после долгого пропуска обновлений, телепорта)
function Driver.snap(d: Driver)
	for _, s in d.Springs do
		s.Target = nil
	end
	d.RootPos.Target = nil
end

-- Шаг пружин на dt к позе и запись Transform. stiffness — множитель частоты пружин
-- (резкие удары). Возвращает false, если суставы пропали (персонажа пересобрали).
function Driver.apply(d: Driver, pose: { [string]: any }, dt: number, stiffness: number?): boolean
	local rig = d.Rig
	local offset = Spring.stepVec(d.RootPos, pose.RootPos or ZERO, dt, stiffness) * rig.Scale
	for _, name in Rig.JointNames do
		local joint = rig.Joints[name]
		if not joint.Motor.Parent then
			return false
		end
		local rot = Spring.stepRot(d.Springs[name], pose[name] or IDENTITY, dt, stiffness)
		joint.Motor.Transform = Rig.transform(joint, rot, name == "Root" and offset or nil)
	end
	return true
end

return Driver
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Gait</string>
            <string name="Source"><![CDATA[-- Походка R6: шаг, бег, спринт, присед, хромота раненого, тяжёлый шаг маньяка, перенос выжившего
-- и «живое» стояние (дыхание, перенос веса, оглядывания).
--
-- Ноги R6 — жёсткие бруски без колен (длина 2, сечение 1×1, сустав сверху). Поэтому цикл шага
-- считается геометрически:
--   * опора: стопа стоит на земле. Угол ноги подбирается так, чтобы точка опоры (пятка, затем
--     носок — перекат по низу бруска) не двигалась, пока таз идёт вперёд со скоростью шага;
--     высота таза = досягаемость опорной ноги (низ в мировой земле, без проваливания);
--   * перенос: нога возвращается вперёд по кубической кривой (Эрмита) — с захлёстом назад после
--     отрыва и подтягиванием перед касанием;
--   * полёт (бег): обе ноги в воздухе, таз летит по дуге (Lift).
-- Частота шагов (Steps, шагов/с) задаётся в профиле, а доля опоры (Duty) выводится из неё так,
-- чтобы стопа не скользила: Duty = Steps · Stride / (2 · v). Фаза (Params.Phase) копится в
-- Animator по Gait.stepRate; касания — при фазе, кратной π (там же звук шагов).
-- Все углы «мировые» (относительно HumanoidRootPart) и переводятся в пространство торса,
-- поэтому наклон и скручивание корпуса не уводят ноги из-под тела.
local Rig = require(script.Parent.Rig)
local Clip = require(script.Parent.Clip)
local Life = require(script.Parent.Life)

local Gait = {}

export type Params = {
	Speed: number, -- скорость по земле (стад/с)
	Phase: number, -- фаза шага (радианы; 2π — два шага)
	Injured: boolean?,
	Crouching: boolean?,
	Killer: boolean?,
	Carrying: boolean?,
	Wiggle: number?,
	Struggle: boolean?,
	LookYaw: number?, -- поворот головы к маньяку (градусы)
	KillerType: string?,
	-- Необязательные (их считает Animator): по умолчанию — спокойное движение вперёд
	Scale: number?, -- масштаб персонажа: скорость делится на него (длина ног)
	Forward: number?, -- направление движения относительно взгляда: вперёд (-1..1)
	Strafe: number?, -- ...и вправо (-1..1); у маньяка от первого лица бывает бег боком/назад
	AccelForward: number?, -- сглаженное ускорение вперёд (стад/с²) — наклон при разгоне/торможении
	AccelSide: number?, -- сглаженное ускорение вправо (стад/с²) — крен в повороте
	TurnRate: number?, -- скорость поворота (рад/с, + влево) — голова смотрит в поворот
	Exertion: number?, -- усталость 0..1: после бега дышит глубже и сутулится
	Breath: number?, -- фаза дыхания (рад), копится в Animator с частотой по усталости
	Seed: number?, -- 0..1, у каждого персонажа своё (оглядывания не синхронны)
}

local sin, cos, abs, asin, clamp, rad, pi = math.sin, math.cos, math.abs, math.asin, math.clamp, math.rad, math.pi
local TAU = pi * 2
local A = Rig.A
local V = Vector3.new
local YXZ = CFrame.fromEulerAnglesYXZ
local IDENTITY = CFrame.identity
local smoothstep, glance = Life.smoothstep, Life.glance

------------------------------------------------------------------------
-- Профили походок: ключи по скорости (стад/с при масштабе 1), между ними — линейно
------------------------------------------------------------------------

type Key = {
	V: number, -- скорость
	Steps: number, -- шагов в секунду
	Reach: number, -- угол ноги вперёд при касании (°)
	Push: number, -- угол ноги назад при отрыве (°)
	Lift: number, -- подъём таза в полёте (стады)
	Sink: number, -- насколько опорная нога может «согнуться» (уйти под землю) ради плавного бега
	Bounce: number, -- просадка таза в середине опоры (вес, удар стопы)
	Lean: number, -- наклон корпуса вперёд (°)
	ArmF: number, -- мах руки вперёд (°)
	ArmB: number, -- мах руки назад (°)
	ArmBase: number, -- руки вынесены вперёд (°) — согнутые на бегу
	ArmOut: number, -- отведение рук от корпуса (°)
	Twist: number, -- скручивание плеч навстречу ногам (°)
	Roll: number, -- крен корпуса на опорную ногу (°)
	Sway: number, -- боковое смещение таза на опорную ногу (стады)
	Nod: number, -- наклон головы (°; минус — исподлобья)
}

local FIELDS = { "Steps", "Reach", "Push", "Lift", "Sink", "Bounce", "Lean", "ArmF", "ArmB", "ArmBase", "ArmOut", "Twist", "Roll", "Sway", "Nod" }
local DEFAULT: { [string]: number } = {
	Steps = 0,
	Reach = 0,
	Push = 0,
	Lift = 0,
	Sink = 0,
	Bounce = 0,
	Lean = 0,
	ArmF = 0,
	ArmB = 0,
	ArmBase = 0,
	ArmOut = 4,
	Twist = 0,
	Roll = 0,
	Sway = 0,
	Nod = 0,
}

local function K(t: { [string]: number }): Key
	for k, v in DEFAULT do
		if t[k] == nil then
			t[k] = v
		end
	end
	return (t :: any) :: Key
end

local PROFILES: { [string]: { Key } } = {
	-- выживший: шаг 10, бег 16, рывок после удара 22
	Survivor = {
		K({ V = 0 }),
		K({ V = 3, Steps = 2.2, Reach = 24, Push = 24, Lean = 2, ArmF = 12, ArmB = 10, Twist = 3, Roll = 1.5, Sway = 0.07 }),
		K({ V = 10, Steps = 3.3, Reach = 36, Push = 38, Lift = 0.05, Sink = 0.06, Bounce = 0.03, Lean = 6, ArmF = 32, ArmB = 26, ArmBase = 4, ArmOut = 5, Twist = 6, Roll = 2, Sway = 0.06 }),
		K({ V = 16, Steps = 3.7, Reach = 44, Push = 48, Lift = 0.16, Sink = 0.12, Bounce = 0.06, Lean = 12, ArmF = 58, ArmB = 40, ArmBase = 12, ArmOut = 7, Twist = 8, Roll = 2, Sway = 0.04 }),
		K({ V = 22, Steps = 4.1, Reach = 50, Push = 54, Lift = 0.22, Sink = 0.14, Bounce = 0.08, Lean = 18, ArmF = 72, ArmB = 50, ArmBase = 16, ArmOut = 8, Twist = 9, Roll = 1.5, Sway = 0.03 }),
	},
	-- раненый: сутулится, короче шаг на больную (правую) ногу — см. LIMP
	Injured = {
		K({ V = 0, Lean = 10 }),
		K({ V = 3, Steps = 2.2, Reach = 20, Push = 20, Lean = 11, ArmF = 8, ArmB = 6, Twist = 3, Roll = 3, Sway = 0.08 }),
		K({ V = 10, Steps = 3.4, Reach = 32, Push = 34, Lift = 0.03, Sink = 0.08, Bounce = 0.05, Lean = 14, ArmF = 22, ArmB = 18, ArmBase = 6, Twist = 5, Roll = 4, Sway = 0.08, Nod = -6 }),
		K({ V = 16, Steps = 3.8, Reach = 40, Push = 44, Lift = 0.12, Sink = 0.12, Bounce = 0.07, Lean = 17, ArmF = 40, ArmB = 30, ArmBase = 10, ArmOut = 6, Twist = 6, Roll = 4, Sway = 0.06, Nod = -6 }),
		K({ V = 22, Steps = 4.1, Reach = 46, Push = 50, Lift = 0.18, Sink = 0.14, Bounce = 0.08, Lean = 21, ArmF = 52, ArmB = 38, ArmBase = 14, ArmOut = 7, Twist = 7, Roll = 3, Sway = 0.05, Nod = -4 }),
	},
	-- маньяк: тяжёлый широкий шаг с ударом стопы, плечи вперёд
	Killer = {
		K({ V = 0, Lean = 6, ArmOut = 9 }),
		K({ V = 6, Steps = 2.0, Reach = 26, Push = 26, Sink = 0.06, Bounce = 0.04, Lean = 7, ArmF = 14, ArmB = 12, ArmOut = 9, Twist = 4, Roll = 2.5, Sway = 0.08, Nod = -4 }),
		K({ V = 16, Steps = 3.0, Reach = 40, Push = 44, Lift = 0.06, Sink = 0.14, Bounce = 0.12, Lean = 12, ArmF = 34, ArmB = 28, ArmBase = 6, ArmOut = 10, Twist = 7, Roll = 3.5, Sway = 0.07, Nod = -6 }),
		K({ V = 23, Steps = 3.6, Reach = 50, Push = 54, Lift = 0.16, Sink = 0.15, Bounce = 0.1, Lean = 20, ArmF = 48, ArmB = 38, ArmBase = 10, ArmOut = 10, Twist = 8, Roll = 3, Sway = 0.05, Nod = -4 }),
	},
	-- маньяк с выжившим на плече: короче шаг, сильнее раскачка от груза
	Carry = {
		K({ V = 0, Lean = 7, ArmOut = 9 }),
		K({ V = 6, Steps = 1.9, Reach = 24, Push = 24, Sink = 0.08, Bounce = 0.05, Lean = 7, ArmF = 16, ArmB = 12, ArmOut = 10, Twist = 2, Roll = 3.5, Sway = 0.1, Nod = -3 }),
		K({ V = 15, Steps = 2.8, Reach = 36, Push = 40, Lift = 0.03, Sink = 0.14, Bounce = 0.13, Lean = 9, ArmF = 30, ArmB = 24, ArmBase = 4, ArmOut = 10, Twist = 3, Roll = 4.5, Sway = 0.09, Nod = -4 }),
	},
}

-- Присед: широкий выпад (переднюю/заднюю ногу не меняет — у R6 нет колен, чтобы пронести
-- ногу под низким тазом), подкрадывающиеся шажки, корпус низко и вперёд.
local CROUCH = {
	Hip = 1.32, -- высота таза (стоя — 2)
	Front = 62, -- угол передней ноги (°)
	Back = -60, -- угол задней ноги (°)
	Spread = 5, -- ноги чуть шире
	Lean = 34,
	Steps = 2.2, -- шагов в секунду при скорости 5
}

-- Хромота: доля времени, которую «съедает» больная правая нога (см. Gait.stepRate)
local LIMP = 0.2

------------------------------------------------------------------------
-- Геометрия ноги-бруска
------------------------------------------------------------------------

local R_FOOT = math.sqrt(4.25) -- от сустава до нижнего угла бруска (2 вниз, 0.5 в сторону)
local PHI_FOOT = math.atan2(0.5, 2)
local SWING_TANGENT = 0.6 -- насколько перенос продолжает скорость опоры (захлёст/подтягивание)

-- Вынос пятки вперёд от сустава при угле th (нога впереди — опора на пятку)
local function heelX(th: number): number
	return 2 * sin(th) - 0.5 * cos(th)
end

-- Насколько низко достаёт нога (самый нижний угол бруска) при наклоне th
local function reachOf(th: number): number
	return 2 * cos(th) + 0.5 * abs(sin(th))
end
Gait.reachOf = reachOf

local G = {} :: { [string]: number } -- текущий профиль (переиспользуется)

local function sampleProfile(style: string, v: number)
	local prof = PROFILES[style]
	local n = #prof
	local i = 1
	while i < n and v >= prof[i + 1].V do
		i += 1
	end
	local k0 = prof[i] :: any
	local k1 = prof[math.min(i + 1, n)] :: any
	local a = k1.V > k0.V and clamp((v - k0.V) / (k1.V - k0.V), 0, 1) or 0
	for _, f in FIELDS do
		G[f] = k0[f] + (k1[f] - k0[f]) * a
	end
	local reach, push = rad(G.Reach), rad(G.Push)
	G.HeelTravel = heelX(reach) + 0.5
	G.Stride = G.HeelTravel + 2 * sin(push) - 0.5 * cos(push) + 0.5
	-- Доля опоры, при которой стопа не скользит (ограничена разумными пределами)
	G.Duty = (v > 0.3 and G.Stride > 1e-3) and clamp(G.Steps * G.Stride / (2 * v), 0.26, 0.68) or 0.6
end

-- Сдвиг сустава ноги вперёд от скручивания плеч (у R6 таз и плечи — один брусок):
-- twist — амплитуда (рад). На фазе ноги u поворот корпуса = ±twist·cos(2πu).
local function hipShift(u: number, twist: number): number
	return sin(twist) - sin(twist * cos(TAU * u))
end

-- Угол опорной ноги, при котором точка опоры (пятка, затем носок) стоит на месте,
-- когда таз прошёл x от касания
local function stanceAngle(x: number, reach: number, heelTravel: number): number
	if x < heelTravel then
		return asin(clamp((heelX(reach) - x) / R_FOOT, -1, 1)) + PHI_FOOT
	end
	return asin(clamp((0.5 - (x - heelTravel)) / R_FOOT, -1, 1)) - PHI_FOOT
end

-- Угол ноги (рад, мировой) на фазе u ∈ [0,1): u = 0 — касание пяткой впереди.
-- twist — скручивание корпуса (рад): сустав ноги ездит вперёд-назад, опора это учитывает.
-- Возвращает угол, опорная ли нога, и прогресс внутри опоры/переноса.
local function legCycle(u: number, scale: number, twist: number): (number, boolean, number)
	local stride = G.Stride
	local reach, push = rad(G.Reach) * scale, rad(G.Push) * scale
	if stride < 1e-3 then
		return 0, true, 0.5
	end
	stride *= scale
	local heelTravel = G.HeelTravel * scale
	local d = G.Duty
	if u < d then
		local s = u / d
		return stanceAngle(s * stride + hipShift(u, twist), reach, heelTravel), true, s
	end
	-- перенос: от угла отрыва к углу касания, продолжая скорость опоры
	local s = (u - d) / (1 - d)
	local from = stanceAngle(stride + hipShift(d, twist), reach, heelTravel)
	local k = stride / d * (1 - d) * SWING_TANGENT
	local m0 = -k / (R_FOOT * cos(PHI_FOOT + from))
	local m1 = -k / (R_FOOT * cos(reach - PHI_FOOT))
	local s2, s3 = s * s, s * s * s
	local th = (2 * s3 - 3 * s2 + 1) * from + (s3 - 2 * s2 + s) * m0 + (-2 * s3 + 3 * s2) * reach + (s3 - s2) * m1
	return th, false, s
end

-- Желаемая высота таза, пока нога опорная: на беге таз идёт ровнее (от касания к отрыву
-- с просадкой Bounce), а не «перепрыгивает» через прямую ногу. Сколько при этом можно
-- «согнуть» ногу (уйти под землю), решает plant() по точной геометрии.
local function stanceHeight(s: number, scale: number, bounce: number): number
	local reach, push = rad(G.Reach) * scale, rad(G.Push) * scale
	return reachOf(reach) + (reachOf(-push) - reachOf(reach)) * s - bounce * sin(pi * s)
end

-- Нижние углы ноги-бруска относительно её сустава (сустав — верхнее наружное ребро)
local FOOT_L = { V(0, -2, -0.5), V(0, -2, 0.5), V(1, -2, -0.5), V(1, -2, 0.5) }
local FOOT_R = { V(0, -2, -0.5), V(0, -2, 0.5), V(-1, -2, -0.5), V(-1, -2, 0.5) }

-- Насколько ниже сустава достаёт нога при мировом повороте w (самый нижний угол бруска)
local function footReach(w: CFrame, side: number): number
	local low = math.huge
	for _, c in side < 0 and FOOT_L or FOOT_R do
		low = math.min(low, w:VectorToWorldSpace(c).Y)
	end
	return -low
end

-- Высота середины таза, при которой нижний угол ноги касается земли (точная кинематика:
-- поворот корпуса r двигает сустав, поворот ноги legLocal задан в пространстве торса)
local function legDrop(r: CFrame, legLocal: CFrame, side: number): number
	return footReach(r * legLocal, side) - r:VectorToWorldSpace(V(side, 0, 0)).Y
end

-- Какие стопы стоят на земле и насколько их можно «согнуть» (заполняют функции стилей)
local Plant = { L = true, R = true, SinkL = 0, SinkR = 0, Lift = 0 }

-- Ставит таз по высоте так, чтобы опорные стопы касались земли: не выше касания
-- и не глубже допуска Sink. В полёте (нет опорных) — желаемая высота как есть.
local function plant(out, r: CFrame)
	local hipMid = out.RootPos - r.UpVector
	local hip = hipMid.Y + 3
	local hi, lo = -math.huge, -math.huge
	if Plant.L then
		local d = legDrop(r, out.LLeg, -1)
		hi, lo = math.max(hi, d), math.max(lo, d - Plant.SinkL)
	end
	if Plant.R then
		local d = legDrop(r, out.RLeg, 1)
		hi, lo = math.max(hi, d), math.max(lo, d - Plant.SinkR)
	end
	if hi > -math.huge then
		hip = clamp(hip, lo, hi)
	end
	out.RootPos = V(hipMid.X, hip + Plant.Lift - 3, hipMid.Z) + r.UpVector
end

------------------------------------------------------------------------
-- Сборка позы
------------------------------------------------------------------------

local function styleOf(p: Params): string
	if p.Killer then
		return p.Carrying and "Carry" or "Killer"
	end
	if p.Crouching then
		return "Crouch"
	end
	return p.Injured and "Injured" or "Survivor"
end

-- Поворот корпуса и смещение так, чтобы наклон шёл от таза (таз остаётся на высоте hip)
local function torso(pose, pitch: number, yaw: number, roll: number, hip: number, sideX: number): CFrame
	local r = YXZ(rad(-pitch), rad(yaw), rad(roll))
	pose.Root = r
	pose.RootPos = V(sideX, hip - 3, 0) + r.UpVector
	return r
end

-- Нога в мировых углах -> в пространстве торса
local function leg(rInv: CFrame, world: CFrame): CFrame
	return rInv * world
end

-- Голова: держит горизонт (гасит наклон/скручивание корпуса) и смотрит куда надо
local function head(pose, r: CFrame, pitch: number, yaw: number, roll: number?)
	local comp = IDENTITY:Lerp(r:Inverse(), 0.85)
	pose.Neck = comp * YXZ(rad(pitch), rad(yaw), rad(roll or 0))
end

local function armSwing(c: number): number
	return c > 0 and c * G.ArmF or c * G.ArmB
end

------------------------------------------------------------------------
-- Стояние (дыхание, вес, оглядывания)
------------------------------------------------------------------------

local function idle(t: number, p: Params, style: string, out)
	local seed = p.Seed or 0
	local exert = p.Exertion or 0
	local killer = style == "Killer" or style == "Carry"
	local b = sin(p.Breath or t * 1.9)
	local depth = (killer and 1.5 or 1) + exert * 1.6 + (style == "Injured" and 0.8 or 0)
	local shift = Life.weightShift(t, seed, killer and 7 or 5.5)
	if style == "Injured" then
		shift = -0.7 + shift * 0.2 -- бережёт правую ногу
	end
	local hipX = shift * 0.12
	local lean = G.Lean + exert * 5 - b * 0.7 * depth
	-- стопы стоят на месте: при сдвиге таза ноги наклоняются; у ненагруженной носок наружу
	local z = -math.deg(asin(clamp(hipX / 2, -1, 1)))
	local wl = A(0, 9 * math.max(0, shift), z)
	local wr = A(0, -9 * math.max(0, -shift), z)
	-- крен таза, при котором обе стопы-бруски касаются земли (наклонённый брусок «длиннее»)
	local roll = math.deg(asin(clamp((footReach(wr, 1) - footReach(wl, -1)) / 2, -0.5, 0.5)))
	local r = torso(out, lean, sin(t * 0.23 + seed * 6) * 2, roll, 2, hipX)
	local rInv = r:Inverse()
	out.LLeg = leg(rInv, wl)
	out.RLeg = leg(rInv, wr)
	Plant.L, Plant.R, Plant.SinkL, Plant.SinkR = true, true, 0, 0
	Plant.Lift = (b + 1) * 0.008 * depth -- грудь поднимается на вдохе
	local sway = sin(t * 0.9 + seed * 4) * 1.2
	local armLean = G.Lean * 0.6
	out.LArm = A(2 + armLean + b * 0.6 * depth + sway, 0, -(G.ArmOut + b * 0.8 * depth))
	out.RArm = A(2 + armLean + b * 0.6 * depth - sway, 0, G.ArmOut + b * 0.8 * depth)
	local gy, gp = glance(t, seed, killer and 5.5 or 4.2, killer and 0.6 or 0.5, killer and 45 or 60)
	return r, gy, gp + b * 0.8 * depth
end

------------------------------------------------------------------------
-- Цикл шага
------------------------------------------------------------------------

local function stride(p: Params, style: string, v: number, out): (CFrame, number)
	local u0 = (p.Phase / TAU) % 1
	-- направление движения относительно взгляда (маньяк ходит боком и пятится)
	local fwd, side = p.Forward or 1, p.Strafe or 0
	local alpha = math.atan2(side, fwd)
	local backward = abs(alpha) > rad(110)
	if backward then
		alpha -= pi * (alpha > 0 and 1 or -1)
		u0 = 1 - u0
	end
	local sideness = abs(sin(alpha))
	local uL, uR = u0, (u0 + 0.5) % 1
	local d = G.Duty
	-- хромота: правая нога короче шагает, сильнее проседает
	local scaleL, scaleR = 1, 1
	local bounceR, sinkR = G.Bounce, G.Sink
	if style == "Injured" then
		-- здоровая половина цикла дольше (см. stepRate) — шаг длиннее, больная — короче
		scaleL, scaleR = 1 + LIMP, 1 - LIMP
		bounceR += 0.07
		sinkR += 0.06
	end
	local amp = 1 - 0.35 * sideness
	local twistAmp = G.Twist * (1 - sideness)
	local thL, stL, sL = legCycle(uL, scaleL * amp, rad(twistAmp))
	local thR, stR, sR = legCycle(uR, scaleR * amp, rad(twistAmp))
	local hip
	local hL = stL and stanceHeight(sL, scaleL * amp, G.Bounce) or nil
	local hR = stR and stanceHeight(sR, scaleR * amp, bounceR) or nil
	Plant.L, Plant.R, Plant.SinkL, Plant.SinkR, Plant.Lift = stL, stR, G.Sink, sinkR, 0
	if hL or hR then
		hip = math.max(hL or 0, hR or 0)
	else
		-- полёт: от отрыва одной ноги до касания другой
		local f = (uL < 0.5 and (uL - d) or (uL - 0.5 - d)) / math.max(0.5 - d, 1e-3)
		f = clamp(f, 0, 1)
		local reach, push = rad(G.Reach) * amp, rad(G.Push) * amp
		hip = reachOf(-push) + (reachOf(reach) - reachOf(-push)) * f + 4 * G.Lift * f * (1 - f)
	end
	-- корпус: наклон, скручивание плеч навстречу ногам, крен и смещение на опорную ногу
	local onLeft = cos(TAU * (uL - d / 2)) -- +1 в середине опоры левой
	local lean = G.Lean
	local roll = G.Roll * onLeft
	if style == "Injured" then
		-- на больную ногу корпус «проваливается» вбок
		roll -= 3 * math.max(0, -onLeft)
		lean += 3 * math.max(0, -onLeft)
	end
	local twist = G.Twist * cos(TAU * uL) * (1 - sideness)
	local r = torso(out, lean, twist, roll, hip, -G.Sway * onLeft)
	local rInv = r:Inverse()
	-- ноги: качаются в плоскости движения
	local spin = A(0, -math.deg(alpha), 0)
	local unspin = A(0, math.deg(alpha), 0)
	local spread = 10 * sideness
	out.LLeg = leg(rInv, spin * CFrame.Angles(thL, 0, 0) * unspin * A(0, 0, -spread))
	out.RLeg = leg(rInv, spin * CFrame.Angles(thR, 0, 0) * unspin * A(0, 0, spread))
	-- руки: навстречу ногам, с небольшим запаздыванием
	local ca = cos(TAU * (uL - 0.04)) * (1 - 0.6 * sideness)
	local armLean = lean * 0.6
	out.RArm = A(G.ArmBase + armLean + armSwing(ca), 0, G.ArmOut)
	out.LArm = A(G.ArmBase + armLean + armSwing(-ca), 0, -G.ArmOut)
	-- голова чуть «кивает» в такт ударам стоп
	local nod = -1.5 * sin(TAU * 2 * (uL - d * 0.3)) * clamp(v / 16, 0, 1)
	return r, nod
end

------------------------------------------------------------------------
-- Присед
------------------------------------------------------------------------

local function crouch(t: number, p: Params, move: number, out): (CFrame, number, number)
	local seed = p.Seed or 0
	local ph = p.Phase
	local b = sin(p.Breath or t * 1.9)
	local depth = 1 + (p.Exertion or 0)
	local frontLeft = seed < 0.5
	-- шажок: передняя нога выносится, задняя подтягивается следом
	local stepF = sin(ph) * 9 * move
	local stepB = sin(ph - 1.3) * 7 * move
	local front = CROUCH.Front + stepF
	local back = CROUCH.Back + stepB
	local hip = CROUCH.Hip
	Plant.L, Plant.R, Plant.SinkL, Plant.SinkR = true, true, 0, 0
	Plant.Lift = math.max(0, sin(ph)) * 0.06 * move + (b + 1) * 0.006 * depth
	local sideX = sin(ph) * 0.1 * move + (frontLeft and -0.05 or 0.05)
	local lean = CROUCH.Lean - b * 0.6 * depth + sin(ph * 2) * 1.5 * move
	local r = torso(out, lean, (frontLeft and -6 or 6) + sin(ph) * 3 * move, sin(ph) * 3 * move, hip, sideX)
	local rInv = r:Inverse()
	local spread = CROUCH.Spread
	local fl = A(front, 0, frontLeft and -spread or spread)
	local bl = A(back, 0, frontLeft and spread or -spread)
	out.LLeg = leg(rInv, frontLeft and fl or bl)
	out.RLeg = leg(rInv, frontLeft and bl or fl)
	-- руки вперёд-вниз, у колен; чуть балансируют
	local arm = 34 + lean * 0.35
	out.LArm = A(arm + sin(ph + 0.6) * 6 * move + b * depth, 0, -8)
	out.RArm = A(arm - sin(ph + 0.6) * 6 * move + b * depth, 0, 8)
	local gy, gp = glance(t, seed, 3.6, 0.55 * (1 - move), 55)
	return r, gy, gp + 8
end

------------------------------------------------------------------------
-- Поверх: руки по «роли» (рана, оружие, колокол, груз)
------------------------------------------------------------------------

local function overlays(t: number, p: Params, style: string, out, move: number, u: number)
	local b = sin(p.Breath or t * 1.9)
	if style == "Injured" then
		-- зажимает рану левой рукой, локоть прижат
		out.LArm = A(50 + b * 2 + sin(TAU * u * 2) * 3 * move, -8, 30)
	elseif style == "Killer" then
		-- оружие в правой: рука тяжелее и впереди
		local x, _, z = out.RArm:ToEulerAnglesXYZ()
		out.RArm = A(14 + math.deg(x) * 0.45, 0, 10 + math.deg(z) * 0.2)
		if p.KillerType == "Wraith" then
			out.LArm = A(52 + sin(t * 2) * 3 + sin(TAU * u) * 6 * move, 0, -12) -- держит колокол
		end
	elseif style == "Carry" then
		-- правая рука обхватывает ноги выжившего на плече
		out.RArm = A(132 + sin(TAU * u * 2) * 3 * move + b, 0, 10)
	end
end

------------------------------------------------------------------------
-- Публичное
------------------------------------------------------------------------

-- Скорость изменения фазы шага (рад/с). Касания стоп — при фазе, кратной π.
-- crouching оставлен для совместимости; при переданных p берутся все их флаги.
function Gait.stepRate(speed: number, crouching: boolean?, p: Params?): number
	local v = speed / (p and p.Scale or 1)
	if v < 0.5 then
		return 0
	end
	if crouching or (p and p.Crouching and not p.Killer) then
		return pi * CROUCH.Steps * clamp(v / 5, 0.5, 1.6)
	end
	local style = p and styleOf(p) or "Survivor"
	sampleProfile(style, v)
	local rate = pi * G.Steps
	if style == "Injured" and p then
		-- больная (правая) половина цикла проходит быстрее, здоровая — медленнее
		rate /= (p.Phase % TAU) < pi and (1 + LIMP) or (1 - LIMP)
	end
	return rate
end

local scratchIdle, scratchMove = {}, {}

-- Передвижение и стояние. Сигнатура прежняя: (время, Params) -> поза.
function Gait.locomotion(t: number, p: Params)
	local style = styleOf(p)
	local v = p.Speed / (p.Scale or 1)
	local move = smoothstep(0.3, 2.2, v)
	local out = {}
	local r, lookYaw, lookPitch
	local nodBase = 0
	if style == "Crouch" then
		r, lookYaw, lookPitch = crouch(t, p, move, out)
	else
		sampleProfile(style, v)
		nodBase = G.Nod
		if move >= 1 then
			local nod
			r, nod = stride(p, style, v, out)
			lookYaw, lookPitch = 0, nod
		elseif move <= 0 then
			r, lookYaw, lookPitch = idle(t, p, style, out)
		else
			-- трогается с места / останавливается: смешиваем стояние и шаг
			local _, gy, gp = idle(t, p, style, scratchIdle)
			local lift = Plant.Lift
			local _, nod = stride(p, style, v, scratchMove)
			Clip.blend(scratchIdle, scratchMove, move, out)
			r = out.Root
			lookYaw, lookPitch = gy * (1 - move), gp * (1 - move) + nod * move
			if move < 0.5 then
				Plant.L, Plant.R = true, true
			end
			Plant.SinkL *= move
			Plant.SinkR *= move
			Plant.Lift = lift * (1 - move)
		end
	end
	-- разгон/торможение и вираж: корпус наклоняется от таза, ноги остаются под телом
	local accel = clamp((p.AccelForward or 0) * 0.3, -10, 14)
	local bank = clamp(-(p.AccelSide or 0) * 0.22, -10, 10)
	if abs(accel) > 0.05 or abs(bank) > 0.05 then
		local extra = YXZ(rad(-accel), 0, rad(bank))
		local hipPos = out.RootPos - r.UpVector
		r = r * extra
		out.Root = r
		out.RootPos = hipPos + r.UpVector
		local inv = extra:Inverse()
		out.LLeg = inv * out.LLeg
		out.RLeg = inv * out.RLeg
	end
	plant(out, r)
	overlays(t, p, style, out, move, (p.Phase / TAU) % 1)
	-- голова держит горизонт и смотрит на маньяка / в поворот / по сторонам
	local look = p.LookYaw or 0
	local yaw = look + clamp((p.TurnRate or 0) * 7, -25, 25) + (look ~= 0 and 0 or lookYaw)
	head(out, r, nodBase + lookPitch, yaw)
	return out
end

return Gait
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Life</string>
            <string name="Source"><![CDATA[-- Мелкие «живые» движения без состояния (зависят только от времени и зерна персонажа):
-- перенос веса, оглядывания, вспышки усилия, редкие события (вздрог, рывок).
-- seed (0..1) у каждого персонажа свой — иначе все двигались бы синхронно.
local Life = {}

local sin, floor, clamp = math.sin, math.floor, math.clamp

-- Псевдослучайное 0..1 от числа
function Life.hash(x: number): number
	local s = sin(x * 12.9898 + 78.233) * 43758.5453
	return s - floor(s)
end
local hash = Life.hash

function Life.smoothstep(a: number, b: number, x: number): number
	local t = clamp((x - a) / (b - a), 0, 1)
	return t * t * (3 - 2 * t)
end
local smoothstep = Life.smoothstep

-- Плавный перенос веса (-1 — на левую ногу, +1 — на правую) раз в period секунд
function Life.weightShift(t: number, seed: number, period: number): number
	local tt = t / period + seed * 13.7
	local slot = floor(tt)
	local function target(i: number): number
		local side = hash(i + seed * 101) > 0.5 and 1 or -1
		return side * (0.35 + 0.65 * hash(i * 1.7 + 3.1))
	end
	local a, b = target(slot - 1), target(slot)
	return a + (b - a) * smoothstep(0, 0.35, tt - slot)
end

-- Иногда оглядывается: (поворот, наклон) головы в градусах
function Life.glance(t: number, seed: number, period: number, chance: number, maxYaw: number): (number, number)
	local tt = t / period + seed * 7.3
	local slot = floor(tt)
	if hash(slot * 3.3 + seed * 57) > chance then
		return 0, 0
	end
	local f = tt - slot
	local w = smoothstep(0.05, 0.25, f) * (1 - smoothstep(0.7, 0.92, f))
	local side = hash(slot * 5.1 + 1.7) > 0.5 and 1 or -1
	local yaw = side * maxYaw * (0.45 + 0.55 * hash(slot * 7.7 + 2.9))
	local pitch = (hash(slot * 2.3 + 9.1) - 0.45) * 16
	return yaw * w, pitch * w
end

-- Редкое короткое событие: огибающая 0..1 (быстрый вход за attack, спад за release, доли окна).
-- Раз в period секунд, с вероятностью chance.
function Life.event(t: number, seed: number, period: number, chance: number, attack: number, release: number): number
	local tt = t / period + seed * 3.1
	local slot = floor(tt)
	if hash(slot * 4.7 + seed * 23) > chance then
		return 0
	end
	local f = tt - slot
	local start = 0.15 + 0.5 * hash(slot * 1.3 + 0.7)
	if f < start then
		return 0
	end
	return smoothstep(start, start + attack, f) * (1 - smoothstep(start + attack, start + attack + release, f))
end

-- Неровные вспышки усилия 0..1 (борьба, дёрганья): несколько несоизмеримых волн
function Life.bursts(t: number, seed: number): number
	local s = seed * 31
	local v = 0.45 + 0.55 * sin(t * 1.3 + s) + 0.35 * sin(t * 2.9 + s * 1.7) + 0.2 * sin(t * 5.3 + s * 0.3)
	return clamp(v, 0, 1)
end

return Life
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Poses</string>
            <string name="Source"><![CDATA[-- Процедурные позы R6. Каждая поза — функция, возвращающая таблицу поворотов суставов:
--   Root (поворот торса вокруг HumanoidRootPart), RootPos (сдвиг торса в стадах),
--   Neck, LArm, RArm, LLeg, RLeg.
-- Углы в градусах: +X — вперёд (руку поднять перед собой), +Y — влево, +Z — вправо.
-- Корпус наклоняется вперёд ОТРИЦАТЕЛЬНЫМ X. Не указанные суставы берутся из базовой позы.
--   Poses.locomotion / Poses.stepRate — походка (Anim/Gait.lua)
--   Poses.State.*  — особые состояния (Anim/States.lua)
--   Poses.Action.* — действия, пока игрок держит кнопку: (t от начала действия, p) -> поза
--     (Anim/Actions.lua — ключевые клипы)
--   Poses.OneShot.* — одноразовые: { Duration, Fn(a, p) -> поза } или клип Anim/Clip.lua
--     (необязательно: FadeIn, FadeOut, Additive, Stiffness, Upper — см. Anim/Clips.lua);
--     накладываются через Poses.applyShot, вариант по обстоятельствам — Poses.shotVariant
local Rig = require(script.Parent.Rig)
local Gait = require(script.Parent.Gait)
local States = require(script.Parent.States)
local Clips = require(script.Parent.Clips)
local Actions = require(script.Parent.Actions)

local Poses = {}

local A = Rig.A
Poses.A = A

export type Params = Gait.Params

local function merge(base, over)
	local out = table.clone(base)
	for k, v in over do
		out[k] = v
	end
	return out
end
Poses.merge = merge

Poses.stepRate = Gait.stepRate
Poses.locomotion = Gait.locomotion
Poses.State = States

-- Действия (Anim/Actions.lua): Repair, Heal, Cleanse, OpenChest, FreeTrap/DisarmTrap, Unhook,
-- OpenGate, SelfHeal, EscapeTrap; маньяк: Hook, Break, Kick, SearchLocker,
-- SetTrap/PickupTrap/ResetTrap/CloseHatch
Poses.Action = Actions.Action
Poses.ActionLength = Actions.Length

-- Одноразовые (Anim/Clips.lua): Swing, Wipe, Stun, Blind, Pickup, Vault (+VaultWalk), KillerVault,
-- PalletDrop, Flinch, Windup, Throw, Bell (+BellUncloak), HookScream, Entity
Poses.OneShot = Clips.OneShot
Poses.applyShot = Clips.apply
Poses.shotVariant = Clips.variant

return Poses
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Rig</string>
            <string name="Source"><![CDATA[-- Математика суставов R6.
-- Позы задаются понятными углами в пространстве родительской детали (Torso или HumanoidRootPart):
--   +X = махнуть конечностью вперёд, +Y = повернуть влево, +Z = отвести вправо.
-- Rig.transform переводит такой поворот (вокруг точки сустава) в Motor6D.Transform,
-- поэтому не нужно помнить странные оси C0/C1 у R6.
local Rig = {}

local rad = math.rad

Rig.JointNames = { "Root", "Neck", "LArm", "RArm", "LLeg", "RLeg" }

local JOINT_PATHS = {
	Root = { "HumanoidRootPart", "RootJoint" },
	Neck = { "Torso", "Neck" },
	LArm = { "Torso", "Left Shoulder" },
	RArm = { "Torso", "Right Shoulder" },
	LLeg = { "Torso", "Left Hip" },
	RLeg = { "Torso", "Right Hip" },
}

export type Joint = {
	Motor: Motor6D,
	C0: CFrame,
	C1: CFrame,
	Rest: CFrame,
	Pivot: Vector3,
}

export type RigData = {
	Joints: { [string]: Joint },
	Scale: number,
}

function Rig.makeJoint(motor: Motor6D, c0: CFrame, c1: CFrame): Joint
	return {
		Motor = motor,
		C0 = c0,
		C1 = c1,
		Rest = c0 * c1:Inverse(),
		Pivot = c0.Position,
	}
end

-- Находит суставы R6 у персонажа. Возвращает nil, если это не R6.
function Rig.find(char: Model): RigData?
	local joints = {}
	for name, path in JOINT_PATHS do
		local part = char:FindFirstChild(path[1])
		local motor = part and part:FindFirstChild(path[2])
		if not motor or not motor:IsA("Motor6D") then
			return nil
		end
		joints[name] = Rig.makeJoint(motor, motor.C0, motor.C1)
	end
	local scale = 1
	local ok, s = pcall(function()
		return char:GetScale()
	end)
	if ok and typeof(s) == "number" then
		scale = s
	end
	return { Joints = joints, Scale = scale }
end

-- Поворот из углов в градусах в соглашении поз: +X — вперёд, +Y — влево, +Z — вправо
function Rig.A(x: number, y: number?, z: number?): CFrame
	return CFrame.Angles(rad(x), rad(y or 0), rad(z or 0))
end

-- Поворот конечности (руки или ноги), при котором она указывает вдоль dir.
-- dir задаётся в пространстве родителя (торса): -Z — вперёд, +X — вправо, -Y — вниз.
-- Это обратная задача к Angles(x, 0, z): конец конечности = (sin z, -cos z·cos x, -cos z·sin x).
function Rig.aim(dir: Vector3): CFrame
	local u = dir.Unit
	return CFrame.Angles(math.atan2(-u.Z, -u.Y), 0, math.asin(math.clamp(u.X, -1, 1)))
end

-- Вектор поворота (ось × угол, рад) кратчайшим путём: угол в [-π, π].
-- ToAxisAngle может вернуть угол до 2π (так в Lune) — приводим.
function Rig.rotVec(cf: CFrame): Vector3
	local axis, angle = cf:ToAxisAngle()
	if angle ~= angle or axis.X ~= axis.X or math.abs(angle) < 1e-7 then
		return Vector3.zero
	end
	if angle > math.pi then
		angle -= 2 * math.pi
	end
	return axis * angle
end

-- rot: поворот вокруг точки сустава; offset: сдвиг в пространстве родителя (в стадах)
function Rig.transform(joint: Joint, rot: CFrame, offset: Vector3?): CFrame
	local pivot = joint.Pivot
	local rel = CFrame.new(pivot + (offset or Vector3.zero)) * rot * CFrame.new(-pivot) * joint.Rest
	return joint.C0:Inverse() * rel * joint.C1
end

return Rig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Spring</string>
            <string name="Source"><![CDATA[-- Пружины для процедурной анимации: суставы догоняют позу «живо» — с инерцией,
-- лёгким перелётом и успокоением, а не экспоненциальным подтягиванием.
--
-- Модель — затухающий осциллятор второго порядка с подачей скорости цели:
--   x'' = ω²·(цель − x) + 2ζω·(r·цель' − x')
--   Freq (Гц)   — собственная частота ω/2π: чем больше, тем быстрее сустав догоняет позу;
--   Damping (ζ) — 1 = без перелёта (критическое), 0.5..0.8 = лёгкий перелёт и «оттяжка»;
--                 значения больше 1 обрезаются до 1;
--   Response(r) — 0..1, какая доля скорости цели передаётся сразу. 1 — плавно движущаяся цель
--                 (цикл шага) отслеживается почти без отставания, пружина сглаживает только рывки
--                 и смену поз; меньше 1 — сустав «тянется» за целью (захлёст рук).
-- Шаг решается аналитически (точное решение при линейно движущейся за кадр цели),
-- поэтому устойчив при любом dt: и 1/240, и 1/10 (дальние персонажи обновляются редко).
-- Если цель за кадр прыгнула (смена позы, а не плавное движение), скорость цели не подаётся —
-- сустав переходит в новую позу с естественным перелётом.
--
-- Повороты хранятся как CFrame (чистый поворот), ошибка и скорости — как вектор поворота
-- (ось × угол, рад) в пространстве родителя сустава.
--
-- Использование:
--   local s = Spring.rot(Spring.R6.Neck)       -- или Spring.vec(...) для смещения
--   local cf = Spring.stepRot(s, targetCFrame, dt) -- каждый кадр; первый вызов ставит сразу в цель
--   Spring.stepRot(s, target, dt, 1.8)         -- 4-й аргумент: множитель частоты (резкие удары)
local Rig = require(script.Parent.Rig)

local Spring = {}

export type Tuning = {
	Freq: number,
	Damping: number,
	Response: number?,
}

export type Rot = {
	Tuning: Tuning,
	Value: CFrame,
	Velocity: Vector3,
	Target: CFrame?,
}

export type Vec = {
	Tuning: Tuning,
	Value: Vector3,
	Velocity: Vector3,
	Target: Vector3?,
}

local ZERO = Vector3.zero
local TAU = math.pi * 2
local exp, cos, sin, sqrt = math.exp, math.cos, math.sin, math.sqrt

-- Цель «прыгнула», а не движется: больше этого угла за один шаг или этой угловой скорости
local JUMP_ANGLE = 0.6 -- рад
local JUMP_SPEED = 30 -- рад/с
-- То же для смещения корпуса (стады за шаг и стад/с)
local JUMP_DIST = 0.6
local JUMP_VEL = 25

-- Коэффициенты точного решения x(dt), v(dt) = (xx·x0 + xv·v0, vx·x0 + vv·v0)
local function coefficients(omega: number, zeta: number, dt: number): (number, number, number, number)
	if zeta >= 0.9999 then
		local e = exp(-omega * dt)
		local wt = omega * dt
		return e * (1 + wt), e * dt, -e * omega * omega * dt, e * (1 - wt)
	end
	local a = zeta * omega
	local wd = omega * sqrt(1 - zeta * zeta)
	local e = exp(-a * dt)
	local c, s = cos(wd * dt), sin(wd * dt)
	return e * (c + a * s / wd), e * s / wd, -e * omega * omega * s / wd, e * (c - a * s / wd)
end
Spring.coefficients = coefficients

local rotVec = Rig.rotVec

local function fromRotVec(v: Vector3): CFrame
	local m = v.Magnitude
	if m < 1e-7 then
		return CFrame.identity
	end
	return CFrame.fromAxisAngle(v / m, m)
end

local function params(t: Tuning, freqScale: number?): (number, number, number)
	local omega = TAU * t.Freq * (freqScale or 1)
	return omega, math.clamp(t.Damping, 0.05, 1), t.Response or 1
end

-- Один шаг для ошибки e (относительно цели) и её скорости ev при скорости цели tv
local function solve(e: Vector3, ev: Vector3, tv: Vector3, omega: number, zeta: number, r: number, dt: number): (Vector3, Vector3)
	-- При r < 1 пружина отстаёт от движущейся цели на постоянную величину eq
	local eq = tv * (-2 * zeta * (1 - r) / omega)
	local y = e - eq
	local xx, xv, vx, vv = coefficients(omega, zeta, dt)
	return y * xx + ev * xv + eq, y * vx + ev * vv
end

function Spring.rot(tuning: Tuning, value: CFrame?): Rot
	return { Tuning = tuning, Value = value or CFrame.identity, Velocity = ZERO, Target = nil }
end

function Spring.vec(tuning: Tuning, value: Vector3?): Vec
	return { Tuning = tuning, Value = value or ZERO, Velocity = ZERO, Target = nil }
end

-- Сразу поставить в позу (телепорт, первый кадр, долгий пропуск обновлений)
function Spring.snapRot(s: Rot, target: CFrame)
	s.Value, s.Velocity, s.Target = target, ZERO, target
end

function Spring.snapVec(s: Vec, target: Vector3)
	s.Value, s.Velocity, s.Target = target, ZERO, target
end

function Spring.stepRot(s: Rot, target: CFrame, dt: number, freqScale: number?): CFrame
	local prev = s.Target
	if not prev then
		Spring.snapRot(s, target)
		return target
	end
	s.Target = target
	if dt <= 0 then
		return s.Value
	end
	local omega, zeta, r = params(s.Tuning, freqScale)
	-- Скорость цели за этот шаг (цель двигалась от prev к target)
	local move = rotVec(target * prev:Inverse())
	local tv = move / dt
	local base = prev
	if move.Magnitude > JUMP_ANGLE or tv.Magnitude > JUMP_SPEED then
		tv = ZERO
		base = target
	end
	local e = rotVec(s.Value * base:Inverse())
	local e1, ev1 = solve(e, s.Velocity - tv, tv, omega, zeta, r, dt)
	local value = fromRotVec(e1) * target
	s.Value = value
	s.Velocity = ev1 + tv
	return value
end

function Spring.stepVec(s: Vec, target: Vector3, dt: number, freqScale: number?): Vector3
	local prev = s.Target
	if not prev then
		Spring.snapVec(s, target)
		return target
	end
	s.Target = target
	if dt <= 0 then
		return s.Value
	end
	local omega, zeta, r = params(s.Tuning, freqScale)
	local move = target - prev
	local tv = move / dt
	local base = prev
	if move.Magnitude > JUMP_DIST or tv.Magnitude > JUMP_VEL then
		tv = ZERO
		base = target
	end
	local e1, ev1 = solve(s.Value - base, s.Velocity - tv, tv, omega, zeta, r, dt)
	local value = target + e1
	s.Value = value
	s.Velocity = ev1 + tv
	return value
end

------------------------------------------------------------------------
-- Настройки суставов R6: голова лёгкая и быстрая, корпус тяжёлый,
-- руки с заметной «оттяжкой», ноги точные (чтобы стопы попадали в землю).
------------------------------------------------------------------------

Spring.R6 = {
	Root = { Freq = 2.6, Damping = 0.78, Response = 1 },
	RootPos = { Freq = 3.2, Damping = 0.72, Response = 1 },
	Neck = { Freq = 4.4, Damping = 0.62, Response = 1 },
	LArm = { Freq = 3.3, Damping = 0.52, Response = 0.85 },
	RArm = { Freq = 3.3, Damping = 0.52, Response = 0.85 },
	LLeg = { Freq = 4.8, Damping = 0.82, Response = 1 },
	RLeg = { Freq = 4.8, Damping = 0.82, Response = 1 },
} :: { [string]: Tuning }

return Spring
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">States</string>
            <string name="Source"><![CDATA[-- Особые состояния выживших: ползёт (повержен), на плече у маньяка, на крюке, в шкафчике,
-- в капкане, сидит у костра. Все «живые»: дыхание, мелкие движения, оглядывания.
-- Углы — как в позах (Rig.A): +X вперёд, +Y влево, +Z вправо; корпус вперёд — минус X.
local Rig = require(script.Parent.Rig)
local Life = require(script.Parent.Life)
local Gait = require(script.Parent.Gait)

type Params = Gait.Params

local States = {}

local sin, cos, abs, max, clamp, rad, pi = math.sin, math.cos, math.abs, math.max, math.clamp, math.rad, math.pi
local TAU = pi * 2
local A = Rig.A
local V = Vector3.new
local YXZ = CFrame.fromEulerAnglesYXZ
local IDENTITY = CFrame.identity
local smoothstep = Life.smoothstep

-- Голова: гасит поворот корпуса на k (0..1) и смотрит (наклон, поворот, крен) в мире
local function neck(r: CFrame, k: number, pitch: number, yaw: number, roll: number?): CFrame
	return IDENTITY:Lerp(r:Inverse(), k) * YXZ(rad(pitch), rad(yaw), rad(roll or 0))
end

-- Корпус, наклонённый от таза: таз на высоте hip (стоя — 2)
local function torso(pose, pitch: number, yaw: number, roll: number, hip: number, side: number?, fwd: number?): CFrame
	local r = YXZ(rad(-pitch), rad(yaw), rad(roll))
	pose.Root = r
	pose.RootPos = V(side or 0, hip - 3, fwd or 0) + r.UpVector
	return r
end

------------------------------------------------------------------------
-- Повержен: лежит на животе и подтягивается руками (по-пластунски)
------------------------------------------------------------------------

-- Гребок одной руки, w ∈ [0,1): 0..0.55 — тянет (ладонь на земле, рука уходит вбок),
-- дальше — заносит руку вперёд над землёй. Возвращает (подъём, отведение) в градусах.
local function stroke(w: number, reach: number): (number, number)
	if w < 0.55 then
		local s = smoothstep(0, 1, w / 0.55)
		return 0, 10 + (60 - 10) * s * reach
	end
	local s = (w - 0.55) / 0.45
	return 22 * sin(pi * s) * reach, 10 + 50 * reach * (1 - smoothstep(0, 1, s))
end

function States.Crawl(t: number, p: Params)
	local seed = p.Seed or 0
	local moving = p.Speed > 0.3
	local b = sin(p.Breath or t * 2.2)
	-- на месте: слабые попытки дотянуться вперёд, чаще просто тяжело дышит
	local ph = moving and p.Phase or t * 0.9
	local reach = moving and 1 or 0.35
	local w = (ph / TAU) % 1
	local liftL, outL = stroke(w, reach)
	local liftR, outR = stroke((w + 0.5) % 1, reach)
	local pull = sin(TAU * w) -- + тянет левая
	local pitch = 87 - b * 1.2
	local r = YXZ(rad(-pitch), rad(pull * 5 * reach), rad(pull * 4 * reach))
	local fwd = moving and (abs(sin(TAU * w)) * 0.12) or 0
	local pose = {
		Root = r,
		RootPos = V(pull * 0.08 * reach, -2.43 + b * 0.02, -0.3 - fwd),
		-- руки над головой (вперёд по земле) и в стороны; подъём — от земли
		LArm = A(180 + liftL, 0, -outL),
		RArm = A(180 + liftR, 0, outR),
		-- ноги волочатся, чуть разведены, иногда отталкиваются
		LLeg = A(-4 - max(0, -pull) * 10 * reach, 0, -6 - pull * 3),
		RLeg = A(-4 - max(0, pull) * 10 * reach, 0, 6 - pull * 3),
	}
	-- голова приподнята и смотрит вперёд; без движения иногда роняет голову
	local drop = moving and 0 or Life.event(t, seed, 6, 0.6, 0.15, 0.5) * 30
	local gy = moving and pull * 6 or Life.glance(t, seed, 5, 0.5, 35)
	pose.Neck = A(62 - drop + b * 2, gy, 0)
	return pose
end

------------------------------------------------------------------------
-- На плече у маньяка: лежит животом на плече, ноги свисают перед грудью маньяка,
-- руки и голова — за его спиной. Корень выжившего повёрнут так, что «вперёд» = вниз.
------------------------------------------------------------------------

function States.Carried(t: number, p: Params)
	local seed = p.Seed or 0
	local wig = p.Wiggle or 0
	-- вырывается всё отчаяннее по мере прогресса
	local k = (0.3 + 0.7 * Life.bursts(t, seed)) * (0.45 + 0.55 * wig)
	-- болтается в такт шагам маньяка
	local gait = sin(p.Phase * 2) * clamp(p.Speed / 14, 0, 1)
	local kick = sin(t * 9.5 + seed * 5)
	local punch = sin(t * 6.3 + seed * 3)
	local twist = sin(t * 3.1 + seed)
	return {
		Root = A(twist * 4 * k, twist * 10 * k, sin(t * 2.3) * 6 * k),
		LLeg = A(62 + kick * 26 * k + gait * 4, 0, -4),
		RLeg = A(62 - kick * 26 * k + gait * 4, 0, 4),
		LArm = A(92 + punch * 28 * k + gait * 8, 0, -10 - k * 10),
		RArm = A(92 - punch * 28 * k + gait * 8, 0, 10 + k * 10),
		Neck = A(-34 + sin(t * 4.1) * 12 * k + gait * 5, sin(t * 3.7 + 1) * 25 * k, 0),
	}
end

------------------------------------------------------------------------
-- На крюке: крюк входит в плечо сзади-слева (см. Art/Props/Hook.lua: HangPoint под крюком).
-- Левое плечо задрано, левая рука держится за крюк, правая висит, ноги болтаются.
-- p.Struggle — борьба с Сущностью: толкает её лапы, бьётся.
------------------------------------------------------------------------

function States.Hooked(t: number, p: Params)
	local seed = p.Seed or 0
	local b = sin(p.Breath or t * 2.6)
	if p.Struggle then
		local e = Life.bursts(t * 1.6, seed)
		local jerk = sin(t * 11 + seed * 7) ^ 3
		local kick = sin(t * 8.3 + seed)
		local push = sin(t * 5.2 + seed * 2)
		local r = YXZ(rad(4 + jerk * 6 * e), rad(sin(t * 3.4) * 12 * e), rad(-8 + jerk * 7 * e))
		return {
			Root = r,
			RootPos = V(0, jerk * 0.06 * e, 0),
			LArm = A(172 + push * 14 * e, 0, 14 - push * 10 * e),
			RArm = A(158 - push * 24 * e, 0, -6 + jerk * 14 * e),
			LLeg = A(10 + kick * 30 * e, 0, -4 - abs(kick) * 6 * e),
			RLeg = A(10 - kick * 30 * e, 0, 4 + abs(kick) * 6 * e),
			Neck = neck(r, 0.5, 18 + jerk * 12 * e, sin(t * 4.7) * 30 * e, 0),
		}
	end
	-- тело медленно качается, иногда слабо дёргается от боли
	local sway = sin(t * 1.1 + seed * 4)
	local twitch = Life.event(t, seed, 3.2, 0.45, 0.06, 0.35)
	local r = YXZ(rad(-7 + sway * 2 - twitch * 5 - b * 1.2), rad(sway * 4), rad(-8 + twitch * 3))
	local gy, gp = Life.glance(t, seed, 5, 0.4, 40)
	local lift = Life.event(t + 2, seed, 7, 0.5, 0.2, 0.4) -- поднимает голову
	return {
		Root = r,
		RootPos = V(0, b * 0.02, 0),
		LArm = A(174 + twitch * 4 + b, 0, 12),
		RArm = A(10 + sway * 6 + twitch * 10, 0, 7 + sway * 2),
		LLeg = A(6 + sway * 5 - twitch * 12, 0, -3),
		RLeg = A(-2 + sway * 5 + twitch * 18, 0, 4),
		Neck = neck(r, 0.3, -30 + lift * 26 + gp * lift + b * 1.5, gy * lift, 10 - lift * 8),
	}
end

------------------------------------------------------------------------
-- В шкафчике: часто и испуганно дышит, руки прижаты к груди, смотрит в щели дверцы
------------------------------------------------------------------------

function States.Hidden(t: number, p: Params)
	local seed = p.Seed or 0
	local b = sin(t * 6.4 + seed * 3)
	local shift = Life.weightShift(t, seed, 4)
	local flinch = Life.event(t, seed, 4, 0.35, 0.04, 0.4) -- вздрагивает от звука
	local pose = {}
	local r = torso(pose, 4 + flinch * 4 - b * 1.2, sin(t * 0.7 + seed) * 3, shift * 1.2, 2 - flinch * 0.05 + b * 0.015, shift * 0.06)
	local rInv = r:Inverse()
	pose.LLeg = rInv * A(0, 0, -1 - shift * 2)
	pose.RLeg = rInv * A(0, 0, 1 - shift * 2)
	pose.LArm = A(62 + b * 2 + flinch * 12, -10, 30 + flinch * 6)
	pose.RArm = A(66 + b * 2 + flinch * 12, 10, -30 - flinch * 6)
	-- выглядывает в щели: медленно водит головой, чуть вверх
	local look = sin(t * 0.55 + seed * 6) * 22 + sin(t * 1.7) * 4
	pose.Neck = neck(r, 0.8, 4 + b * 1.5 - flinch * 6, look, 0)
	return pose
end

------------------------------------------------------------------------
-- В капкане: правая нога в челюстях капкана, левая на колене, тянется к капкану,
-- иногда пытается выдернуть ногу и вздрагивает от боли
------------------------------------------------------------------------

function States.Trapped(t: number, p: Params)
	local seed = p.Seed or 0
	local b = sin(p.Breath or t * 2.8)
	local tug = Life.event(t, seed, 2.6, 0.75, 0.08, 0.3) -- рывок ногой
	local shake = sin(t * 23) * 0.6 -- дрожь от боли
	local lean = 38 - tug * 12 - b * 1.5
	local pose = {}
	local r = torso(pose, lean, -8 + tug * 4, -5, 1.6 + tug * 0.08 + b * 0.01, 0.1, -0.1)
	local rInv = r:Inverse()
	pose.RLeg = rInv * A(34 + tug * 6, 0, 3) -- в капкане
	pose.LLeg = rInv * A(-56, 0, -6) -- колено на земле
	-- руки к капкану (вниз-вперёд к правой стопе), на рывке тянут
	pose.LArm = A(68 - tug * 22 + shake, 0, 24)
	pose.RArm = A(64 - tug * 22 - shake, 0, 6)
	local gy, gp = Life.glance(t, seed, 3.5, 0.45, 50)
	pose.Neck = neck(r, 0.5, -28 + gp + tug * 10, gy, 0)
	return pose
end

------------------------------------------------------------------------
-- Сидит у костра (лобби): руки на коленях, греет руки, оглядывается
------------------------------------------------------------------------

function States.Sit(t: number, p: Params)
	local seed = p.Seed or 0
	local b = sin(p.Breath or t * 1.8)
	local warm = Life.event(t, seed, 9, 0.6, 0.12, 0.25) -- тянет руки к огню и трёт
	local rub = sin(t * 9) * warm
	local lean = 10 + seed * 6 + warm * 6 - b
	local r = YXZ(rad(-lean), rad(sin(t * 0.3 + seed * 5) * 3), 0)
	local gy, gp = Life.glance(t, seed, 4.5, 0.55, 55)
	local bent = seed > 0.5 and 1 or -1 -- одна нога чуть подогнута
	return {
		Root = r,
		RootPos = V(0, b * 0.015, 0),
		LLeg = A(90 + lean * 0.2 + bent * 4, 0, -5),
		RLeg = A(90 + lean * 0.2 - bent * 4, 0, 5),
		LArm = A(52 + warm * 28 + rub * 4 + b, 0, 6 + warm * 14),
		RArm = A(52 + warm * 28 - rub * 4 + b, 0, -6 - warm * 14),
		Neck = neck(r, 0.6, -6 + gp - warm * 8 + b, gy * (1 - warm), 0),
	}
end

return States
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="16">
        <Properties>
          <string name="Name">Art</string>
        </Properties>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Hatchet</string>
            <string name="Source"><![CDATA[-- Метательный топор Охотницы (строится на клиенте для полёта снаряда).
-- Hatchet.build() возвращает Model с PrimaryPart; опора модели — центр вращения в начале координат,
-- «вперёд» (-Z) — направление полёта, модель вращается вокруг своей оси X (кувырком, как настоящий
-- брошенный топор). Лезвие смотрит вперёд: воткнувшись (Effects ставит опору в 0.6 перед точкой
-- удара), топор уходит в стену острием, а рукоять остаётся снаружи. Все детали Anchored, без столкновений.
local Hatchet = {}

local A = function(x: number, y: number, z: number): CFrame
	return CFrame.Angles(math.rad(x), math.rad(y), math.rad(z))
end

local function part(m: Model, class: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material): BasePart
	local p = Instance.new(class) :: BasePart
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Parent = m
	return p
end

-- Цилиндр между точками a и b
local function rod(m: Model, a: Vector3, b: Vector3, diameter: number, color: Color3, material: Enum.Material): BasePart
	local p = part(m, "Part", Vector3.new((b - a).Magnitude, diameter, diameter), CFrame.lookAt((a + b) / 2, b) * A(0, 90, 0), color, material);
	(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

function Hatchet.build(): Model
	local m = Instance.new("Model")
	m.Name = "Hatchet"
	local iron = Color3.fromRGB(64, 62, 60)
	local steel = Color3.fromRGB(150, 148, 142)
	local wood = Color3.fromRGB(96, 70, 46)
	local leather = Color3.fromRGB(70, 48, 34)
	-- Рукоять чуть отклонена назад, низ обмотан кожей
	local top, bottom = Vector3.new(0, 0.34, -0.1), Vector3.new(0, -1.22, 0.1)
	local handle = rod(m, top, bottom, 0.15, wood, Enum.Material.Wood)
	handle.Name = "Handle"
	rod(m, top:Lerp(bottom, 0.66), top:Lerp(bottom, 0.98), 0.19, leather, Enum.Material.Leather)
	-- Обух с проушиной, щёки, бородка, светлая заточенная кромка
	local eye = part(m, "Part", Vector3.new(0.2, 0.3, 0.28), CFrame.new(0, 0.22, -0.12), iron, Enum.Material.CorrodedMetal)
	eye.Name = "Head"
	part(m, "Part", Vector3.new(0.17, 0.2, 0.12), CFrame.new(0, 0.22, 0.07), iron, Enum.Material.CorrodedMetal)
	part(m, "Part", Vector3.new(0.09, 0.28, 0.38), CFrame.new(0, 0.2, -0.45), iron, Enum.Material.CorrodedMetal)
	part(m, "WedgePart", Vector3.new(0.09, 0.14, 0.38), CFrame.new(0, 0.41, -0.45) * A(0, 180, 0), iron, Enum.Material.CorrodedMetal)
	part(m, "WedgePart", Vector3.new(0.09, 0.24, 0.38), CFrame.new(0, -0.06, -0.45) * A(180, 0, 0), iron, Enum.Material.CorrodedMetal)
	part(m, "Part", Vector3.new(0.095, 0.66, 0.08), CFrame.new(0, 0.16, -0.67), steel, Enum.Material.Metal)
	-- Сыромятная обвязка под обухом
	rod(m, Vector3.new(0, 0.07, -0.1), Vector3.new(0, -0.05, -0.09), 0.2, leather, Enum.Material.Leather)
	part(m, "Part", Vector3.new(0.22, 0.05, 0.36), CFrame.new(0, 0.2, -0.12) * A(35, 0, 0), leather, Enum.Material.Leather)
	-- Опора — центр вращения (начало координат), а не центр обуха
	m.PrimaryPart = eye
	eye.PivotOffset = eye.CFrame:Inverse()
	return m
end

return Hatchet
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Все настройки игры в одном месте. Меняй числа, чтобы настроить баланс.
local Config = {}

-- Лобби / раунд
Config.MinPlayers = 2 -- минимум игроков для старта (1 маньяк + 1 выживший)
Config.StudioMinPlayers = 1 -- в Studio можно тестировать одному (будешь выжившим)
Config.LobbyCountdown = 15
Config.ResultsTime = 14
Config.MaxRoundTime = 20 * 60
Config.IntroTime = 3 -- затемнение в начале раунда

-- Генераторы
Config.GeneratorCount = 7
Config.GeneratorsRequired = 5
Config.GeneratorRepairTime = 80 -- секунд одному выжившему
Config.GeneratorKickRegression = 0.08
Config.GeneratorRegressPerSecond = 0.0025
Config.RuinRegressPerSecond = 0.004 -- Проклятие: Руина

-- Проверки навыка (skill check)
Config.SkillCheckChancePerSecond = 0.10
Config.SkillCheckDuration = 1.1 -- полный оборот стрелки
Config.SkillCheckGreatBonus = 0.02
Config.SkillCheckFailPenalty = 0.10

-- Скорости (стандартная WalkSpeed в Roblox = 16)
Config.SurvivorWalkSpeed = 10
Config.SurvivorSprintSpeed = 16
Config.SurvivorCrouchSpeed = 5
Config.SurvivorCrawlSpeed = 2.5
Config.SurvivorHitBoostSpeed = 22
Config.SurvivorHitBoostTime = 1.8
Config.KillerCarrySpeed = 16.4
Config.KillerLungeSpeed = 26
Config.KillerLungeTime = 0.35

-- Атака маньяка
Config.AttackRange = 7
Config.AttackCooldownHit = 2.7
Config.AttackCooldownMiss = 1.5
Config.AttackSlowSpeed = 6

-- Действия (секунды)
Config.HealTime = 16
Config.UnhookTime = 1.2
Config.HookTime = 1.2
Config.BreakPalletTime = 2.6
Config.KickGeneratorTime = 1.8
Config.OpenGateTime = 18
Config.CleanseTime = 12
Config.ChestTime = 5
Config.SearchLockerTime = 0.9
Config.CloseHatchTime = 1.5
Config.InteractRange = 7

-- Крюки
Config.HookStageTime = 60
Config.MaxHooks = 3
Config.WiggleTime = 16
Config.BleedOutTime = 240

-- Паллеты
Config.PalletStunTime = 2.2
Config.PalletStunRange = 7

-- Эндгейм и люк
Config.EndGameCollapseTime = 120

-- Предметы
Config.MedkitHealTime = 12 -- сколько лечиться аптечкой
Config.MedkitCharges = 24 -- секунд использования
Config.ToolboxCharges = 30
Config.ToolboxBonus = 0.5 -- +50% к скорости ремонта
Config.FlashlightCharges = 12
Config.FlashlightBlindTime = 0.9 -- сколько светить в лицо, чтобы ослепить
Config.FlashlightRange = 16
Config.FlashlightAngle = 14 -- градусов
Config.BlindDuration = 2.5
Config.ChestItemWeights = { Medkit = 40, Toolbox = 35, Flashlight = 25 }

-- Радиус ужаса и звук
-- Порядок выбора звука: SoundOverrides -> найденный в библиотеке Creator Store -> встроенный синтез.
Config.SoundOverrides = {
	-- Сюда можно вставить ID звуков из Toolbox (вкладка Audio): число, "rbxassetid://..." или список вариантов:
	-- Heartbeat = "rbxassetid://1234567",
	-- ChaseMusic = "rbxassetid://...",
	-- FootstepDirt = { "rbxassetid://...", "rbxassetid://..." },
	-- Имена всех слотов — в src/shared/Sounds.lua
}
Config.SoundLibraryEnabled = true -- искать настоящие звуки (AssetService:SearchAudioAsync) при старте сервера
Config.SoundSearchTimeLimit = 120 -- секунд на весь поиск, дальше — встроенные звуки
Config.SoundSearchWorkers = 2 -- сколько запросов поиска идёт одновременно
Config.SoundSearchRetries = 2 -- повторов при ошибке (с нарастающей паузой)
Config.SoundSearchInterval = 0.5 -- секунд между запросами поиска (на весь сервер), чтобы не упереться в лимит
Config.SoundLoadTimeout = 10 -- секунд на загрузку найденного звука на клиенте, иначе — встроенный
Config.MaxSounds = 36 -- одновременно звучащих одноразовых звуков на ПК
Config.MaxSoundsMobile = 18 -- то же на телефонах и планшетах
Config.SoundGroupVolumes = { Master = 1, SFX = 1, Ambience = 0.75, Music = 0.7, Voice = 1, UI = 0.8 }
Config.ChaseDistance = 26

-- Вид маньяка от первого лица, как в оригинале
Config.KillerFirstPerson = true

-- Карта
Config.MapSize = 220
Config.LobbyPosition = Vector3.new(0, 400, 0)

-- Очки крови
Config.ScoreCategoryCap = 8000
Config.SaveBloodpoints = true -- сохраняются в DataStore (работает в опубликованной игре)

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">ItemDefs</string>
          <string name="Source"><![CDATA[-- Предметы выживших из сундуков.
